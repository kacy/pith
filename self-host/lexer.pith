# lexer.pith - the compiler's side of the lexer
#
# the scanner is std.pith.lexer. std.pith.highlight colors code from the same
# scanner, so the compiler and the highlighter share one lexer and cannot
# drift apart. this module adds what only the compiler needs: the source size
# limit, the token table the parser walks by index, and the values of integer
# literals.

from std.pith.lexer import Token, lex

# ---------------------------------------------------------------
# integer literal values
# ---------------------------------------------------------------

# the value of one digit in `base`, or -1 when the character is not one
fn literal_digit_value(c: String, base: Int) -> Int:
    code := ord(c)
    mut value := 0 - 1
    if code >= 48 and code <= 57:
        value = code - 48
    elif code >= 97 and code <= 102:
        value = code - 87
    elif code >= 65 and code <= 70:
        value = code - 55
    if value >= base:
        return 0 - 1
    return value

## the magnitude an integer literal's token text spells: decimal digits, or
## `0x`, `0b` or `0o` and digits, with the `_` separators already removed.
## the first value is the magnitude's low 64 bits read as an Int, so one at or
## above 2^63 comes back negative. the second is true when the magnitude is
## past 2^64 - 1 or the text is not a literal, and then the first means
## nothing. it never overflows, whatever the text.
pub fn int_literal_magnitude(text: String) -> (Int, Bool):
    mut base := 10
    mut i := 0
    if text.len() > 2 and text[0] == "0":
        prefix := text[1]
        if prefix == "x" or prefix == "X":
            base = 16
        elif prefix == "b" or prefix == "B":
            base = 2
        elif prefix == "o" or prefix == "O":
            base = 8
        if base != 10:
            i = 2
    if i >= text.len():
        return (0, true)
    # (2^64 - 1) / base and its remainder: a magnitude past `limit`, or at it
    # with a next digit past `rest`, would not fit in 64 bits
    mut limit := 1844674407370955161
    mut rest := 5
    if base == 16:
        limit = 1152921504606846975
        rest = 15
    elif base == 8:
        limit = 2305843009213693951
        rest = 7
    elif base == 2:
        limit = 9223372036854775807
        rest = 1
    mut magnitude := 0
    while i < text.len():
        digit := literal_digit_value(text[i], base)
        if digit < 0 or magnitude < 0 or magnitude > limit or (magnitude == limit and digit > rest):
            return (0, true)
        magnitude = magnitude.wrapping_mul(base).wrapping_add(digit)
        i = i + 1
    return (magnitude, false)

## the value of an integer literal's text, which may start with `-`, as the
## two's complement bits an iconst takes. the checker has already refused a
## literal outside its type's range, so the bits read back as that value.
pub fn int_literal_value(text: String) -> Int:
    if text.starts_with("-"):
        zero := 0
        return zero.wrapping_sub(int_literal_magnitude(text.substring(1, text.len())).0)
    return int_literal_magnitude(text).0

# ---------------------------------------------------------------
# token table
# ---------------------------------------------------------------

mut _tok_kinds: List[String] := []
mut _tok_values: List[String] := []
mut _tok_lines: List[Int] := []
mut _tok_cols: List[Int] := []
mut _tok_offsets: List[Int] := []
mut _tok_lens: List[Int] := []

# kind of token `i` in the loaded token table. the table is the
# parallel-array copy of a token stream that load_tokens() installs, and
# it, not the List[Token] lex_all() returns, is what the parser reads, so
# the parser walks the stream by index without copying tokens. there is
# no bounds check: an index at or past tok_count() is a runtime trap, so
# gate on tok_count() first.
pub fn tok_kind(i: Int) -> String:
    return _tok_kinds[i]
# source text of token `i`. empty for the kinds that carry no text —
# newline, indent, dedent, eof. for an "err" token this is either a
# message the lexer wrote (an unterminated string, a bad dedent) or the
# single offending character.
pub fn tok_value(i: Int) -> String:
    return _tok_values[i]
# 1-based source line of token `i`'s first character. synthesized tokens
# (indent, dedent, eof) report wherever the scanner was sitting when
# they were produced.
pub fn tok_line(i: Int) -> Int:
    return _tok_lines[i]
# 1-based column of token `i`'s first character, which is what a caret
# renderer needs to point at the token rather than beside it. columns
# count bytes, not codepoints.
pub fn tok_col(i: Int) -> Int:
    return _tok_cols[i]
# byte offset of token `i`'s first character within the source that was
# lexed. use with tok_len() to slice the original text back out.
pub fn tok_offset(i: Int) -> Int:
    return _tok_offsets[i]
# byte length of token `i`'s lexeme. zero for synthesized and
# end-of-input tokens, which consume no source.
pub fn tok_len(i: Int) -> Int:
    return _tok_lens[i]
# number of tokens in the loaded table, counting the trailing eof. the
# upper bound for every tok_* index.
pub fn tok_count() -> Int:
    return _tok_kinds.len()

# install `token_list` as the token table the tok_* accessors read,
# discarding whatever was loaded before. this is how the parser hands a
# stream over to itself: parse_with_file() loads the file's tokens, and
# interpolation parsing swaps in a sub-lexed fragment here and puts the
# outer stream back with load_token_snapshot().
pub fn load_tokens(token_list: List[Token]):
    _tok_kinds = []
    _tok_values = []
    _tok_lines = []
    _tok_cols = []
    _tok_offsets = []
    _tok_lens = []
    for tok in token_list:
        _tok_kinds.push(tok.kind)
        _tok_values.push(tok.value)
        _tok_lines.push(tok.line)
        _tok_cols.push(tok.column)
        _tok_offsets.push(tok.offset)
        _tok_lens.push(tok.len)

# restore the token table from six parallel lists — the shape you get by
# reading tok_kind()/tok_value()/… across a whole stream. the parser uses
# this to put the outer token stream back after sub-parsing a string
# interpolation. the six lists are copied column by column and their
# lengths are never compared, so passing lists of unequal length leaves a
# ragged table that traps only when an accessor reaches past a short one.
pub fn load_token_snapshot(kinds: List[String], values: List[String], lines: List[Int], cols: List[Int], offsets: List[Int], lens: List[Int]):
    _tok_kinds = []
    _tok_values = []
    _tok_lines = []
    _tok_cols = []
    _tok_offsets = []
    _tok_lens = []
    for kind in kinds:
        _tok_kinds.push(kind)
    for value in values:
        _tok_values.push(value)
    for line in lines:
        _tok_lines.push(line)
    for col in cols:
        _tok_cols.push(col)
    for off in offsets:
        _tok_offsets.push(off)
    for ln in lens:
        _tok_lens.push(ln)

# the largest source file the compiler reads. the front end holds a few
# hundred bytes per token, so a 16 MiB file dense with tokens already
# needs several GiB; the limit turns a larger one into an error instead
# of an out-of-memory kill.
max_source_bytes := 16777216

# tokenize a whole source string, from a clean scanner, up to and
# including the trailing eof token. load_tokens() installs the stream as
# the token table; parse_with_file() does that itself.
#
# lexing never fails: a stray character, an unterminated string or an
# indentation level that matches no open block becomes an "err" token in
# the stream and scanning carries on. a caller that cares has to scan the
# result for kind "err", and note a multi-byte character produces one
# "err" token per byte, so errors arrive in runs.
#
# a source longer than max_source_bytes is not lexed. the stream is one
# "err" token that says so, then eof.
pub fn lex_all(src: String) -> List[Token]:
    if src.len() <= max_source_bytes:
        return lex(src)
    mut refused: List[Token] := [Token("err", "source file too large: {src.len()} bytes, and the limit is {max_source_bytes} (16 MiB)", 1, 1, 0, 0)]
    for tok in lex(""):
        refused.push(tok)
    return refused
