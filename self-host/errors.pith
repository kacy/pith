# errors.pith — human-readable error rendering for pith diagnostics
#
# renders diagnostics with source context, underlines, and fix
# suggestions.

from std.strings import lines_keep_empty

# one problem to report, from any stage — the lexer, parser, checker or
# linter all build these, and they are rendered together.
#
# `severity` is "error" or "warning" as a plain string, and only an
# error fails a build; a warning is printed and otherwise ignored.
# `code` is the E-number the docs and the tests key on, so it is the
# stable part of the diagnostic — the message is free to be reworded,
# the code is not.
#
# `fix` carries a suggested replacement when the reporter can offer
# one, and "" when it cannot. the language server turns a non-empty fix
# into a quickfix, so anything put here is something a user may apply
# with one keystroke and without reading it closely.
pub struct Diagnostic:
    pub severity: String
    pub code: String
    pub message: String
    pub file: String
    pub line: Int
    pub col: Int
    pub fix: String

# render all diagnostics as human-readable text with source context.
pub fn render_diagnostics(diags: List[Diagnostic], source: String) -> String:
    # split the file once for the whole batch and join the rendered
    # diagnostics once at the end. doing either per diagnostic made
    # rendering cost the square of the count, and a file that fails to
    # check tends to fail in a lot of places at once: 4000 diagnostics
    # took over half a minute to print.
    #
    # split() would drop empty segments, so every blank line in the file
    # would shift the snippet up by one: a diagnostic reported at line 8
    # of a file with three blank lines above it printed line 11 instead,
    # and anything past the last non-empty segment printed no snippet at
    # all. the line number in the header was right the whole time — only
    # the source line under it was wrong, which is worse than no snippet.
    source_lines := lines_keep_empty(source)
    mut rendered: List[String] := []
    for d in diags:
        rendered.push(render_single_diagnostic(d, source_lines))
    return rendered.join("")

# render a single diagnostic with source context and underline.
fn render_single_diagnostic(d: Diagnostic, source_lines: List[String]) -> String:
    mut output := ""

    # header: file + severity + message (with error code)
    mut location := ""
    if d.file != "":
        location = d.file
        if d.line > 0:
            location = location + ":" + d.line.to_string()
            if d.col > 0:
                location = location + ":" + d.col.to_string()
        location = location + ": "

    if d.code != "":
        output = output + location + d.severity + "[" + d.code + "]: " + d.message + chr(10)
    else:
        output = output + location + d.severity + ": " + d.message + chr(10)

    # source line + underline (only if we have line info)
    if d.line > 0:
        line_idx := d.line - 1
        if line_idx >= 0 and line_idx < source_lines.len():
            source_line := source_lines[line_idx]
            line_num := d.line.to_string()
            output = output + "  " + line_num + " | " + source_line + chr(10)

            # underline: spaces for margin + carets
            margin_width := line_num.len() + 4
            mut j := 0
            while j < margin_width + d.col:
                output = output + " "
                j = j + 1
            output = output + "^" + chr(10)

    # fix suggestion
    if d.fix != "":
        output = output + "  fix: " + d.fix + chr(10)

    output = output + chr(10)
    return output

# render diagnostics as JSON (same format as check_main.pith).
pub fn render_diagnostics_json(diags: List[Diagnostic]) -> String:
    # one object per slot, joined once — appending each object to the
    # array text rebuilt the whole array every time, which is the same
    # quadratic shape the human renderer above had, and nothing caps
    # how many diagnostics a broken file produces.
    mut objects: List[String] := []
    for d in diags:
        objects.push(render_diagnostic_json(d))
    return "[" + objects.join(",") + "]" + chr(10)

# render a single diagnostic as a JSON object.
fn render_diagnostic_json(d: Diagnostic) -> String:
    quote := chr(34)
    mut output := chr(123)
    output = output + quote + "file" + quote + ":"
    if d.file != "":
        output = output + quote + escape_json_string(d.file) + quote
    else:
        output = output + "null"
    output = output + "," + quote + "severity" + quote + ":" + quote + escape_json_string(d.severity) + quote
    output = output + "," + quote + "code" + quote + ":"
    if d.code != "":
        output = output + quote + escape_json_string(d.code) + quote
    else:
        output = output + "null"
    output = output + "," + quote + "message" + quote + ":" + quote + escape_json_string(d.message) + quote
    output = output + "," + quote + "line" + quote + ":" + d.line.to_string()
    output = output + "," + quote + "col" + quote + ":" + d.col.to_string()
    output = output + "," + quote + "fix" + quote + ":"
    if d.fix != "":
        output = output + quote + escape_json_string(d.fix) + quote
    else:
        output = output + "null"
    output = output + chr(125)
    return output

# escape a string for JSON output.
fn escape_json_string(s: String) -> String:
    quote := chr(34)
    backslash := chr(92)
    mut output := ""
    for ch in s:
        if ch == quote:
            output = output + backslash + quote
        elif ch == backslash:
            output = output + backslash + backslash
        elif ch == chr(10):
            output = output + backslash + "n"
        elif ch == chr(9):
            output = output + backslash + "t"
        else:
            output = output + ch
    return output

# count errors in a diagnostic list.
pub fn count_errors(diags: List[Diagnostic]) -> Int:
    mut count := 0
    for d in diags:
        if d.severity == "error":
            count = count + 1
    return count

# check if a diagnostic list has any errors (not just warnings).
pub fn has_errors(diags: List[Diagnostic]) -> Bool:
    return count_errors(diags) > 0
