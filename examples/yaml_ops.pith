# yaml_ops: reading configuration with std.yaml.
#
# loads the deployment config for a small web service. the typed decoder fills
# a struct from a mapping, the tree API reads optional settings with
# defaults, and a broken file is reported with the parser's reason instead of
# a guess. a stream of several documents is read in one call.

import std.yaml as yaml

struct Database:
    pub host: String
    pub port: Int
    pub pool: Int = 4

fn config_text() -> String:
    return [
        "service: billing",
        "replicas: 3",
        "debug: false",
        "regions: [eu-west, us-east]",
        "database:",
        "  host: db.internal   # comments are ignored",
        "  port: 5432",
        "motd: |",
        "  maintenance on sunday",
        "  between 02:00 and 04:00",
].join("\n") + "\n"

fn main():
    root := yaml.parse(config_text())
    service := yaml.get_string(root, "service")
    replicas := yaml.get_int(root, "replicas")
    print("{service}: {replicas} replicas, debug={yaml.get_bool(root, "debug")}")

    regions := yaml.get_array(root, "regions")
    for index in 0..yaml.array_len(regions):
        print("  region {index + 1}: {yaml.scalar_string(yaml.array_get(regions, index))}")

    # optional settings fall back to defaults when the key is absent
    timeout_seconds := yaml.get_int_or(root, "timeout_seconds", 30)
    log_level := yaml.get_string_or(root, "log_level", "info")
    print("timeout {timeout_seconds}s, log level {log_level}")

    database := yaml.decode[Database](yaml.get_map(root, "database"))
    if database.is_ok:
        db := database.ok
        print("database {db.host}:{db.port}, pool of {db.pool}")

    # a block scalar keeps its line breaks
    for line in yaml.get_string(root, "motd").trim().split("\n"):
        print("motd | {line}")

    # a typo in the file is an error with a reason, not a half-read config
    print("")
    broken := yaml.parse("regions: [eu-west, us-east")
    if broken < 0:
        print("rejected broken config: {yaml.last_error()}")

    # one file can carry several documents separated by ---
    stream := yaml.parse_all("service: web\nreplicas: 2\n---\nservice: worker\nreplicas: 5\n")
    mut total := replicas
    for index in 0..yaml.array_len(stream):
        doc := yaml.array_get(stream, index)
        total += yaml.get_int(doc, "replicas")
        print("also deploying {yaml.get_string(doc, "service")}")
    print("replicas across services: {total}")
