# clash_event_a — one module's Event, carrying a timestamp.
# a different module (clash_event_b) declares its own struct of the same name,
# so this file exists to prove the two never get confused for each other.
pub struct Event:
    pub name: String
    pub time_ns: Int

pub fn at(name: String, time_ns: Int) -> Event:
    return Event(name, time_ns)
