# an unknown variant of an enum reached through a module alias, and of one
# imported under another name, in each of the three shapes
import support.unknown_variant_shapes_mod as m
from support.unknown_variant_shapes_mod import Shape as E

fn main():
    a := m.Shape.Nope
    b := m.Shape.Nope(1.0)
    c := E.Nope
    d := E.Nope(1.0)
    e := E.Dot
    match e:
        E.Gone => print("gone")
        _ => print("other")
