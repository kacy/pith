        return tcp_stream_write_bytes(self, data)

    fn write_bytes_ctx(ctx: Context, data: Bytes) -> Int!BlockingError:
        return tcp_stream_write_bytes_ctx(self, ctx, data)

    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_bytes_to(self, data)

    fn write_all_bytes_ctx(ctx: Context, data: Bytes) -> Int!BlockingError:
        return write_all_tcp_stream_bytes_ctx(self, ctx, data)

    fn buffered_bytes_reader() -> BufferedBytesReader:
        return buffered_bytes_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_bytes_reader_chunked(chunk_size: Int) -> BufferedBytesReader:
        return buffered_bytes_reader(self, chunk_size)

    fn buffered_bytes_writer() -> BufferedBytesWriter:
        return buffered_bytes_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_bytes_writer_chunked(chunk_size: Int) -> BufferedBytesWriter:
        return buffered_bytes_writer(self, chunk_size)

    fn buffered_reader() -> BufferedReader:
        return buffered_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_reader_chunked(chunk_size: Int) -> BufferedReader:
        return buffered_reader(self, chunk_size)

    fn buffered_writer() -> BufferedWriter:
        return buffered_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_writer_chunked(chunk_size: Int) -> BufferedWriter:
        return buffered_writer(self, chunk_size)

    fn set_timeout(ms: Int):
        tcp_stream_set_timeout(self, ms)

    fn close():
        tcp_stream_close(self)

impl Reader for TcpStream:
    fn read(max_bytes: Int) -> String!:
        return tcp_stream_read(self, max_bytes)

impl BytesReader for TcpStream:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return tcp_stream_read_bytes(self, max_bytes)

impl Writer for TcpStream:
    fn write(data: String) -> Int!:
        return tcp_stream_write(self, data)

impl BytesWriter for TcpStream:
    fn write_bytes(data: Bytes) -> Int!:
        return tcp_stream_write_bytes(self, data)

impl Closer for TcpStream:
    fn close():
        tcp_stream_close(self)

impl FileStream:
    fn read(max_bytes: Int) -> String!:
        return file_stream_read(self, max_bytes)

    fn read_all() -> String!:
        return read_all_file_stream(self)

    fn read_all_chunked(chunk_size: Int) -> String!:
        return read_all_file_stream_chunked(self, chunk_size)

    fn read_bytes(max_bytes: Int) -> Bytes!:
        return file_stream_read_bytes(self, max_bytes)

    fn read_exact_bytes(count: Int) -> Bytes!:
        return read_exact_bytes_from(self, count)

    fn read_all_bytes() -> Bytes!:
        return read_all_bytes_from(self, DEFAULT_CHUNK_SIZE)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_bytes_from(self, chunk_size)

    fn write(data: String) -> Int!:
        return file_stream_write(self, data)

    fn write_all(data: String) -> Int!:
        return write_all_file_stream(self, data)

    fn write_bytes(data: Bytes) -> Int!:
        return file_stream_write_bytes(self, data)

    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_bytes_to(self, data)

    fn write_n_bytes(data: Bytes, count: Int) -> Int!:
        return write_n_bytes(self, data, count)

    fn buffered_bytes_reader() -> BufferedBytesReader:
        return buffered_bytes_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_bytes_reader_chunked(chunk_size: Int) -> BufferedBytesReader:
        return buffered_bytes_reader(self, chunk_size)

    fn buffered_bytes_writer() -> BufferedBytesWriter:
        return buffered_bytes_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_bytes_writer_chunked(chunk_size: Int) -> BufferedBytesWriter:
        return buffered_bytes_writer(self, chunk_size)

    fn buffered_reader() -> BufferedReader:
        return buffered_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_reader_chunked(chunk_size: Int) -> BufferedReader:
        return buffered_reader(self, chunk_size)

    fn buffered_writer() -> BufferedWriter:
        return buffered_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_writer_chunked(chunk_size: Int) -> BufferedWriter:
        return buffered_writer(self, chunk_size)

    fn close():
        file_stream_close(self)

impl Reader for FileStream:
    fn read(max_bytes: Int) -> String!:
        return file_stream_read(self, max_bytes)

impl BytesReader for FileStream:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return file_stream_read_bytes(self, max_bytes)

impl Writer for FileStream:
    fn write(data: String) -> Int!:
        return file_stream_write(self, data)

impl BytesWriter for FileStream:
    fn write_bytes(data: Bytes) -> Int!:
        return file_stream_write_bytes(self, data)

impl Closer for FileStream:
    fn close():
        file_stream_close(self)

# a file nobody closes is closed when its last value dies. a file handle is
# never reissued, so a close() before that leaves the destructor nothing to do.
# a file is unbuffered here: every write has reached the os by the time it
# returns, so nothing is lost.
impl Drop for FileStream:
    fn drop():
        self.close()

## Read a line from standard input
pub fn prompt() -> String:
    return input()

## Print a message then read a line from standard input
pub fn prompt_with(msg: String) -> String:
    print(msg)
    return input()

test "io string readers and buffers keep offsets":
    reader := string_reader("abcdef")
    out := string_buffer()

    assert_eq(reader.read(2)!, "ab")
    assert_eq(reader.read_all_chunked(2)!, "cdef")
    assert(out.is_empty())
    assert_eq(out.write("hi")!, 2)
    assert_eq(out.write_line("there")!, 6)
    assert_eq(out.string(), "hithere" + chr(10))
    assert_eq(out.len(), 8)
    out.clear()
    assert(out.is_empty())

test "io copies and limits string streams":
    reader := string_reader("abcdef")
    out := string_buffer()
    limited := string_buffer()
    short_reader := string_reader("hi")
    short_out := string_buffer()
    failed := copy_n(short_reader, short_out, 3)

    assert_eq(copy_chunked(reader, out, 2)!, 6)
    assert_eq(out.string(), "abcdef")
    assert_eq(write_n(limited, "pith", 3)!, 3)
    assert_eq(limited.string(), "pit")
    assert(failed.is_err)

test "io byte readers support exact reads":
    reader := bytes_reader(bytes.from_string_utf8("abcdef"))

    assert_eq(reader.read_bytes(2)!.to_string_utf8()!, "ab")
    assert_eq(read_exact_bytes(reader, 3)!.to_string_utf8()!, "cde")
    assert(reader.read_exact_bytes(2).is_err)

test "io buffered string readers split lines and separators":
    reader := string_reader("alpha" + chr(10) + "beta" + chr(13) + chr(10) + "gamma")
    buffered := reader.buffered_chunked(3)

    assert_eq(buffered.read_line()!, "alpha")
    assert_eq(buffered.read_line()!, "beta")
    assert_eq(buffered.read_until("ma")!, "gam")

test "io buffered read_line_opt tells an empty line from the end":
    nl := chr(10)
    buffered := string_reader("one" + nl + nl + "three" + chr(13) + nl + "last").buffered_chunked(2)
    mut lines: List[String] := []
    while true:
        line := buffered.read_line_opt()!
        if line == none:
            break
        lines.push("[" + line.value() + "]")
    assert_eq(lines.join(","), "[one],[],[three],[last]")
    assert(buffered.read_line_opt()! == none)
    assert_eq(buffered.read_line()!, "")

    ends_with_newline := string_reader("a" + nl).buffered()
    assert_eq(ends_with_newline.read_line_opt()!.value(), "a")
    assert(ends_with_newline.read_line_opt()! == none)
    assert(string_reader("").buffered().read_line_opt()! == none)

    ctx := background()
    blank := string_reader(nl).buffered()
    assert_eq(blank.read_line_opt_ctx(ctx)!.value(), "")
    assert(blank.read_line_opt_ctx(ctx)! == none)
    assert_eq(blank.read_line_ctx(ctx)!, "")
    blank.close()
    assert(blank.read_line_opt()! == none)

test "io buffered string writers flush by chunk size":
    out := string_buffer()
    writer := out.buffered_chunked(5)

    assert_eq(writer.write("hi")!, 2)
    assert_eq(out.string(), "")
    assert_eq(writer.write("there")!, 5)
    assert_eq(out.string(), "hithere")
    assert_eq(writer.write("!")!, 1)
    assert_eq(out.string(), "hithere")
    assert_eq(writer.flush()!, 1)
    assert_eq(out.string(), "hithere!")

test "io buffered byte streams handle separators and flushes":
    reader := bytes_reader(bytes.from_string_utf8("a,b,c")).buffered_chunked(2)
    out := bytes.buffer()
    writer := out.buffered_chunked(4)

    assert_eq(reader.read_until_bytes(bytes.from_string_utf8(","))!.to_string_utf8()!, "a")
    assert_eq(reader.read_until_bytes_including(bytes.from_string_utf8(","))!.to_string_utf8()!, "b,")
    assert_eq(reader.read_all_bytes()!.to_string_utf8()!, "c")
    assert_eq(writer.write_bytes(bytes.from_string_utf8("ab"))!, 2)
    assert_eq(out.bytes().len(), 0)
    assert_eq(writer.write_all_bytes(bytes.from_string_utf8("cd"))!, 2)
    assert_eq(out.bytes().to_string_utf8()!, "abcd")
    assert_eq(writer.write_bytes(bytes.from_string_utf8("e"))!, 1)
    assert_eq(writer.flush()!, 1)
    assert_eq(out.bytes().to_string_utf8()!, "abcde")

test "io string readers, buffers and cursors deregister on close":
    reader := string_reader("hello")
    assert_eq(reader.read(4)!, "hell")
    reader.close()
    assert_eq(reader.read(4)!, "")
    reader.close()

    buf := string_buffer()
    buf.write("abc")!
    buf.close()
    assert_eq(buf.write("more")!, 0)
    assert_eq(buf.string(), "")
    buf.close()

    cursor := bytes_reader(bytes.from_string_utf8("xyz"))
    assert_eq(cursor.read_bytes(2)!.to_string_utf8()!, "xy")
    cursor.close()
    assert(cursor.read_bytes(2)!.is_empty())
    cursor.close()

test "io buffered text readers and writers deregister on close":
    source := string_reader("line one" + chr(10) + "line two")
    buffered := source.buffered()
    assert_eq(buffered.read_line()!, "line one")
    buffered.close()
    assert_eq(buffered.read(4)!, "")
    buffered.close()
    source.close()

    target := string_buffer()
    writer := target.buffered_chunked(4)
    writer.write("abcdef")!
    writer.flush()!
    writer.close()
    assert_eq(writer.write("zz")!, 0)
    writer.close()
    assert_eq(target.string(), "abcdef")
    target.close()

test "io string buffer counts and keeps every write":
    buf := string_buffer()
    assert_eq(buf.write("")!, 0)
    assert(buf.is_empty())
    assert_eq(buf.string(), "")
    assert_eq(buf.write_line("")!, 1)
    assert_eq(buf.string(), chr(10))
    assert_eq(buf.write_line("row")!, 4)
    assert_eq(buf.newline()!, 1)
    assert_eq(buf.string(), chr(10) + "row" + chr(10) + chr(10))
    assert_eq(buf.len(), 6)
    buf.close()

test "io string buffer joins mixed chunk sizes in order":
    buf := string_buffer()
    mut expected := ""
    mut i := 0
    while i < 300:
        piece := "x".repeat(i % 7) + i.to_string() + "|"
        assert_eq(buf.write(piece)!, piece.len())
        expected = expected + piece
        i = i + 1
    assert_eq(buf.len(), expected.len())
    assert_eq(buf.string(), expected)
    buf.close()

test "io string buffer keeps multi-byte and arbitrary byte content":
    buf := string_buffer()
    assert_eq(buf.write("héllo ")!, 7)
    assert_eq(buf.write("wörld ")!, 7)
    assert_eq(buf.write("日本語")!, 9)
    assert_eq(buf.string(), "héllo wörld 日本語")
    assert_eq(buf.len(), 23)
    # a string holds whatever bytes were put into it, valid utf-8 or not,
    # and so must the buffer: nothing on the way in or out may decode.
    raw := chr(200) + chr(255) + chr(0) + "z"
    assert_eq(buf.write(raw)!, 4)
    got := buf.string()
    assert_eq(got.len(), 27)
    assert_eq(got, "héllo wörld 日本語" + raw)
    assert_eq(ord(got[23]), 200)
    assert_eq(ord(got[24]), 255)
    assert_eq(ord(got[25]), 0)
    buf.close()

test "io string buffer aliases share one buffer":
    first := string_buffer()
    second := first
    assert_eq(first.write("ab")!, 2)
    assert_eq(second.write("cd")!, 2)
    assert_eq(first.string(), "abcd")
    assert_eq(second.string(), "abcd")
    assert_eq(second.len(), 4)
    second.clear()
    assert(first.is_empty())
    first.close()
    assert_eq(second.write("z")!, 0)
    assert_eq(second.string(), "")

test "io string buffer snapshots stay unchanged after later writes":
    buf := string_buffer()
    mut i := 0
    while i < 40:
        buf.write("ab")!
        i = i + 1
    early := buf.string()
    assert_eq(early.len(), 80)
    buf.write("Z")!
    assert_eq(early, "ab".repeat(40))
    assert_eq(buf.string(), "ab".repeat(40) + "Z")
    later := buf.string()
    buf.clear()
    assert_eq(later, "ab".repeat(40) + "Z")
    assert_eq(early, "ab".repeat(40))
    buf.write("fresh")!
    assert_eq(buf.string(), "fresh")
    last_snapshot := buf.string()
    buf.close()
    assert_eq(last_snapshot, "fresh")
    assert_eq(later.len(), 81)
    assert_eq(early.len(), 80)

test "io string buffer resets and is reused":
    buf := string_buffer()
    mut round := 0
    while round < 5:
        mut i := 0
        while i < 100:
            buf.write("chunk-{round}-{i};")!
            i = i + 1
        assert(buf.string().starts_with("chunk-{round}-0;chunk-{round}-1;"))
        assert(buf.string().ends_with("chunk-{round}-99;"))
        buf.clear()
        assert(buf.is_empty())
        assert_eq(buf.string(), "")
        round = round + 1
    buf.close()

test "io string buffer close frees and stays closed":
    buf := string_buffer()
    buf.write("kept")!
    kept := buf.string()
    buf.close()
    assert_eq(kept, "kept")
    assert_eq(buf.write("more")!, 0)
    assert_eq(buf.write_line("more")!, 0)
    assert_eq(buf.string(), "")
    assert_eq(buf.len(), 0)
    assert(buf.is_empty())
    # clearing a closed buffer must not re-register it
    buf.clear()
    assert_eq(buf.write("again")!, 0)
    buf.close()
    buf.close()
    assert_eq(buf.string(), "")

test "io string buffer survives repeated create, write and close cycles":
    mut total := 0
    mut cycle := 0
    while cycle < 200:
        buf := string_buffer()
        mut i := 0
        while i < 33:
            buf.write("c{cycle}.{i} ")!
            i = i + 1
        out := buf.string()
        buf.close()
        assert(out.starts_with("c{cycle}.0 "))
        assert(out.ends_with("c{cycle}.32 "))
        total = total + out.len()
        cycle = cycle + 1
    assert(total > 200 * 33 * 4)

# how many entries the registries hold on this task, across every map.
fn registry_entries() -> Int:
    return string_reader_data.len() + string_reader_offsets.len() + string_buffer_stores.len() + bytes_reader_data.len() + bytes_reader_offsets.len() + buffered_bytes_readers.len() + buffered_bytes_writers.len() + buffered_readers.len() + buffered_writers.len()

# one of each registry type, used and then let go without a close or a free.
fn abandon_one_of_each(i: Int) -> Int!:
    reader := string_reader("abc-{i}")
    buf := string_buffer()
    buf.write("x")!
    cursor := bytes_reader(bytes.from_string_utf8("abc"))
    text := string_reader("one two").buffered()
    out := string_buffer().buffered()
    out.write("unflushed")!
    raw := bytes_reader(bytes.from_string_utf8("raw")).buffered()
    target := bytes.buffer()
    defer target.free()
    sink := target.buffered()
    sink.write_bytes(bytes.from_string_utf8("unflushed"))!
    return reader.read(2)!.len() + cursor.read_bytes(1)!.len() + text.read(3)!.len() + raw.read_bytes(1)!.len()

test "io values dropped without close give their entries back":
    before := registry_entries()
    mut total := 0
    for i in 0..1000:
        total = total + abandon_one_of_each(i)!
    assert_eq(total, 7000)
    assert_eq(registry_entries(), before)

# close a reader and let it die while another is open: the destructor after the
# close, and the second close, must leave the other reader alone.
fn close_twice_then_drop(keep: StringReader) -> String!:
    gone := string_reader("gone")
    gone.close()
    gone.close()
    return keep.read(4)!

test "io close then drop, and a second close, are no-ops":
    keep := string_reader("keep reading")
    assert_eq(close_twice_then_drop(keep)!, "keep")
    assert_eq(keep.read_all()!, " reading")
    buf := string_buffer()
    buf.write("held")!
    buf.close()
    buf.close()
    assert_eq(buf.string(), "")

# a buffered writer's destructor does not flush: what it held is lost, as it
# is when close() runs first.
fn abandon_writer(target: StringBuffer):
    writer := target.buffered()
    writer.write("never flushed") catch 0

test "io a dropped buffered writer does not flush":
    target := string_buffer()
    abandon_writer(target)
    assert_eq(target.string(), "")
