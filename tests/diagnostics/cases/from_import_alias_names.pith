# `from m import x as y` reaches x through a module alias the parser
# writes for y. errors that follow from such a use name `y`, or the module
# m, the way the source spells them, never the hidden alias.

from std.json import byte_at as peek
from std.math import sqrt as root
from std.math import missing_fn as gone

fn main():
    x := peek
    peek(1)
    print(root(1.0, 2.0))
    a := gone
    gone()
    b: gone := 1
