# match on enum variants. variant patterns are written qualified (Color.Red);
# a bare name in a pattern is a binding, not a variant.

enum Color:
    Red
    Green
    Blue

fn name(c: Color) -> String:
    match c:
        Color.Red => "red"
        Color.Green => "green"
        Color.Blue => "blue"

fn is_warm(c: Color) -> String:
    match c:
        Color.Red => "warm"
        _ => "cool"

fn main():
    print(name(Color.Red))
    print(name(Color.Green))
    print(name(Color.Blue))
    print(is_warm(Color.Red))
    print(is_warm(Color.Blue))
