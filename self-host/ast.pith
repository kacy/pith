# ast.pith — arena-indexed AST nodes
#
# stores all AST nodes in a flat list. nodes reference each other
# by integer index, avoiding the need for pointers.
#
# node.kind is a string tag (e.g. "int_lit", "binary", "fn_decl").
# node.value holds associated data (e.g. the literal value, operator name).
# node.children holds indices of sub-nodes.

# one node of the parsed syntax tree. nodes live in a single global
# arena and refer to each other by INDEX, not by reference — `children`
# holds arena indices, and every function here that takes a node takes
# one of those indices. that is why the tree is walked with get_node()
# rather than by following fields.
#
# `kind` is an untyped string tag ("fn_decl", "call", "binding", …) and
# `value` is whatever text that kind needs — a function's name, a
# literal's text, an operator. neither is checked, so a misspelled kind
# silently matches nothing.
#
# line and col are the position of the LAST token that formed the node,
# not the first, so a node spanning several tokens reports at its end.
# that is the documented diagnostics limitation, and it is why anything
# needing the declaration's own line searches the source text instead.
pub struct Node:
    pub kind: String
    pub value: String
    pub children: List[Int]
    pub line: Int
    pub col: Int

# global node arena — all nodes live here
mut nodes: List[Node] := []

# add a node with children, return its index
pub fn add_node(kind: String, value: String, children: List[Int], line: Int, col: Int) -> Int:
    nodes.push(Node(kind, value, children, line, col))
    return nodes.len() - 1

# add a leaf node (no children), return its index
pub fn add_leaf(kind: String, value: String, line: Int, col: Int) -> Int:
    mut empty: List[Int] := []
    nodes.push(Node(kind, value, empty, line, col))
    return nodes.len() - 1

# retrieve a node by index
pub fn get_node(idx: Int) -> Node:
    return nodes[idx]

# how many nodes the arena holds. every parse appends contiguously, so
# a count taken before and after a parse brackets that parse's nodes.
pub fn node_count() -> Int:
    return nodes.len()

# get kind of node by index (avoids struct field access in caller)
pub fn node_kind(idx: Int) -> String:
    return nodes[idx].kind

# get value of node by index
pub fn node_value(idx: Int) -> String:
    return nodes[idx].value

# get number of children
pub fn node_child_count(idx: Int) -> Int:
    n := nodes[idx]
    return n.children.len()

# get child index at position
pub fn node_child(idx: Int, pos: Int) -> Int:
    n := nodes[idx]
    kids := n.children
    return kids[pos]

# clear the arena for reuse.
#
# emptying the list in place rather than rebinding it to a fresh one:
# `nodes = []` strands every node it drops, strings and child lists
# included, so a long-lived tool that runs the front end per keystroke
# grew by a whole closure's worth of nodes each time — tens of
# megabytes an edit, which walks a language server into the oom killer
# inside a couple of minutes of typing. `clear()` releases what it
# removes. the rebinding form is the one with the defect, and it is a
# defect in the emitter rather than here; this call site is only the
# one that hurt.
pub fn reset_arena():
    nodes.clear()

# drop every node added since the arena held `count` of them, leaving
# the earlier nodes — and every index into them — exactly as they were.
# parses append contiguously, so a count taken before a parse and handed
# back here undoes precisely that parse. that is what lets a throwaway
# parse share the arena with an analysis the editor is still reading
# from: without it, parsing one file to find its syntax errors would
# leave the type cache and definition map pointing at nodes that are no
# longer the ones they described.
pub fn truncate_arena(count: Int):
    if count < 0:
        return
    while nodes.len() > count:
        nodes.remove(nodes.len() - 1)
