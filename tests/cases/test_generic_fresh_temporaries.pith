# fresh temporaries inside a generic body: a one-char string from `s[i]`
# compared in a loop condition, a string call result compared as an operand,
# a field read straight off a call result, a fresh optional shell passed as
# an argument, and a container result discarded at statement position. the
# four fresh-temporary predicates and the discarded-statement release used to
# answer "borrowed" inside a generic body, so every one of these leaked its
# temporary per evaluation; with the body typed they answer as the concrete
# body's, and the values read back here show nothing is freed early.
#
# each generic function has a concrete twin printing the same line; the twin
# is the control, and the expected output is its lines.

struct Point:
    pub label: String
    pub n: Int

fn make_point(n: Int) -> Point:
    return Point(label: "p" + n.to_string(), n: n)

fn shout(s: String) -> String:
    return s + "!"

fn opt_len(v: String?) -> Int:
    if let s = v:
        return s.len()
    return 0

fn maybe(n: Int) -> String?:
    if n > 0:
        return "m" + n.to_string()
    return none

fn count_colons[T](t: T, s: String) -> Int:
    mut i := 0
    mut n := 0
    while i < s.len():
        if s[i] == ":":
            n = n + 1
        i = i + 1
    return n

fn count_colons_con(t: Int, s: String) -> Int:
    mut i := 0
    mut n := 0
    while i < s.len():
        if s[i] == ":":
            n = n + 1
        i = i + 1
    return n

fn shouted_matches[T](t: T, s: String) -> Bool:
    return shout(s) == "hey!"

fn shouted_matches_con(t: Int, s: String) -> Bool:
    return shout(s) == "hey!"

fn label_of[T](t: T, n: Int) -> String:
    return make_point(n).label

fn label_of_con(t: Int, n: Int) -> String:
    return make_point(n).label

fn optional_arg[T](t: T, n: Int) -> Int:
    return opt_len(maybe(n))

fn optional_arg_con(t: Int, n: Int) -> Int:
    return opt_len(maybe(n))

fn discarded[T](t: T, n: Int) -> Int:
    m: Map[String, Int] := {}
    m.insert("a", n)
    m.insert("b", n + 1)
    m.keys()
    m.take("a")
    return m.len()

fn discarded_con(t: Int, n: Int) -> Int:
    m: Map[String, Int] := {}
    m.insert("a", n)
    m.insert("b", n + 1)
    m.keys()
    m.take("a")
    return m.len()

fn main():
    print("{count_colons(1, "a:b:c")} {count_colons_con(1, "a:b:c")}")
    print("{shouted_matches(1, "hey")} {shouted_matches_con(1, "hey")} {shouted_matches(1, "no")}")
    print(label_of(1, 4) + " " + label_of_con(1, 4))
    print("{optional_arg(1, 12)} {optional_arg_con(1, 12)} {optional_arg(1, 0)}")
    print("{discarded(1, 5)} {discarded_con(1, 5)}")
    held := "a:b:c"
    print("{count_colons(1, held)} {held}")
