# a parameter that shares its name with a function in another module. the
# call through the parameter is a closure call, and the ir validator used to
# read it as a plain call to the function, which returns a register pair
from param_shadow_helper import run

fn handle(x: Int) -> Int!String:
    return x * 2

fn triple(x: Int) -> Int!String:
    return x * 3

fn main():
    print("{run(triple, 5)} {run(handle, 5)}")
