# std.iter — iterator protocol, eager Range, and a generic collection terminal.
#
# A type implements the iterator protocol by providing `fn next() -> T?`. The
# compiler's `for` loop sugar (added in #203) recognizes any such type and
# drives it via next(), so user-defined iterators work the same as the
# language's built-in collection loops.
#
# `to_list` (below) is the canonical terminal: it drains any iterator into a
# `List[T]`. The element type T is inferred from the `Iterator[T]` bound (see
# #204), so callers don't need explicit type arguments.

# Iterator[T]: anything yielding values of T until it runs out.
pub interface Iterator[T]:
    fn next() -> T?

# Range yields each integer in the half-open interval [lo, hi).
#
# Use this when you want a value you can hold, pass around, or pass to `to_list`.
# The for-loop sugar `for i in lo..hi:` is still faster for the common case
# because it compiles to a counted loop with no allocation.
pub struct Range:
    cur: Int
    hi: Int

impl Iterator[Int] for Range:
    fn next() -> Int?:
        if self.cur >= self.hi:
            return none
        v := self.cur
        self.cur = self.cur + 1
        return v

# Drain an iterator into a List. T is inferred from the I: Iterator[T] bound.
pub fn to_list[I: Iterator[T], T](it: I) -> List[T]:
    mut out: List[T] := []
    for x in it:
        out.push(x)
    return out

# Lazy adapters. Each one wraps a source iterator + a closure and produces a
# new iterator. A chain like `to_list(filter_iter(map_iter(src, f), p))` walks
# the source once with a single allocation at to_list — no intermediate list
# per pipeline stage.
#
# Constructors are named `map_iter` / `filter_iter` so they don't collide with
# the eager free-function `map` / `filter` builtins on List from earlier in the
# language.

# Lazy map adapter: yields f(x) for each x the source iterator yields.
pub struct MapIter[I, T, U]:
    src: I
    f: fn(T) -> U

impl Iterator[U] for MapIter:
    fn next() -> U?:
        n := self.src.next()
        if n == none:
            return none
        return self.f(n.value())

# Wrap an iterator so each yielded value passes through f.
pub fn map_iter[I: Iterator[T], T, U](src: I, f: fn(T) -> U) -> MapIter[I, T, U]:
    return MapIter[I, T, U](src, f)

# Lazy filter adapter: yields only the source values that satisfy p.
pub struct FilterIter[I, T]:
    src: I
    p: fn(T) -> Bool

impl Iterator[T] for FilterIter:
    fn next() -> T?:
        # pull from the source until the predicate accepts an element or the
        # source is exhausted
        mut n := self.src.next()
        while n != none:
            v := n.value()
            if self.p(v):
                return v
            n = self.src.next()
        return none

# Wrap an iterator so only values satisfying p come through.
pub fn filter_iter[I: Iterator[T], T](src: I, p: fn(T) -> Bool) -> FilterIter[I, T]:
    return FilterIter[I, T](src, p)
