# live grpc interop: a real unary call over the native (pure-pith) http/2
# transport. needs external network to reach a public grpc server, and skips
# when unreachable so the deterministic coverage stays in std/net/grpc's own
# tests.
#
# run with: pith test tests/live/grpc_live.pith
#
# this exercises the whole stack end to end — std.protobuf builds the request
# and parses the reply, std.net.grpc frames it and reads the grpc-status
# trailer, and std.net.http2 carries it over pith's own tls 1.3 with alpn "h2".
# grpcb.in's GRPCBin/DummyUnary echoes the DummyMessage back, so a correct
# round-trip returns our own field 1 string.

import std.net.grpc as grpc
import std.protobuf as protobuf
import std.bytes as bytes

test "a unary call round-trips through grpcb.in":
    # DummyMessage { f_string = 1 }
    w := protobuf.writer()
    w.write_string(1, "pith")!
    request := w.bytes()
    w.free()

    attempt := grpc.call("grpcb.in", 9001, "/grpcbin.GRPCBin/DummyUnary", request)
    if attempt.is_err:
        skip_test("grpc call did not complete: {attempt.err.message}")
    reply := attempt.ok

    # the echoed DummyMessage carries our string back in field 1.
    r := protobuf.reader(reply)
    mut echoed := ""
    while not r.at_end():
        tag := r.read_tag()!
        if tag.field == 1:
            echoed = r.read_string()!
        else:
            r.skip(tag.wire)!
    assert_eq(echoed, "pith")
