fn main():
    mut ks: List[String] := []
    for k in ["pear", "apple", "zebra", "fig"]:
        mut placed := false
        mut i := 0
        while i < ks.len() and not placed:
            if k < ks[i]:
                ks.insert(i, k)
                placed = true
            i = i + 1
        if not placed:
            ks.push(k)
    print("{ks}")
    print("{"a" < "b"}")
    print("{"b" <= "b"}")
    print("{"c" > "b"}")
    print("{"a" >= "b"}")
    print("{"abc" < "abd"}")
    print("{"ab" < "abc"}")
