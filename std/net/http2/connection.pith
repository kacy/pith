# std.net.http2.connection — the http/2 connection lifecycle and a GET.
#
# a connection runs the http/2 handshake (the client preface plus a SETTINGS
# exchange) over a transport, then drives one request stream to completion. it
# builds on the frame codec (std.net.http2.frames) and hpack header compression
# (std.net.http2.hpack): the request is a HEADERS frame carrying an hpack block,
# the response is a HEADERS block followed by DATA frames until end-of-stream.
#
#   r := connection.get("https://www.cloudflare.com/")!
#   print("status {r.status}, {r.body.len()} bytes")
#
# this is the synchronous, single-stream core. it reads and writes frames in
# lockstep on one caller, which trivially honors http/2's rule that one reader
# hpack-decodes header blocks in receive order. the concurrent multiplexing
# layer (a spawned reader loop and per-stream channels) sits on top of this in a
# later phase and reuses the same codec.
#
# it coexists with the h2-crate-backed std.net.http2.get during the migration;
# both target the same servers so they can be checked against each other.

# the http2 codec modules are imported before std.net.tls on purpose. the
# self-hosted checker's module loader currently gives std.binary's Reader type
# two identities when tls's large import graph is visited before the codec
# modules that also import std.binary, which surfaces as spurious "expected
# Reader, got Reader" errors. importing frames and hpack first keeps binary
# single-identity. this is a loader-ordering bug worth fixing at the source.
import std.net.http2.frames as frames
import std.net.http2.hpack as hpack
import std.bytes as bytes
import std.binary as binary
import std.encoding as encoding
import std.net.url as url
import std.net.tls as tls
import std.time as time

# --- settings identifiers (RFC 9113 §6.5.2) ---

# SETTINGS_HEADER_TABLE_SIZE — the peer's hpack dynamic table bound.
pub SETTINGS_HEADER_TABLE_SIZE := 1
# SETTINGS_ENABLE_PUSH — whether the peer may push streams (0 disables it).
pub SETTINGS_ENABLE_PUSH := 2
# SETTINGS_MAX_CONCURRENT_STREAMS — the cap on simultaneously open streams.
pub SETTINGS_MAX_CONCURRENT_STREAMS := 3
# SETTINGS_INITIAL_WINDOW_SIZE — the initial per-stream flow-control window.
pub SETTINGS_INITIAL_WINDOW_SIZE := 4
# SETTINGS_MAX_FRAME_SIZE — the largest frame payload the peer will accept.
pub SETTINGS_MAX_FRAME_SIZE := 5
# SETTINGS_MAX_HEADER_LIST_SIZE — the largest header list the peer will accept.
pub SETTINGS_MAX_HEADER_LIST_SIZE := 6

# the default connection and stream flow-control window (RFC 9113 §6.9.2).
pub DEFAULT_INITIAL_WINDOW := 65535

# bound a header block while following CONTINUATION frames, so a hostile server
# cannot stream endless CONTINUATION frames that never set END_HEADERS to grow an
# unbounded buffer. mirrors the http/2 server's caps: a byte ceiling a little above
# a typical header list, plus a frame-count cap that stops a flood of tiny or empty
# CONTINUATION frames.
MAX_HEADER_BLOCK_BYTES := 81920
MAX_CONTINUATION_FRAMES := 64

# the hex of the 24-byte client connection preface,
# "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" (RFC 9113 §3.4). encoded as hex so the
# carriage returns and line feeds are unambiguous in source.
PREFACE_HEX := "505249202a20485454502f322e300d0a0d0a534d0d0a0d0a"

# the client connection preface bytes, sent before any frame.
fn client_preface() -> Bytes:
    return encoding.from_hex(PREFACE_HEX) catch bytes.empty()

# --- response ---

# an http/2 response: the status code, decoded header fields, the trailing
# header fields (empty when the peer sends none), and the body bytes. trailers
# are a second header block after the body; grpc carries its grpc-status there.
pub struct Response:
    pub status: Int
    pub headers: List[hpack.HeaderField]
    pub trailers: List[hpack.HeaderField]
    pub body: Bytes

# --- connection ---

# a synchronous http/2 connection over one transport. the handle addresses the
# tls session over tls, or the raw socket fd when `plaintext` (h2c); `live` marks
# it connected either way. when not live the connection reads from a preloaded
# `buf` and records writes in `sent`, which the tests drive. `buf` and `pos` are
# the receive buffer coalescing partial socket reads (frames can span reads), and
# the encoder/decoder carry the two hpack dynamic tables.
pub struct Connection:
    mut tls_handle: Int
    mut live: Bool
    mut buf: Bytes
    mut pos: Int
    mut encoder: hpack.Encoder
    mut decoder: hpack.Decoder
    mut next_stream_id: Int
    mut sent: Bytes
    # true for an h2c (plaintext) connection: the handle is a raw socket fd and
    # transport i/o goes through tcp rather than the tls session.
    mut plaintext: Bool

# build a live connection over an established tls session handle.
fn new_live_connection(handle: Int) -> Connection:
    return Connection(handle, true, bytes.empty(), 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, true), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), 1, bytes.empty(), false)

# build a live h2c (plaintext) connection over an open socket fd.
fn new_h2c_connection(fd: Int) -> Connection:
    return Connection(fd, true, bytes.empty(), 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, true), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), 1, bytes.empty(), true)

# build an offline connection that reads `data` as if it arrived from a peer.
# used by the tests to drive the read loop over a constructed frame stream.
fn connection_from_frames(data: Bytes) -> Connection:
    return Connection(0, false, data, 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), 1, bytes.empty(), false)

# the SETTINGS frame the client opens with: no server push, the default window,
# and the default max frame size (so a peer must not send larger frames).
fn initial_settings_frame() -> frames.Frame!:
    params := [frames.setting(SETTINGS_ENABLE_PUSH, 0), frames.setting(SETTINGS_INITIAL_WINDOW_SIZE, DEFAULT_INITIAL_WINDOW), frames.setting(SETTINGS_MAX_FRAME_SIZE, frames.DEFAULT_MAX_FRAME_SIZE)]
    return frames.settings_frame(params)!

# find the ":status" pseudo-header and parse it, or 0 when absent.
fn status_from(headers: List[hpack.HeaderField]) -> Int:
    for header in headers:
        if header.name == ":status":
            return parse_int(header.value).unwrap_or(0)
    return 0

impl Connection:
    # the request :scheme pseudo-header: "http" for an h2c connection, "https"
    # over tls.
    fn scheme() -> String:
        if self.plaintext:
            return "http"
        return "https"

    # read one transport chunk: the socket when live (tcp for h2c, the tls session
    # otherwise), or nothing when offline (the buffer is exhausted, read as eof).
    fn recv_chunk() -> Bytes!:
        if self.live:
            if self.plaintext:
                return tcp_read_bytes(self.tls_handle, 16384)!
            return tls.conn_from_handle(self.tls_handle).read_bytes(16384)!
        return bytes.empty()

    # ensure at least `n` unread bytes are buffered, pulling transport chunks as
    # needed. fails if the transport closes first. the read cursor (`pos`) means
    # a frame can be sliced out in one piece rather than copying its header and
    # payload separately; the consumed prefix is dropped only when a new chunk is
    # pulled, so steady-state reading does not re-concat the buffer per frame.
    fn fill(n: Int) -> Int!:
        while self.buf.len() - self.pos < n:
            chunk := self.recv_chunk()!
            if chunk.len() == 0:
                fail "http2: connection closed"
            self.buf = bytes.concat(self.buf.slice(self.pos, self.buf.len()), chunk)
            self.pos = 0
        return 0

    # read one frame off the transport: the 9-byte header gives the payload
    # length, then the whole frame (header + payload) is sliced out in one piece
    # and the cursor advanced — no separate head/payload slices, no concat to
    # rejoin them. the codec's reader then parses and bounds-checks it.
    fn read_frame() -> frames.Frame!:
        self.fill(9)!
        length_res := binary.read_u24_be_at(self.buf, self.pos)
        if length_res.is_err:
            fail length_res.err.message
        total := 9 + length_res.ok
        self.fill(total)!
        full := self.buf.slice(self.pos, self.pos + total)
        self.pos = self.pos + total
        return frames.read_frame(binary.reader(full), frames.DEFAULT_MAX_FRAME_SIZE)!

    # write raw bytes to the transport (tcp for h2c, the tls session otherwise),
    # or record them when offline.
    fn send(data: Bytes) -> Int!:
        if self.live:
            if self.plaintext:
                return tcp_write_bytes(self.tls_handle, data)!
            return tls.conn_from_handle(self.tls_handle).write_all_bytes(data)!
        self.sent = bytes.concat(self.sent, data)
        return data.len()

    # serialize and send one frame.
    fn send_frame(frame: frames.Frame) -> Int!:
        wire := frames.frame_bytes(frame)!
        n := self.send(wire)!
        return n

    # send the preface and the opening SETTINGS. the response read loop acks the
    # peer's SETTINGS when it arrives, so no separate wait is needed here.
    fn handshake() -> Bool!:
        self.send(client_preface())!
        self.send_frame(initial_settings_frame()!)!
        return true

    # read a complete header block, following CONTINUATION frames until the
    # END_HEADERS flag. per RFC 9113 §6.10 nothing else may interleave, so this
    # reads frames directly rather than going through the main loop.
    fn read_header_block(first: frames.HeadersFrame) -> Bytes!:
        out := bytes.buffer()
        defer out.free()
        out.write(first.block_fragment)!
        mut done := first.end_headers
        mut continuations := 0
        while not done:
            frame := self.read_frame()!
            if frame.header.frame_type != frames.FRAME_CONTINUATION:
                fail "http2: expected a CONTINUATION frame to complete the header block"
            if frame.header.stream_id != first.stream_id:
                fail "http2: CONTINUATION frame on the wrong stream"
            continuations = continuations + 1
            if continuations > MAX_CONTINUATION_FRAMES:
                fail "http2: too many CONTINUATION frames in one header block"
            cont := frames.parse_continuation(frame)!
            out.write(cont.block_fragment)!
            if out.len() > MAX_HEADER_BLOCK_BYTES:
                fail "http2: header block exceeds the maximum size"
            done = cont.end_headers
        return out.bytes()

    # grant flow-control credit for `amount` consumed body bytes: always at the
    # connection level, and at the stream level while the stream stays open.
    fn replenish(stream_id: Int, amount: Int, end_stream: Bool) -> Bool!:
        if amount <= 0:
            return true
        self.send_frame(frames.window_update_frame(0, amount)!)!
        if not end_stream:
            self.send_frame(frames.window_update_frame(stream_id, amount)!)!
        return true

    # read frames until `stream_id` ends, assembling the response. servicing
    # connection housekeeping along the way: ack SETTINGS, answer PING, honor
    # GOAWAY and RST_STREAM, and replenish flow-control credit as body arrives.
    fn read_response(stream_id: Int) -> Response!:
        body := bytes.buffer()
        defer body.free()
        mut status := 0
        mut headers: List[hpack.HeaderField] := []
        mut trailers: List[hpack.HeaderField] := []
        mut got_headers := false
        while true:
            frame := self.read_frame()!
            t := frame.header.frame_type
            if t == frames.FRAME_HEADERS:
                hf := frames.parse_headers(frame)!
                block := self.read_header_block(hf)!
                # always decode to keep the hpack dynamic table in lockstep.
                decoded := self.decoder.decode(block)!
                if hf.stream_id == stream_id:
                    # the first header block is the response; a later one (after
                    # the body has begun) is the trailers.
                    if not got_headers:
                        headers = decoded
                        status = status_from(decoded)
                        got_headers = true
                    else:
                        trailers = decoded
                    if hf.end_stream:
                        return Response(status, headers, trailers, body.bytes())
            elif t == frames.FRAME_DATA:
                df := frames.parse_data(frame)!
                if df.stream_id == stream_id:
                    body.write(df.data)!
                    # flow control counts the whole frame payload, padding included.
                    self.replenish(stream_id, frame.header.length, df.end_stream)!
                    if df.end_stream:
                        return Response(status, headers, trailers, body.bytes())
            elif t == frames.FRAME_SETTINGS:
                sf := frames.parse_settings(frame)!
                if not sf.ack:
                    self.send_frame(frames.settings_ack_frame())!
            elif t == frames.FRAME_PING:
                pf := frames.parse_ping(frame)!
                if not pf.ack:
                    self.send_frame(frames.ping_ack_frame(pf.opaque)!)!
            elif t == frames.FRAME_GOAWAY:
                ga := frames.parse_goaway(frame)!
                if ga.last_stream_id < stream_id:
                    fail "http2: server sent GOAWAY ({frames.error_name(ga.error_code)}) before serving stream {stream_id}"
            elif t == frames.FRAME_RST_STREAM:
                rs := frames.parse_rst_stream(frame)!
                if rs.stream_id == stream_id:
                    fail "http2: stream {stream_id} was reset by the peer ({frames.error_name(rs.error_code)})"
            # WINDOW_UPDATE, PRIORITY, PUSH_PROMISE and unknown types need no
            # action to complete a single response, so they are ignored here.

    # send a GET on the next client stream and read its response.
    fn request_get(authority: String, path: String) -> Response!:
        stream_id := self.next_stream_id
        self.next_stream_id = self.next_stream_id + 2
        request := [hpack.header_field(":method", "GET"), hpack.header_field(":path", path), hpack.header_field(":scheme", self.scheme()), hpack.header_field(":authority", authority)]
        block := self.encoder.encode(request)
        self.send_frame(frames.headers_frame(stream_id, block, true, true))!
        return self.read_response(stream_id)!

    # close the underlying transport.
    pub fn close():
        if self.live:
            if self.plaintext:
                tcp_close(self.tls_handle)
            else:
                tls.conn_from_handle(self.tls_handle).close()

# open a connection to `host`:`port` using the caller's tls `config` and run the
# handshake. the config must offer alpn "h2"; use this to trust a private ca or
# otherwise customize tls. fails if the peer does not negotiate http/2.
pub fn connect_with_config(host: String, port: Int, config: tls.Config) -> Connection!:
    session := tls.dial_with_config(host, port, host, config)!
    negotiated := session.negotiated_protocol()
    if negotiated != "h2":
        session.close()
        fail "http2: server did not negotiate h2 (alpn '{negotiated}')"
    conn := new_live_connection(session.handle)
    conn.handshake()!
    return conn

# open a connection to `host`:`port` over tls with alpn "h2", trusting the system
# roots, and run the handshake. fails if the peer does not negotiate http/2.
pub fn connect(host: String, port: Int) -> Connection!:
    return connect_with_config(host, port, tls.client_config()!.with_alpn(["h2"]))!

# open an h2c (plaintext, prior-knowledge) connection to `host`:`port` and run the
# handshake. no tls, no alpn — the client assumes the peer speaks http/2 and opens
# with the preface, per RFC 9113 §3.3. for a server reached over tls, use connect.
pub fn connect_h2c(host: String, port: Int) -> Connection!:
    fd := tcp_connect(host, port)!
    conn := new_h2c_connection(fd)
    conn.handshake()!
    return conn

# the parts of an https url a request needs: where to connect and what to ask
# for. `authority` is the value of the :authority pseudo-header (host, plus the
# port when it is not the default 443).
struct Target:
    host: String
    port: Int
    authority: String
    path: String

# parse an https url into a connect target. fails on a non-https scheme or a
# missing host.
fn parse_target(url_string: String) -> Target!:
    handle := url.parse(url_string)
    scheme := url.scheme(handle)
    host := url.host(handle)
    if host == "":
        fail "http2: could not parse a host from '{url_string}'"
    if scheme != "https":
        fail "http2: only https urls are supported (got scheme '{scheme}')"
    mut port := url.port(handle)
    if port <= 0:
        port = 443
    mut path := url.path(handle)
    if path == "":
        path = "/"
    query := url.query(handle)
    if query != "":
        path = path + "?" + query
    mut authority := host
    if port != 443:
        authority = "{host}:{port}"
    return Target(host, port, authority, path)

# GET an https url over native http/2 on a fresh single-stream connection and
# return the response. fails on a connection, tls, alpn, or protocol error. use
# open_url when you want to multiplex several requests over one connection.
pub fn get(url_string: String) -> Response!:
    target := parse_target(url_string)!
    conn := connect(target.host, target.port)!
    attempt := conn.request_get(target.authority, target.path)
    conn.close()
    if attempt.is_err:
        fail attempt.err
    return attempt.ok

# --- concurrent multiplexing: many streams over one connection ---
#
# the synchronous get above drives one stream in lockstep. real http/2
# multiplexes many streams over a single connection, and that is where pith's
# concurrency primitives earn their keep. a Client keeps exactly one task on
# each direction of the socket, which is what the tls layer requires (its read
# and write paths touch disjoint per-connection state, so read and write may run
# at once, but two readers or two writers may not):
#
#   - one reader task reads every frame in receive order and hands it to the
#     waiting stream. hpack decoding is stateful, so a single reader decoding in
#     receive order is mandatory, not merely convenient.
#   - one writer task drains an outbound frame channel, so socket writes never
#     overlap. header blocks are hpack-encoded under the client mutex in
#     stream-id order — which is also their wire order — keeping the peer's
#     decoder in step and stream ids monotonic (RFC 9113 §5.1.1).
#   - each request opens a stream, hands its frames to the writer, and reads its
#     own events off a per-stream channel until end-of-stream.

# the kind tags of a stream event. `kind` selects which StreamEvent fields carry
# meaning.
STREAM_HEADERS := 1
STREAM_DATA := 2
STREAM_RESET := 3
# a whole unary response coalesced into one event: `headers`, `trailers`, and the
# full body together (see the reader's unary batching below). the streaming path
# never uses this kind — it must see each frame incrementally.
STREAM_UNARY := 4

# an event the reader task delivers to a waiting stream. headers carry the
# decoded fields, data carries a body chunk, and reset carries the peer's error
# code; `end` marks the final event of the stream. `trailers` is populated only
# on a STREAM_UNARY event, which carries a whole unary response at once.
pub struct StreamEvent:
    pub kind: Int
    pub headers: List[hpack.HeaderField]
    pub trailers: List[hpack.HeaderField]
    pub data: Bytes
    pub end: Bool
    pub error_code: Int

# DATA, RESET, and the trailer slot of HEADERS events carry no header fields; they
# share one empty list rather than allocating a fresh one per frame (data events
# are the response hot path). consumers only read the shared list, never mutate it.
fn empty_fields() -> List[hpack.HeaderField]:
    fields: List[hpack.HeaderField] := []
    return fields

NO_FIELDS := empty_fields()

# build a HEADERS stream event (response headers, or trailers once the body has
# begun); `end` marks it as the stream's final event.
pub fn headers_event(fields: List[hpack.HeaderField], end: Bool) -> StreamEvent:
    return StreamEvent(STREAM_HEADERS, fields, NO_FIELDS, bytes.empty(), end, 0)

# build a coalesced unary response event: the response headers, the trailers, and
# the full body in one event. the reader accumulates a unary stream's three frames
# (headers, data, trailer headers) and delivers this single event at end-of-stream,
# so the waiting worker wakes once instead of once per frame. always the final
# event of its stream.
pub fn unary_event(headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField], body: Bytes) -> StreamEvent:
    return StreamEvent(STREAM_UNARY, headers, trailers, body, true, 0)

# build a DATA stream event carrying a body chunk; `end` marks end-of-stream.
pub fn data_event(chunk: Bytes, end: Bool) -> StreamEvent:
    return StreamEvent(STREAM_DATA, NO_FIELDS, NO_FIELDS, chunk, end, 0)

# build a RESET stream event carrying the peer's error code.
pub fn reset_event(code: Int) -> StreamEvent:
    return StreamEvent(STREAM_RESET, NO_FIELDS, NO_FIELDS, bytes.empty(), false, code)

impl StreamEvent:
    # whether this event carries a decoded header block (response headers or,
    # once the body has begun, trailers).
    pub fn is_headers() -> Bool:
        return self.kind == STREAM_HEADERS

    # whether this event carries a body chunk.
    pub fn is_data() -> Bool:
        return self.kind == STREAM_DATA

    # whether this event is a stream reset (RST_STREAM); `error_code` carries the
    # peer's reason.
    pub fn is_reset() -> Bool:
        return self.kind == STREAM_RESET

# the per-stream inbox capacity. large enough that the reader rarely blocks
# handing an event to a stream whose consumer is momentarily behind.
STREAM_INBOX_CAP := 256
# the shared outbound frame buffer. the writer drains it continuously, so a
# generous buffer keeps request() and the reader from stalling as they enqueue.
OUTBOUND_CAP := 256
# a per-stream flow-control credit poke: capacity one, since a blocked body
# sender only needs to learn "a send window grew, re-check it". coalesced pokes
# never lose a wakeup — if one is already buffered, the sender will still wake.
CREDIT_POKE_CAP := 1
# the concurrent-stream admission poke buffer: a freed stream slot pokes a
# waiting request(). a generous buffer keeps freed slots from being lost when
# several requests are queued behind the peer's MAX_CONCURRENT_STREAMS limit.
SLOT_POKE_CAP := 256

# the client's socket-ownership mode (see the "inline fast-path" note below).
# INLINE runs a single in-flight request synchronously on the caller; PROMOTING
# is the brief transition; THREADED is the reader/writer pipeline. mode only ever
# moves forward, INLINE -> PROMOTING -> THREADED, never back.
MODE_INLINE := 0
MODE_PROMOTING := 1
MODE_THREADED := 2

# a multiplexed http/2 client over one connection. many request() calls share
# it. the mutex guards the stream table, the id counter, the closed/going-away
# flags, and the last stream the peer promised to serve; the channels are
# already safe to use across tasks. `active` mirrors the stream-table keys
# because Map[Int, _].keys() does not yet enumerate int keys.
#
# --- the inline fast-path ---
#
# a client starts in MODE_INLINE and runs a single in-flight request/response
# synchronously on the calling thread — the same lockstep codec the one-shot
# get() uses — with no channel handoffs. this is the whole win for sequential
# traffic (the common grpc unary case): one thread, one write, no arbitration,
# because with only one stream in flight there is nothing to coalesce and no
# hpack ordering to referee.
#
# the client promotes to the threaded pipeline, exactly once, the first time a
# second stream wants the connection at the same time (a concurrent request, or
# any streaming rpc). promotion is a one-way latch: a client that has ever seen
# concurrency stays THREADED for the rest of its life, and concurrent behaviour
# is then exactly what it was before this fast-path existed.
#
# both the reader and the writer tasks are spawned up front, but they stay parked
# through the inline phase so they never touch the socket while an inline call
# owns it. the writer parks on `outbound` (an inline call writes to the socket
# directly, so nothing is ever queued); the reader parks on `promote_gate` and
# does not read a single frame until it is released. parking them costs no
# latency — the inline hot path never hands off to either — and it keeps the spawn
# out of the request path, where spawning the reader has proven unreliable. the
# tasks also hold the live references that keep the connection pinned for the
# client's lifetime.
#
# promotion is the delicate part: the reader must not read the socket or touch
# the hpack decoder while an inline call still owns them (two readers on one tls
# session are illegal, and the decoder is single-owner by protocol). `gate`
# guards the small state machine (`mode` and `inline_busy`, an inline call's
# lease on the socket + codec). the promoter latches `mode`, waits on `handoff`
# for any in-flight inline call to drop its lease, releases the reader through
# `promote_gate`, and closes `ready` to wake any other caller that was waiting on
# the promotion. `gate` is deliberately a separate lock from `mu`: the inline
# lease is released under `gate` only, so it can never be blocked behind a
# threaded caller that is holding `mu` while it waits on a full `outbound`.
#
# `writer` is the writer's handle, awaited on close() so a final GOAWAY flushes
# before the transport drops.
pub struct Client:
    conn: Connection
    mu: Mutex
    mut next_stream_id: Int
    streams: Map[Int, Channel[StreamEvent]]
    mut active: List[Int]
    # the ids of streams the reader should coalesce: a unary request()/get() marks
    # its stream here so the reader batches its three response frames into one
    # STREAM_UNARY event. a streaming stream is never marked, so its events flow
    # incrementally. presence means unary; removed when the stream is forgotten.
    unary: Map[Int, Bool]
    outbound: Channel[Bytes]
    closed: AtomicInt
    mut going_away: Bool
    mut last_peer_stream: Int
    writer: Task[Int]
    # the peer's advertised limits (RFC 9113 §6.5.2), applied from its SETTINGS.
    # the frame size bounds our outbound HEADERS (split into CONTINUATION past
    # it); the header-list size, when non-zero, caps a request's uncompressed
    # header footprint before it is sent.
    mut peer_max_frame_size: Int
    mut peer_max_header_list: Int
    # send-side flow control (RFC 9113 §6.9). we may not send more DATA than the
    # peer's windows allow. `conn_send_window` is the connection-level credit
    # (starts at the default, grows only on a stream-0 WINDOW_UPDATE);
    # `send_windows` holds each open stream's credit; `peer_initial_window` is
    # the value new stream windows start at (the peer's SETTINGS_INITIAL_WINDOW_SIZE).
    # `credit` pokes a stream's blocked body sender when a window grows.
    mut conn_send_window: Int
    mut peer_initial_window: Int
    send_windows: Map[Int, Int]
    credit: Map[Int, Channel[Int]]
    # the peer's SETTINGS_MAX_CONCURRENT_STREAMS (0 = unlimited). request() waits
    # on `slot_free` for a slot when the cap is reached; forget() pokes it.
    mut max_concurrent: Int
    slot_free: Channel[Int]
    # the inline fast-path state (see the struct note above). `gate` guards `mode`
    # and `inline_busy`; `handoff` (capacity 1) lets the promoter wait for an
    # in-flight inline call to release the socket; `promote_gate` (capacity 1)
    # releases the parked reader when the client promotes; `ready` is closed once
    # the pipeline is up so any threaded caller that arrived mid-promotion can
    # proceed.
    gate: Mutex
    mut mode: Int
    mut inline_busy: Bool
    handoff: Channel[Int]
    ready: Channel[Int]
    promote_gate: Channel[Int]

# a single http/2 stream: an opened request whose body and response flow
# incrementally, for streaming rpcs (grpc server-, client-, and bidi-streaming).
# `send` writes DATA (half-closing on the last), `recv` pulls the next event
# (response headers, a body chunk, trailers, or a reset) as the reader delivers
# it. the client's request()/get() ride the same machinery but accumulate the
# events into a Response. `inbox` is the same channel registered in the client's
# stream table, held directly so recv() avoids a per-call table lookup.
pub struct Stream:
    client: Client
    pub id: Int
    inbox: Channel[StreamEvent]

impl Stream:
    # send a chunk of the request body, half-closing the stream (END_STREAM on the
    # final DATA frame) when `end_stream` is set. flow-controlled and chunked to
    # the peer's max frame size. blocks until the chunk is sent or the connection
    # drops; the reader task grants credit meanwhile, so this never deadlocks.
    # returns the bytes sent.
    pub fn send(data: Bytes, end_stream: Bool) -> Int:
        return send_stream_data(self.client, self.id, data, end_stream)

    # pull the next event off this stream: a HEADERS event (response headers, or
    # trailers if the body has begun), a DATA chunk with its end flag, or a RESET.
    # fails when the connection closed before the stream completed.
    pub fn recv() -> StreamEvent!:
        opt := self.inbox.recv()
        if opt == none:
            fail "http2: connection closed before the stream completed"
        return opt?

    # abandon the stream: reset it (CANCEL) if it is still open, then drop it from
    # the client's table and free its concurrency slot. safe to call once done.
    fn close():
        rst := frames.rst_stream_frame(self.id, frames.ERROR_CANCEL)
        if not rst.is_err:
            wire := frames.frame_bytes(rst.ok)
            if not wire.is_err:
                self.client.outbound.send(wire.ok)
        self.client.forget(self.id)

# a placeholder write task for offline clients, which drive the reader directly
# and never spawn a real writer over the shared outbound channel.
fn idle_writer() -> Int:
    return 0

# build a multiplexed client over an already-open connection, ready to serve
# requests inline. the client starts in MODE_INLINE; the reader and writer tasks
# are spawned now but stay parked (the reader on `promote_gate`, the writer on
# `outbound`) until the client promotes, so an inline call has the socket to
# itself (see the Client note and ensure_threaded). shared by open and
# open_with_config.
fn client_from_connection(conn: Connection) -> Client:
    ids: List[Int] := []
    table: Map[Int, Channel[StreamEvent]] := {}
    unary_streams: Map[Int, Bool] := {}
    windows: Map[Int, Int] := {}
    credit: Map[Int, Channel[Int]] := {}
    outbound := Channel[Bytes](OUTBOUND_CAP)
    closed := AtomicInt(0)
    # spawn the writer before the client exists so its handle can be stored. it
    # parks on `outbound` through the inline phase (inline calls write directly)
    # and is ready to drain it the moment the client promotes.
    writer := spawn writer_loop(outbound, conn, closed)
    client := Client(conn, Mutex(), 1, table, ids, unary_streams, outbound, closed, false, 0, writer, frames.DEFAULT_MAX_FRAME_SIZE, 0, DEFAULT_INITIAL_WINDOW, DEFAULT_INITIAL_WINDOW, windows, credit, 0, Channel[Int](SLOT_POKE_CAP), Mutex(), MODE_INLINE, false, Channel[Int](1), Channel[Int](1), Channel[Int](1))
    # spawn the reader too, but it parks on `promote_gate` and reads nothing until
    # promotion releases it. spawning both tasks here — never from the request
    # path — keeps task startup off the hot path and has proven the reliable place
    # to start the reader.
    spawn reader_loop(client)
    return client

# open a multiplexed client to host:port over tls with alpn "h2", trusting the
# system roots. the first sequential requests run inline; the client promotes to
# the reader/writer pipeline once concurrency appears. call close() when done.
pub fn open(host: String, port: Int) -> Client!:
    conn := connect(host, port)!
    return client_from_connection(conn)

# open a multiplexed h2c (plaintext, prior-knowledge) client to host:port. like
# open, but no tls — for a server that speaks http/2 in the clear. call close()
# when done.
pub fn open_h2c(host: String, port: Int) -> Client!:
    conn := connect_h2c(host, port)!
    return client_from_connection(conn)

# open a multiplexed client using the caller's tls `config` (which must offer
# alpn "h2") — for example one that trusts a private ca. otherwise like open.
pub fn open_with_config(host: String, port: Int, config: tls.Config) -> Client!:
    conn := connect_with_config(host, port, config)!
    return client_from_connection(conn)

# open a multiplexed client from an https url (using its host and port).
pub fn open_url(url_string: String) -> Client!:
    target := parse_target(url_string)!
    return open(target.host, target.port)!

# a pool of n independent http/2 connections to the same host:port. a single
# connection's reader/writer pipeline is ~one-core-bound, so concurrent requests
# spread round-robin across the pool run on separate cores — the same reason
# grpc clients open multiple subchannels. keep n at or below the core count for
# a throughput gain; close() shuts every connection down.
pub struct Pool:
    clients: List[Client]
    mut next: Int
    pick: Mutex

impl Pool:
    # the index of the next connection, round-robin, safe across concurrent callers.
    fn choose() -> Int:
        self.pick.lock()
        i := self.next
        self.next = (self.next + 1) % self.clients.len()
        self.pick.unlock()
        return i

    # send a request over the next pooled connection; otherwise like Client.request.
    pub fn request(method: String, authority: String, path: String, extra: List[hpack.HeaderField], body: Bytes) -> Response!:
        return self.clients[self.choose()].request(method, authority, path, extra, body)

    # open a stream over the next pooled connection; otherwise like Client.open_stream.
    pub fn open_stream(method: String, authority: String, path: String, extra: List[hpack.HeaderField], end_stream: Bool) -> Stream!:
        return self.clients[self.choose()].open_stream(method, authority, path, extra, end_stream)

    # close every pooled connection.
    pub fn close():
        for c in self.clients:
            c.close()

# open a pool of n http/2 connections to host:port over tls (alpn "h2"), trusting
# the system roots. reuse it for many concurrent requests; close() when done.
pub fn open_pool(host: String, port: Int, n: Int) -> Pool!:
    mut clients: List[Client] := []
    mut i := 0
    while i < n:
        clients.push(open(host, port)!)
        i = i + 1
    return Pool(clients: clients, next: 0, pick: Mutex())

# like open_pool but dialing each connection with the caller's tls `config`
# (which must offer alpn "h2") — e.g. one trusting a private ca.
pub fn open_pool_with_config(host: String, port: Int, n: Int, config: tls.Config) -> Pool!:
    mut clients: List[Client] := []
    mut i := 0
    while i < n:
        clients.push(open_with_config(host, port, config)!)
        i = i + 1
    return Pool(clients: clients, next: 0, pick: Mutex())

# drop `target` from an id list, returning the remaining ids.
fn list_remove_int(items: List[Int], target: Int) -> List[Int]:
    mut out: List[Int] := []
    for item in items:
        if item != target:
            out.push(item)
    return out

# the reader task: once released, read frames until the connection ends, demuxing
# each to its stream and servicing connection housekeeping. a read error tears the
# whole connection down; a protocol error additionally sends a GOAWAY naming the
# fault before failing every waiting stream so their request() calls unblock.
fn reader_loop(client: Client):
    # park until the client promotes. through the inline phase the inline call
    # owns the socket, so the reader must not read a single frame. close() before
    # any promotion closes the gate instead, which also releases us; either way we
    # bail immediately if the client has been closed.
    client.promote_gate.recv()
    if client.closed.load() != 0:
        return
    # per-stream accumulators for unary streams, private to this one reader thread
    # so no lock guards them. a unary stream's response frames are gathered here
    # and flushed as a single event (see handle_frame's unary batching).
    accums: Map[Int, UnaryAccum] := {}
    while true:
        attempt := client.conn.read_frame()
        if attempt.is_err:
            fail_all(client)
            return
        outcome := handle_frame(client, attempt.ok, accums)
        if outcome.is_err:
            # a frame we could not process is a connection-level protocol error:
            # tell the peer why, then drop every stream.
            send_goaway(client, frames.ERROR_PROTOCOL_ERROR)
            fail_all(client)
            return
        if not outcome.ok:
            fail_all(client)
            return

# the reader's running state for a unary stream: the response headers, the
# trailers, and the body assembled from its DATA frames. it lives only on the
# reader thread (in the reader's `accums` map), so it needs no lock. `to_event`
# packs it into the single event the worker receives.
struct UnaryAccum:
    mut headers: List[hpack.HeaderField]
    mut trailers: List[hpack.HeaderField]
    mut body: Bytes
    mut got_headers: Bool

# a fresh accumulator with empty headers, trailers, and body.
fn new_unary_accum() -> UnaryAccum:
    empty_headers: List[hpack.HeaderField] := []
    empty_trailers: List[hpack.HeaderField] := []
    return UnaryAccum(empty_headers, empty_trailers, bytes.empty(), false)

impl UnaryAccum:
    # the coalesced event carrying the whole response.
    fn to_event() -> StreamEvent:
        return unary_event(self.headers, self.trailers, self.body)

# whether the reader should coalesce this stream's frames. an already-open
# accumulator answers yes immediately; otherwise the first frame of a stream the
# caller marked unary opens one. a streaming stream is never marked, so this stays
# false and its frames are delivered one at a time.
fn accumulating(client: Client, accums: Map[Int, UnaryAccum], stream_id: Int) -> Bool:
    if accums.contains_key(stream_id):
        return true
    if client.is_unary(stream_id):
        accums.insert(stream_id, new_unary_accum())
        return true
    return false

# dispatch one frame. returns false when the reader should stop (the connection
# has fully wound down after a GOAWAY). `accums` holds the reader's per-stream
# state for unary streams whose frames are being coalesced.
#
# a unary response is three frames — response HEADERS, DATA, trailer HEADERS —
# and delivering each as its own event wakes the waiting worker three times, one
# kernel context switch each. for a stream the caller marked unary we instead
# accumulate the three frames here and deliver a single STREAM_UNARY event at
# end-of-stream, so the worker wakes once. streaming streams are never marked, so
# their events still flow one frame at a time (a server-streaming response must
# reach the caller incrementally, never buffered to end-of-stream).
fn handle_frame(client: Client, frame: frames.Frame, accums: Map[Int, UnaryAccum]) -> Bool!:
    t := frame.header.frame_type
    if t == frames.FRAME_HEADERS:
        hf := frames.parse_headers(frame)!
        block := client.conn.read_header_block(hf)!
        # decode in receive order to keep the single hpack table in step.
        decoded := client.conn.decoder.decode(block)!
        if accumulating(client, accums, hf.stream_id):
            a := accums[hf.stream_id]
            # the first header block is the response headers; a later one (after
            # the body has begun) is the trailers.
            if not a.got_headers:
                a.headers = decoded
                a.got_headers = true
            else:
                a.trailers = decoded
            if hf.end_stream:
                deliver(client, hf.stream_id, a.to_event())
                accums.remove(hf.stream_id)
        else:
            deliver(client, hf.stream_id, headers_event(decoded, hf.end_stream))
        return true
    if t == frames.FRAME_DATA:
        df := frames.parse_data(frame)!
        if accumulating(client, accums, df.stream_id):
            a := accums[df.stream_id]
            a.body = bytes.concat(a.body, df.data)
            if df.end_stream:
                deliver(client, df.stream_id, a.to_event())
                accums.remove(df.stream_id)
        else:
            deliver(client, df.stream_id, data_event(df.data, df.end_stream))
        # flow control counts the whole frame payload, padding included.
        client.replenish(df.stream_id, frame.header.length, df.end_stream)!
        return true
    if t == frames.FRAME_SETTINGS:
        sf := frames.parse_settings(frame)!
        if not sf.ack:
            apply_settings(client, sf.settings)
            client.enqueue(frames.settings_ack_frame())!
        return true
    if t == frames.FRAME_PING:
        pf := frames.parse_ping(frame)!
        if not pf.ack:
            client.enqueue(frames.ping_ack_frame(pf.opaque)!)!
        return true
    if t == frames.FRAME_WINDOW_UPDATE:
        wu := frames.parse_window_update(frame)!
        # a zero increment is a protocol error (RFC 9113 §6.9). otherwise the
        # credit grows a send window; apply it and wake any blocked body sender.
        if wu.increment == 0:
            fail "http2: WINDOW_UPDATE with a zero increment"
        grant_send_credit(client, wu.stream_id, wu.increment)
        return true
    if t == frames.FRAME_GOAWAY:
        ga := frames.parse_goaway(frame)!
        return handle_goaway(client, ga)
    if t == frames.FRAME_RST_STREAM:
        rs := frames.parse_rst_stream(frame)!
        # drop any half-built unary accumulator; the reset ends the stream.
        if accums.contains_key(rs.stream_id):
            accums.remove(rs.stream_id)
        deliver(client, rs.stream_id, reset_event(rs.error_code))
        return true
    # PRIORITY, PUSH_PROMISE and unknown types need no action to complete our
    # requests, so they are ignored.
    return true

# apply a GOAWAY: stop opening new streams and fail every stream the peer will
# not serve (id above last_stream_id), while leaving lower-id streams to finish.
# returns true so the reader keeps draining those until the peer closes.
fn handle_goaway(client: Client, ga: frames.GoawayFrame) -> Bool!:
    client.mu.lock()
    client.going_away = true
    client.last_peer_stream = ga.last_stream_id
    mut survivors: List[Int] := []
    for sid in client.active:
        if sid > ga.last_stream_id:
            if client.streams.contains_key(sid):
                client.streams[sid].close()
                client.streams.remove(sid)
            # wake any body sender on a dropped stream so it stops.
            if client.credit.contains_key(sid):
                client.credit[sid].close()
                client.credit.remove(sid)
            if client.send_windows.contains_key(sid):
                client.send_windows.remove(sid)
        else:
            survivors.push(sid)
    client.active = survivors
    remaining := survivors.len()
    client.mu.unlock()
    # nothing left to wait for: the connection is done.
    return remaining > 0

# best-effort GOAWAY to the peer. try_send so a full or closed outbound channel
# never blocks the reader; the writer is still draining when this runs after a
# protocol error, so a queued frame flushes.
fn send_goaway(client: Client, error_code: Int):
    frame := frames.goaway_frame(client.last_peer_stream, error_code, bytes.empty())
    if frame.is_err:
        return
    wire := frames.frame_bytes(frame.ok)
    if wire.is_err:
        return
    client.outbound.try_send(wire.ok)

# hand an event to a waiting stream, dropping it if the stream is already gone
# (e.g. a trailing frame after the response finished). the channel handle is
# taken under the mutex and the send happens outside it, so a briefly-behind
# consumer never blocks the stream table.
fn deliver(client: Client, stream_id: Int, event: StreamEvent):
    client.mu.lock()
    if not client.streams.contains_key(stream_id):
        client.mu.unlock()
        return
    inbox := client.streams[stream_id]
    client.mu.unlock()
    inbox.send(event)

# close every waiting stream's inbox and clear the table, so pending request()
# calls unblock with a connection-closed error.
fn fail_all(client: Client):
    client.mu.lock()
    client.closed.store(1)
    for stream_id in client.active:
        if client.streams.contains_key(stream_id):
            client.streams[stream_id].close()
        # closing the credit channel wakes a blocked body sender to give up.
        if client.credit.contains_key(stream_id):
            client.credit[stream_id].close()
    empty: Map[Int, Channel[StreamEvent]] := {}
    empty_unary: Map[Int, Bool] := {}
    empty_windows: Map[Int, Int] := {}
    empty_credit: Map[Int, Channel[Int]] := {}
    client.streams = empty
    client.unary = empty_unary
    client.send_windows = empty_windows
    client.credit = empty_credit
    client.active = []
    client.mu.unlock()
    # unblock any request waiting on a full outbound channel now the writer is
    # stopping, so it fails fast instead of hanging.
    client.outbound.close()
    # unblock any request queued for a concurrency slot.
    client.slot_free.close()

# given the frame just pulled from the outbound channel, drain any frames already
# queued behind it (with try_recv) and return them concatenated in FIFO order, so
# a burst can go out in one write. returns `first` untouched when nothing else is
# queued — the common single-frame case, with no extra allocation.
fn drain_coalesced(first: Bytes, outbound: Channel[Bytes]) -> Bytes:
    next := outbound.try_recv()
    if next == none:
        return first
    buf := bytes.buffer()
    buf.write(first) catch 0
    mut more := next
    while more != none:
        buf.write(more.unwrap_or(bytes.empty())) catch 0
        more = outbound.try_recv()
    out := buf.bytes()
    buf.free()
    return out

# the writer task: drain the outbound channel and write serialized frames in
# order. stops when the channel is closed (close()) or a write fails. it owns the
# send direction only — the outbound channel, the connection, and the closed
# flag — so its handle can be held before the full client is built. a closed
# channel still yields its buffered frames before recv reports none, so a GOAWAY
# queued just before close() is flushed here.
#
# frames already queued behind the one recv() returns are coalesced into a single
# write (see drain_coalesced), preserving FIFO order so the wire bytes — and thus
# hpack/DATA ordering — are unchanged. under concurrency many streams queue frames
# between writer wakeups, collapsing a burst of one-record-per-frame writes into
# one record and syscall.
fn writer_loop(outbound: Channel[Bytes], conn: Connection, closed: AtomicInt) -> Int:
    while true:
        opt := outbound.recv()
        if opt == none:
            return 0
        wire := drain_coalesced(opt.unwrap_or(bytes.empty()), outbound)
        sent := conn.send(wire)
        if sent.is_err:
            closed.store(1)
            return 0

# read stream events until end-of-stream, assembling the response. a closed
# inbox (connection dropped) or a RST_STREAM fails the request. a header block
# that arrives after the body has begun is the trailers.
fn assemble_response(inbox: Channel[StreamEvent]) -> Response!:
    body := bytes.buffer()
    defer body.free()
    mut status := 0
    mut headers: List[hpack.HeaderField] := []
    mut trailers: List[hpack.HeaderField] := []
    mut got_headers := false
    while true:
        opt := inbox.recv()
        if opt == none:
            fail "http2: connection closed before the response completed"
        event := opt?
        if event.kind == STREAM_UNARY:
            # the reader coalesced the whole response into one event, so there is
            # nothing to assemble across frames — return it directly.
            return Response(status_from(event.headers), event.headers, event.trailers, event.data)
        if event.kind == STREAM_RESET:
            fail "http2: stream was reset by the peer ({frames.error_name(event.error_code)})"
        if event.kind == STREAM_HEADERS:
            if not got_headers:
                headers = event.headers
                status = status_from(event.headers)
                got_headers = true
            else:
                trailers = event.headers
        elif event.kind == STREAM_DATA:
            body.write(event.data)!
        if event.end:
            return Response(status, headers, trailers, body.bytes())

# the error a deadline-bounded request fails with when its time runs out. a
# caller (std.net.grpc) compares against this exact string to tell a deadline
# from other transport failures, so it must stay stable.
pub REQUEST_DEADLINE_EXCEEDED := "http2: request deadline exceeded"

# like assemble_response, but give up once the monotonic clock passes
# `deadline_ms` (a time.mono_millis() timestamp). each wait for the next stream
# event is bounded by the time remaining, so a server that answers slowly — or
# never — fails the request with REQUEST_DEADLINE_EXCEEDED instead of blocking
# forever. the caller owns cleaning up the abandoned stream (reset + forget).
fn assemble_response_until(inbox: Channel[StreamEvent], deadline_ms: Int) -> Response!:
    body := bytes.buffer()
    defer body.free()
    mut status := 0
    mut headers: List[hpack.HeaderField] := []
    mut trailers: List[hpack.HeaderField] := []
    mut got_headers := false
    while true:
        remaining := deadline_ms - time.mono_millis()
        if remaining <= 0:
            fail REQUEST_DEADLINE_EXCEEDED
        picked := select:
            received := inbox.recv() => (1, received)
            timeout remaining => (0, none)
        if picked.0 == 0:
            fail REQUEST_DEADLINE_EXCEEDED
        opt := picked.1
        if opt == none:
            fail "http2: connection closed before the response completed"
        event := opt?
        if event.kind == STREAM_UNARY:
            return Response(status_from(event.headers), event.headers, event.trailers, event.data)
        if event.kind == STREAM_RESET:
            fail "http2: stream was reset by the peer ({frames.error_name(event.error_code)})"
        if event.kind == STREAM_HEADERS:
            if not got_headers:
                headers = event.headers
                status = status_from(event.headers)
                got_headers = true
            else:
                trailers = event.headers
        elif event.kind == STREAM_DATA:
            body.write(event.data)!
        if event.end:
            return Response(status, headers, trailers, body.bytes())

# apply the peer's SETTINGS (RFC 9113 §6.5.2). the header-table-size bounds our
# hpack encoder so the indices we emit stay valid for the peer's decoder; the
# frame size and header-list size shape and gate what we send; the initial
# window size sets new streams' send credit and retroactively resizes open ones;
# max-concurrent-streams caps how many streams we open at once. push-related and
# unknown identifiers are ignored.
fn apply_settings(client: Client, settings: List[frames.Setting]):
    client.mu.lock()
    mut admit_more := false
    for s in settings:
        if s.id == SETTINGS_HEADER_TABLE_SIZE:
            client.conn.encoder.set_max_table_size(s.value)
        elif s.id == SETTINGS_MAX_FRAME_SIZE:
            client.peer_max_frame_size = s.value
        elif s.id == SETTINGS_MAX_HEADER_LIST_SIZE:
            client.peer_max_header_list = s.value
        elif s.id == SETTINGS_INITIAL_WINDOW_SIZE:
            # RFC 9113 §6.9.2: a change adjusts every open stream's send window
            # by the delta from the previous initial value.
            delta := s.value - client.peer_initial_window
            client.peer_initial_window = s.value
            for sid in client.active:
                if client.send_windows.contains_key(sid):
                    client.send_windows.insert(sid, client.send_windows[sid] + delta)
        elif s.id == SETTINGS_MAX_CONCURRENT_STREAMS:
            client.max_concurrent = s.value
            admit_more = true
    client.mu.unlock()
    # a raised (or first-seen) limit may let a queued request() proceed.
    if admit_more:
        client.slot_free.try_send(1)

# the uncompressed size an hpack header list counts against
# SETTINGS_MAX_HEADER_LIST_SIZE: each field is its name and value octets plus a
# fixed 32-octet overhead (RFC 9113 §6.5.2, RFC 7541 §4.1).
fn header_list_size(fields: List[hpack.HeaderField]) -> Int:
    mut total := 0
    for f in fields:
        total = total + f.name.len() + f.value.len() + 32
    return total

# serialize an hpack block into a HEADERS frame followed by as many CONTINUATION
# frames as the block needs to stay within `max_frame_size`, concatenated into
# one contiguous buffer. sending it as a single write keeps the block whole on
# the wire — a header block must not be split by another stream's frames (RFC
# 9113 §6.10).
fn header_block_wire(stream_id: Int, block: Bytes, end_stream: Bool, max_frame_size: Int) -> Bytes!:
    out := bytes.buffer()
    defer out.free()
    total := block.len()
    if total <= max_frame_size:
        out.write(frames.frame_bytes(frames.headers_frame(stream_id, block, end_stream, true))!)!
        return out.bytes()
    # first slice goes in the HEADERS frame without END_HEADERS; the rest follow
    # in CONTINUATION frames, the last of which carries END_HEADERS.
    out.write(frames.frame_bytes(frames.headers_frame(stream_id, block.slice(0, max_frame_size), end_stream, false))!)!
    mut pos := max_frame_size
    while pos < total:
        mut stop := pos + max_frame_size
        if stop > total:
            stop = total
        out.write(frames.frame_bytes(frames.continuation_frame(stream_id, block.slice(pos, stop), stop == total))!)!
        pos = stop
    return out.bytes()

# apply an inbound WINDOW_UPDATE to our send windows and wake any body sender
# waiting on the affected stream. a stream-0 update grows the connection window,
# which may unblock any stream, so it pokes them all; a stream id grows just
# that one stream. pokes are sent outside the mutex so a full poke channel (one
# already pending) never blocks the reader.
fn grant_send_credit(client: Client, stream_id: Int, increment: Int):
    client.mu.lock()
    if stream_id == 0:
        client.conn_send_window = client.conn_send_window + increment
        mut waiters: List[Channel[Int]] := []
        for sid in client.active:
            if client.credit.contains_key(sid):
                waiters.push(client.credit[sid])
        client.mu.unlock()
        for ch in waiters:
            ch.try_send(1)
        return
    if client.send_windows.contains_key(stream_id):
        client.send_windows.insert(stream_id, client.send_windows[stream_id] + increment)
    if client.credit.contains_key(stream_id):
        ch := client.credit[stream_id]
        client.mu.unlock()
        ch.try_send(1)
        return
    client.mu.unlock()

# stream `data` as DATA frames over the client, honoring the peer's send windows
# (RFC 9113 §6.9): reserve credit bounded by the stream window, the connection
# window, and the max frame size; send that much; and block on the stream's
# credit signal when no window is available, until a WINDOW_UPDATE grows one.
# END_STREAM rides on the final DATA frame only when `end_stream` is set, so a
# streaming caller can send many chunks and half-close on the last. an empty
# `data` sends nothing unless `end_stream` is set, in which case it sends a lone
# empty END_STREAM DATA frame to half-close (as client-streaming's close does).
# returns the bytes sent; stops early if the connection drops (the waiting reader
# then fails on the closed inbox). runs on its own task for a unary body so the
# response is read as the body flows.
fn send_stream_data(client: Client, stream_id: Int, data: Bytes, end_stream: Bool) -> Int:
    total := data.len()
    if total == 0:
        if end_stream:
            wire := frames.frame_bytes(frames.data_frame(stream_id, bytes.empty(), true))
            if wire.is_err:
                return 0
            client.outbound.send(wire.ok)
        return 0
    mut off := 0
    while off < total:
        grant := client.reserve_send(stream_id, total - off)
        if grant <= 0:
            # no credit right now: wait for a poke, or give up if the connection
            # closed (its credit channel is then closed and recv reports none).
            if not client.await_credit(stream_id):
                return off
            continue
        stop := off + grant
        last := stop == total
        frame := frames.data_frame(stream_id, data.slice(off, stop), last and end_stream)
        wire := frames.frame_bytes(frame)
        if wire.is_err:
            return off
        if not client.outbound.send(wire.ok):
            return off
        off = stop
    return off

impl Client:
    # reserve up to `want` bytes of send credit for `stream_id`, bounded by the
    # stream window, the connection window, and the peer's max frame size.
    # returns the bytes reserved (0 when no credit is available), debiting both
    # windows by that amount. a window can be negative after a settings shrink,
    # so a non-positive result just means "wait".
    fn reserve_send(stream_id: Int, want: Int) -> Int:
        self.mu.lock()
        mut win := 0
        if self.send_windows.contains_key(stream_id):
            win = self.send_windows[stream_id]
        mut grant := want
        if grant > win:
            grant = win
        if grant > self.conn_send_window:
            grant = self.conn_send_window
        if grant > self.peer_max_frame_size:
            grant = self.peer_max_frame_size
        if grant > 0:
            self.send_windows.insert(stream_id, win - grant)
            self.conn_send_window = self.conn_send_window - grant
        self.mu.unlock()
        if grant < 0:
            return 0
        return grant

    # block until this stream's credit is poked (a WINDOW_UPDATE grew a window),
    # returning false if the connection closed instead (the channel was closed).
    fn await_credit(stream_id: Int) -> Bool:
        self.mu.lock()
        if not self.credit.contains_key(stream_id):
            self.mu.unlock()
            return false
        ch := self.credit[stream_id]
        self.mu.unlock()
        opt := ch.recv()
        return opt != none

    # serialize a frame and queue it for the writer task.
    fn enqueue(frame: frames.Frame) -> Bool!:
        return self.outbound.send(frames.frame_bytes(frame)!)

    # grant flow-control credit for `amount` consumed body bytes: at the
    # connection level always, and at the stream level while the stream is open.
    fn replenish(stream_id: Int, amount: Int, end_stream: Bool) -> Bool!:
        if amount <= 0:
            return true
        self.enqueue(frames.window_update_frame(0, amount)!)!
        if not end_stream:
            self.enqueue(frames.window_update_frame(stream_id, amount)!)!
        return true

    # whether the reader should coalesce this stream into one unary event. read
    # once per stream when the reader sees its first frame; a streaming stream is
    # never marked, so this is false and its events flow incrementally.
    fn is_unary(stream_id: Int) -> Bool:
        self.mu.lock()
        marked := self.unary.contains_key(stream_id)
        self.mu.unlock()
        return marked

    # remove a finished stream from the table and its flow-control state, then
    # free a concurrency slot so a request queued behind the peer's limit can go.
    fn forget(stream_id: Int):
        self.mu.lock()
        if self.streams.contains_key(stream_id):
            self.streams.remove(stream_id)
        if self.unary.contains_key(stream_id):
            self.unary.remove(stream_id)
        if self.send_windows.contains_key(stream_id):
            self.send_windows.remove(stream_id)
        if self.credit.contains_key(stream_id):
            self.credit[stream_id].close()
            self.credit.remove(stream_id)
        self.active = list_remove_int(self.active, stream_id)
        self.mu.unlock()
        self.slot_free.try_send(1)

    # open a stream from a full header-field list: wait for a slot when the peer
    # caps concurrency (RFC 9113 §5.1.2), allocate the id, register the stream's
    # inbox, and enqueue the HEADERS — all under the mutex so ids stay monotonic
    # and hpack encoding matches wire order. END_STREAM rides on the HEADERS when
    # `end_stream` is set (no body will follow). the returned Stream carries the
    # id and inbox for incremental send/recv. `unary` marks the stream so the
    # reader coalesces its response into one event (see handle_frame); a streaming
    # caller passes false so its events flow one frame at a time.
    fn open_stream_with_fields(fields: List[hpack.HeaderField], end_stream: Bool, unary: Bool) -> Stream!:
        self.mu.lock()
        while true:
            if self.closed.load() != 0:
                self.mu.unlock()
                fail "http2: client is closed"
            if self.going_away:
                self.mu.unlock()
                fail "http2: peer sent GOAWAY; not opening new streams"
            if self.max_concurrent <= 0 or self.active.len() < self.max_concurrent:
                break
            self.mu.unlock()
            slot := self.slot_free.recv()
            if slot == none:
                fail "http2: client is closed"
            self.mu.lock()
        if self.peer_max_header_list > 0 and header_list_size(fields) > self.peer_max_header_list:
            self.mu.unlock()
            fail "http2: request header list exceeds the peer's limit"
        stream_id := self.next_stream_id
        self.next_stream_id = self.next_stream_id + 2
        inbox := Channel[StreamEvent](STREAM_INBOX_CAP)
        self.streams.insert(stream_id, inbox)
        if unary:
            self.unary.insert(stream_id, true)
        self.active.push(stream_id)
        self.send_windows.insert(stream_id, self.peer_initial_window)
        self.credit.insert(stream_id, Channel[Int](CREDIT_POKE_CAP))
        block := self.conn.encoder.encode(fields)
        built := header_block_wire(stream_id, block, end_stream, self.peer_max_frame_size)
        if built.is_err:
            self.mu.unlock()
            self.forget(stream_id)
            fail built.err
        accepted := self.outbound.send(built.ok)
        self.mu.unlock()
        if not accepted:
            self.forget(stream_id)
            fail "http2: connection closed"
        return Stream(self, stream_id, inbox)

    # open a stream for a streaming rpc: fills the four pseudo-headers from the
    # method, authority, and path, appends `extra` (e.g. content-type), and sends
    # the HEADERS. pass end_stream=true to half-close immediately (a
    # server-streaming request has no body); false to keep sending DATA with
    # Stream.send. safe to call from many tasks concurrently.
    pub fn open_stream(method: String, authority: String, path: String, extra: List[hpack.HeaderField], end_stream: Bool) -> Stream!:
        mut fields := [hpack.header_field(":method", method), hpack.header_field(":path", path), hpack.header_field(":scheme", self.conn.scheme()), hpack.header_field(":authority", authority)]
        for f in extra:
            fields.push(f)
        # a stream is long-lived and its events flow through the reader, so it can
        # never run on the inline path: promote to the pipeline before opening it.
        self.ensure_threaded()
        return self.open_stream_with_fields(fields, end_stream, false)!

    # --- inline fast-path plumbing (see the Client note) ---

    # try to take the inline lease: succeed only while the connection is still
    # single-stream (MODE_INLINE) and no other inline call holds it. on success
    # the caller owns the socket, the encoder and the decoder until end_inline().
    fn try_begin_inline() -> Bool:
        self.gate.lock()
        if self.closed.load() != 0 or self.mode != MODE_INLINE or self.inline_busy:
            self.gate.unlock()
            return false
        self.inline_busy = true
        self.gate.unlock()
        return true

    # release the inline lease. if a promotion latched while this call held the
    # socket, hand it over — the promoter is (or will soon be) waiting on
    # `handoff`. the poke is capacity-1 and coalesced, so a stray poke (the
    # promoter already saw us idle) is harmless: promotion happens at most once.
    fn end_inline():
        self.gate.lock()
        self.inline_busy = false
        promoting := self.mode != MODE_INLINE
        self.gate.unlock()
        if promoting:
            self.handoff.try_send(1)

    # promote to the threaded pipeline, exactly once, releasing the parked reader
    # so it takes over the socket. safe to call from many threads: the first mover
    # promotes, the rest wait on `ready`. because a caller returns only after any
    # in-flight inline call has released the socket and the reader owns it, the
    # caller can then open a stream with no risk of racing the inline codec.
    fn ensure_threaded():
        self.gate.lock()
        m := self.mode
        if m == MODE_THREADED:
            self.gate.unlock()
            return
        if m == MODE_PROMOTING:
            self.gate.unlock()
            # another caller is promoting; wait for it. recv returns once `ready`
            # is closed (or at once if it already is).
            self.ready.recv()
            return
        # m == MODE_INLINE: we are the promoter.
        self.mode = MODE_PROMOTING
        must_wait := self.inline_busy
        self.gate.unlock()
        if must_wait:
            # an inline call still owns the socket + decoder; wait for it to drop
            # its lease before we hand them to the reader. two readers on one tls
            # session are illegal, and the decoder is single-owner by protocol.
            self.handoff.recv()
        # the inline path is fully drained now, and no new inline call can start
        # (mode is past INLINE), so its bookkeeping is stable.
        if self.closed.load() == 0:
            # the connection send window is left untouched at promotion. inline is
            # strictly sequential, so by the time each response was read the peer
            # had consumed that request and re-granted the bytes with a
            # WINDOW_UPDATE(0); those grants were read and dropped by the inline
            # codec. sends and grants therefore net out, and the window is back at
            # its initial value — exactly what conn_send_window still holds, since
            # the inline path never debited it. (an earlier version subtracted the
            # cumulative inline bytes here, which drove the window deeply negative
            # after a long warmup and stalled the first thousands of concurrent
            # sends.)
            # the writer already runs and the reader is already spawned (parked
            # on promote_gate); release it to take over the socket now.
            self.promote_gate.send(1)
        self.gate.lock()
        self.mode = MODE_THREADED
        self.gate.unlock()
        # release every caller that was waiting on the promotion.
        self.ready.close()

    # run one request/response synchronously on the caller, holding the inline
    # lease. with a single stream in flight this reuses the lockstep codec — no
    # reader/writer tasks, no channel handoffs. precondition: try_begin_inline()
    # returned true, and the body fits one DATA frame within the send window (so
    # the write never blocks on flow control before the response is read).
    fn inline_round_trip(fields: List[hpack.HeaderField], body: Bytes) -> Response!:
        has_body := body.len() > 0
        # the inline lease makes this the sole user of the socket, the encoder,
        # the decoder and next_stream_id (the reader/writer are not spawned until
        # this call releases the lease), so no mutex is needed here.
        stream_id := self.next_stream_id
        self.next_stream_id = self.next_stream_id + 2
        block := self.conn.encoder.encode(fields)
        self.conn.send_frame(frames.headers_frame(stream_id, block, not has_body, true))!
        if has_body:
            self.conn.send_frame(frames.data_frame(stream_id, body, true))!
        return self.conn.read_response(stream_id)!

    # send a request with the given header fields and body, and read its full
    # response. runs inline (synchronously on the caller) while the connection is
    # still single-stream, else through the multiplexing pipeline. safe to call
    # from many tasks concurrently.
    fn do_request(fields: List[hpack.HeaderField], body: Bytes) -> Response!:
        # fast path: a body small enough to ride one DATA frame within the send
        # window, on a connection no other inline call is using. this is the
        # common grpc unary shape, and it avoids the pipeline entirely.
        if body.len() <= self.peer_max_frame_size and self.try_begin_inline():
            result := self.inline_round_trip(fields, body)
            # release the lease before propagating, so an error never leaks it.
            self.end_inline()
            if result.is_err:
                fail result.err
            return result.ok
        # slow path: concurrency, or a body large enough to need flow control.
        # bring up the pipeline (once) and multiplex exactly as before.
        self.ensure_threaded()
        return self.threaded_request(fields, body)!

    # the multiplexing request path: open a stream, send the body, and assemble
    # the response from the reader's stream events. built on open_stream_with_fields:
    # an empty body half-closes on the HEADERS frame; a non-empty body streams as
    # flow-controlled DATA on its own task while the response is read.
    fn threaded_request(fields: List[hpack.HeaderField], body: Bytes) -> Response!:
        has_body := body.len() > 0
        stream := self.open_stream_with_fields(fields, not has_body, true)!
        stream_id := stream.id
        if has_body and body.len() <= self.peer_max_frame_size:
            # the body is a single frame within the initial window, so sending it
            # never waits on flow control and the small write drains immediately
            # — no need to send on a task. this is the common grpc unary case.
            send_stream_data(self, stream_id, body, true)
            attempt := assemble_response(stream.inbox)
            self.forget(stream_id)
            if attempt.is_err:
                fail attempt.err
            return attempt.ok
        if has_body:
            # a larger body may span frames and block on flow-control credit, so
            # send it on a task while this call keeps draining the response inbox.
            # bind self to a local: a spawn thunk cannot load `self` directly.
            me := self
            sender := spawn send_stream_data(me, stream_id, body, true)
            attempt := assemble_response(stream.inbox)
            await sender
            self.forget(stream_id)
            if attempt.is_err:
                fail attempt.err
            return attempt.ok
        # no body: END_STREAM already rode on the HEADERS frame.
        attempt := assemble_response(stream.inbox)
        self.forget(stream_id)
        if attempt.is_err:
            fail attempt.err
        return attempt.ok

    # send a request built from a method, authority, path, extra header fields,
    # and a body, returning the response. the four pseudo-headers are filled in;
    # `extra` carries regular headers such as content-type. this is the entry
    # point for non-GET verbs and request bodies — a grpc unary call is a POST
    # whose body is a length-prefixed protobuf message.
    pub fn request(method: String, authority: String, path: String, extra: List[hpack.HeaderField], body: Bytes) -> Response!:
        mut fields := [hpack.header_field(":method", method), hpack.header_field(":path", path), hpack.header_field(":scheme", self.conn.scheme()), hpack.header_field(":authority", authority)]
        for f in extra:
            fields.push(f)
        return self.do_request(fields, body)!

    # like request, but fail with REQUEST_DEADLINE_EXCEEDED once `timeout_ms`
    # milliseconds pass without a complete response. a timeout of zero (or less)
    # means no deadline — identical to request, including its inline fast path.
    # a deadline-bounded call always rides the threaded pipeline: the inline path
    # reads the socket synchronously and cannot be interrupted, while the
    # pipeline delivers events over a channel this can wait on with a bound. on
    # timeout the stream is reset (CANCEL) and forgotten, so the connection
    # stays usable for later requests.
    pub fn request_with_timeout(method: String, authority: String, path: String, extra: List[hpack.HeaderField], body: Bytes, timeout_ms: Int) -> Response!:
        mut fields := [hpack.header_field(":method", method), hpack.header_field(":path", path), hpack.header_field(":scheme", self.conn.scheme()), hpack.header_field(":authority", authority)]
        for f in extra:
            fields.push(f)
        if timeout_ms <= 0:
            return self.do_request(fields, body)!
        self.ensure_threaded()
        return self.threaded_request_until(fields, body, time.mono_millis() + timeout_ms)!

    # threaded_request with a deadline: the same open/send/assemble shape, but
    # the response wait is bounded by `deadline_ms`. on failure (timeout
    # included) the stream is closed — reset on the wire and dropped from the
    # table — which also wakes a body sender still blocked on flow control.
    fn threaded_request_until(fields: List[hpack.HeaderField], body: Bytes, deadline_ms: Int) -> Response!:
        has_body := body.len() > 0
        stream := self.open_stream_with_fields(fields, not has_body, true)!
        stream_id := stream.id
        if has_body and body.len() > self.peer_max_frame_size:
            # a large body may block on flow-control credit, so send it on a
            # task while this call drains the response inbox (see
            # threaded_request). bind self to a local: a spawn thunk cannot
            # load `self` directly.
            me := self
            sender := spawn send_stream_data(me, stream_id, body, true)
            attempt := assemble_response_until(stream.inbox, deadline_ms)
            if attempt.is_err:
                # closing the stream resets it and closes its credit channel,
                # unblocking the sender so the await below cannot hang.
                stream.close()
                await sender
                fail attempt.err
            await sender
            self.forget(stream_id)
            return attempt.ok
        if has_body:
            # a single-frame body drains immediately — the common grpc unary
            # case — so it is sent right here, no task needed.
            send_stream_data(self, stream_id, body, true)
        attempt := assemble_response_until(stream.inbox, deadline_ms)
        if attempt.is_err:
            stream.close()
            fail attempt.err
        self.forget(stream_id)
        return attempt.ok

    # GET a path on the given authority over this client.
    pub fn get(authority: String, path: String) -> Response!:
        fields := [hpack.header_field(":method", "GET"), hpack.header_field(":path", path), hpack.header_field(":scheme", self.conn.scheme()), hpack.header_field(":authority", authority)]
        return self.do_request(fields, bytes.empty())!

    # stop the client and close the connection. call it when no request is in
    # flight. a GOAWAY is queued first and the writer (which runs for the whole
    # client lifetime) is awaited so it flushes before the transport drops; a
    # promoted client's reader then unblocks on the closed transport.
    pub fn close():
        self.mu.lock()
        self.going_away = true
        self.mu.unlock()
        # mark closed first, so a concurrent promoter sees it and does not spawn a
        # reader over a transport we are about to drop.
        self.closed.store(1)
        # release the reader if it is still parked (client never promoted), so it
        # observes closed and exits instead of parking forever.
        self.promote_gate.close()
        send_goaway(self, frames.ERROR_NO_ERROR)
        self.outbound.close()
        await self.writer
        self.conn.close()

# --- tests ---

fn hx(data: Bytes) -> String:
    return encoding.to_hex(data)

# build a server-style frame stream in memory to drive the read loop.
fn encode_frames(list: List[frames.Frame]) -> Bytes!:
    out := bytes.buffer()
    for frame in list:
        out.write(frames.frame_bytes(frame)!)!
    result := out.bytes()
    out.free()
    return result

# hpack-encode a header list into a block with a fresh encoder, so a fresh
# decoder (empty dynamic table) stays in sync.
fn header_block(fields: List[hpack.HeaderField]) -> Bytes:
    encoder := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    return encoder.encode(fields)

# collect the WINDOW_UPDATE frames recorded in a connection's sent stream.
fn sent_window_updates(conn: Connection) -> List[frames.WindowUpdateFrame]!:
    reader := binary.reader(conn.sent)
    mut updates: List[frames.WindowUpdateFrame] := []
    while binary.remaining(reader) > 0:
        frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
        if frame.header.frame_type == frames.FRAME_WINDOW_UPDATE:
            updates.push(frames.parse_window_update(frame)!)
    return updates

# collect the PING frames recorded in a connection's sent stream.
fn sent_pings(conn: Connection) -> List[frames.PingFrame]!:
    reader := binary.reader(conn.sent)
    mut pings: List[frames.PingFrame] := []
    while binary.remaining(reader) > 0:
        frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
        if frame.header.frame_type == frames.FRAME_PING:
            pings.push(frames.parse_ping(frame)!)
    return pings

test "the client preface is the exact 24-byte RFC 9113 token":
    preface := client_preface()
    assert_eq(preface.len(), 24)
    assert_eq(hx(preface), PREFACE_HEX)
    # cross-check against the human-readable form with its crlf pairs.
    assert_eq(hx(preface), hx(bytes.from_string_utf8("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")))

test "the opening SETTINGS disables push and states our limits":
    parsed := frames.parse_settings(initial_settings_frame()!)!
    assert(not parsed.ack)
    assert_eq(parsed.settings.len(), 3)
    assert_eq(parsed.settings[0].id, SETTINGS_ENABLE_PUSH)
    assert_eq(parsed.settings[0].value, 0)
    assert_eq(parsed.settings[2].id, SETTINGS_MAX_FRAME_SIZE)
    assert_eq(parsed.settings[2].value, frames.DEFAULT_MAX_FRAME_SIZE)

test "the read loop assembles a response from HEADERS and DATA":
    block := header_block([hpack.header_field(":status", "200"), hpack.header_field("content-type", "text/plain")])
    stream := encode_frames([frames.headers_frame(1, block, false, true), frames.data_frame(1, bytes.from_string_utf8("hello world"), true)])!
    conn := connection_from_frames(stream)
    response := conn.read_response(1)!
    assert_eq(response.status, 200)
    assert_eq(response.body.to_string_utf8()!, "hello world")
    assert_eq(response.headers.len(), 2)
    assert_eq(response.headers[1].name, "content-type")

test "the read loop acks server SETTINGS before the response":
    block := header_block([hpack.header_field(":status", "204")])
    server_settings := frames.settings_frame([frames.setting(SETTINGS_MAX_CONCURRENT_STREAMS, 100)])!
    stream := encode_frames([server_settings, frames.headers_frame(1, block, true, true)])!
    conn := connection_from_frames(stream)
    response := conn.read_response(1)!
    assert_eq(response.status, 204)
    # a SETTINGS ack must have gone back to the peer.
    reader := binary.reader(conn.sent)
    ack := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
    settings := frames.parse_settings(ack)!
    assert(settings.ack)

test "the read loop replenishes flow control as body arrives":
    block := header_block([hpack.header_field(":status", "200")])
    stream := encode_frames([frames.headers_frame(1, block, false, true), frames.data_frame(1, bytes.from_string_utf8("hello"), false), frames.data_frame(1, bytes.empty(), true)])!
    conn := connection_from_frames(stream)
    response := conn.read_response(1)!
    assert_eq(response.body.to_string_utf8()!, "hello")
    updates := sent_window_updates(conn)!
    # the 5-byte DATA frame yields a connection and a stream WINDOW_UPDATE; the
    # empty end-of-stream DATA yields none.
    assert_eq(updates.len(), 2)
    assert_eq(updates[0].stream_id, 0)
    assert_eq(updates[0].increment, 5)
    assert_eq(updates[1].stream_id, 1)
    assert_eq(updates[1].increment, 5)

test "the read loop follows CONTINUATION frames to finish a header block":
    full := header_block([hpack.header_field(":status", "200"), hpack.header_field("x-note", "split-across-frames")])
    first_half := full.slice(0, 3)
    second_half := full.slice(3, full.len())
    stream := encode_frames([frames.headers_frame(1, first_half, false, false), frames.continuation_frame(1, second_half, true), frames.data_frame(1, bytes.from_string_utf8("body"), true)])!
    conn := connection_from_frames(stream)
    response := conn.read_response(1)!
    assert_eq(response.status, 200)
    assert_eq(response.body.to_string_utf8()!, "body")
    assert_eq(response.headers[1].name, "x-note")
    assert_eq(response.headers[1].value, "split-across-frames")

test "a RST_STREAM on our stream fails the response":
    block := header_block([hpack.header_field(":status", "200")])
    stream := encode_frames([frames.headers_frame(1, block, false, true), frames.rst_stream_frame(1, frames.ERROR_INTERNAL_ERROR)!])!
    conn := connection_from_frames(stream)
    assert(conn.read_response(1).is_err)

# --- concurrent multiplexing tests ---

# build a Client over an offline connection without spawning the reader/writer
# tasks, so a test can drive reader_loop directly and inspect the results. the
# writer is an idle placeholder — the test owns the outbound channel itself. the
# client starts already in MODE_THREADED so the tests exercise the multiplexing
# path directly, as they did before the inline fast-path existed. `promote_gate`
# is pre-filled so a test that calls reader_loop directly runs it straight
# through instead of parking (there is no promoter to release it).
fn offline_client(conn: Connection) -> Client:
    ids: List[Int] := []
    table: Map[Int, Channel[StreamEvent]] := {}
    unary_streams: Map[Int, Bool] := {}
    windows: Map[Int, Int] := {}
    credit: Map[Int, Channel[Int]] := {}
    gate := Channel[Int](1)
    gate.send(1)
    return Client(conn, Mutex(), 1, table, ids, unary_streams, Channel[Bytes](OUTBOUND_CAP), AtomicInt(0), false, 0, spawn idle_writer(), frames.DEFAULT_MAX_FRAME_SIZE, 0, DEFAULT_INITIAL_WINDOW, DEFAULT_INITIAL_WINDOW, windows, credit, 0, Channel[Int](SLOT_POKE_CAP), Mutex(), MODE_THREADED, false, Channel[Int](1), Channel[Int](1), gate)

# pull the next event off an inbox, failing if the channel closed first.
fn next_event(inbox: Channel[StreamEvent]) -> StreamEvent!:
    opt := inbox.recv()
    if opt == none:
        fail "expected a stream event but the inbox was closed"
    return opt?

# drain the WINDOW_UPDATE frames the reader queued for the writer.
fn drain_window_updates(ch: Channel[Bytes]) -> List[frames.WindowUpdateFrame]!:
    mut out: List[frames.WindowUpdateFrame] := []
    while true:
        opt := ch.recv()
        if opt == none:
            return out
        frame := frames.read_frame(binary.reader(opt.unwrap_or(bytes.empty())), frames.MAX_ALLOWED_FRAME_SIZE)!
        if frame.header.frame_type == frames.FRAME_WINDOW_UPDATE:
            out.push(frames.parse_window_update(frame)!)

test "the reader task demuxes frames to the right streams":
    # one shared encoder builds the stream so the single reader-side decoder
    # stays in step across both streams' header blocks.
    enc := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    block1 := enc.encode([hpack.header_field(":status", "200")])
    block3 := enc.encode([hpack.header_field(":status", "404")])
    stream := encode_frames([frames.headers_frame(1, block1, false, true), frames.data_frame(1, bytes.from_string_utf8("hello"), false), frames.headers_frame(3, block3, true, true), frames.data_frame(1, bytes.empty(), true)])!
    client := offline_client(connection_from_frames(stream))
    inbox1 := Channel[StreamEvent](STREAM_INBOX_CAP)
    inbox3 := Channel[StreamEvent](STREAM_INBOX_CAP)
    client.streams.insert(1, inbox1)
    client.active.push(1)
    client.streams.insert(3, inbox3)
    client.active.push(3)
    # runs to end-of-stream, then closes the inboxes.
    reader_loop(client)

    # stream 1: headers(200), data("hello"), empty end-of-stream data.
    h1 := next_event(inbox1)!
    assert_eq(h1.kind, STREAM_HEADERS)
    assert_eq(status_from(h1.headers), 200)
    d1 := next_event(inbox1)!
    assert_eq(d1.kind, STREAM_DATA)
    assert_eq(d1.data.to_string_utf8()!, "hello")
    assert(not d1.end)
    d1end := next_event(inbox1)!
    assert(d1end.end)
    # stream 3: a single end-of-stream headers frame.
    h3 := next_event(inbox3)!
    assert_eq(h3.kind, STREAM_HEADERS)
    assert_eq(status_from(h3.headers), 404)
    assert(h3.end)

test "the reader task replenishes flow control as body arrives":
    block := header_block([hpack.header_field(":status", "200")])
    stream := encode_frames([frames.headers_frame(1, block, false, true), frames.data_frame(1, bytes.from_string_utf8("hello"), false), frames.data_frame(1, bytes.empty(), true)])!
    client := offline_client(connection_from_frames(stream))
    inbox := Channel[StreamEvent](STREAM_INBOX_CAP)
    client.streams.insert(1, inbox)
    client.active.push(1)
    reader_loop(client)
    updates := drain_window_updates(client.outbound)!
    # the 5-byte DATA frame grants a connection and a stream WINDOW_UPDATE; the
    # empty end-of-stream DATA grants none.
    assert_eq(updates.len(), 2)
    assert_eq(updates[0].stream_id, 0)
    assert_eq(updates[0].increment, 5)
    assert_eq(updates[1].stream_id, 1)
    assert_eq(updates[1].increment, 5)

test "assemble_response builds a response from stream events":
    inbox := Channel[StreamEvent](8)
    inbox.send(headers_event([hpack.header_field(":status", "201"), hpack.header_field("x-test", "yes")], false))
    inbox.send(data_event(bytes.from_string_utf8("body-bytes"), false))
    inbox.send(data_event(bytes.from_string_utf8("-more"), true))
    r := assemble_response(inbox)!
    assert_eq(r.status, 201)
    assert_eq(r.body.to_string_utf8()!, "body-bytes-more")
    assert_eq(r.headers.len(), 2)
    assert_eq(r.headers[1].name, "x-test")
    assert_eq(r.headers[1].value, "yes")

test "assemble_response fails when the stream is reset":
    inbox := Channel[StreamEvent](4)
    inbox.send(reset_event(frames.ERROR_INTERNAL_ERROR))
    assert(assemble_response(inbox).is_err)

test "assemble_response fails when the connection closes early":
    inbox := Channel[StreamEvent](4)
    inbox.send(headers_event([hpack.header_field(":status", "200")], false))
    inbox.close()
    assert(assemble_response(inbox).is_err)

test "list_remove_int drops the target id":
    assert_eq(list_remove_int([1, 3, 5, 7], 5), [1, 3, 7])
    assert_eq(list_remove_int([1, 3], 9), [1, 3])

# --- robustness tests (phase 4) ---

test "read_response captures trailers after the body":
    # one shared encoder so the single decoder stays in step across both blocks.
    enc := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    head := enc.encode([hpack.header_field(":status", "200")])
    trail := enc.encode([hpack.header_field("grpc-status", "0")])
    stream := encode_frames([frames.headers_frame(1, head, false, true), frames.data_frame(1, bytes.from_string_utf8("payload"), false), frames.headers_frame(1, trail, true, true)])!
    conn := connection_from_frames(stream)
    response := conn.read_response(1)!
    assert_eq(response.status, 200)
    assert_eq(response.body.to_string_utf8()!, "payload")
    assert_eq(response.headers.len(), 1)
    assert_eq(response.trailers.len(), 1)
    assert_eq(response.trailers[0].name, "grpc-status")
    assert_eq(response.trailers[0].value, "0")

test "a non-CONTINUATION frame interrupting a header block is rejected":
    block := header_block([hpack.header_field(":status", "200")])
    # a HEADERS without END_HEADERS, then a DATA frame instead of a CONTINUATION.
    stream := encode_frames([frames.headers_frame(1, block, false, false), frames.data_frame(1, bytes.from_string_utf8("x"), true)])!
    conn := connection_from_frames(stream)
    assert(conn.read_response(1).is_err)

test "a PING is answered with an exact-echo ACK and a PING ACK is ignored":
    opaque := encoding.from_hex("1122334455667788")!
    block := header_block([hpack.header_field(":status", "200")])
    stream := encode_frames([frames.ping_frame(opaque)!, frames.headers_frame(1, block, true, true)])!
    conn := connection_from_frames(stream)
    conn.read_response(1)!
    pings := sent_pings(conn)!
    assert_eq(pings.len(), 1)
    assert(pings[0].ack)
    assert_eq(hx(pings[0].opaque), "1122334455667788")
    # a PING that is already an ACK must not be answered.
    stream2 := encode_frames([frames.ping_ack_frame(opaque)!, frames.headers_frame(1, header_block([hpack.header_field(":status", "200")]), true, true)])!
    conn2 := connection_from_frames(stream2)
    conn2.read_response(1)!
    assert_eq(sent_pings(conn2)!.len(), 0)

test "assemble_response captures trailers after the body":
    inbox := Channel[StreamEvent](8)
    inbox.send(headers_event([hpack.header_field(":status", "200")], false))
    inbox.send(data_event(bytes.from_string_utf8("hi"), false))
    inbox.send(headers_event([hpack.header_field("grpc-status", "0")], true))
    r := assemble_response(inbox)!
    assert_eq(r.status, 200)
    assert_eq(r.body.to_string_utf8()!, "hi")
    assert_eq(r.trailers.len(), 1)
    assert_eq(r.trailers[0].name, "grpc-status")
    assert_eq(r.trailers[0].value, "0")

test "a reset names the error code in the failure":
    inbox := Channel[StreamEvent](4)
    inbox.send(reset_event(frames.ERROR_REFUSED_STREAM))
    r := assemble_response(inbox)
    assert(r.is_err)
    assert(r.err.contains("REFUSED_STREAM"))

test "a GOAWAY drops streams above last-stream-id and keeps the rest":
    client := offline_client(connection_from_frames(bytes.empty()))
    inbox1 := Channel[StreamEvent](4)
    inbox3 := Channel[StreamEvent](4)
    client.streams.insert(1, inbox1)
    client.active.push(1)
    client.streams.insert(3, inbox3)
    client.active.push(3)
    # last-stream-id 1: the peer served stream 1 but not stream 3.
    ga := frames.parse_goaway(frames.goaway_frame(1, frames.ERROR_NO_ERROR, bytes.empty())!)!
    keep := handle_goaway(client, ga)!
    assert(keep)
    assert(client.going_away)
    assert(client.streams.contains_key(1))
    assert(not client.streams.contains_key(3))
    # stream 3's inbox was closed, so its waiting request() unblocks with none.
    assert(inbox3.recv() == none)

test "a WINDOW_UPDATE with a zero increment is a protocol error":
    client := offline_client(connection_from_frames(bytes.empty()))
    frame := frames.window_update_frame(1, 0)!
    accums: Map[Int, UnaryAccum] := {}
    assert(handle_frame(client, frame, accums).is_err)

# --- settings enforcement tests (phase 4) ---

test "header_list_size sums names, values, and per-field overhead":
    fields := [hpack.header_field(":method", "GET"), hpack.header_field("x", "yz")]
    # (7 + 3 + 32) + (1 + 2 + 32) = 42 + 35 = 77
    assert_eq(header_list_size(fields), 77)

test "apply_settings records the peer's frame and header-list limits":
    client := offline_client(connection_from_frames(bytes.empty()))
    apply_settings(client, [frames.setting(SETTINGS_MAX_FRAME_SIZE, 32768), frames.setting(SETTINGS_MAX_HEADER_LIST_SIZE, 8192), frames.setting(SETTINGS_HEADER_TABLE_SIZE, 0)])
    assert_eq(client.peer_max_frame_size, 32768)
    assert_eq(client.peer_max_header_list, 8192)

test "header_block_wire emits a single HEADERS when the block fits":
    block := bytes.from_string_utf8("small")
    wire := header_block_wire(3, block, false, frames.DEFAULT_MAX_FRAME_SIZE)!
    reader := binary.reader(wire)
    frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
    parsed := frames.parse_headers(frame)!
    assert(parsed.end_headers)
    assert(not parsed.end_stream)
    assert_eq(hx(parsed.block_fragment), hx(block))
    assert_eq(binary.remaining(reader), 0)

test "header_block_wire splits a large block into HEADERS + CONTINUATION":
    block := bytes.from_string_utf8("abcdefghij")
    # a 4-byte cap over 10 bytes yields HEADERS(4) + CONTINUATION(4) + CONTINUATION(2).
    wire := header_block_wire(1, block, true, 4)!
    reader := binary.reader(wire)
    first := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
    assert_eq(first.header.frame_type, frames.FRAME_HEADERS)
    head := frames.parse_headers(first)!
    assert(not head.end_headers)
    assert(head.end_stream)
    out := bytes.buffer()
    out.write(head.block_fragment)!
    mut done := false
    while not done:
        frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
        assert_eq(frame.header.frame_type, frames.FRAME_CONTINUATION)
        cont := frames.parse_continuation(frame)!
        out.write(cont.block_fragment)!
        done = cont.end_headers
    reassembled := out.bytes()
    out.free()
    # the split frames reassemble to exactly the original block.
    assert_eq(hx(reassembled), hx(block))

# --- send-side flow control tests (phase 5a) ---

# register a stream on an offline client with the given send windows, ready for
# the flow-control helpers to act on it.
fn arm_send_stream(client: Client, stream_id: Int, stream_window: Int, conn_window: Int, max_frame: Int):
    client.streams.insert(stream_id, Channel[StreamEvent](STREAM_INBOX_CAP))
    client.active.push(stream_id)
    client.send_windows.insert(stream_id, stream_window)
    client.credit.insert(stream_id, Channel[Int](CREDIT_POKE_CAP))
    client.conn_send_window = conn_window
    client.peer_max_frame_size = max_frame

# read the next DATA frame off an outbound channel, failing if it closed first.
fn next_data_frame(ch: Channel[Bytes]) -> frames.DataFrame!:
    opt := ch.recv()
    if opt == none:
        fail "expected a DATA frame but the outbound channel was closed"
    frame := frames.read_frame(binary.reader(opt?), frames.MAX_ALLOWED_FRAME_SIZE)!
    return frames.parse_data(frame)!

test "reserve_send is bounded by the stream and connection windows":
    client := offline_client(connection_from_frames(bytes.empty()))
    arm_send_stream(client, 1, 10, 6, 100)
    # min(want 8, stream 10, conn 6, frame 100) = 6, debited from both windows.
    assert_eq(client.reserve_send(1, 8), 6)
    assert_eq(client.send_windows[1], 4)
    assert_eq(client.conn_send_window, 0)
    # no connection credit left: nothing can be reserved.
    assert_eq(client.reserve_send(1, 4), 0)
    assert_eq(client.send_windows[1], 4)

test "reserve_send caps a chunk at the peer's max frame size":
    client := offline_client(connection_from_frames(bytes.empty()))
    arm_send_stream(client, 1, 1000, 1000, 16)
    assert_eq(client.reserve_send(1, 1000), 16)

test "grant_send_credit grows the stream and connection windows":
    client := offline_client(connection_from_frames(bytes.empty()))
    arm_send_stream(client, 1, 0, 0, 100)
    grant_send_credit(client, 1, 50)
    assert_eq(client.send_windows[1], 50)
    grant_send_credit(client, 0, 30)
    assert_eq(client.conn_send_window, 30)

test "a new SETTINGS_INITIAL_WINDOW_SIZE resizes open stream windows by the delta":
    client := offline_client(connection_from_frames(bytes.empty()))
    client.streams.insert(1, Channel[StreamEvent](1))
    client.active.push(1)
    client.send_windows.insert(1, DEFAULT_INITIAL_WINDOW)
    # the peer shrinks the initial window; the open stream shrinks by the delta.
    apply_settings(client, [frames.setting(SETTINGS_INITIAL_WINDOW_SIZE, 1000)])
    assert_eq(client.peer_initial_window, 1000)
    assert_eq(client.send_windows[1], 1000)

test "apply_settings records the peer's max concurrent streams":
    client := offline_client(connection_from_frames(bytes.empty()))
    apply_settings(client, [frames.setting(SETTINGS_MAX_CONCURRENT_STREAMS, 3)])
    assert_eq(client.max_concurrent, 3)

test "send_stream_data splits a body across the window and finishes after a WINDOW_UPDATE":
    client := offline_client(connection_from_frames(bytes.empty()))
    # a 4-byte window on both the stream and the connection, a large frame cap.
    arm_send_stream(client, 1, 4, 4, 100)
    body := bytes.from_string_utf8("abcdefghij")
    sender := spawn send_stream_data(client, 1, body, true)
    # the first DATA carries the initial 4-byte window. reading it proves the
    # sender sent it and is now blocked waiting for more credit, which makes the
    # split deterministic rather than a race with the grants below.
    first := next_data_frame(client.outbound)!
    assert_eq(first.data.to_string_utf8()!, "abcd")
    assert(not first.end_stream)
    # grant the remaining six bytes on both windows; the sender wakes and sends.
    grant_send_credit(client, 1, 6)
    grant_send_credit(client, 0, 6)
    total := await sender
    assert_eq(total, 10)
    second := next_data_frame(client.outbound)!
    assert_eq(second.data.to_string_utf8()!, "efghij")
    assert(second.end_stream)

test "a stream's recv yields its events one at a time":
    inbox := Channel[StreamEvent](8)
    inbox.send(headers_event([hpack.header_field(":status", "200")], false))
    inbox.send(data_event(bytes.from_string_utf8("chunk-a"), false))
    inbox.send(data_event(bytes.from_string_utf8("chunk-b"), true))
    stream := Stream(offline_client(connection_from_frames(bytes.empty())), 1, inbox)
    h := stream.recv()!
    assert_eq(h.kind, STREAM_HEADERS)
    assert_eq(status_from(h.headers), 200)
    a := stream.recv()!
    assert_eq(a.kind, STREAM_DATA)
    assert_eq(a.data.to_string_utf8()!, "chunk-a")
    assert(not a.end)
    b := stream.recv()!
    assert_eq(b.data.to_string_utf8()!, "chunk-b")
    assert(b.end)

test "send_stream_data half-closes only on the chunk that asks":
    client := offline_client(connection_from_frames(bytes.empty()))
    client.send_windows.insert(1, DEFAULT_INITIAL_WINDOW)
    client.credit.insert(1, Channel[Int](CREDIT_POKE_CAP))
    assert_eq(send_stream_data(client, 1, bytes.from_string_utf8("hello"), false), 5)
    assert_eq(send_stream_data(client, 1, bytes.from_string_utf8("bye"), true), 3)
    first := next_data_frame(client.outbound)!
    assert_eq(first.data.to_string_utf8()!, "hello")
    assert(not first.end_stream)
    last := next_data_frame(client.outbound)!
    assert_eq(last.data.to_string_utf8()!, "bye")
    assert(last.end_stream)

test "send_stream_data half-closes with a lone empty frame when there is no data":
    client := offline_client(connection_from_frames(bytes.empty()))
    assert_eq(send_stream_data(client, 1, bytes.empty(), true), 0)
    frame := next_data_frame(client.outbound)!
    assert_eq(frame.data.len(), 0)
    assert(frame.end_stream)

test "open_stream registers a stream that recv reads incrementally":
    no_extra: List[hpack.HeaderField] := []
    block := header_block([hpack.header_field(":status", "200")])
    server := encode_frames([frames.headers_frame(1, block, false, true), frames.data_frame(1, bytes.from_string_utf8("one"), false), frames.data_frame(1, bytes.from_string_utf8("two"), true)])!
    client := offline_client(connection_from_frames(server))
    opened := client.open_stream("POST", "example.com", "/svc/method", no_extra, true)
    assert(not opened.is_err)
    stream := opened.ok
    assert_eq(stream.id, 1)
    reader_loop(client)
    h := stream.recv()!
    assert_eq(status_from(h.headers), 200)
    d1 := stream.recv()!
    assert_eq(d1.data.to_string_utf8()!, "one")
    assert(not d1.end)
    d2 := stream.recv()!
    assert_eq(d2.data.to_string_utf8()!, "two")
    assert(d2.end)

test "drain_coalesced leaves a single frame untouched":
    outbound := Channel[Bytes](8)
    only := drain_coalesced(bytes.from_string_utf8("solo"), outbound)
    assert_eq(only.to_string_utf8()!, "solo")

test "drain_coalesced merges queued frames into one buffer in fifo order":
    outbound := Channel[Bytes](8)
    outbound.send(bytes.from_string_utf8("BB"))
    outbound.send(bytes.from_string_utf8("CC"))
    # "AA" stands in for the frame recv() already pulled; BB and CC were queued
    # behind it and must come out concatenated, in order, in one buffer.
    merged := drain_coalesced(bytes.from_string_utf8("AA"), outbound)
    assert_eq(merged.to_string_utf8()!, "AABBCC")
    # the channel is fully drained afterwards
    assert(outbound.try_recv() == none)

# --- inline fast-path tests ---
#
# these drive the fast path over an offline connection: the request frames are
# recorded in conn.sent and the response is read out of a preloaded frame buffer,
# so a whole unary round-trip runs synchronously on the caller with no reader or
# writer task. the promotion tests then check the one-way latch and its send-window
# bookkeeping without needing a live socket.

test "an inline request runs synchronously and leaves the client single-stream":
    block := header_block([hpack.header_field(":status", "200"), hpack.header_field("content-type", "application/grpc")])
    server := encode_frames([frames.headers_frame(1, block, false, true), frames.data_frame(1, bytes.from_string_utf8("pong"), true)])!
    client := client_from_connection(connection_from_frames(server))
    no_extra: List[hpack.HeaderField] := []
    resp := client.request("POST", "example.com", "/svc/method", no_extra, bytes.from_string_utf8("ping"))!
    assert_eq(resp.status, 200)
    assert_eq(resp.body.to_string_utf8()!, "pong")
    # no second stream ever appeared, so the client stayed inline: no pipeline.
    assert_eq(client.mode, MODE_INLINE)
    assert(not client.inline_busy)
    # the stream id advanced by two, ready for the next inline call.
    assert_eq(client.next_stream_id, 3)
    client.close()

test "sequential inline requests reuse the fast path with monotonic ids":
    # one shared encoder builds both response blocks so the client's single
    # decoder stays in step reading them in order, just as it will on the wire.
    enc := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    b1 := enc.encode([hpack.header_field(":status", "200")])
    b2 := enc.encode([hpack.header_field(":status", "200")])
    server := encode_frames([frames.headers_frame(1, b1, false, true), frames.data_frame(1, bytes.from_string_utf8("one"), true), frames.headers_frame(3, b2, false, true), frames.data_frame(3, bytes.from_string_utf8("two"), true)])!
    client := client_from_connection(connection_from_frames(server))
    r1 := client.get("example.com", "/a")!
    assert_eq(r1.body.to_string_utf8()!, "one")
    r2 := client.get("example.com", "/b")!
    assert_eq(r2.body.to_string_utf8()!, "two")
    # both ran inline; the ids used were 1 then 3.
    assert_eq(client.mode, MODE_INLINE)
    assert_eq(client.next_stream_id, 5)
    client.close()

test "the inline lease is exclusive and released again by end_inline":
    client := client_from_connection(connection_from_frames(bytes.empty()))
    assert_eq(client.mode, MODE_INLINE)
    assert(client.try_begin_inline())
    # a second attempt fails while the lease is held.
    assert(not client.try_begin_inline())
    client.end_inline()
    # released, the lease can be retaken.
    assert(client.try_begin_inline())
    client.end_inline()
    client.close()

test "a closed client refuses the inline lease":
    client := client_from_connection(connection_from_frames(bytes.empty()))
    client.closed.store(1)
    assert(not client.try_begin_inline())
    client.close()

test "ensure_threaded is a no-op once the client is already threaded":
    client := offline_client(connection_from_frames(bytes.empty()))
    assert_eq(client.mode, MODE_THREADED)
    client.ensure_threaded()
    assert_eq(client.mode, MODE_THREADED)

test "the first concurrency promotes the client and leaves the send window whole":
    client := client_from_connection(connection_from_frames(bytes.empty()))
    assert_eq(client.mode, MODE_INLINE)
    client.ensure_threaded()
    # the one-way latch is now set and the pipeline owns the socket.
    assert_eq(client.mode, MODE_THREADED)
    # promotion does not touch the connection send window: inline's sends were
    # already re-granted by the peer, so it stays at the initial value.
    assert_eq(client.conn_send_window, DEFAULT_INITIAL_WINDOW)
    # promotion is idempotent.
    client.ensure_threaded()
    assert_eq(client.mode, MODE_THREADED)
    client.close()

test "assemble_response_until returns a response that arrives in time":
    inbox := Channel[StreamEvent](4)
    inbox.send(headers_event([hpack.header_field(":status", "200")], false))
    inbox.send(data_event(bytes.from_string_utf8("ok"), true))
    resp := assemble_response_until(inbox, time.mono_millis() + 2000)!
    assert_eq(resp.status, 200)
    assert_eq(resp.body.to_string_utf8()!, "ok")

test "assemble_response_until fails once the deadline passes on a silent stream":
    inbox := Channel[StreamEvent](4)
    started := time.mono_millis()
    result := assemble_response_until(inbox, started + 30)
    assert(result.is_err)
    assert_eq(result.err, REQUEST_DEADLINE_EXCEEDED)
    # the wait was bounded: it actually waited rather than failing on arrival.
    # the timeout may wake a hair before the deadline on a coarse timer, so the
    # bound is deliberately loose — the immediate-failure case is the test below.
    assert(time.mono_millis() - started >= 20)

test "assemble_response_until fails immediately on an already-past deadline":
    inbox := Channel[StreamEvent](4)
    result := assemble_response_until(inbox, time.mono_millis() - 1)
    assert(result.is_err)
    assert_eq(result.err, REQUEST_DEADLINE_EXCEEDED)
