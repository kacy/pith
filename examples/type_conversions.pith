# type conversions between primitives

fn main():
    # int to string
    number := 42
    string_value := number.to_string()
    print("int to string: {string_value}")

    # int to float
    float_value := number.to_float()
    print("int to float: {float_value}")

    # float to string
    pi_value := 3.14
    print("float to string: {pi_value.to_string()}")

    # float to int (truncates)
    print("float to int: {pi_value.to_int()}")

    # bool to string
    flag := true
    print("bool to string: {flag.to_string()}")

    # parse_int returns a result — unwrap it, or fall back on bad input
    print("parsed int: {parse_int("123").unwrap_or(0)}")
    print("bad int: {parse_int("nope").unwrap_or(0)}")

    # parse_float works the same way
    print("parsed float: {parse_float("2.718").unwrap_or(0.0)}")
