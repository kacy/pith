# the phase payoff: pith's own http/2 client talks to pith's own http/2 server
# over pith's own tls 1.3 with alpn "h2" — pure pith end to end, no external
# stack. the server (std.net.http2.server.serve_h2_tls_connection) accepts tls
# connections that negotiated "h2" and serves GETs and POSTs; the client
# (std.net.http2.connection) dials with alpn "h2", verifies the fixture ca, and
# multiplexes concurrent streams.
#
# the cases run: several concurrent GET streams over one multiplexed client (which
# promotes the client to its reader/writer pipeline); POST bodies echoed back over
# the same client — a small body, then a 200000-byte body larger than the 65535
# initial window in both directions, which forces the server to replenish its
# receive window on the upload and to chunk-and-gate the echoed response on the
# client's send window, asserting the >window payload survives both halves of the
# flow control byte for byte; then a Pool of independent connections serving
# concurrent requests. under valgrind (make memcheck) this guards the arc surface
# as request and body state crosses the per-stream handler tasks and the tls
# transport. the server awaits every serve task before returning, so teardown is
# clean and the process exits deterministically.

import std.net.http2.server as server
import std.net.http2.connection as http2
import std.net.http2.hpack as hpack
import std.net.http as http
import std.net.tls as tls
import std.bytes as bytes

CERT_PATH := "tests/live/fixtures/localhost.crt"
KEY_PATH := "tests/live/fixtures/localhost.key"
CA_PATH := "tests/live/fixtures/localhost-ca.crt"

# the handler: a POST echoes its request body back (so the body assembly and the
# flow control in both directions are checked end to end), and any other verb
# echoes the request path (so each concurrent GET stream has a distinct body).
fn hello(req: http.HttpRequestBytes) -> http.HttpResponse:
    method := req.method() catch "GET"
    if method == "POST":
        return http.response(200).with_body_bytes(req.body_bytes()).content_type("application/octet-stream")
    path := req.path() catch "/"
    return http.text(200, "hello " + path)

# build an n-byte deterministic payload (a repeated 16-byte pattern). n is chosen
# as a multiple of 16 by the caller so the buffer lands exactly on n bytes.
fn make_payload(n: Int) -> Bytes:
    buf := bytes.buffer()
    chunk := bytes.from_string_utf8("0123456789abcdef")
    mut written := 0
    while written < n:
        buf.write(chunk) catch 0
        written = written + 16
    out := buf.bytes()
    buf.free()
    return out

# find a free loopback port so repeated runs (build, then valgrind) never collide
# with a socket still in TIME_WAIT.
fn choose_port(start: Int) -> Int!:
    mut port := start
    while port < start + 200:
        probe := tcp_listen("127.0.0.1", port)
        if probe.is_ok:
            tcp_close(probe.ok)
            return port
        port = port + 1
    fail "no free tcp port"

# serve one accepted tls connection to completion, wrapped to return an Int so its
# task handle can be collected and awaited (serve_h2_tls_connection is void).
fn serve_one(conn: tls.Conn) -> Int:
    server.serve_h2_tls_connection(conn, hello)
    return 0

# accept exactly `count` tls connections, serving each on its own task, then wait
# for them all to finish before tearing the listener down. the listener is bound
# by the caller, not here — see main.
fn run_server(listener: tls.Listener, count: Int) -> Int!:
    mut tasks: List[Task[Int]] := []
    mut i := 0
    while i < count:
        conn := listener.accept()!
        tasks.push(spawn serve_one(conn))
        i = i + 1
    for t in tasks:
        await t
    listener.close()
    return 0

# a concurrent fetch worker over the shared multiplexed client. it checks the
# response itself and returns just a pass/fail so nothing large crosses the await.
struct FetchResult:
    status: Int
    ok: Bool

fn fetch(client: http2.Client, authority: String, path: String) -> FetchResult:
    attempt := client.get(authority, path)
    if attempt.is_err:
        return FetchResult(0, false)
    r := attempt.ok
    body := r.body.to_string_utf8() catch ""
    return FetchResult(r.status, r.status == 200 and body == "hello " + path)

# the same, but over a pooled set of connections.
fn pool_fetch(pool: http2.Pool, authority: String, path: String) -> FetchResult:
    extra: List[hpack.HeaderField] := []
    attempt := pool.request("GET", authority, path, extra, bytes.empty())
    if attempt.is_err:
        return FetchResult(0, false)
    r := attempt.ok
    body := r.body.to_string_utf8() catch ""
    return FetchResult(r.status, r.status == 200 and body == "hello " + path)

fn client_config() -> tls.Config!:
    return tls.client_config_with_ca_file(CA_PATH)!.with_alpn(["h2"])

fn main() -> Int!:
    authority := "localhost"
    port := choose_port(18760)!
    # bind before spawning, so the dial below cannot outrun the server. binding
    # inside the task meant the client's connect raced the scheduler, and a fixed
    # sleep was the only thing standing between them — one this case lost roughly
    # two runs in five under valgrind, which slows the server far more than it
    # slows the sleep. once the socket is listening, a connect that arrives ahead
    # of accept() waits in the kernel's backlog instead of being refused, so there
    # is no window left to time.
    config := tls.server_config(CERT_PATH, KEY_PATH)!.with_alpn(["h2", "http/1.1"])
    listener := tls.listen("127.0.0.1", port, config)!
    # one connection for the multiplexed client, three for the pool below.
    server_task := spawn run_server(listener, 4)

    # --- case 1: concurrent streams over one multiplexed client ---
    client := http2.open_with_config("127.0.0.1", port, client_config()!)!
    t1 := spawn fetch(client, authority, "/one")
    t2 := spawn fetch(client, authority, "/two")
    t3 := spawn fetch(client, authority, "/three")
    t4 := spawn fetch(client, authority, "/four")
    r1 := await t1
    r2 := await t2
    r3 := await t3
    r4 := await t4
    assert(r1.ok)
    assert(r2.ok)
    assert(r3.ok)
    assert(r4.ok)
    assert(r1.status == 200)

    # --- case 1b: POST bodies with real flow control, over the same client ---
    # a small POST body echoed back verifies request-body assembly end to end.
    no_extra: List[hpack.HeaderField] := []
    small := bytes.from_string_utf8("ping over pith h2 tls")
    echo_small := client.request("POST", authority, "/echo", no_extra, small)!
    assert(echo_small.status == 200)
    assert(bytes.eq(echo_small.body, small))

    # a body larger than the 65535-byte initial window in BOTH directions: the
    # upload forces the server to replenish its receive window (WINDOW_UPDATE), and
    # the echoed response forces the server to chunk and gate on the client's send
    # window, resuming as the client replenishes. asserting exact bytes proves both
    # halves of the flow control carry a >window payload intact.
    big := make_payload(200000)
    echo_big := client.request("POST", authority, "/echo", no_extra, big)!
    assert(echo_big.status == 200)
    assert(echo_big.body.len() == 200000)
    assert(bytes.eq(echo_big.body, big))
    client.close()

    # --- case 2: concurrent requests across a pool of connections ---
    pool := http2.open_pool_with_config("127.0.0.1", port, 3, client_config()!)!
    p1 := spawn pool_fetch(pool, authority, "/alpha")
    p2 := spawn pool_fetch(pool, authority, "/beta")
    p3 := spawn pool_fetch(pool, authority, "/gamma")
    p4 := spawn pool_fetch(pool, authority, "/delta")
    p5 := spawn pool_fetch(pool, authority, "/epsilon")
    p6 := spawn pool_fetch(pool, authority, "/zeta")
    mut ok_count := 0
    for res in [await p1, await p2, await p3, await p4, await p5, await p6]:
        if res.ok:
            ok_count = ok_count + 1
    assert(ok_count == 6)
    pool.close()

    await server_task
    config.close()
    print("pith h2 client <-> pith h2 server over tls: gets, post echoes, and a >window body all correct")
    return 0
