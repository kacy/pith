    fn close():
        close_process(self)

impl Closer for Process:
    fn close():
        close_process(self)

impl ProcessHandle:
    # give back the runtime's entry for the child and close its pipes, which
    # ends a read another task is parked in. a second close is a no-op: process
    # ids are never reissued.
    fn close():
        process_close(self.id)

# the child is closed when the last Process or pipe view naming it dies. this
# is close(), so it does not wait for the child or kill it.
impl Drop for ProcessHandle:
    fn drop():
        self.close()

