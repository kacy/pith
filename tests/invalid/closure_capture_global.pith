# a module global is reached by every task, so a closure stored in one, even
# under a guard, can run on any of them (E248)
guard mu:
    mut handlers: List[fn() -> Int] := []

fn run_all() -> Int:
    mut n := 0
    locked mu:
        for h in handlers:
            n += h()
    return n

fn main() -> Int!:
    mut xs: List[String] := []
    locked mu:
        handlers.push(fn() -> Int => xs.len())
    t := spawn run_all()
    xs.push("main")
    print("{await t}")
    return 0
