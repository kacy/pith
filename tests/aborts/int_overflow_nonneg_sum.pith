# a sum of two values that are never negative is checked by the sign of the
# result instead of the overflow flag, and still stops the program.
fn main():
    mut step := 1
    mut k := 0
    while k < 62:
        step = step * 2
        k = k + 1
    mut total := 0
    mut i := 0
    print("before")
    while i < 3:
        total = total + step
        i = i + 1
    print("after:{total}")
