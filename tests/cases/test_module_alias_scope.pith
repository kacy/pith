# an import alias reaches its own module's functions and nobody else's. both
# helpers declare `label`, and the two aliases have to resolve to their own,
# whether the function is called or taken as a value.

import module_alias_scope_first as first
import module_alias_scope_second as second

fn main():
    print(first.label())
    print(second.label())
    print(second.only_here())
    f := first.label
    print(f())
