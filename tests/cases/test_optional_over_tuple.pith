# an optional over a tuple has to build a Some shell like any other optional.
# it is the one payload shape that looks exactly like the shell itself, so
# every site that wraps a value used to store the payload raw and read the
# shell's own slots back out. the return position was always correct; these
# are the positions that were not.

struct Holder:
    pub p: (Int, String)?

fn take(p: (Int, String)?) -> String:
    if let v = p:
        return "{v.0}/{v.1}"
    return "none"

fn built() -> (Int, String)?:
    return (9, "i")

# a payload that is still owned elsewhere, so releasing it twice frees a live
# value and the next allocation reuses its block. string literals are immortal
# and cannot show this, which is why the first version of this test passed
# against a destructor that released every element twice.
fn mk(n: Int) -> String:
    return "v{n}"

fn survives_release() -> Int:
    held := mk(7)
    mut o: (Int, String)? := (5, held)
    o = none
    fresh := mk(9)
    if held != "v7":
        print("WRONG: a live payload was freed, held reads {held}")
    if fresh != "v9":
        print("WRONG: fresh reads {fresh}")
    print("aliased payload survives: {held}")

    # every other reference-counted element kind, same shape
    l := [100, 200]
    mut ol: (List[Int], Int)? := (l, 1)
    ol = none
    print("list survives: {l[0]},{l[1]}")

    inner := mk(3)
    mut on: ((Int, String), Int)? := ((3, inner), 1)
    on = none
    print("nested survives: {inner}")

    # a payload whose elements are all by-value is still a heap allocation the
    # shell has to release
    mut bv: (Int, Int)? := (1, 2)
    bv = (3, 4)
    if let v = bv:
        print("by-value pair: {v.0} {v.1}")
    return 0

fn main() -> Int:
    survives_release()
    o: (Int, String)? := (1, "a")
    if let q = o:
        print("bind {q.0} {q.1}")

    h := Holder(p: (2, "b"))
    if let w = h.p:
        print("ctor {w.0} {w.1}")

    mut hb := Holder(p: none)
    hb.p = (3, "c")
    if let x = hb.p:
        print("field-assign {x.0} {x.1}")

    xs: List[(Int, String)?] := [(4, "d"), none]
    if let e = xs[0]:
        print("element {e.0} {e.1}")
    print("element-none {take(xs[1])}")

    mut m: Map[String, (Int, String)?] := {}
    m["k"] = (5, "e")
    if let mv = m["k"]:
        print("index-assign {mv.0} {mv.1}")

    ml: Map[String, (Int, String)?] := {"j": (6, "f")}
    if let lv = ml["j"]:
        print("map-literal {lv.0} {lv.1}")

    mut a: (Int, String)? := none
    a = (7, "g")
    if let av = a:
        print("assign {av.0} {av.1}")

    print("argument {take((8, \"h\"))}")
    print("return {take(built())}")
    print("passthrough {take(o)}")
    n: (Int, String)? := none
    print("none {take(n)}")
    return 0
