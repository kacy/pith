# regression: negative float literals (-1.0) used to emit wrong IR, so the
# workaround was to write `0.0 - 1.0`. the literals now carry their value.
fn main():
    a := -1.0
    print("a={a}")
    b := -1.5
    print("b={b}")
    c := 3.0 + -2.0
    print("c={c}")
    d := -0.25 * 5.0
    print("d={d}")
