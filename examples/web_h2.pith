# a std.web app served over http/2.
#
# the app is built the same way as for http/1.1; only the listen call changes.
# listen_h2c speaks cleartext http/2, which suits a server behind a load
# balancer that terminates tls. listen_tls(host, port, cert, key) serves
# http/2 over tls, with http/1.1 for clients that do not ask for h2.
#
# main plays the client with std.net.http2's multiplexed client: one
# connection, several requests, each on its own stream.

import std.json as json
import std.net.http as http
import std.net.http2.connection as h2
import std.net.tcp as tcp
import std.web as web

PORT := 18096

fn greet(req: web.Request) -> http.HttpResponse:
    return http.text(200, "hello, {req.param("name")}")

fn zone_info(req: web.Request) -> http.HttpResponse:
    obj := json.make_object()
    json.object_set(obj, "zone", json.make_string(req.param("zone")))
    json.object_set(obj, "protocol", json.make_string("h2c"))
    return http.json_value(200, obj)

fn build_app() -> web.App:
    mut app := web.new()
    app = app.get("/hello/:name", greet)
    app = app.get("/zones/:zone", zone_info)
    return app

fn serve(port: Int) -> Int:
    return build_app().listen_h2c("127.0.0.1", port) catch 0

# connect until the accept loop answers, rather than sleeping for a guess.
fn wait_until_listening(port: Int) -> Bool:
    for attempt in 0..500:
        probe := tcp.connect("127.0.0.1", port) catch:
            sleep(10)
            continue
        tcp.close(probe)
        return true
    return false

fn main() -> Int!:
    spawn serve(PORT)
    if not wait_until_listening(PORT):
        fail "the server never came up"

    client := h2.open_h2c("127.0.0.1", PORT)!
    defer client.close()
    # routing, middleware and the /healthz route behave as they do over
    # http/1.1.
    for path in ["/hello/ada", "/zones/utc", "/healthz", "/missing"]:
        resp := client.get("localhost", path)!
        body := resp.body.to_string_utf8() catch ""
        print("GET {path} -> {resp.status} {body}")
    return 0
