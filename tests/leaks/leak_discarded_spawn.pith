# a fire-and-forget `spawn f(...)` whose handle is discarded at statement
# position — the shape every std accept loop uses (`spawn handle_conn(fd)`).
# the task slab reclaims a slot only on await or detach, so before the
# emitter learned to detach a discarded spawn, each one stranded its slot
# and the resident set grew with the TOTAL spawned, not the live count:
# ~72 mb over 200k here. with the detach the peak tracks the number of
# tasks alive at once instead.
#
# that number must not depend on how busy the machine is, or the case reads
# its load and not its leak (issue #1027: 5.8 mb to 25 mb across three runs
# beside a build). every task reports on a channel and main drains one batch
# before it spawns the next, so at most `batch` tasks are alive whatever the
# scheduler does, and the peak is the same at 200k and 800k rounds.
import leakprobe as probe

batch := 64

fn work(done: Channel[Int]):
    done.send(1)

fn main():
    n := probe.rounds()
    done := Channel[Int](batch)
    mut i := 0
    while i < n:
        mut j := 0
        while j < batch:
            spawn work(done)
            j = j + 1
        j = 0
        while j < batch:
            done.recv()
            j = j + 1
        i = i + batch
    print("{probe.peak_kb()}")
