# an unknown variant on a generic enum's bare name, which checks against
# the declaration because only instances are registered as types
enum Opt[T]:
    Some(T)
    Nothing

fn main():
    a: Opt[Int] := Opt.Nope
    b := Opt.Nada(1)
    c: Opt[Int] := Opt.Some(2)
    match c:
        Opt.Gone(x) => print("gone")
        _ => print("other")
