# checker_diagnostics.pith - checker diagnostic state and reporting helpers

from ast import get_node
from errors import Diagnostic
from std.collections import copy_list, copy_map

mut checker_diagnostics: List[Diagnostic] := []
mut checker_file_path := ""
# the node currently being checked: plain report_error calls carry its
# position, so errors land on a line even when the reporting site
# doesn't thread a node through
mut checker_current_node := 0 - 1

# controls for a body that is checked more than once. a generic body is
# walked once per specialization, and the emitter walks each one again
# just before emitting it; a fault inside such a body would otherwise be
# reported once per walk. the switches below are set by the specialization
# driver and left alone by everything else, so an ordinary pass-2 walk
# reports exactly as it always has.
#
# reporting off: every report_* call returns without recording anything.
# the emitter's re-check runs this way, because the check pass already
# reported what the body had to say.
mut checker_reporting_enabled := true
# a suffix appended to every message while set, naming the specialization
# the walk is checking against (" in first[Int]"), so a reader can tell a
# fault at one type from a body that is wrong at every type.
mut checker_message_suffix := ""
# a severity that replaces "error" while set. the count mode of the
# generic-body check records what it finds as warnings, so a corpus can be
# surveyed for faults inside bodies nothing ever checked before without
# turning a build red.
mut checker_severity_override := ""
# while a dedup scope is open, one (node, code) pair records once; the
# second specialization that trips over the same fault at the same node
# adds nothing. the first report names the type it was found at.
mut checker_dedup_active := false
mut checker_dedup_seen: Map[String, Bool] := {}

## stamp `idx` as the node that plain report_error calls take their line
## and column from, and hand back the previous stamp so a nested check
## can put it back with checker_restore_current_node. a caller that
## drops the return value leaves its stamp in place after it finishes,
## which is what statement checking relies on.
pub fn checker_set_current_node(idx: Int) -> Int:
    prev := checker_current_node
    checker_current_node = idx
    return prev

## put back a stamp saved by checker_set_current_node, so checking a
## sub-expression doesn't leave its node as the position for errors the
## enclosing expression reports afterwards. -1 means "no node", and
## reporting with that stamp gives line 0, column 0.
pub fn checker_restore_current_node(prev: Int):
    checker_current_node = prev

## the node currently being checked (-1 when none is active). lets a
## resolution site key a record by the expression it is resolving
## without threading the index through every helper.
pub fn checker_current_node_index() -> Int:
    return checker_current_node

fn checker_node_position(node_idx: Int) -> (Int, Int):
    if node_idx < 0:
        return (0, 0)
    node := get_node(node_idx)
    return (node.line, node.col)

## throw away everything reported so far and start attributing
## diagnostics to `file_path`. initialize_checker calls this once at the
## start of a check run and nothing resets again, so the diagnostics of
## a multi-module run all pile into one list.
pub fn checker_reset_diagnostics(file_path: String):
    checker_diagnostics = []
    checker_file_path = file_path
    checker_reporting_enabled = true
    checker_message_suffix = ""
    checker_severity_override = ""
    checker_dedup_active = false
    checker_dedup_seen = {}

## change the file stamped on diagnostics from here on, keeping the ones
## already reported. a check run walks several modules through one
## shared diagnostic list, so a driver has to update this as it enters
## each module or every error will name whichever file was named last.
pub fn checker_set_file_path(file_path: String):
    checker_file_path = file_path

## the file currently stamped on diagnostics, so a walk that leaves the
## module being checked can put the right file back when it returns.
pub fn checker_current_file_path() -> String:
    return checker_file_path

## turn recording on or off and hand back the previous setting, so the
## caller can restore it. see checker_reporting_enabled.
pub fn checker_set_reporting(on: Bool) -> Bool:
    prev := checker_reporting_enabled
    checker_reporting_enabled = on
    return prev

## set the text appended to every message from here on and hand back the
## previous one. pass "" to stop appending.
pub fn checker_set_message_suffix(suffix: String) -> String:
    prev := checker_message_suffix
    checker_message_suffix = suffix
    return prev

## record errors under `severity` instead of "error" from here on, and hand
## back the previous override. pass "" to record errors as errors again.
pub fn checker_set_severity_override(severity: String) -> String:
    prev := checker_severity_override
    checker_severity_override = severity
    return prev

## open a scope in which one (node, code) pair records once. nesting is
## not supported: a second begin resets the seen set.
pub fn checker_begin_dedup():
    checker_dedup_active = true
    checker_dedup_seen = {}

## close the scope opened by checker_begin_dedup.
pub fn checker_end_dedup():
    checker_dedup_active = false
    checker_dedup_seen = {}

## everything reported since the last checker_reset_diagnostics, in the
## order it was reported. nothing is filtered or deduplicated, and
## warnings share the list with errors — the `severity` field is the
## only thing telling them apart. nothing resets between modules, so
## each c_run_module result also carries the earlier modules' entries.
pub fn checker_get_diagnostics() -> List[Diagnostic]:
    return checker_diagnostics

## true when an error is already recorded at the current node's
## position — used to avoid stacking a generic fallback error on a
## specific one.
pub fn checker_reported_at_current() -> Bool:
    pos := checker_node_position(checker_current_node)
    if pos.0 == 0:
        return false
    for d in checker_diagnostics:
        if d.severity == "error" and d.line == pos.0 and d.file == checker_file_path:
            return true
    return false

# every report lands here. applies the switches above in order: nothing
# records while reporting is off; a dedup scope drops a repeat of a
# (node, code) pair; the suffix joins the message; an error takes the
# override severity when one is set.
fn checker_record(node_idx: Int, severity: String, code: String, message: String, fix: String):
    if checker_reporting_enabled == false:
        return
    if checker_dedup_active:
        dedup_key := node_idx.to_string() + ":" + code
        if checker_dedup_seen.contains_key(dedup_key):
            return
        checker_dedup_seen.insert(dedup_key, true)
    mut recorded_severity := severity
    if severity == "error" and checker_severity_override.len() > 0:
        recorded_severity = checker_severity_override
    pos := checker_node_position(node_idx)
    checker_diagnostics.push(Diagnostic(recorded_severity, code, message + checker_message_suffix, checker_file_path, pos.0, pos.1, fix))

## report an error against a specific AST node, for a site that holds
## the offending node but is not the node currently being checked — an
## argument, or a child of the expression under check. a negative
## node_idx reports at line 0, and the text renderer then prints the
## file and message with no line number and no source snippet.
pub fn report_error_at(node_idx: Int, code: String, message: String):
    checker_record(node_idx, "error", code, message, "")

## report an error at whatever node checking is currently inside. this
## is the common form: the statement and expression walkers stamp the
## node on entry with checker_set_current_node, so a reporting site
## buried in a helper gets a position without threading a node index
## through. with no node stamped yet the error lands at line 0 and
## prints without a location.
pub fn report_error(code: String, message: String):
    checker_record(checker_current_node, "error", code, message, "")

## report_error_at plus a suggested repair. the fix travels in its own
## field, not in the message: the text renderer prints it on a separate
## `fix:` line and the JSON carries it as "fix", so phrase it as a
## standalone instruction ("declare with 'mut': mut x") rather than a
## clause continuing the message. an empty fix prints no `fix:` line and
## comes out as JSON null.
pub fn report_error_with_fix_at(node_idx: Int, code: String, message: String, fix: String):
    checker_record(node_idx, "error", code, message, fix)

## report_error plus a suggested repair, positioned at the node
## currently being checked. the fix follows the same rules as in
## report_error_with_fix_at: a standalone instruction, rendered on its
## own line, and skipped when empty.
pub fn report_error_with_fix(code: String, message: String, fix: String):
    checker_record(checker_current_node, "error", code, message, fix)

## record a warning at a node's position, into the same list the errors
## go into — severity "warning" is all that distinguishes it, and
## checker_reported_at_current only ever looks at errors, so a warning
## here never suppresses a later error at the same line. no checker pass
## calls this today; the E3xx warnings a user sees come from the
## linter's own diagnostic list, not this one.
pub fn report_warning_at(node_idx: Int, code: String, message: String):
    checker_record(node_idx, "warning", code, message, "")

## record a warning with no source position at all. unlike report_error
## it ignores the current-node stamp entirely and always writes line 0,
## column 0, so it renders with the file and message but no line and no
## snippet. like report_warning_at, no checker pass calls it today.
pub fn report_warning(code: String, message: String):
    checker_record(0 - 1, "warning", code, message, "")

# ---------------------------------------------------------------
# snapshots
# ---------------------------------------------------------------

## the diagnostic state as it stood at one moment: what was reported so
## far, the file being stamped, and the switches. a run that resumes
## from a snapshot restores the list so the imported modules' findings
## are reported again without checking them again.
pub struct DiagnosticsSnapshot:
    pub diagnostics: List[Diagnostic]
    pub file_path: String
    pub current_node: Int
    pub reporting_enabled: Bool
    pub message_suffix: String
    pub severity_override: String
    pub dedup_active: Bool
    pub dedup_seen: Map[String, Bool]

## copy the state out. Diagnostic records are never mutated, so the
## list is shared one level down.
pub fn take_diagnostics_snapshot() -> DiagnosticsSnapshot:
    return DiagnosticsSnapshot(copy_list(checker_diagnostics), checker_file_path, checker_current_node, checker_reporting_enabled, checker_message_suffix, checker_severity_override, checker_dedup_active, copy_map(checker_dedup_seen))

## make the live state a copy of the snapshot, leaving the snapshot as
## it was.
pub fn restore_diagnostics_snapshot(s: DiagnosticsSnapshot):
    checker_diagnostics = copy_list(s.diagnostics)
    checker_file_path = s.file_path
    checker_current_node = s.current_node
    checker_reporting_enabled = s.reporting_enabled
    checker_message_suffix = s.message_suffix
    checker_severity_override = s.severity_override
    checker_dedup_active = s.dedup_active
    checker_dedup_seen = copy_map(s.dedup_seen)
