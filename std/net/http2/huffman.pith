# reverse lookup for decoding, keyed by "length:code".
#
# it is derived from the fixed table above, so it is built when the module loads
# rather than on the first header block that needs it. module initializers run on
# the main thread before main's body, so by the time any connection task exists
# the map is already whole and read-only, and concurrent decoders never observe
# it half-built. building it costs well under a millisecond, paid once.
decode_map: Map[String, Int] := build_decode_map()

# invert the code table into the "length:code" -> symbol map that `decode` walks.
fn build_decode_map() -> Map[String, Int]:
    table := huff_table()
    mut built: Map[String, Int] := {}
    mut i := 0
    while i < table.len():
        entry := table[i]
        built.insert(decode_key(entry.length, entry.code), i)
        i = i + 1
    return built

# a low bit mask of `n` ones (0 for n == 0).
fn low_mask(n: Int) -> Int:
    return bits.shl(1, n) - 1

# the decode-map key that uniquely identifies a codeword.
fn decode_key(length: Int, code: Int) -> String:
    return length.to_string() + ":" + code.to_string()

# huffman-encode bytes. the result is padded to a byte boundary with the
# most-significant bits of the EOS symbol, per RFC 7541 §5.2.
pub fn encode(input: Bytes) -> Bytes:
    table := huff_table()
    out := bytes.buffer()
    mut acc := 0
    mut nbits := 0
    mut i := 0
    while i < input.len():
        entry := table[input[i]]
        acc = bits.bor(bits.shl(acc, entry.length), entry.code)
        nbits = nbits + entry.length
        while nbits >= 8:
            nbits = nbits - 8
            out.write_byte(bits.band(bits.shr(acc, nbits), 255)) catch 0
        acc = bits.band(acc, low_mask(nbits))
        i = i + 1
    if nbits > 0:
        pad := 8 - nbits
        final := bits.bor(bits.shl(acc, pad), low_mask(pad))
        out.write_byte(bits.band(final, 255)) catch 0
    result := out.bytes()
    out.free()
    return result

# the number of bytes `encode` would produce for `input`, without encoding.
# hpack uses this to choose the shorter of the raw and Huffman forms.
pub fn encoded_length(input: Bytes) -> Int:
    table := huff_table()
    mut total_bits := 0
    mut i := 0
    while i < input.len():
        total_bits = total_bits + table[input[i]].length
        i = i + 1
    return (total_bits + 7) / 8

# huffman-decode bytes, rejecting a whole EOS symbol and malformed padding.
pub fn decode(input: Bytes) -> Bytes!:
    out := bytes.buffer()
    mut code := 0
    mut length := 0
    mut i := 0
    while i < input.len():
        byte := input[i]
        mut bit := 7
        while bit >= 0:
            code = bits.bor(bits.shl(code, 1), bits.band(bits.shr(byte, bit), 1))
            length = length + 1
            if length > MAX_CODE_LENGTH:
                out.free()
                fail "invalid huffman code"
            key := decode_key(length, code)
            if decode_map.contains_key(key):
                symbol := decode_map[key]
                if symbol == EOS_SYMBOL:
                    out.free()
                    fail "huffman EOS symbol is not allowed in input"
                out.write_byte(symbol) catch 0
                code = 0
                length = 0
            bit = bit - 1
        i = i + 1
    if length >= 8:
        out.free()
        fail "huffman padding is too long"
    if length > 0:
        if code != low_mask(length):
            out.free()
            fail "huffman padding must be the EOS prefix"
    result := out.bytes()
    out.free()
    return result

# --- tests ---

fn hx(data: Bytes) -> String:
    return encoding.to_hex(data)

test "huffman table is complete and well-formed":
    table := huff_table()
    assert_eq(table.len(), 257)
    assert_eq(table[48].length, 5)
    assert_eq(table[48].code, 0)
    assert_eq(table[EOS_SYMBOL].length, 30)

test "huffman encodes the RFC 7541 C.4.1 authority":
    # "www.example.com" -> f1e3 c2e5 f23a 6ba0 ab90 f4ff
    encoded := encode(bytes.from_string_utf8("www.example.com"))
    assert_eq(hx(encoded), "f1e3c2e5f23a6ba0ab90f4ff")

test "huffman round-trips the RFC 7541 C.4.1 authority":
    decoded := decode(encode(bytes.from_string_utf8("www.example.com")))!
    assert_eq(decoded.to_string_utf8()!, "www.example.com")

test "huffman encodes the RFC 7541 C.4.3 cache-control":
    # "no-cache" -> a8eb 1064 9cbf
    encoded := encode(bytes.from_string_utf8("no-cache"))
    assert_eq(hx(encoded), "a8eb10649cbf")

test "huffman encodes the RFC 7541 C.6.1 date value":
    # "Mon, 21 Oct 2013 20:13:21 GMT"
    encoded := encode(bytes.from_string_utf8("Mon, 21 Oct 2013 20:13:21 GMT"))
    assert_eq(hx(encoded), "d07abe941054d444a8200595040b8166e082a62d1bff")

test "huffman round-trips every byte value":
    out := bytes.buffer()
    mut i := 0
    while i < 256:
        out.write_byte(i) catch 0
        i = i + 1
    original := out.bytes()
    out.free()
    decoded := decode(encode(original))!
    assert_eq(hx(decoded), hx(original))

test "huffman round-trips an empty input":
    assert_eq(decode(encode(bytes.empty()))!.len(), 0)

test "huffman rejects an incomplete non-EOS padding":
    # a single zero byte decodes '0' (00000) then leaves 000 padding, which is
    # not the all-ones EOS prefix.
    result := decode(bytes.from_string_utf8(chr(0)))
    assert(result.is_err)

test "huffman rejects padding longer than seven bits":
    # 0xff is the 6-bit symbol '&' plus two 1 bits; a second 0xff pushes the
    # pending run past a full byte of padding.
    result := decode(encoding.from_hex("ffff")!)
    assert(result.is_err)
