# ir_struct_registry.pith — the compiler's memory of struct and enum
# shapes: which structs exist, their field layouts and defaults, and
# which enums box payloads. the emitter fills these during collection
# and reads them everywhere; keeping the state and its accessors in
# one module keeps that contract visible.

from ast import Node, get_node
from types import TypeInfo, get_type_info, get_type_name
from checker import c_get_expr_type
from ir_struct_layouts import ir_struct_field_count_with_state, ir_struct_field_name_at_with_state, ir_struct_field_type_name_with_state, ir_struct_field_default_node_with_state
from ir_decode_calls import ir_struct_has_default_fields_with_state

pub mut ir_boxed_enums: Map[String, Bool] := {}
pub mut ir_enum_payload_kinds: Map[String, String] := {} # "Shape.Circle" -> "float,string"
pub mut ir_enum_variant_lists: Map[String, String] := {} # "Shape" -> "Circle,Square"
pub mut ir_struct_names: Map[String, Int] := {} # struct name -> field count
pub mut ir_struct_field_lookup: Map[String, String] := {} # "Struct.field" -> field type
pub mut ir_struct_field_index_lookup: Map[String, String] := {} # "Struct.field" -> field index string
pub mut ir_struct_decl_nodes: Map[String, Int] := {} # struct name -> declaration node idx
pub mut ir_struct_field_default_nodes: Map[String, Int] := {} # "Struct.field" -> default expr node idx

## strip type arguments: Box[Int] and Box share one layout.
pub fn ir_struct_base_name(sname: String) -> String:
    if sname.len() == 0:
        return sname
    bracket := sname.index_of("[")
    if bracket >= 0:
        return sname.substring(0, bracket)
    return sname

## the reference-counting kind for an emission type hint, or ""
## for kinds that never own heap memory.
pub fn ir_rc_kind(type_hint: String) -> String:
    if type_hint == "string":
        return "string"
    if type_hint == "list" or type_hint == "list_string":
        return "list"
    if type_hint == "map" or type_hint == "map_int":
        return "map"
    if type_hint == "set" or type_hint == "set_int":
        return "set"
    if type_hint == "bytes":
        return "bytes"
    if type_hint == "closure":
        return "closure"
    # a tuple is a struct:tuple header allocation, so it releases through
    # the same struct header count.
    if type_hint == "tuple":
        return "tuple"
    # every struct is releasable: the header-carrying allocation frees at
    # the last count, and types with rc fields additionally run their
    # generated destructor. checked types carry the bare name; emission
    # hints carry the struct: prefix.
    if type_hint.starts_with("struct:"):
        return "struct"
    base := ir_struct_base_name(type_hint)
    if ir_struct_names.contains_key(base):
        return "struct"
    # a type named through its module — `decimal.Decimal` in an enum payload —
    # arrives qualified, and the registry keys structs by their bare name. the
    # only question here is whether the value is a heap struct that has to be
    # retained and released, and two modules with a same-named struct both
    # answer yes, so the suffix decides it without having to know which one it
    # is. getting this wrong is silent: the payload is stored without a count
    # and the enum's destructor skips it, so it dangles.
    dot := base.last_index_of(".")
    if dot >= 0:
        if ir_struct_names.contains_key(base.substring(dot + 1, base.len())):
            return "struct"
    return ""

# every rc kind releases: strings via their header count, collections via
# the shared-handle count with a free-time element cascade.

## struct name returned by well-known builtin constructors, or "".
pub fn ir_known_struct_return_type(fname: String) -> String:
    if ir_struct_names.contains_key(fname):
        return fname
    if fname == "get_node":
        return "Node"
    if fname == "advance_token" or fname == "expect":
        return "Token"
    if fname == "ti_primitive" or fname == "ti_struct" or fname == "ti_enum" or fname == "ti_function" or fname == "ti_optional" or fname == "ti_result" or fname == "ti_tuple" or fname == "ti_list" or fname == "ti_map" or fname == "ti_set" or fname == "ti_task" or fname == "ti_channel" or fname == "get_type_info":
        return "TypeInfo"
    return ""

## the boxed-enum name for an eq/neq node, or "" when neither side
## is one. checked types name enums; emission inference doesn't.
pub fn ir_binary_enum_eq_name(node: Node) -> String:
    left_name := get_type_name(c_get_expr_type(node.children[0]))
    if ir_boxed_enums.contains_key(left_name):
        return left_name
    right_name := get_type_name(c_get_expr_type(node.children[1]))
    if ir_boxed_enums.contains_key(right_name):
        return right_name
    return ""

## true when any field of the struct declares a default value.
pub fn ir_struct_has_default_fields(target_info: TypeInfo) -> Bool:
    return ir_struct_has_default_fields_with_state(target_info, ir_struct_field_default_nodes)

## number of fields in a registered struct, or -1 when unknown.
pub fn ir_struct_field_count(struct_name: String) -> Int:
    return ir_struct_field_count_with_state(struct_name, ir_struct_names)

## field name at an index in declaration order, or "".
pub fn ir_struct_field_name_at(struct_name: String, field_index: Int) -> String:
    return ir_struct_field_name_at_with_state(struct_name, field_index, ir_struct_names, ir_struct_field_index_lookup)

## a field's declared type name, or "".
pub fn ir_struct_field_type_name(struct_name: String, field_name: String) -> String:
    return ir_struct_field_type_name_with_state(struct_name, field_name, ir_struct_names, ir_struct_field_lookup)

## the ast node of a field's default expression, or -1.
pub fn ir_struct_field_default_node(struct_name: String, field_name: String) -> Int:
    return ir_struct_field_default_node_with_state(struct_name, field_name, ir_struct_names, ir_struct_field_default_nodes)
