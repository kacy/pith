# ir_decode_emit.pith: recognition and lowering of json, handle-pool (toml/yaml),
# and config typed struct decode calls and generic specialization bodies.
#
# expression lowering stays in ir_lower; entry points take IrDecodeHooks
# instead of importing ir_lower back so the module graph stays a strict DAG.

from ast import Node, get_node, node_kind
from checker import c_get_expr_type, c_ident_is_shadowed_alias
from types import TypeInfo, get_type_info, lookup_type_id
from ir_ast_helpers import ir_unwrap_pub_node
from ir_common import ir_base_decl_name, ir_cached_decode_call_nodes, ir_root_items
from ir_builder import ir_emit, ir_reg, ir_str, ir_str_interned, ir_label, ir_new_temp_name, ir_zero_reg
from ir_state import IrDecodeHooks, ir_var_types, ir_module_aliases, ir_active_generic_params, ir_active_generic_concrete_types, ir_result_reg_funcs, ir_struct_decl_nodes, ir_struct_names, ir_decode_last_args, ir_decode_partial_push, ir_decode_partial_begin, ir_decode_partial_end
from ir_types import ir_type_from_tid, ir_rc_kind, ir_resolve_type_hint, ir_struct_base_name, ir_struct_field_count, ir_struct_field_default_node, ir_struct_field_name_at, ir_struct_has_default_fields, ir_struct_needs_dtor, ir_struct_field_tid_at
from ir_symbols import ir_param_name_at, ir_module_alias_member_name, ir_generic_preferred_name, ir_json_generic_name, ir_config_generic_name, ir_handle_generic_name, ir_queue_generic_specialization, ir_resolve_generic_module_call_name, ir_specialize_type_name
from ir_primitives import ir_emit_call_text, ir_emit_call0, ir_emit_call1, ir_emit_call2, ir_emit_call3, ir_emit_call4, ir_emit_label, ir_emit_optional_none_value, ir_emit_optional_owned_some, ir_emit_optional_some_value, ir_rc_release_reg, ir_string_release_reg, ir_emit_json_field_ok, ir_emit_result_value_field, ir_emit_result_flag_field, ir_emit_result_ok_field_typed, ir_emit_registered_rcall_boxed_into, ir_emit_result_return_error_branch, ir_emit_result_store_error_branch, ir_emit_decode_field_error_branch, ir_emit_ok_result_tuple_raw, ir_emit_err_result_tuple_raw, ir_emit_struct_result_return, ir_emit_struct_result_store
from ir_collections_ops import ir_emit_dotted_path_lookup, ir_emit_dotted_path_lookup_or_return
from ir_json_fill_emit import JsonFillField, ir_emit_json_fill_flat

# ===========================================================================
# Decode call & specialization recognition
# ===========================================================================

fn ir_decode_field_receiver(index_idx: Int, member_name: String) -> String:
    index_node := get_node(index_idx)
    if index_node.kind != "index" or index_node.children.len() < 2:
        return ""
    base_node := get_node(index_node.children[0])
    if base_node.kind != "field_access" or base_node.value != member_name:
        return ""
    if base_node.children.len() < 1:
        return ""
    recv := get_node(base_node.children[0])
    if recv.kind != "ident" or c_ident_is_shadowed_alias(base_node.children[0]):
        return ""
    return recv.value

## true when `recv.member[T]` names a std.json decode entry point under any alias.
pub fn ir_is_json_decode_callee(index_idx: Int, member_name: String) -> Bool:
    recv_name := ir_decode_field_receiver(index_idx, member_name)
    if recv_name.len() == 0:
        return false
    if ir_module_aliases.contains_key(recv_name) and ir_module_aliases[recv_name] == "std.json":
        return true
    return recv_name == "json" or recv_name == "json_mod"

## true when `recv.member[T]` names a std.config decode entry point under any alias.
pub fn ir_is_config_decode_callee(index_idx: Int, member_name: String) -> Bool:
    recv_name := ir_decode_field_receiver(index_idx, member_name)
    if recv_name.len() == 0:
        return false
    if ir_module_aliases.contains_key(recv_name) and ir_module_aliases[recv_name] == "std.config":
        return true
    return recv_name == "config" or recv_name == "config_mod"

## true when `module_path` uses the shared handle-pool decode lowering (std.toml/std.yaml).
pub fn ir_is_handle_pool_module(module_path: String) -> Bool:
    return module_path == "std.toml" or module_path == "std.yaml"

## true when `recv.member[T]` names a handle-pool decode entry point under any alias.
pub fn ir_is_handle_decode_callee(index_idx: Int, member_name: String) -> Bool:
    recv_name := ir_decode_field_receiver(index_idx, member_name)
    if recv_name.len() == 0:
        return false
    if ir_module_aliases.contains_key(recv_name) and ir_is_handle_pool_module(ir_module_aliases[recv_name]):
        return true
    return recv_name == "toml" or recv_name == "toml_mod" or recv_name == "yaml" or recv_name == "yaml_mod"

## true when `index_idx` names `config.decode_file[T]` or bare `decode_file[T]`.
pub fn ir_is_config_file_decode_callee(index_idx: Int, member_name: String) -> Bool:
    index_node := get_node(index_idx)
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind == "ident":
        return base_node.value == member_name
    return ir_is_config_decode_callee(index_idx, member_name)

fn ir_in_handle_pool_module(module_path: String) -> Bool:
    return module_path == "" or ir_is_handle_pool_module(module_path)

fn ir_is_handle_spec_name(base_name: String, suffix: String) -> Bool:
    return base_name == "std_toml_" + suffix or base_name == "std_yaml_" + suffix

## true when specializing std.config's `decode[T]` or `decode_prefix[T]`.
pub fn ir_is_config_decode_specialization(base_name: String, prefixed: Bool, module_path: String, decl_idx: Int) -> Bool:
    local_std_config := module_path == "" or module_path == "std/config"
    first_param := ir_param_name_at(decl_idx, 0)
    second_param := ir_param_name_at(decl_idx, 1)
    if prefixed:
        if base_name == "std_config_decode_prefix":
            return true
        return base_name == "decode_prefix" and local_std_config and first_param == "cfg" and second_param == "prefix"
    if base_name == "std_config_decode":
        return true
    return base_name == "decode" and local_std_config and first_param == "cfg"

## true when specializing handle-pool `decode[T](handle)`.
pub fn ir_is_handle_decode_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    if ir_is_handle_spec_name(base_name, "decode"):
        return true
    return base_name == "decode" and ir_in_handle_pool_module(module_path) and ir_param_name_at(decl_idx, 0) == "handle"

## true when specializing handle-pool `decode_path[T](handle, dotted_path)`.
pub fn ir_is_handle_decode_path_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    if ir_is_handle_spec_name(base_name, "decode_path"):
        return true
    return base_name == "decode_path" and ir_in_handle_pool_module(module_path) and ir_param_name_at(decl_idx, 0) == "handle" and ir_param_name_at(decl_idx, 1) == "dotted_path"

## true when specializing handle-pool `decode_text_path[T](input, dotted_path)`.
pub fn ir_is_handle_decode_text_path_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    if ir_is_handle_spec_name(base_name, "decode_text_path"):
        return true
    return base_name == "decode_text_path" and ir_in_handle_pool_module(module_path) and ir_param_name_at(decl_idx, 0) == "input" and ir_param_name_at(decl_idx, 1) == "dotted_path"

## true when specializing handle-pool `decode_text[T](input)`.
pub fn ir_is_handle_decode_text_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    if ir_is_handle_spec_name(base_name, "decode_text"):
        return true
    return base_name == "decode_text" and ir_in_handle_pool_module(module_path) and ir_param_name_at(decl_idx, 0) == "input"

## true when specializing std.json `decode_object[T](handle)`.
pub fn ir_is_json_decode_object_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    local_std_json := module_path == "" or module_path == "std.json"
    if base_name == "std_json_decode_object":
        return true
    return base_name == "decode_object" and local_std_json and ir_param_name_at(decl_idx, 0) == "handle"

## true when specializing std.json `decode[T]` or `decode_text[T]`.
pub fn ir_is_json_decode_specialization(base_name: String, module_path: String, decl_idx: Int, text_input: Bool) -> Bool:
    local_std_json := module_path == "" or module_path == "std.json"
    first_param := ir_param_name_at(decl_idx, 0)
    if text_input:
        if base_name == "std_json_decode_text":
            return true
        return base_name == "decode_text" and local_std_json and first_param == "input"
    if base_name == "std_json_decode":
        return true
    return base_name == "decode" and local_std_json and first_param == "input"

## true when specializing std.json `decode_path[T](handle, dotted_path)`.
pub fn ir_is_json_decode_path_specialization(base_name: String, module_path: String, decl_idx: Int) -> Bool:
    local_std_json := module_path == "" or module_path == "std.json"
    if base_name == "std_json_decode_path":
        return true
    return base_name == "decode_path" and local_std_json and ir_param_name_at(decl_idx, 0) == "handle" and ir_param_name_at(decl_idx, 1) == "dotted_path"

# ===========================================================================
# Decode field type classification & helper symbol lookup
# ===========================================================================

fn ir_resolve_decode_call_name(index_idx: Int, member_name: String) -> String:
    index_node := get_node(index_idx)
    if index_node.kind == "index" and index_node.children.len() > 0:
        base_node := get_node(index_node.children[0])
        if base_node.kind == "field_access" and base_node.children.len() > 0:
            recv := get_node(base_node.children[0])
            if recv.kind == "ident" and not c_ident_is_shadowed_alias(base_node.children[0]):
                alias_name := ir_module_alias_member_name(recv.value, member_name)
                if alias_name.len() > 0:
                    return alias_name
    return member_name

fn ir_json_primitive_suffix(field_tid: Int) -> String:
    info := get_type_info(field_tid)
    if info.kind != "primitive":
        return ""
    if info.name == "String":
        return "string"
    if info.name == "Int":
        return "int"
    if info.name == "Bool":
        return "bool"
    if info.name == "Float":
        return "float"
    return ""

fn ir_json_object_helper_name(field_tid: Int) -> String:
    prim := ir_json_primitive_suffix(field_tid)
    if prim.len() > 0:
        return "object_require_" + prim
    info := get_type_info(field_tid)
    if info.kind == "list" and info.inner >= 0:
        elem_prim := ir_json_primitive_suffix(info.inner)
        if elem_prim.len() > 0:
            return "object_require_" + elem_prim + "_list"
    return ""

fn ir_json_require_helper_name(field_tid: Int) -> String:
    prim := ir_json_primitive_suffix(field_tid)
    if prim.len() > 0:
        return "std_json_require_" + prim
    return ""

fn ir_json_scan_required_helper_name(field_tid: Int) -> String:
    prim := ir_json_primitive_suffix(field_tid)
    if prim.len() > 0:
        return "std_json_scan_required_" + prim + "_bytes"
    return ""

fn ir_json_scalar_has_helper_name(field_tid: Int) -> String:
    prim := ir_json_primitive_suffix(field_tid)
    if prim.len() > 0:
        return "std_json_scalar_has_" + prim
    return ""

fn ir_json_type_name_char(name: String) -> String:
    if name == "String":
        return "s"
    if name == "Int":
        return "i"
    if name == "Bool":
        return "b"
    if name == "Float":
        return "f"
    return ""

fn ir_json_field_type_char(field_tid: Int) -> String:
    info := get_type_info(field_tid)
    if info.kind == "primitive":
        return ir_json_type_name_char(info.name)
    return ""

fn ir_kv_scalar_require_member(family: String, field_tid: Int) -> String:
    resolved := ir_resolve_type_hint(ir_type_from_tid(field_tid))
    if resolved == "string":
        if family == "config":
            return "require"
        return "require_string"
    if resolved == "int":
        return "require_int"
    if resolved == "bool":
        return "require_bool"
    return ""

fn ir_struct_decode_field_tid(field_tid: Int) -> Int:
    if get_type_info(field_tid).kind == "struct":
        return field_tid
    return 0 - 1

fn ir_optional_inner_tid(field_tid: Int) -> Int:
    info := get_type_info(field_tid)
    if info.kind == "optional":
        return info.inner
    return 0 - 1

fn ir_json_list_elem_tid(field_tid: Int) -> Int:
    info := get_type_info(field_tid)
    if info.kind != "list" or info.inner < 0:
        return 0 - 1
    return info.inner

fn ir_json_struct_list_elem_tid(field_tid: Int) -> Int:
    elem_tid := ir_json_list_elem_tid(field_tid)
    if elem_tid < 0:
        return 0 - 1
    return ir_struct_decode_field_tid(elem_tid)

fn ir_json_map_value_tid(field_tid: Int) -> Int:
    info := get_type_info(field_tid)
    if info.kind != "map" or info.value_type < 0:
        return 0 - 1
    if info.key_type != lookup_type_id("String"):
        return 0 - 1
    return info.value_type

fn ir_json_node_built_collection(field_tid: Int) -> Bool:
    if ir_json_map_value_tid(field_tid) >= 0:
        return true
    elem_tid := ir_json_list_elem_tid(field_tid)
    if elem_tid < 0:
        return false
    elem := get_type_info(elem_tid)
    return elem.kind == "list" or elem.kind == "map"

fn ir_struct_has_optional_fields(target_info: TypeInfo) -> Bool:
    for field_tid in target_info.field_types:
        if ir_optional_inner_tid(field_tid) >= 0:
            return true
    return false

fn ir_json_field_is_nested(field_tid: Int) -> Bool:
    return ir_struct_decode_field_tid(field_tid) >= 0 or ir_json_list_elem_tid(field_tid) >= 0 or ir_json_map_value_tid(field_tid) >= 0

fn ir_struct_has_nested_decode_fields(target_info: TypeInfo) -> Bool:
    for field_tid in target_info.field_types:
        if ir_json_field_is_nested(field_tid):
            return true
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        if optional_inner_tid >= 0 and ir_json_field_is_nested(optional_inner_tid):
            return true
    return false

# the type id of field `i` of a struct a specialization body is decoding.
# a specialization body has no call node to take the checker's field tids from,
# so lookup_type_id supplies the tid the layout cannot (optionals, lists, maps).
fn ir_specialized_struct_field_tid(struct_name: String, i: Int) -> Int:
    mut fallback := 0 - 1
    struct_tid := lookup_type_id(struct_name)
    if struct_tid >= 0:
        info := get_type_info(struct_tid)
        if info.kind == "struct" and i < info.field_types.len():
            fallback = info.field_types[i]
    return ir_struct_field_tid_at(struct_name, i, fallback)

# ===========================================================================
# Shared IR emission primitives for decode calls & field branches
# ===========================================================================

# result-returning decode helper calls, routed through the register-ABI
# registry: a registered pair-returning helper is rcall'd and boxed back into
# the result tuple every decode consumer expects; anything else keeps call.
fn ir_emit_decode_result_call1(result_reg: Int, fname: String, arg0: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 1, " " + arg0.to_string())
        return
    ir_emit_call1(result_reg, fname, "tuple", arg0)

fn ir_emit_decode_result_call2(result_reg: Int, fname: String, arg0: Int, arg1: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 2, " " + arg0.to_string() + " " + arg1.to_string())
        return
    ir_emit_call2(result_reg, fname, "tuple", arg0, arg1)

fn ir_emit_decode_result_call3(result_reg: Int, fname: String, arg0: Int, arg1: Int, arg2: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 3, " " + arg0.to_string() + " " + arg1.to_string() + " " + arg2.to_string())
        return
    ir_emit_call3(result_reg, fname, "tuple", arg0, arg1, arg2)

# the concrete struct tid a decode call targets, or -1 when there is none.
# at a plain call site the checker already knows the result is User!; inside
# a generic wrapper body we recover the struct from the explicit type argument
# under the active substitution.
fn ir_decode_target_tid(idx: Int, node: Node) -> Int:
    ret_tid := c_get_expr_type(idx)
    if ret_tid >= 0:
        ret_info := get_type_info(ret_tid)
        if ret_info.kind == "result" and get_type_info(ret_info.inner).kind == "struct":
            return ret_info.inner
    if node.children.len() == 0:
        return 0 - 1
    index_node := get_node(node.children[0])
    if index_node.kind != "index" or index_node.children.len() < 2:
        return 0 - 1
    type_arg := get_node(index_node.children[1])
    concrete_name := ir_specialize_type_name(type_arg.value, ir_active_generic_params, ir_active_generic_concrete_types)
    concrete_tid := lookup_type_id(concrete_name)
    if concrete_tid < 0 or get_type_info(concrete_tid).kind != "struct":
        return 0 - 1
    return concrete_tid

fn ir_decode_collect_arg_regs(node: Node, start_idx: Int, hooks: IrDecodeHooks) -> List[Int]:
    mut arg_regs: List[Int] := []
    for child, i in node.children:
        if i < start_idx:
            continue
        if node_kind(child) == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                arg_regs.push(hooks.emit_expr(cn.children[0]))
        else:
            arg_regs.push(hooks.emit_expr(child))
    ir_decode_last_args = arg_regs
    return arg_regs

fn ir_decode_arg_expr_idx(node: Node, start_idx: Int) -> Int:
    for child, i in node.children:
        if i < start_idx:
            continue
        if node_kind(child) == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                return cn.children[0]
            continue
        return child
    return 0 - 1

fn ir_decode_arg_is_minted(node: Node, start_idx: Int) -> Bool:
    expr := ir_decode_arg_expr_idx(node, start_idx)
    if expr < 0:
        return false
    kind := get_node(expr).kind
    return kind == "call" or kind == "method_call" or kind == "binary" or kind == "string_interp"

fn ir_release_minted_decode_args(node: Node, arg_regs: List[Int], positions: List[Int]):
    for pos in positions:
        if pos >= 1 and pos <= arg_regs.len() and ir_decode_arg_is_minted(node, pos):
            ir_string_release_reg(arg_regs[pos - 1])

# a result tuple that passed its error branch is finished the moment its ok
# payload is read out: releasing it frees the three-slot allocation while the
# extracted payload keeps its count.
fn ir_take_json_ok(result_r: Int, field_tid: Int) -> Int:
    ok_r := ir_emit_json_field_ok(result_r, field_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_take_result_ok(result_r: Int, tid: Int) -> Int:
    ok_r := ir_emit_result_value_field(result_r, tid, "ok")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_take_result_ok_typed(result_r: Int, type_name: String) -> Int:
    ok_r := ir_emit_result_ok_field_typed(result_r, type_name)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_decode_held_kind(field_tid: Int) -> String:
    if ir_optional_inner_tid(field_tid) >= 0:
        return "tuple"
    return ir_rc_kind(ir_type_from_tid(field_tid))

fn ir_emit_pool_mark_slot(fn_name: String, temp_prefix: String) -> String:
    r := ir_reg()
    ir_emit_call0(r, fn_name, "int")
    var_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(var_name, "int")
    ir_emit("store " + var_name + " " + r.to_string())
    return var_name

struct IrJsonPoolMark:
    node_id_var: String
    array_len_var: String

fn ir_emit_json_pool_mark(mark_node_id_name: String, mark_array_len_name: String) -> IrJsonPoolMark:
    return IrJsonPoolMark(ir_emit_pool_mark_slot(mark_node_id_name, "json_pool_node_mark"), ir_emit_pool_mark_slot(mark_array_len_name, "json_pool_array_mark"))

fn ir_emit_json_pool_restore(mark: IrJsonPoolMark, restore_name: String):
    node_r := ir_reg()
    ir_emit("load " + node_r.to_string() + " " + mark.node_id_var)
    array_r := ir_reg()
    ir_emit("load " + array_r.to_string() + " " + mark.array_len_var)
    ir_emit_call2(ir_reg(), restore_name, "void", node_r, array_r)

struct IrHandlePoolMark:
    node_id_var: String
    table_len_var: String
    array_len_var: String

fn ir_emit_handle_pool_mark(mark_node_id_name: String, mark_table_len_name: String, mark_array_len_name: String) -> IrHandlePoolMark:
    return IrHandlePoolMark(ir_emit_pool_mark_slot(mark_node_id_name, "handle_pool_node_mark"), ir_emit_pool_mark_slot(mark_table_len_name, "handle_pool_table_mark"), ir_emit_pool_mark_slot(mark_array_len_name, "handle_pool_array_mark"))

fn ir_emit_handle_pool_restore(mark: IrHandlePoolMark, restore_name: String):
    node_r := ir_reg()
    ir_emit("load " + node_r.to_string() + " " + mark.node_id_var)
    table_r := ir_reg()
    ir_emit("load " + table_r.to_string() + " " + mark.table_len_var)
    array_r := ir_reg()
    ir_emit("load " + array_r.to_string() + " " + mark.array_len_var)
    ir_emit_call3(ir_reg(), restore_name, "void", node_r, table_r, array_r)

fn ir_emit_decode_dotted_path(root_r: Int, dotted_path_r: Int, require_fn: String, int_tid: Int, prefix: String, temp_name: String, done_l: String) -> Int:
    current_name := ir_new_temp_name(prefix + "_current")
    parts_name := ir_new_temp_name(prefix + "_parts")
    len_name := ir_new_temp_name(prefix + "_parts_len")
    idx_name := ir_new_temp_name(prefix + "_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    return ir_emit_dotted_path_lookup(root_r, dotted_path_r, require_fn, int_tid, current_name, parts_name, len_name, idx_name, temp_name, done_l)

# describes the decode family and whether we are emitting at an inline call
# site (resolve against index_idx, store errors to temp_name/done_l) or inside
# a generic specialization body (resolve against module_path, return or store).
struct IrDecodeSite:
    family: String
    specialized: Bool
    index_idx: Int
    module_path: String
    temp_name: String
    done_l: String

fn ir_decode_site_call_name(site: IrDecodeSite, member: String) -> String:
    if not site.specialized:
        return ir_resolve_decode_call_name(site.index_idx, member)
    if site.family == "config":
        return "std_config_" + member
    return ir_resolve_generic_module_call_name(site.module_path, member)

struct IrDecodeFieldBranch:
    field_temp: String
    present_l: String
    merge_l: String

fn ir_begin_decode_field_branch(has_r: Int, temp_prefix: String, temp_type: String) -> IrDecodeFieldBranch:
    present_l := ir_label()
    missing_l := ir_label()
    merge_l := ir_label()
    field_temp := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(field_temp, temp_type)
    ir_emit("brif " + has_r.to_string() + " " + present_l + " " + missing_l)
    ir_emit_label(missing_l)
    return IrDecodeFieldBranch(field_temp, present_l, merge_l)

fn ir_decode_field_store_and_merge(branch: IrDecodeFieldBranch, value_r: Int):
    ir_emit("store " + branch.field_temp + " " + value_r.to_string())
    ir_emit("jmp " + branch.merge_l)

fn ir_decode_field_load_after_merge(branch: IrDecodeFieldBranch) -> Int:
    ir_emit_label(branch.merge_l)
    loaded_r := ir_reg()
    ir_emit("load " + loaded_r.to_string() + " " + branch.field_temp)
    return loaded_r

# the Some a present optional field is stored as: a heap payload belongs to
# the shell so the struct's destructor releases both shell and payload (#1144).
fn ir_decode_optional_some(value_r: Int, inner_tid: Int) -> Int:
    kind := ir_rc_kind(ir_type_from_tid(inner_tid))
    if kind.len() == 0 or kind == "tuple":
        return ir_emit_optional_some_value(value_r)
    return ir_emit_optional_owned_some(value_r, kind)

fn ir_emit_decode_field_error(site: IrDecodeSite, field_result_r: Int):
    if site.done_l.len() == 0:
        ir_emit_result_return_error_branch(field_result_r)
    else:
        ir_emit_decode_field_error_branch(field_result_r, site.temp_name, site.done_l)

fn ir_emit_nested_decode_path(parent_handle_r: Int, key_r: Int, target_tid: Int, require_name: String, decode_name: String, temp_prefix: String) -> Int:
    child_result_r := ir_reg()
    ir_emit_decode_result_call2(child_result_r, require_name, parent_handle_r, key_r)
    done_l := ir_label()
    temp_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(temp_name, "tuple")
    ir_emit_result_store_error_branch(child_result_r, temp_name, done_l)
    child_handle_r := ir_take_result_ok(child_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(decode_name, [ir_type_from_tid(target_tid)], "tuple"), child_handle_r)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

fn ir_emit_site_nested_decode(site: IrDecodeSite, container_r: Int, key_r: Int, target_tid: Int) -> Int:
    if site.family == "config":
        mut decode_name := ir_config_generic_name("decode_prefix")
        if not site.specialized:
            decode_name = ir_generic_preferred_name(ir_resolve_decode_call_name(site.index_idx, "decode_prefix"), "decode_prefix")
        result_r := ir_reg()
        ir_emit_decode_result_call2(result_r, ir_queue_generic_specialization(decode_name, [ir_type_from_tid(target_tid)], "tuple"), container_r, key_r)
        return result_r
    if site.family == "handle":
        mut decode_name := ir_handle_generic_name("decode", site.module_path)
        if not site.specialized:
            decode_name = ir_generic_preferred_name(ir_resolve_decode_call_name(site.index_idx, "decode"), "decode")
        return ir_emit_nested_decode_path(container_r, key_r, target_tid, ir_decode_site_call_name(site, "require_table"), decode_name, "handle_nested_decode")
    mut decode_name := ir_json_generic_name("decode_object")
    if not site.specialized:
        decode_name = ir_generic_preferred_name(ir_resolve_decode_call_name(site.index_idx, "decode_object"), "decode_object")
    return ir_emit_nested_decode_path(container_r, key_r, target_tid, ir_decode_site_call_name(site, "object_require_object"), decode_name, "json_nested_decode")

# ===========================================================================
# JSON node-pool collection builders (struct lists, nested lists, maps)
# ===========================================================================

struct IrJsonListHelpers:
    require_array: String
    array_len: String
    require_element: String
    element_error: String
    decode_object: String

fn ir_json_list_helpers(site: IrDecodeSite) -> IrJsonListHelpers:
    mut decode_name := ir_json_generic_name("decode_object")
    if not site.specialized:
        decode_name = ir_generic_preferred_name(ir_resolve_decode_call_name(site.index_idx, "decode_object"), "decode_object")
    return IrJsonListHelpers(ir_decode_site_call_name(site, "object_require_array"), ir_decode_site_call_name(site, "array_len"), ir_decode_site_call_name(site, "require_object_element"), ir_decode_site_call_name(site, "element_decode_error"), decode_name)

struct IrJsonNodeHelpers:
    require_array: String
    require_map: String
    array_len: String
    array_get: String
    object_get: String
    member_count: String
    member_key: String
    node_int: String
    node_string: String
    node_bool: String
    node_float: String
    node_object: String
    node_array: String
    node_map: String
    element_path: String
    member_path: String
    path_error: String
    decode_object: String

fn ir_json_node_helpers(site: IrDecodeSite) -> IrJsonNodeHelpers:
    mut decode_name := ir_json_generic_name("decode_object")
    if not site.specialized:
        decode_name = ir_generic_preferred_name(ir_resolve_decode_call_name(site.index_idx, "decode_object"), "decode_object")
    return IrJsonNodeHelpers(ir_decode_site_call_name(site, "object_require_array"), ir_decode_site_call_name(site, "object_require_map"), ir_decode_site_call_name(site, "array_len"), ir_decode_site_call_name(site, "array_get"), ir_decode_site_call_name(site, "object_get"), ir_decode_site_call_name(site, "object_member_count"), ir_decode_site_call_name(site, "object_member_key"), ir_decode_site_call_name(site, "node_require_int"), ir_decode_site_call_name(site, "node_require_string"), ir_decode_site_call_name(site, "node_require_bool"), ir_decode_site_call_name(site, "node_require_float"), ir_decode_site_call_name(site, "node_require_object"), ir_decode_site_call_name(site, "node_require_array"), ir_decode_site_call_name(site, "node_require_map"), ir_decode_site_call_name(site, "element_path"), ir_decode_site_call_name(site, "member_path"), ir_decode_site_call_name(site, "path_decode_error"), decode_name)

fn ir_emit_decode_loop_cond(loop_l: String, idx_name: String, len_name: String, body_l: String, loop_done_l: String):
    ir_emit_label(loop_l)
    loop_idx_r := ir_reg()
    ir_emit("load " + loop_idx_r.to_string() + " " + idx_name)
    loop_len_r := ir_reg()
    ir_emit("load " + loop_len_r.to_string() + " " + len_name)
    cond_r := ir_reg()
    ir_emit("lt " + cond_r.to_string() + " " + loop_idx_r.to_string() + " " + loop_len_r.to_string())
    ir_emit("brif " + cond_r.to_string() + " " + body_l + " " + loop_done_l)

fn ir_emit_decode_loop_step(idx_name: String, loop_l: String):
    step_idx_r := ir_reg()
    ir_emit("load " + step_idx_r.to_string() + " " + idx_name)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    next_idx_r := ir_reg()
    ir_emit("add " + next_idx_r.to_string() + " " + step_idx_r.to_string() + " " + one_r.to_string())
    ir_emit("store " + idx_name + " " + next_idx_r.to_string())
    ir_emit("jmp " + loop_l)

fn ir_emit_decode_loop_finish(loop_done_l: String, out_name: String, temp_name: String, done_l: String) -> Int:
    ir_emit_label(loop_done_l)
    out_r := ir_reg()
    ir_emit("load " + out_r.to_string() + " " + out_name)
    ir_emit("store " + temp_name + " " + ir_emit_ok_result_tuple_raw(out_r).to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

# a list-of-structs field read out of a parsed object node, as a loop over
# the array under the key. on failure releases the list and every element built
# before and wraps the error under the element position (`rows[1]: ...`).
fn ir_emit_json_struct_list_field(handle_r: Int, key_r: Int, elem_tid: Int, helpers: IrJsonListHelpers) -> Int:
    temp_name := ir_new_temp_name("json_struct_list")
    ir_var_types.insert(temp_name, "tuple")
    list_name := ir_new_temp_name("json_struct_list_out")
    len_name := ir_new_temp_name("json_struct_list_len")
    idx_name := ir_new_temp_name("json_struct_list_idx")
    arr_name := ir_new_temp_name("json_struct_list_arr")
    ir_var_types.insert(list_name, "list")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(arr_name, "int")
    done_l := ir_label()

    arr_result_r := ir_reg()
    ir_emit_decode_result_call2(arr_result_r, helpers.require_array, handle_r, key_r)
    ir_emit_result_store_error_branch(arr_result_r, temp_name, done_l)
    ir_emit("store " + arr_name + " " + ir_take_result_ok(arr_result_r, lookup_type_id("Int")).to_string())
    list_r := ir_reg()
    ir_emit_call0(list_r, "__list_new_struct", "list")
    ir_emit("store " + list_name + " " + list_r.to_string())
    arr_r := ir_reg()
    ir_emit("load " + arr_r.to_string() + " " + arr_name)
    len_r := ir_reg()
    ir_emit_call1(len_r, helpers.array_len, "int", arr_r)
    ir_emit("store " + len_name + " " + len_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ir_emit_decode_loop_cond(loop_l, idx_name, len_name, body_l, loop_done_l)

    ir_emit_label(body_l)
    body_arr_r := ir_reg()
    ir_emit("load " + body_arr_r.to_string() + " " + arr_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    elem_result_r := ir_reg()
    ir_emit_decode_result_call3(elem_result_r, helpers.require_element, body_arr_r, key_r, body_idx_r)
    elem_ok_r := ir_emit_result_flag_field(elem_result_r, "is_ok")
    elem_ok_l := ir_label()
    ir_emit("brif " + elem_ok_r.to_string() + " " + elem_ok_l + " " + fail_l)
    ir_emit_label(elem_ok_l)
    elem_r := ir_take_result_ok(elem_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(helpers.decode_object, [ir_type_from_tid(elem_tid)], "tuple"), elem_r)
    decode_ok_r := ir_emit_result_flag_field(decode_result_r, "is_ok")
    decode_ok_l := ir_label()
    decode_err_l := ir_label()
    ir_emit("brif " + decode_ok_r.to_string() + " " + decode_ok_l + " " + decode_err_l)
    ir_emit_label(decode_err_l)
    inner_err_r := ir_reg()
    ir_emit("field " + inner_err_r.to_string() + " " + decode_result_r.to_string() + " 16 struct:JsonDecodeError err")
    wrapped_r := ir_reg()
    ir_emit_call3(wrapped_r, helpers.element_error, "struct:JsonDecodeError", key_r, body_idx_r, inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", decode_result_r)
    wrapped_box_r := ir_emit_err_result_tuple_raw(wrapped_r)
    ir_emit("store " + temp_name + " " + wrapped_box_r.to_string())
    drop_list_r := ir_reg()
    ir_emit("load " + drop_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", drop_list_r)
    ir_emit("jmp " + done_l)
    ir_emit_label(decode_ok_l)
    value_r := ir_take_json_ok(decode_result_r, elem_tid)
    push_list_r := ir_reg()
    ir_emit("load " + push_list_r.to_string() + " " + list_name)
    ir_emit_call2(ir_reg(), "pith_list_push_value_owned", "void", push_list_r, value_r)
    ir_emit_decode_loop_step(idx_name, loop_l)

    ir_emit_label(fail_l)
    ir_emit("store " + temp_name + " " + elem_result_r.to_string())
    fail_list_r := ir_reg()
    ir_emit("load " + fail_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", fail_list_r)
    ir_emit("jmp " + done_l)
    return ir_emit_decode_loop_finish(loop_done_l, list_name, temp_name, done_l)

fn ir_json_value_ownership(tid: Int) -> String:
    info := get_type_info(tid)
    if info.kind == "primitive" and info.name == "String":
        return "string"
    if info.kind == "list" or info.kind == "map" or info.kind == "struct":
        return info.kind
    return ""

fn ir_json_value_tag_code(ownership: String) -> Int:
    if ownership == "string":
        return 1
    if ownership == "list":
        return 2
    if ownership == "map":
        return 3
    return 4

fn ir_json_list_ctor_for_ownership(ownership: String) -> String:
    if ownership == "string":
        return "__list_new_str"
    if ownership == "list":
        return "__list_new_list"
    if ownership == "map":
        return "__list_new_map"
    if ownership == "struct":
        return "__list_new_struct"
    return "__list_new"

fn ir_json_node_scalar_helper(helpers: IrJsonNodeHelpers, info: TypeInfo) -> String:
    if info.name == "String":
        return helpers.node_string
    if info.name == "Bool":
        return helpers.node_bool
    if info.name == "Float":
        return helpers.node_float
    return helpers.node_int

fn ir_emit_json_node_value(node_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    info := get_type_info(tid)
    if info.kind == "primitive":
        result_r := ir_reg()
        ir_emit_decode_result_call2(result_r, ir_json_node_scalar_helper(helpers, info), node_r, path_r)
        return result_r
    if info.kind == "struct":
        return ir_emit_json_node_struct(node_r, path_r, tid, helpers)
    temp_name := ir_new_temp_name("json_node_value")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    container_result_r := ir_reg()
    if info.kind == "list":
        ir_emit_decode_result_call2(container_result_r, helpers.node_array, node_r, path_r)
    else:
        ir_emit_decode_result_call2(container_result_r, helpers.node_map, node_r, path_r)
    ir_emit_result_store_error_branch(container_result_r, temp_name, done_l)
    container_r := ir_take_result_ok(container_result_r, lookup_type_id("Int"))
    mut built_r := 0
    if info.kind == "list":
        built_r = ir_emit_json_node_list_from_array(container_r, path_r, tid, helpers)
    else:
        built_r = ir_emit_json_node_map_from_object(container_r, path_r, tid, helpers)
    ir_emit("store " + temp_name + " " + built_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_json_node_struct(node_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    temp_name := ir_new_temp_name("json_node_struct")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    obj_result_r := ir_reg()
    ir_emit_decode_result_call2(obj_result_r, helpers.node_object, node_r, path_r)
    ir_emit_result_store_error_branch(obj_result_r, temp_name, done_l)
    obj_r := ir_take_result_ok(obj_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(helpers.decode_object, [ir_type_from_tid(tid)], "tuple"), obj_r)
    ok_r := ir_emit_result_flag_field(decode_result_r, "is_ok")
    ok_l := ir_label()
    err_l := ir_label()
    ir_emit("brif " + ok_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(err_l)
    inner_err_r := ir_reg()
    ir_emit("field " + inner_err_r.to_string() + " " + decode_result_r.to_string() + " 16 struct:JsonDecodeError err")
    wrapped_r := ir_reg()
    ir_emit_call2(wrapped_r, helpers.path_error, "struct:JsonDecodeError", path_r, inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", decode_result_r)
    ir_emit("store " + temp_name + " " + ir_emit_err_result_tuple_raw(wrapped_r).to_string())
    ir_emit("jmp " + done_l)
    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_json_node_list_from_array(arr_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    elem_tid := get_type_info(tid).inner
    elem_ownership := ir_json_value_ownership(elem_tid)
    temp_name := ir_new_temp_name("json_node_list")
    ir_var_types.insert(temp_name, "tuple")
    list_name := ir_new_temp_name("json_node_list_out")
    len_name := ir_new_temp_name("json_node_list_len")
    idx_name := ir_new_temp_name("json_node_list_idx")
    arr_name := ir_new_temp_name("json_node_list_arr")
    ir_var_types.insert(list_name, ir_type_from_tid(tid))
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(arr_name, "int")
    done_l := ir_label()
    ir_emit("store " + arr_name + " " + arr_r.to_string())
    list_r := ir_reg()
    ir_emit_call0(list_r, ir_json_list_ctor_for_ownership(elem_ownership), ir_type_from_tid(tid))
    ir_emit("store " + list_name + " " + list_r.to_string())
    len_arr_r := ir_reg()
    ir_emit("load " + len_arr_r.to_string() + " " + arr_name)
    len_r := ir_reg()
    ir_emit_call1(len_r, helpers.array_len, "int", len_arr_r)
    ir_emit("store " + len_name + " " + len_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ok_l := ir_label()
    ir_emit_decode_loop_cond(loop_l, idx_name, len_name, body_l, loop_done_l)

    ir_emit_label(body_l)
    body_arr_r := ir_reg()
    ir_emit("load " + body_arr_r.to_string() + " " + arr_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    elem_node_r := ir_reg()
    ir_emit_call2(elem_node_r, helpers.array_get, "int", body_arr_r, body_idx_r)
    elem_path_r := ir_reg()
    ir_emit_call2(elem_path_r, helpers.element_path, "string", path_r, body_idx_r)
    elem_result_r := ir_emit_json_node_value(elem_node_r, elem_path_r, elem_tid, helpers)
    ir_string_release_reg(elem_path_r)
    elem_ok_r := ir_emit_result_flag_field(elem_result_r, "is_ok")
    ir_emit("brif " + elem_ok_r.to_string() + " " + ok_l + " " + fail_l)
    ir_emit_label(fail_l)
    ir_emit("store " + temp_name + " " + elem_result_r.to_string())
    fail_list_r := ir_reg()
    ir_emit("load " + fail_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", fail_list_r)
    ir_emit("jmp " + done_l)
    ir_emit_label(ok_l)
    value_r := ir_take_json_ok(elem_result_r, elem_tid)
    push_list_r := ir_reg()
    ir_emit("load " + push_list_r.to_string() + " " + list_name)
    if elem_ownership.len() > 0:
        ir_emit_call2(ir_reg(), "pith_list_push_value_owned", "void", push_list_r, value_r)
    else:
        ir_emit_call2(ir_reg(), "pith_list_push_value", "void", push_list_r, value_r)
    ir_emit_decode_loop_step(idx_name, loop_l)
    return ir_emit_decode_loop_finish(loop_done_l, list_name, temp_name, done_l)

fn ir_emit_json_node_map_from_object(obj_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    val_tid := get_type_info(tid).value_type
    val_ownership := ir_json_value_ownership(val_tid)
    temp_name := ir_new_temp_name("json_node_map")
    ir_var_types.insert(temp_name, "tuple")
    map_name := ir_new_temp_name("json_node_map_out")
    count_name := ir_new_temp_name("json_node_map_count")
    idx_name := ir_new_temp_name("json_node_map_idx")
    obj_name := ir_new_temp_name("json_node_map_obj")
    ir_var_types.insert(map_name, "map")
    ir_var_types.insert(count_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(obj_name, "int")
    done_l := ir_label()
    ir_emit("store " + obj_name + " " + obj_r.to_string())
    map_r := ir_reg()
    ir_emit_call0(map_r, "__map_new", "map")
    ir_emit("store " + map_name + " " + map_r.to_string())
    count_obj_r := ir_reg()
    ir_emit("load " + count_obj_r.to_string() + " " + obj_name)
    count_r := ir_reg()
    ir_emit_call1(count_r, helpers.member_count, "int", count_obj_r)
    ir_emit("store " + count_name + " " + count_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ok_l := ir_label()
    ir_emit_decode_loop_cond(loop_l, idx_name, count_name, body_l, loop_done_l)

    ir_emit_label(body_l)
    body_obj_r := ir_reg()
    ir_emit("load " + body_obj_r.to_string() + " " + obj_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    key_r := ir_reg()
    ir_emit_call2(key_r, helpers.member_key, "string", body_obj_r, body_idx_r)
    val_node_r := ir_reg()
    ir_emit_call2(val_node_r, helpers.object_get, "int", body_obj_r, key_r)
    member_path_r := ir_reg()
    ir_emit_call2(member_path_r, helpers.member_path, "string", path_r, key_r)
    val_result_r := ir_emit_json_node_value(val_node_r, member_path_r, val_tid, helpers)
    ir_string_release_reg(member_path_r)
    val_ok_r := ir_emit_result_flag_field(val_result_r, "is_ok")
    ir_emit("brif " + val_ok_r.to_string() + " " + ok_l + " " + fail_l)
    ir_emit_label(fail_l)
    ir_string_release_reg(key_r)
    ir_emit("store " + temp_name + " " + val_result_r.to_string())
    fail_map_r := ir_reg()
    ir_emit("load " + fail_map_r.to_string() + " " + map_name)
    ir_emit_call1(ir_reg(), "pith_map_release_handle", "void", fail_map_r)
    ir_emit("jmp " + done_l)
    ir_emit_label(ok_l)
    value_r := ir_take_json_ok(val_result_r, val_tid)
    store_map_r := ir_reg()
    ir_emit("load " + store_map_r.to_string() + " " + map_name)
    if val_ownership.len() > 0:
        tag_r := ir_reg()
        ir_emit("iconst " + tag_r.to_string() + " " + ir_json_value_tag_code(val_ownership).to_string())
        ir_emit_call4(ir_reg(), "map_insert_owned_kind", "void", store_map_r, key_r, value_r, tag_r)
    else:
        ir_emit_call3(ir_reg(), "map_insert", "void", store_map_r, key_r, value_r)
    ir_string_release_reg(key_r)
    ir_emit_decode_loop_step(idx_name, loop_l)
    return ir_emit_decode_loop_finish(loop_done_l, map_name, temp_name, done_l)

fn ir_emit_json_node_collection_field(handle_r: Int, key_r: Int, field_tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    temp_name := ir_new_temp_name("json_node_field")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    container_result_r := ir_reg()
    is_map := ir_json_map_value_tid(field_tid) >= 0
    if is_map:
        ir_emit_decode_result_call2(container_result_r, helpers.require_map, handle_r, key_r)
    else:
        ir_emit_decode_result_call2(container_result_r, helpers.require_array, handle_r, key_r)
    ir_emit_result_store_error_branch(container_result_r, temp_name, done_l)
    container_r := ir_take_result_ok(container_result_r, lookup_type_id("Int"))
    mut built_r := 0
    if is_map:
        built_r = ir_emit_json_node_map_from_object(container_r, key_r, field_tid, helpers)
    else:
        built_r = ir_emit_json_node_list_from_array(container_r, key_r, field_tid, helpers)
    ir_emit("store " + temp_name + " " + built_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# ===========================================================================
# Unified field-decoding engine (config, handle-pool, json object, json scalar)
# ===========================================================================

# emit the present-value fetch for one field according to `decode_kind`:
#   "scalar"               -> call `decode_helper(container_r, key_r)`
#   "nested_struct"        -> nested struct decode for `site.family`
#   "json_struct_list"     -> list-of-structs loop via `IrJsonListHelpers`
#   "json_node_collection" -> map/nested-list builder via `IrJsonNodeHelpers`
fn ir_emit_decode_present_result(site: IrDecodeSite, decode_kind: String, container_r: Int, key_r: Int, target_tid: Int, decode_helper: String) -> Int:
    if decode_kind == "nested_struct":
        return ir_emit_site_nested_decode(site, container_r, key_r, target_tid)
    if decode_kind == "json_struct_list":
        return ir_emit_json_struct_list_field(container_r, key_r, target_tid, ir_json_list_helpers(site))
    if decode_kind == "json_node_collection":
        return ir_emit_json_node_collection_field(container_r, key_r, target_tid, ir_json_node_helpers(site))
    field_result_r := ir_reg()
    ir_emit_decode_result_call2(field_result_r, decode_helper, container_r, key_r)
    return field_result_r

# emit optional, defaulted, or required decoding for one struct field.
# handles both specialization return-on-error (site.done_l == "") and inline
# call store-error-and-branch (site.done_l != "") uniformly.
fn ir_emit_decode_field_checked(site: IrDecodeSite, container_r: Int, key_r: Int, field_tid: Int, optional_inner_tid: Int, default_idx: Int, has_fn: String, temp_prefix: String, decode_kind: String, target_tid: Int, decode_helper: String, hooks: IrDecodeHooks) -> Int:
    if optional_inner_tid >= 0:
        has_r := ir_reg()
        ir_emit_call2(has_r, has_fn, "bool", container_r, key_r)
        branch := ir_begin_decode_field_branch(has_r, temp_prefix, "tuple")
        if default_idx >= 0:
            ir_decode_field_store_and_merge(branch, hooks.emit_value_for_target(default_idx, "tuple"))
        else:
            ir_decode_field_store_and_merge(branch, ir_emit_optional_none_value())
        ir_emit_label(branch.present_l)
        field_result_r := ir_emit_decode_present_result(site, decode_kind, container_r, key_r, target_tid, decode_helper)
        ir_emit_decode_field_error(site, field_result_r)
        ir_decode_field_store_and_merge(branch, ir_decode_optional_some(ir_take_json_ok(field_result_r, optional_inner_tid), optional_inner_tid))
        return ir_decode_field_load_after_merge(branch)
    if default_idx >= 0:
        has_r := ir_reg()
        ir_emit_call2(has_r, has_fn, "bool", container_r, key_r)
        field_type := ir_type_from_tid(field_tid)
        branch := ir_begin_decode_field_branch(has_r, temp_prefix, field_type)
        ir_decode_field_store_and_merge(branch, hooks.emit_value_for_target(default_idx, field_type))
        ir_emit_label(branch.present_l)
        field_result_r := ir_emit_decode_present_result(site, decode_kind, container_r, key_r, target_tid, decode_helper)
        ir_emit_decode_field_error(site, field_result_r)
        ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
        return ir_decode_field_load_after_merge(branch)
    field_result_r := ir_emit_decode_present_result(site, decode_kind, container_r, key_r, target_tid, decode_helper)
    ir_emit_decode_field_error(site, field_result_r)
    return ir_take_json_ok(field_result_r, field_tid)

fn ir_emit_kv_field_key(site: IrDecodeSite, field_name: String, prefix_r: Int) -> Int:
    key_r := ir_reg()
    ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
    if prefix_r < 0:
        return key_r
    full_key_r := ir_reg()
    ir_emit_call2(full_key_r, ir_decode_site_call_name(site, "dotted_key"), "string", prefix_r, key_r)
    return full_key_r

# shared struct-field decode loop for both std.config and handle-pool
# (std.toml/std.yaml), covering both call sites and specialization bodies.
fn ir_emit_kv_decode_struct(site: IrDecodeSite, struct_name: String, container_r: Int, prefix_r: Int, has_target_info: Bool, target_info: TypeInfo, hooks: IrDecodeHooks):
    mut field_regs: List[Int] := []
    mut fresh_keys: List[Int] := []
    inline_call := site.done_l.len() > 0
    mut held := 0
    if inline_call:
        held = ir_decode_partial_begin()
    mut field_count := ir_struct_field_count(struct_name)
    if has_target_info:
        field_count = target_info.fields.len()
    mut i := 0
    while i < field_count:
        mut field_name := ""
        mut field_tid := 0 - 1
        if has_target_info:
            if i >= target_info.field_types.len():
                i = i + 1
                continue
            field_name = target_info.fields[i]
            field_tid = ir_struct_field_tid_at(struct_name, i, target_info.field_types[i])
        else:
            field_name = ir_struct_field_name_at(struct_name, i)
            field_tid = ir_specialized_struct_field_tid(struct_name, i)
        default_idx := ir_struct_field_default_node(struct_name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        key_r := ir_emit_kv_field_key(site, field_name, prefix_r)
        if prefix_r >= 0 and inline_call:
            fresh_keys.push(key_r)
            ir_decode_partial_push(key_r, "string")
        mut value_tid := field_tid
        if optional_inner_tid >= 0:
            value_tid = optional_inner_tid
        struct_tid := ir_struct_decode_field_tid(value_tid)
        mut decode_kind := "scalar"
        mut has_member := "has"
        mut helper_symbol := ""
        mut temp_prefix := site.family + "_field"
        if struct_tid >= 0:
            decode_kind = "nested_struct"
            if site.family == "config":
                has_member = "has_prefix"
            temp_prefix = site.family + "_struct_field"
        else:
            member := ir_kv_scalar_require_member(site.family, value_tid)
            if member.len() == 0:
                if not inline_call:
                    hooks.emit_default_ret()
                    return
                i = i + 1
                continue
            helper_symbol = ir_decode_site_call_name(site, member)
        val_r := ir_emit_decode_field_checked(site, container_r, key_r, field_tid, optional_inner_tid, default_idx, ir_decode_site_call_name(site, has_member), temp_prefix, decode_kind, struct_tid, helper_symbol, hooks)
        field_regs.push(val_r)
        if inline_call:
            ir_decode_partial_push(val_r, ir_decode_held_kind(field_tid))
        i = i + 1
    if inline_call:
        ir_decode_partial_end(held)
        for key_r in fresh_keys:
            ir_string_release_reg(key_r)
        ir_emit_struct_result_store(field_regs, "struct:" + struct_name, site.temp_name)
    else:
        ir_emit_struct_result_return(field_regs, "struct:" + struct_name)

# shared object-node field decode loop for std.json, covering both inline
# call sites (`ir_emit_json_decode_object_call`, nested fallback, path/file)
# and generic specialization bodies (`decode_object`, `decode`, `decode_path`).
fn ir_emit_json_object_fields(site: IrDecodeSite, struct_name: String, handle_r: Int, has_target_info: Bool, target_info: TypeInfo, hooks: IrDecodeHooks):
    mut field_regs: List[Int] := []
    held := ir_decode_partial_begin()
    has_fn := ir_decode_site_call_name(site, "object_has")
    mut field_count := ir_struct_field_count(struct_name)
    if has_target_info:
        field_count = target_info.fields.len()
    mut i := 0
    while i < field_count:
        mut field_name := ""
        mut field_tid := 0 - 1
        if has_target_info:
            if i >= target_info.field_types.len():
                i = i + 1
                continue
            field_name = target_info.fields[i]
            field_tid = ir_struct_field_tid_at(struct_name, i, target_info.field_types[i])
        else:
            field_name = ir_struct_field_name_at(struct_name, i)
            field_tid = ir_specialized_struct_field_tid(struct_name, i)
        default_idx := ir_struct_field_default_node(struct_name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        mut value_tid := field_tid
        if optional_inner_tid >= 0:
            value_tid = optional_inner_tid
        mut decode_kind := ""
        mut target_tid := value_tid
        mut helper_symbol := ""
        mut temp_prefix := "json_object_field"
        nested_struct_tid := ir_struct_decode_field_tid(value_tid)
        struct_list_tid := ir_json_struct_list_elem_tid(value_tid)
        if nested_struct_tid >= 0:
            decode_kind = "nested_struct"
            target_tid = nested_struct_tid
            temp_prefix = "json_object_struct_field"
        elif struct_list_tid >= 0:
            decode_kind = "json_struct_list"
            target_tid = struct_list_tid
            temp_prefix = "json_object_list_field"
        elif ir_json_node_built_collection(value_tid):
            decode_kind = "json_node_collection"
            target_tid = value_tid
            temp_prefix = "json_object_collection_field"
        else:
            helper_name := ir_json_object_helper_name(value_tid)
            if helper_name.len() == 0:
                i = i + 1
                continue
            decode_kind = "scalar"
            helper_symbol = ir_decode_site_call_name(site, helper_name)
        val_r := ir_emit_decode_field_checked(site, handle_r, key_r, field_tid, optional_inner_tid, default_idx, has_fn, temp_prefix, decode_kind, target_tid, helper_symbol, hooks)
        field_regs.push(val_r)
        ir_decode_partial_push(val_r, ir_decode_held_kind(field_tid))
        i = i + 1
    ir_decode_partial_end(held)
    ir_emit_struct_result_store(field_regs, "struct:" + struct_name, site.temp_name)

# ===========================================================================
# Config decode entry points (specializations & call sites)
# ===========================================================================

## emit the std.config `decode[T]` or `decode_prefix[T]` specialization body.
pub fn ir_emit_config_decode_specialization_body(struct_name: String, prefixed: Bool, hooks: IrDecodeHooks):
    if not ir_struct_names.contains_key(struct_name) or lookup_type_id(struct_name) < 0:
        hooks.emit_default_ret()
        return
    cfg_r := ir_reg()
    ir_emit("load " + cfg_r.to_string() + " cfg")
    mut prefix_r := 0 - 1
    if prefixed:
        prefix_r = ir_reg()
        ir_emit("load " + prefix_r.to_string() + " prefix")
    site := IrDecodeSite("config", true, 0 - 1, "", "", "")
    ir_emit_kv_decode_struct(site, struct_name, cfg_r, prefix_r, false, get_type_info(0), hooks)

## emit an inline std.config `decode[T]` or `decode_prefix[T]` call.
pub fn ir_emit_config_decode_call(idx: Int, node: Node, prefixed: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0:
        return ir_zero_reg()
    cfg_r := arg_regs[0]
    mut prefix_r := 0 - 1
    if prefixed:
        if arg_regs.len() < 2:
            return ir_zero_reg()
        prefix_r = arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    temp_name := ir_new_temp_name("config_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    site := IrDecodeSite("config", false, node.children[0], "", temp_name, done_l)
    ir_emit_kv_decode_struct(site, target_info.name, cfg_r, prefix_r, true, target_info, hooks)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit a std.config loader+decode call (`from_toml_file_typed`, `from_json_typed_prefix`, etc.).
## cfg_temp is zero-initialized and unconditionally released at done_l so the
## loaded Config struct is never leaked on either success or decode error.
pub fn ir_emit_config_loader_decode_call(idx: Int, node: Node, loader_name: String, prefixed: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0:
        return ir_zero_reg()
    input_r := arg_regs[0]
    mut prefix_r := 0 - 1
    if prefixed:
        if arg_regs.len() < 2:
            return ir_zero_reg()
        prefix_r = arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("config_loader_decode")
    ir_var_types.insert(temp_name, "tuple")
    cfg_temp := ir_new_temp_name("config_loader_cfg")
    ir_var_types.insert(cfg_temp, "int")
    zero_cfg_r := ir_reg()
    ir_emit("iconst " + zero_cfg_r.to_string() + " 0")
    ir_emit("store " + cfg_temp + " " + zero_cfg_r.to_string())
    done_l := ir_label()
    load_result_r := ir_reg()
    ir_emit_decode_result_call1(load_result_r, ir_resolve_decode_call_name(node.children[0], loader_name), input_r)
    ir_emit_result_store_error_branch(load_result_r, temp_name, done_l)
    cfg_r := ir_take_result_ok(load_result_r, lookup_type_id("Config"))
    ir_emit("store " + cfg_temp + " " + cfg_r.to_string())
    site := IrDecodeSite("config", false, node.children[0], "", temp_name, done_l)
    ir_emit_kv_decode_struct(site, target_info.name, cfg_r, prefix_r, true, target_info, hooks)
    ir_emit_label(done_l)
    cfg_end_r := ir_reg()
    ir_emit("load " + cfg_end_r.to_string() + " " + cfg_temp)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", cfg_end_r)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## dispatch a std.config typed decode call expression, or return -1 if not one.
pub fn ir_emit_index_config_decode_call(idx: Int, node: Node, callee_idx: Int, hooks: IrDecodeHooks) -> Int:
    if ir_is_config_decode_callee(callee_idx, "decode"):
        return ir_emit_config_decode_call(idx, node, false, hooks)
    if ir_is_config_decode_callee(callee_idx, "decode_prefix"):
        return ir_emit_config_decode_call(idx, node, true, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_file_typed"):
        return ir_emit_config_loader_decode_call(idx, node, "from_toml_file", false, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_file_typed"):
        return ir_emit_config_loader_decode_call(idx, node, "from_json_file", false, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_toml", true, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_json", true, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_file_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_toml_file", true, hooks)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_file_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_json_file", true, hooks)
    return 0 - 1

# ===========================================================================
# Handle-pool (std.toml / std.yaml) decode entry points
# ===========================================================================

fn ir_emit_handle_decode_struct_from_handle(struct_name: String, module_path: String, handle_name: String, hooks: IrDecodeHooks):
    if not ir_struct_names.contains_key(struct_name):
        hooks.emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " " + handle_name)
    site := IrDecodeSite("handle", true, 0 - 1, module_path, "", "")
    ir_emit_kv_decode_struct(site, struct_name, handle_r, 0 - 1, false, get_type_info(0), hooks)

## emit the handle-pool `decode[T](handle)` specialization body.
pub fn ir_emit_handle_decode_specialization_body(struct_name: String, module_path: String, hooks: IrDecodeHooks):
    ir_emit_handle_decode_struct_from_handle(struct_name, module_path, "handle", hooks)

## emit the handle-pool `decode_path[T](handle, dotted_path)` specialization body.
pub fn ir_emit_handle_decode_path_specialization_body(struct_name: String, module_path: String, hooks: IrDecodeHooks):
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    dotted_path_r := ir_reg()
    ir_emit("load " + dotted_path_r.to_string() + " dotted_path")
    ir_emit_dotted_path_lookup_or_return(handle_r, dotted_path_r, ir_resolve_generic_module_call_name(module_path, "require_table"), "current", "__for_iter_handle_path", "__for_len_handle_path", "__for_idx_handle_path")
    ir_emit_handle_decode_struct_from_handle(struct_name, module_path, "current", hooks)

fn ir_emit_handle_decode_text_spec_body(module_path: String, concrete_types: List[String], ret_type: String, with_path: Bool):
    input_r := ir_reg()
    ir_emit("load " + input_r.to_string() + " input")
    mut temp_prefix := "handle_decode_text"
    if with_path:
        temp_prefix = "handle_decode_text_path"
    temp_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mark := ir_emit_handle_pool_mark(ir_resolve_generic_module_call_name(module_path, "pool_mark_node_id"), ir_resolve_generic_module_call_name(module_path, "pool_mark_table_len"), ir_resolve_generic_module_call_name(module_path, "pool_mark_array_len"))
    parse_result_r := ir_reg()
    ir_emit_decode_result_call1(parse_result_r, ir_resolve_generic_module_call_name(module_path, "parse_required"), input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    root_r := ir_take_result_ok_typed(parse_result_r, "Int")
    decode_result_r := ir_reg()
    if with_path:
        path_r := ir_reg()
        ir_emit("load " + path_r.to_string() + " dotted_path")
        decode_path_name := ir_queue_generic_specialization(ir_resolve_generic_module_call_name(module_path, "decode_path"), concrete_types, ret_type)
        ir_emit_decode_result_call2(decode_result_r, decode_path_name, root_r, path_r)
    else:
        decode_name := ir_queue_generic_specialization(ir_resolve_generic_module_call_name(module_path, "decode"), concrete_types, ret_type)
        ir_emit_decode_result_call1(decode_result_r, decode_name, root_r)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    ir_emit_handle_pool_restore(mark, ir_resolve_generic_module_call_name(module_path, "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the handle-pool `decode_text[T](input)` specialization body.
pub fn ir_emit_handle_decode_text_specialization_body(struct_name: String, module_path: String, concrete_types: List[String], ret_type: String):
    ir_emit_handle_decode_text_spec_body(module_path, concrete_types, ret_type, false)

## emit the handle-pool `decode_text_path[T](input, dotted_path)` specialization body.
pub fn ir_emit_handle_decode_text_path_specialization_body(struct_name: String, module_path: String, concrete_types: List[String], ret_type: String):
    ir_emit_handle_decode_text_spec_body(module_path, concrete_types, ret_type, true)

fn ir_emit_handle_call_pool_mark(index_idx: Int) -> IrHandlePoolMark:
    return ir_emit_handle_pool_mark(ir_resolve_decode_call_name(index_idx, "pool_mark_node_id"), ir_resolve_decode_call_name(index_idx, "pool_mark_table_len"), ir_resolve_decode_call_name(index_idx, "pool_mark_array_len"))

fn ir_emit_handle_call_parse(index_idx: Int, parse_member: String, input_r: Int, temp_name: String, done_l: String) -> Int:
    parse_result_r := ir_reg()
    ir_emit_decode_result_call1(parse_result_r, ir_resolve_decode_call_name(index_idx, parse_member), input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    return ir_take_result_ok(parse_result_r, lookup_type_id("Int"))

## emit an inline handle-pool `decode[T]` or `decode_text[T]` call.
pub fn ir_emit_handle_decode_call(idx: Int, node: Node, text_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0:
        return ir_zero_reg()
    mut handle_r := arg_regs[0]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    temp_name := ir_new_temp_name("handle_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mut mark := IrHandlePoolMark("", "", "")
    if text_input:
        mark = ir_emit_handle_call_pool_mark(node.children[0])
        handle_r = ir_emit_handle_call_parse(node.children[0], "parse_required", handle_r, temp_name, done_l)
    site := IrDecodeSite("handle", false, node.children[0], "", temp_name, done_l)
    ir_emit_kv_decode_struct(site, target_info.name, handle_r, 0 - 1, true, target_info, hooks)
    ir_emit_label(done_l)
    if text_input:
        ir_emit_handle_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit an inline handle-pool `decode_path[T]` or `decode_text_path[T]` call.
pub fn ir_emit_handle_decode_path_call(idx: Int, node: Node, text_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() < 2:
        return ir_zero_reg()
    mut handle_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    temp_name := ir_new_temp_name("handle_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mut mark := IrHandlePoolMark("", "", "")
    if text_input:
        mark = ir_emit_handle_call_pool_mark(node.children[0])
        handle_r = ir_emit_handle_call_parse(node.children[0], "parse_required", handle_r, temp_name, done_l)
    final_handle_r := ir_emit_decode_dotted_path(handle_r, dotted_path_r, ir_resolve_decode_call_name(node.children[0], "require_table"), lookup_type_id("Int"), "handle_decode", temp_name, done_l)
    site := IrDecodeSite("handle", false, node.children[0], "", temp_name, done_l)
    ir_emit_kv_decode_struct(site, target_info.name, final_handle_r, 0 - 1, true, target_info, hooks)
    ir_emit_label(done_l)
    if text_input:
        ir_emit_handle_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit an inline handle-pool `decode_file[T]` or `decode_file_path[T]` call.
pub fn ir_emit_handle_decode_file_call(idx: Int, node: Node, path_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0 or (path_input and arg_regs.len() < 2):
        return ir_zero_reg()
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    mut temp_prefix := "handle_decode_file"
    if path_input:
        temp_prefix = "handle_decode_file_path"
    temp_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mark := ir_emit_handle_call_pool_mark(node.children[0])
    mut handle_r := ir_emit_handle_call_parse(node.children[0], "parse_file_required", arg_regs[0], temp_name, done_l)
    if path_input:
        handle_r = ir_emit_decode_dotted_path(handle_r, arg_regs[1], ir_resolve_decode_call_name(node.children[0], "require_table"), lookup_type_id("Int"), "handle_decode_file", temp_name, done_l)
    site := IrDecodeSite("handle", false, node.children[0], "", temp_name, done_l)
    ir_emit_kv_decode_struct(site, target_info.name, handle_r, 0 - 1, true, target_info, hooks)
    ir_emit_label(done_l)
    ir_emit_handle_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# ===========================================================================
# JSON fast paths: flat fill & nested fill specs
# ===========================================================================

fn ir_json_decode_all_required_scalar(target_info: TypeInfo) -> Bool:
    if target_info.fields.len() == 0 or not ir_struct_decl_nodes.contains_key(target_info.name):
        return false
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_optional_inner_tid(field_tid) >= 0 or ir_struct_field_default_node(target_info.name, field_name) >= 0:
            return false
        if ir_json_scan_required_helper_name(field_tid).len() == 0:
            return false
    return true

fn ir_json_decode_has_string(target_info: TypeInfo) -> Bool:
    for field_name, i in target_info.fields:
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_json_field_type_char(field_tid) == "s":
            return true
    return false

fn ir_emit_json_decode_scan_fields(input_r: Int, target_info: TypeInfo, index_idx: Int) -> Int:
    n := target_info.fields.len()
    struct_r := ir_reg()
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + n.to_string())
    ir_emit_call1(struct_r, "__struct_alloc", "struct:" + target_info.name, count_r)
    if ir_json_decode_has_string(target_info):
        dtor_r := ir_reg()
        ir_emit("funcref " + dtor_r.to_string() + " __dtor_" + ir_struct_base_name(target_info.name))
        ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + dtor_r.to_string())
    mut fields: List[JsonFillField] := []
    for field_name, i in target_info.fields:
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        fields.push(JsonFillField(field_name, ir_json_field_type_char(field_tid)))
    skip_fn := ir_resolve_decode_call_name(index_idx, "fill_skip_value")
    error_fn := ir_resolve_decode_call_name(index_idx, "fill_missing_error")
    malformed_fn := ir_resolve_decode_call_name(index_idx, "fill_malformed_error")
    return ir_emit_json_fill_flat(input_r, struct_r, fields, skip_fn, error_fn, malformed_fn)

# bare struct name -> declaration node index, over every root of the program;
# ambiguous names are excluded so nested-fill never binds the wrong struct.
mut ir_json_nested_decls: Map[String, Int] := {}
mut ir_json_spec_dtor_names: List[String] := []

fn ir_json_nested_decl_index(type_name: String) -> Int:
    if ir_json_nested_decls.contains_key(type_name):
        return ir_json_nested_decls[type_name]
    return 0 - 1

fn ir_json_is_struct_decl_kind(kind: String) -> Bool:
    return kind == "struct_decl" or kind == "struct"

fn ir_json_spec_dtor_index(name: String) -> Int:
    for existing, i in ir_json_spec_dtor_names:
        if existing == name:
            return i
    ir_json_spec_dtor_names.push(name)
    return ir_json_spec_dtor_names.len() - 1

fn ir_json_type_node_is_list(type_node: Node) -> Bool:
    return type_node.kind == "generic_type" and type_node.value == "List" and type_node.children.len() == 1

fn ir_json_type_node_is_string_map(type_node: Node) -> Bool:
    if type_node.kind != "generic_type" or type_node.value != "Map" or type_node.children.len() != 2:
        return false
    key_node := get_node(type_node.children[0])
    return key_node.kind == "type" and key_node.value == "String"

fn ir_json_nested_elem_spec(type_node: Node, depth: Int) -> String:
    if depth > 16:
        return ""
    if ir_json_type_node_is_list(type_node):
        inner := ir_json_nested_elem_spec(get_node(type_node.children[0]), depth + 1)
        if inner.len() == 0:
            return ""
        return "l(" + inner + ")"
    if ir_json_type_node_is_string_map(type_node):
        inner := ir_json_nested_elem_spec(get_node(type_node.children[1]), depth + 1)
        if inner.len() == 0:
            return ""
        return "m(" + inner + ")"
    if type_node.kind != "type":
        return ""
    type_char := ir_json_type_name_char(type_node.value)
    if type_char.len() > 0:
        return type_char
    sub_idx := ir_json_nested_decl_index(type_node.value)
    if sub_idx < 0:
        return ""
    marker := "#" + ir_json_spec_dtor_index(type_node.value).to_string()
    sub_spec := ir_json_nested_spec_of_decl(get_node(sub_idx), depth + 1, true)
    if sub_spec.len() == 0:
        return ""
    return "o" + marker + "(" + sub_spec + ")"

fn ir_json_nested_spec_of_decl(decl: Node, depth: Int, under_list: Bool) -> String:
    if depth > 16:
        return ""
    mut spec := ""
    mut first := true
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and fnode.children.len() > 0:
            if not first:
                spec = spec + ","
            first = false
            fname := fnode.value.split(" ")[0]
            type_node := get_node(fnode.children[0])
            if ir_json_type_node_is_list(type_node):
                elem := ir_json_nested_elem_spec(get_node(type_node.children[0]), depth + 1)
                if elem.len() == 0:
                    return ""
                spec = spec + "l" + fname + "(" + elem + ")"
                continue
            if ir_json_type_node_is_string_map(type_node):
                elem := ir_json_nested_elem_spec(get_node(type_node.children[1]), depth + 1)
                if elem.len() == 0:
                    return ""
                spec = spec + "m" + fname + "(" + elem + ")"
                continue
            type_char := ir_json_type_name_char(type_node.value)
            if type_char.len() > 0:
                spec = spec + type_char + fname
                continue
            if type_node.kind != "type":
                return ""
            sub_idx := ir_json_nested_decl_index(type_node.value)
            if sub_idx < 0:
                return ""
            mut marker := ""
            if under_list:
                marker = "#" + ir_json_spec_dtor_index(type_node.value).to_string()
            sub_spec := ir_json_nested_spec_of_decl(get_node(sub_idx), depth + 1, under_list)
            if sub_spec.len() == 0:
                return ""
            spec = spec + "o" + fname + marker + "(" + sub_spec + ")"
    return spec

fn ir_json_decode_nested_spec_from_decl(decl: Node, depth: Int) -> String:
    ir_json_spec_dtor_names = []
    return ir_json_nested_spec_of_decl(decl, depth, false)

fn ir_json_decl_has_nested_field(decl: Node) -> Bool:
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and fnode.children.len() > 0:
            type_node := get_node(fnode.children[0])
            if type_node.kind == "type" and ir_json_type_name_char(type_node.value).len() == 0:
                return true
            if ir_json_type_node_is_list(type_node) or ir_json_type_node_is_string_map(type_node):
                return true
    return false

fn ir_json_intern_nested_spec_of(decl_idx: Int):
    node := get_node(decl_idx)
    if ir_json_is_struct_decl_kind(node.kind) and ir_json_decl_has_nested_field(node):
        spec := ir_json_decode_nested_spec_from_decl(node, 0)
        if spec.len() > 0:
            ir_str(spec)

## the string prepass step for the nested fill: build the declaration map
## over `roots`, then intern the nested spec of every struct a decode call
## in the program targets, or of every struct that has one when a call's
## target cannot be resolved before specialization.
pub fn ir_json_intern_nested_specs(roots: List[Int]):
    ir_json_nested_decls = {}
    mut ambiguous: List[String] := []
    for root in roots:
        for item_idx in ir_root_items(root):
            node := get_node(item_idx)
            if not ir_json_is_struct_decl_kind(node.kind):
                continue
            name := ir_base_decl_name(node.value)
            if ir_json_nested_decls.contains_key(name):
                ambiguous.push(name)
            else:
                ir_json_nested_decls.insert(name, item_idx)
    for name in ambiguous:
        ir_json_nested_decls.remove(name)
    mut targets: List[Int] := []
    mut unresolved := false
    for root in roots:
        for call_idx in ir_cached_decode_call_nodes(root):
            ret_tid := c_get_expr_type(call_idx)
            mut resolved := false
            if ret_tid >= 0:
                ret_info := get_type_info(ret_tid)
                if ret_info.kind == "result" and get_type_info(ret_info.inner).kind == "struct":
                    resolved = true
                    target_idx := ir_json_nested_decl_index(get_type_info(ret_info.inner).name)
                    if target_idx >= 0:
                        targets.push(target_idx)
            if not resolved:
                unresolved = true
    if unresolved:
        for root in roots:
            for item_idx in ir_root_items(root):
                ir_json_intern_nested_spec_of(item_idx)
        return
    for target_idx in targets:
        ir_json_intern_nested_spec_of(target_idx)

fn ir_json_struct_decl_matches(struct_tid: Int, written_name: String, depth: Int) -> Bool:
    nested_info := get_type_info(struct_tid)
    resolved := ir_json_nested_decl_index(written_name)
    if resolved < 0 or not ir_struct_decl_nodes.contains_key(nested_info.name):
        return false
    if ir_struct_decl_nodes[nested_info.name] != resolved:
        return false
    return ir_json_decode_nested_fill_shape(nested_info, depth + 1)

fn ir_json_elem_fill_shape(elem_tid: Int, elem_node: Node, depth: Int) -> Bool:
    if depth > 16:
        return false
    elem_info := get_type_info(elem_tid)
    if elem_info.kind == "primitive":
        return elem_node.kind == "type" and ir_json_type_name_char(elem_node.value).len() > 0 and ir_json_type_name_char(elem_node.value) == ir_json_field_type_char(elem_tid)
    if elem_info.kind == "list":
        return ir_json_type_node_is_list(elem_node) and elem_info.inner >= 0 and ir_json_elem_fill_shape(elem_info.inner, get_node(elem_node.children[0]), depth + 1)
    if elem_info.kind == "map":
        return ir_json_type_node_is_string_map(elem_node) and ir_json_map_value_tid(elem_tid) >= 0 and ir_json_elem_fill_shape(elem_info.value_type, get_node(elem_node.children[1]), depth + 1)
    if elem_info.kind == "struct":
        return elem_node.kind == "type" and ir_json_struct_decl_matches(elem_tid, elem_node.value, depth)
    return false

fn ir_json_decode_nested_fill_shape(target_info: TypeInfo, depth: Int) -> Bool:
    if depth > 16:
        return false
    n := target_info.fields.len()
    if n == 0 or n > 63 or not ir_struct_decl_nodes.contains_key(target_info.name):
        return false
    decl := get_node(ir_struct_decl_nodes[target_info.name])
    mut i := 0
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind != "field":
            continue
        if fnode.children.len() == 0 or i >= n or i >= target_info.field_types.len():
            return false
        field_name := target_info.fields[i]
        if fnode.value.split(" ")[0] != field_name:
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_optional_inner_tid(field_tid) >= 0 or ir_struct_field_default_node(target_info.name, field_name) >= 0:
            return false
        type_node := get_node(fnode.children[0])
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0:
            if type_node.kind != "type" or not ir_json_struct_decl_matches(nested_tid, type_node.value, depth):
                return false
        elif ir_json_list_elem_tid(field_tid) >= 0:
            if not ir_json_type_node_is_list(type_node) or not ir_json_elem_fill_shape(ir_json_list_elem_tid(field_tid), get_node(type_node.children[0]), depth + 1):
                return false
        elif ir_json_map_value_tid(field_tid) >= 0:
            if not ir_json_type_node_is_string_map(type_node) or not ir_json_elem_fill_shape(ir_json_map_value_tid(field_tid), get_node(type_node.children[1]), depth + 1):
                return false
        elif ir_json_type_name_char(type_node.value).len() == 0 or ir_json_type_name_char(type_node.value) != ir_json_field_type_char(field_tid):
            return false
        i = i + 1
    return i == n

fn ir_json_decode_nested_spec_for(target_info: TypeInfo) -> String:
    if not ir_struct_has_nested_decode_fields(target_info):
        return ""
    if not ir_json_decode_nested_fill_shape(target_info, 0):
        return ""
    spec := ir_json_decode_nested_spec_from_decl(get_node(ir_struct_decl_nodes[target_info.name]), 0)
    if spec.len() == 0 or not ir_str_interned(spec):
        return ""
    return spec

fn ir_json_target_has_collection_field(target_info: TypeInfo, depth: Int) -> Bool:
    if depth > 16:
        return false
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_json_list_elem_tid(field_tid) >= 0 or ir_json_map_value_tid(field_tid) >= 0:
            return true
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0 and ir_json_target_has_collection_field(get_type_info(nested_tid), depth + 1):
            return true
    return false

fn ir_emit_json_nested_alloc(target_info: TypeInfo) -> Int:
    struct_r := ir_reg()
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + target_info.fields.len().to_string())
    ir_emit_call1(struct_r, "__struct_alloc", "struct:" + target_info.name, count_r)
    if ir_struct_needs_dtor(target_info.name):
        dtor_r := ir_reg()
        ir_emit("funcref " + dtor_r.to_string() + " __dtor_" + ir_struct_base_name(target_info.name))
        ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + dtor_r.to_string())
    for field_name, i in target_info.fields:
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0:
            sub_r := ir_emit_json_nested_alloc(get_type_info(nested_tid))
            ir_emit("sstore " + struct_r.to_string() + " " + i.to_string() + " " + sub_r.to_string())
    return struct_r

fn ir_emit_json_decode_fill_nested(input_r: Int, target_info: TypeInfo, spec: String, check_utf8: Bool) -> Int:
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    struct_r := ir_emit_json_nested_alloc(target_info)
    spec_r := ir_reg()
    ir_emit("strref " + spec_r.to_string() + " " + ir_str(spec))
    flag_r := ir_reg()
    mut flag := 0
    if check_utf8:
        flag = 1
    ir_emit("iconst " + flag_r.to_string() + " " + flag.to_string())
    result_r := ir_reg()
    if not ir_json_target_has_collection_field(target_info, 0):
        ir_emit_call_text(result_r, "pith_json_fill_struct_nested", "tuple", 4, " " + input_r.to_string() + " " + spec_r.to_string() + " " + struct_r.to_string() + " " + flag_r.to_string())
    else:
        dtor_names := ir_json_spec_dtor_names
        count_r := ir_reg()
        ir_emit("iconst " + count_r.to_string() + " " + dtor_names.len().to_string())
        table_r := ir_reg()
        if dtor_names.len() == 0:
            ir_emit("iconst " + table_r.to_string() + " 0")
        else:
            ir_emit_call1(table_r, "__struct_alloc", "tuple", count_r)
            for name, k in dtor_names:
                entry_r := ir_reg()
                if ir_struct_needs_dtor(name):
                    ir_emit("funcref " + entry_r.to_string() + " __dtor_" + ir_struct_base_name(name))
                else:
                    ir_emit("iconst " + entry_r.to_string() + " 0")
                ir_emit("sstore " + table_r.to_string() + " " + k.to_string() + " " + entry_r.to_string())
        ir_emit_call_text(result_r, "pith_json_fill_struct_lists", "tuple", 6, " " + input_r.to_string() + " " + spec_r.to_string() + " " + struct_r.to_string() + " " + flag_r.to_string() + " " + table_r.to_string() + " " + count_r.to_string())
        if dtor_names.len() > 0:
            ir_emit_call1(ir_reg(), "pith_struct_release", "void", table_r)
    ir_emit("store " + temp_name + " " + result_r.to_string())
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# ===========================================================================
# JSON decode entry points (scalar-map, node-pool, specializations, call sites)
# ===========================================================================

fn ir_emit_json_decode_map_call(input_r: Int, target_info: TypeInfo, hooks: IrDecodeHooks) -> Int:
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()

    scan_r := ir_reg()
    ir_emit_decode_result_call1(scan_r, "std_json_decode_scalars_bytes", input_r)
    ir_emit_result_store_error_branch(scan_r, temp_name, done_l)
    fields_r := ir_take_result_ok(scan_r, 0 - 1)
    fields_done_l := ir_label()

    site := IrDecodeSite("json_scalar", false, 0 - 1, "", temp_name, fields_done_l)
    mut field_regs: List[Int] := []
    held := ir_decode_partial_begin()
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        default_idx := ir_struct_field_default_node(target_info.name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        mut value_tid := field_tid
        if optional_inner_tid >= 0:
            value_tid = optional_inner_tid
        helper_name := ir_json_require_helper_name(value_tid)
        has_name := ir_json_scalar_has_helper_name(value_tid)
        if helper_name.len() == 0 or ((optional_inner_tid >= 0 or default_idx >= 0) and has_name.len() == 0):
            continue
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        val_r := ir_emit_decode_field_checked(site, fields_r, key_r, field_tid, optional_inner_tid, default_idx, has_name, "json_scalar_field", "scalar", value_tid, helper_name, hooks)
        field_regs.push(val_r)
        ir_decode_partial_push(val_r, ir_decode_held_kind(field_tid))

    ir_decode_partial_end(held)
    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)
    ir_emit_label(fields_done_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", fields_r)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit an inline std.json `decode[T]` or `decode_text[T]` call.
pub fn ir_emit_json_decode_call(idx: Int, node: Node, text_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0:
        return ir_zero_reg()
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    mut input_r := arg_regs[0]
    fresh_input := ir_decode_arg_is_minted(node, 1)
    fresh_text_input := text_input and fresh_input
    fresh_bytes_input := not text_input and fresh_input
    text_r := input_r
    owns_input := text_input or fresh_bytes_input
    has_optional_fields := ir_struct_has_optional_fields(target_info)
    has_default_fields := ir_struct_has_default_fields(target_info)
    has_nested_fields := ir_struct_has_nested_decode_fields(target_info)

    nested_spec := ir_json_decode_nested_spec_for(target_info)
    if nested_spec.len() > 0:
        mut fill_input_r := input_r
        if text_input:
            converted_r := ir_reg()
            ir_emit_call1(converted_r, "std_bytes_from_string_utf8", "bytes", input_r)
            fill_input_r = converted_r
        fill_r := ir_emit_json_decode_fill_nested(fill_input_r, target_info, nested_spec, not text_input)
        if owns_input:
            ir_rc_release_reg(fill_input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return fill_r
    if has_nested_fields:
        temp_name := ir_new_temp_name("json_decode_nested")
        ir_var_types.insert(temp_name, "tuple")
        done_l := ir_label()
        mark := ir_emit_json_pool_mark(ir_resolve_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_decode_call_name(node.children[0], "pool_mark_array_len"))
        mut handle_r := input_r
        if text_input:
            parsed_r := ir_reg()
            ir_emit_call1(parsed_r, ir_resolve_decode_call_name(node.children[0], "parse"), "int", input_r)
            handle_r = parsed_r
        else:
            parse_result_r := ir_reg()
            ir_emit_decode_result_call1(parse_result_r, ir_resolve_decode_call_name(node.children[0], "parse_bytes_required"), input_r)
            ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
            handle_r = ir_take_result_ok(parse_result_r, lookup_type_id("Int"))
        checked_r := ir_reg()
        ir_emit_decode_result_call1(checked_r, ir_resolve_decode_call_name(node.children[0], "require_object_handle"), handle_r)
        ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
        object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
        site := IrDecodeSite("json_object", false, node.children[0], "", temp_name, done_l)
        ir_emit_json_object_fields(site, target_info.name, object_r, true, target_info, hooks)
        ir_emit_label(done_l)
        ir_emit_json_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
        if fresh_bytes_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + temp_name)
        return r
    if text_input:
        converted_r := ir_reg()
        ir_emit_call1(converted_r, "std_bytes_from_string_utf8", "bytes", input_r)
        input_r = converted_r
    if ir_json_decode_all_required_scalar(target_info):
        scan_r := ir_emit_json_decode_scan_fields(input_r, target_info, node.children[0])
        if owns_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return scan_r
    if target_info.fields.len() > 3 or has_optional_fields or has_default_fields:
        map_r := ir_emit_json_decode_map_call(input_r, target_info, hooks)
        if owns_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return map_r

    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mut field_regs: List[Int] := []
    held := ir_decode_partial_begin()
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := target_info.field_types[i]
        helper_name := ir_json_scan_required_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, helper_name, input_r, key_r)
        ir_emit_decode_field_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))
        ir_decode_partial_push(field_regs[field_regs.len() - 1], ir_decode_held_kind(field_tid))
    ir_decode_partial_end(held)
    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)
    ir_emit_label(done_l)
    if owns_input:
        ir_rc_release_reg(input_r, "bytes")
    if fresh_text_input:
        ir_string_release_reg(text_r)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the std.json `decode_object[T](handle)` specialization body.
pub fn ir_emit_json_decode_object_specialization_body(struct_name: String, module_path: String, hooks: IrDecodeHooks):
    if not ir_struct_names.contains_key(struct_name):
        hooks.emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    temp_name := ir_new_temp_name("json_decode_object")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    site := IrDecodeSite("json_object", true, 0 - 1, module_path, temp_name, done_l)
    ir_emit_json_object_fields(site, struct_name, handle_r, false, get_type_info(0), hooks)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the std.json `decode[T]` or `decode_text[T]` specialization body.
pub fn ir_emit_json_decode_specialization_body(struct_name: String, module_path: String, text_input: Bool, hooks: IrDecodeHooks):
    if not ir_struct_names.contains_key(struct_name):
        hooks.emit_default_ret()
        return
    input_r := ir_reg()
    ir_emit("load " + input_r.to_string() + " input")
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mark := ir_emit_json_pool_mark(ir_resolve_generic_module_call_name(module_path, "pool_mark_node_id"), ir_resolve_generic_module_call_name(module_path, "pool_mark_array_len"))
    mut handle_r := input_r
    if text_input:
        parsed_r := ir_reg()
        ir_emit_call1(parsed_r, ir_resolve_generic_module_call_name(module_path, "parse"), "int", input_r)
        handle_r = parsed_r
    else:
        parse_result_r := ir_reg()
        ir_emit_decode_result_call1(parse_result_r, ir_resolve_generic_module_call_name(module_path, "parse_bytes_required"), input_r)
        ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
        handle_r = ir_take_result_ok(parse_result_r, 0)
    checked_r := ir_reg()
    ir_emit_decode_result_call1(checked_r, ir_resolve_generic_module_call_name(module_path, "require_object_handle"), handle_r)
    ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
    object_r := ir_take_result_ok(checked_r, 0)
    site := IrDecodeSite("json_object", true, 0 - 1, module_path, temp_name, done_l)
    ir_emit_json_object_fields(site, struct_name, object_r, false, get_type_info(0), hooks)
    ir_emit_label(done_l)
    ir_emit_json_pool_restore(mark, ir_resolve_generic_module_call_name(module_path, "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the std.json `decode_path[T](handle, dotted_path)` specialization body.
pub fn ir_emit_json_decode_path_specialization_body(struct_name: String, module_path: String, hooks: IrDecodeHooks):
    if not ir_struct_names.contains_key(struct_name):
        hooks.emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    root_result_r := ir_reg()
    ir_emit_decode_result_call1(root_result_r, ir_resolve_generic_module_call_name(module_path, "require_object_handle"), handle_r)
    temp_name := ir_new_temp_name("json_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    ir_emit_result_store_error_branch(root_result_r, temp_name, done_l)
    root_r := ir_take_result_ok(root_result_r, 0)
    dotted_path_r := ir_reg()
    ir_emit("load " + dotted_path_r.to_string() + " dotted_path")
    final_handle_r := ir_emit_decode_dotted_path(root_r, dotted_path_r, ir_resolve_generic_module_call_name(module_path, "object_require_object"), 0, "json", temp_name, done_l)
    site := IrDecodeSite("json_object", true, 0 - 1, module_path, temp_name, done_l)
    ir_emit_json_object_fields(site, struct_name, final_handle_r, false, get_type_info(0), hooks)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit an inline std.json `decode_object[T](handle)` call.
pub fn ir_emit_json_decode_object_call(idx: Int, node: Node, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0:
        return ir_zero_reg()
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    temp_name := ir_new_temp_name("json_decode_object")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    checked_r := ir_reg()
    ir_emit_decode_result_call1(checked_r, ir_resolve_decode_call_name(node.children[0], "require_object_handle"), arg_regs[0])
    ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
    object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
    site := IrDecodeSite("json_object", false, node.children[0], "", temp_name, done_l)
    ir_emit_json_object_fields(site, target_info.name, object_r, true, target_info, hooks)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit an inline std.json `decode_path[T]` or `decode_text_path[T]` call.
pub fn ir_emit_json_decode_path_call(idx: Int, node: Node, text_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() < 2:
        return ir_zero_reg()
    mut handle_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    temp_name := ir_new_temp_name("json_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mut mark := IrJsonPoolMark("", "")
    if text_input:
        mark = ir_emit_json_pool_mark(ir_resolve_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_decode_call_name(node.children[0], "pool_mark_array_len"))
        parsed_r := ir_reg()
        ir_emit_call1(parsed_r, ir_resolve_decode_call_name(node.children[0], "parse"), "int", handle_r)
        handle_r = parsed_r
    root_result_r := ir_reg()
    ir_emit_decode_result_call1(root_result_r, ir_resolve_decode_call_name(node.children[0], "require_object_handle"), handle_r)
    ir_emit_result_store_error_branch(root_result_r, temp_name, done_l)
    root_r := ir_take_result_ok(root_result_r, lookup_type_id("Int"))
    final_handle_r := ir_emit_decode_dotted_path(root_r, dotted_path_r, ir_resolve_decode_call_name(node.children[0], "object_require_object"), lookup_type_id("Int"), "json", temp_name, done_l)
    site := IrDecodeSite("json_object", false, node.children[0], "", temp_name, done_l)
    ir_emit_json_object_fields(site, target_info.name, final_handle_r, true, target_info, hooks)
    ir_emit_label(done_l)
    mut minted_args := [2]
    if text_input:
        ir_emit_json_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
        minted_args = [1, 2]
    ir_release_minted_decode_args(node, arg_regs, minted_args)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit an inline std.json `decode_file[T]` or `decode_file_path[T]` call.
pub fn ir_emit_json_decode_file_call(idx: Int, node: Node, path_input: Bool, hooks: IrDecodeHooks) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, hooks)
    if arg_regs.len() == 0 or (path_input and arg_regs.len() < 2):
        return ir_zero_reg()
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    mut temp_prefix := "json_decode_file"
    if path_input:
        temp_prefix = "json_decode_file_path"
    temp_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mark := ir_emit_json_pool_mark(ir_resolve_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_decode_call_name(node.children[0], "pool_mark_array_len"))
    parsed_r := ir_reg()
    ir_emit_call1(parsed_r, ir_resolve_decode_call_name(node.children[0], "parse_file"), "int", arg_regs[0])
    checked_r := ir_reg()
    ir_emit_decode_result_call1(checked_r, ir_resolve_decode_call_name(node.children[0], "require_object_handle"), parsed_r)
    ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
    mut object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
    if path_input:
        object_r = ir_emit_decode_dotted_path(object_r, arg_regs[1], ir_resolve_decode_call_name(node.children[0], "object_require_object"), lookup_type_id("Int"), "json_file", temp_name, done_l)
    site := IrDecodeSite("json_object", false, node.children[0], "", temp_name, done_l)
    ir_emit_json_object_fields(site, target_info.name, object_r, true, target_info, hooks)
    ir_emit_label(done_l)
    ir_emit_json_pool_restore(mark, ir_resolve_decode_call_name(node.children[0], "pool_restore"))
    if path_input:
        ir_release_minted_decode_args(node, arg_regs, [1, 2])
    else:
        ir_release_minted_decode_args(node, arg_regs, [1])
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r
