# metrics for prometheus: a request counter, an in-flight gauge and a latency
# histogram, recorded over a small batch of requests and printed as the text a
# scrape of /metrics returns.
#
# in a real service the endpoint runs beside the app:
#
#     import std.prometheus as prometheus
#     shutdown.on_signals() catch 0
#     spawn prometheus.serve("0.0.0.0", 9464)
#
# prometheus then GETs http://host:9464/metrics on its scrape interval, and on
# a SIGTERM the endpoint stops accepting and finishes the scrape in progress.

import std.metrics as metrics

struct Request:
    route: String
    status: Int
    latency_ms: Int

fn served() -> List[Request]:
    return [
        Request(route: "/api", status: 200, latency_ms: 12),
        Request(route: "/api", status: 200, latency_ms: 85),
        Request(route: "/api", status: 500, latency_ms: 310),
        Request(route: "/health", status: 200, latency_ms: 1),
    ]

fn main():
    requests := metrics.counter("http_requests_total").describe("requests served, by route and status", "")
    in_flight := metrics.gauge("http_requests_in_flight").describe("requests being served now", "")
    # buckets sized for this service: most answers land under 50ms.
    latency := metrics.histogram("http_request_duration_ms").describe("time to answer", "ms").buckets([10.0, 50.0, 250.0])

    for r in served():
        in_flight.add(1.0)
        requests.labels(["route", r.route, "status", "{r.status}"]).inc()
        latency.labels(["route", r.route]).observe(r.latency_ms.to_float())
        in_flight.add(-1.0)

    print(metrics.snapshot_text())
