# std.concurrent — contexts, timers, and task helpers

import std.time as time

# wait failures used by context-aware helpers.
pub enum WaitError:
    Cancelled
    DeadlineExceeded

# blocking operation failure with a simple kind code.
pub struct BlockingError:
    pub kind: Int
    pub message: String

# cancellation context shared across blocking helpers. the error cell
# is an atomic int (0 = active, 1 = cancelled, 2 = deadline) so the
# watcher task and the waiting task can read and write it safely; the
# deadline is set once at creation and never changes.
pub struct Context:
    pub done_ch: Channel[Bool]
    pub err: AtomicInt
    pub deadline_ms: Int

# handle used to cancel a derived context. it shares the context's done
# channel and error cell, so cancelling the token cancels the context.
pub struct CancelToken:
    pub done_ch: Channel[Bool]
    pub err: AtomicInt

# periodic timer that sends timestamps on a channel.
pub struct Ticker:
    pub tick_ch: Channel[Int]
    pub stop_ch: Channel[Bool]

# result wrapper for context-aware channel receives.
pub enum RecvResult[T]:
    Value(T)
    Closed

# a set of tasks that fan out from one context and fail as a unit: the first
# failure cancels the group's context, so the others can stop early instead of
# finishing work whose answer is already unwanted.
#
# the tasks are held as results rather than plain values because a group cares
# about which one failed, not what the survivors returned. work that has a value
# to report should write it where the caller can find it — a channel, or a slot
# it owns — exactly as it would without a group.
pub struct Group:
    pub ctx: Context
    token: CancelToken
    tasks: List[Task[Int!]]
    slots: Semaphore

# the cap a group runs under when the caller asks for no limit. it is a number
# no fan-out reaches rather than a special case, which keeps one code path for
# limited and unlimited groups; a semaphore stores a counter, so a large cap
# costs no more than a small one.
GROUP_UNLIMITED := 1000000

fn error_code_to_wait(code: Int) -> WaitError:
    if code == 2:
        return WaitError.DeadlineExceeded
    return WaitError.Cancelled

fn context_wait_error(ctx: Context) -> WaitError:
    # error_code(), not err.load(): the cell alone does not know about a
    # deadline that has passed but has not been claimed yet, and reading it
    # raw would report a deadline expiry as a plain cancellation.
    return error_code_to_wait(ctx.error_code())

fn make_child_context(parent: Context, deadline_ms: Int) -> (Context, CancelToken):
    err := AtomicInt(0)
    done_ch := Channel[Bool]()
    ctx := Context(done_ch, err, deadline_ms)
    token := CancelToken(done_ch, err)
    spawn watch_parent(parent, done_ch, err)
    return (ctx, token)

# claim the error cell for one reason and, if we won the claim, signal
# cancellation by closing the done channel. compare_set makes the claim
# atomic, so a deadline and a manual cancel racing settle on one winner.
fn mark_context(done_ch: Channel[Bool], err: AtomicInt, code: Int):
    if err.compare_set(0, code):
        done_ch.close()

fn watch_parent(parent: Context, done_ch: Channel[Bool], err: AtomicInt):
    parent.done().recv()
    mut code := parent.error_code()
    if code == 0:
        code = 1
    mark_context(done_ch, err, code)

fn watch_deadline(done_ch: Channel[Bool], err: AtomicInt, at_ms: Int):
    while err.load() == 0:
        if time.now() >= at_ms:
            mark_context(done_ch, err, 2)
            return
        time.delay(1)

# one unit of group work. the permit is taken here rather than in go() so that
# submitting to a full group does not block the submitting task — a group holds
# its backlog instead of pushing it back onto the caller.
#
# a failure cancels the group's context before the error is reported, so the
# siblings learn about it while this task is still unwinding rather than after
# wait() has collected everything.
fn run_group_task(work: fn() -> Int!, token: CancelToken, slots: Semaphore) -> Int!:
    slots.acquire()
    outcome := work()
    slots.release()
    if outcome.is_err:
        token.cancel()
        fail outcome.err
    return outcome.ok

fn after_worker(ch: Channel[Int], ms: Int):
    time.delay(ms)
    ch.send(time.now())
    ch.close()

fn ticker_worker(ch: Channel[Int], stop_ch: Channel[Bool], ms: Int):
    while stop_ch.len() == 0:
        time.delay(ms)
        if stop_ch.len() > 0:
            return
        ch.try_send(time.now())

## return a root context that is never cancelled on its own.
pub fn background() -> Context:
    return Context(Channel[Bool](), AtomicInt(0), -1)

# derive a child context with manual cancellation.
pub fn with_cancel(parent: Context) -> (Context, CancelToken):
    return make_child_context(parent, -1)

# derive a child context that cancels at a deadline.
pub fn with_deadline(parent: Context, at_ms: Int) -> (Context, CancelToken):
    pair := make_child_context(parent, at_ms)
    ctx := pair.0
    spawn watch_deadline(ctx.done_ch, ctx.err, at_ms)
    return (ctx, pair.1)

# derive a child context that cancels after a timeout.
pub fn with_timeout(parent: Context, ms: Int) -> (Context, CancelToken):
    return with_deadline(parent, time.now() + ms)

# send one timestamp after the delay.
pub fn after(ms: Int) -> Channel[Int]:
    ch := Channel[Int](1)
    spawn after_worker(ch, ms)
    return ch

# create a repeating ticker.
pub fn ticker(ms: Int) -> Ticker:
    tick_ch := Channel[Int](1)
    stop_ch := Channel[Bool](1)
    spawn ticker_worker(tick_ch, stop_ch, ms)
    return Ticker(tick_ch, stop_ch)

## start a group whose context is cancelled by the first failure.
##
## the returned group carries a child of `parent`, so cancelling the parent also
## stops the group, and a failure inside the group does not reach back up to it.
pub fn group(parent: Context) -> Group:
    return group_limited(parent, GROUP_UNLIMITED)

## start a group that runs at most `limit` units of work at once.
##
## use this when the fan-out is wider than the resource behind it — a hundred
## rooms sharing ten connections. submitting never blocks; work waits for a
## permit inside its own task.
pub fn group_limited(parent: Context, limit: Int) -> Group:
    pair := with_cancel(parent)
    pending: List[Task[Int!]] := []
    mut permits := limit
    if permits < 1:
        permits = 1
    return Group(pair.0, pair.1, pending, Semaphore(permits))

# wait for a task unless the context is cancelled first.
pub fn await_ctx[T](task: Task[T], ctx: Context) -> T!WaitError:
    while not task.is_done():
        if ctx.is_cancelled():
            fail context_wait_error(ctx)
        time.delay(1)
    return await task

# send with cancellation support.
pub fn send_ctx[T](ch: Channel[T], ctx: Context, value: T) -> Bool!WaitError:
    while true:
        if ch.try_send(value):
            return true
        if ch.is_closed():
            return false
        if ctx.is_cancelled():
            fail context_wait_error(ctx)
        time.delay(1)

# receive with cancellation support.
pub fn recv_ctx[T](ch: Channel[T], ctx: Context) -> RecvResult[T]!WaitError:
    while true:
        picked := select:
            value := ch.recv() => (1, value)
            timeout 1 => (0, none)
        if picked.0 == 1:
            if picked.1 == none:
                return RecvResult.Closed
            return RecvResult.Value(picked.1?)
        if ctx.is_cancelled():
            fail context_wait_error(ctx)

## ask the experimental cycle collector for a collection right now and wait
## for the attempt to finish. returns true when a collection ran, false when
## the collector is disabled or some thread kept the world from stopping in
## time. the collector only exists when the process was started with
## PITH_CYCLE_GC=1; without it this returns false immediately and reference
## cycles keep their documented behavior — they leak (see docs/ownership.md).
pub fn gc_collect() -> Bool:
    return pith_cycle_gc_collect_now() != 0

## print the cycle collector's counters to stderr: suspects buffered, cycles
## reclaimed, collections run. useful when deciding whether a long-running
## process is accumulating unmarked reference cycles.
pub fn gc_stats():
    pith_cycle_gc_stats()

# build a blocking error for cancellation.
pub fn blocking_cancelled() -> BlockingError:
    return BlockingError(1, "cancelled")

# build a blocking error for deadline expiry.
pub fn blocking_deadline_exceeded() -> BlockingError:
    return BlockingError(2, "deadline exceeded")

# build a generic blocking failure.
pub fn blocking_failed(message: String) -> BlockingError:
    return BlockingError(3, message)

# convert a wait error into the blocking error shape used by io helpers.
pub fn blocking_from_wait(err: WaitError) -> BlockingError:
    if err == WaitError.DeadlineExceeded:
        return blocking_deadline_exceeded()
    return blocking_cancelled()

impl Context:
    fn done() -> Channel[Bool]:
        return self.done_ch

    fn is_cancelled() -> Bool:
        return self.error_code() != 0

    fn error_code() -> Int:
        code := self.err.load()
        if code != 0:
            return code
        # a deadline is data, not an event: it is set once when the context
        # is built and never changes, so whether it has passed is a question
        # the clock can answer on its own. leaving that answer to
        # watch_deadline made it wait on a task being scheduled, and under
        # load a caller could see a live context well after its deadline had
        # gone by. claiming the cell here does exactly what the watcher would
        # have done, and compare_set inside mark_context keeps the two from
        # both winning — so this is the same answer, not a new one, just no
        # longer delayed until a task gets a turn. the watcher stays for the
        # context nobody asks about, whose done channel still has to close.
        if self.deadline_ms < 0 or time.now() < self.deadline_ms:
            return 0
        mark_context(self.done_ch, self.err, 2)
        # re-read rather than assume 2: a cancel racing this claim may have
        # taken the cell first, and its reason is the truthful one.
        return self.err.load()

    fn deadline() -> Int?:
        if self.deadline_ms < 0:
            return none
        return self.deadline_ms

impl Group:
    ## add one unit of work to the group. returns immediately; the work runs on
    ## its own task.
    ##
    ## `work` should consult `group.ctx` if it is long-running, so a sibling's
    ## failure can stop it. work that never looks at the context still runs to
    ## completion — cancelling a context asks a task to stop, it does not kill it.
    fn go(work: fn() -> Int!):
        # the fields are read into locals first: a spawn argument cannot load
        # from `self` (the ir consumer rejects it), so the method hands the
        # task plain values rather than a receiver to walk.
        token := self.token
        slots := self.slots
        self.tasks.push(spawn run_group_task(work, token, slots))

    ## wait for every unit of work, then report the first failure.
    ##
    ## every task is awaited even after one has failed, so when this returns
    ## nothing from the group is still running — which is what makes it safe to
    ## release whatever the work borrowed. the first error is the one reported;
    ## later ones are discarded, as they are usually the cancellation that the
    ## first one caused.
    fn wait() -> Int!:
        mut first := ""
        for task in self.tasks:
            outcome := await task
            if outcome.is_err and first == "":
                first = outcome.err
        if first != "":
            fail first
        return 0

    ## cancel the group's context without waiting. the caller still has to
    ## `wait()` to be sure the work has stopped.
    fn cancel():
        self.token.cancel()

impl CancelToken:
    fn cancel():
        mark_context(self.done_ch, self.err, 1)

impl Ticker:
    fn channel() -> Channel[Int]:
        return self.tick_ch

    fn stop():
        self.stop_ch.try_send(true)

impl BlockingError:
    fn is_cancelled() -> Bool:
        return self.kind == 1

    fn is_deadline_exceeded() -> Bool:
        return self.kind == 2

    fn is_failed() -> Bool:
        return self.kind == 3

# --- group test fixtures ---
#
# the work a group runs is `fn() -> Int!`, and a pith lambda can neither fail
# nor use `!`, so each unit below is a named function. the counters they share
# are module-level for the same reason: a named function has no closure to
# capture them from.

mut group_test_ran := AtomicInt(0)
mut group_test_live := AtomicInt(0)
mut group_test_peak := AtomicInt(0)
mut group_test_peak_mu := Mutex()

# compare_set in a loop, not store(load() + 1): those are two operations, and a
# sibling bumping the counter between them costs an increment. these units run
# concurrently by construction, so the short form makes the count assertions
# below flake rather than fail honestly.
fn group_test_bump(cell: AtomicInt):
    mut settled := false
    while not settled:
        current := cell.load()
        settled = cell.compare_set(current, current + 1)

fn group_test_quick() -> Int!:
    group_test_bump(group_test_ran)
    return 1

fn group_test_fails() -> Int!:
    fail "unit failed"

# slow enough that its siblings are still running when another unit fails.
fn group_test_slow() -> Int!:
    time.delay(60)
    return 1

# record the concurrency this unit observed, so a limit can be asserted rather
# than assumed.
fn group_test_tracked() -> Int!:
    # the whole read-modify-write of the live count and the high-water mark sits
    # under one lock, so the observed peak is a value that really existed rather
    # than two racing updates blended together.
    group_test_peak_mu.lock()
    now := group_test_live.load() + 1
    group_test_live.store(now)
    if now > group_test_peak.load():
        group_test_peak.store(now)
    group_test_peak_mu.unlock()

    time.delay(20)

    group_test_peak_mu.lock()
    group_test_live.store(group_test_live.load() - 1)
    group_test_peak_mu.unlock()
    return 1

test "a group of successful work reports success":
    group_test_ran.store(0)
    g := group(background())
    g.go(group_test_quick)
    g.go(group_test_quick)
    g.go(group_test_quick)

    assert(g.wait().is_ok)
    assert_eq(group_test_ran.load(), 3)
    # nothing failed, so the group's context is still live
    assert(not g.ctx.is_cancelled())

test "a group reports the first failure and cancels its context":
    g := group(background())
    g.go(group_test_slow)
    g.go(group_test_fails)
    g.go(group_test_slow)

    outcome := g.wait()
    assert(outcome.is_err)
    assert_eq(outcome.err, "unit failed")
    # the siblings were told to stop, whether or not they were looking
    assert(g.ctx.is_cancelled())

test "an empty group succeeds without waiting for anything":
    assert(group(background()).wait().is_ok)

test "cancelling a group's parent cancels the group":
    pair := with_cancel(background())
    g := group(pair.0)
    pair.1.cancel()
    # the watcher task has to observe the parent, so give it a moment
    time.delay(50)
    assert(g.ctx.is_cancelled())
    assert(g.wait().is_ok)

test "a limited group runs no more than its permits at once":
    group_test_live.store(0)
    group_test_peak.store(0)
    g := group_limited(background(), 2)
    mut i := 0
    while i < 6:
        g.go(group_test_tracked)
        i = i + 1

    assert(g.wait().is_ok)
    assert(group_test_peak.load() <= 2)
    # and it really did overlap, rather than serialising by accident
    assert(group_test_peak.load() >= 1)

test "a group limit below one is clamped rather than deadlocking":
    g := group_limited(background(), 0)
    g.go(group_test_quick)
    assert(g.wait().is_ok)

test "concurrent contexts can be cancelled":
    parent := background()
    pair := with_cancel(parent)
    ctx := pair.0
    token := pair.1

    assert(not parent.is_cancelled())
    assert(not ctx.is_cancelled())
    token.cancel()
    assert(ctx.is_cancelled())
    assert_eq(ctx.error_code(), 1)

test "a deadline that has passed is observable without waiting for a task":
    # no delay anywhere in this test: the deadline is already a second in
    # the past when the context is built, so it is cancelled by then too.
    # asking before watch_deadline has had a turn used to answer "live",
    # which under load is how a caller saw a context past its deadline.
    ctx := with_deadline(background(), time.now() - 1000).0
    assert(ctx.is_cancelled())
    # and the reason is the deadline, not a bare cancellation — the two
    # readings have to agree, because every caller checks is_cancelled()
    # and then asks error_code() why
    assert_eq(ctx.error_code(), 2)
    assert(blocking_from_wait(context_wait_error(ctx)).is_deadline_exceeded())

test "a deadline still ahead of us leaves the context live":
    ctx := with_deadline(background(), time.now() + 60000).0
    assert(not ctx.is_cancelled())
    assert_eq(ctx.error_code(), 0)

test "a context with no deadline is never cancelled by the clock":
    assert(not background().is_cancelled())
    assert(not with_cancel(background()).0.is_cancelled())

test "cancelling before a deadline passes keeps the cancel as the reason":
    pair := with_deadline(background(), time.now() + 60000)
    pair.1.cancel()
    assert(pair.0.is_cancelled())
    assert_eq(pair.0.error_code(), 1)

test "concurrent blocking errors classify failures":
    cancelled := blocking_cancelled()
    deadline := blocking_deadline_exceeded()
    failed := blocking_failed("boom")

    assert(cancelled.is_cancelled())
    assert(not cancelled.is_failed())
    assert(deadline.is_deadline_exceeded())
    assert_eq(deadline.message, "deadline exceeded")
    assert(failed.is_failed())
    assert_eq(failed.message, "boom")
    assert(blocking_from_wait(WaitError.Cancelled).is_cancelled())
    assert(blocking_from_wait(WaitError.DeadlineExceeded).is_deadline_exceeded())
