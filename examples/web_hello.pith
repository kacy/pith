# a first std.web server: a home page and a greeting with a path parameter.
#
# a real program ends main with `build_app().listen("0.0.0.0", 8080)!` and
# serves until it is stopped. this one starts the server on a background task,
# sends it a few requests, prints what came back and exits, so its output can
# be checked.

import std.net.http as http
import std.net.tcp as tcp
import std.web as web

PORT := 18080

fn home(req: web.Request) -> http.HttpResponse:
    return http.text(200, "welcome to pith")

fn greet(req: web.Request) -> http.HttpResponse:
    return http.text(200, "hello, {req.param("name")}")

fn build_app() -> web.App:
    mut app := web.new()
    app = app.get("/", home)
    app = app.get("/hello/:name", greet)
    return app

fn serve(port: Int) -> Int:
    return build_app().listen("127.0.0.1", port) catch 0

# connect until the accept loop answers, rather than sleeping for a guess.
fn wait_until_listening(port: Int) -> Bool:
    for attempt in 0..500:
        probe := tcp.connect("127.0.0.1", port) catch:
            sleep(10)
            continue
        tcp.close(probe)
        return true
    return false

# one request, summarized as the status line and body a client would see.
fn show(method: String, path: String):
    resp := http.request(method, "127.0.0.1", PORT, path).send() catch:
        print("{method} {path}: no response")
        return
    body := resp.body_text() catch ""
    print("{method} {path} -> {resp.status} {body}")

fn main() -> Int!:
    spawn serve(PORT)
    if not wait_until_listening(PORT):
        fail "the server never came up"

    show("GET", "/")
    show("GET", "/hello/ada")
    # web.new() adds a health check for load balancers.
    show("GET", "/healthz")
    show("GET", "/nowhere")
    # the path exists but takes only GET, so the router answers 405.
    show("POST", "/")
    return 0
