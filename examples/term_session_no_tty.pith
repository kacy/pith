# a terminal session refuses to open when there is no terminal, which is the
# situation this example runs in: the example harness pipes stdout, so open()
# must fail cleanly before touching any terminal state. a program that
# supports both a terminal and a pipe branches on this error and falls back
# to plain output.
import std.term.session as session

fn main():
    r := session.open()
    if r.is_ok:
        t := r.ok
        t.close()
        print("opened a terminal session")
    else:
        print("no terminal: {r.err}")
