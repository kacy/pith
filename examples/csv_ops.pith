# csv_ops: reading and writing CSV with std.csv.
#
# summarizes a month of expenses exported from a bank. parse_with_headers
# turns each row into a map keyed by column name, quoted fields keep their
# commas, and the summary is encoded back to CSV, saved, and read again.

import std.csv as csv
import std.fs as fs

fn export_text() -> String:
    return [
        "date,payee,category,amount_cents",
        "2026-11-02,corner cafe,food,450",
        "2026-11-03,\"rail, regional\",travel,2380",
        "2026-11-09,grocer,food,6215",
        "2026-11-14,\"books \"\"n\"\" more\",leisure,1899",
        "2026-11-20,grocer,food,4105",
        "2026-11-28,taxi,travel,1720",
].join("\n")

fn dollars(cents: Int) -> String:
    return "{cents / 100}.{(cents % 100):02}"

fn main() -> Int!:
    rows := csv.parse_with_headers(export_text())
    print("{rows.len()} transactions")

    mut totals: Map[String, Int] := {}
    mut largest := rows[0]
    for row in rows:
        cents := parse_int(row["amount_cents"])!
        totals[row["category"]] = totals.get(row["category"]).unwrap_or(0) + cents
        if cents > parse_int(largest["amount_cents"])!:
            largest = row

    # a quoted field comes back without its quotes, commas and all
    print("largest: {largest["payee"]} on {largest["date"]}, {dollars(parse_int(largest["amount_cents"])!)}")
    print("")

    mut summary: List[List[String]] := [["category", "total"]]
    for category in totals.keys().sort():
        print("{category:<8} {dollars(totals[category]):>7}")
        summary.push([category, dollars(totals[category])])

    # encode_row quotes only the fields that need it
    print("")
    print(csv.encode_row(["note", "food, mostly groceries"]))

    path := "/tmp/pith_csv_ops_summary.csv"
    defer fs.remove(path)
    written := csv.save(path, summary)!
    reloaded := csv.parse_file(path)!
    print("saved {written} bytes, read back {reloaded.len() - 1} categories")
    return 0
