# using the redis client (std.redis).
#
# a real program connects to a redis server and issues commands. to keep this
# example self-contained, it first spins up a tiny stand-in server on loopback
# that replays canned RESP responses — enough to exercise the client without a
# running redis. against a real server you would just call redis.connect and
# skip the mock entirely.

import std.redis as redis
import std.net.tcp as tcp

# a stand-in redis: accept one connection, then reply to each command in turn
# with a pre-baked RESP response. it does not parse the requests — the client
# sends them in a fixed order, so canned replies are enough.
fn fake_redis(port: Int, replies: List[String]) -> Int!:
    server := tcp_listen("127.0.0.1", port)!
    defer tcp_close(server)
    conn := tcp_accept(server)!
    defer tcp_close(conn)
    for reply in replies:
        request := tcp_read(conn, 4096)!
        tcp.write_all(conn, reply)!
    return 0

fn main() -> Int!:
    port := 17654
    # one canned RESP reply per command main sends below, in order.
    server := spawn fake_redis(port, ["+PONG\r\n", "+OK\r\n", "$5\r\nhello\r\n", ":1\r\n", ":2\r\n", ":1\r\n", "*2\r\n$8\r\ngreeting\r\n$7\r\ncounter\r\n", ":1\r\n"])
    sleep(200)

    c := redis.connect("127.0.0.1", port)!
    defer c.close()
    print("ping: {c.ping()!}")
    print("set: {c.set("greeting", "hello")!}")
    print("get: {c.get("greeting")!}")
    print("incr: {c.incr("counter")!}")
    print("incr: {c.incr("counter")!}")
    print("exists: {c.exists("greeting")!}")
    print("keys: {c.keys("*")!.len()}")
    print("del: {c.del("greeting")!}")

    await server
    return 0
