# optionals: T? for a value that may be absent, and the ways to read one.
#
# answers questions about a team directory. a lookup that misses returns
# none instead of a sentinel like "" or -1, and the type says so: a
# String? cannot be used as a String until the code has decided what an
# empty one means.

struct Member:
    name: String
    desk: Int?
    # a field with an optional type can default to none
    phone: String? = none

fn find(members: List[Member], name: String) -> Member?:
    for member in members:
        if member.name == name:
            return member
    return none

# a plain value passed to an optional parameter is widened to a present one
fn desk_label(desk: Int?) -> String:
    return match desk:
        none => "remote"
        number => "desk {number}"

fn main():
    members := [Member(name: "ada", desk: 12, phone: "555-0101"), Member(name: "grace", desk: none), Member(name: "linus", desk: 7)]

    # if let runs the branch only when there is a value, and names it
    for name in ["grace", "margaret"]:
        if let member = find(members, name):
            print("{name}: {desk_label(member.desk)}")
        else:
            print("{name}: not in the directory")

    # unwrap_or supplies the value to use when there is none
    for member in members:
        print("{member.name:<6} phone {member.phone.unwrap_or("unlisted")}")

    # an optional interpolates as its value, or as `none`
    print("ada's desk: {members[0].desk}, grace's desk: {members[1].desk}")
    print("a plain Int widens: {desk_label(30)}")

    # .get is the safe form of indexing, for maps and lists alike
    extensions := {"ada": 4101, "linus": 4107}
    # grace has no extension of her own, so calls go to the front desk
    print("grace's extension: {extensions.get("grace").unwrap_or(4100)}")
    print("a fourth member exists: {members.get(3) != none}")

    # a list of optionals keeps a slot for each missing value
    desks: List[Int?] := members.map(fn(member: Member) => member.desk)
    mut assigned := 0
    for desk in desks:
        if desk != none:
            assigned += 1
    print("{assigned} of {desks.len()} members have a desk")
