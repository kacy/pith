# generics: structs, enums and functions written once for any element type.
#
# a few catalog helpers, pagination, search and price lists, used on two
# unrelated product types. type arguments are inferred from the arguments
# at each call; a bound such as `T: Priced` says which methods the body may
# call on a T, and each type a function is used with gets its own compiled
# copy.

interface Priced:
    fn cents() -> Int

interface Named:
    fn label() -> String

struct Book:
    title: String
    price: Int

impl Priced for Book:
    fn cents() -> Int:
        return self.price

impl Named for Book:
    fn label() -> String:
        return self.title

struct Coffee:
    origin: String
    grams: Int
    cents_per_100g: Int

impl Priced for Coffee:
    fn cents() -> Int:
        return self.grams * self.cents_per_100g / 100

impl Named for Coffee:
    fn label() -> String:
        return "{self.origin} {self.grams}g"

# a generic struct, and a generic enum
struct Page[T]:
    number: Int
    items: List[T]

enum Lookup[T]:
    Found(T)
    Missing(String)

impl Page:
    # a method can take type parameters of its own: T comes from the page,
    # U from the function passed in
    fn map[U](convert: fn(T) -> U) -> Page[U]:
        return Page(number: self.number, items: self.items.map(convert))

fn paginate[T](items: List[T], size: Int) -> List[Page[T]]:
    mut pages: List[Page[T]] := []
    for item, index in items:
        if index % size == 0:
            pages.push(Page(number: pages.len() + 1, items: []))
        pages[pages.len() - 1].items.push(item)
    return pages

fn find[T](items: List[T], matches: fn(T) -> Bool, wanted: String) -> Lookup[T]:
    for item in items:
        if matches(item):
            return Lookup.Found(item)
    return Lookup.Missing(wanted)

fn total[T: Priced](items: List[T]) -> Int:
    return items.reduce(0, fn(sum: Int, item: T) => sum + item.cents())

# two bounds, written in a where clause, which reads better as they grow
fn price_list[T](items: List[T]) -> List[String] where T: Priced + Named:
    return items.map(fn(item: T) => "{item.label():<18} {money(item.cents()):>6}")

fn money(cents: Int) -> String:
    return "{cents / 100}.{cents % 100:02}"

fn main():
    books := [
        Book(title: "the pith book", price: 3900),
        Book(title: "systems notes", price: 2450),
        Book(title: "small servers", price: 1800),
    ]
    coffee := [
        Coffee(origin: "kenya", grams: 250, cents_per_100g: 640),
        Coffee(origin: "peru", grams: 1000, cents_per_100g: 410),
    ]

    for line in price_list(books):
        print(line)
    for line in price_list(coffee):
        print(line)
    print("books {money(total(books))}, coffee {money(total(coffee))}")

    for page in paginate(books, 2):
        titles := page.map(fn(book: Book) => book.title)
        print("page {titles.number}: {titles.items.join(", ")}")

    for wanted in ["peru", "brazil"]:
        match find(coffee, fn(bag: Coffee) => bag.origin == wanted, wanted):
            Lookup.Found(bag) => print("found {bag.label()} at {money(bag.cents())}")
            Lookup.Missing(name) => print("no coffee from {name}")

    # with no argument to infer T from, the call names it
    empty := paginate[Book]([], 10)
    print("pages for an empty shelf: {empty.len()}")
