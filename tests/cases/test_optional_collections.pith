# a collection literal whose element or value type is optional (or a
# result) must wrap each value, not store the raw one. before this, the
# raw values were stored and a later .value() dereferenced an integer
# as a heap tuple and crashed.
fn ok_val(x: Int) -> Int!:
    return x

fn main():
    opts: List[Int?] := [1, none, 3]
    a := opts[0]
    print(a.value().to_string())
    b := opts[1]
    if b == none:
        print("none")
    c := opts[2]
    print(c.value().to_string())

    rs: List[Int!] := [ok_val(5), ok_val(10)]
    r := rs[1]
    print((r catch 0).to_string())

    mstr: Map[String, Int?] := {"a": 1, "b": 3}
    print(mstr.get_default("a", none).value().to_string())
    print(mstr.get_default("b", none).value().to_string())

    mint: Map[Int, String?] := {1: "x", 2: "y"}
    print(mint.get_default(2, none).value())

    nums := [10, 20, 30]
    print(nums[2].to_string())
