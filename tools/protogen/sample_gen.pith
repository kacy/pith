    # end the rpc with grpc-status 0 (OK).
    pub fn finish_ok():
        self.inner.finish_ok()
    # this rpc's caller metadata, lowercase-keyed.
    pub fn metadata() -> Map[String, String]:
        return self.inner.metadata()
    # the absolute deadline (a time.mono_millis() timestamp), 0 when none.
    pub fn deadline_ms() -> Int:
        return self.inner.deadline_ms()
    # whether a graceful shutdown has begun. a handler that streams
    # indefinitely polls this and ends its own stream; one that does
    # not is closed with UNAVAILABLE partway through the grace period.
    pub fn closing() -> Bool:
        return self.inner.closing()

