# std.trace - opentelemetry-style distributed tracing.
#
# a span records one unit of work: a name, timing, attributes, a status, and its
# place in a trace (a trace id shared by the whole request, a span id, and the
# parent span). spans nest: the "current" span is tracked per os thread, so
# starting a span inside another parents it automatically without threading a
# context through every call.
#
#     span := trace.start("handle_request")
#     span.set_attr("http.route", "/api")
#     ... work, possibly starting child spans ...
#     span.end()
#
# tracing is OFF until trace.set_active(true) (std.obs.init does this from the
# environment), so start() is a cheap no-op in an uninstrumented program. ended
# spans collect in a buffer that the OTLP exporter drains; see std.otlp.

import std.uuid as uuid
import std.time as time
import std.encoding as encoding
import std.binary as binary
import std.bits as bits
import std.bytes as bytes

# span kinds (OTel SpanKind).
pub INTERNAL := 1
pub SERVER := 2
pub CLIENT := 3
pub PRODUCER := 4
pub CONSUMER := 5

# status codes (OTel StatusCode).
pub STATUS_UNSET := 0
pub STATUS_OK := 1
pub STATUS_ERROR := 2

# attribute value kinds. an Attr's `kind` picks which of its value fields is
# live; these mirror the OTLP AnyValue variants the exporter can encode.
pub ATTR_STRING := 0
pub ATTR_INT := 1
pub ATTR_BOOL := 2
pub ATTR_FLOAT := 3

# one span attribute: a key plus a value of one of four types (kind selects
# which field is live). mirrors OTLP AnyValue's string/bool/int/double.
pub struct Attr:
    pub key: String
    pub kind: Int      # ATTR_STRING | ATTR_INT | ATTR_BOOL | ATTR_FLOAT
    pub s: String
    pub i: Int
    pub b: Bool
    pub f: Float

# per-span caps on collected data, matching the OTel default span limits. once a
# list is full the extra item is dropped and the matching dropped_* counter is
# bumped, so a runaway span cannot grow without bound.
MAX_SPAN_ATTRIBUTES := 128
MAX_SPAN_EVENTS := 128
MAX_SPAN_LINKS := 128

# a timestamped named point on a span (an OTel span event) with its own
# attributes — e.g. "exception" or "cache.miss" at a moment during the span.
pub struct SpanEvent:
    pub name: String
    pub time_unix_ns: Int
    pub attrs: List[Attr]

# a reference from this span to another span's context (an OTel span Link),
# carrying just the linked trace and span ids.
pub struct Link:
    pub trace_id: String
    pub span_id: String

# global on/off. off => start() returns a non-recording span and touches no
# per-thread state, so the overhead of leaving trace calls in is negligible.
#
# shared and unlocked on purpose. std.obs.init sets it once at startup, before
# any task exists, and it is a machine word holding no reference, so a later
# flip cannot tear or free anything under a reader — the worst a racing task
# sees is the previous answer for one span, which is what turning tracing on or
# off mid-flight means anyway.
mut trace_active := false

# turn tracing on or off process-wide. std.obs.init sets this from the
# environment; until then start() is a no-op.
pub fn set_active(on: Bool):
    trace_active = on

# whether tracing is currently active.
pub fn is_active() -> Bool:
    return trace_active

# the current span per os thread. a fresh thread (including a spawned task)
# starts with no active span; propagate across a spawn with current_context()
# then with_context() inside the task.
threadlocal mut cur_trace_id := ""
threadlocal mut cur_span_id := ""
threadlocal mut cur_sampled := false

# a span's identity and sampling decision — the part that crosses process
# boundaries (see traceparent) and the part a child inherits.
pub struct SpanContext:
    pub trace_id: String
    pub span_id: String
    pub sampled: Bool

fn empty_context() -> SpanContext:
    return SpanContext("", "", false)

# whether a context carries a well-formed trace id and span id.
pub fn context_is_valid(ctx: SpanContext) -> Bool:
    return ctx.trace_id.len() == 32 and ctx.span_id.len() == 16

# the active span's context on this thread, or an empty (invalid) context.
pub fn current_context() -> SpanContext:
    return SpanContext(cur_trace_id, cur_span_id, cur_sampled)

# make `ctx` the current context on this thread (used to re-establish a parent
# inside a spawned task, or from an inbound traceparent).
pub fn with_context(ctx: SpanContext):
    cur_trace_id = ctx.trace_id
    cur_span_id = ctx.span_id
    cur_sampled = ctx.sampled

# drop the current context on this thread (no active span).
pub fn clear_context():
    cur_trace_id = ""
    cur_span_id = ""
    cur_sampled = false

# one span: a named, timed unit of work with attributes, a status, and its
# place in a trace. a non-recording span (recording=false) is the no-op returned
# when tracing is inactive.
pub struct Span:
    pub trace_id: String
    pub span_id: String
    pub parent_id: String
    pub name: String
    pub kind: Int
    pub start_unix_ns: Int
    start_mono_ns: Int
    mut end_unix_ns: Int
    mut attrs: List[Attr]
    mut status: Int
    mut status_message: String
    pub recording: Bool
    # the context to restore as current when this span ends (its parent).
    saved_trace_id: String
    saved_span_id: String
    saved_sampled: Bool
    mut events: List[SpanEvent]
    mut links: List[Link]
    # counts of items dropped because a span limit was hit (reported to OTLP).
    mut dropped_attributes_count: Int
    mut dropped_events_count: Int
    mut dropped_links_count: Int

# a compact 32-hex-character id from a uuid (dashes stripped) — the trace-id
# width; a 16-hex span id is its first half. these match std.log's id format so
# a trace id lines up whether it came from here or from a log record.
fn compact_uuid() -> String:
    raw := uuid.v7() catch (uuid.v4() catch "")
    return raw.replace("-", "")

fn new_id(width: Int) -> String:
    hex := compact_uuid()
    if width == 32:
        if hex.len() == 32:
            return hex
        return "00000000000000000000000000000000"
    if hex.len() >= 16:
        return hex.substring(0, 16)
    return "0000000000000000"

# unix time in nanoseconds, at millisecond resolution (the wall clock is ms; a
# span's duration is measured separately with the monotonic clock for precision).
fn unix_nanos() -> Int:
    return time.now() * 1000000

fn no_op_span() -> Span:
    # a bare [] does not infer its element type as a positional constructor arg,
    # so each empty list needs an explicitly-typed local.
    empty_attrs: List[Attr] := []
    empty_events: List[SpanEvent] := []
    empty_links: List[Link] := []
    return Span("", "", "", "", INTERNAL, 0, 0, 0, empty_attrs, STATUS_UNSET, "", false, "", "", false, empty_events, empty_links, 0, 0, 0)

# --- head-based sampling (OpenTelemetry sampler) ---
#
# sampling is decided once, when a span starts (head sampling), and the decision
# rides along the whole trace via the traceparent flags. an unsampled span is
# still given real ids and still becomes the current context, so downstream work
# and outgoing traceparents stay linked — it just isn't recorded or exported.
# std.obs.init picks the sampler from OTEL_TRACES_SAMPLER / OTEL_TRACES_SAMPLER_ARG.

# sampler modes. the parentbased_* modes honor an existing parent's decision and
# only fall back to their named root sampler when there is no parent; they are
# the OpenTelemetry defaults and what you almost always want.
pub SAMPLER_ALWAYS_ON := 0
pub SAMPLER_ALWAYS_OFF := 1
pub SAMPLER_TRACEIDRATIO := 2
pub SAMPLER_PARENT_ALWAYS_ON := 3      # OTel default
pub SAMPLER_PARENT_ALWAYS_OFF := 4
pub SAMPLER_PARENT_TRACEIDRATIO := 5

# the active sampler and its ratio (only used by the traceidratio modes).
#
# shared and unlocked for the same reason trace_active is: std.obs.start
# installs the sampler before it turns tracing on, so both are set before the
# first span, and both are plain words holding no reference. a task that reads
# the mode while a later set_sampler is halfway through can pair a new mode with
# an old ratio, which changes at most one span's sampling decision — and only
# for the traceidratio modes, which are the ones that consult the ratio at all.
mut sampler_mode := SAMPLER_PARENT_ALWAYS_ON
mut sampler_ratio := 1.0

# choose the sampler mode and ratio. the ratio is only consulted by the
# traceidratio modes; the others ignore it.
pub fn set_sampler(mode: Int, ratio: Float):
    sampler_mode = mode
    sampler_ratio = ratio

# map an OTEL_TRACES_SAMPLER name onto a sampler mode and install it. an
# unrecognized name falls back to the OTel default (parentbased_always_on).
pub fn set_sampler_from_name(name: String, ratio: Float):
    mut mode := SAMPLER_PARENT_ALWAYS_ON
    if name == "always_on":
        mode = SAMPLER_ALWAYS_ON
    elif name == "always_off":
        mode = SAMPLER_ALWAYS_OFF
    elif name == "traceidratio":
        mode = SAMPLER_TRACEIDRATIO
    elif name == "parentbased_always_on":
        mode = SAMPLER_PARENT_ALWAYS_ON
    elif name == "parentbased_always_off":
        mode = SAMPLER_PARENT_ALWAYS_OFF
    elif name == "parentbased_traceidratio":
        mode = SAMPLER_PARENT_TRACEIDRATIO
    set_sampler(mode, ratio)

# we sample on the low 62 bits of a trace id. the OTel convention is the low 63
# bits of the rightmost 8 bytes, but pith trace ids are uuids: the 9th byte holds
# the 2-bit uuid variant marker in its high bits, so only 62 of those bits are
# random. taking the low 62 gives an even split for both pith-generated ids and
# fully-random inbound trace ids, and it is purely a function of the id, so every
# service that sees the trace reaches the same decision.
SAMPLE_MASK := 4611686018427387903      # 2^62 - 1
# 2^62 as a float, the scale we compare ratio against. it lives inside
# ratio_sampled as a local because a module-level float constant is miscompiled
# to zero; keeping it local sidesteps that.

# the rightmost 8 bytes of a trace id as a non-negative integer, most significant
# byte first. we build it a byte at a time (clearing the top bit of the leading
# byte) rather than calling binary.read_u64_be_at, because that reader rejects a
# value whose top bit is set — which would send roughly half of all trace ids
# down the error path and bias the decision.
fn trace_id_sample_value(decoded: Bytes) -> Int:
    mut value := bits.band(binary.read_u8_at(decoded, 8) catch 0, 127)
    mut i := 9
    while i < 16:
        byte := binary.read_u8_at(decoded, i) catch 0
        value = bits.shl(value, 8) + byte
        i = i + 1
    return value

# the deterministic trace-id-ratio decision: the same trace id always yields the
# same answer, so every service that sees a trace agrees on whether to sample it.
# a trace is sampled when its low 62 bits fall below ratio * 2^62.
fn ratio_sampled(trace_id: String, ratio: Float) -> Bool:
    if ratio >= 1.0:
        return true
    if ratio <= 0.0:
        return false
    decoded := encoding.from_hex(trace_id) catch bytes.empty()
    if decoded.len() < 16:
        return false
    sample_scale := 4611686018427387904.0   # 2^62
    value := bits.band(trace_id_sample_value(decoded), SAMPLE_MASK)
    threshold := (ratio * sample_scale).to_int()
    return value < threshold

# the root sampling decision (no parent to inherit from): always_on/off resolve
# directly, and the traceidratio modes defer to the deterministic hash.
fn sample_root(trace_id: String) -> Bool:
    if sampler_mode == SAMPLER_ALWAYS_ON or sampler_mode == SAMPLER_PARENT_ALWAYS_ON:
        return true
    if sampler_mode == SAMPLER_ALWAYS_OFF or sampler_mode == SAMPLER_PARENT_ALWAYS_OFF:
        return false
    return ratio_sampled(trace_id, sampler_ratio)

# the child decision. parentbased modes inherit the parent's decision so a whole
# trace is sampled or not as a unit; the non-parent modes make a fresh decision
# (traceidratio on the inherited trace id lands the same way as the root did,
# which is exactly the consistency we want).
fn sample_child(trace_id: String, parent_sampled: Bool) -> Bool:
    if sampler_mode == SAMPLER_PARENT_ALWAYS_ON or sampler_mode == SAMPLER_PARENT_ALWAYS_OFF or sampler_mode == SAMPLER_PARENT_TRACEIDRATIO:
        return parent_sampled
    return sample_root(trace_id)

# start a span of the given kind, parented under the current span on this thread
# (or a new root trace if there is none), and make it the current span. returns a
# no-op span when tracing is inactive. when tracing is active but the sampler
# says no, the span still gets ids and becomes current (so context propagates)
# but is not recorded — recording=false keeps it out of the export buffer.
pub fn start_kind(name: String, kind: Int) -> Span:
    if not trace_active:
        return no_op_span()
    mut trace_id := cur_trace_id
    parent_id := cur_span_id
    # no active trace on this thread means this is a root span.
    is_root := cur_trace_id.len() != 32
    mut sampled := false
    if is_root:
        trace_id = new_id(32)
        sampled = sample_root(trace_id)
    else:
        sampled = sample_child(trace_id, cur_sampled)
    span_id := new_id(16)
    empty_attrs: List[Attr] := []
    empty_events: List[SpanEvent] := []
    empty_links: List[Link] := []
    # recording follows the sampling decision: a sampled span records and exports,
    # an unsampled one only propagates context.
    span := Span(trace_id, span_id, parent_id, name, kind, unix_nanos(), time.mono_nanos(), 0, empty_attrs, STATUS_UNSET, "", sampled, cur_trace_id, cur_span_id, cur_sampled, empty_events, empty_links, 0, 0, 0)
    # this span is now current; it restores the saved parent on end.
    cur_trace_id = trace_id
    cur_span_id = span_id
    cur_sampled = sampled
    return span

# start an INTERNAL span (the common case).
pub fn start(name: String) -> Span:
    return start_kind(name, INTERNAL)

impl Span:
    # whether another attribute fits under MAX_SPAN_ATTRIBUTES; when the cap is
    # reached it records the drop instead so the counter reflects what was lost.
    fn can_add_attr() -> Bool:
        if self.attrs.len() >= MAX_SPAN_ATTRIBUTES:
            self.dropped_attributes_count = self.dropped_attributes_count + 1
            return false
        return true

    # attach a string attribute; returns self so calls can chain.
    fn set_attr(key: String, value: String) -> Span:
        if self.recording and self.can_add_attr():
            self.attrs.push(Attr(key, ATTR_STRING, value, 0, false, 0.0))
        return self

    # attach an integer attribute; returns self so calls can chain.
    fn set_attr_int(key: String, value: Int) -> Span:
        if self.recording and self.can_add_attr():
            self.attrs.push(Attr(key, ATTR_INT, "", value, false, 0.0))
        return self

    # attach a boolean attribute; returns self so calls can chain.
    fn set_attr_bool(key: String, value: Bool) -> Span:
        if self.recording and self.can_add_attr():
            self.attrs.push(Attr(key, ATTR_BOOL, "", 0, value, 0.0))
        return self

    # attach a floating-point attribute; returns self so calls can chain.
    fn set_attr_float(key: String, value: Float) -> Span:
        if self.recording and self.can_add_attr():
            self.attrs.push(Attr(key, ATTR_FLOAT, "", 0, false, value))
        return self

    # record a named event at the current time; returns self so calls can chain.
    fn add_event(name: String) -> Span:
        empty_attrs: List[Attr] := []
        return self.add_event_attrs(name, empty_attrs)

    # record a named event with its own attributes, timestamped like end() does
    # (the span's wall-clock start plus the monotonic time elapsed since). drops
    # the event past MAX_SPAN_EVENTS, bumping dropped_events_count. chainable.
    fn add_event_attrs(name: String, attrs: List[Attr]) -> Span:
        if self.recording:
            if self.events.len() >= MAX_SPAN_EVENTS:
                self.dropped_events_count = self.dropped_events_count + 1
            else:
                time_ns := self.start_unix_ns + (time.mono_nanos() - self.start_mono_ns)
                self.events.push(SpanEvent(name, time_ns, attrs))
        return self

    # record a link to another span's context. drops the link past
    # MAX_SPAN_LINKS, bumping dropped_links_count. returns self so calls can chain.
    fn add_link(ctx: SpanContext) -> Span:
        if self.recording:
            if self.links.len() >= MAX_SPAN_LINKS:
                self.dropped_links_count = self.dropped_links_count + 1
            else:
                self.links.push(Link(ctx.trace_id, ctx.span_id))
        return self

    fn set_status(code: Int, message: String):
        if self.recording:
            self.status = code
            self.status_message = message

    fn context() -> SpanContext:
        return SpanContext(self.trace_id, self.span_id, self.sampled_flag())

    # the sampling decision this span carries, which drives the traceparent
    # flags. recording is set from the sampler at start, so it is exactly the
    # sampled bit: a recording span is sampled, a propagating one is not.
    fn sampled_flag() -> Bool:
        return self.recording

    # finish the span: stamp its end time and restore the parent as the current
    # span. a no-op span (tracing was off) never became current, so it has no
    # parent to restore and nothing to record — it is recognized by its empty
    # trace id. an unsampled-but-propagating span still restores its parent here;
    # only a recording span is handed to the export buffer.
    fn end():
        if self.trace_id == "":
            return
        self.end_unix_ns = self.start_unix_ns + (time.mono_nanos() - self.start_mono_ns)
        cur_trace_id = self.saved_trace_id
        cur_span_id = self.saved_span_id
        cur_sampled = self.saved_sampled
        if self.recording:
            record_finished_span(self)

# --- export buffer: ended spans wait here for the OTLP exporter to drain ---
#
# every span that ends writes here and the exporter drains from here, so unlike
# the two settings above this really is contended state. all three accesses
# (set_sink, record_finished_span, drain_finished_spans) take the lock, and the
# drain hands the list over and installs a fresh one rather than exporting under
# it, so the exporter's POST runs off the lock.
mut sink_mu := Mutex()
mut sink_spans: List[Span] := []
mut sink_active := false
FINISHED_SPANS_CAP := 2048

# enable collecting ended spans (the exporter turns this on). off => end() keeps
# nothing, so a program tracing without an exporter does not accumulate spans.
pub fn set_sink(on: Bool):
    sink_mu.lock()
    sink_active = on
    if not on:
        sink_spans = []
    sink_mu.unlock()

fn record_finished_span(span: Span):
    sink_mu.lock()
    if sink_active and sink_spans.len() < FINISHED_SPANS_CAP:
        sink_spans.push(span)
    sink_mu.unlock()

# take and clear the finished spans collected so far (the exporter calls this).
pub fn drain_finished_spans() -> List[Span]:
    sink_mu.lock()
    out := sink_spans
    sink_spans = []
    sink_mu.unlock()
    return out

# --- W3C trace-context propagation (the `traceparent` header) ---

# format a context as a W3C traceparent: version-trace-span-flags.
pub fn format_traceparent(ctx: SpanContext) -> String:
    mut flags := "00"
    if ctx.sampled:
        flags = "01"
    return "00-" + ctx.trace_id + "-" + ctx.span_id + "-" + flags

# the value of one lowercase hex digit, or -1 when the character is not one.
# indexing a String yields one byte, so this is safe to call on any byte of any
# string, however the bytes were encoded.
fn hex_digit(character: String) -> Int:
    code := bits.band(ord(character), 255)
    if code >= 48 and code <= 57:
        return code - 48
    if code >= 97 and code <= 102:
        return code - 87
    return -1

# whether `field` is exactly `width` lowercase hex digits, as every field of a
# W3C traceparent must be. this is a safety check and not only a validation one:
# len() counts bytes and substring() takes byte offsets, so a length check alone
# never proves an offset falls on a character boundary, and slicing through the
# middle of a multi-byte character is a runtime trap that no catch can intercept.
# a traceparent arrives from the network unauthenticated, so proving the field is
# hex — hence all ascii, hence every byte offset is a boundary — is what keeps a
# hostile header from taking the process down. std.net.grpc.bearer_token guards
# the same hazard the same way.
fn is_hex_field(field: String, width: Int) -> Bool:
    if field.len() != width:
        return false
    mut position := 0
    while position < width:
        if hex_digit(field[position]) < 0:
            return false
        position = position + 1
    return true

# parse a W3C traceparent header into a context, or none when malformed. every
# field is validated as hex before it is read, so a malformed or hostile header
# is rejected rather than trusted or fatal.
pub fn parse_traceparent(header: String) -> SpanContext?:
    parts := header.split("-")
    if parts.len() < 4:
        return none
    if parts[0] != "00":
        return none
    trace_id := parts[1]
    span_id := parts[2]
    flags := parts[3]
    if not is_hex_field(trace_id, 32):
        return none
    if not is_hex_field(span_id, 16):
        return none
    if not is_hex_field(flags, 2):
        return none
    # the sampled decision is bit 0 of the flags byte, which is the low bit of
    # the second hex digit.
    sampled := bits.band(hex_digit(flags[1]), 1) == 1
    return SpanContext(trace_id, span_id, sampled)

test "spans nest through the per-thread current span":
    set_active(true)
    clear_context()
    root := start("root")
    assert_eq(root.trace_id.len(), 32)
    assert_eq(root.span_id.len(), 16)
    assert_eq(root.parent_id, "")

    child := start("child")
    assert_eq(child.trace_id, root.trace_id)      # same trace
    assert_eq(child.parent_id, root.span_id)      # parented under root
    assert(child.span_id != root.span_id)

    child.end()
    # current is back to root after the child ends
    assert_eq(current_context().span_id, root.span_id)
    root.end()
    assert_eq(current_context().trace_id, "")
    set_active(false)

test "inactive tracer returns cheap no-op spans":
    set_active(false)
    clear_context()
    s := start("noop")
    assert(not s.recording)
    assert_eq(s.trace_id, "")
    s.end()
    assert_eq(current_context().trace_id, "")

test "traceparent round-trips":
    ctx := SpanContext("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", true)
    header := format_traceparent(ctx)
    assert_eq(header, "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01")
    back := parse_traceparent(header)
    assert(back != none)
    assert_eq(back.value().trace_id, ctx.trace_id)
    assert_eq(back.value().span_id, ctx.span_id)
    assert(back.value().sampled)
    assert(parse_traceparent("garbage") == none)

test "a traceparent carrying a multi-byte character does not parse":
    # a traceparent arrives from the network with no authentication behind it.
    # len() counts bytes and substring() takes byte offsets, so the old length
    # guard did not make the offsets safe: a multi-byte character in the flags
    # field was cut in half, and a cut through a character is a runtime trap
    # that ends the process — two bytes from any client. every field must now be
    # rejected rather than sliced.
    trace_id := "0af7651916cd43dd8448eb211c80319c"
    span_id := "b7ad6b7169203331"
    prefix := "00-" + trace_id + "-" + span_id + "-"

    # the flags field: the one that used to be sliced.
    assert(parse_traceparent(prefix + "0€") == none)
    assert(parse_traceparent(prefix + "€") == none)
    assert(parse_traceparent(prefix + "€0") == none)
    assert(parse_traceparent(prefix + "0é") == none)

    # the other fields, which were never sliced but were taken on trust. each of
    # these is exactly the right byte length, so only a hex check rejects them.
    bad_trace := trace_id.substring(0, 29) + "€"
    bad_span := span_id.substring(0, 13) + "€"
    assert_eq(bad_trace.len(), 32)
    assert_eq(bad_span.len(), 16)
    assert(parse_traceparent("00-" + bad_trace + "-" + span_id + "-01") == none)
    assert(parse_traceparent("00-" + trace_id + "-" + bad_span + "-01") == none)
    assert(parse_traceparent("0€-" + trace_id + "-" + span_id + "-01") == none)

test "a traceparent field that is not hex does not parse":
    trace_id := "0af7651916cd43dd8448eb211c80319c"
    span_id := "b7ad6b7169203331"
    prefix := "00-" + trace_id + "-" + span_id + "-"
    assert(parse_traceparent(prefix + "zz") == none)
    assert(parse_traceparent(prefix + "0") == none)
    assert(parse_traceparent(prefix + "001") == none)
    # uppercase is not lowercase hex, which is what the spec writes.
    assert(parse_traceparent(prefix + "0A") == none)
    assert(parse_traceparent("00-" + trace_id.substring(0, 31) + "z-" + span_id + "-01") == none)
    assert(parse_traceparent("00-" + trace_id + "-" + span_id.substring(0, 15) + "z-01") == none)

test "a well-formed traceparent still parses both sampling decisions":
    trace_id := "0af7651916cd43dd8448eb211c80319c"
    span_id := "b7ad6b7169203331"

    sampled := parse_traceparent("00-" + trace_id + "-" + span_id + "-01")
    assert(sampled != none)
    assert_eq(sampled.value().trace_id, trace_id)
    assert_eq(sampled.value().span_id, span_id)
    assert(sampled.value().sampled)

    plain := parse_traceparent("00-" + trace_id + "-" + span_id + "-00")
    assert(plain != none)
    assert_eq(plain.value().trace_id, trace_id)
    assert_eq(plain.value().span_id, span_id)
    assert(not plain.value().sampled)

    # sampled is bit 0 of the flags byte, not the whole second digit: a peer that
    # sets another flag alongside it still reads as sampled.
    both := parse_traceparent("00-" + trace_id + "-" + span_id + "-03")
    assert(both != none)
    assert(both.value().sampled)
    other := parse_traceparent("00-" + trace_id + "-" + span_id + "-02")
    assert(other != none)
    assert(not other.value().sampled)

test "a parsed traceparent still parents the spans that follow it":
    set_active(true)
    clear_context()
    incoming := parse_traceparent("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01")
    assert(incoming != none)
    with_context(incoming.value())

    child := start("child")
    assert_eq(child.trace_id, "0af7651916cd43dd8448eb211c80319c")
    assert_eq(child.parent_id, "b7ad6b7169203331")
    child.end()

    clear_context()
    set_active(false)

test "typed attributes record their kind and value":
    set_active(true)
    clear_context()
    span := start("work")
    span.set_attr("db.system", "postgres").set_attr_int("rows", 42).set_attr_bool("cache.hit", true).set_attr_float("ratio", 0.75)
    assert_eq(span.attrs.len(), 4)

    assert_eq(span.attrs[0].key, "db.system")
    assert_eq(span.attrs[0].kind, ATTR_STRING)
    assert_eq(span.attrs[0].s, "postgres")

    assert_eq(span.attrs[1].key, "rows")
    assert_eq(span.attrs[1].kind, ATTR_INT)
    assert_eq(span.attrs[1].i, 42)

    assert_eq(span.attrs[2].key, "cache.hit")
    assert_eq(span.attrs[2].kind, ATTR_BOOL)
    assert(span.attrs[2].b)

    assert_eq(span.attrs[3].key, "ratio")
    assert_eq(span.attrs[3].kind, ATTR_FLOAT)
    assert_eq(span.attrs[3].f, 0.75)

    span.end()
    set_active(false)

test "an inactive span records no attributes":
    set_active(false)
    clear_context()
    span := start("noop")
    span.set_attr("k", "v").set_attr_int("n", 1).set_attr_bool("flag", true).set_attr_float("x", 2.0)
    assert_eq(span.attrs.len(), 0)

test "add_event records a named event with a timestamp":
    set_active(true)
    clear_context()
    span := start("work")
    span.add_event("cache.miss")
    assert_eq(span.events.len(), 1)
    assert_eq(span.events[0].name, "cache.miss")
    assert(span.events[0].time_unix_ns > 0)
    assert_eq(span.events[0].attrs.len(), 0)
    span.end()
    set_active(false)

test "add_event_attrs records the event's attributes":
    set_active(true)
    clear_context()
    span := start("work")
    attrs: List[Attr] := [Attr("exception.type", ATTR_STRING, "IOError", 0, false, 0.0)]
    span.add_event_attrs("exception", attrs)
    assert_eq(span.events.len(), 1)
    assert_eq(span.events[0].name, "exception")
    assert_eq(span.events[0].attrs.len(), 1)
    assert_eq(span.events[0].attrs[0].key, "exception.type")
    assert_eq(span.events[0].attrs[0].s, "IOError")
    span.end()
    set_active(false)

test "add_link records the linked context's ids":
    set_active(true)
    clear_context()
    other := SpanContext("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", true)
    span := start("work")
    span.add_link(other)
    assert_eq(span.links.len(), 1)
    assert_eq(span.links[0].trace_id, other.trace_id)
    assert_eq(span.links[0].span_id, other.span_id)
    span.end()
    set_active(false)

test "an inactive span records no events or links":
    set_active(false)
    clear_context()
    span := start("noop")
    span.add_event("e")
    span.add_link(SpanContext("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", true))
    assert_eq(span.events.len(), 0)
    assert_eq(span.links.len(), 0)

test "the attribute cap drops extras and counts them":
    set_active(true)
    clear_context()
    span := start("work")
    mut i := 0
    while i < MAX_SPAN_ATTRIBUTES + 2:
        span.set_attr_int("k", i)
        i = i + 1
    assert_eq(span.attrs.len(), MAX_SPAN_ATTRIBUTES)
    assert_eq(span.dropped_attributes_count, 2)
    span.end()
    set_active(false)

test "the event cap drops extras and counts them":
    set_active(true)
    clear_context()
    span := start("work")
    mut i := 0
    while i < MAX_SPAN_EVENTS + 3:
        span.add_event("e")
        i = i + 1
    assert_eq(span.events.len(), MAX_SPAN_EVENTS)
    assert_eq(span.dropped_events_count, 3)
    span.end()
    set_active(false)

test "the link cap drops extras and counts them":
    set_active(true)
    clear_context()
    ctx := SpanContext("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", true)
    span := start("work")
    mut i := 0
    while i < MAX_SPAN_LINKS + 1:
        span.add_link(ctx)
        i = i + 1
    assert_eq(span.links.len(), MAX_SPAN_LINKS)
    assert_eq(span.dropped_links_count, 1)
    span.end()
    set_active(false)

# --- sampling ---------------------------------------------------------------

test "ratio_sampled is deterministic for a fixed trace id":
    fixed := "0af7651916cd43dd8448eb211c80319c"
    first := ratio_sampled(fixed, 0.5)
    mut i := 0
    while i < 10:
        assert_eq(ratio_sampled(fixed, 0.5), first)
        i = i + 1

test "ratio_sampled samples everything at 1.0 and nothing at 0.0":
    fixed := "0af7651916cd43dd8448eb211c80319c"
    assert(ratio_sampled(fixed, 1.0))
    assert(not ratio_sampled(fixed, 0.0))

test "trace-id-ratio sampling picks a fraction of traces":
    # over many distinct ids at 0.5, we expect roughly half sampled — assert only
    # loose bounds, enough to prove it is neither sampling all nor none.
    mut sampled_count := 0
    mut i := 0
    while i < 200:
        id := new_id(32)
        if ratio_sampled(id, 0.5):
            sampled_count = sampled_count + 1
        i = i + 1
    assert(sampled_count > 40)
    assert(sampled_count < 160)

test "always_off spans propagate context but record nothing":
    set_active(true)
    set_sink(true)
    clear_context()
    drain_finished_spans()          # clear anything left by an earlier test
    set_sampler(SAMPLER_ALWAYS_OFF, 1.0)

    span := start("root")
    assert(not span.recording)
    # it still became the current context, with valid ids, so it propagates.
    assert_eq(current_context().trace_id.len(), 32)
    assert(not current_context().sampled)
    span.end()
    # the parent (empty, since this was a root) is restored on end.
    assert_eq(current_context().trace_id, "")
    # and nothing was buffered for export.
    assert_eq(drain_finished_spans().len(), 0)

    # for contrast, an always_on root does record one finished span.
    set_sampler(SAMPLER_ALWAYS_ON, 1.0)
    on := start("root-on")
    assert(on.recording)
    on.end()
    assert_eq(drain_finished_spans().len(), 1)

    set_sampler(SAMPLER_PARENT_ALWAYS_ON, 1.0)
    set_sink(false)
    set_active(false)

test "parentbased sampler inherits the parent's decision":
    set_active(true)
    set_sink(true)
    clear_context()
    drain_finished_spans()
    set_sampler(SAMPLER_PARENT_ALWAYS_OFF, 1.0)

    parent := "0af7651916cd43dd8448eb211c80319c"
    # a sampled parent context (as if from an inbound traceparent).
    with_context(SpanContext(parent, "b7ad6b7169203331", true))
    child := start("child")
    # parentbased_always_off records the child anyway, because the parent is
    # sampled — parentbased means "do what the parent did".
    assert(child.recording)
    assert_eq(child.trace_id, parent)
    child.end()
    assert_eq(drain_finished_spans().len(), 1)

    # with an unsampled parent, the same sampler drops the child.
    with_context(SpanContext(parent, "b7ad6b7169203331", false))
    child2 := start("child2")
    assert(not child2.recording)
    child2.end()
    assert_eq(drain_finished_spans().len(), 0)

    clear_context()
    set_sampler(SAMPLER_PARENT_ALWAYS_ON, 1.0)
    set_sink(false)
    set_active(false)

test "the traceparent flag reflects the sampling decision":
    set_active(true)
    clear_context()

    set_sampler(SAMPLER_ALWAYS_OFF, 1.0)
    off := start("off")
    off_header := format_traceparent(off.context())
    assert_eq(off_header.substring(off_header.len() - 3, off_header.len()), "-00")
    off.end()

    clear_context()
    set_sampler(SAMPLER_ALWAYS_ON, 1.0)
    on := start("on")
    on_header := format_traceparent(on.context())
    assert_eq(on_header.substring(on_header.len() - 3, on_header.len()), "-01")
    on.end()

    set_sampler(SAMPLER_PARENT_ALWAYS_ON, 1.0)
    set_active(false)
