fn main() -> Int!:
    s := "hi"
    got_h := s.get(0)
    got_i := s.get(1)
    got_oob := s.get(2)
    got_neg := s.get(-1)
    print("h_present:" + (got_h != none).to_string())
    print("h_value:" + got_h.unwrap_or("MISS"))
    print("i_value:" + got_i.unwrap_or("MISS"))
    print("oob_none:" + (got_oob == none).to_string())
    print("neg_none:" + (got_neg == none).to_string())

    empty := ""
    print("empty_none:" + (empty.get(0) == none).to_string())
    return 0
