# std.protobuf — a protocol buffers wire-format codec, written in pith.
#
# this is the low-level wire codec (protobuf encoding spec §"encoding"): the
# varints, tags, and length-delimited fields that every protobuf message is
# built from. it is what the grpc layer uses to serialize request and response
# messages. it is NOT a `.proto` compiler — there is no schema parsing or code
# generation. you build a message by writing its fields in order with a Writer,
# and read one back by looping over its fields with a Reader, the same way the
# database drivers hand-write their wire protocols.
#
#   w := protobuf.writer()
#   w.write_int32(1, 150)!          # field 1 = 150
#   w.write_string(2, "testing")!   # field 2 = "testing"
#   msg := w.bytes()
#   w.free()
#
#   r := protobuf.reader(msg)
#   while not r.at_end():
#       tag := r.read_tag()!
#       if tag.field == 1 and tag.wire == protobuf.WIRE_VARINT:
#           value := r.read_int64()!
#       else:
#           r.skip(tag.wire)!
#
# proto3 semantics: default values (0, "", empty) are normally not written, and
# a decoder reads tags until the buffer is exhausted, dispatching on the field
# number and skipping any field it does not recognize. deferred for later:
# groups (the removed wire types 3 and 4). maps, oneof, and the well-known
# types are schema-level shapes built from these primitives; tools/protogen
# generates them.

import std.bytes as bytes
import std.bits as bits
import std.encoding as encoding

# wire type 0: varint (int32/64, uint32/64, sint32/64, bool, enum).
pub WIRE_VARINT := 0
# wire type 1: 64-bit fixed (fixed64, sfixed64, double).
pub WIRE_I64 := 1
# wire type 2: length-delimited (string, bytes, embedded messages, packed).
pub WIRE_LEN := 2
# wire type 5: 32-bit fixed (fixed32, sfixed32, float).
pub WIRE_I32 := 5

# raised when a buffer ends mid-field or a value is malformed.
pub struct ProtoError:
    pub message: String

# a decoded field key: its field number and wire type.
pub struct Tag:
    pub field: Int
    pub wire: Int

fn proto_fail(message: String) -> ProtoError:
    return ProtoError(message)

# --- writer -----------------------------------------------------------------

# accumulates encoded bytes. build a message by writing its fields in order,
# then take the result with `bytes()` and release it with `free()`.
pub struct Writer:
    pub buf: ByteBuffer

# start a new, empty writer.
pub fn writer() -> Writer:
    return Writer(bytes.buffer())

impl Writer:
    fn put(value: Int) -> Bool!ProtoError:
        wrote := self.buf.write_byte(bits.mask8(value))
        if wrote.is_err:
            fail proto_fail(wrote.err)
        return true

    fn put_bytes(data: Bytes) -> Bool!ProtoError:
        if data.len() == 0:
            return true
        wrote := self.buf.write(data)
        if wrote.is_err:
            fail proto_fail(wrote.err)
        return true

    # write a base-128 varint. a 64-bit value takes at most ten bytes; negative
    # ints are encoded as their full two's-complement width, matching how
    # protobuf sign-extends an int32/int64.
    pub fn write_varint(value: Int) -> Bool!ProtoError:
        mut v := value
        mut i := 0
        while i < 10:
            low := bits.band(v, 127)
            v = bits.shr(v, 7)
            if v == 0:
                self.put(low)!
                return true
            self.put(bits.bor(low, 128))!
            i = i + 1
        fail proto_fail("varint encoding overflow")

    # write a field key: (field_number << 3) | wire_type.
    pub fn write_tag(field: Int, wire: Int) -> Bool!ProtoError:
        return self.write_varint(bits.bor(bits.shl(field, 3), wire))

    # write an int32/int64/uint32/uint64/enum field (a varint).
    pub fn write_int32(field: Int, value: Int) -> Bool!ProtoError:
        self.write_tag(field, WIRE_VARINT)!
        return self.write_varint(value)

    # write an int64 field (a varint; same wire form as int32).
    pub fn write_int64(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_int32(field, value)

    # write a uint32 field (a varint).
    pub fn write_uint32(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_int32(field, value)

    # write a uint64 field (a varint).
    pub fn write_uint64(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_int32(field, value)

    # write an enum field (a varint).
    pub fn write_enum(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_int32(field, value)

    # write a bool field (varint 0 or 1).
    pub fn write_bool(field: Int, value: Bool) -> Bool!ProtoError:
        self.write_tag(field, WIRE_VARINT)!
        if value:
            return self.write_varint(1)
        return self.write_varint(0)

    # write a sint32/sint64 field, zigzag-encoded so small negatives stay small.
    pub fn write_sint32(field: Int, value: Int) -> Bool!ProtoError:
        self.write_tag(field, WIRE_VARINT)!
        return self.write_varint(zigzag_encode(value))

    # write a sint64 field, zigzag-encoded.
    pub fn write_sint64(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_sint32(field, value)

    # write a fixed32 field (little-endian 32-bit).
    pub fn write_fixed32(field: Int, value: Int) -> Bool!ProtoError:
        self.write_tag(field, WIRE_I32)!
        return self.put_fixed32(value)

    # write an sfixed32 field (little-endian 32-bit).
    pub fn write_sfixed32(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_fixed32(field, value)

    # write a fixed64 field (little-endian 64-bit).
    pub fn write_fixed64(field: Int, value: Int) -> Bool!ProtoError:
        self.write_tag(field, WIRE_I64)!
        return self.put_fixed64(value)

    # write an sfixed64 field (little-endian 64-bit).
    pub fn write_sfixed64(field: Int, value: Int) -> Bool!ProtoError:
        return self.write_fixed64(field, value)

    # write a double field (64-bit ieee754, little-endian).
    pub fn write_double(field: Int, value: Float) -> Bool!ProtoError:
        return self.write_fixed64(field, float_to_bits(value))

    # write a float field (32-bit ieee754, little-endian). pith's Float is a
    # 64-bit double, so the value narrows to the nearest f32 first (ties to
    # even), the same rounding a c `(float)` cast does.
    pub fn write_float(field: Int, value: Float) -> Bool!ProtoError:
        self.write_tag(field, WIRE_I32)!
        return self.put_fixed32(float32_bits(value))

    fn put_fixed32(value: Int) -> Bool!ProtoError:
        self.put(bits.band(value, 255))!
        self.put(bits.band(bits.shr(value, 8), 255))!
        self.put(bits.band(bits.shr(value, 16), 255))!
        self.put(bits.band(bits.shr(value, 24), 255))!
        return true

    fn put_fixed64(value: Int) -> Bool!ProtoError:
        self.put_fixed32(value)!
        return self.put_fixed32(bits.shr(value, 32))

    # write a utf8 string field (length-delimited).
    pub fn write_string(field: Int, text: String) -> Bool!ProtoError:
        return self.write_bytes(field, bytes.from_string_utf8(text))

    # write a bytes field (length-delimited).
    pub fn write_bytes(field: Int, data: Bytes) -> Bool!ProtoError:
        self.write_tag(field, WIRE_LEN)!
        self.write_varint(data.len())!
        return self.put_bytes(data)

    # write an embedded message field: its own encoded bytes, length-prefixed.
    pub fn write_message(field: Int, message: Bytes) -> Bool!ProtoError:
        return self.write_bytes(field, message)

    # write a packed repeated varint field (proto3's default for repeated
    # scalars): all the varints back to back inside one length-delimited field.
    pub fn write_packed_varints(field: Int, values: List[Int]) -> Bool!ProtoError:
        inner := writer()
        for value in values:
            inner.write_varint(value)!
        payload := inner.bytes()
        self.write_bytes(field, payload)!
        inner.free()
        return true

    # the encoded bytes so far. the writer is still usable after this.
    pub fn bytes() -> Bytes:
        return self.buf.bytes()

    # release the underlying buffer.
    pub fn free():
        self.buf.free()

# --- reader -----------------------------------------------------------------

# a cursor over an encoded message. read fields in a loop until `at_end()`.
pub struct Reader:
    pub data: Bytes
    pub pos: Int

# start a reader at the front of an encoded message.
pub fn reader(data: Bytes) -> Reader:
    return Reader(data: data, pos: 0)

impl Reader:
    # true once every byte has been consumed.
    pub fn at_end() -> Bool:
        return self.pos >= self.data.len()

    # bytes left from the cursor.
    pub fn remaining() -> Int:
        if self.pos >= self.data.len():
            return 0
        return self.data.len() - self.pos

    fn read_byte() -> Int!ProtoError:
        if self.pos >= self.data.len():
            fail proto_fail("unexpected end of buffer")
        value := self.data[self.pos]
        self.pos = self.pos + 1
        return value

    # read raw bytes and advance the cursor.
    fn read_raw(count: Int) -> Bytes!ProtoError:
        if count < 0:
            fail proto_fail("negative length")
        if self.pos + count > self.data.len():
            fail proto_fail("unexpected end of buffer")
        out := self.data.slice(self.pos, self.pos + count)
        self.pos = self.pos + count
        return out

    # read a base-128 varint.
    pub fn read_varint() -> Int!ProtoError:
        mut result := 0
        mut shift := 0
        mut count := 0
        while count < 10:
            b := self.read_byte()!
            result = bits.bor(result, bits.shl(bits.band(b, 127), shift))
            count = count + 1
            if bits.band(b, 128) == 0:
                return result
            shift = shift + 7
        fail proto_fail("varint too long")

    # read a field key into its field number and wire type.
    pub fn read_tag() -> Tag!ProtoError:
        key := self.read_varint()!
        return Tag(field: bits.shr(key, 3), wire: bits.band(key, 7))

    # read an int32/int64/uint field (a varint); negatives come back as
    # sign-extended ints.
    pub fn read_int64() -> Int!ProtoError:
        return self.read_varint()

    # read an int32 field (a varint).
    pub fn read_int32() -> Int!ProtoError:
        return self.read_varint()

    # read a uint64 field (a varint).
    pub fn read_uint64() -> Int!ProtoError:
        return self.read_varint()

    # read a uint32 field (a varint).
    pub fn read_uint32() -> Int!ProtoError:
        return self.read_varint()

    # read an enum field (a varint).
    pub fn read_enum() -> Int!ProtoError:
        return self.read_varint()

    # read a bool field.
    pub fn read_bool() -> Bool!ProtoError:
        return self.read_varint()! != 0

    # read a zigzag-encoded sint32/sint64 field.
    pub fn read_sint64() -> Int!ProtoError:
        return zigzag_decode(self.read_varint()!)

    # read a zigzag-encoded sint32 field.
    pub fn read_sint32() -> Int!ProtoError:
        return self.read_sint64()

    # read a little-endian 32-bit fixed field (unsigned).
    pub fn read_fixed32() -> Int!ProtoError:
        b0 := self.read_byte()!
        b1 := self.read_byte()!
        b2 := self.read_byte()!
        b3 := self.read_byte()!
        return bits.bor(bits.bor(b0, bits.shl(b1, 8)), bits.bor(bits.shl(b2, 16), bits.shl(b3, 24)))

    # read a little-endian 64-bit fixed field (raw bits).
    pub fn read_fixed64() -> Int!ProtoError:
        low := self.read_fixed32()!
        high := self.read_fixed32()!
        return bits.bor(low, bits.shl(high, 32))

    # read a signed little-endian 32-bit fixed field (sign-extended).
    pub fn read_sfixed32() -> Int!ProtoError:
        raw := self.read_fixed32()!
        if raw >= 2147483648:
            return raw - 4294967296
        return raw

    # read a signed little-endian 64-bit fixed field.
    pub fn read_sfixed64() -> Int!ProtoError:
        return self.read_fixed64()

    # read a double field (64-bit ieee754).
    pub fn read_double() -> Float!ProtoError:
        return float_from_bits(self.read_fixed64()!)

    # read a float field (32-bit ieee754), widened losslessly to a Float.
    pub fn read_float() -> Float!ProtoError:
        return float32_from_bits(self.read_fixed32()!)

    # read a length-delimited field's raw bytes.
    pub fn read_bytes() -> Bytes!ProtoError:
        length := self.read_varint()!
        return self.read_raw(length)

    # read a length-delimited field as an embedded message's bytes.
    pub fn read_message() -> Bytes!ProtoError:
        return self.read_bytes()

    # read a length-delimited field as a utf8 string.
    pub fn read_string() -> String!ProtoError:
        raw := self.read_bytes()!
        decoded := bytes.decode_utf8(raw)
        if decoded.is_err:
            fail proto_fail("field is not valid utf8")
        return decoded.ok

    # read a packed repeated varint field into a list.
    pub fn read_packed_varints() -> List[Int]!ProtoError:
        payload := self.read_bytes()!
        sub := reader(payload)
        out: List[Int] := []
        while not sub.at_end():
            out.push(sub.read_varint()!)
        return out

    # skip an unknown field of the given wire type, leaving the cursor on the
    # next field. this is what keeps a decoder forward-compatible.
    pub fn skip(wire: Int) -> Bool!ProtoError:
        if wire == WIRE_VARINT:
            self.read_varint()!
            return true
        if wire == WIRE_I64:
            self.read_raw(8)!
            return true
        if wire == WIRE_LEN:
            length := self.read_varint()!
            self.read_raw(length)!
            return true
        if wire == WIRE_I32:
            self.read_raw(4)!
            return true
        fail proto_fail("unknown wire type")

# --- 32-bit floats ----------------------------------------------------------
#
# pith's Float is a 64-bit double, but a proto `float` field carries ieee754
# binary32 bits on the wire. these helpers move between the two bit patterns
# by hand: widening an f32 to an f64 is exact, and narrowing rounds to the
# nearest f32 with ties to even, exactly like a c `(float)` cast.

# the ieee754 binary32 bit pattern nearest to `value`.
fn float32_bits(value: Float) -> Int:
    b := float_to_bits(value)
    sign := bits.shl(bits.shr(b, 63), 31)
    exp := bits.band(bits.shr(b, 52), 0x7ff)
    frac := bits.band(b, 0xfffffffffffff)
    if exp == 0x7ff:
        # infinity (frac == 0) or nan. a nan keeps its top mantissa bits and
        # is forced quiet, so the payload can never read back as an infinity.
        if frac == 0:
            return bits.bor(sign, 0x7f800000)
        return bits.bor(sign, bits.bor(0x7fc00000, bits.shr(frac, 29)))
    mut e := exp - 1023
    if e > 127:
        # too large for any finite f32
        return bits.bor(sign, 0x7f800000)
    if e >= 0 - 126:
        # a normal f32 candidate: round the 52-bit mantissa down to 23 bits.
        keep := bits.shr(frac, 29)
        dropped := bits.band(frac, 0x1fffffff)
        mut mant := keep
        if dropped > 0x10000000 or (dropped == 0x10000000 and bits.band(keep, 1) == 1):
            mant = keep + 1
        if mant == 0x800000:
            # the mantissa carried out; bump the exponent instead
            mant = 0
            e = e + 1
            if e > 127:
                return bits.bor(sign, 0x7f800000)
        return bits.bor(sign, bits.bor(bits.shl(e + 127, 23), mant))
    # below the normal f32 range: round the full 53-bit significand onto the
    # subnormal grid (multiples of 2^-149) by shifting `shift` bits off it.
    shift := (0 - e) - 97
    if shift > 60:
        # far below even the subnormal range; rounds to a signed zero
        return sign
    sig := bits.bor(bits.shl(1, 52), frac)
    low := bits.shr(sig, shift)
    rest := bits.band(sig, bits.shl(1, shift) - 1)
    half := bits.shl(1, shift - 1)
    mut sub := low
    if rest > half or (rest == half and bits.band(low, 1) == 1):
        sub = low + 1
    # if the rounding carried up to 2^23 this is exactly the smallest normal
    # f32, whose bit pattern (exponent field 1, mantissa 0) this bor produces.
    return bits.bor(sign, sub)

# the Float (a 64-bit double) an ieee754 binary32 bit pattern denotes. every
# f32 value fits an f64 exactly, so nothing is lost.
fn float32_from_bits(b: Int) -> Float:
    sign := bits.shl(bits.band(bits.shr(b, 31), 1), 63)
    exp := bits.band(bits.shr(b, 23), 255)
    frac := bits.band(b, 0x7fffff)
    if exp == 255:
        # infinity or nan: an all-ones f64 exponent, mantissa carried across
        return float_from_bits(bits.bor(sign, bits.bor(bits.shl(0x7ff, 52), bits.shl(frac, 29))))
    if exp == 0:
        if frac == 0:
            return float_from_bits(sign)
        # an f32 subnormal is a normal f64: normalize the mantissa by hand,
        # walking the leading 1 up to the implicit position.
        mut f := frac
        mut e := 0 - 126
        while bits.band(f, 0x800000) == 0:
            f = bits.shl(f, 1)
            e = e - 1
        f = bits.band(f, 0x7fffff)
        return float_from_bits(bits.bor(sign, bits.bor(bits.shl(e + 1023, 52), bits.shl(f, 29))))
    return float_from_bits(bits.bor(sign, bits.bor(bits.shl((exp - 127) + 1023, 52), bits.shl(frac, 29))))

# --- zigzag -----------------------------------------------------------------

# map a signed int onto an unsigned varint so that small magnitudes (either
# sign) stay short: 0, -1, 1, -2, 2 -> 0, 1, 2, 3, 4.
fn zigzag_encode(value: Int) -> Int:
    if value >= 0:
        return value * 2
    return ((0 - value) * 2) - 1

fn zigzag_decode(value: Int) -> Int:
    half := bits.shr(value, 1)
    if bits.band(value, 1) == 0:
        return half
    return 0 - (half + 1)

# ----------------------------------------------------------------------------

fn bytes_of(values: List[Int]) -> Bytes:
    out := bytes.array()
    for value in values:
        out.push(value)
    return out.bytes()

fn varint_bytes(value: Int) -> Bytes:
    w := writer()
    w.write_varint(value)
    result := w.bytes()
    w.free()
    return result

test "varint encodes the canonical examples":
    assert_eq(encoding.to_hex(varint_bytes(0)), "00")
    assert_eq(encoding.to_hex(varint_bytes(127)), "7f")
    assert_eq(encoding.to_hex(varint_bytes(128)), "8001")
    assert_eq(encoding.to_hex(varint_bytes(150)), "9601")
    assert_eq(encoding.to_hex(varint_bytes(300)), "ac02")

test "varint round-trips a range of values":
    for value in [0, 1, 127, 128, 255, 300, 16384, 2147483647, 1099511627776]:
        r := reader(varint_bytes(value))
        assert_eq(r.read_varint()!, value)

test "a negative int is a ten-byte varint":
    encoded := varint_bytes(0 - 1)
    assert_eq(encoded.len(), 10)
    r := reader(encoded)
    assert_eq(r.read_varint()!, 0 - 1)

test "field 1 = 150 is the canonical 08 96 01":
    w := writer()
    w.write_int32(1, 150)!
    assert_eq(encoding.to_hex(w.bytes()), "089601")
    w.free()

test "a string field is tag, length, then utf8":
    w := writer()
    w.write_string(2, "testing")!
    assert_eq(encoding.to_hex(w.bytes()), "120774657374696e67")
    w.free()

test "an embedded message is length-prefixed":
    w := writer()
    w.write_message(3, bytes_of([0x08, 0x96, 0x01]))!
    assert_eq(encoding.to_hex(w.bytes()), "1a03089601")
    w.free()

test "tags carry the field number and wire type":
    r := reader(bytes_of([0x1a]))
    tag := r.read_tag()!
    assert_eq(tag.field, 3)
    assert_eq(tag.wire, WIRE_LEN)

test "zigzag maps small magnitudes to small varints":
    assert_eq(zigzag_encode(0), 0)
    assert_eq(zigzag_encode(0 - 1), 1)
    assert_eq(zigzag_encode(1), 2)
    assert_eq(zigzag_encode(0 - 2), 3)
    assert_eq(zigzag_encode(2147483647), 4294967294)
    for value in [0, 1, 0 - 1, 2, 0 - 2, 63, 0 - 64, 2147483647, 0 - 2147483648]:
        assert_eq(zigzag_decode(zigzag_encode(value)), value)

test "sint fields zigzag on the wire":
    w := writer()
    w.write_sint32(1, 0 - 1)!
    assert_eq(encoding.to_hex(w.bytes()), "0801")
    r := reader(w.bytes())
    r.read_tag()!
    assert_eq(r.read_sint32()!, 0 - 1)
    w.free()

test "fixed32 and fixed64 are little-endian":
    w := writer()
    w.write_fixed32(1, 0x12345678)!
    assert_eq(encoding.to_hex(w.bytes()), "0d78563412")
    w.free()

    w2 := writer()
    w2.write_fixed64(2, 0x0102030405060708)!
    assert_eq(encoding.to_hex(w2.bytes()), "110807060504030201")
    r := reader(w2.bytes())
    r.read_tag()!
    assert_eq(r.read_fixed64()!, 0x0102030405060708)
    w2.free()

test "sfixed32 sign-extends on read":
    w := writer()
    w.write_sfixed32(1, 0 - 2)!
    r := reader(w.bytes())
    r.read_tag()!
    assert_eq(r.read_sfixed32()!, 0 - 2)
    w.free()

test "double round-trips through fixed64":
    w := writer()
    w.write_double(1, 3.14159)!
    r := reader(w.bytes())
    r.read_tag()!
    assert_eq(r.read_double()!, 3.14159)
    w.free()

# encode a float field and read it straight back, for the float tests below.
fn float_wire_round_trip(value: Float) -> Float!ProtoError:
    w := writer()
    w.write_float(1, value)!
    r := reader(w.bytes())
    r.read_tag()!
    result := r.read_float()!
    w.free()
    return result

test "float encodes the canonical fixed32 bytes":
    # field 1, wire 5: 0d, then 1.5 as little-endian f32 (0x3fc00000).
    w := writer()
    w.write_float(1, 1.5)!
    assert_eq(encoding.to_hex(w.bytes()), "0d0000c03f")
    w.free()

test "float round-trips values an f32 holds exactly":
    for value in [0.0, 1.5, 0.0 - 0.25, 2.0, 123456.0]:
        assert_eq(float_wire_round_trip(value)!, value)

test "float narrows to the nearest f32 on encode":
    # 0.1 has no exact f32, so the wire carries the nearest one and decode
    # widens it back exactly: the f32-rounded double, not 0.1 itself.
    assert_eq(float_wire_round_trip(0.1)!, 0.10000000149011612)

test "float narrowing rounds ties to even":
    # 1 + 2^-24 sits halfway between 1.0 and the next f32; the even mantissa
    # (1.0) wins. 1 + 3 * 2^-24 sits halfway one step up; there the even
    # mantissa is the larger neighbour (1 + 2^-22).
    assert_eq(float_wire_round_trip(float_from_bits(0x3ff0000010000000))!, 1.0)
    assert_eq(float_wire_round_trip(float_from_bits(0x3ff0000030000000))!, float_from_bits(0x3ff0000040000000))

test "float keeps large magnitudes and subnormals":
    # 3.4e38 is near the top of the f32 range; it narrows to a nearby f32.
    assert_eq(float_wire_round_trip(3.4e38)!, float_from_bits(0x47eff933c0000000))
    # 2^-149 is the smallest positive f32 subnormal, and round-trips exactly.
    tiny := float_from_bits(0x36a0000000000000)
    assert_eq(float_wire_round_trip(tiny)!, tiny)
    assert_eq(float_wire_round_trip(0.0 - tiny)!, 0.0 - tiny)

test "a float beyond the f32 range becomes infinity":
    inf := float_from_bits(0x7ff0000000000000)
    assert_eq(float_wire_round_trip(1.0e39)!, inf)
    assert_eq(float_wire_round_trip(0.0 - 1.0e39)!, 0.0 - inf)
    assert_eq(float_wire_round_trip(inf)!, inf)

test "skip steps over an unknown field of each wire type":
    w := writer()
    w.write_string(1, "ignored")!
    w.write_int32(2, 7)!
    w.write_fixed32(3, 99)!
    w.write_int32(4, 42)!
    r := reader(w.bytes())
    first := r.read_tag()!
    r.skip(first.wire)!
    second := r.read_tag()!
    assert_eq(second.field, 2)
    assert_eq(r.read_int32()!, 7)
    third := r.read_tag()!
    r.skip(third.wire)!
    fourth := r.read_tag()!
    assert_eq(fourth.field, 4)
    assert_eq(r.read_int32()!, 42)
    w.free()

test "packed repeated varints round-trip":
    w := writer()
    w.write_packed_varints(6, [3, 270, 86942])!
    assert_eq(encoding.to_hex(w.bytes()), "3206038e029ea705")
    r := reader(w.bytes())
    r.read_tag()!
    assert_eq(r.read_packed_varints()!, [3, 270, 86942])
    w.free()

test "a mixed message decodes field by field":
    w := writer()
    w.write_int32(1, 150)!
    w.write_string(2, "pith")!
    w.write_bool(3, true)!
    w.write_message(4, bytes_of([0x08, 0x2a]))!
    encoded := w.bytes()

    r := reader(encoded)
    mut seen_int := 0
    mut seen_text := ""
    mut seen_bool := false
    mut seen_nested := 0
    while not r.at_end():
        tag := r.read_tag()!
        if tag.field == 1:
            seen_int = r.read_int32()!
        elif tag.field == 2:
            seen_text = r.read_string()!
        elif tag.field == 3:
            seen_bool = r.read_bool()!
        elif tag.field == 4:
            inner := reader(r.read_message()!)
            inner.read_tag()!
            seen_nested = inner.read_int32()!
        else:
            r.skip(tag.wire)!
    assert_eq(seen_int, 150)
    assert_eq(seen_text, "pith")
    assert(seen_bool)
    assert_eq(seen_nested, 42)
    w.free()
