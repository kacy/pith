# std.io — io interfaces and generic helpers
#
# this is the first pass at a shared io foundation for the stdlib.
# the public surface still offers both string and bytes helpers, but
# the transport-facing string layer now rides on top of bytes where it can.
#
# the key idea is simple:
# - transports implement a small interface surface
# - generic helpers like read_all and copy do the repetitive work once
# - higher-level stdlib modules build on the same contracts
#
# handle-backed in-memory adapters are included so the helpers are easy to test.

import std.bytes as bytes
import std.time as time
from std.bytes import ByteBuffer
from std.concurrent import Context, BlockingError, blocking_cancelled, blocking_deadline_exceeded, blocking_failed

DEFAULT_CHUNK_SIZE := 4096

# guards the buffered-stream registries so handlers on different
# threads can allocate, read, and free concurrently. it wraps only map
# operations — never a source read or target write, which would
# serialize every connection behind one blocked socket.
mut io_registry_mu := Mutex()
threadlocal mut next_string_reader_handle: Int := 1
threadlocal mut string_reader_data: Map[Int, String] := {}
threadlocal mut string_reader_offsets: Map[Int, Int] := {}

threadlocal mut next_string_buffer_handle: Int := 1
threadlocal mut string_buffer_parts: Map[Int, List[String]] := {}
threadlocal mut string_buffer_lengths: Map[Int, Int] := {}

threadlocal mut next_bytes_reader_handle: Int := 1
threadlocal mut bytes_reader_data: Map[Int, Bytes] := {}
threadlocal mut bytes_reader_offsets: Map[Int, Int] := {}

threadlocal mut next_buffered_bytes_reader_handle: Int := 1
threadlocal mut buffered_bytes_reader_source_kinds: Map[Int, Int] := {}
threadlocal mut buffered_bytes_reader_source_handles: Map[Int, Int] := {}
threadlocal mut buffered_bytes_reader_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_bytes_reader_cache: Map[Int, Bytes] := {}

threadlocal mut next_buffered_bytes_writer_handle: Int := 1
threadlocal mut buffered_bytes_writer_target_kinds: Map[Int, Int] := {}
threadlocal mut buffered_bytes_writer_target_handles: Map[Int, Int] := {}
threadlocal mut buffered_bytes_writer_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_bytes_writer_cache: Map[Int, Bytes] := {}

# every buffered text reader — over a string, a socket, a file, or a child's
# stdout or stderr — shares this one registry. the reader kind picks which
# source `fill` reads a chunk from; nothing else about the buffering differs,
# which is why there is one implementation of read, read_line and read_until
# rather than one per source.
#
# `cursors` is the read cursor into `cache`: consuming moves the cursor rather
# than re-slicing the string, so taking a line out of a 4 KiB buffer does not
# copy the 4 KiB behind it. the consumed prefix is dropped in one step when the
# next chunk arrives, which keeps the cache from growing without bound.
threadlocal mut next_buffered_text_reader_handle: Int := 1
threadlocal mut buffered_text_reader_kinds: Map[Int, Int] := {}
threadlocal mut buffered_text_reader_sources: Map[Int, Int] := {}
threadlocal mut buffered_text_reader_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_text_reader_cache: Map[Int, String] := {}
threadlocal mut buffered_text_reader_cursors: Map[Int, Int] := {}
# bytes of a character the last fill stopped in the middle of, waiting for the
# rest of it to arrive. a source read is counted in bytes and ends wherever the
# count lands, so this holds at most three bytes and is empty most of the time.
threadlocal mut buffered_text_reader_partials: Map[Int, Bytes] := {}

threadlocal mut next_buffered_string_writer_handle: Int := 1
threadlocal mut buffered_string_writer_targets: Map[Int, Int] := {}
threadlocal mut buffered_string_writer_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_string_writer_cache: Map[Int, String] := {}

threadlocal mut next_buffered_tcp_writer_handle: Int := 1
threadlocal mut buffered_tcp_writer_fds: Map[Int, Int] := {}
threadlocal mut buffered_tcp_writer_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_tcp_writer_cache: Map[Int, String] := {}

threadlocal mut next_buffered_file_writer_handle: Int := 1
threadlocal mut buffered_file_writer_handles: Map[Int, Int] := {}
threadlocal mut buffered_file_writer_chunk_sizes: Map[Int, Int] := {}
threadlocal mut buffered_file_writer_cache: Map[Int, String] := {}

interface Reader:
    fn read(max_bytes: Int) -> String!

interface Writer:
    fn write(data: String) -> Int!

interface BytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!

interface BytesWriter:
    fn write_bytes(data: Bytes) -> Int!

interface Closer:
    fn close()

interface Flusher:
    fn flush() -> Int!

struct StringReader:
    pub handle: Int

struct StringBuffer:
    pub handle: Int

struct BytesCursor:
    pub handle: Int

struct BufferedBytesReader:
    pub handle: Int

struct BufferedBytesWriter:
    pub handle: Int

struct BufferedStringReader:
    pub handle: Int

struct BufferedStringWriter:
    pub handle: Int

struct BufferedTcpStream:
    pub handle: Int

struct BufferedTcpWriter:
    pub handle: Int

struct BufferedFileReader:
    pub handle: Int

struct BufferedFileWriter:
    pub handle: Int

struct TcpStream:
    pub fd: Int

struct FileStream:
    pub handle: Int

struct Process:
    pub handle: Int

struct ProcessStdin:
    pub handle: Int

struct ProcessStdout:
    pub handle: Int

struct ProcessStderr:
    pub handle: Int

struct BufferedProcessStdout:
    pub handle: Int

struct BufferedProcessStderr:
    pub handle: Int

BUFFERED_BYTES_SOURCE_CURSOR := 1
BUFFERED_BYTES_SOURCE_TCP := 2
BUFFERED_BYTES_SOURCE_FILE := 3
BUFFERED_BYTES_SOURCE_PROCESS_STDOUT := 4
BUFFERED_BYTES_SOURCE_PROCESS_STDERR := 5

BUFFERED_BYTES_TARGET_BUFFER := 1
BUFFERED_BYTES_TARGET_TCP := 2
BUFFERED_BYTES_TARGET_FILE := 3
BUFFERED_BYTES_TARGET_PROCESS_STDIN := 4

# which source a text read draws a chunk from. the same tags serve both the
# unbuffered `read_all` loops and the buffered readers' `fill`, because the two
# differ only in what they do with the chunk once they have it.
TEXT_SOURCE_STRING := 1
TEXT_SOURCE_TCP := 2
TEXT_SOURCE_FILE := 3
TEXT_SOURCE_PROCESS_STDOUT := 4
TEXT_SOURCE_PROCESS_STDERR := 5

impl StringReader:
    fn read(max_bytes: Int) -> String!:
        return string_reader_read(self, max_bytes)

    fn read_all() -> String!:
        return read_all(self)

    fn read_all_chunked(chunk_size: Int) -> String!:
        return read_all_chunked(self, chunk_size)

    fn buffered() -> BufferedStringReader:
        return buffered_string_reader(self)

    fn buffered_chunked(chunk_size: Int) -> BufferedStringReader:
        return buffered_string_reader_chunked(self, chunk_size)

impl Reader for StringReader:
    fn read(max_bytes: Int) -> String!:
        return string_reader_read(self, max_bytes)

impl Closer for StringReader:
    # drop the reader's registry entries. a closed reader reads as end of
    # input; a second close is a no-op.
    fn close():
        close_string_reader_state(self.handle)

impl StringBuffer:
    fn write(data: String) -> Int!:
        return string_buffer_write(self, data)

    fn write_all(data: String) -> Int!:
        return write_all(self, data)

    fn write_line(data: String) -> Int!:
        return string_buffer_write_line(self, data)

    fn newline() -> Int!:
        return string_buffer_write(self, chr(10))

    fn string() -> String:
        return string_buffer_string(self)

    fn len() -> Int:
        return string_buffer_len(self)

    fn is_empty() -> Bool:
        return string_buffer_len(self) == 0

    fn clear():
        string_buffer_clear(self)

    fn buffered() -> BufferedStringWriter:
        return buffered_string_writer(self)

    fn buffered_chunked(chunk_size: Int) -> BufferedStringWriter:
        return buffered_string_writer_chunked(self, chunk_size)

impl Writer for StringBuffer:
    fn write(data: String) -> Int!:
        return string_buffer_write(self, data)

impl Closer for StringBuffer:
    # drop the buffer's registry entries, discarding the accumulated text —
    # read string() first. a write or clear after close leaves the buffer
    # closed and reports nothing written; a second close is a no-op.
    fn close():
        close_string_buffer_state(self.handle)

impl BytesCursor:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return bytes_cursor_read(self, max_bytes)

    fn read_exact_bytes(count: Int) -> Bytes!:
        return read_exact_bytes_cursor(self, count)

    fn read_all_bytes() -> Bytes!:
        return read_all_bytes_cursor(self)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_bytes_cursor_chunked(self, chunk_size)

    fn buffered() -> BufferedBytesReader:
        return buffered_bytes_reader(self)

    fn buffered_chunked(chunk_size: Int) -> BufferedBytesReader:
        return buffered_bytes_reader_chunked(self, chunk_size)

impl BytesReader for BytesCursor:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return bytes_cursor_read(self, max_bytes)

impl Closer for BytesCursor:
    # drop the cursor's registry entries, releasing the bytes it was built
    # over. a closed cursor reads as end of input; a second close is a no-op.
    fn close():
        close_bytes_cursor_state(self.handle)

impl BytesWriter for ByteBuffer:
    fn write_bytes(data: Bytes) -> Int!:
        return self.write(data)

impl ByteBuffer:
    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_byte_buffer(self, data)

    fn write_n_bytes(data: Bytes, count: Int) -> Int!:
        return write_n_bytes(self, data, count)

    fn buffered() -> BufferedBytesWriter:
        return buffered_bytes_writer(self)

    fn buffered_chunked(chunk_size: Int) -> BufferedBytesWriter:
        return buffered_bytes_writer_chunked(self, chunk_size)

impl BufferedBytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return buffered_bytes_reader_read(self, max_bytes)

    fn read_exact_bytes(count: Int) -> Bytes!:
        return read_exact_buffered_bytes_reader(self, count)

    fn read_until_bytes(sep: Bytes) -> Bytes!:
        return buffered_bytes_reader_read_until_internal(self, sep)

    fn read_until_bytes_including(sep: Bytes) -> Bytes!:
        return buffered_bytes_reader_read_until_including_internal(self, sep)

    # like read_until_bytes_including, but fails once the accumulated bytes
    # pass `cap` before the separator arrives — so a peer that never sends
    # the separator cannot grow the buffer without bound. a `cap` of 0 or
    # less means no limit, matching the unbounded form.
    fn read_until_bytes_including_bounded(sep: Bytes, cap: Int) -> Bytes!:
        return buffered_bytes_reader_read_until_with_sep_internal(self, sep, true, cap)

    fn read_all_bytes() -> Bytes!:
        return read_all_buffered_bytes_reader(self)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_buffered_bytes_reader_chunked(self, chunk_size)

    fn free():
        free_buffered_bytes_reader(self)

impl BytesReader for BufferedBytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return buffered_bytes_reader_read(self, max_bytes)

impl BufferedBytesWriter:
    fn write_bytes(data: Bytes) -> Int!:
        return buffered_bytes_writer_write(self, data)

    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_buffered_bytes_writer(self, data)

    fn flush() -> Int!:
        return buffered_bytes_writer_flush(self)

    fn free():
        free_buffered_bytes_writer(self)

impl BytesWriter for BufferedBytesWriter:
    fn write_bytes(data: Bytes) -> Int!:
        return buffered_bytes_writer_write(self, data)

impl Flusher for BufferedBytesWriter:
    fn flush() -> Int!:
        return buffered_bytes_writer_flush(self)

# build an in-memory string reader from text.
pub fn string_reader(data: String) -> StringReader:
    return StringReader(allocate_string_reader_handle(data))

# build an in-memory string writer.
pub fn string_buffer() -> StringBuffer:
    return StringBuffer(allocate_string_buffer_handle())

# build an in-memory bytes reader from raw bytes.
pub fn bytes_reader(data: Bytes) -> BytesCursor:
    return BytesCursor(allocate_bytes_reader_handle(data))

fn buffered_bytes_reader(reader: BytesCursor) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_CURSOR, reader.handle, DEFAULT_CHUNK_SIZE)

fn buffered_bytes_reader_chunked(reader: BytesCursor, chunk_size: Int) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_CURSOR, reader.handle, chunk_size)

fn buffered_bytes_writer(writer: ByteBuffer) -> BufferedBytesWriter:
    return make_buffered_bytes_writer(BUFFERED_BYTES_TARGET_BUFFER, writer.handle, DEFAULT_CHUNK_SIZE)

fn buffered_bytes_writer_chunked(writer: ByteBuffer, chunk_size: Int) -> BufferedBytesWriter:
    return make_buffered_bytes_writer(BUFFERED_BYTES_TARGET_BUFFER, writer.handle, chunk_size)

fn buffered_string_reader(reader: StringReader) -> BufferedStringReader:
    return buffered_string_reader_chunked(reader, DEFAULT_CHUNK_SIZE)

fn buffered_string_reader_chunked(reader: StringReader, chunk_size: Int) -> BufferedStringReader:
    return BufferedStringReader(allocate_buffered_string_reader_handle(reader.handle, chunk_size))

fn buffered_string_writer(writer: StringBuffer) -> BufferedStringWriter:
    return buffered_string_writer_chunked(writer, DEFAULT_CHUNK_SIZE)

fn buffered_string_writer_chunked(writer: StringBuffer, chunk_size: Int) -> BufferedStringWriter:
    return BufferedStringWriter(allocate_buffered_string_writer_handle(writer.handle, chunk_size))

fn buffered_tcp_stream(stream: TcpStream) -> BufferedTcpStream:
    return buffered_tcp_stream_chunked(stream, DEFAULT_CHUNK_SIZE)

fn buffered_tcp_stream_chunked(stream: TcpStream, chunk_size: Int) -> BufferedTcpStream:
    return BufferedTcpStream(allocate_buffered_tcp_stream_handle(stream.fd, chunk_size))

fn buffered_tcp_writer(writer: TcpStream) -> BufferedTcpWriter:
    return buffered_tcp_writer_chunked(writer, DEFAULT_CHUNK_SIZE)

fn buffered_tcp_writer_chunked(writer: TcpStream, chunk_size: Int) -> BufferedTcpWriter:
    return BufferedTcpWriter(allocate_buffered_tcp_writer_handle(writer.fd, chunk_size))

fn buffered_file_reader(stream: FileStream) -> BufferedFileReader:
    return buffered_file_reader_chunked(stream, DEFAULT_CHUNK_SIZE)

fn buffered_file_reader_chunked(stream: FileStream, chunk_size: Int) -> BufferedFileReader:
    return BufferedFileReader(allocate_buffered_file_reader_handle(stream.handle, chunk_size))

fn buffered_file_writer(stream: FileStream) -> BufferedFileWriter:
    return buffered_file_writer_chunked(stream, DEFAULT_CHUNK_SIZE)

fn buffered_file_writer_chunked(stream: FileStream, chunk_size: Int) -> BufferedFileWriter:
    return BufferedFileWriter(allocate_buffered_file_writer_handle(stream.handle, chunk_size))

fn buffered_process_stdout(reader: ProcessStdout) -> BufferedProcessStdout:
    return buffered_process_stdout_chunked(reader, DEFAULT_CHUNK_SIZE)

fn buffered_process_stdout_chunked(reader: ProcessStdout, chunk_size: Int) -> BufferedProcessStdout:
    return BufferedProcessStdout(allocate_buffered_process_stdout_handle(reader.handle, chunk_size))

fn buffered_process_stderr(reader: ProcessStderr) -> BufferedProcessStderr:
    return buffered_process_stderr_chunked(reader, DEFAULT_CHUNK_SIZE)

fn buffered_process_stderr_chunked(reader: ProcessStderr, chunk_size: Int) -> BufferedProcessStderr:
    return BufferedProcessStderr(allocate_buffered_process_stderr_handle(reader.handle, chunk_size))

fn buffered_bytes_reader_from_tcp(stream: TcpStream, chunk_size: Int) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_TCP, stream.fd, chunk_size)

fn buffered_bytes_writer_to_tcp(stream: TcpStream, chunk_size: Int) -> BufferedBytesWriter:
    return make_buffered_bytes_writer(BUFFERED_BYTES_TARGET_TCP, stream.fd, chunk_size)

fn buffered_bytes_reader_from_file(stream: FileStream, chunk_size: Int) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_FILE, stream.handle, chunk_size)

fn buffered_bytes_writer_to_file(stream: FileStream, chunk_size: Int) -> BufferedBytesWriter:
    return make_buffered_bytes_writer(BUFFERED_BYTES_TARGET_FILE, stream.handle, chunk_size)

fn buffered_bytes_reader_from_stdout(reader: ProcessStdout, chunk_size: Int) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_PROCESS_STDOUT, reader.handle, chunk_size)

fn buffered_bytes_reader_from_stderr(reader: ProcessStderr, chunk_size: Int) -> BufferedBytesReader:
    return make_buffered_bytes_reader(BUFFERED_BYTES_SOURCE_PROCESS_STDERR, reader.handle, chunk_size)

fn buffered_bytes_writer_to_stdin(writer: ProcessStdin, chunk_size: Int) -> BufferedBytesWriter:
