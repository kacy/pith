# metrics with no instrumentation code, from std.web.
#
# an app built with web.new() wraps every route in a middleware that counts
# requests, tracks the ones in flight and times them, labeled by method, route
# pattern and status. it also serves GET /metrics in the prometheus text
# format. the handlers below contain no metrics code; main sends a few
# requests and then reads the counters back the way a scraper would.

import std.net.http as http
import std.net.tcp as tcp
import std.web as web

PORT := 18099

fn greet(req: web.Request) -> http.HttpResponse:
    return http.text(200, "hi, {req.query_or("name", "world")}")

fn order(req: web.Request) -> http.HttpResponse:
    id := parse_int(req.param("id")) catch:
        return http.bad_request_response()
    return http.text(200, "order {id}")

fn build_app() -> web.App:
    mut app := web.new()
    app = app.get("/greet", greet)
    app = app.get("/orders/:id", order)
    return app

fn serve(port: Int) -> Int:
    return build_app().listen("127.0.0.1", port) catch 0

# connect until the accept loop answers, rather than sleeping for a guess.
fn wait_until_listening(port: Int) -> Bool:
    for attempt in 0..500:
        probe := tcp.connect("127.0.0.1", port) catch:
            sleep(10)
            continue
        tcp.close(probe)
        return true
    return false

fn fetch(path: String) -> String:
    resp := http.get_request("127.0.0.1", PORT, path).send() catch:
        return ""
    return resp.body_text() catch ""

# the value of the request counter whose labels are exactly `labels`.
fn request_count(metrics: String, labels: String) -> String:
    series := "http_server_requests_total{{{labels}}} "
    for line in metrics.split("\n"):
        if line.starts_with(series):
            return line.substring(series.len(), line.len())
    return "0"

fn main() -> Int!:
    spawn serve(PORT)
    if not wait_until_listening(PORT):
        fail "the server never came up"

    for name in ["ada", "grace", "edsger"]:
        print(fetch("/greet?name={name}"))
    for id in ["17", "18", "nineteen"]:
        print(fetch("/orders/{id}"))

    # the route label is the pattern, so /orders/17 and /orders/18 are one
    # series and the label set stays small however many orders there are.
    metrics := fetch("/metrics")
    print("")
    print("GET /greet 200:       {request_count(metrics, "method=\"GET\",route=\"/greet\",status=\"200\"")}")
    print("GET /orders/:id 200:  {request_count(metrics, "method=\"GET\",route=\"/orders/:id\",status=\"200\"")}")
    print("GET /orders/:id 400:  {request_count(metrics, "method=\"GET\",route=\"/orders/:id\",status=\"400\"")}")
    return 0
