# std.net.grpc — a minimal unary grpc client and server over pith's native http/2.
#
# grpc is http/2 with a fixed message framing and a status carried in the
# trailers. a unary call POSTs to /<package>.<Service>/<Method> with
# content-type application/grpc, sends one length-prefixed protobuf message as
# the request body, and reads one length-prefixed message back plus a
# grpc-status trailer.
#
# this layer handles the transport and the message framing; it moves raw message
# bytes. build the request and parse the response with std.protobuf (bytes in,
# bytes out), which keeps grpc usable without code generation:
#
#   w := protobuf.writer()
#   w.write_string(1, "pith")!            # DummyMessage { f_string = 1 }
#   reply := grpc.call("grpcb.in", 9001, "/grpcbin.GRPCBin/DummyUnary", w.bytes())!
#   w.free()
#   r := protobuf.reader(reply)           # the echoed DummyMessage
#   ...
#
# call() opens a connection, runs one method, and closes. for several calls,
# dial() a channel once and reuse it — each unary() multiplexes over the one
# http/2 connection:
#
#   ch := grpc.dial("grpcb.in", 9001)!
#   reply := ch.unary("/grpcbin.GRPCBin/DummyUnary", request)!
#   ch.close()
#
# to serve, write a dispatch handler — (path, request bytes) -> reply bytes, or a
# GrpcError — and hand it to serve() or serve_tls(). the server routes each call
# by its /<package>.<Service>/<Method> path to the handler and sends the reply
# back with the grpc-status trailer:
#
#   fn greeter(path, request) -> Bytes!grpc.GrpcError:
#       name := read_name(request) catch "world"
#       return encode_reply("hello, " + name)
#
#   grpc.serve("0.0.0.0", 50051, greeter)!               # plaintext http/2
#   grpc.serve_tls("0.0.0.0", 443, cert, key, greeter)!  # http/2 over tls
#
# dial a plaintext server with dial_h2c (no tls); dial a tls server with dial or
# dial_with_config.
#
# the handler lives in a module global, so there is one grpc server per process —
# the usual shape, one service binary per endpoint. that is a deliberate limit: a
# pith closure cannot capture a fn-value, so the handler cannot be threaded in any
# other way.
#
# serving a streaming rpc: serve_body/serve_body_tls take a BODY-level dispatch
# — raw framed bytes in and out — so one dispatch can carry unary and buffered
# streaming methods side by side, in either direction (unframe_messages /
# frame_messages / frame_one do the framing). the generated serve_<Service> uses
# this for all four rpc shapes. buffered means the whole request and reply pass
# through memory — right for bounded streams, wrong for interactive or endless
# ones.
#
# for those, serve_stream/serve_stream_tls take a STREAM-level dispatch: the
# handler receives a live GrpcStream and can recv_message() and send_message()
# incrementally — reply to message 1 before the client sends message 2. see the
# streaming server section below. the generated stubs stay on the buffered path;
# serve_stream is the hand-written escape hatch.
#
# deadlines and metadata: a client attaches metadata (unary_with_headers, the
# *_with_headers stream openers) and a deadline (unary_with_deadline) to a call;
# a server dispatch reads them back with incoming_metadata() and
# incoming_deadline_ms(), and a request whose deadline is already spent on
# arrival is answered DEADLINE_EXCEEDED without running the handler. initial
# (request) metadata only — trailing metadata is not supported.
#
# deferred: message compression, trailing metadata, mid-handler deadline
# cancellation, and grpc-message percent-decoding.

import std.net.http2.hpack as hpack
import std.net.http2.connection as http2
import std.net.http2.server as h2server
import std.net.http as http
import std.protobuf as protobuf
import std.bytes as bytes
import std.bits as bits
import std.encoding as encoding
import std.resilience as resilience
import std.net.tls as tls
import std.trace as trace
import std.metrics as metrics
import std.time as time
import std.shutdown as shutdown

# grpc status codes (the grpc-status trailer). 0 is success; the rest are
# errors. see https://grpc.io/docs/guides/status-codes/.
pub GRPC_OK := 0
pub GRPC_CANCELLED := 1
pub GRPC_UNKNOWN := 2
pub GRPC_INVALID_ARGUMENT := 3
pub GRPC_DEADLINE_EXCEEDED := 4
pub GRPC_NOT_FOUND := 5
pub GRPC_ALREADY_EXISTS := 6
pub GRPC_PERMISSION_DENIED := 7
pub GRPC_RESOURCE_EXHAUSTED := 8
pub GRPC_FAILED_PRECONDITION := 9
pub GRPC_ABORTED := 10
pub GRPC_OUT_OF_RANGE := 11
pub GRPC_UNIMPLEMENTED := 12
pub GRPC_INTERNAL := 13
pub GRPC_UNAVAILABLE := 14
pub GRPC_DATA_LOSS := 15
pub GRPC_UNAUTHENTICATED := 16

# the grpc-message a peer reads when a graceful shutdown closed its stream rather
# than the handler doing so. it rides on GRPC_UNAVAILABLE, the code a grpc client
# retries — exactly right during a rolling deploy, where the replacement instance
# is already accepting. see the drain section near serve_stream.
pub SHUTTING_DOWN := "grpc: server is shutting down"

# how long a send onto an already-closed stream parks before reporting 0. it is
# backpressure for a loop that has stopped listening, not a delay any working
# handler ever pays: a stream is only closed underneath a handler that ignored
# the shutdown flag, and by then the process is on its way out.
CLOSED_STREAM_PARK_MS := 1

# the status codes worth retrying: the ones that describe the service's
# moment rather than the request's content. UNAVAILABLE is the transport
# code and what a server says mid-restart; RESOURCE_EXHAUSTED and ABORTED
# clear on their own. everything else fails the same way every time.
pub fn retryable_code(code: Int) -> Bool:
    return code == GRPC_UNAVAILABLE or code == GRPC_RESOURCE_EXHAUSTED or code == GRPC_ABORTED

# a failed grpc call: the numeric grpc-status and the server's message.
pub struct GrpcError:
    pub status: Int
    pub message: String

# the grpc-status code names, indexed by code, built once at module load —
# finish_client_span reads this table several times per RPC on the metrics
# path, so a per-call rebuild of the 17 strings was pure waste (the same
# reason REQUEST_HEADERS is cached below).
GRPC_STATUS_NAMES := ["OK", "CANCELLED", "UNKNOWN", "INVALID_ARGUMENT", "DEADLINE_EXCEEDED", "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED", "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE", "DATA_LOSS", "UNAUTHENTICATED"]

# the human name of a grpc-status code, for error messages and logging.
pub fn status_name(status: Int) -> String:
    if status >= 0 and status < GRPC_STATUS_NAMES.len():
        return GRPC_STATUS_NAMES[status]
    return "CODE_{status}"

# a grpc channel: a reusable connection to one server. dial() opens it, unary()
# runs a method over it — as many as you like, multiplexed over the one http/2
# connection — and close() shuts it down. `authority` is the server host, which
# grpc uses to address the service.
pub struct Conn:
    client: http2.Client
    authority: String
    # metadata sent on every call over this channel — credentials, usually.
    # set_credentials fills it; empty means the channel adds nothing.
    credentials: List[String]

# an empty credential list, typed for the Conn field.
fn no_credentials() -> List[String]:
    out: List[String] := []
    return out

impl Conn:
    ## send `metadata` — flat key, value, key, value — on every call over this
    ## channel, so a credential is attached once at dial instead of threaded
    ## through every call site:
    ##
    ##   conn := grpc.dial_h2c("localhost", 50051)!
    ##   conn.set_credentials(["authorization", "Bearer " + token])
    ##
    ## this mutates the channel rather than returning a configured copy: two
    ## Conn values sharing one http/2 client would each close it. per-call
    ## metadata still goes through the *_with_headers forms, and is appended
    ## after these, so a call can add to them but not silently drop them.
    pub fn set_credentials(metadata: List[String]):
        self.credentials = metadata

    # this channel's credentials followed by `extra`, which is what every call
    # actually sends.
    fn call_metadata(extra: List[String]) -> List[String]:
        if self.credentials.len() == 0:
            return extra
        mut out: List[String] := []
        for item in self.credentials:
            out.push(item)
        for item in extra:
            out.push(item)
        return out

    # run a unary rpc over this channel. `full_method` is "/package.Service/Method"
    # and `request` is the serialized protobuf request message; the returned bytes
    # are the serialized response message. fails with a GrpcError on a non-OK
    # grpc-status, a malformed response, or a transport error.
    pub fn unary(full_method: String, request: Bytes) -> Bytes!GrpcError:
        no_metadata: List[String] := []
        return self.unary_with_headers_and_deadline(full_method, request, no_metadata, 0)!

    # like unary, but retried under `policy` when the failure is one worth
    # retrying: UNAVAILABLE (the transport-error code, and what a server says
    # while restarting), RESOURCE_EXHAUSTED, and ABORTED. anything else — a
    # deadline, a bad argument, an application error — propagates on the
    # first attempt. the backoff curve is std.resilience's.
    pub fn unary_retry(full_method: String, request: Bytes, policy: resilience.Retry) -> Bytes!GrpcError:
        mut tries := 0
        while true:
            result := self.unary(full_method, request)
            if result.is_ok:
                return result.ok
            if not retryable_code(result.err.status):
                fail result.err
            tries = tries + 1
            if tries >= policy.attempts:
                fail result.err
            sleep(policy.delay_ms(tries))
        fail GrpcError(GRPC_UNKNOWN, "unreachable")

    # like unary, but also sends `extra_headers` — a flat [k1, v1, k2, v2, ...]
    # list — as grpc metadata: custom http/2 request headers layered on top of the
    # standard grpc set. this is how a caller passes auth/tenant credentials (e.g.
    # an api key) to a collector. an empty list behaves exactly like unary.
    pub fn unary_with_headers(full_method: String, request: Bytes, extra_headers: List[String]) -> Bytes!GrpcError:
        return self.unary_with_headers_and_deadline(full_method, request, extra_headers, 0)!

    # like unary, but with a deadline: the call sends a grpc-timeout header so
    # the server can stop working once the time is up, and the client itself
    # gives up after `timeout_ms` milliseconds, failing with
    # GRPC_DEADLINE_EXCEEDED. a timeout of zero (or less) means no deadline.
    pub fn unary_with_deadline(full_method: String, request: Bytes, timeout_ms: Int) -> Bytes!GrpcError:
        no_metadata: List[String] := []
        return self.unary_with_headers_and_deadline(full_method, request, no_metadata, timeout_ms)!

    # the full unary form: metadata and a deadline together. the other unary
    # methods are shorthands for this one.
    pub fn unary_with_headers_and_deadline(full_method: String, request: Bytes, extra_headers: List[String], timeout_ms: Int) -> Bytes!GrpcError:
        if not trace.is_active():
            framed := frame_message(request)
            fields := with_timeout_header(with_metadata(grpc_headers(), self.call_metadata(extra_headers)), timeout_ms)
            resp := self.client.request_with_timeout("POST", self.authority, full_method, fields, framed, timeout_ms)
            if resp.is_err:
                fail transport_error(resp.err)
            return handle_response(resp.ok)!
        # observability on: a CLIENT span, a traceparent injected into the request
        # headers, and RED metrics — all invisible to the caller.
        span := trace.start_kind(full_method, trace.CLIENT)
        span.set_attr("rpc.system", "grpc").set_attr("rpc.method", full_method)
        framed := frame_message(request)
        started := time.mono_nanos()
        fields := with_timeout_header(with_metadata(headers_with_traceparent(span.context()), self.call_metadata(extra_headers)), timeout_ms)
        resp := self.client.request_with_timeout("POST", self.authority, full_method, fields, framed, timeout_ms)
        if resp.is_err:
            err := transport_error(resp.err)
            finish_client_span(span, full_method, err.status, started)
            fail err
        result := handle_response(resp.ok)
        mut status := GRPC_OK
        if result.is_err:
            status = result.err.status
        finish_client_span(span, full_method, status, started)
        return result!

    # close the underlying http/2 connection. the channel cannot be used after.
    pub fn close():
        self.client.close()

# dial a grpc server: open an http/2 connection to host:port over tls with alpn
# "h2" and return a reusable channel. reuse it for many unary() calls and
# close() it when done.
pub fn dial(host: String, port: Int) -> Conn!:
    client := http2.open(host, port)!
    return Conn(client: client, authority: host, credentials: no_credentials())

# dial a grpc server using the caller's tls `config` (which must offer alpn
# "h2") — for example one built with tls.client_config_with_ca_file to trust a
# private ca, for a server whose cert the system roots don't cover. otherwise
# like dial.
pub fn dial_with_config(host: String, port: Int, config: tls.Config) -> Conn!:
    client := http2.open_with_config(host, port, config)!
    return Conn(client: client, authority: host, credentials: no_credentials())

# dial a grpc server over plaintext http/2 (h2c) — no tls. matches a server
# started with grpc.serve. use this for local or trusted-network endpoints; for
# anything public, dial over tls. otherwise like dial.
pub fn dial_h2c(host: String, port: Int) -> Conn!:
    client := http2.open_h2c(host, port)!
    return Conn(client: client, authority: host, credentials: no_credentials())

# make a one-shot unary call: dial host:port, run the method, and close. this is
# the simplest entry point; for several calls over one connection, dial() a
# channel once and reuse it with unary().
pub fn call(host: String, port: Int, full_method: String, request: Bytes) -> Bytes!GrpcError:
    opened := dial(host, port)
    if opened.is_err:
        fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot connect to {host}:{port}: {opened.err}")
    channel := opened.ok
    result := channel.unary(full_method, request)
    channel.close()
    return result!

# --- framing ----------------------------------------------------------------

# the request headers every grpc call sends alongside the four http/2
# pseudo-headers. they are the same on every call, so they are built once and
# shared — the request path only reads them (it copies each field into its own
# list), so a single cached list saves four header allocations per call.
REQUEST_HEADERS := [hpack.header_field("content-type", "application/grpc"), hpack.header_field("te", "trailers"), hpack.header_field("grpc-encoding", "identity"), hpack.header_field("grpc-accept-encoding", "identity")]

fn grpc_headers() -> List[hpack.HeaderField]:
    return REQUEST_HEADERS

# the base grpc headers plus `extra` metadata (a flat [k1, v1, k2, v2, ...] list)
# appended as http/2 header fields. an empty list returns `base` unchanged so the
# common no-metadata call keeps sharing the cached header list; otherwise a fresh
# list is built so the cached one is never mutated. an odd trailing key with no
# value is ignored.
fn with_metadata(base: List[hpack.HeaderField], extra: List[String]) -> List[hpack.HeaderField]:
    if extra.len() == 0:
        return base
    mut fields: List[hpack.HeaderField] := []
    for f in base:
        fields.push(f)
    mut i := 0
    while i + 1 < extra.len():
        fields.push(hpack.header_field(extra[i], extra[i + 1]))
        i = i + 2
    return fields

# `fields` plus a grpc-timeout header carrying `timeout_ms` in the canonical
# wire form. zero (or less) means no deadline and returns `fields` unchanged;
# otherwise a fresh list is built so a shared base list is never mutated.
fn with_timeout_header(fields: List[hpack.HeaderField], timeout_ms: Int) -> List[hpack.HeaderField]:
    if timeout_ms <= 0:
        return fields
    mut out: List[hpack.HeaderField] := []
    for f in fields:
        out.push(f)
    out.push(hpack.header_field("grpc-timeout", format_grpc_timeout(timeout_ms)))
    return out

# a grpc-timeout value may carry at most eight digits, in any of six units.
GRPC_TIMEOUT_MAX_VALUE := 99999999

# format a timeout for the grpc-timeout request header: a value of one to eight
# digits followed by a unit. milliseconds ("m") cover everything realistic; a
# timeout too large for eight digits of millis falls back to whole seconds
# ("S"), clamped at the eight-digit ceiling (~3 years).
pub fn format_grpc_timeout(timeout_ms: Int) -> String:
    if timeout_ms <= GRPC_TIMEOUT_MAX_VALUE:
        return "{timeout_ms}m"
    mut secs := timeout_ms / 1000
    if secs > GRPC_TIMEOUT_MAX_VALUE:
        secs = GRPC_TIMEOUT_MAX_VALUE
    return "{secs}S"

# parse a grpc-timeout header value into milliseconds: one to eight digits and
# a unit — H hours, M minutes, S seconds, m millis, u micros, n nanos. sub-
# millisecond values round down, so "1u" is 0 ms (a deadline already due).
# anything malformed is none — the caller treats the request as having no
# deadline rather than inventing one.
pub fn parse_grpc_timeout(text: String) -> Int?:
    if text.len() < 2 or text.len() > 9:
        return none
    raw := bytes.from_string_utf8(text)
    mut value := 0
    mut i := 0
    while i < raw.len() - 1:
        c := raw[i]
        if c < 48 or c > 57:
            return none
        value = (value * 10) + (c - 48)
        i = i + 1
    unit := raw[raw.len() - 1]
    if unit == 72: # 'H'
        return value * 3600000
    if unit == 77: # 'M'
        return value * 60000
    if unit == 83: # 'S'
        return value * 1000
    if unit == 109: # 'm'
        return value
    if unit == 117: # 'u'
        return value / 1000
    if unit == 110: # 'n'
        return value / 1000000
    return none

# map a transport-level failure to the grpc error a caller sees: the http/2
# client's deadline error becomes GRPC_DEADLINE_EXCEEDED, anything else is
# GRPC_UNAVAILABLE.
fn transport_error(detail: String) -> GrpcError:
    if detail == http2.REQUEST_DEADLINE_EXCEEDED:
        return GrpcError(GRPC_DEADLINE_EXCEEDED, "grpc: deadline exceeded")
    return GrpcError(GRPC_UNAVAILABLE, "grpc transport error: {detail}")

# the standard grpc headers plus a W3C traceparent for `ctx`, so the server joins
# this trace. builds a fresh list rather than pushing onto the shared cached one.
fn headers_with_traceparent(ctx: trace.SpanContext) -> List[hpack.HeaderField]:
    mut fields: List[hpack.HeaderField] := []
    for f in grpc_headers():
        fields.push(f)
    fields.push(hpack.header_field("traceparent", trace.format_traceparent(ctx)))
    return fields

# the headers for a streaming open: the base grpc headers, plus a traceparent
# carrying the current trace context when one is active — so a streaming rpc
# started inside a span propagates it. off (or no active span) => base headers.
fn stream_headers() -> List[hpack.HeaderField]:
    if not trace.is_active():
        return grpc_headers()
    ctx := trace.current_context()
    if not trace.context_is_valid(ctx):
        return grpc_headers()
    return headers_with_traceparent(ctx)

# set a grpc client span's status from the grpc-status, end it, and record the RED
# metrics (a request counter and a duration histogram) for the call.
fn finish_client_span(span: trace.Span, full_method: String, status: Int, start_ns: Int):
    if status == GRPC_OK:
        span.set_status(trace.STATUS_OK, "")
    else:
        span.set_status(trace.STATUS_ERROR, status_name(status))
    span.set_attr("rpc.grpc.status_code", status.to_string())
    span.end()
    elapsed_ms := (time.mono_nanos() - start_ns) / 1000000
    metrics.counter("rpc_client_requests_total").labels(["rpc_method", full_method, "grpc_status", status_name(status)]).inc()
    metrics.histogram("rpc_client_duration_ms").labels(["rpc_method", full_method]).observe(elapsed_ms.to_float())

# frame a message for the wire: a one-byte compression flag (0 = identity), a
# big-endian uint32 length, then the message bytes. the five prefix bytes are
# written directly rather than through an intermediate list. writes to a fresh
# in-memory buffer cannot fail, so their results are discarded.
fn frame_message(message: Bytes) -> Bytes:
    buf := bytes.buffer()
    n := message.len()
    buf.write_byte(0) catch 0
    buf.write_byte(bits.band(bits.shr(n, 24), 255)) catch 0
    buf.write_byte(bits.band(bits.shr(n, 16), 255)) catch 0
    buf.write_byte(bits.band(bits.shr(n, 8), 255)) catch 0
    buf.write_byte(bits.band(n, 255)) catch 0
    if n > 0:
        buf.write(message) catch 0
    out := buf.bytes()
    buf.free()
    return out

# read one length-prefixed message out of a response body: skip the flag, read
# the big-endian length, and return the message bytes. compression is rejected.
fn parse_message(body: Bytes) -> Bytes!GrpcError:
    if body.len() < 5:
        fail GrpcError(GRPC_INTERNAL, "grpc response frame is shorter than its five-byte header")
    if body[0] != 0:
        fail GrpcError(GRPC_UNIMPLEMENTED, "grpc message compression is not supported")
    length := read_u32(body, 1)
    if 5 + length > body.len():
        fail GrpcError(GRPC_INTERNAL, "grpc response frame length runs past the body")
    return body.slice(5, 5 + length)

# read a big-endian uint32 from `data` at `off`.
fn read_u32(data: Bytes, off: Int) -> Int:
    return bits.bor(bits.bor(bits.shl(data[off], 24), bits.shl(data[off + 1], 16)), bits.bor(bits.shl(data[off + 2], 8), data[off + 3]))

# --- response handling ------------------------------------------------------

# turn a completed http/2 response into the grpc result: the response message
# bytes on OK, or a GrpcError carrying the server's status and message.
fn handle_response(response: http2.Response) -> Bytes!GrpcError:
    return grpc_result(response.status, response.headers, response.trailers, response.body)!

# the core of handle_response, over the response parts directly, so it can be
# driven in tests without constructing a transport Response.
fn grpc_result(http_status: Int, headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField], body: Bytes) -> Bytes!GrpcError:
    status := status_from(headers, trailers, http_status)
    if status != GRPC_OK:
        fail GrpcError(status, message_from(headers, trailers))
    return parse_message(body)!

# the grpc-status: from the trailers if present, else the initial headers (a
# trailers-only error response), else derived from the http status (grpc
# requires 200, so anything else is an error).
fn status_from(headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField], http_status: Int) -> Int:
    if has_header(trailers, "grpc-status"):
        return parse_status(find_header(trailers, "grpc-status"))
    if has_header(headers, "grpc-status"):
        return parse_status(find_header(headers, "grpc-status"))
    if http_status != 200:
        return GRPC_UNKNOWN
    return GRPC_OK

# the grpc-message (the human-readable error detail), from the trailers or the
# initial headers; "" when the server sends none. the value arrives
# percent-encoded, so it is decoded back to the text the server wrote.
fn message_from(headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField]) -> String:
    message := find_header(trailers, "grpc-message")
    if message != "":
        return percent_decode(message)
    return percent_decode(find_header(headers, "grpc-message"))

# grpc-message is percent-encoded on the wire (grpc's PROTOCOL-HTTP2): printable
# ascii passes through, everything else — including the CR, LF, and NUL that
# RFC 9113 §8.2.1 forbids in a field value, and any byte of a utf8 message —
# becomes %XX. without this a handler that puts a newline or a non-ascii
# character in an error message writes a field value a compliant client must
# reject, which turns a readable error into a broken response.
fn percent_encode(text: String) -> String:
    hex_digits := bytes.from_string_utf8("0123456789ABCDEF")
    # appending to the result string one character at a time recopied the
    # whole accumulated string on every append, which made encoding quadratic
    # in the message; a byte buffer keeps each append constant.
    out := bytes.buffer_with_capacity(text.len())
    defer out.free()
    mut i := 0
    while i < text.len():
        c := text[i]
        # ord is signed, so a utf8 continuation byte comes back negative; mask
        # it to the 0-255 the escape needs.
        code := bits.band(ord(c), 255)
        if code >= 32 and code <= 126 and c != "%":
            out.write_byte(code)
        else:
            out.write_byte(37)
            out.write_byte(hex_digits[code / 16])
            out.write_byte(hex_digits[code % 16])
        i = i + 1
    # every byte written above is printable ascii or an ascii escape, so the
    # decode cannot fail; an empty result would be a visible total failure
    # rather than a silently wrong encoding.
    return out.bytes().to_string_utf8() catch ""

# the inverse. a malformed escape is left as written rather than dropped, so a
# server that never encoded its message still reads back as itself.
fn percent_decode(text: String) -> String:
    # collect the pieces and join once at the end: appending each character
    # to the result string recopied everything accumulated so far, which made
    # decoding quadratic in the message. a list survives a decoded byte that
    # is not valid utf-8, which a byte-buffer round-trip through utf-8
    # validation would not.
    mut parts: List[String] := []
    mut i := 0
    while i < text.len():
        if text[i] == "%" and i + 2 < text.len():
            high := percent_nibble(text[i + 1])
            low := percent_nibble(text[i + 2])
            if high >= 0 and low >= 0:
                parts.push(chr(high * 16 + low))
                i = i + 3
            else:
                parts.push(text[i])
                i = i + 1
        else:
            parts.push(text[i])
            i = i + 1
    return parts.join("")

fn percent_nibble(c: String) -> Int:
    if c >= "0" and c <= "9":
        return ord(c) - 48
    if c >= "a" and c <= "f":
        return ord(c) - 97 + 10
    if c >= "A" and c <= "F":
        return ord(c) - 65 + 10
    return 0 - 1

# parse a decimal grpc-status value; an empty or non-numeric value reads as 0.
fn parse_status(text: String) -> Int:
    digits := bytes.from_string_utf8(text)
    mut value := 0
    mut i := 0
    while i < digits.len():
        c := digits[i]
        if c < 48 or c > 57:
            return value
        value = (value * 10) + (c - 48)
        i = i + 1
    return value

# the value of a header field by name, or "" when absent.
fn find_header(fields: List[hpack.HeaderField], name: String) -> String:
    for f in fields:
        if f.name == name:
            return f.value
    return ""

# whether a header field is present.
fn has_header(fields: List[hpack.HeaderField], name: String) -> Bool:
    for f in fields:
        if f.name == name:
            return true
    return false

# --- streaming --------------------------------------------------------------

# the largest single message a deframer will reassemble. the frame header can
# declare up to 4 GiB, and a peer that declares a huge length and then dribbles
# the body makes the receiver buffer toward that number long before it can tell
# the message will never arrive. 4 MiB is grpc's own default receive limit.
pub MAX_MESSAGE_BYTES := 4194304

# a grpc message deframer: incoming DATA chunks arrive on arbitrary boundaries,
# so it accumulates bytes and hands back complete length-prefixed messages
# ([1-byte compression flag][4-byte big-endian length][message]) one at a time.
# a chunk may hold zero, one, or many messages, and a message may span chunks.
pub struct Deframer:
    mut buf: Bytes
    mut pos: Int

# a fresh, empty deframer.
pub fn new_deframer() -> Deframer:
    return Deframer(bytes.empty(), 0)

impl Deframer:
    # add a chunk of received bytes. drops the already-consumed prefix first so
    # the buffer stays bounded across a long stream.
    pub fn push(chunk: Bytes):
        if self.pos > 0:
            self.buf = self.buf.slice(self.pos, self.buf.len())
            self.pos = 0
        if chunk.len() > 0:
            self.buf = bytes.concat(self.buf, chunk)

    # the message length from the buffered header, or -1 if the header is not
    # complete yet.
    fn header_length() -> Int:
        if self.buf.len() - self.pos < 5:
            return -1
        return read_u32(self.buf, self.pos + 1)

    # whether next() can be called: either a complete message is buffered, or
    # the header declares one too large to accept. an over-limit message counts
    # as ready so the caller drains it and gets the error from next(), rather
    # than buffering toward a length that was never going to be allowed.
    pub fn ready() -> Bool:
        length := self.header_length()
        if length < 0:
            return false
        if length > MAX_MESSAGE_BYTES:
            return true
        return self.buf.len() - self.pos >= 5 + length

    # bytes buffered but not yet consumed. after draining every ready() message,
    # a non-zero remainder is a partial frame — the sender either truncated the
    # body or framed it wrong, which callers reject rather than silently drop.
    pub fn remaining() -> Int:
        return self.buf.len() - self.pos

    # take the next complete message and advance past it. precondition: ready().
    # fails if the message is larger than MAX_MESSAGE_BYTES, or if it is flagged
    # compressed, which this implementation does not read.
    pub fn next() -> Bytes!GrpcError:
        # the size limit is checked before the compression flag, the order grpc
        # itself uses. it matters for bytes that were never framed at all: any
        # leading byte reads as "compressed", so checking the flag first would
        # answer "compression unsupported" for plain garbage.
        length := self.header_length()
        if length > MAX_MESSAGE_BYTES:
            fail GrpcError(GRPC_RESOURCE_EXHAUSTED, "grpc: message of {length} bytes exceeds the {MAX_MESSAGE_BYTES}-byte receive limit")
        if self.buf[self.pos] != 0:
            fail GrpcError(GRPC_UNIMPLEMENTED, "grpc message compression is not supported")
        msg := self.buf.slice(self.pos + 5, self.pos + 5 + length)
        self.pos = self.pos + 5 + length
        return msg

# one step of a streaming read: `done` is false with the next response `message`,
# or true (with an empty message) once the server has finished the stream.
pub struct StreamMessage:
    pub done: Bool
    pub message: Bytes

# the response-decoding state of a streaming rpc, fed one http/2 stream event at
# a time: a deframer that reassembles messages from DATA chunks, plus the
# response's initial headers and trailers so the terminal grpc-status can be read
# when the stream ends. transport-independent — a live stream and the offline
# tests both drive it the same way.
pub struct StreamReader:
    mut deframer: Deframer
    mut done: Bool
    mut headers: List[hpack.HeaderField]
    mut trailers: List[hpack.HeaderField]

fn new_stream_reader() -> StreamReader:
    empty: List[hpack.HeaderField] := []
    return StreamReader(new_deframer(), false, empty, empty)

impl StreamReader:
    # apply one stream event: a HEADERS block is stored as the response headers or,
    # if it carries grpc-status, the trailers; a DATA chunk feeds the deframer; a
    # RESET fails. an event with `end` finishes the stream.
    fn feed(ev: http2.StreamEvent) -> Int!GrpcError:
        if ev.is_reset():
            fail GrpcError(GRPC_INTERNAL, "grpc: stream reset (error code {ev.error_code})")
        if ev.is_headers():
            if has_header(ev.headers, "grpc-status"):
                self.trailers = ev.headers
            else:
                self.headers = ev.headers
            if ev.end:
                self.done = true
        elif ev.is_data():
            if ev.data.len() > 0:
                self.deframer.push(ev.data)
            if ev.end:
                self.done = true
        return 0

    fn ready() -> Bool:
        return self.deframer.ready()

    fn take() -> Bytes!GrpcError:
        return self.deframer.next()!

    fn finished() -> Bool:
        return self.done

    # the terminal grpc-status, from the trailers (or the initial headers / the
    # http status), read once the stream has finished.
    fn final_status() -> Int:
        mut http_status := parse_status(find_header(self.headers, ":status"))
        if http_status == 0:
            http_status = 200
        return status_from(self.headers, self.trailers, http_status)

    fn final_message() -> String:
        return message_from(self.headers, self.trailers)

# pull one message from an in-progress stream: hand back a buffered message if the
# reader has one, else read stream events until a message completes or the stream
# ends. a StreamMessage with `done` true (empty) marks the end; a non-OK terminal
# grpc-status or a reset fails. shared by server-, and bidi-streaming recv.
fn recv_stream_message(stream: http2.Stream, reader: StreamReader) -> StreamMessage!GrpcError:
    while true:
        if reader.ready():
            return StreamMessage(false, reader.take()!)
        if reader.finished():
            status := reader.final_status()
            if status != GRPC_OK:
                fail GrpcError(status, reader.final_message())
            return StreamMessage(true, bytes.empty())
        evr := stream.recv()
        if evr.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: connection closed mid-stream")
        reader.feed(evr.ok)!
    return StreamMessage(true, bytes.empty())

# frame `message` and send it on `stream` without ending the stream. shared by
# client- and bidi-streaming send. returns the byte count the transport queued;
# a broken connection surfaces on the receive side, not here.
fn send_framed_message(stream: http2.Stream, message: Bytes) -> Int:
    return stream.send(frame_message(message), false)

# half-close the send side: a lone empty DATA frame with END_STREAM, telling the
# server no more request messages follow.
fn half_close_stream(stream: http2.Stream) -> Int:
    return stream.send(bytes.empty(), true)

# a server-streaming call in progress: one request was sent, and recv() pulls the
# response messages as they arrive. `reader` decodes the responses from the
# incremental stream events.
pub struct ServerStream:
    stream: http2.Stream
    reader: StreamReader

impl ServerStream:
    # pull the next response message. returns a StreamMessage whose `done` is
    # false with the message, or true (empty) once the server has finished. fails
    # with a GrpcError if the terminal grpc-status is not OK or the stream resets.
    pub fn recv() -> StreamMessage!GrpcError:
        return recv_stream_message(self.stream, self.reader)!

impl Conn:
    # open a server-streaming rpc: send one request message, then read the stream
    # of responses. `full_method` is "/package.Service/Method". call recv() on the
    # returned ServerStream to pull response messages until it reports done; a
    # non-OK grpc-status surfaces as a GrpcError from recv().
    pub fn server_stream(full_method: String, request: Bytes) -> ServerStream!GrpcError:
        no_metadata: List[String] := []
        return self.server_stream_with_headers(full_method, request, no_metadata)!

    # like server_stream, but also sends `extra_headers` — a flat [k1, v1, ...]
    # list — as grpc metadata, the same shape unary_with_headers takes.
    pub fn server_stream_with_headers(full_method: String, request: Bytes, extra_headers: List[String]) -> ServerStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, with_metadata(stream_headers(), extra_headers), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        stream := opened.ok
        stream.send(frame_message(request), true)
        return ServerStream(stream, new_stream_reader())

# collect every message of a server-streaming response into a list, failing on a
# non-OK grpc-status. a convenience for callers that want the whole stream.
pub fn collect_server_stream(stream: ServerStream) -> List[Bytes]!GrpcError:
    mut out: List[Bytes] := []
    while true:
        step := stream.recv()!
        if step.done:
            return out
        out.push(step.message)
    return out

# a client-streaming call in progress: the client sends a sequence of request
# messages with send(), calls close_send() to finish sending, then reads the one
# response with recv_response().
pub struct ClientStream:
    stream: http2.Stream
    reader: StreamReader

impl ClientStream:
    # send one request message. call as many times as needed before close_send().
    pub fn send(message: Bytes) -> Int:
        return send_framed_message(self.stream, message)

    # finish sending: half-close the stream so the server knows the request
    # sequence is complete. call recv_response() after this.
    pub fn close_send() -> Int:
        return half_close_stream(self.stream)

    # read the single response message and the terminal grpc-status. fails with a
    # GrpcError on a non-OK status, a reset, or if the server sent no message.
    pub fn recv_response() -> Bytes!GrpcError:
        mut message := bytes.empty()
        mut got := false
        while true:
            step := recv_stream_message(self.stream, self.reader)!
            if step.done:
                if not got:
                    fail GrpcError(GRPC_INTERNAL, "grpc: client-streaming response carried no message")
                return message
            message = step.message
            got = true
        return message

# a bidirectional-streaming call in progress. the send side (send/close_send) and
# the receive side (recv) are independent — send goes through the connection's
# writer task, recv reads this stream's own event channel — so a caller may drive
# them from two tasks: spawn a sender while the main task recvs.
pub struct BidiStream:
    stream: http2.Stream
    reader: StreamReader

impl BidiStream:
    # send one request message.
    pub fn send(message: Bytes) -> Int:
        return send_framed_message(self.stream, message)

    # finish sending: half-close so the server sees the end of the request stream.
    # the receive side stays open until the server finishes its own stream.
    pub fn close_send() -> Int:
        return half_close_stream(self.stream)

    # pull the next response message: a StreamMessage with `done` false and the
    # message, or true (empty) once the server has finished. fails on a non-OK
    # terminal grpc-status or a reset.
    pub fn recv() -> StreamMessage!GrpcError:
        return recv_stream_message(self.stream, self.reader)!

impl Conn:
    # open a client-streaming rpc: send a sequence of request messages, then read
    # one response. `full_method` is "/package.Service/Method". send() each
    # request, close_send() to finish, then recv_response().
    pub fn client_stream(full_method: String) -> ClientStream!GrpcError:
        no_metadata: List[String] := []
        return self.client_stream_with_headers(full_method, no_metadata)!

    # like client_stream, but also sends `extra_headers` as grpc metadata.
    pub fn client_stream_with_headers(full_method: String, extra_headers: List[String]) -> ClientStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, with_metadata(stream_headers(), extra_headers), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        return ClientStream(opened.ok, new_stream_reader())

    # open a bidirectional-streaming rpc: send and receive message streams
    # independently. `full_method` is "/package.Service/Method". send()/close_send()
    # drive the request stream, recv() drains the response stream — the two can run
    # in separate tasks.
    pub fn bidi_stream(full_method: String) -> BidiStream!GrpcError:
        no_metadata: List[String] := []
        return self.bidi_stream_with_headers(full_method, no_metadata)!

    # like bidi_stream, but also sends `extra_headers` as grpc metadata.
    pub fn bidi_stream_with_headers(full_method: String, extra_headers: List[String]) -> BidiStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, with_metadata(stream_headers(), extra_headers), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        return BidiStream(opened.ok, new_stream_reader())

# ----------------------------------------------------------------------------

fn trailer(status: Int) -> List[hpack.HeaderField]:
    return [hpack.header_field("grpc-status", "{status}")]

test "with_metadata appends extra pairs after the base grpc headers":
    extra := ["x-api-key", "secret", "x-tenant", "acme"]
    fields := with_metadata(grpc_headers(), extra)
    # the four cached grpc headers come first, then the two metadata pairs.
    assert_eq(fields.len(), grpc_headers().len() + 2)
    assert_eq(find_header(fields, "x-api-key"), "secret")
    assert_eq(find_header(fields, "x-tenant"), "acme")
    # the standard grpc headers are still present.
    assert_eq(find_header(fields, "content-type"), "application/grpc")

test "with_metadata returns the base list unchanged when there is no metadata":
    empty: List[String] := []
    fields := with_metadata(grpc_headers(), empty)
    # no extra headers: unary's byte-identical behavior is preserved.
    assert_eq(fields.len(), grpc_headers().len())

test "with_metadata ignores a trailing key that has no value":
    fields := with_metadata(grpc_headers(), ["x-only-key"])
    assert_eq(fields.len(), grpc_headers().len())

test "with_timeout_header appends grpc-timeout and leaves the base list alone":
    fields := with_timeout_header(grpc_headers(), 1500)
    assert_eq(fields.len(), grpc_headers().len() + 1)
    assert_eq(find_header(fields, "grpc-timeout"), "1500m")
    # the shared cached header list was copied, not mutated.
    assert(not has_header(grpc_headers(), "grpc-timeout"))

test "with_timeout_header without a deadline returns the base list unchanged":
    assert_eq(with_timeout_header(grpc_headers(), 0).len(), grpc_headers().len())

test "format_grpc_timeout uses millis up to eight digits then whole seconds":
    assert_eq(format_grpc_timeout(1500), "1500m")
    assert_eq(format_grpc_timeout(99999999), "99999999m")
    # nine digits of millis no longer fit; fall back to seconds.
    assert_eq(format_grpc_timeout(100000000), "100000S")
    # a value too large even in seconds clamps at the eight-digit ceiling.
    assert_eq(format_grpc_timeout(999999999999999), "99999999S")

test "parse_grpc_timeout reads every unit into milliseconds":
    assert_eq(parse_grpc_timeout("1H")?, 3600000)
    assert_eq(parse_grpc_timeout("2M")?, 120000)
    assert_eq(parse_grpc_timeout("3S")?, 3000)
    assert_eq(parse_grpc_timeout("1500m")?, 1500)
    assert_eq(parse_grpc_timeout("2000u")?, 2)
    assert_eq(parse_grpc_timeout("5000000n")?, 5)
    # sub-millisecond values round down: due immediately.
    assert_eq(parse_grpc_timeout("1u")?, 0)
    assert_eq(parse_grpc_timeout("999999n")?, 0)

test "parse_grpc_timeout rejects garbage":
    assert(parse_grpc_timeout("") == none)
    assert(parse_grpc_timeout("m") == none)
    assert(parse_grpc_timeout("15x") == none)
    assert(parse_grpc_timeout("15") == none)
    assert(parse_grpc_timeout("1a4m") == none)
    # nine digits exceed the eight-digit cap.
    assert(parse_grpc_timeout("123456789m") == none)

test "a message frames with a zero flag and a big-endian length":
    framed := frame_message(encoding.from_hex("089601")!)
    assert_eq(encoding.to_hex(framed), "0000000003089601")

test "an empty message frames to just the five-byte header":
    assert_eq(encoding.to_hex(frame_message(bytes.empty())), "0000000000")

test "parse_message round-trips a framed message":
    payload := encoding.from_hex("08961a")!
    assert_eq(parse_message(frame_message(payload))!, payload)

test "parse_message rejects a truncated frame":
    result := parse_message(encoding.from_hex("000000")!)
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_INTERNAL)

test "parse_message rejects a compressed frame":
    result := parse_message(encoding.from_hex("0100000000")!)
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNIMPLEMENTED)

test "parse_status reads a decimal grpc-status":
    assert_eq(parse_status("0"), 0)
    assert_eq(parse_status("5"), 5)
    assert_eq(parse_status("16"), 16)
    assert_eq(parse_status(""), 0)

test "status_name maps the standard codes":
    assert_eq(status_name(GRPC_OK), "OK")
    assert_eq(status_name(GRPC_NOT_FOUND), "NOT_FOUND")
    assert_eq(status_name(GRPC_UNAUTHENTICATED), "UNAUTHENTICATED")

test "an OK response yields the message bytes":
    message := encoding.from_hex("0a0470697468")!
    assert_eq(grpc_result(200, [], trailer(GRPC_OK), frame_message(message))!, message)

test "a non-OK grpc-status becomes a typed error":
    trailers := [hpack.header_field("grpc-status", "5"), hpack.header_field("grpc-message", "missing")]
    result := grpc_result(200, [], trailers, bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_NOT_FOUND)
    assert_eq(result.err.message, "missing")

test "a trailers-only error is read from the initial headers":
    headers := [hpack.header_field("grpc-status", "12")]
    result := grpc_result(200, headers, [], bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNIMPLEMENTED)

test "a non-200 response without a grpc-status is an error":
    result := grpc_result(502, [], [], bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNKNOWN)

test "a protobuf request round-trips through grpc framing":
    w := protobuf.writer()
    w.write_string(1, "pith")!
    request := w.bytes()
    w.free()

    # the server echoes: frame the request as if it were the response body.
    reply := grpc_result(200, [], trailer(GRPC_OK), frame_message(request))!

    r := protobuf.reader(reply)
    tag := r.read_tag()!
    assert_eq(tag.field, 1)
    assert_eq(r.read_string()!, "pith")

test "a private-ca h2 config builds for the dial_with_config path":
    # the config dial_with_config (and http2.open_with_config) accept: trust a
    # private ca from a file and offer alpn "h2". this is what lets a grpc client
    # reach a server whose cert the system roots don't cover — e.g. a local
    # benchmark server. a live dial with it is exercised in tests/live.
    cfg := tls.client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!.with_alpn(["h2"])
    # a real config has a non-negative handle; the error sentinels are negative.
    assert(cfg.handle >= 0)

# --- deframer ---------------------------------------------------------------

test "deframer yields a single message from one push":
    d := new_deframer()
    msg := encoding.from_hex("0a03616263")!
    d.push(frame_message(msg))
    assert(d.ready())
    assert_eq(d.next()!, msg)
    assert(not d.ready())

test "deframer yields two messages from one push":
    d := new_deframer()
    a := encoding.from_hex("01")!
    b := encoding.from_hex("0203")!
    d.push(bytes.concat(frame_message(a), frame_message(b)))
    assert(d.ready())
    assert_eq(d.next()!, a)
    assert(d.ready())
    assert_eq(d.next()!, b)
    assert(not d.ready())

test "deframer reassembles a message split across two pushes":
    d := new_deframer()
    framed := frame_message(encoding.from_hex("deadbeef")!)
    d.push(framed.slice(0, 3))
    assert(not d.ready())
    d.push(framed.slice(3, framed.len()))
    assert(d.ready())
    assert_eq(d.next()!, encoding.from_hex("deadbeef")!)

test "deframer waits for a five-byte prefix split across pushes":
    d := new_deframer()
    framed := frame_message(encoding.from_hex("ff")!)
    d.push(framed.slice(0, 2))
    assert(not d.ready())
    d.push(framed.slice(2, framed.len()))
    assert(d.ready())
    assert_eq(d.next()!, encoding.from_hex("ff")!)

test "deframer handles an empty message":
    d := new_deframer()
    d.push(frame_message(bytes.empty()))
    assert(d.ready())
    assert_eq(d.next()!.len(), 0)
    assert(not d.ready())

test "deframer rejects a compressed message":
    d := new_deframer()
    d.push(encoding.from_hex("010000000155")!)
    assert(d.ready())
    assert(d.next().is_err)

# --- server-stream reader ---------------------------------------------------

test "stream reader deframes messages across events then reads OK status":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200"), hpack.header_field("content-type", "application/grpc")], false))!
    r.feed(http2.data_event(frame_message(encoding.from_hex("0a0161")!), false))!
    assert(r.ready())
    assert_eq(r.take()!, encoding.from_hex("0a0161")!)
    framed := frame_message(encoding.from_hex("0a0263")!)
    r.feed(http2.data_event(framed.slice(0, 3), false))!
    assert(not r.ready())
    r.feed(http2.data_event(framed.slice(3, framed.len()), false))!
    assert(r.ready())
    assert_eq(r.take()!, encoding.from_hex("0a0263")!)
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

test "stream reader surfaces a non-OK trailer status":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "5"), hpack.header_field("grpc-message", "gone")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_NOT_FOUND)
    assert_eq(r.final_message(), "gone")

test "stream reader treats a reset as an error":
    r := new_stream_reader()
    assert(r.feed(http2.reset_event(8)).is_err)

# --- client / bidi shapes ---------------------------------------------------

test "client-stream reader yields one response then finishes OK":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    msg := encoding.from_hex("0a0470697468")!
    r.feed(http2.data_event(frame_message(msg), false))!
    assert(r.ready())
    assert_eq(r.take()!, msg)
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

test "bidi reader deframes several echoed messages in order":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    a := encoding.from_hex("0a0161")!
    b := encoding.from_hex("0a0162")!
    c := encoding.from_hex("0a0163")!
    r.feed(http2.data_event(frame_message(a), false))!
    r.feed(http2.data_event(frame_message(b), false))!
    r.feed(http2.data_event(frame_message(c), false))!
    assert(r.ready())
    assert_eq(r.take()!, a)
    assert(r.ready())
    assert_eq(r.take()!, b)
    assert(r.ready())
    assert_eq(r.take()!, c)
    assert(not r.ready())
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

# a pool of n grpc channels to the same server, each its own http/2 connection.
# a single channel's reader/writer pipeline is ~one-core-bound, so concurrent
# rpcs spread round-robin across the pool run on separate cores (the same reason
# real grpc clients open multiple subchannels). use it in place of a single
# dial() channel for many concurrent calls; keep n at or below the core count
# for a throughput gain. close() shuts every channel down.
pub struct PoolConn:
    conns: List[Conn]
    mut next: Int
    pick: Mutex

impl PoolConn:
    # the index of the next channel, round-robin, safe across concurrent callers.
    fn choose() -> Int:
        self.pick.lock()
        i := self.next
        self.next = (self.next + 1) % self.conns.len()
        self.pick.unlock()
        return i

    # unary rpc over the next pooled channel; see Conn.unary.
    pub fn unary(full_method: String, request: Bytes) -> Bytes!GrpcError:
        return self.conns[self.choose()].unary(full_method, request)

    # server-streaming rpc over the next pooled channel; see Conn.server_stream.
    pub fn server_stream(full_method: String, request: Bytes) -> ServerStream!GrpcError:
        return self.conns[self.choose()].server_stream(full_method, request)

    # client-streaming rpc over the next pooled channel; see Conn.client_stream.
    pub fn client_stream(full_method: String) -> ClientStream!GrpcError:
        return self.conns[self.choose()].client_stream(full_method)

    # bidi-streaming rpc over the next pooled channel; see Conn.bidi_stream.
    pub fn bidi_stream(full_method: String) -> BidiStream!GrpcError:
        return self.conns[self.choose()].bidi_stream(full_method)

    # the number of channels in the pool.
    pub fn size() -> Int:
        return self.conns.len()

    # the i-th channel. hand a long-lived task its own channel with this (rather
    # than sharing the pool across tasks) so each task's calls stay on one
    # connection's pipeline.
    pub fn at(i: Int) -> Conn:
        return self.conns[i]

    # close every pooled channel.
    pub fn close():
        for c in self.conns:
            c.close()

# dial a pool of n grpc channels to host:port (each its own http/2 connection
# over tls, alpn "h2"). issue concurrent rpcs across it to use multiple cores;
# n above the core count gives no further gain. close() shuts them all down.
pub fn dial_pool(host: String, port: Int, n: Int) -> PoolConn!:
    mut conns: List[Conn] := []
    mut i := 0
    while i < n:
        conns.push(dial(host, port)!)
        i = i + 1
    return PoolConn(conns: conns, next: 0, pick: Mutex())

# like dial_pool but dialing each channel with the caller's tls `config` (which
# must offer alpn "h2") — e.g. one trusting a private ca.
pub fn dial_pool_with_config(host: String, port: Int, n: Int, config: tls.Config) -> PoolConn!:
    mut conns: List[Conn] := []
    mut i := 0
    while i < n:
        conns.push(dial_with_config(host, port, config)!)
        i = i + 1
    return PoolConn(conns: conns, next: 0, pick: Mutex())

# --- server ---
#
# serving grpc reuses the http/2 server: a grpc call is an http/2 POST to
# /pkg.Service/Method carrying a length-prefixed message, answered with a
# length-prefixed reply and a grpc-status trailer. serve() wraps the http/2
# server with a handler that deframes the request, dispatches by path, frames
# the reply, and sets the trailer.
#
# the dispatch fn lives in a module global because a pith closure cannot capture
# a fn-value, so there is one grpc server per process — the common case, one
# service binary per endpoint. a generated <Service>Server provides the dispatch
# (routing each path to a typed handler); a hand-written server can match paths
# itself.

GRPC_CONTENT_TYPE := "application/grpc"

# --- request context: metadata and deadline ---
#
# a dispatch handler is a module-global fn-value, so per-request data cannot be
# threaded through its signature without breaking every server and generated
# stub already written against it. instead each serve handler stashes the
# request's metadata and deadline in threadlocal slots just before invoking the
# dispatch, and the dispatch reads them back with incoming_metadata() /
# incoming_deadline_ms(). threadlocal storage is per-task under the green
# runtime and per-os-thread otherwise (where every task is its own thread), and
# each request runs handler-plus-dispatch on its own task, so concurrent
# requests never see each other's context.

threadlocal mut current_metadata: Map[String, String] := {}
threadlocal mut current_deadline: Int := 0

# the metadata of the request currently being dispatched: its custom request
# headers, lowercase-keyed, minus the transport headers (host, content-type,
# te, user-agent) and the reserved grpc-* set. valid inside a dispatch handler;
# empty outside one.
pub fn incoming_metadata() -> Map[String, String]:
    return current_metadata

# the absolute deadline of the request currently being dispatched, as a
# time.mono_millis() timestamp — compare against time.mono_millis() for the
# time remaining. 0 when the client sent no grpc-timeout (or none parsed).
pub fn incoming_deadline_ms() -> Int:
    return current_deadline

# whether `name` (already lowercase) is a header the transport or grpc itself
# owns, and so never surfaces as caller metadata.
fn is_reserved_metadata_key(name: String) -> Bool:
    if name.starts_with("grpc-"):
        return true
    return name == "host" or name == "content-type" or name == "te" or name == "user-agent"

# the caller metadata carried in a request's headers.
fn request_metadata(req: http.HttpRequestBytes) -> Map[String, String]:
    mut out: Map[String, String] := {}
    for key in req.header_map:
        name := key.to_lower()
        if not is_reserved_metadata_key(name):
            out.insert(name, req.header_map[key])
    return out

# the request's grpc-timeout in milliseconds, or none when the header is
# absent or malformed (a malformed value reads as no deadline — the safe
# direction, since inventing one would fail valid requests).
fn request_timeout_ms(req: http.HttpRequestBytes) -> Int?:
    text := req.header_or("grpc-timeout", "")
    if text == "":
        return none
    return parse_grpc_timeout(text)

# stash the request context for the dispatch about to run. returns true when
# the request's deadline had already expired on arrival, in which case the
# caller answers DEADLINE_EXCEEDED without invoking the handler at all.
# expiry is judged from the parsed timeout itself, not the stored timestamp:
# time.mono_millis() reads 0 in the process's first millisecond, and a
# timestamp of 0 must keep meaning "no deadline".
fn begin_request_context(req: http.HttpRequestBytes) -> Bool:
    current_metadata = request_metadata(req)
    current_deadline = 0
    parsed_timeout := request_timeout_ms(req)
    if parsed_timeout == none:
        return false
    remaining := parsed_timeout.unwrap_or(0)
    current_deadline = time.mono_millis() + remaining
    return remaining <= 0

# the message sent when a request arrives with its deadline already spent.
EXPIRED_ON_ARRIVAL := "grpc: deadline expired before the handler ran"

# the trailers-only DEADLINE_EXCEEDED response for the buffered serve paths.
fn expired_response() -> http.HttpResponse:
    return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(GRPC_DEADLINE_EXCEEDED, EXPIRED_ON_ARRIVAL))

# the process-wide unary dispatch, and the same for the body-level and streaming
# forms further down. all three are shared and unlocked, and safe because of
# where they are written: each is assigned as the first statement of the serve()
# call that installs it, and that call then blocks in the accept loop for the
# life of the process. so the write happens before the listener exists, let
# alone the first request task, and nothing writes them again. the cost is one
# dispatch per process — two concurrent serve() calls would fight over the slot,
# which is the same single-handler constraint std.net.http2.server documents for
# its streaming handler.
mut grpc_dispatch_fn: fn(String, Bytes) -> Bytes!GrpcError := grpc_no_dispatch

fn grpc_no_dispatch(path: String, request: Bytes) -> Bytes!GrpcError:
    fail GrpcError(GRPC_UNIMPLEMENTED, "no grpc dispatch registered")

fn grpc_ok_trailers() -> Map[String, String]:
    mut t: Map[String, String] := {}
    t.insert("grpc-status", GRPC_OK.to_string())
    return t

fn grpc_status_trailers(status: Int, message: String) -> Map[String, String]:
    mut t: Map[String, String] := {}
    t.insert("grpc-status", status.to_string())
    if message.len() > 0:
        t.insert("grpc-message", percent_encode(message))
    return t

# extract the single request message from a unary request body (one
# length-prefixed frame). an all-default proto3 message can arrive as an empty
# body, which decodes to a default message.
fn grpc_unframe_unary(body: Bytes) -> Bytes!GrpcError:
    # an all-default proto3 message encodes to no bytes, and a peer may send it
    # as an empty body: that is the one case where "nothing" is a valid message.
    if body.len() == 0:
        return bytes.empty()
    d := new_deframer()
    d.push(body)
    if not d.ready():
        # a body that is not a complete frame is malformed — truncated, or a
        # length prefix that overruns what was sent. answering OK with an empty
        # message would let corrupt input look like a successful default-valued
        # call, so reject it.
        fail GrpcError(GRPC_INVALID_ARGUMENT, "grpc: truncated request message frame")
    msg := d.next()!
    if d.remaining() > 0:
        fail GrpcError(GRPC_INVALID_ARGUMENT, "grpc: unary request carried more than one message")
    return msg

# the http/2 handler that turns one unary grpc request into one grpc response.
fn grpc_serve_handler(req: http.HttpRequestBytes) -> http.HttpResponse:
    path := req.path() catch ""
    if begin_request_context(req):
        return expired_response()
    request := grpc_unframe_unary(req.body_bytes())
    if request.is_err:
        # report the framing error's own status: a malformed frame is the
        # caller's fault (INVALID_ARGUMENT), not a server fault, and a
        # compressed message is UNIMPLEMENTED. reporting INTERNAL for all of
        # them told a client to retry a request that will never succeed.
        return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(request.err.status, request.err.message))
    result := grpc_dispatch_fn(path, request.ok)
    if result.is_err:
        return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(result.err.status, result.err.message))
    framed := frame_message(result.ok)
    return http.response(200).content_type(GRPC_CONTENT_TYPE).with_body_bytes(framed).with_trailers(grpc_ok_trailers())

# --- interceptors -------------------------------------------------------------
#
# an interceptor wraps a dispatch the way a std.web middleware wraps a route
# handler: it takes the rest of the chain (`next`) plus the call, so it can run
# code before or after it, or answer the call itself without invoking next at
# all. compose them with intercept() and hand the result to any serve form —
# the dispatch signature does not change, so a generated <Svc> router or a
# hand-written dispatch both drop straight in.
#
#   fn log_calls(next: fn(String, Bytes) -> Bytes!grpc.GrpcError, path: String, request: Bytes) -> Bytes!grpc.GrpcError:
#       print(path)
#       return next(path, request)
#
#   guarded := grpc.intercept(serve_Chat, [grpc.authorize(check_token), log_calls])
#   grpc.serve("0.0.0.0", 50051, guarded)!
#
# the first interceptor in the list runs outermost, so it sees the call first
# and the reply last — the ordering std.web's use_mw promises.
#
# an interceptor that refuses a call returns refuse(status, message) instead of
# failing directly: a pith lambda can neither `fail` nor use `!`, so the refusal
# is built by a named helper and returned as a value. the ready-made
# interceptors below are shaped that way for the same reason.

## the refusal an interceptor returns instead of calling next: a failed result
## carrying `status` and `message`, which the server sends back as the call's
## grpc-status and grpc-message.
##
##   if not limiter.allow():
##       return grpc.refuse(grpc.GRPC_RESOURCE_EXHAUSTED, "rate limited")
pub fn refuse(status: Int, message: String) -> Bytes!GrpcError:
    fail GrpcError(status, message)

# the pieces the chain runner walks. bundling them in a struct lets the `next`
# closure below capture one struct value and an index rather than the bare
# interceptor and dispatch fn-values — the same reason std.web's Chain exists.
struct Chain:
    interceptors: List[fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError]
    dispatch: fn(String, Bytes) -> Bytes!GrpcError

# run the onion from `index` inward: call interceptors[index] with a `next` that
# recurses one level deeper, and when we run past the end, call the dispatch.
# the `next` lambda only forwards the result — it never unwraps one — because a
# lambda cannot use `!`.
fn run_chain(chain: Chain, index: Int, path: String, request: Bytes) -> Bytes!GrpcError:
    if index >= chain.interceptors.len():
        return chain.dispatch(path, request)!
    interceptor := chain.interceptors[index]
    next := fn(p: String, r: Bytes) => run_chain(chain, index + 1, p, r)
    return interceptor(next, path, request)!

## wrap `dispatch` in `interceptors` and return the composed dispatch. the
## first interceptor in the list runs outermost. an empty list returns a
## dispatch that behaves exactly like the one passed in.
pub fn intercept(dispatch: fn(String, Bytes) -> Bytes!GrpcError, interceptors: List[fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError]) -> fn(String, Bytes) -> Bytes!GrpcError:
    chain := Chain(interceptors, dispatch)
    return fn(path: String, request: Bytes) => run_chain(chain, 0, path, request)

# what authorize() carries: capturing the verifier inside a struct rather than
# as a bare fn-value keeps the closure on the shape the compiler handles.
struct Authorizer:
    verify: fn(Map[String, String]) -> Bool

## an interceptor that authorizes every call from its metadata. `verify` gets
## the caller's metadata — the headers the client attached, minus the ones grpc
## and the transport own — and returns whether the call may proceed; a refusal
## is UNAUTHENTICATED and never reaches the dispatch.
##
## this is the transport-level hook: it runs before any method body, so one
## interceptor covers every rpc a server exposes.
##
##   fn check_token(md: Map[String, String]) -> Bool:
##       return jwt.verify_hs256(grpc.bearer_token(md), SECRET).is_ok
##
##   grpc.serve(host, port, grpc.intercept(serve_Chat, [grpc.authorize(check_token)]))!
pub fn authorize(verify: fn(Map[String, String]) -> Bool) -> fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError:
    guard := Authorizer(verify)
    return fn(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes):
        if not guard.verify(incoming_metadata()):
            return refuse(GRPC_UNAUTHENTICATED, "unauthenticated")
        return next(path, request)

## the bearer token in `metadata`, or "" when the authorization entry is absent
## or is not a bearer credential. the scheme is matched case-insensitively, as
## rfc 7235 requires; the token itself is returned untouched.
pub fn bearer_token(metadata: Map[String, String]) -> String:
    value := metadata.get("authorization").unwrap_or("")
    if value.len() < 7:
        return ""
    # the scheme name is ascii by rfc 7235, and the value is whatever a client
    # sent. comparing bytes avoids slicing 7 bytes off a value whose first
    # character is multi-byte, which is a cut through the middle of it.
    mut position := 0
    expected := "bearer "
    while position < 7:
        mut got := bit_and(ord(value[position]), 255)
        if got >= 65 and got <= 90:
            got = got + 32
        if got != bit_and(ord(expected[position]), 255):
            return ""
        position = position + 1
    return value.substring(7, value.len())

## an interceptor that spends one token from `limiter` per call and answers
## RESOURCE_EXHAUSTED when the bucket is empty. build one limiter and share it:
## every serving task drains the same bucket, so the cap holds for the whole
## server no matter how many connections are open. the same limiter can guard
## an http surface through web.rate_limit.
##
##   limiter := resilience.rate_limiter(100, 20)
##   grpc.serve(host, port, grpc.intercept(serve_Chat, [grpc.rate_limit(limiter)]))!
pub fn rate_limit(limiter: resilience.Limiter) -> fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError:
    return fn(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes):
        if not limiter.allow():
            return refuse(GRPC_RESOURCE_EXHAUSTED, "rate limited")
        return next(path, request)

## an interceptor that runs calls through a circuit breaker. a dispatch failure
## that is the server's own fault — INTERNAL, UNAVAILABLE, DATA_LOSS, or an
## expired deadline — trips the breaker; a caller's fault (NOT_FOUND, an invalid
## argument, a refused credential) does not, because a client sending bad
## requests is not a reason to stop serving good ones. while the circuit is
## open, callers get UNAVAILABLE immediately instead of waiting on a dependency
## that is already drowning.
##
##   breaker := resilience.circuit_breaker(5, 10_000)
##   grpc.serve(host, port, grpc.intercept(serve_Chat, [grpc.circuit(breaker)]))!
pub fn circuit(breaker: resilience.Breaker) -> fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError:
    return fn(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes):
        if not breaker.allow():
            return refuse(GRPC_UNAVAILABLE, "circuit open")
        result := next(path, request)
        if result.is_err and server_fault(result.err.status):
            breaker.failure()
        else:
            breaker.success()
        return result

## whether `status` names a failure the server is responsible for, and so one
## worth counting against a circuit breaker. a caller's own error is not.
pub fn server_fault(status: Int) -> Bool:
    return status == GRPC_INTERNAL or status == GRPC_UNAVAILABLE or status == GRPC_DATA_LOSS or status == GRPC_DEADLINE_EXCEEDED

# serve grpc over plaintext http/2 (h2c). blocks, accepting connections. the
# `dispatch` maps a full method path (/pkg.Service/Method) and the request
# message bytes to the response message bytes, or a GrpcError.
#
# every serve entry point below rides the http/2 server's accept loop, so they
# all inherit its graceful shutdown: once std.shutdown.request() runs (from a
# SIGTERM, say), the listener stops accepting and this returns after the
# in-flight rpcs finish or the grace period expires. the return value is the
# work still unfinished at that point, 0 for a clean drain. an rpc in progress
# is never severed by the drain itself — which for a streaming method means the
# stream runs to its trailers rather than dying mid-exchange.
pub fn serve(host: String, port: Int, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_dispatch_fn = dispatch
    return h2server.listen_h2c(host, port, grpc_serve_handler)!

# serve grpc over http/2 with tls (alpn "h2"). drains on shutdown like serve().
pub fn serve_tls(host: String, port: Int, cert: String, key: String, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_dispatch_fn = dispatch
    return h2server.listen_h2_tls(host, port, cert, key, grpc_serve_handler)!

# --- body-level serving (streaming-capable dispatch) --------------------------
#
# serve() deframes one request message and frames one reply — the unary shape. a
# streaming rpc is the same http/2 exchange with more frames in the body: a
# server-streaming reply is N framed messages concatenated, a client-streaming
# request likewise. so a dispatch that works on the RAW framed body can serve
# every buffered shape; it deframes what it expects and frames what it returns
# (unframe_messages / frame_messages below). the generated <Svc> router uses
# this, deframing per method. buffered means the whole request and reply pass
# through memory — the right tool for bounded streams, not endless ones.
#
# an endless stream and a graceful shutdown are in tension: the drain waits for
# the connection to end, and a stream that never ends outlasts any grace period.
# such a handler should watch std.shutdown.requested() and finish its stream
# when it goes true, rather than relying on the deadline to cut it off.

# installed by serve_body / serve_body_tls; see grpc_dispatch_fn above for why
# this needs no lock.
mut grpc_body_dispatch_fn: fn(String, Bytes) -> Bytes!GrpcError := grpc_no_dispatch

fn grpc_serve_body_handler(req: http.HttpRequestBytes) -> http.HttpResponse:
    path := req.path() catch ""
    if begin_request_context(req):
        return expired_response()
    result := grpc_body_dispatch_fn(path, req.body_bytes())
    if result.is_err:
        return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(result.err.status, result.err.message))
    return http.response(200).content_type(GRPC_CONTENT_TYPE).with_body_bytes(result.ok).with_trailers(grpc_ok_trailers())

# the most messages a buffered request stream will hold. a 10 MiB body of
# five-byte empty frames is two million messages, and each one costs a list slot
# and a Bytes header on top of its payload — a request that is small on the wire
# turning into hundreds of megabytes of handler input. 64k is far more than a
# buffered rpc has any reason to send; a client with more should stream.
pub MAX_STREAM_MESSAGES := 65536

# deframe every length-prefixed message in a request body. an empty body is a
# valid empty stream (and, for unary, an all-default proto3 message).
pub fn unframe_messages(body: Bytes) -> List[Bytes]!GrpcError:
    mut out: List[Bytes] := []
    d := new_deframer()
    d.push(body)
    while d.ready():
        if out.len() >= MAX_STREAM_MESSAGES:
            fail GrpcError(GRPC_RESOURCE_EXHAUSTED, "grpc: request stream carries more than {MAX_STREAM_MESSAGES} messages")
        out.push(d.next()!)
    if d.remaining() > 0:
        # leftover bytes that never completed a frame: the body was truncated or
        # mis-framed. dropping them silently would hand the handler a short
        # stream and report success.
        fail GrpcError(GRPC_INVALID_ARGUMENT, "grpc: truncated request message frame")
    return out

# frame a sequence of messages into one response body: each message
# length-prefixed, concatenated in order.
pub fn frame_messages(messages: List[Bytes]) -> Bytes:
    buf := bytes.buffer()
    for message in messages:
        framed := frame_message(message)
        buf.write(framed) catch 0
    out := buf.bytes()
    buf.free()
    return out

# frame one message — the unary reply shape, public for body-level dispatches.
pub fn frame_one(message: Bytes) -> Bytes:
    return frame_message(message)

# serve grpc over plaintext http/2 (h2c) with a body-level dispatch: `dispatch`
# receives the raw framed request body and returns the raw framed response body,
# so its methods can be unary or streaming (buffered). blocks.
pub fn serve_body(host: String, port: Int, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_body_dispatch_fn = dispatch
    return h2server.listen_h2c(host, port, grpc_serve_body_handler)!

# like serve_body, over http/2 with tls (alpn "h2").
pub fn serve_body_tls(host: String, port: Int, cert: String, key: String, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_body_dispatch_fn = dispatch
    return h2server.listen_h2_tls(host, port, cert, key, grpc_serve_body_handler)!

# --- streaming serving (incremental) ------------------------------------------
#
# the buffered paths above hold the whole request until the client half-closes,
# which makes an interactive stream impossible: the handler cannot answer message
# 1 while the client waits to send message 2. serve_stream instead hands the
# dispatch a live GrpcStream riding the h2 server's streaming path: recv_message
# deframes request messages as their DATA arrives, send_message frames and sends
# a reply immediately, and finish carries the grpc-status out in the trailers.
# any mix of the four rpc shapes works — a unary handler just recvs once and
# sends once. generated stubs do not use this path; it is the hand-written
# escape hatch for interactive and long-lived streams.

# a grpc rpc in progress on the server, handed to a serve_stream dispatch.
# receive with recv_message() until it reports done; send with send_message();
# end with finish_ok() or finish(). the response headers (":status 200",
# content-type application/grpc) go out lazily with the first send_message — so
# a handler that fails before sending anything still gets the compact
# trailers-only error response from finish().
pub struct GrpcStream:
    stream: h2server.ServerStream
    mut deframer: Deframer
    # the absolute request deadline (a time.mono_millis() timestamp, 0 = none),
    # anchored when the request arrived rather than when the handler asks.
    deadline: Int
    mut request_done: Bool
    # atomics rather than plain flags, because the drain watchdog below can close
    # a stream from another task at the same moment its handler is sending on it.
    # two header blocks, or trailers twice, is a protocol error the peer fails on;
    # a compare-and-set makes "who sends this" a decision exactly one task wins.
    sent_headers: AtomicInt
    finished: AtomicInt

# the response headers of a streaming grpc reply.
fn grpc_response_fields() -> List[hpack.HeaderField]:
    return [hpack.header_field(":status", "200"), hpack.header_field("content-type", GRPC_CONTENT_TYPE)]

# the grpc-status (and grpc-message, when non-empty) trailer fields.
fn grpc_status_fields(status: Int, message: String) -> List[hpack.HeaderField]:
    mut fields: List[hpack.HeaderField] := [hpack.header_field("grpc-status", status.to_string())]
    if message.len() > 0:
        fields.push(hpack.header_field("grpc-message", percent_encode(message)))
    return fields

impl GrpcStream:
    # the full method path of this rpc, "/package.Service/Method".
    pub fn full_method() -> String:
        return self.stream.request.path() catch ""

    # the parsed request head (headers, metadata) — the body is not in it; read
    # messages with recv_message().
    pub fn request_head() -> http.HttpRequestBytes:
        return self.stream.request

    # this rpc's caller metadata: custom request headers, lowercase-keyed, minus
    # the transport and reserved grpc-* headers.
    pub fn metadata() -> Map[String, String]:
        return request_metadata(self.stream.request)

    # this rpc's absolute deadline as a time.mono_millis() timestamp, or 0 when
    # the client sent no grpc-timeout.
    pub fn deadline_ms() -> Int:
        return self.deadline

    # whether a graceful shutdown has begun. a long-lived handler polls this
    # between messages and ends its own stream while it still can — that is the
    # only way such a stream ends on the handler's terms. everything still open
    # when the framework's half of the grace period starts is closed with
    # UNAVAILABLE instead; see the drain section below.
    pub fn closing() -> Bool:
        return shutdown.requested()

    # pull the next request message: a StreamMessage with `done` false and the
    # message bytes, or `done` true once the client has finished sending. blocks
    # until a whole message has arrived. fails with GRPC_CANCELLED if the client
    # reset the stream (or the connection dropped) — the handler should stop —
    # and with GRPC_UNAVAILABLE once a drain has taken the stream over.
    pub fn recv_message() -> StreamMessage!GrpcError:
        while true:
            if self.deframer.ready():
                return StreamMessage(false, self.deframer.next()!)
            if self.request_done:
                return StreamMessage(true, bytes.empty())
            # never park waiting on the peer once the framework's half of the
            # grace period has begun: whatever the client has not sent by then is
            # not going to arrive before the process goes, and a handler parked
            # here is a handler that cannot notice the drain at all. already-
            # buffered messages are served first, above, so nothing in hand is
            # dropped.
            if shutdown.stream_deadline_passed():
                fail GrpcError(GRPC_UNAVAILABLE, SHUTTING_DOWN)
            ev := self.stream.recv_event()
            if ev.is_reset():
                self.request_done = true
                # a drain cancels the stream to wake exactly this parked recv, so
                # during one the reset is the server's own doing, not the client's.
                if shutdown.requested():
                    fail GrpcError(GRPC_UNAVAILABLE, SHUTTING_DOWN)
                fail GrpcError(GRPC_CANCELLED, "grpc: stream reset by the client")
            if ev.is_data():
                if ev.data.len() > 0:
                    self.deframer.push(ev.data)
            # a HEADERS event after the body began is request trailers; grpc
            # requests carry nothing there, so only its end flag matters.
            if ev.end:
                self.request_done = true
        return StreamMessage(true, bytes.empty())

    # frame and send one response message, immediately — the client can read it
    # while this rpc's request stream is still open. the response headers go out
    # before the first message. returns the bytes queued for the wire, and 0 once
    # the rpc is over.
    pub fn send_message(message: Bytes) -> Int:
        # a stream a drain already closed takes no more messages: DATA after the
        # trailers is a protocol error, and the peer already has its status. a
        # handler that ignored the shutdown flag ends up here, and 0 is what tells
        # it — loudly, if it looks — that its stream is gone.
        #
        # the short park is what happens when it does not look. a send is the only
        # thing slowing down a loop like `while true: send(tick())`, and answering
        # it instantly would turn a handler that used to sit on a flow-control
        # window into one spinning a core through the rest of the shutdown.
        if self.finished.load() != 0:
            time.delay(CLOSED_STREAM_PARK_MS)
            return 0
        if self.sent_headers.compare_set(0, 1):
            self.stream.send_headers(grpc_response_fields(), false)
        return self.stream.send_data(frame_message(message), false)

    # end the rpc with `status` (and an optional message) in the trailers. after
    # a send_message this is the trailing HEADERS block; before any send it is a
    # trailers-only response, the compact error shape grpc clients expect.
    pub fn finish(status: Int, message: String):
        if not self.finished.compare_set(0, 1):
            return
        if not self.sent_headers.compare_set(0, 1):
            self.stream.send_trailers(grpc_status_fields(status, message))
            return
        mut fields := grpc_response_fields()
        for f in grpc_status_fields(status, message):
            fields.push(f)
        self.stream.send_headers(fields, true)

    # end the rpc with grpc-status 0 (OK).
    pub fn finish_ok():
        self.finish(GRPC_OK, "")

# --- closing endless streams on shutdown --------------------------------------
#
# a drain waits for work to finish, and a stream that never finishes outlasts any
# grace period: a watch or a ticker rpc would be severed mid-message when the
# process goes, and the peer would see a truncated body with no grpc-status —
# indistinguishable from a crash.
#
# so the grace period is split. the first half is the handler's: closing() goes
# true the moment a drain begins, and a handler that polls it ends its stream on
# its own terms. the second half is the framework's: every rpc still open at
# std.shutdown.stream_deadline() is finished here with UNAVAILABLE, which is the
# code a grpc client retries on — exactly right during a rolling deploy, where
# the replacement instance is already accepting. a handler that does nothing at
# all therefore still leaves its peer with a clean status.
#
# a registry is what makes that reachable. a handler asleep between two sends is
# not inside any framework call to intercept, so something else has to hold its
# stream; and one process-wide watchdog task is far cheaper than a watcher per
# rpc. the cost is a lock and a map slot per streaming rpc, on the serve_stream
# path only — the buffered serve paths hand back a whole response and cannot be
# endless.

mut live_mu := Mutex()
mut live_streams: Map[Int, GrpcStream] := {}
mut next_live_id := 0
mut closed_by_shutdown := 0
mut stream_watch_started := false

## how many rpcs a graceful shutdown had to close because their handler did not.
##
## a healthy service reports 0: every long-lived handler noticed
## GrpcStream.closing() and ended its own stream. anything else names the
## handlers to fix, and is the difference between a deploy that hands over and
## one that only looks like it did.
pub fn streams_closed_by_shutdown() -> Int:
    live_mu.lock()
    n := closed_by_shutdown
    live_mu.unlock()
    return n

# hold a live rpc for the drain watchdog, returning the ticket that releases it.
fn register_live_stream(call: GrpcStream) -> Int:
    live_mu.lock()
    id := next_live_id
    next_live_id = next_live_id + 1
    live_streams.insert(id, call)
    live_mu.unlock()
    return id

# release a ticket. a no-op when the watchdog has already taken the stream, which
# is what a handler that outlived the deadline finds on its way out.
fn forget_live_stream(id: Int):
    live_mu.lock()
    if live_streams.contains_key(id):
        live_streams.remove(id)
    live_mu.unlock()

# take every held rpc out of the registry and end it with `status`. taking them
# out first means a second sweep finds nothing, and finishing them outside the
# lock keeps a send that blocks on a flow-control window from wedging the
# handlers still trying to register and release.
fn close_live_streams(status: Int, message: String) -> Int:
    live_mu.lock()
    mut doomed: List[GrpcStream] := []
    for id in live_streams.keys():
        doomed.push(live_streams[id])
    empty: Map[Int, GrpcStream] := {}
    live_streams = empty
    closed_by_shutdown = closed_by_shutdown + doomed.len()
    live_mu.unlock()
    for call in doomed:
        call.finish(status, message)
    return doomed.len()

# park until a drain begins, leave the handlers their half of the grace period,
# then close whatever is still open with a clean status. it keeps sweeping to the
# end of the period, because a connection accepted just before the drain can
# still open a stream after it.
#
# the outer loop is for a process that resets its shutdown state and restarts its
# servers in place: a normal one exits long before the sweep is over, but one
# that lives on has to get its watchdog back.
fn stream_drain_watch():
    while true:
        mut requested := false
        while not requested:
            requested = shutdown.wait_requested(shutdown.WAKE_SLICE_MS)
        deadline := shutdown.stream_deadline()
        while time.mono_millis() < deadline:
            time.delay(shutdown.POLL_INTERVAL_MS)
        # the deadline is the midpoint, so the same distance again is the end of
        # the grace period — past which the process is going whatever anyone
        # thinks.
        give_up := deadline + shutdown.drain_deadline() / 2
        close_live_streams(GRPC_UNAVAILABLE, SHUTTING_DOWN)
        while time.mono_millis() < give_up:
            time.delay(shutdown.POLL_INTERVAL_MS)
            close_live_streams(GRPC_UNAVAILABLE, SHUTTING_DOWN)
        mut cleared := false
        while not cleared:
            time.delay(shutdown.WAKE_SLICE_MS)
            cleared = not shutdown.requested()

# start the one watchdog, once. both serve_stream entry points call it, and it
# needs no lock for the same reason the dispatch slot needs none: it runs before
# the listener exists, and the guard makes a second serve_stream a no-op.
fn start_stream_drain_watch():
    if stream_watch_started:
        return
    stream_watch_started = true
    # a bare, unqualified call so `spawn` accepts it. the task parks on the
    # shutdown flag, so under the green runtime it holds no worker.
    spawn stream_drain_watch()

# the stream dispatch lives in a module global for the same reason the unary
# dispatch does: a pith closure cannot capture a fn-value, so there is one
# streaming grpc server per process.
# installed by the streaming serve calls; see grpc_dispatch_fn above for why
# this needs no lock.
mut grpc_stream_dispatch_fn: fn(String, GrpcStream) -> Int!GrpcError := grpc_no_stream_dispatch

fn grpc_no_stream_dispatch(path: String, call: GrpcStream) -> Int!GrpcError:
    fail GrpcError(GRPC_UNIMPLEMENTED, "no grpc stream dispatch registered")

# the h2-level streaming handler: wrap the stream, dispatch by path, and make
# sure the rpc is finished when the dispatch returns — a forgotten finish would
# leave the client waiting forever. an error return becomes the grpc-status (a
# trailers-only response when nothing was sent yet); a clean return that never
# called finish gets finish_ok.
fn grpc_serve_stream_handler(stream: h2server.ServerStream) -> Int:
    expired := begin_request_context(stream.request)
    sent_headers := AtomicInt(0)
    finished := AtomicInt(0)
    call := GrpcStream(stream, new_deframer(), current_deadline, false, sent_headers, finished)
    if expired:
        call.finish(GRPC_DEADLINE_EXCEEDED, EXPIRED_ON_ARRIVAL)
        return 0
    # hold the rpc for the drain watchdog for exactly as long as it runs, so a
    # shutdown can close it even if the handler never comes back.
    live := register_live_stream(call)
    defer forget_live_stream(live)
    result := grpc_stream_dispatch_fn(call.full_method(), call)
    if result.is_err:
        call.finish(result.err.status, result.err.message)
    else:
        call.finish_ok()
    return 0

# serve grpc over plaintext http/2 (h2c) with a stream-level dispatch: `dispatch`
# receives the full method path and a live GrpcStream, and drives the rpc
# incrementally. blocks, accepting connections.
#
# drains on shutdown like serve(). a long-lived dispatch should poll
# GrpcStream.closing() between messages and finish its stream when it goes true;
# one that does not is closed with UNAVAILABLE at the midpoint of the grace
# period rather than severed at the end of it — see the drain section above.
pub fn serve_stream(host: String, port: Int, dispatch: fn(String, GrpcStream) -> Int!GrpcError) -> Int!:
    grpc_stream_dispatch_fn = dispatch
    start_stream_drain_watch()
    return h2server.listen_h2c_streaming(host, port, grpc_serve_stream_handler)!

# like serve_stream, over http/2 with tls (alpn "h2").
pub fn serve_stream_tls(host: String, port: Int, cert: String, key: String, dispatch: fn(String, GrpcStream) -> Int!GrpcError) -> Int!:
    grpc_stream_dispatch_fn = dispatch
    start_stream_drain_watch()
    return h2server.listen_h2_tls_streaming(host, port, cert, key, grpc_serve_stream_handler)!

# --- server request context --------------------------------------------------

# build a parsed request head like the h2 server hands the serve handlers, for
# driving the request-context helpers without a live connection.
fn context_test_request(timeout_value: String) -> http.HttpRequestBytes!:
    mut head := "POST /test.Svc/Method HTTP/1.1\r\nhost: example\r\ncontent-type: application/grpc\r\nte: trailers\r\nuser-agent: test-client\r\ngrpc-encoding: identity\r\nx-tenant: acme\r\nx-request-id: r1\r\n"
    if timeout_value != "":
        head = head + "grpc-timeout: " + timeout_value + "\r\n"
    head = head + "\r\n"
    return http.build_http_request(bytes.from_string_utf8(head), bytes.empty())!

test "request_metadata keeps caller headers and drops transport ones":
    md := request_metadata(context_test_request("")!)
    assert_eq(md["x-tenant"], "acme")
    assert_eq(md["x-request-id"], "r1")
    assert(not md.contains_key("host"))
    assert(not md.contains_key("content-type"))
    assert(not md.contains_key("te"))
    assert(not md.contains_key("user-agent"))
    assert(not md.contains_key("grpc-encoding"))

test "begin_request_context anchors the deadline on the monotonic clock":
    assert(not begin_request_context(context_test_request("60S")!))
    deadline := incoming_deadline_ms()
    now := time.mono_millis()
    assert(deadline > now)
    assert(deadline <= now + 60000)

test "begin_request_context stashes the context and spots a spent deadline":
    # a healthy deadline: context is visible and the request is not expired.
    assert(not begin_request_context(context_test_request("60S")!))
    assert_eq(incoming_metadata()["x-tenant"], "acme")
    assert(incoming_deadline_ms() > 0)
    # one microsecond rounds down to zero millis: expired on arrival.
    assert(begin_request_context(context_test_request("1u")!))
    # no timeout header (or a malformed one): no deadline at all.
    assert(not begin_request_context(context_test_request("")!))
    assert_eq(incoming_deadline_ms(), 0)
    assert(not begin_request_context(context_test_request("abc")!))
    assert_eq(incoming_deadline_ms(), 0)

test "grpc-message percent-encodes what a field value may not carry":
    # a newline in a field value is forbidden by RFC 9113 §8.2.1, so a handler
    # that echoes user input into an error must not put it on the wire raw.
    assert_eq(percent_encode("no such row"), "no such row")
    assert_eq(percent_encode("bad input:\nline 2"), "bad input:%0Aline 2")
    assert_eq(percent_encode("50% off"), "50%25 off")
    # a utf8 message: every byte above 0x7E escapes, so the value stays ascii
    assert_eq(percent_encode("caf" + chr(195) + chr(169)), "caf%C3%A9")

test "grpc-message decodes back to what the server wrote":
    assert_eq(percent_decode("bad input:%0Aline 2"), "bad input:\nline 2")
    assert_eq(percent_decode("50%25 off"), "50% off")
    assert_eq(percent_decode("caf%C3%A9"), "caf" + chr(195) + chr(169))
    # a server that never encoded reads back unchanged rather than losing bytes
    assert_eq(percent_decode("100% sure"), "100% sure")

test "status trailers carry the encoded message":
    fields := grpc_status_fields(GRPC_INVALID_ARGUMENT, "bad\nrequest")
    assert_eq(fields.len(), 2)
    assert_eq(fields[1].name, "grpc-message")
    assert_eq(fields[1].value, "bad%0Arequest")

test "only the transient status codes are retryable":
    assert(retryable_code(GRPC_UNAVAILABLE))
    assert(retryable_code(GRPC_RESOURCE_EXHAUSTED))
    assert(retryable_code(GRPC_ABORTED))
    assert(not retryable_code(GRPC_OK))
    assert(not retryable_code(GRPC_DEADLINE_EXCEEDED))
    assert(not retryable_code(GRPC_INVALID_ARGUMENT))
    assert(not retryable_code(GRPC_UNAUTHENTICATED))

# --- interceptor tests --------------------------------------------------------
#
# the dispatches and interceptors these use are module-level functions because
# a test block cannot declare one; they exist only for the tests below.

fn echo_dispatch(path: String, request: Bytes) -> Bytes!GrpcError:
    if path == "/x.T/Boom":
        fail GrpcError(GRPC_INTERNAL, "boom")
    if path == "/x.T/BadArg":
        fail GrpcError(GRPC_INVALID_ARGUMENT, "bad argument")
    return request

fn tag_a(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes) -> Bytes!GrpcError:
    inner := next(path, request)!
    return bytes.from_string_utf8("a(" + (inner.to_string_utf8() catch "") + ")")

fn tag_b(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes) -> Bytes!GrpcError:
    inner := next(path, request)!
    return bytes.from_string_utf8("b(" + (inner.to_string_utf8() catch "") + ")")

fn deny_all(next: fn(String, Bytes) -> Bytes!GrpcError, path: String, request: Bytes) -> Bytes!GrpcError:
    return refuse(GRPC_PERMISSION_DENIED, "nope")

test "an empty interceptor list leaves the dispatch alone":
    empty: List[fn(fn(String, Bytes) -> Bytes!GrpcError, String, Bytes) -> Bytes!GrpcError] := []
    guarded := intercept(echo_dispatch, empty)
    reply := guarded("/x.T/Echo", bytes.from_string_utf8("hi"))!
    assert_eq(reply.to_string_utf8()!, "hi")

test "the first interceptor registered runs outermost":
    guarded := intercept(echo_dispatch, [tag_a, tag_b])
    reply := guarded("/x.T/Echo", bytes.from_string_utf8("core"))!
    # a wraps b wraps the dispatch, so a's mark is on the outside
    assert_eq(reply.to_string_utf8()!, "a(b(core))")

test "an interceptor can refuse a call without reaching the dispatch":
    guarded := intercept(echo_dispatch, [deny_all, tag_b])
    result := guarded("/x.T/Echo", bytes.from_string_utf8("hi"))
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_PERMISSION_DENIED)
    # tag_b never ran, so nothing wrapped the reply
    assert_eq(result.err.message, "nope")

test "a dispatch error propagates out through the interceptors":
    guarded := intercept(echo_dispatch, [tag_a])
    result := guarded("/x.T/Boom", bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_INTERNAL)

test "the rate limit interceptor answers RESOURCE_EXHAUSTED when the bucket is dry":
    limiter := resilience.rate_limiter(60, 2)
    guarded := intercept(echo_dispatch, [rate_limit(limiter)])
    assert(guarded("/x.T/Echo", bytes.empty()).is_ok)
    assert(guarded("/x.T/Echo", bytes.empty()).is_ok)
    refused := guarded("/x.T/Echo", bytes.empty())
    assert(refused.is_err)
    assert_eq(refused.err.status, GRPC_RESOURCE_EXHAUSTED)

test "the circuit counts server faults and ignores caller faults":
    breaker := resilience.circuit_breaker(2, 60_000)
    guarded := intercept(echo_dispatch, [circuit(breaker)])
    # a caller's own error must not trip the breaker, however often it repeats
    mut i := 0
    while i < 5:
        assert(guarded("/x.T/BadArg", bytes.empty()).is_err)
        i = i + 1
    assert(guarded("/x.T/Echo", bytes.empty()).is_ok)
    # two server faults reach the threshold and open the circuit
    assert(guarded("/x.T/Boom", bytes.empty()).is_err)
    assert(guarded("/x.T/Boom", bytes.empty()).is_err)
    open := guarded("/x.T/Echo", bytes.empty())
    assert(open.is_err)
    assert_eq(open.err.status, GRPC_UNAVAILABLE)

test "only the server's own failures count against a circuit":
    assert(server_fault(GRPC_INTERNAL))
    assert(server_fault(GRPC_UNAVAILABLE))
    assert(server_fault(GRPC_DATA_LOSS))
    assert(server_fault(GRPC_DEADLINE_EXCEEDED))
    assert(not server_fault(GRPC_INVALID_ARGUMENT))
    assert(not server_fault(GRPC_NOT_FOUND))
    assert(not server_fault(GRPC_UNAUTHENTICATED))
    assert(not server_fault(GRPC_OK))

test "the bearer token is read case-insensitively, or not at all":
    mut md: Map[String, String] := {}
    md.insert("authorization", "Bearer abc.def")
    assert_eq(bearer_token(md), "abc.def")
    # rfc 7235 makes the scheme case-insensitive
    md.insert("authorization", "bEaReR xyz")
    assert_eq(bearer_token(md), "xyz")
    # another scheme is not a bearer credential
    md.insert("authorization", "Basic dXNlcjpwdw==")
    assert_eq(bearer_token(md), "")
    # and neither is a truncated header or none at all
    md.insert("authorization", "Bear")
    assert_eq(bearer_token(md), "")
    mut none_set: Map[String, String] := {}
    assert_eq(bearer_token(none_set), "")

    # a client can send any bytes at all. the scheme is compared byte by byte
    # because slicing seven bytes off a value whose first character is
    # multi-byte cuts through the middle of it.
    md.insert("authorization", "Ärger token here")
    assert_eq(bearer_token(md), "")
    md.insert("authorization", "Bearer Ärger")
    assert_eq(bearer_token(md), "Ärger")
