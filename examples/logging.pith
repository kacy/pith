# structured logging with std.log: a checkout service logs the orders it takes.
#
# a logger carries context, here the service name and a target, so every line
# a handler writes is tagged without repeating it, and each event adds typed
# fields of its own. the console format is for people and the json format is
# for log pipelines. lines go to stderr and to a file in a temp directory,
# which main reads back and prints. every line starts with a timestamp, which
# main drops so the output is the same on every run.

import std.fs as fs
import std.log as log
import std.os.path as path

struct Order:
    id: Int
    items: Int
    total_cents: Int

fn take_order(logger: log.Logger, order: Order):
    # below the logger's level, so it writes nothing.
    logger.debug().int("order", order.id).msg("validating")
    if order.items == 0:
        logger.warn().int("order", order.id).msg("rejected an empty order")
        return
    logger.info().int("order", order.id).int("items", order.items).int("total_cents", order.total_cents).msg("order accepted")

# console lines open with the time and a space.
fn without_timestamp(line: String) -> String:
    return line.substring(line.index_of(" ") + 1, line.len())

# json lines open with a "time" field.
fn without_time_field(line: String) -> String:
    return "{{" + line.substring(line.index_of(",") + 1, line.len())

fn main() -> Int!:
    dir := fs.make_temp_dir("pith_logging_")!
    defer fs.remove_tree(dir)
    console_path := path.join(dir, "checkout.log")
    json_path := path.join(dir, "checkout.jsonl")

    base := log.root().with([log.str("service", "checkout")]).target("orders").level(log.info_level())
    orders := [Order(id: 101, items: 3, total_cents: 4200), Order(id: 102, items: 0, total_cents: 0)]
    for order in orders:
        take_order(base.console().file(console_path), order)

    # a pipeline wants the trace context too, so a line can be joined to the
    # request's spans.
    traced := base.json().file(json_path).trace_context("4bf92f3577b34da6a3ce929d0e0e4736", "00f067aa0ba902b7")
    take_order(traced, Order(id: 103, items: 1, total_cents: 999))

    print("console:")
    for line in fs.read(console_path)!.trim().split("\n"):
        print("  {without_timestamp(line)}")
    print("json:")
    for line in fs.read(json_path)!.trim().split("\n"):
        print("  {without_time_field(line)}")
    return 0
