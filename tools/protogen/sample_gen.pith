fn _Geometry_Reflect_stream_unimpl(call: GeometryReflectServerCall) -> Int!grpc.GrpcError:
    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: "Reflect not implemented")
mut _Geometry_Reflect_stream_fn: fn(GeometryReflectServerCall) -> Int!grpc.GrpcError := _Geometry_Reflect_stream_unimpl

# route one live rpc by its method path, driving the stream to completion.
# a unary arm recvs the one request (requiring the client's half-close) and
# sends the one reply; a streaming arm hands its typed ServerCall to the
# installed handler. an error return becomes the grpc-status; a clean
# return that never finished gets finish_ok from grpc.serve_stream.
fn _Geometry_stream_route(path: String, call: grpc.GrpcStream) -> Int!grpc.GrpcError:
    if path == "/sample.Geometry/Describe":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Point(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Point failed")
        call.send_message(encode_Shape(_Geometry_Describe_fn(decoded.ok)!))
        return 0
    if path == "/sample.Geometry/Corners":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Shape(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Shape failed")
        return _Geometry_Corners_stream_fn(decoded.ok, GeometryCornersServerCall(inner: call))!
    if path == "/sample.Geometry/Assemble":
        return _Geometry_Assemble_stream_fn(GeometryAssembleServerCall(inner: call))!
    if path == "/sample.Geometry/Reflect":
        return _Geometry_Reflect_stream_fn(GeometryReflectServerCall(inner: call))!
    if path == "/sample.Geometry/Ping":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Empty(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Empty failed")
        call.send_message(encode_Empty(_Geometry_Ping_fn(decoded.ok)!))
        return 0
    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: "no method " + path)

