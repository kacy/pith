# clash_widget_b — the other same-named struct: a different field layout on
# purpose, so a constructor or method bound across the two would read wrong
# offsets and the golden output would show it. label stays first so tag()
# must skip past it.
pub struct Widget:
    pub label: String
    pub n: Int

impl Widget:
    fn tag() -> Int:
        return self.n + 2000
    fn only_b() -> String:
        return "b-only:" + self.label
