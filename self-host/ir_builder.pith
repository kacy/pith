# ir_builder.pith — the emission substrate
#
# everything the lowering families write through: the output line
# buffer, the register and label counters, the interned string table,
# and the current function's variable maps (registers, types, return
# kind). one instance of this state exists per module emission; the
# per-function pieces reset at every function boundary.
#
# snapshot/restore exists for nested emission: a lambda body emits
# into its own buffer while the enclosing function is mid-emission.

mut ir_lines: List[String] := []
mut ir_next_reg := 0
mut ir_next_label := 0
mut ir_strings: List[String] := []
mut ir_string_indices: Map[String, Int] := {}
mut ir_string_module_count := 0

## saved buffer and counter state for nested emission.
pub struct IrBuilderSnapshot:
    next_reg: Int
    lines: List[String]

fn ir_push_line(items: List[String], value: String) -> List[String]:
    mut updated: List[String] := items
    updated.push(value)
    return updated

fn ir_strip_quotes(s: String) -> String:
    mut result := s
    if result.len() >= 2:
        if result[0] == chr(34):
            result = result.substring(1, result.len())
        if result.len() > 0 and result.substring(result.len() - 1, result.len()) == chr(34):
            # a final quote is only a delimiter when it is not itself escaped.
            # an interpolation's leading segment can end in `\"` (the text
            # before the brace in "a\"{x}"), and stripping that quote would
            # orphan the backslash and corrupt the literal.
            mut backslashes := 0
            mut j := result.len() - 2
            while j >= 0 and result[j] == chr(92):
                backslashes = backslashes + 1
                j = j - 1
            if backslashes % 2 == 0:
                result = result.substring(0, result.len() - 1)
    return result

fn ir_string_symbol_name(index: Int) -> String:
    return "m" + ir_string_module_count.to_string() + "s" + index.to_string()

fn ir_copy_lines(lines: List[String]) -> List[String]:
    mut copy: List[String] := []
    for line in lines:
        copy.push(line)
    return copy

## reset all emission state for a fresh module.
pub fn ir_builder_reset():
    ir_lines = []
    ir_next_reg = 0
    ir_next_label = 0
    ir_strings = []
    ir_string_indices = {}

## reset the per-function counters and locals.
pub fn ir_builder_reset_function():
    ir_lines = []
    ir_next_reg = 0

## builder reset registers.
pub fn ir_builder_reset_registers():
    ir_next_reg = 0

## builder set string module count.
pub fn ir_builder_set_string_module_count(module_count: Int):
    ir_string_module_count = module_count

## builder snapshot.
pub fn ir_builder_snapshot() -> IrBuilderSnapshot:
    return IrBuilderSnapshot(ir_next_reg, ir_copy_lines(ir_lines))

## builder restore.
pub fn ir_builder_restore(snapshot: IrBuilderSnapshot):
    ir_next_reg = snapshot.next_reg
    ir_lines = ir_copy_lines(snapshot.lines)

## builder lines.
pub fn ir_builder_lines() -> List[String]:
    return ir_copy_lines(ir_lines)

## builder append lines.
pub fn ir_builder_append_lines(lines: List[String]):
    mut updated: List[String] := ir_lines
    for line in lines:
        updated.push(line)
    ir_lines = updated

## new temp name.
pub fn ir_new_temp_name(prefix: String) -> String:
    return "__" + prefix + "_" + ir_next_reg.to_string() + "_" + ir_next_label.to_string()

## emit.
pub fn ir_emit(line: String):
    ir_lines = ir_push_line(ir_lines, line)

## str.
pub fn ir_str(s: String) -> String:
    cleaned := ir_strip_quotes(s)
    if ir_string_indices.contains_key(cleaned):
        return ir_string_symbol_name(ir_string_indices[cleaned])
    idx := ir_strings.len()
    ir_strings = ir_push_line(ir_strings, cleaned)
    ir_string_indices.insert(cleaned, idx)
    return ir_string_symbol_name(idx)

## true when `s` is already in the string table, so a strref to it will
## resolve. a body that would reference a string the prepass did not
## intern asks this first and takes another path when the answer is no,
## because the table has been emitted by then and ir_str would add an
## entry nothing ever writes out.
pub fn ir_str_interned(s: String) -> Bool:
    return ir_string_indices.contains_key(ir_strip_quotes(s))

## emit string table.
pub fn ir_emit_string_table():
    for value, i in ir_strings:
        ir_emit("string " + ir_string_symbol_name(i) + " " + chr(34) + value + chr(34))

## reg.
pub fn ir_reg() -> Int:
    r := ir_next_reg
    ir_next_reg = ir_next_reg + 1
    return r

## label.
pub fn ir_label() -> String:
    n := ir_next_label
    ir_next_label = ir_next_label + 1
    return "L" + n.to_string()

# the current function's variable types — the one piece of
# per-function state the lowering families read constantly.
pub mut ir_var_types: Map[String, String] := {}

# names the prologue prepass could not track under a single rc kind: a name
# bound with conflicting kinds in sibling branches or match arms (`E.S(v)`
# binding a string and `E.M(v)` binding a struct), or with an rc kind at one
# site and a plain value at another. the ones that never hold a count stay
# here only. lives in ir_builder (not ir_emitter_core) so ir_match_emit can
# read it without a module cycle, same as ir_var_regs/ir_var_types.
pub mut ir_untracked_rc_binds: List[String] := []

# the subset of ir_untracked_rc_binds that some binding site gives an rc kind.
# each of these carries a side slot (ir_kinded_tag_slot) holding the rc kind
# code of the value its slot owns, written at every binding site, so a rebind
# releases the outgoing value under the kind it was bound with and the exit
# cleanup releases whatever the last binding on the path taken left there.
pub mut ir_kinded_rc_binds: List[String] := []

# the module's kind-dispatching release helper, named per module like the
# tuple cascade helpers, and whether any function of the module called it.
pub mut ir_kinded_release_symbol: String := ""
pub mut ir_kinded_release_used: Bool := false

## the current function's variable registers.
pub mut ir_var_regs: Map[String, Int] := {}

## the current function's return kind.
pub mut ir_current_func_return_kind: String := ""
