# ir_call_emit.pith — tiny wrappers for emitting call and label
# instructions. they bind the shared registries so the rest of the
# emitter can say ir_emit_call2(r, name, kind, a, b) and move on.

from ir_builder import ir_emit
from ir_call_helpers import ir_emit_call_text_with_state
from ir_method_tables import ir_func_returns
from ir_alias_registry import ir_type_aliases
from ir_struct_registry import ir_struct_names

pub mut ir_last_was_ret := false # tracks if the last emitted instruction was a return

# # emit a call with pre-rendered argument text.
pub fn ir_emit_call_text(result_reg: Int, fname: String, ret_type: String, arg_count: Int, arg_text: String):
    ir_emit_call_text_with_state(result_reg, fname, ret_type, arg_count, arg_text, ir_func_returns, ir_type_aliases, ir_struct_names)

# # emit a zero-argument call.
pub fn ir_emit_call0(result_reg: Int, fname: String, ret_type: String):
    ir_emit_call_text(result_reg, fname, ret_type, 0, "")

# # emit a one-argument call.
pub fn ir_emit_call1(result_reg: Int, fname: String, ret_type: String, arg0: Int):
    ir_emit_call_text(result_reg, fname, ret_type, 1, " " + arg0.to_string())

# --- string ownership -------------------------------------------------
#
# heap cstrings carry a refcount (cranelift/runtime/src/runtime_core.rs);
# retain and release are no-ops for literals and null, so string registers
# never need their origin distinguished at emission time. the discipline:
#
#   - every string a variable holds is one owned count
#   - binding or assigning a borrowed string (a variable read, a collection
#     element, a struct field) retains it first; fresh call results already
#     arrive owned
#   - rebinding or reassigning releases the value being replaced
#   - a return hands its count to the caller: a returned variable is
#     excluded from cleanup, a returned borrow is retained
#   - each return releases every string local the function owns

# # emit a two-argument call.
pub fn ir_emit_call2(result_reg: Int, fname: String, ret_type: String, arg0: Int, arg1: Int):
    ir_emit_call_text(result_reg, fname, ret_type, 2, " " + arg0.to_string() + " " + arg1.to_string())

# # emit a three-argument call.
pub fn ir_emit_call3(result_reg: Int, fname: String, ret_type: String, arg0: Int, arg1: Int, arg2: Int):
    ir_emit_call_text(result_reg, fname, ret_type, 3, " " + arg0.to_string() + " " + arg1.to_string() + " " + arg2.to_string())

# # emit a label and reset return tracking.
pub fn ir_emit_label(l: String):
    ir_emit("label " + l)
    ir_last_was_ret = false
