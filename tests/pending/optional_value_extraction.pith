# PENDING — no issue yet. not registered in tooling/leak_check.sh; it fails.
#
# `.value()` does not release what it extracts from. two halves:
#
#  - called straight on the optional a function handed back, it strands the
#    shell. that happens at `Int` as well as at `String`, so it is the shell
#    and not the payload, and `ch.recv().value()` pays it on every receive.
#  - called on an optional that was bound to a local first, it strands the
#    heap payload when the optional came back from a call. an optional built
#    by an annotated binding (`b: String? := text`) is fine.
#
# `unwrap_or` and `catch` on the very same subjects are flat, and so is a
# `== none` test on a bound optional — but `== none` on a call's optional
# temporary strands the shell the same way `.value()` does. so the fault is in
# how a temporary and a call-produced optional are cleaned up, not in the
# extraction operators as a family.
#
# this is not a generics defect. it turned up in a generic survey because
# tests/leaks/leak_unwrap_extract.pith binds its subject to a local in every
# one of its shapes and never extracts from a call result directly.
#
# measured on this file at PITH_LEAK_ROUNDS 200000 vs 800000:
#   shape 1, value() on a call's Int? temporary      15.1 mb -> 52.7 mb
#   shape 2, == none on a call's Int? temporary      15.1 mb -> 52.7 mb
#   shape 3, value() on a bound String? from a call  12.1 mb -> 40.2 mb
#   shape 4, unwrap_or on the same bound String?      2.7 mb ->  2.7 mb
#   shape 5, value() on a bound annotated String?     2.7 mb ->  2.8 mb
#   shape 6, the same optional never extracted        2.8 mb ->  2.7 mb
import pendingprobe as probe
import std.env as env

fn maybe_int(i: Int) -> Int?:
    return i

fn maybe_text(i: Int) -> String?:
    return "value-" + i.to_string()

fn main():
    which := env.int_or("SHAPE", 1)
    n := probe.rounds()
    mut i := 0
    mut acc := 0
    while i < n:
        text := "bound-" + i.to_string()
        if which == 1:
            acc = acc + maybe_int(i).value()
        if which == 2:
            if maybe_int(i) == none:
                acc = acc + 1
        if which == 3:
            a := maybe_text(i)
            acc = acc + a.value().len()
        if which == 4:
            b := maybe_text(i)
            acc = acc + b.unwrap_or("").len()
        if which == 5:
            c: String? := text
            acc = acc + c.value().len()
        if which == 6:
            d := maybe_text(i)
            if d == none:
                acc = acc + 1
        i = i + 1
    if acc < 0:
        print("unreachable")
    kb := probe.peak_kb()
    print("{kb}")
