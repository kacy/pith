# a product catalog served over grpc from generated code.
#
# tools/protogen turned catalog.proto (quoted in docs/grpc.md) into
# catalog_gen.pith: the message structs, a typed CatalogClient, and
# serve_Catalog, which decodes each request, routes it to a handler by method
# and encodes the reply. what is left to write is one typed handler per rpc.
# the client runs in the same process so the round trip shows end to end.

import catalog_gen as cat
import std.algo as algo
import std.net.grpc as grpc
import std.time as time

PORT := 20261

# built once at module load and never written after, so handler tasks read it
# without a lock.
store := seeded()

fn seeded() -> Map[String, cat.Product]:
    products := [
        cat.Product(sku: "sku-1", name: "usb-c cable", price: 9.99, category: cat.Category_ELECTRONICS, tags: ["cable", "usb"], in_stock: true),
        cat.Product(sku: "sku-2", name: "the go programming language", price: 34.5, category: cat.Category_BOOKS, tags: ["go", "book"], in_stock: true),
        cat.Product(sku: "sku-3", name: "usb hub", price: 19.0, category: cat.Category_ELECTRONICS, tags: ["usb", "hub"], in_stock: false)
    ]
    mut by_sku: Map[String, cat.Product] := {}
    for product in products:
        by_sku[product.sku] = product
    return by_sku

# rpc GetProduct(GetProductRequest) returns (Product)
fn get_product(req: cat.GetProductRequest) -> cat.Product!grpc.GrpcError:
    if let product = store.get(req.sku):
        return product
    fail grpc.GrpcError(status: grpc.GRPC_NOT_FOUND, message: "no product {req.sku}")

# rpc Search(SearchRequest) returns (SearchResponse). matches come back sorted
# by name, since a map has no order of its own.
fn search(req: cat.SearchRequest) -> cat.SearchResponse!grpc.GrpcError:
    if req.query == "":
        fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "query is required")
    mut hits: List[cat.Product] := []
    for sku in store:
        if store[sku].name.contains(req.query):
            hits.push(store[sku])
    sorted := algo.sort_by_key(hits, fn(p: cat.Product) => p.name)
    mut shown := sorted
    if req.max_results > 0 and sorted.len() > req.max_results:
        shown = sorted.slice(0, req.max_results)
    return cat.SearchResponse(products: shown, total: sorted.len())

fn run_server() -> Int:
    return cat.serve_Catalog("127.0.0.1", PORT, get_product, search) catch 1

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

fn stock_note(product: cat.Product) -> String:
    if product.in_stock:
        return "in stock"
    return "out of stock"

fn lookup(client: cat.CatalogClient, sku: String):
    product := client.GetProduct(cat.GetProductRequest(sku: sku)) catch err:
        print("{sku}: {grpc.status_name(err.status)}, {err.message}")
        return
    print("{sku}: {product.name}, ${product.price:.2}, {stock_note(product)}")

fn find(client: cat.CatalogClient, query: String, max_results: Int):
    found := client.Search(cat.SearchRequest(query: query, max_results: max_results)) catch err:
        print("search '{query}': {grpc.status_name(err.status)}, {err.message}")
        return
    print("search '{query}': {found.total} matches, showing {found.products.len()}")
    for product in found.products:
        print("  {product.sku}  {product.name}")

fn main() -> Int!:
    spawn run_server()
    conn := connect()!
    defer conn.close()
    client := cat.new_CatalogClient(conn)

    lookup(client, "sku-1")
    lookup(client, "sku-3")
    lookup(client, "sku-99")
    find(client, "usb", 10)
    find(client, "usb", 1)
    find(client, "", 10)
    return 0
