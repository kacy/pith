# a chain of tuple indexes such as `pair.0.1` reads as two indexes. the lexer
# used to take `0.1` as a float, so nested access needed a binding per level.

fn spans() -> ((Int, Int), (Int, Int)):
    return ((1, 2), (3, 4))

fn main():
    ends := ((1, 2), (3, 4))
    print("{ends.0.0} {ends.0.1} {ends.1.0} {ends.1.1}")
    print("{ends.0.1 + ends.1.0}")
    deep := (((5, 6), 7), 8)
    print("{deep.0.0.1} {deep.0.1} {deep.1}")
    print("{spans().1.0}")
    half := 0.5
    print("{half + 1.25}")
