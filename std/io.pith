fn buffered_tcp_writer_write_internal(writer: BufferedTcpWriter, data: String) -> Int!:
    if not buffered_tcp_writer_fds.contains_key(writer.handle):
        return 0

    cached := buffered_tcp_writer_cache_get(writer.handle)
    buffered_tcp_writer_cache.insert(writer.handle, cached + data)
    if buffered_tcp_writer_should_flush(writer.handle):
        buffered_tcp_writer_flush_internal(writer)!
    return data.len()

fn buffered_tcp_writer_write_internal_ctx(writer: BufferedTcpWriter, ctx: Context, data: String) -> Int!BlockingError:
    if not buffered_tcp_writer_fds.contains_key(writer.handle):
        return 0

    cached := buffered_tcp_writer_cache_get(writer.handle)
    buffered_tcp_writer_cache.insert(writer.handle, cached + data)
    if buffered_tcp_writer_should_flush(writer.handle):
        buffered_tcp_writer_flush_internal_ctx(writer, ctx)!
    return data.len()

fn buffered_tcp_writer_flush_internal(writer: BufferedTcpWriter) -> Int!:
    if not buffered_tcp_writer_fds.contains_key(writer.handle):
        return 0

    cached := buffered_tcp_writer_cache_get(writer.handle)
    if cached.len() == 0:
        return 0

    fd := buffered_tcp_writer_fds[writer.handle]
    wrote := write_all_tcp_stream(TcpStream(fd), cached)!
    buffered_tcp_writer_cache.insert(writer.handle, "")
    return wrote

fn buffered_tcp_writer_flush_internal_ctx(writer: BufferedTcpWriter, ctx: Context) -> Int!BlockingError:
    if not buffered_tcp_writer_fds.contains_key(writer.handle):
        return 0

    cached := buffered_tcp_writer_cache_get(writer.handle)
    if cached.len() == 0:
        return 0

    fd := buffered_tcp_writer_fds[writer.handle]
    wrote := write_all_tcp_stream_ctx(TcpStream(fd), ctx, cached)!
    buffered_tcp_writer_cache.insert(writer.handle, "")
    return wrote

