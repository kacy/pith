# tasks, deadlines and shared state: a price check across several suppliers.
#
# main asks every supplier for a quote at once, one spawned task each, and
# waits for the answers under a single deadline, so one slow supplier cannot
# hold up the others. the tasks share a small ledger behind a lock, a
# semaphore caps how many requests are open at a time, and a wait group lets
# main wait for the stragglers it stopped waiting on before it reads the
# ledger.

import std.concurrent as concurrent
import std.time as time
from std.concurrent import await_ctx

struct Supplier:
    name: String
    price_cents: Int
    latency_ms: Int

# the guard block ties these globals to ledger_mu: the compiler refuses any
# read or write of them outside `locked ledger_mu:`.
guard ledger_mu:
    mut contacted: List[String] := []
    mut open_now: Int := 0
    mut most_open: Int := 0

# the suppliers' api allows two open connections per client.
MAX_OPEN := 2

fn request_quote(s: Supplier, permits: Semaphore, finished: WaitGroup) -> Int:
    defer finished.done()
    permits.acquire()
    defer permits.release()
    locked ledger_mu:
        contacted.push(s.name)
        open_now = open_now + 1
        if open_now > most_open:
            most_open = open_now
    # stands in for the network round trip.
    time.delay(s.latency_ms)
    locked ledger_mu:
        open_now = open_now - 1
    return s.price_cents

fn dollars(cents: Int) -> String:
    return "${cents / 100}.{cents % 100:02}"

fn main() -> Int!:
    suppliers := [
        Supplier(name: "acme", price_cents: 1299, latency_ms: 20),
        Supplier(name: "globex", price_cents: 1149, latency_ms: 40),
        Supplier(name: "initech", price_cents: 999, latency_ms: 1500),
        Supplier(name: "umbrella", price_cents: 1225, latency_ms: 30),
    ]
    permits := Semaphore(MAX_OPEN)
    finished := WaitGroup()
    finished.add(suppliers.len())

    mut pending: List[Task[Int]] := []
    for s in suppliers:
        pending.push(spawn request_quote(s, permits, finished))

    # one deadline for the whole round: every await below shares it.
    deadline := concurrent.with_timeout(concurrent.background(), 500).0
    mut best_name := ""
    mut best_cents := 0
    for task, i in pending:
        name := suppliers[i].name
        cents := await_ctx(task, deadline) catch:
            print("{name:<9} no answer before the deadline")
            continue
        print("{name:<9} {dollars(cents)}")
        if best_name == "" or cents < best_cents:
            best_name = name
            best_cents = cents
    print("best quote: {best_name} at {dollars(best_cents)}")

    # the deadline stopped the wait, not the task: the slow request still
    # runs and still writes the ledger. wait for it before reading.
    finished.wait()
    locked ledger_mu:
        print("suppliers contacted: {contacted.len()}")
        print("open at once, at most: {most_open} (limit {MAX_OPEN})")
    return 0
