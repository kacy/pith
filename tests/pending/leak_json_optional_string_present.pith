# typed json.decode of a flat struct with an optional String field that is
# present in the document, the scalar-object path, grows about 31 bytes per
# decode: 9160 kb at 200000 rounds against 27912 kb at 800000. the same decode
# with the field absent from the document stays flat.
#
# this sat in tests/leaks/ as the gate for #1144, but the backend kept the
# backslash of the `\{` escape its document is written with, so every decode
# failed on the first byte and the gate never reached the optional field.
import std.json as json
import pendingprobe as probe

pub struct Plain:
    pub id: Int
    pub note: String?
    pub name: String

fn main():
    n := probe.rounds()
    mut i := 0
    mut total := 0
    while i < n:
        doc := "\{\"id\":{i},\"note\":\"n\",\"name\":\"p{i}\"\}"
        r := json.decode_text[Plain](doc)
        if r.is_ok:
            total = total + r.ok.name.len()
        i = i + 1
    print("{probe.peak_kb()}")
