fn count_marks(s: String) -> Int:
    mut n := 0
    mut i := 0
    while i < s.len():
        if s[i] == ":":
            n = n + 1
        if s[i] != chr(58) and s[i] == chr(44):
            n = n + 100
        if s[i] == s[0]:
            n = n + 1000
        i = i + 1
    return n

# escape literals also lower to a byte compare: "\t" decodes to byte 9. this
# guards the escape-decoding path, which is easy to get wrong because the
# literal's stored form still carries its quotes and backslash.
fn count_tabs(s: String) -> Int:
    mut n := 0
    mut i := 0
    while i < s.len():
        if s[i] == "\t":
            n = n + 1
        i = i + 1
    return n

# ord(s[i]) reads a byte with byte_at instead of allocating a one-character
# string, and ord("0") folds to a constant — the pattern the url scanners use.
fn digit_sum(s: String) -> Int:
    mut total := 0
    mut i := 0
    while i < s.len():
        b := ord(s[i])
        if b >= ord("0") and b <= ord("9"):
            total = total + (b - ord("0"))
        i = i + 1
    return total

fn main():
    print(count_marks("a:b:c,d:e").to_string())
    print(count_marks("").to_string())
    s := "xy"
    # s.get(i) returns String?, safe for potentially-oob access. The
    # comparison unwraps with an empty-string default so the miss reads
    # as a plain "not equal".
    ok := s.get(5).unwrap_or("") == "x"
    print(ok.to_string())
    print(ord(s[1]).to_string())
    print(count_tabs("x\ty\tz\tw").to_string())
    print(digit_sum("a1b2c3d9").to_string())
