# only a type that implements the interface converts to it.
interface Shape:
    fn area() -> Int

struct Sq:
    s: Int

struct Note:
    text: String

impl Shape for Sq:
    fn area() -> Int:
        return self.s * self.s

fn show(x: Shape) -> Int:
    return x.area()

fn main():
    print(show(Note(text: "no")).to_string())
    xs: List[Shape] := [Sq(s: 1), Note(text: "no")]
    print(xs.len().to_string())
