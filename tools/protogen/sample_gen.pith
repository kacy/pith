# route one live rpc by its method path, driving the stream to completion.
# a unary arm recvs the one request (requiring the client's half-close) and
# sends the one reply; a streaming arm hands its typed ServerCall to the
# handler passed for it. an error return becomes the grpc-status; a clean
# return that never finished gets finish_ok from grpc.serve_stream.
fn _Geometry_stream_route(path: String, call: grpc.GrpcStream, handle_Describe: fn(Point) -> Shape!grpc.GrpcError, handle_Corners: fn(Shape, GeometryCornersServerCall) -> Int!grpc.GrpcError, handle_Assemble: fn(GeometryAssembleServerCall) -> Int!grpc.GrpcError, handle_Reflect: fn(GeometryReflectServerCall) -> Int!grpc.GrpcError, handle_Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Int!grpc.GrpcError:
    if path == "/sample.Geometry/Describe":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Point(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Point failed")
        call.send_message(encode_Shape(handle_Describe(decoded.ok)!))
        return 0
    if path == "/sample.Geometry/Corners":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Shape(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Shape failed")
        return handle_Corners(decoded.ok, GeometryCornersServerCall(inner: call))!
    if path == "/sample.Geometry/Assemble":
        return handle_Assemble(GeometryAssembleServerCall(inner: call))!
    if path == "/sample.Geometry/Reflect":
        return handle_Reflect(GeometryReflectServerCall(inner: call))!
    if path == "/sample.Geometry/Ping":
        first := call.recv_message()!
        if not first.done:
            second := call.recv_message()!
            if not second.done:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        decoded := decode_Empty(first.message)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Empty failed")
        call.send_message(encode_Empty(handle_Ping(decoded.ok)!))
        return 0
    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: "no method " + path)

# the stream-level dispatch routing to these handlers.
fn _Geometry_stream_dispatch(Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape, GeometryCornersServerCall) -> Int!grpc.GrpcError, Assemble: fn(GeometryAssembleServerCall) -> Int!grpc.GrpcError, Reflect: fn(GeometryReflectServerCall) -> Int!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> fn(String, grpc.GrpcStream) -> Int!grpc.GrpcError:
    return fn(path: String, call: grpc.GrpcStream) -> Int!grpc.GrpcError => _Geometry_stream_route(path, call, Describe, Corners, Assemble, Reflect, Ping)

# serve the whole Geometry service over one plaintext http/2 (h2c)
# streaming listener. unary handlers keep the (Req) -> Resp shape; a
# streaming rpc's handler drives its typed ServerCall incrementally.
# blocks, accepting connections.
pub fn serve_Geometry_streaming(host: String, port: Int, Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape, GeometryCornersServerCall) -> Int!grpc.GrpcError, Assemble: fn(GeometryAssembleServerCall) -> Int!grpc.GrpcError, Reflect: fn(GeometryReflectServerCall) -> Int!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Int!:
    return grpc.serve_stream(host, port, _Geometry_stream_dispatch(Describe, Corners, Assemble, Reflect, Ping))!

# like serve_Geometry_streaming, over http/2 with tls (alpn h2).
pub fn serve_Geometry_streaming_tls(host: String, port: Int, cert: String, key: String, Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape, GeometryCornersServerCall) -> Int!grpc.GrpcError, Assemble: fn(GeometryAssembleServerCall) -> Int!grpc.GrpcError, Reflect: fn(GeometryReflectServerCall) -> Int!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Int!:
    return grpc.serve_stream_tls(host, port, cert, key, _Geometry_stream_dispatch(Describe, Corners, Assemble, Reflect, Ping))!
