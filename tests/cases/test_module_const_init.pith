# module-scope constants of every literal kind must keep their value. positive
# ints and strings always worked; negative-int and float literals used to be
# silently zeroed (the declaration inlined only positive ints/strings, and the
# startup initializer skipped negatives and floats). regression guard.
POS_INT := 42
NEG_INT := -7
ZERO := 0
BIG_FLOAT := 1000000.0
FRAC := 0.75
NEG_FLOAT := -3.5
STR := "hello"
COMPUTED := 0 - 9

fn main() -> Int!:
    print(POS_INT.to_string())
    print(NEG_INT.to_string())
    print(ZERO.to_string())
    print(BIG_FLOAT.to_string())
    print(FRAC.to_string())
    print(NEG_FLOAT.to_string())
    print(STR)
    print(COMPUTED.to_string())
    return 0
