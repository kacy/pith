# std.regex - a small regular expression engine.
#
# the matcher is a pike vm: the pattern compiles to bytecode and the
# vm advances every live thread one input character at a time, so
# matching is linear in the input for any pattern — there is no
# backtracking to go pathological.
#
# supported: literals, `.` (any char but newline), classes [a-z0-9]
# and [^...], escapes \d \w \s \D \W \S \t \n and escaped metas,
# quantifiers * + ? (greedy), alternation |, capturing groups (...),
# and anchors ^ $. not supported: {n,m} counts, lazy quantifiers,
# backreferences, lookaround.

# instruction opcodes
OP_CHAR := 0
OP_ANY := 1
OP_CLASS := 2
OP_SPLIT := 3
OP_JMP := 4
OP_SAVE := 5
OP_MATCH := 6
OP_BOL := 7
OP_EOL := 8

## one compiled instruction: an opcode and up to two arguments.
pub struct Inst:
    op: Int
    a: Int
    b: Int

## a character class: flat lo,hi code pairs, optionally negated.
pub struct ClassDef:
    ranges: List[Int]
    negate: Bool

## a compiled pattern, ready to match.
pub struct Regex:
    insts: List[Inst]
    classes: List[ClassDef]
    ngroups: Int

## one match: the half-open [start, stop) range and its text.
pub struct Match:
    start: Int
    stop: Int
    text: String

# --- pattern parsing and compilation ------------------------------------
# the parser walks the pattern once, emitting instructions as it goes
# and patching split/jmp targets after each fragment's size is known.

struct Compiler:
    pattern: String
    pos: Int
    insts: List[Inst]
    classes: List[ClassDef]
    ngroups: Int
    error: String

fn c_peek(c: Compiler) -> String:
    if c.pos >= c.pattern.len():
        return ""
    return c.pattern[c.pos]

fn c_emit(c: Compiler, op: Int, a: Int, b: Int) -> Int:
    c.insts.push(Inst(op, a, b))
    return c.insts.len() - 1

fn c_fail(c: Compiler, msg: String):
    if c.error == "":
        c.error = msg + " at position " + c.pos.to_string()

# alternation: concat ('|' concat)*
fn parse_alt(c: Compiler):
    start := c.insts.len()
    parse_concat(c)
    if c_peek(c) != "|":
        return
    # wrap the finished branch: insert a split before it and a jmp
    # after it, then chain further branches
    mut branch_starts: List[Int] := [start]
    mut jmp_slots: List[Int] := []
    while c_peek(c) == "|" and c.error == "":
        c.pos = c.pos + 1
        # close the previous branch with a jmp-to-end placeholder
        jmp_slots.push(c_emit(c, OP_JMP, 0 - 1, 0))
        branch_starts.push(c.insts.len())
        parse_concat(c)
    # the branches were emitted one after another with no splits between
    # them. insert them now: before each branch except the last, a split
    # offers "this branch or the next one". the splits go in last to
    # first. insert_split moves every target at or past its insertion
    # point, so a split inserted later would move the earlier split's
    # alternative past the new split. inserting backward also keeps the
    # recorded branch starts valid.
    mut i := branch_starts.len() - 2
    while i >= 0:
        insert_split(c, branch_starts[i], branch_starts[i + 1])
        i = i - 1
    end_pc := c.insts.len()
    # the placeholder after branch k sits behind the splits for branches
    # 0 through k, so it moved forward by k + 1
    mut k := 0
    while k < jmp_slots.len():
        c.insts[jmp_slots[k] + k + 1] = Inst(OP_JMP, end_pc, 0)
        k = k + 1

fn insert_split(c: Compiler, at: Int, alt_target: Int):
    # insert OP_SPLIT at index `at`; all targets >= at shift by one
    mut fixed: List[Inst] := []
    mut i := 0
    while i < c.insts.len():
        inst := c.insts[i]
        mut a := inst.a
        mut b := inst.b
        if inst.op == OP_JMP or inst.op == OP_SPLIT:
            if a >= at:
                a = a + 1
            if inst.op == OP_SPLIT and b >= at:
                b = b + 1
        fixed.push(Inst(inst.op, a, b))
        i = i + 1
    mut alt := alt_target
    if alt >= at:
        alt = alt + 1
    mut out: List[Inst] := []
    mut j := 0
    while j < fixed.len():
        if j == at:
            out.push(Inst(OP_SPLIT, at + 1, alt))
        out.push(fixed[j])
        j = j + 1
    if at == fixed.len():
        out.push(Inst(OP_SPLIT, at + 1, alt))
    c.insts = out

fn parse_concat(c: Compiler):
    while c.error == "":
        ch := c_peek(c)
        if ch == "" or ch == "|" or ch == ")":
            return
        parse_repeat(c)

fn parse_repeat(c: Compiler):
    atom_start := c.insts.len()
    parse_atom(c)
    if c.error != "":
        return
    ch := c_peek(c)
    if ch == "*":
        c.pos = c.pos + 1
        # split(body, out) before atom; jmp back after
        insert_split(c, atom_start, 0)
        jmp_pc := c_emit(c, OP_JMP, atom_start, 0)
        # split's alternative exits past the jmp
        c.insts[atom_start] = Inst(OP_SPLIT, atom_start + 1, jmp_pc + 1)
    elif ch == "+":
        c.pos = c.pos + 1
        split_pc := c_emit(c, OP_SPLIT, atom_start, 0)
        c.insts[split_pc] = Inst(OP_SPLIT, atom_start, split_pc + 1)
    elif ch == "?":
        c.pos = c.pos + 1
        insert_split(c, atom_start, 0)
        end_pc := c.insts.len()
        c.insts[atom_start] = Inst(OP_SPLIT, atom_start + 1, end_pc)

fn parse_atom(c: Compiler):
    ch := c_peek(c)
    if ch == "(":
        c.pos = c.pos + 1
        group := c.ngroups
        c.ngroups = c.ngroups + 1
        c_emit(c, OP_SAVE, group * 2, 0)
        parse_alt(c)
        if c_peek(c) != ")":
            c_fail(c, "unclosed group")
            return
        c.pos = c.pos + 1
        c_emit(c, OP_SAVE, group * 2 + 1, 0)
        return
    if ch == "[":
        parse_class(c)
        return
    if ch == ".":
        c.pos = c.pos + 1
        c_emit(c, OP_ANY, 0, 0)
        return
    if ch == "^":
        c.pos = c.pos + 1
        c_emit(c, OP_BOL, 0, 0)
        return
    if ch == "$":
        c.pos = c.pos + 1
        c_emit(c, OP_EOL, 0, 0)
        return
    if ch == chr(92):
        c.pos = c.pos + 1
        esc := c_peek(c)
        if esc == "":
            c_fail(c, "trailing backslash")
            return
        c.pos = c.pos + 1
        emit_escape(c, esc)
        return
    if ch == "*" or ch == "+" or ch == "?":
        c_fail(c, "quantifier with nothing to repeat")
        return
    c.pos = c.pos + 1
    c_emit(c, OP_CHAR, ord(ch), 0)

fn emit_escape(c: Compiler, esc: String):
    if esc == "d" or esc == "D":
        c_emit(c, OP_CLASS, add_class(c, [48, 57], esc == "D"), 0)
        return
    if esc == "w" or esc == "W":
        c_emit(c, OP_CLASS, add_class(c, [48, 57, 65, 90, 97, 122, 95, 95], esc == "W"), 0)
        return
    if esc == "s" or esc == "S":
        c_emit(c, OP_CLASS, add_class(c, [32, 32, 9, 10, 13, 13], esc == "S"), 0)
        return
    if esc == "t":
        c_emit(c, OP_CHAR, 9, 0)
        return
    if esc == "n":
        c_emit(c, OP_CHAR, 10, 0)
        return
    c_emit(c, OP_CHAR, ord(esc), 0)

fn add_class(c: Compiler, ranges: List[Int], negate: Bool) -> Int:
    c.classes.push(ClassDef(ranges, negate))
    return c.classes.len() - 1

fn parse_class(c: Compiler):
    c.pos = c.pos + 1
    mut negate := false
    if c_peek(c) == "^":
        negate = true
        c.pos = c.pos + 1
    mut ranges: List[Int] := []
    mut closed := false
    while c.pos < c.pattern.len() and not closed:
        ch := c_peek(c)
        if ch == "]":
            c.pos = c.pos + 1
            closed = true
        elif ch == chr(92):
            c.pos = c.pos + 1
            esc := c_peek(c)
            c.pos = c.pos + 1
            if esc == "d":
                ranges.push(48)
                ranges.push(57)
            elif esc == "w":
                ranges.push(48)
                ranges.push(57)
                ranges.push(65)
                ranges.push(90)
                ranges.push(97)
                ranges.push(122)
                ranges.push(95)
                ranges.push(95)
            elif esc == "s":
                ranges.push(32)
                ranges.push(32)
                ranges.push(9)
                ranges.push(10)
                ranges.push(13)
                ranges.push(13)
            elif esc == "t":
                ranges.push(9)
                ranges.push(9)
            elif esc == "n":
                ranges.push(10)
                ranges.push(10)
            else:
                ranges.push(ord(esc))
                ranges.push(ord(esc))
        else:
            lo := ord(ch)
            c.pos = c.pos + 1
            if c_peek(c) == "-" and c.pos + 1 < c.pattern.len() and c.pattern[c.pos + 1] != "]":
                c.pos = c.pos + 1
                hi := ord(c_peek(c))
                c.pos = c.pos + 1
                if hi < lo:
                    c_fail(c, "reversed class range")
                    return
                ranges.push(lo)
                ranges.push(hi)
            else:
                ranges.push(lo)
                ranges.push(lo)
    if not closed:
        c_fail(c, "unclosed class")
        return
    c_emit(c, OP_CLASS, add_class(c, ranges, negate), 0)

# a pattern is usually dev-controlled, but a server that compiles a user-
# supplied one must not be crashable by it: the parser recurses per group
# nesting (deep nesting overflows the native stack) and quantifier handling is
# superlinear in the pattern length. cap the length so both stay well below the
# danger zone — real patterns are far shorter than this.
MAX_PATTERN_LEN := 4096

## compile a pattern; errors carry the offending position.
pub fn compile(pattern: String) -> Regex!:
    if pattern.len() > MAX_PATTERN_LEN:
        fail "regex: pattern exceeds maximum length"
    mut insts: List[Inst] := []
    mut classes: List[ClassDef] := []
    c := Compiler(pattern, 0, insts, classes, 1, "")
    c_emit(c, OP_SAVE, 0, 0)
    parse_alt(c)
    if c.error == "" and c.pos < c.pattern.len():
        c_fail(c, "unexpected character '" + c_peek(c) + "'")
    if c.error != "":
        fail c.error
    c_emit(c, OP_SAVE, 1, 0)
    c_emit(c, OP_MATCH, 0, 0)
    return Regex(c.insts, c.classes, c.ngroups)

# --- the pike vm ---------------------------------------------------------

fn class_matches(cd: ClassDef, code: Int) -> Bool:
    mut hit := false
    mut i := 0
    while i + 1 < cd.ranges.len() and not hit:
        if code >= cd.ranges[i] and code <= cd.ranges[i + 1]:
            hit = true
        i = i + 2
    if cd.negate:
        return not hit
    return hit

# add a thread (and everything reachable through control instructions)
# to the next thread list. `seen` dedupes by pc: the first arrival wins,
# which preserves greedy priority because callers add in priority order.
fn add_thread(re: Regex, list_pcs: List[Int], list_slots: List[List[Int]], seen: Set[Int], pc: Int, slots: List[Int], pos: Int, input_len: Int):
    if seen.contains(pc):
        return
    seen.add(pc)
    inst := re.insts[pc]
    if inst.op == OP_JMP:
        add_thread(re, list_pcs, list_slots, seen, inst.a, slots, pos, input_len)
        return
    if inst.op == OP_SPLIT:
        add_thread(re, list_pcs, list_slots, seen, inst.a, slots, pos, input_len)
        add_thread(re, list_pcs, list_slots, seen, inst.b, slots, pos, input_len)
        return
    if inst.op == OP_SAVE:
        mut copied: List[Int] := []
        for v in slots:
            copied.push(v)
        while copied.len() <= inst.a:
            copied.push(0 - 1)
        copied[inst.a] = pos
        add_thread(re, list_pcs, list_slots, seen, pc + 1, copied, pos, input_len)
        return
    if inst.op == OP_BOL:
        if pos == 0:
            add_thread(re, list_pcs, list_slots, seen, pc + 1, slots, pos, input_len)
        return
    if inst.op == OP_EOL:
        if pos == input_len:
            add_thread(re, list_pcs, list_slots, seen, pc + 1, slots, pos, input_len)
        return
    list_pcs.push(pc)
    list_slots.push(slots)

# run the vm once from `start` to the end of the input. a fresh thread
# enters at pc 0 at every character boundary until a match is recorded,
# with lower priority than every thread already running, so the threads
# from an earlier start always win. this is the unanchored search that
# re2 and go use: one pass over the input instead of one pass per start
# offset. returns the capture slots of the leftmost-first match, or an
# empty list.
#
# a start inside a multi-byte character is skipped: its match would fail
# slots_aligned anyway.
fn run_from(re: Regex, input: String, start: Int) -> List[Int]:
    mut cur_pcs: List[Int] := []
    mut cur_slots: List[List[Int]] := []
    mut seen: Set[Int] := {}
    n := input.len()
    entry := entry_pcs(re)
    mut best: List[Int] := []
    mut pos := start
    while pos <= n:
        mut code := 0 - 1
        if pos < n:
            code = ord(input[pos])
        # a continuation byte (0x80-0xbf) is not a character boundary
        if best.len() == 0 and (code < 128 or code >= 192) and not all_seen(seen, entry):
            mut init: List[Int] := []
            add_thread(re, cur_pcs, cur_slots, seen, 0, init, pos, n)
        if cur_pcs.len() == 0:
            if best.len() > 0:
                return best
            # no thread survived: move on without building empty lists
            seen.clear()
            pos = pos + 1
            continue
        mut next_pcs: List[Int] := []
        mut next_slots: List[List[Int]] := []
        mut next_seen: Set[Int] := {}
        mut thread_index := 0
        mut matched_this_round := false
        while thread_index < cur_pcs.len() and not matched_this_round:
            inst := re.insts[cur_pcs[thread_index]]
            slots := cur_slots[thread_index]
            if inst.op == OP_MATCH:
                # highest-priority thread that matched at this length;
                # later threads are lower priority, stop scanning them
                best = slots
                matched_this_round = true
            elif inst.op == OP_CHAR:
                if code == inst.a:
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            elif inst.op == OP_ANY:
                if code >= 0 and code != 10:
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            elif inst.op == OP_CLASS:
                if code >= 0 and class_matches(re.classes[inst.a], code):
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            thread_index = thread_index + 1
        cur_pcs = next_pcs
        cur_slots = next_slots
        seen = next_seen
        pos = pos + 1
    return best

# the instructions that consume input or match, reachable from pc 0
# through control instructions. a new start whose every one of these
# already holds a thread would only be dropped as a duplicate.
fn entry_pcs(re: Regex) -> List[Int]:
    mut out: List[Int] := []
    mut visited: Set[Int] := {}
    collect_entry(re, 0, visited, out)
    return out

fn collect_entry(re: Regex, pc: Int, visited: Set[Int], out: List[Int]):
    if visited.contains(pc):
        return
    visited.add(pc)
    inst := re.insts[pc]
    if inst.op == OP_JMP:
        collect_entry(re, inst.a, visited, out)
    elif inst.op == OP_SPLIT:
        collect_entry(re, inst.a, visited, out)
        collect_entry(re, inst.b, visited, out)
    elif inst.op == OP_SAVE or inst.op == OP_BOL or inst.op == OP_EOL:
        collect_entry(re, pc + 1, visited, out)
    else:
        out.push(pc)

fn all_seen(seen: Set[Int], pcs: List[Int]) -> Bool:
    for pc in pcs:
        if not seen.contains(pc):
            return false
    return true

# the leftmost match at or after `start` whose offsets all fall on
# character boundaries. a match that cuts a character is rejected and the
# search resumes one byte past its start, which is what trying each start
# offset in turn would have found.
fn search(re: Regex, input: String, start: Int) -> List[Int]:
    mut at := start
    while at <= input.len():
        slots := run_from(re, input, at)
        if slots.len() < 2:
            return []
        if slots_aligned(input, slots):
            return slots
        at = slots[0] + 1
    return []

# true when `at` is where a character starts.
fn on_boundary(input: String, at: Int) -> Bool:
    if at <= 0 or at >= input.len():
        return true
    code := ord(input[at])
    return code < 128 or code >= 192

# true when every offset the vm recorded lands where a character starts.
#
# the vm steps one byte at a time, so an instruction that accepts a single byte
# — `.` and every negated class do — can leave a match ending halfway through a
# multi-byte character. a String is cut in bytes and a cut inside a character
# stops the process outright, so a span that does not line up with the text is
# treated as no match at this position and the search moves on rather than
# taking the program down: `compile(".")!.find("é")` used to end the process.
#
# what that leaves is a byte-oriented engine reported in a way text can survive.
# `.` matches one byte, so on its own it does not match a two-byte character,
# while `..`, `.+` and `[^,]+` match one whole. ascii is unaffected — every
# offset in it is a boundary — which is every pattern and every input the
# engine had tests for.
fn slots_aligned(input: String, slots: List[Int]) -> Bool:
    mut i := 0
    while i < slots.len():
        if slots[i] >= 0 and not on_boundary(input, slots[i]):
            return false
        i = i + 1
    return true

impl Regex:
    ## true when the pattern matches anywhere in the input.
    pub fn is_match(input: String) -> Bool:
        return self.find(input) != none

    ## the leftmost match, or none.
    pub fn find(input: String) -> Match?:
        slots := search(self, input, 0)
        if slots.len() < 2:
            return none
        return Match(slots[0], slots[1], input.substring(slots[0], slots[1]))

    ## capture groups of the leftmost match: index 0 is the whole
    ## match, then one entry per group (empty string when unmatched).
    pub fn captures(input: String) -> List[String]?:
        slots := search(self, input, 0)
        if slots.len() < 2:
            return none
        mut out: List[String] := []
        mut g := 0
        while g < self.ngroups:
            lo_i := g * 2
            hi_i := g * 2 + 1
            if hi_i < slots.len() and slots[lo_i] >= 0 and slots[hi_i] >= slots[lo_i]:
                out.push(input.substring(slots[lo_i], slots[hi_i]))
            else:
                out.push("")
            g = g + 1
        return out

    ## every non-overlapping match, left to right.
    pub fn find_all(input: String) -> List[Match]:
        mut out: List[Match] := []
        mut start := 0
        while start <= input.len():
            slots := search(self, input, start)
            if slots.len() < 2:
                return out
            stop := slots[1]
            out.push(Match(slots[0], stop, input.substring(slots[0], stop)))
            if stop == slots[0]:
                start = stop + 1
            else:
                start = stop
        return out

    ## replace every match with the replacement text.
    pub fn replace_all(input: String, replacement: String) -> String:
        # collect the pieces and join once at the end: appending each segment
        # to the result string recopied everything accumulated so far, which
        # made replacement quadratic in the number of matches.
        mut parts: List[String] := []
        mut last := 0
        for m in self.find_all(input):
            parts.push(input.substring(last, m.start))
            parts.push(replacement)
            last = m.stop
        parts.push(input.substring(last, input.len()))
        return parts.join("")

test "zero-width patterns match the empty string":
    assert(compile("a*")!.is_match(""))
    assert(compile("^$")!.is_match(""))
    assert(compile("")!.is_match("anything"))

test "greedy quantifier takes the longest run and reports its span":
    m := compile("a+")!.find("baaad")
    assert(m != none)
    assert_eq(m.value().text, "aaa")
    assert_eq(m.value().start, 1)
    assert_eq(m.value().stop, 4)

test "optional and star quantifiers":
    assert(compile("ab?c")!.is_match("ac"))
    assert(not compile("ab?c")!.is_match("abbc"))
    assert(compile("ab*c")!.is_match("ac"))
    assert(compile("ab*c")!.is_match("abbbc"))

test "shorthand classes and their negations":
    assert(compile("\\d+")!.is_match("x9"))
    assert(not compile("\\D+")!.is_match("123"))
    assert(compile("\\w+")!.is_match("a_1"))
    assert(compile("\\S+")!.is_match("  x"))

test "character classes, ranges, and negation":
    assert(compile("[a-z]+")!.is_match("HI there"))
    assert(not compile("[^a-z]+")!.is_match("abc"))
    assert(compile("[.+*]")!.is_match("a+b"))
    assert(compile("[a-]")!.is_match("-"))

test "anchored alternation with groups":
    re := compile("^(cat|dog)$")!
    assert(re.is_match("cat"))
    assert(re.is_match("dog"))
    assert(not re.is_match("cats"))

test "alternation with three or more branches":
    re := compile("^(cat|dog|bird|fish)$")!
    for word in ["cat", "dog", "bird", "fish"]:
        assert(re.is_match(word))
    assert(not re.is_match("cow"))
    starred := compile("^(a*|b+|c?)x$")!
    for text in ["aaax", "bbx", "cx", "x"]:
        assert(starred.is_match(text))
    assert(not starred.is_match("abx"))
    nested := compile("^(a|(b|c|d)|e)$")!
    for text in ["a", "b", "c", "d", "e"]:
        assert(nested.is_match(text))
    empty := compile("^(a||b)$")!
    assert(empty.is_match(""))
    assert(empty.is_match("b"))
    caps := compile("(x|y|z)(\\d)")!.captures("--z7--")?
    assert_eq(caps[1], "z")
    assert_eq(caps[2], "7")

test "escaped metacharacters match literally":
    re := compile("a\\.c")!
    assert(re.is_match("a.c"))
    assert(not re.is_match("abc"))

test "dot does not match a newline":
    assert(not compile("a.b")!.is_match("a\nb"))

test "captures return the full match then each group":
    c := compile("(\\w+)@(\\w+)")!.captures("to kacy@example now")
    assert(c != none)
    assert_eq(c.value(), ["kacy@example", "kacy", "example"])

test "a non-participating group captures the empty string":
    c := compile("(a)?(b)")!.captures("b")
    assert(c != none)
    assert_eq(c.value(), ["b", "", "b"])

test "find and captures return none when nothing matches":
    re := compile("xyz")!
    assert(re.find("abc") == none)
    assert(re.captures("abc") == none)

test "find_all returns non-overlapping matches with spans":
    ms := compile("[0-9]+")!.find_all("a12b345c")
    assert_eq(ms.len(), 2)
    assert_eq(ms[0].text, "12")
    assert_eq(ms[0].start, 1)
    assert_eq(ms[1].text, "345")

test "find_all terminates on a nullable pattern":
    ms := compile("a*")!.find_all("aaa")
    assert(ms.len() >= 1)

test "replace_all handles every match, no match, and vowels":
    assert_eq(compile("[0-9]")!.replace_all("a1b2c3", "#"), "a#b#c#")
    assert_eq(compile("x")!.replace_all("abc", "_"), "abc")
    assert_eq(compile("[aeiou]+")!.replace_all("the quick", "_"), "th_ q_ck")

test "compile rejects unclosed constructs":
    assert(compile("(abc").is_err)
    assert(compile("[a-z").is_err)

test "compile rejects an oversized pattern":
    # a pattern past the length cap is refused before it can overflow the stack
    # (deep nesting) or run the superlinear quantifier path.
    assert(compile("a".repeat(MAX_PATTERN_LEN + 1)).is_err)
    assert(compile("a".repeat(16)).is_ok)
