# a table of cases checked by a shared helper.
#
# the built-in assertions are ordinary calls, not something only a `test` block
# can say, so the check for one row lives in a function and the caller feeds it
# rows. spelling every case out inline is what a table exists to avoid, and it
# is why exhaustive coverage so often does not get written at all.
import std.strings as strings

struct SplitCase:
    name: String
    input: String
    sep: String
    limit: Int
    want: List[String]

fn cases() -> List[SplitCase]:
    return [
        SplitCase("plain", "a,b,c", ",", 8, ["a", "b", "c"]),
        SplitCase("no separator present", "abc", ",", 8, ["abc"]),
        SplitCase("empty fields are kept", "a,,c", ",", 8, ["a", "", "c"]),
        SplitCase("leading and trailing", ",a,", ",", 8, ["", "a", ""]),
        SplitCase("multi-character separator", "a::b", "::", 8, ["a", "b"]),
        SplitCase("the limit counts splits, not fields", "a,b,c,d", ",", 2, ["a", "b", "c,d"]),
    ]

# one row, checked. assert_eq compares lists by content, so a row that differs
# reports both lists rather than two heap addresses.
fn assert_splits(c: SplitCase):
    got := strings.split_n(c.input, c.sep, c.limit)
    assert_eq(got, c.want)
    assert_eq(got.len(), c.want.len())
    assert_ne(c.name, "")

fn main():
    mut checked := 0
    for c in cases():
        assert_splits(c)
        checked = checked + 1

    # a loop that quietly stopped iterating passes just as loudly as one that
    # checked every row, so the row count is an assertion too.
    assert_eq(checked, 6)
    print("{checked} split cases checked")
