# std.metrics - small in-memory metrics for apps and tools
#
# this stays intentionally simple:
# - counters accumulate
# - gauges move up and down
# - histograms keep fixed buckets plus count/sum/min/max

# a monotonically increasing metric.
pub struct Counter:
    pub name: String

# a point-in-time integer value.
pub struct Gauge:
    pub name: String

# a histogram with fixed buckets and integer observations.
pub struct Histogram:
    pub name: String

mut counter_values: Map[String, Float] := {}
mut gauge_values: Map[String, Float] := {}
mut histogram_counts: Map[String, Int] := {}
mut histogram_sums: Map[String, Float] := {}
mut histogram_mins: Map[String, Float] := {}
mut histogram_maxs: Map[String, Float] := {}
mut histogram_bucket_counts: Map[String, Int] := {}

# custom bucket boundaries per bare metric name (see Histogram.buckets). a metric
# with no entry here uses default_histogram_buckets(). all series of one metric
# share its boundaries, so this is keyed by the bare name, not the series key.
mut histogram_bucket_defs: Map[String, List[Float]] := {}

# guards all the metric maps so concurrent updates from separate threads do not
# race. each public operation takes it around its whole read-modify-write; the
# internal helpers (ensure_*, *_value, render_*) assume it is already held.
mut metrics_mu := Mutex()

# label support. a metric can have several series, one per distinct label set
# (e.g. requests_total{route="/api"} vs {route="/"}). an instrument's `name`
# field holds the full SERIES KEY — the bare name for an unlabeled metric, or
# name{k="v",...} for a labeled one — so every op keys off it unchanged. these
# registries map a series key back to its bare name and its label pairs so the
# prometheus text can group series under one # TYPE line and the structured
# snapshot (for OTLP) can hand back typed name/labels/value. guarded by
# metrics_mu like the value maps.
mut series_bare_name: Map[String, String] := {}
mut series_label_pairs: Map[String, List[String]] := {}

# label names follow the same rule as metric names.
fn normalize_label_name(name: String) -> String:
    return normalize_metric_name(name)

# escape a label value for prometheus text: backslash, double-quote, newline.
fn escape_label_value(value: String) -> String:
    mut out := ""
    mut i := 0
    while i < value.len():
        c := value[i]
        if c == chr(92):
            out = out + chr(92) + chr(92)
        elif c == chr(34):
            out = out + chr(92) + chr(34)
        elif c == chr(10):
            out = out + chr(92) + "n"
        else:
            out = out + c
        i = i + 1
    return out

# build the {k="v",...} suffix from [k1,v1,k2,v2,...] with keys sorted so a label
# set has one canonical series key regardless of argument order. empty -> "".
fn label_suffix(pairs: List[String]) -> String:
    if pairs.len() < 2:
        return ""
    mut kv: Map[String, String] := {}
    mut keys: List[String] := []
    mut i := 0
    while i + 1 < pairs.len():
        k := normalize_label_name(pairs[i])
        if not kv.contains_key(k):
            keys.push(k)
        kv.insert(k, pairs[i + 1])
        i = i + 2
    if keys.len() == 0:
        return ""
    sorted := keys.sort()
    mut out := chr(123)
    mut first := true
    for k in sorted:
        if not first:
            out = out + ","
        out = out + k + "=" + chr(34) + escape_label_value(kv[k]) + chr(34)
        first = false
    return out + chr(125)

fn make_series_key(name: String, pairs: List[String]) -> String:
    return name + label_suffix(pairs)

# record a series' bare name and label pairs (idempotent). caller holds the lock.
fn register_series(key: String, name: String, pairs: List[String]):
    if not series_bare_name.contains_key(key):
        series_bare_name.insert(key, name)
        series_label_pairs.insert(key, pairs)

fn default_histogram_buckets() -> List[Float]:
    return [1.0, 5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0, 1000.0, 5000.0]

# the bucket boundaries for a bare metric name: its custom set if one was
# registered (Histogram.buckets), else the defaults. caller holds the lock.
fn buckets_for(bare: String) -> List[Float]:
    if histogram_bucket_defs.contains_key(bare):
        return histogram_bucket_defs[bare]
    return default_histogram_buckets()

# register custom bucket boundaries for a bare metric, first call wins so a
# metric's boundaries stay stable once observations start. caller holds the lock.
fn register_buckets(bare: String, bounds: List[Float]):
    if not histogram_bucket_defs.contains_key(bare):
        histogram_bucket_defs.insert(bare, bounds)

# a stable, human-readable rendering of a float bound or value: whole numbers
# print without a trailing ".0" (so a bucket reads le="5", a count reads "3"),
# fractions print in full. used for prometheus text and bucket keys alike.
fn render_value(v: Float) -> String:
    whole := v.to_int()
    if whole.to_float() == v:
        return whole.to_string()
    return v.to_string()

fn bucket_key(name: String, upper_bound: Float) -> String:
    return name + "|" + render_value(upper_bound)

# the bare metric name behind a series key. caller holds the lock.
fn bare_of(key: String) -> String:
    if series_bare_name.contains_key(key):
        return series_bare_name[key]
    return key

fn metric_name_char(c: String) -> String:
    if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_":
        return c
    return "_"

fn normalize_metric_name(name: String) -> String:
    if name == "":
        return "metric"
    mut out := ""
    mut i := 0
    while i < name.len():
        out = out + metric_name_char(name[i])
        i = i + 1
    if out == "":
        return "metric"
    if out[0] >= "0" and out[0] <= "9":
        return "_" + out
    return out

fn ensure_counter(name: String):
    if not counter_values.contains_key(name):
        counter_values.insert(name, 0.0)

fn ensure_gauge(name: String):
    if not gauge_values.contains_key(name):
        gauge_values.insert(name, 0.0)

# bucket counts are created lazily on first observe, so the boundary set can be
# chosen with Histogram.buckets any time before the first observation.
fn ensure_histogram(name: String):
    if histogram_counts.contains_key(name):
        return
    histogram_counts.insert(name, 0)
    histogram_sums.insert(name, 0.0)
    histogram_mins.insert(name, 0.0)
    histogram_maxs.insert(name, 0.0)

fn counter_value(name: String) -> Float:
    ensure_counter(name)
    return counter_values[name]

fn gauge_value(name: String) -> Float:
    ensure_gauge(name)
    return gauge_values[name]

fn histogram_count(name: String) -> Int:
    ensure_histogram(name)
    return histogram_counts[name]

fn histogram_sum(name: String) -> Float:
    ensure_histogram(name)
    return histogram_sums[name]

fn histogram_min(name: String) -> Float:
    ensure_histogram(name)
    return histogram_mins[name]

fn histogram_max(name: String) -> Float:
    ensure_histogram(name)
    return histogram_maxs[name]

fn histogram_bucket_value(name: String, upper_bound: Float) -> Int:
    key := bucket_key(name, upper_bound)
    if histogram_bucket_counts.contains_key(key):
        return histogram_bucket_counts[key]
    return 0

# collect the series keys of one value map (counter/gauge floats or histogram
# counts) into `names`, skipping any already seen. generic over the value type so
# the same walk serves every map.
fn metric_names_from_values[V](values: Map[String, V], names: List[String], seen: Map[String, Bool]) -> List[String]:
    mut out := names
    for name in values:
        if seen.contains_key(name):
            continue
        seen.insert(name, true)
        out.push(name)
    return out

fn metric_names() -> List[String]:
    mut seen: Map[String, Bool] := {}
    mut names: List[String] := []
    names = metric_names_from_values(counter_values, names, seen)
    names = metric_names_from_values(gauge_values, names, seen)
    names = metric_names_from_values(histogram_counts, names, seen)
    return names.sort()

# drop all in-memory metric values. useful for tests and short-lived tools.
pub fn reset():
    metrics_mu.lock()
    counter_values = {}
    gauge_values = {}
    histogram_counts = {}
    histogram_sums = {}
    histogram_mins = {}
    histogram_maxs = {}
    histogram_bucket_counts = {}
    histogram_bucket_defs = {}
    series_bare_name = {}
    series_label_pairs = {}
    metrics_mu.unlock()

# create or reopen a counter by name.
pub fn counter(name: String) -> Counter:
    normalized := normalize_metric_name(name)
    metrics_mu.lock()
    register_series(normalized, normalized, [])
    ensure_counter(normalized)
    metrics_mu.unlock()
    return Counter(normalized)

# create or reopen a gauge by name.
pub fn gauge(name: String) -> Gauge:
    normalized := normalize_metric_name(name)
    metrics_mu.lock()
    register_series(normalized, normalized, [])
    ensure_gauge(normalized)
    metrics_mu.unlock()
    return Gauge(normalized)

# create or reopen a histogram by name.
pub fn histogram(name: String) -> Histogram:
    normalized := normalize_metric_name(name)
    metrics_mu.lock()
    register_series(normalized, normalized, [])
    ensure_histogram(normalized)
    metrics_mu.unlock()
    return Histogram(normalized)

# the bare metric name behind an instrument's series key.
fn instrument_bare_name(key: String) -> String:
    metrics_mu.lock()
    mut bare := key
    if series_bare_name.contains_key(key):
        bare = series_bare_name[key]
    metrics_mu.unlock()
    return bare

impl Counter:
    fn inc():
        self.add(1.0)

    fn add(delta: Float):
        metrics_mu.lock()
        ensure_counter(self.name)
        counter_values.insert(self.name, counter_values[self.name] + delta)
        metrics_mu.unlock()

    fn value() -> Float:
        metrics_mu.lock()
        result := counter_value(self.name)
        metrics_mu.unlock()
        return result

    # a counter for this metric with the given label set. pairs is [k1,v1,k2,v2,
    # ...]; each distinct set is its own series. requests.labels(["route","/api"]).
    fn labels(pairs: List[String]) -> Counter:
        metrics_mu.lock()
        mut bare := self.name
        if series_bare_name.contains_key(self.name):
            bare = series_bare_name[self.name]
        key := make_series_key(bare, pairs)
        register_series(key, bare, pairs)
        ensure_counter(key)
        metrics_mu.unlock()
        return Counter(key)

impl Gauge:
    fn set(value: Float):
        metrics_mu.lock()
        ensure_gauge(self.name)
        gauge_values.insert(self.name, value)
        metrics_mu.unlock()

    fn add(delta: Float):
        metrics_mu.lock()
        ensure_gauge(self.name)
        gauge_values.insert(self.name, gauge_values[self.name] + delta)
        metrics_mu.unlock()

    fn value() -> Float:
        metrics_mu.lock()
        result := gauge_value(self.name)
        metrics_mu.unlock()
        return result

    # a gauge for this metric with the given label set (see Counter.labels).
    fn labels(pairs: List[String]) -> Gauge:
        metrics_mu.lock()
        mut bare := self.name
        if series_bare_name.contains_key(self.name):
            bare = series_bare_name[self.name]
        key := make_series_key(bare, pairs)
        register_series(key, bare, pairs)
        ensure_gauge(key)
        metrics_mu.unlock()
        return Gauge(key)

impl Histogram:
    fn observe(value: Float):
        metrics_mu.lock()
        ensure_histogram(self.name)
        next_count := histogram_counts[self.name] + 1
        histogram_counts.insert(self.name, next_count)
        histogram_sums.insert(self.name, histogram_sums[self.name] + value)
        if next_count == 1:
            histogram_mins.insert(self.name, value)
            histogram_maxs.insert(self.name, value)
        else:
            if value < histogram_mins[self.name]:
                histogram_mins.insert(self.name, value)
            if value > histogram_maxs[self.name]:
                histogram_maxs.insert(self.name, value)
        for bucket in buckets_for(bare_of(self.name)):
            if value <= bucket:
                key := bucket_key(self.name, bucket)
                mut current := 0
                if histogram_bucket_counts.contains_key(key):
                    current = histogram_bucket_counts[key]
                histogram_bucket_counts.insert(key, current + 1)
        metrics_mu.unlock()

    # choose this histogram's bucket boundaries (upper bounds, ascending). set it
    # before the first observe; the first call for a metric wins. returns self so
    # it chains: histogram("latency_ms").buckets([0.005, 0.01, 0.05]).
    fn buckets(bounds: List[Float]) -> Histogram:
        metrics_mu.lock()
        register_buckets(bare_of(self.name), bounds)
        metrics_mu.unlock()
        return self

    fn count() -> Int:
        metrics_mu.lock()
        result := histogram_count(self.name)
        metrics_mu.unlock()
        return result

    fn sum() -> Float:
        metrics_mu.lock()
        result := histogram_sum(self.name)
        metrics_mu.unlock()
        return result

    fn min() -> Float:
        metrics_mu.lock()
        result := histogram_min(self.name)
        metrics_mu.unlock()
        return result

    fn max() -> Float:
        metrics_mu.lock()
        result := histogram_max(self.name)
        metrics_mu.unlock()
        return result

    # a histogram for this metric with the given label set (see Counter.labels).
    fn labels(pairs: List[String]) -> Histogram:
        metrics_mu.lock()
        mut bare := self.name
        if series_bare_name.contains_key(self.name):
            bare = series_bare_name[self.name]
        key := make_series_key(bare, pairs)
        register_series(key, bare, pairs)
        ensure_histogram(key)
        metrics_mu.unlock()
        return Histogram(key)

# which value maps hold this series key. caller holds the lock.
fn series_kind(key: String) -> String:
    if counter_values.contains_key(key):
        return "counter"
    if gauge_values.contains_key(key):
        return "gauge"
    return "histogram"

fn series_pairs(key: String) -> List[String]:
    if series_label_pairs.contains_key(key):
        return series_label_pairs[key]
    return []

# a copy of `pairs` with one more k=v appended, for adding le to a bucket line.
fn append_pair(pairs: List[String], k: String, v: String) -> List[String]:
    mut out: List[String] := []
    for p in pairs:
        out.push(p)
    out.push(k)
    out.push(v)
    return out

# the value line(s) for one series. the # TYPE line is emitted once per metric
# name by snapshot_text. `key` is the full series key (name{labels}); `bare` is
# the metric name; `pairs` are its [k,v,...] labels. caller holds the lock.
fn render_series_lines(key: String, bare: String, pairs: List[String], kind: String) -> List[String]:
    mut lines: List[String] := []
    if kind == "counter":
        lines.push(key + " " + render_value(counter_value(key)))
        return lines
    if kind == "gauge":
        lines.push(key + " " + render_value(gauge_value(key)))
        return lines
    # histogram: buckets carry the series labels plus le; count/sum/min/max carry
    # just the series labels.
    for bucket in buckets_for(bare):
        le := append_pair(pairs, "le", render_value(bucket))
        lines.push(bare + "_bucket" + label_suffix(le) + " " + histogram_bucket_value(key, bucket).to_string())
    inf := append_pair(pairs, "le", "+Inf")
    lines.push(bare + "_bucket" + label_suffix(inf) + " " + histogram_count(key).to_string())
    suffix := label_suffix(pairs)
    lines.push(bare + "_count" + suffix + " " + histogram_count(key).to_string())
    lines.push(bare + "_sum" + suffix + " " + render_value(histogram_sum(key)))
    if histogram_count(key) > 0:
        lines.push(bare + "_min" + suffix + " " + render_value(histogram_min(key)))
        lines.push(bare + "_max" + suffix + " " + render_value(histogram_max(key)))
    return lines

# export a stable prometheus-text snapshot of all series. series of the same
# metric share one # TYPE line; each series carries its labels.
pub fn snapshot_text() -> String:
    metrics_mu.lock()
    keys := metric_names()
    mut lines: List[String] := []
    mut typed: Map[String, Bool] := {}
    for key in keys:
        mut bare := key
        if series_bare_name.contains_key(key):
            bare = series_bare_name[key]
        kind := series_kind(key)
        if not typed.contains_key(bare):
            lines.push("# TYPE " + bare + " " + kind)
            typed.insert(bare, true)
        for line in render_series_lines(key, bare, series_pairs(key), kind):
            lines.push(line)
    metrics_mu.unlock()
    return lines.join(chr(10))

# a typed view of one metric series, for building OTLP data points.
pub struct MetricSample:
    pub name: String        # bare metric name
    pub kind: String        # "counter" | "gauge" | "histogram"
    pub labels: List[String]  # [k1,v1,k2,v2,...]
    pub value: Float        # counter/gauge value, or histogram observation count
    pub sum: Float          # histogram sum of observations (0 for counter/gauge)

# a structured snapshot of every series, one MetricSample each. gives an OTLP
# exporter typed name/labels/value without parsing the prometheus text.
pub fn snapshot() -> List[MetricSample]:
    metrics_mu.lock()
    mut out: List[MetricSample] := []
    for key in metric_names():
        bare := bare_of(key)
        kind := series_kind(key)
        mut value := 0.0
        mut sum := 0.0
        if kind == "counter":
            value = counter_value(key)
        elif kind == "gauge":
            value = gauge_value(key)
        else:
            value = histogram_count(key).to_float()
            sum = histogram_sum(key)
        out.push(MetricSample(bare, kind, series_pairs(key), value, sum))
    metrics_mu.unlock()
    return out

test "metrics counters and gauges normalize names and store values":
    reset()
    requests := counter("requests total")
    inflight := gauge("requests in flight")

    requests.inc()
    requests.add(2.0)
    inflight.set(3.0)
    inflight.add(0.0 - 1.0)

    snapshot := snapshot_text()
    assert_eq(requests.value(), 3.0)
    assert_eq(inflight.value(), 2.0)
    assert(snapshot.contains("# TYPE requests_total counter"))
    assert(snapshot.contains("requests_total 3"))
    assert(snapshot.contains("# TYPE requests_in_flight gauge"))
    assert(snapshot.contains("requests_in_flight 2"))

test "metrics histograms export bucketed text":
    reset()
    latency := histogram("request latency ms")

    latency.observe(4.0)
    latency.observe(30.0)

    snapshot := snapshot_text()
    assert_eq(latency.count(), 2)
    assert_eq(latency.sum(), 34.0)
    assert_eq(latency.min(), 4.0)
    assert_eq(latency.max(), 30.0)
    assert(snapshot.contains("# TYPE request_latency_ms histogram"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "5" + chr(34) + chr(125) + " 1"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "50" + chr(34) + chr(125) + " 2"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "+Inf" + chr(34) + chr(125) + " 2"))
    assert(snapshot.contains("request_latency_ms_count 2"))
    assert(snapshot.contains("request_latency_ms_sum 34"))

fn stress_counter(name: String, times: Int) -> Int:
    c := counter(name)
    mut i := 0
    while i < times:
        c.inc()
        i = i + 1
    return times

fn stress_histogram(name: String, times: Int) -> Int:
    h := histogram(name)
    mut i := 0
    while i < times:
        h.observe(7.0)
        i = i + 1
    return times

test "metrics stay exact under concurrent updates":
    reset()
    per := 2000
    ca := spawn stress_counter("concurrent hits", per)
    cb := spawn stress_counter("concurrent hits", per)
    cc := spawn stress_counter("concurrent hits", per)
    cd := spawn stress_counter("concurrent hits", per)
    ce := spawn stress_counter("concurrent hits", per)
    cf := spawn stress_counter("concurrent hits", per)
    cg := spawn stress_counter("concurrent hits", per)
    ch := spawn stress_counter("concurrent hits", per)
    ha := spawn stress_histogram("concurrent obs", per)
    hb := spawn stress_histogram("concurrent obs", per)
    hc := spawn stress_histogram("concurrent obs", per)
    hd := spawn stress_histogram("concurrent obs", per)

    mut counted := 0
    counted = counted + await ca
    counted = counted + await cb
    counted = counted + await cc
    counted = counted + await cd
    counted = counted + await ce
    counted = counted + await cf
    counted = counted + await cg
    counted = counted + await ch
    mut observed := 0
    observed = observed + await ha
    observed = observed + await hb
    observed = observed + await hc
    observed = observed + await hd

    assert_eq(counted, per * 8)
    assert_eq(counter("concurrent hits").value(), (per * 8).to_float())
    assert_eq(observed, per * 4)
    assert_eq(histogram("concurrent obs").count(), per * 4)
    assert_eq(histogram("concurrent obs").sum(), (per * 4 * 7).to_float())

test "labels create independent series and render with a shared TYPE line":
    reset()
    reqs := counter("http_requests_total")
    reqs.labels(["route", "/api", "method", "GET"]).inc()
    reqs.labels(["route", "/api", "method", "GET"]).add(2.0)
    reqs.labels(["route", "/health", "method", "GET"]).inc()

    # each distinct label set is its own series; keys are sorted for a canonical form
    assert_eq(reqs.labels(["method", "GET", "route", "/api"]).value(), 3.0)
    assert_eq(reqs.labels(["route", "/health", "method", "GET"]).value(), 1.0)

    text := snapshot_text()
    # one TYPE line for the metric, one line per series with sorted labels
    assert(text.contains("# TYPE http_requests_total counter"))
    assert(text.contains("http_requests_total" + chr(123) + "method=" + chr(34) + "GET" + chr(34) + ",route=" + chr(34) + "/api" + chr(34) + chr(125) + " 3"))

test "structured snapshot reports typed samples with labels":
    reset()
    gauge("inflight").labels(["pool", "db"]).set(4.0)
    histogram("latency_ms").labels(["route", "/api"]).observe(7.0)
    histogram("latency_ms").labels(["route", "/api"]).observe(120.0)

    mut found_gauge := false
    mut found_hist := false
    for s in snapshot():
        if s.name == "inflight" and s.labels.len() == 2:
            assert_eq(s.kind, "gauge")
            assert_eq(s.value, 4.0)
            found_gauge = true
        if s.name == "latency_ms" and s.labels.len() == 2:
            assert_eq(s.kind, "histogram")
            assert_eq(s.value, 2.0)
            assert_eq(s.sum, 127.0)
            found_hist = true
    assert(found_gauge)
    assert(found_hist)

test "counters and gauges carry fractional values":
    reset()
    errors := counter("error_ratio")
    errors.add(0.5)
    errors.add(0.25)
    temp := gauge("cpu_load")
    temp.set(1.75)

    assert_eq(errors.value(), 0.75)
    assert_eq(temp.value(), 1.75)
    text := snapshot_text()
    assert(text.contains("error_ratio 0.75"))
    assert(text.contains("cpu_load 1.75"))

test "whole float values render without a trailing decimal":
    reset()
    counter("requests_total").add(5.0)
    gauge("workers").set(3.0)
    histogram("latency_ms").observe(2.0)

    text := snapshot_text()
    # prometheus is happy with 5.0, but 5 is the conventional rendering and what
    # the pre-float text emitted, so whole numbers stay integer-clean.
    assert(text.contains("requests_total 5"))
    assert(not text.contains("requests_total 5.0"))
    assert(text.contains("workers 3"))
    assert(text.contains("latency_ms_sum 2"))

test "custom histogram buckets replace the defaults":
    reset()
    # a latency histogram in seconds wants sub-second boundaries, not the 1..5000 default.
    lat := histogram("request_seconds").buckets([0.005, 0.01, 0.025, 0.1, 0.5])
    lat.observe(0.003)
    lat.observe(0.02)
    lat.observe(0.2)

    text := snapshot_text()
    # 0.003 and 0.02 fall at/under 0.025; 0.2 only at/under 0.5.
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "0.025" + chr(34) + chr(125) + " 2"))
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "0.5" + chr(34) + chr(125) + " 3"))
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "+Inf" + chr(34) + chr(125) + " 3"))
    # the default 1..5000 boundaries must not appear for this metric.
    assert(not text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "5000" + chr(34)))
    assert_eq(lat.count(), 3)
