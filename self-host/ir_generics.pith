# ir_generics.pith - generic function metadata helpers

from ast import get_node, Node
from ir_names import ir_import_target_name
from ir_type_helpers import ir_resolve_type_hint_with_state, ir_resolve_result_type_kind
from ir_method_tables import ir_func_returns
from ir_utils import ir_push_string

## true for any function-declaration node kind.
pub fn ir_is_fn_decl_kind(kind: String) -> Bool:
    return kind == "fn" or kind == "fn_decl"

## true when the declaration carries generic parameters.
pub fn ir_has_generic_params(node: Node) -> Bool:
    for child in node.children:
        if get_node(child).kind == "generic_param":
            return true
    return false

## the declaration's generic parameter names, in order.
pub fn ir_collect_generic_param_names(node: Node) -> List[String]:
    mut names: List[String] := []
    mut i := 0
    while i < node.children.len():
        child := get_node(node.children[i])
        if child.kind == "generic_param":
            names.push(child.value)
        i = i + 1
    return names

## the n-th parameter name of a function node, or "".
pub fn ir_param_name_at(fn_idx: Int, param_index: Int) -> String:
    node := get_node(fn_idx)
    mut seen := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if seen == param_index:
                return cn.value
            seen = seen + 1
    return ""

## prefer a name that names a generic declaration.
pub fn ir_generic_preferred_name_with_state(preferred: String, fallback: String, generic_decl_indices: Map[String, Int]) -> String:
    if generic_decl_indices.contains_key(preferred):
        return preferred
    return fallback

## the generic json decode helper name for a type, or "".
pub fn ir_json_generic_name_with_state(base_name: String, generic_decl_indices: Map[String, Int]) -> String:
    return ir_generic_preferred_name_with_state("std_json_" + base_name, base_name, generic_decl_indices)

## the generic config decode helper name for a type, or "".
pub fn ir_config_generic_name_with_state(base_name: String, generic_decl_indices: Map[String, Int]) -> String:
    return ir_generic_preferred_name_with_state("std_config_" + base_name, base_name, generic_decl_indices)

## resolve alias.generic_fn() to its qualified name, or "".
pub fn ir_resolve_generic_module_call_name(module_path: String, member_name: String) -> String:
    if module_path.len() > 0:
        return ir_import_target_name(module_path, member_name)
    return member_name

## the generic handle-pool decode helper name for a type, or "".
pub fn ir_handle_generic_name_with_state(base_name: String, module_path: String, generic_decl_indices: Map[String, Int]) -> String:
    preferred := ir_resolve_generic_module_call_name(module_path, base_name)
    return ir_generic_preferred_name_with_state(preferred, base_name, generic_decl_indices)

## pack type names into one string for storage.
pub fn ir_encode_type_list(type_names: List[String]) -> String:
    return type_names.join(chr(9))

## unpack a stored type-name list.
pub fn ir_decode_type_list(encoded: String) -> List[String]:
    if encoded.len() == 0:
        return []
    return encoded.split(chr(9))

## the dedupe key for one specialization request.
pub fn ir_generic_specialization_key(name: String, type_names: List[String]) -> String:
    return name + chr(9) + ir_encode_type_list(type_names)

fn ir_sanitize_symbol_part(name: String) -> String:
    mut out := ""
    mut i := 0
    while i < name.len():
        ch := name[i]
        if ch == "[" or ch == "]" or ch == "," or ch == " " or ch == "." or ch == ":":
            out = out + "_"
        else:
            out = out + ch
        i = i + 1
    return out

## the emitted symbol name for one specialization.
pub fn ir_generic_specialization_name(name: String, type_names: List[String]) -> String:
    mut suffix_parts: List[String] := []
    for type_name in type_names:
        suffix_parts.push(ir_sanitize_symbol_part(type_name))
    return name + "__" + suffix_parts.join("_")

## substitute generic parameters in a type name.
pub fn ir_specialize_type_name_with_state(name: String, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    for generic_param, i in generic_params:
        if i < concrete_types.len() and generic_param == name:
            return concrete_types[i]
    return ir_resolve_type_hint_with_state(name, type_aliases, struct_names)

## resolve a type node under a generic substitution.
pub fn ir_resolve_type_node_with_subst_with_state(type_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    tn := get_node(type_idx)
    if tn.kind == "type":
        return ir_resolve_type_hint_with_state(ir_specialize_type_name_with_state(tn.value, generic_params, concrete_types, type_aliases, struct_names), type_aliases, struct_names)
    if tn.kind == "generic_type":
        if tn.value == "List":
            if tn.children.len() > 0:
                inner := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if inner == "string":
                    return "list_string"
            return "list"
        if tn.value == "Map":
            if tn.children.len() > 0:
                key_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if key_type == "int":
                    return "map_int"
            return "map"
        if tn.value == "Set":
            if tn.children.len() > 0:
                elem_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if elem_type == "int":
                    return "set_int"
            return "set"
        return ir_resolve_type_hint_with_state(tn.value, type_aliases, struct_names)
    if tn.kind == "result_type" and tn.children.len() > 0:
        inner_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
        return ir_resolve_result_type_kind(inner_type)
    if tn.kind == "optional_type" and tn.children.len() > 0:
        return "tuple"
    if tn.kind == "fn_type":
        return "closure"
    if tn.kind == "tuple_type":
        return "tuple"
    return ""

## a function node's return type under substitution.
pub fn ir_extract_return_type_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "type" or rn.kind == "generic_type" or rn.kind == "result_type" or rn.kind == "optional_type":
                    return ir_resolve_type_node_with_subst_with_state(returns_child, generic_params, concrete_types, type_aliases, struct_names)
    return "unknown"

## the inner type of an optional return under substitution.
pub fn ir_extract_optional_inner_type_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "optional_type" and rn.children.len() > 0:
                    return ir_resolve_type_node_with_subst_with_state(rn.children[0], generic_params, concrete_types, type_aliases, struct_names)
    return ""

## parameter type names under a generic substitution.
pub fn ir_extract_param_types_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> List[String]:
    node := get_node(fn_idx)
    mut param_types: List[String] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                param_types.push(ir_resolve_type_node_with_subst_with_state(cn.children[0], generic_params, concrete_types, type_aliases, struct_names))
            else:
                param_types.push("")
    return param_types

# the generic instantiation registry: which generic declarations
# exist (by module-qualified name), and which specializations have
# been requested, named, and emitted.
pub mut ir_generic_decl_indices: Map[String, Int] := {}
pub mut ir_generic_decl_module_paths: Map[String, String] := {}
pub mut ir_generic_specialization_keys: List[String] := []
pub mut ir_generic_specialization_names: Map[String, String] := {}
pub mut ir_generic_specialization_type_lists: Map[String, String] := {}
pub mut ir_generic_emitted_specializations: Map[String, Int] := {}
## Per-spec arg-tid list encoded as tab-joined ints. Populated on demand at
## call sites where the arg tids are structurally richer than the
## emission-kind concrete_types list. Used by the emitter to recover the
## concrete Optional tid inside a specialization body (concrete_types
## flattens Optional to "tuple").
pub mut ir_generic_specialization_arg_tids: Map[String, String] := {}
## The impl target of every generic declaration that is a method rather than a
## free function, keyed by the same symbol name ir_generic_decl_indices uses.
## A method's specialization takes a leading self parameter and emits inside
## its impl's context; nothing else about it differs from a free function's.
pub mut ir_generic_method_owners: Map[String, String] := {}

## file a generic declaration under its module-qualified name.
pub fn ir_record_generic_function_decl(item_idx: Int, node: Node, module_path: String):
    mut full_name := node.value
    if module_path.len() > 0:
        full_name = ir_import_target_name(module_path, node.value)
    ir_generic_decl_indices.insert(full_name, item_idx)
    ir_generic_decl_module_paths.insert(full_name, module_path)

## true when the name is a recorded generic declaration.
pub fn ir_is_generic_function_name(name: String) -> Bool:
    return ir_generic_decl_indices.contains_key(name)

## file a generic impl method under the symbol dispatch resolves it to.
pub fn ir_record_generic_method_decl(method_idx: Int, full_name: String, impl_type: String, module_path: String):
    ir_generic_decl_indices.insert(full_name, method_idx)
    ir_generic_decl_module_paths.insert(full_name, module_path)
    ir_generic_method_owners.insert(full_name, impl_type)

## true when the name is a recorded generic impl method.
pub fn ir_is_generic_method_name(name: String) -> Bool:
    return ir_generic_method_owners.contains_key(name)

## prefer a name that names a generic declaration.
pub fn ir_generic_preferred_name(preferred: String, fallback: String) -> String:
    return ir_generic_preferred_name_with_state(preferred, fallback, ir_generic_decl_indices)

## request a specialization; names it and records its types once.
pub fn ir_queue_generic_specialization(name: String, arg_types: List[String], ret_type: String) -> String:
    key := ir_generic_specialization_key(name, arg_types)
    if ir_generic_specialization_names.contains_key(key):
        return ir_generic_specialization_names[key]
    spec_name := ir_generic_specialization_name(name, arg_types)
    ir_generic_specialization_keys = ir_push_string(ir_generic_specialization_keys, key)
    ir_generic_specialization_names.insert(key, spec_name)
    ir_generic_specialization_type_lists.insert(key, ir_encode_type_list(arg_types))
    ir_func_returns.insert(spec_name, ret_type)
    return spec_name

## record arg tids for a spec-key so the emitter can recover Optional
## inner types the emission-kind concrete_types list flattened. Safe to
## call multiple times per key — first record wins (later callers of the
## same spec have equivalent arg tids by construction).
pub fn ir_record_generic_spec_arg_tids(name: String, arg_types: List[String], arg_tids: List[Int]):
    key := ir_generic_specialization_key(name, arg_types)
    if ir_generic_specialization_arg_tids.contains_key(key):
        return
    mut encoded := ""
    for tid, i in arg_tids:
        if i > 0:
            encoded = encoded + chr(9)
        encoded = encoded + tid.to_string()
    ir_generic_specialization_arg_tids.insert(key, encoded)

## decode a spec's arg tids, or an empty list if none were recorded.
pub fn ir_decode_generic_spec_arg_tids(key: String) -> List[Int]:
    result: List[Int] := []
    if not ir_generic_specialization_arg_tids.contains_key(key):
        return result
    encoded := ir_generic_specialization_arg_tids[key]
    if encoded.len() == 0:
        return result
    for part in encoded.split(chr(9)):
        # parse_int-ish: rebuild the integer manually to avoid stdlib dep
        mut val := 0
        mut neg := false
        mut i := 0
        if part.len() > 0 and part[0] == "-":
            neg = true
            i = 1
        while i < part.len():
            c := part[i]
            if c >= "0" and c <= "9":
                val = val * 10 + (ord(c) - 48)
            i = i + 1
        if neg:
            val = 0 - val
        result.push(val)
    return result
