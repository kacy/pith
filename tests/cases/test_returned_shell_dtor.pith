# a user function returning `T?` builds its Some at the return site, and that
# shell owns its heap payload through __opt_dtor_<kind>. this case pins the
# counts around that ownership: a direct-call extraction for each heap payload
# kind — string, struct, list, map, set, bytes and, since #967, a fn value —
# in each spelling, a forwarded parameter shell whose payload the
# caller's own local still reads afterwards (the shape that must not
# double-free), a discarded call result, and the none path. every subject is
# read back after its extraction, so an over-release faults where it happens.
# the iterator section pins the companion fix: a specialized generic body's
# `List[I.Item]` bind resolves the associated element type and builds a
# tagged list, so `to_list` owns the rows its iterator's destructor-carrying
# shells hand over — before, the rows lived on a leaked count and reading
# them after the iterator died read freed memory.

from std.iter import Iterator, to_list

struct Pt:
    pub val: Int
    pub tag: String

fn make_s(i: Int) -> String?:
    if i < 0:
        return none
    return "name-{i}"

fn make_p(i: Int) -> Pt?:
    if i < 0:
        return none
    return Pt(val: i, tag: "pt-{i}")

fn make_l(i: Int) -> List[String]?:
    if i < 0:
        return none
    mut xs: List[String] := []
    j := i + 1
    xs.push("elem-{i}")
    xs.push("elem-{j}")
    return xs

fn make_m(i: Int) -> Map[String, Int]?:
    if i < 0:
        return none
    mut m: Map[String, Int] := {}
    m.insert("k-{i}", i)
    return m

fn make_set(i: Int) -> Set[Int]?:
    if i < 0:
        return none
    mut s: Set[Int] := {i, i + 1}
    return s

fn make_b(i: Int) -> Bytes?:
    if i < 0:
        return none
    return bytes_from_string_utf8("bytes-{i}")

fn base_fn(x: Int) -> Int:
    return x

fn make_f(i: Int) -> (fn(Int) -> Int)?:
    if i < 0:
        return none
    return fn(x: Int) => x + i

fn fwd(v: String?) -> String?:
    return v

struct It3:
    mut rows: List[Pt]
    mut pos: Int

impl Iterator for It3:
    type Item = Pt
    fn next() -> Pt?:
        if self.pos >= self.rows.len():
            return none
        r := self.rows[self.pos]
        self.pos = self.pos + 1
        return r

fn collected() -> Int:
    all := to_list(It3(rows: [Pt(val: 1, tag: "a"), Pt(val: 2, tag: "bb")], pos: 0))
    first := all[0]
    return first.val + first.tag.len() + all[1].tag.len() + all.len()

fn direct_cells() -> Int:
    mut n := make_s(3).unwrap_or("d").len()
    n = n + make_s(4).value().len()
    if let v = make_s(5):
        n = n + v.len()
    p := make_p(6).unwrap_or(Pt(val: 0, tag: "z"))
    n = n + p.val + p.tag.len()
    dl: List[String] := []
    n = n + make_l(7).unwrap_or(dl).len()
    n = n + dl.len()
    if let xs = make_l(8):
        n = n + xs[0].len() + xs.len()
    return n

# the remaining heap payload kinds behind a returned Some, each extracted
# and read back so an over-release faults where it happens: a map through
# an `if let` and an `unwrap_or` default, a set through `if let` plus a
# membership read, bytes through `.value()`, and the none path for each.
fn more_kinds() -> Int:
    mut n := 0
    if let m = make_m(20):
        n = n + m.len() + m.get("k-20").unwrap_or(0 - 1)
    dm: Map[String, Int] := {}
    n = n + make_m(21).unwrap_or(dm).len()
    if let s = make_set(22):
        n = n + s.len()
        if s.contains(22):
            n = n + 1
    b := make_b(23).value()
    n = n + b.len()
    make_m(0 - 1)
    if make_set(0 - 1) == none:
        n = n + 1
    if make_b(0 - 1) == none:
        n = n + 1
    return n

# the fn-value lane the "each heap payload kind" claim above used to skip.
# `(fn(Int) -> Int)?` could not be spelled at all before #967 — the parens read
# as a one-element tuple type — so a closure payload never reached a returned
# shell and __opt_dtor_closure was unreachable. what the shell owns is the
# lambda's capture, so every extraction here calls the fn it pulled out, and
# the last one calls it after the shell that carried it has gone.
fn fn_cells() -> Int:
    mut n := make_f(30).unwrap_or(base_fn)(1)
    n = n + make_f(31).value()(1)
    if let f = make_f(32):
        n = n + f(1)
    n = n + match make_f(33):
        none => 0
        f => f(1)
    n = n + make_f(0 - 1).unwrap_or(base_fn)(1)
    make_f(34)
    if make_f(0 - 1) == none:
        n = n + 1
    mut g := fn(x: Int) => x
    if let h = make_f(35):
        g = h
    n = n + g(1)
    return n

fn forwarded() -> Int:
    o := make_s(9)
    d := fwd(o).unwrap_or("d")
    back := o.unwrap_or("x")
    return d.len() + back.len()

fn discarded() -> Int:
    make_s(10)
    make_p(11)
    make_l(12)
    make_s(0 - 1)
    return 1

# the rebind shape: a call-produced optional bound to a name, extracted,
# rebound to a second name and extracted again. the extraction retains, so
# the second read still sees the payload — and the shell's own release is
# the retain's balance, so neither read double-frees.
fn rebound() -> Int:
    u: String? := make_s(13)
    mut n := u.unwrap_or("?").len()
    v: String? := u
    n = n + v.unwrap_or("?").len()
    return n

fn none_paths() -> Int:
    mut n := make_s(0 - 1).unwrap_or("dd").len()
    if let v = make_p(0 - 1):
        n = n + v.val
    else:
        n = n + 3
    return n

fn main():
    mut rounds := 0
    mut total := 0
    while rounds < 200:
        total = direct_cells() + more_kinds() + fn_cells() + forwarded() + discarded() + none_paths() + collected() + rebound()
        rounds = rounds + 1
    d := direct_cells()
    mk := more_kinds()
    fc := fn_cells()
    f := forwarded()
    x := discarded()
    z := none_paths()
    c := collected()
    rb := rebound()
    print("direct={d}")
    print("kinds={mk}")
    print("fns={fc}")
    print("forwarded={f}")
    print("discarded={x}")
    print("none={z}")
    print("collected={c}")
    print("rebound={rb}")
    print("total={total}")
