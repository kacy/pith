# markdown through a template and through std.web.pages, over and over. a
# round renders a template whose `<%md %>` tags write a document with and
# without heading ids, lists its headings with markdown.toc, splits front
# matter off it, and serves a page with yaml front matter through a layout,
# which parses the yaml, copies it into the context and answers through
# http.serve_content. a context node, a yaml node or a heading that is not
# released moves the peak between the two round counts.
import leakprobe as probe
import std.bytes as bytes
import std.fs as fs
import std.json as json
import std.markdown as markdown
import std.net.http as http
import std.template as template
import std.web as web
import std.web.pages as pages

LAYOUT := "<title><%= title %></title><nav><% for h in toc %><a href=\"#<%= h.id %>\"><%= h.text %></a><% end %></nav><main><%md content %></main>"

fn document(i: Int) -> String:
    return "---\ntitle: round {i}\ntags: [a, b]\n---\n# Heading {i}\n\nsome *text* and a [link](/u) <b>raw</b>\n\n## Heading {i}\n\n- one\n- two\n"

fn request_for(path: String) -> http.HttpRequestBytes:
    return http.HttpRequestBytes(head: bytes.empty(), body: bytes.empty(), method_text: "GET", path_text: path, query_text: "", version_text: "HTTP/1.1", headers_text: "", body_text_cache: "", header_map: {}, query_map: {}, path_parts_cache: [])

fn round(i: Int, page: template.Template, app: web.App) -> Int:
    scope := json.open_scope()
    source := document(i)
    split := markdown.split_front_matter(source) catch:
        json.close_scope(scope)
        return 0
    ctx := template.context().set("content", split.body)
    plain := template.render(page, ctx) catch ""
    with_ids := template.render(page.heading_ids(true), ctx) catch ""
    headings := markdown.toc(split.body, markdown.options())
    served := app.serve(request_for("/page"))
    json.close_scope(scope)
    return plain.len() + with_ids.len() + headings.len() + served.body.len()

fn main() -> Int!:
    root := fs.make_temp_dir("pith-leak-pages-")!
    fs.write(root + "/page.md", document(0))!
    page := template.compile("<main><%md content %></main>") catch:
        return 1
    layout := template.compile(LAYOUT) catch:
        return 1
    app := web.bare().get("/*path", pages.handler(root, layout))
    n := probe.rounds() / 20
    mut total := 0
    for i in 0..n:
        total += round(i, page, app)
    fs.remove_all(root)
    print("{probe.peak_kb()}")
    return 0
