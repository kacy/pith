# std.units — a top-level module that sorts after a nested one
#
# `std.units` sorts after `std.text.casing` by name, but it belongs to the
# `std` group, so it must be listed with `std.namespace` and `std.shapes`
# rather than under a second `std` heading.

# the number of centimetres in a metre.
pub CM_PER_M := 100
