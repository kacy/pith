# std.net.grpc — a minimal unary grpc client and server over pith's native http/2.
#
# grpc is http/2 with a fixed message framing and a status carried in the
# trailers. a unary call POSTs to /<package>.<Service>/<Method> with
# content-type application/grpc, sends one length-prefixed protobuf message as
# the request body, and reads one length-prefixed message back plus a
# grpc-status trailer.
#
# this layer handles the transport and the message framing; it moves raw message
# bytes. build the request and parse the response with std.protobuf (bytes in,
# bytes out), which keeps grpc usable without code generation:
#
#   w := protobuf.writer()
#   w.write_string(1, "pith")!            # DummyMessage { f_string = 1 }
#   reply := grpc.call("grpcb.in", 9001, "/grpcbin.GRPCBin/DummyUnary", w.bytes())!
#   w.free()
#   r := protobuf.reader(reply)           # the echoed DummyMessage
#   ...
#
# call() opens a connection, runs one method, and closes. for several calls,
# dial() a channel once and reuse it — each unary() multiplexes over the one
# http/2 connection:
#
#   ch := grpc.dial("grpcb.in", 9001)!
#   reply := ch.unary("/grpcbin.GRPCBin/DummyUnary", request)!
#   ch.close()
#
# to serve, write a dispatch handler — (path, request bytes) -> reply bytes, or a
# GrpcError — and hand it to serve() or serve_tls(). the server routes each call
# by its /<package>.<Service>/<Method> path to the handler and sends the reply
# back with the grpc-status trailer:
#
#   fn greeter(path, request) -> Bytes!grpc.GrpcError:
#       name := read_name(request) catch "world"
#       return encode_reply("hello, " + name)
#
#   grpc.serve("0.0.0.0", 50051, greeter)!               # plaintext http/2
#   grpc.serve_tls("0.0.0.0", 443, cert, key, greeter)!  # http/2 over tls
#
# the handler lives in a module global, so there is one grpc server per process —
# the usual shape, one service binary per endpoint. that is a deliberate limit: a
# pith closure cannot capture a fn-value, so the handler cannot be threaded in any
# other way.
#
# deferred: streaming rpcs (client/server/bidi), message compression, deadlines
# and metadata beyond the basics, grpc-message percent-decoding, and .proto code
# generation.

import std.net.http2.hpack as hpack
import std.net.http2.connection as http2
import std.net.http2.server as h2server
import std.net.http as http
import std.protobuf as protobuf
import std.bytes as bytes
import std.bits as bits
import std.encoding as encoding
import std.net.tls as tls
import std.trace as trace
import std.metrics as metrics
import std.time as time

# grpc status codes (the grpc-status trailer). 0 is success; the rest are
# errors. see https://grpc.io/docs/guides/status-codes/.
pub GRPC_OK := 0
pub GRPC_CANCELLED := 1
pub GRPC_UNKNOWN := 2
pub GRPC_INVALID_ARGUMENT := 3
pub GRPC_DEADLINE_EXCEEDED := 4
pub GRPC_NOT_FOUND := 5
pub GRPC_ALREADY_EXISTS := 6
pub GRPC_PERMISSION_DENIED := 7
pub GRPC_RESOURCE_EXHAUSTED := 8
pub GRPC_FAILED_PRECONDITION := 9
pub GRPC_ABORTED := 10
pub GRPC_OUT_OF_RANGE := 11
pub GRPC_UNIMPLEMENTED := 12
pub GRPC_INTERNAL := 13
pub GRPC_UNAVAILABLE := 14
pub GRPC_DATA_LOSS := 15
pub GRPC_UNAUTHENTICATED := 16

# a failed grpc call: the numeric grpc-status and the server's message.
pub struct GrpcError:
    pub status: Int
    pub message: String

# the human name of a grpc-status code, for error messages and logging.
pub fn status_name(status: Int) -> String:
    names := ["OK", "CANCELLED", "UNKNOWN", "INVALID_ARGUMENT", "DEADLINE_EXCEEDED", "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED", "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE", "DATA_LOSS", "UNAUTHENTICATED"]
    if status >= 0 and status < names.len():
        return names[status]
    return "CODE_{status}"

# a grpc channel: a reusable connection to one server. dial() opens it, unary()
# runs a method over it — as many as you like, multiplexed over the one http/2
# connection — and close() shuts it down. `authority` is the server host, which
# grpc uses to address the service.
pub struct Conn:
    client: http2.Client
    authority: String

impl Conn:
    # run a unary rpc over this channel. `full_method` is "/package.Service/Method"
    # and `request` is the serialized protobuf request message; the returned bytes
    # are the serialized response message. fails with a GrpcError on a non-OK
    # grpc-status, a malformed response, or a transport error.
    pub fn unary(full_method: String, request: Bytes) -> Bytes!GrpcError:
        no_metadata: List[String] := []
        return self.unary_with_headers(full_method, request, no_metadata)!

    # like unary, but also sends `extra_headers` — a flat [k1, v1, k2, v2, ...]
    # list — as grpc metadata: custom http/2 request headers layered on top of the
    # standard grpc set. this is how a caller passes auth/tenant credentials (e.g.
    # an api key) to a collector. an empty list behaves exactly like unary.
    pub fn unary_with_headers(full_method: String, request: Bytes, extra_headers: List[String]) -> Bytes!GrpcError:
        if not trace.is_active():
            framed := frame_message(request)
            resp := self.client.request("POST", self.authority, full_method, with_metadata(grpc_headers(), extra_headers), framed)
            if resp.is_err:
                fail GrpcError(GRPC_UNAVAILABLE, "grpc transport error: {resp.err}")
            return handle_response(resp.ok)!
        # observability on: a CLIENT span, a traceparent injected into the request
        # headers, and RED metrics — all invisible to the caller.
        span := trace.start_kind(full_method, trace.CLIENT)
        span.set_attr("rpc.system", "grpc").set_attr("rpc.method", full_method)
        framed := frame_message(request)
        started := time.mono_nanos()
        resp := self.client.request("POST", self.authority, full_method, with_metadata(headers_with_traceparent(span.context()), extra_headers), framed)
        if resp.is_err:
            finish_client_span(span, full_method, GRPC_UNAVAILABLE, started)
            fail GrpcError(GRPC_UNAVAILABLE, "grpc transport error: {resp.err}")
        result := handle_response(resp.ok)
        mut status := GRPC_OK
        if result.is_err:
            status = result.err.status
        finish_client_span(span, full_method, status, started)
        return result!

    # close the underlying http/2 connection. the channel cannot be used after.
    pub fn close():
        self.client.close()

# dial a grpc server: open an http/2 connection to host:port over tls with alpn
# "h2" and return a reusable channel. reuse it for many unary() calls and
# close() it when done.
pub fn dial(host: String, port: Int) -> Conn!:
    client := http2.open(host, port)!
    return Conn(client: client, authority: host)

# dial a grpc server using the caller's tls `config` (which must offer alpn
# "h2") — for example one built with tls.client_config_with_ca_file to trust a
# private ca, for a server whose cert the system roots don't cover. otherwise
# like dial.
pub fn dial_with_config(host: String, port: Int, config: tls.Config) -> Conn!:
    client := http2.open_with_config(host, port, config)!
    return Conn(client: client, authority: host)

# make a one-shot unary call: dial host:port, run the method, and close. this is
# the simplest entry point; for several calls over one connection, dial() a
# channel once and reuse it with unary().
pub fn call(host: String, port: Int, full_method: String, request: Bytes) -> Bytes!GrpcError:
    opened := dial(host, port)
    if opened.is_err:
        fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot connect to {host}:{port}: {opened.err}")
    channel := opened.ok
    result := channel.unary(full_method, request)
    channel.close()
    return result!

# --- framing ----------------------------------------------------------------

# the request headers every grpc call sends alongside the four http/2
# pseudo-headers. they are the same on every call, so they are built once and
# shared — the request path only reads them (it copies each field into its own
# list), so a single cached list saves four header allocations per call.
REQUEST_HEADERS := [hpack.header_field("content-type", "application/grpc"), hpack.header_field("te", "trailers"), hpack.header_field("grpc-encoding", "identity"), hpack.header_field("grpc-accept-encoding", "identity")]

fn grpc_headers() -> List[hpack.HeaderField]:
    return REQUEST_HEADERS

# the base grpc headers plus `extra` metadata (a flat [k1, v1, k2, v2, ...] list)
# appended as http/2 header fields. an empty list returns `base` unchanged so the
# common no-metadata call keeps sharing the cached header list; otherwise a fresh
# list is built so the cached one is never mutated. an odd trailing key with no
# value is ignored.
fn with_metadata(base: List[hpack.HeaderField], extra: List[String]) -> List[hpack.HeaderField]:
    if extra.len() == 0:
        return base
    mut fields: List[hpack.HeaderField] := []
    for f in base:
        fields.push(f)
    mut i := 0
    while i + 1 < extra.len():
        fields.push(hpack.header_field(extra[i], extra[i + 1]))
        i = i + 2
    return fields

# the standard grpc headers plus a W3C traceparent for `ctx`, so the server joins
# this trace. builds a fresh list rather than pushing onto the shared cached one.
fn headers_with_traceparent(ctx: trace.SpanContext) -> List[hpack.HeaderField]:
    mut fields: List[hpack.HeaderField] := []
    for f in grpc_headers():
        fields.push(f)
    fields.push(hpack.header_field("traceparent", trace.format_traceparent(ctx)))
    return fields

# the headers for a streaming open: the base grpc headers, plus a traceparent
# carrying the current trace context when one is active — so a streaming rpc
# started inside a span propagates it. off (or no active span) => base headers.
fn stream_headers() -> List[hpack.HeaderField]:
    if not trace.is_active():
        return grpc_headers()
    ctx := trace.current_context()
    if not trace.context_is_valid(ctx):
        return grpc_headers()
    return headers_with_traceparent(ctx)

# set a grpc client span's status from the grpc-status, end it, and record the RED
# metrics (a request counter and a duration histogram) for the call.
fn finish_client_span(span: trace.Span, full_method: String, status: Int, start_ns: Int):
    if status == GRPC_OK:
        span.set_status(trace.STATUS_OK, "")
    else:
        span.set_status(trace.STATUS_ERROR, status_name(status))
    span.set_attr("rpc.grpc.status_code", status.to_string())
    span.end()
    elapsed_ms := (time.mono_nanos() - start_ns) / 1000000
    metrics.counter("rpc_client_requests_total").labels(["rpc_method", full_method, "grpc_status", status_name(status)]).inc()
    metrics.histogram("rpc_client_duration_ms").labels(["rpc_method", full_method]).observe(elapsed_ms.to_float())

# frame a message for the wire: a one-byte compression flag (0 = identity), a
# big-endian uint32 length, then the message bytes. the five prefix bytes are
# written directly rather than through an intermediate list. writes to a fresh
# in-memory buffer cannot fail, so their results are discarded.
fn frame_message(message: Bytes) -> Bytes:
    buf := bytes.buffer()
    n := message.len()
    buf.write_byte(0) catch 0
    buf.write_byte(bits.band(bits.shr(n, 24), 255)) catch 0
    buf.write_byte(bits.band(bits.shr(n, 16), 255)) catch 0
    buf.write_byte(bits.band(bits.shr(n, 8), 255)) catch 0
    buf.write_byte(bits.band(n, 255)) catch 0
    if n > 0:
        buf.write(message) catch 0
    out := buf.bytes()
    buf.free()
    return out

# read one length-prefixed message out of a response body: skip the flag, read
# the big-endian length, and return the message bytes. compression is rejected.
fn parse_message(body: Bytes) -> Bytes!GrpcError:
    if body.len() < 5:
        fail GrpcError(GRPC_INTERNAL, "grpc response frame is shorter than its five-byte header")
    if body[0] != 0:
        fail GrpcError(GRPC_UNIMPLEMENTED, "grpc message compression is not supported")
    length := read_u32(body, 1)
    if 5 + length > body.len():
        fail GrpcError(GRPC_INTERNAL, "grpc response frame length runs past the body")
    return body.slice(5, 5 + length)

# read a big-endian uint32 from `data` at `off`.
fn read_u32(data: Bytes, off: Int) -> Int:
    return bits.bor(bits.bor(bits.shl(data[off], 24), bits.shl(data[off + 1], 16)), bits.bor(bits.shl(data[off + 2], 8), data[off + 3]))

# --- response handling ------------------------------------------------------

# turn a completed http/2 response into the grpc result: the response message
# bytes on OK, or a GrpcError carrying the server's status and message.
fn handle_response(response: http2.Response) -> Bytes!GrpcError:
    return grpc_result(response.status, response.headers, response.trailers, response.body)!

# the core of handle_response, over the response parts directly, so it can be
# driven in tests without constructing a transport Response.
fn grpc_result(http_status: Int, headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField], body: Bytes) -> Bytes!GrpcError:
    status := status_from(headers, trailers, http_status)
    if status != GRPC_OK:
        fail GrpcError(status, message_from(headers, trailers))
    return parse_message(body)!

# the grpc-status: from the trailers if present, else the initial headers (a
# trailers-only error response), else derived from the http status (grpc
# requires 200, so anything else is an error).
fn status_from(headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField], http_status: Int) -> Int:
    if has_header(trailers, "grpc-status"):
        return parse_status(find_header(trailers, "grpc-status"))
    if has_header(headers, "grpc-status"):
        return parse_status(find_header(headers, "grpc-status"))
    if http_status != 200:
        return GRPC_UNKNOWN
    return GRPC_OK

# the grpc-message (the human-readable error detail), from the trailers or the
# initial headers; "" when the server sends none.
fn message_from(headers: List[hpack.HeaderField], trailers: List[hpack.HeaderField]) -> String:
    message := find_header(trailers, "grpc-message")
    if message != "":
        return message
    return find_header(headers, "grpc-message")

# parse a decimal grpc-status value; an empty or non-numeric value reads as 0.
fn parse_status(text: String) -> Int:
    digits := bytes.from_string_utf8(text)
    mut value := 0
    mut i := 0
    while i < digits.len():
        c := digits[i]
        if c < 48 or c > 57:
            return value
        value = (value * 10) + (c - 48)
        i = i + 1
    return value

# the value of a header field by name, or "" when absent.
fn find_header(fields: List[hpack.HeaderField], name: String) -> String:
    for f in fields:
        if f.name == name:
            return f.value
    return ""

# whether a header field is present.
fn has_header(fields: List[hpack.HeaderField], name: String) -> Bool:
    for f in fields:
        if f.name == name:
            return true
    return false

# --- streaming --------------------------------------------------------------

# a grpc message deframer: incoming DATA chunks arrive on arbitrary boundaries,
# so it accumulates bytes and hands back complete length-prefixed messages
# ([1-byte compression flag][4-byte big-endian length][message]) one at a time.
# a chunk may hold zero, one, or many messages, and a message may span chunks.
pub struct Deframer:
    mut buf: Bytes
    mut pos: Int

# a fresh, empty deframer.
pub fn new_deframer() -> Deframer:
    return Deframer(bytes.empty(), 0)

impl Deframer:
    # add a chunk of received bytes. drops the already-consumed prefix first so
    # the buffer stays bounded across a long stream.
    pub fn push(chunk: Bytes):
        if self.pos > 0:
            self.buf = self.buf.slice(self.pos, self.buf.len())
            self.pos = 0
        if chunk.len() > 0:
            self.buf = bytes.concat(self.buf, chunk)

    # whether a complete message is buffered and ready to take with next().
    pub fn ready() -> Bool:
        avail := self.buf.len() - self.pos
        if avail < 5:
            return false
        length := read_u32(self.buf, self.pos + 1)
        return avail >= 5 + length

    # take the next complete message and advance past it. precondition: ready().
    # fails if the message is flagged compressed, which this client does not read.
    pub fn next() -> Bytes!GrpcError:
        if self.buf[self.pos] != 0:
            fail GrpcError(GRPC_UNIMPLEMENTED, "grpc message compression is not supported")
        length := read_u32(self.buf, self.pos + 1)
        msg := self.buf.slice(self.pos + 5, self.pos + 5 + length)
        self.pos = self.pos + 5 + length
        return msg

# one step of a streaming read: `done` is false with the next response `message`,
# or true (with an empty message) once the server has finished the stream.
pub struct StreamMessage:
    pub done: Bool
    pub message: Bytes

# the response-decoding state of a streaming rpc, fed one http/2 stream event at
# a time: a deframer that reassembles messages from DATA chunks, plus the
# response's initial headers and trailers so the terminal grpc-status can be read
# when the stream ends. transport-independent — a live stream and the offline
# tests both drive it the same way.
pub struct StreamReader:
    mut deframer: Deframer
    mut done: Bool
    mut headers: List[hpack.HeaderField]
    mut trailers: List[hpack.HeaderField]

fn new_stream_reader() -> StreamReader:
    empty: List[hpack.HeaderField] := []
    return StreamReader(new_deframer(), false, empty, empty)

impl StreamReader:
    # apply one stream event: a HEADERS block is stored as the response headers or,
    # if it carries grpc-status, the trailers; a DATA chunk feeds the deframer; a
    # RESET fails. an event with `end` finishes the stream.
    fn feed(ev: http2.StreamEvent) -> Int!GrpcError:
        if ev.is_reset():
            fail GrpcError(GRPC_INTERNAL, "grpc: stream reset (error code {ev.error_code})")
        if ev.is_headers():
            if has_header(ev.headers, "grpc-status"):
                self.trailers = ev.headers
            else:
                self.headers = ev.headers
            if ev.end:
                self.done = true
        elif ev.is_data():
            if ev.data.len() > 0:
                self.deframer.push(ev.data)
            if ev.end:
                self.done = true
        return 0

    fn ready() -> Bool:
        return self.deframer.ready()

    fn take() -> Bytes!GrpcError:
        return self.deframer.next()!

    fn finished() -> Bool:
        return self.done

    # the terminal grpc-status, from the trailers (or the initial headers / the
    # http status), read once the stream has finished.
    fn final_status() -> Int:
        mut http_status := parse_status(find_header(self.headers, ":status"))
        if http_status == 0:
            http_status = 200
        return status_from(self.headers, self.trailers, http_status)

    fn final_message() -> String:
        return message_from(self.headers, self.trailers)

# pull one message from an in-progress stream: hand back a buffered message if the
# reader has one, else read stream events until a message completes or the stream
# ends. a StreamMessage with `done` true (empty) marks the end; a non-OK terminal
# grpc-status or a reset fails. shared by server-, and bidi-streaming recv.
fn recv_stream_message(stream: http2.Stream, reader: StreamReader) -> StreamMessage!GrpcError:
    while true:
        if reader.ready():
            return StreamMessage(false, reader.take()!)
        if reader.finished():
            status := reader.final_status()
            if status != GRPC_OK:
                fail GrpcError(status, reader.final_message())
            return StreamMessage(true, bytes.empty())
        evr := stream.recv()
        if evr.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: connection closed mid-stream")
        reader.feed(evr.ok)!
    return StreamMessage(true, bytes.empty())

# frame `message` and send it on `stream` without ending the stream. shared by
# client- and bidi-streaming send. returns the byte count the transport queued;
# a broken connection surfaces on the receive side, not here.
fn send_framed_message(stream: http2.Stream, message: Bytes) -> Int:
    return stream.send(frame_message(message), false)

# half-close the send side: a lone empty DATA frame with END_STREAM, telling the
# server no more request messages follow.
fn half_close_stream(stream: http2.Stream) -> Int:
    return stream.send(bytes.empty(), true)

# a server-streaming call in progress: one request was sent, and recv() pulls the
# response messages as they arrive. `reader` decodes the responses from the
# incremental stream events.
pub struct ServerStream:
    stream: http2.Stream
    reader: StreamReader

impl ServerStream:
    # pull the next response message. returns a StreamMessage whose `done` is
    # false with the message, or true (empty) once the server has finished. fails
    # with a GrpcError if the terminal grpc-status is not OK or the stream resets.
    pub fn recv() -> StreamMessage!GrpcError:
        return recv_stream_message(self.stream, self.reader)!

impl Conn:
    # open a server-streaming rpc: send one request message, then read the stream
    # of responses. `full_method` is "/package.Service/Method". call recv() on the
    # returned ServerStream to pull response messages until it reports done; a
    # non-OK grpc-status surfaces as a GrpcError from recv().
    pub fn server_stream(full_method: String, request: Bytes) -> ServerStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, stream_headers(), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        stream := opened.ok
        stream.send(frame_message(request), true)
        return ServerStream(stream, new_stream_reader())

# collect every message of a server-streaming response into a list, failing on a
# non-OK grpc-status. a convenience for callers that want the whole stream.
pub fn collect_server_stream(stream: ServerStream) -> List[Bytes]!GrpcError:
    mut out: List[Bytes] := []
    while true:
        step := stream.recv()!
        if step.done:
            return out
        out.push(step.message)
    return out

# a client-streaming call in progress: the client sends a sequence of request
# messages with send(), calls close_send() to finish sending, then reads the one
# response with recv_response().
pub struct ClientStream:
    stream: http2.Stream
    reader: StreamReader

impl ClientStream:
    # send one request message. call as many times as needed before close_send().
    pub fn send(message: Bytes) -> Int:
        return send_framed_message(self.stream, message)

    # finish sending: half-close the stream so the server knows the request
    # sequence is complete. call recv_response() after this.
    pub fn close_send() -> Int:
        return half_close_stream(self.stream)

    # read the single response message and the terminal grpc-status. fails with a
    # GrpcError on a non-OK status, a reset, or if the server sent no message.
    pub fn recv_response() -> Bytes!GrpcError:
        mut message := bytes.empty()
        mut got := false
        while true:
            step := recv_stream_message(self.stream, self.reader)!
            if step.done:
                if not got:
                    fail GrpcError(GRPC_INTERNAL, "grpc: client-streaming response carried no message")
                return message
            message = step.message
            got = true
        return message

# a bidirectional-streaming call in progress. the send side (send/close_send) and
# the receive side (recv) are independent — send goes through the connection's
# writer task, recv reads this stream's own event channel — so a caller may drive
# them from two tasks: spawn a sender while the main task recvs.
pub struct BidiStream:
    stream: http2.Stream
    reader: StreamReader

impl BidiStream:
    # send one request message.
    pub fn send(message: Bytes) -> Int:
        return send_framed_message(self.stream, message)

    # finish sending: half-close so the server sees the end of the request stream.
    # the receive side stays open until the server finishes its own stream.
    pub fn close_send() -> Int:
        return half_close_stream(self.stream)

    # pull the next response message: a StreamMessage with `done` false and the
    # message, or true (empty) once the server has finished. fails on a non-OK
    # terminal grpc-status or a reset.
    pub fn recv() -> StreamMessage!GrpcError:
        return recv_stream_message(self.stream, self.reader)!

impl Conn:
    # open a client-streaming rpc: send a sequence of request messages, then read
    # one response. `full_method` is "/package.Service/Method". send() each
    # request, close_send() to finish, then recv_response().
    pub fn client_stream(full_method: String) -> ClientStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, stream_headers(), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        return ClientStream(opened.ok, new_stream_reader())

    # open a bidirectional-streaming rpc: send and receive message streams
    # independently. `full_method` is "/package.Service/Method". send()/close_send()
    # drive the request stream, recv() drains the response stream — the two can run
    # in separate tasks.
    pub fn bidi_stream(full_method: String) -> BidiStream!GrpcError:
        opened := self.client.open_stream("POST", self.authority, full_method, stream_headers(), false)
        if opened.is_err:
            fail GrpcError(GRPC_UNAVAILABLE, "grpc: cannot open stream: {opened.err}")
        return BidiStream(opened.ok, new_stream_reader())

# ----------------------------------------------------------------------------

fn trailer(status: Int) -> List[hpack.HeaderField]:
    return [hpack.header_field("grpc-status", "{status}")]

test "with_metadata appends extra pairs after the base grpc headers":
    extra := ["x-api-key", "secret", "x-tenant", "acme"]
    fields := with_metadata(grpc_headers(), extra)
    # the four cached grpc headers come first, then the two metadata pairs.
    assert_eq(fields.len(), grpc_headers().len() + 2)
    assert_eq(find_header(fields, "x-api-key"), "secret")
    assert_eq(find_header(fields, "x-tenant"), "acme")
    # the standard grpc headers are still present.
    assert_eq(find_header(fields, "content-type"), "application/grpc")

test "with_metadata returns the base list unchanged when there is no metadata":
    empty: List[String] := []
    fields := with_metadata(grpc_headers(), empty)
    # no extra headers: unary's byte-identical behavior is preserved.
    assert_eq(fields.len(), grpc_headers().len())

test "with_metadata ignores a trailing key that has no value":
    fields := with_metadata(grpc_headers(), ["x-only-key"])
    assert_eq(fields.len(), grpc_headers().len())

test "a message frames with a zero flag and a big-endian length":
    framed := frame_message(encoding.from_hex("089601")!)
    assert_eq(encoding.to_hex(framed), "0000000003089601")

test "an empty message frames to just the five-byte header":
    assert_eq(encoding.to_hex(frame_message(bytes.empty())), "0000000000")

test "parse_message round-trips a framed message":
    payload := encoding.from_hex("08961a")!
    assert_eq(parse_message(frame_message(payload))!, payload)

test "parse_message rejects a truncated frame":
    result := parse_message(encoding.from_hex("000000")!)
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_INTERNAL)

test "parse_message rejects a compressed frame":
    result := parse_message(encoding.from_hex("0100000000")!)
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNIMPLEMENTED)

test "parse_status reads a decimal grpc-status":
    assert_eq(parse_status("0"), 0)
    assert_eq(parse_status("5"), 5)
    assert_eq(parse_status("16"), 16)
    assert_eq(parse_status(""), 0)

test "status_name maps the standard codes":
    assert_eq(status_name(GRPC_OK), "OK")
    assert_eq(status_name(GRPC_NOT_FOUND), "NOT_FOUND")
    assert_eq(status_name(GRPC_UNAUTHENTICATED), "UNAUTHENTICATED")

test "an OK response yields the message bytes":
    message := encoding.from_hex("0a0470697468")!
    assert_eq(grpc_result(200, [], trailer(GRPC_OK), frame_message(message))!, message)

test "a non-OK grpc-status becomes a typed error":
    trailers := [hpack.header_field("grpc-status", "5"), hpack.header_field("grpc-message", "missing")]
    result := grpc_result(200, [], trailers, bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_NOT_FOUND)
    assert_eq(result.err.message, "missing")

test "a trailers-only error is read from the initial headers":
    headers := [hpack.header_field("grpc-status", "12")]
    result := grpc_result(200, headers, [], bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNIMPLEMENTED)

test "a non-200 response without a grpc-status is an error":
    result := grpc_result(502, [], [], bytes.empty())
    assert(result.is_err)
    assert_eq(result.err.status, GRPC_UNKNOWN)

test "a protobuf request round-trips through grpc framing":
    w := protobuf.writer()
    w.write_string(1, "pith")!
    request := w.bytes()
    w.free()

    # the server echoes: frame the request as if it were the response body.
    reply := grpc_result(200, [], trailer(GRPC_OK), frame_message(request))!

    r := protobuf.reader(reply)
    tag := r.read_tag()!
    assert_eq(tag.field, 1)
    assert_eq(r.read_string()!, "pith")

test "a private-ca h2 config builds for the dial_with_config path":
    # the config dial_with_config (and http2.open_with_config) accept: trust a
    # private ca from a file and offer alpn "h2". this is what lets a grpc client
    # reach a server whose cert the system roots don't cover — e.g. a local
    # benchmark server. a live dial with it is exercised in tests/live.
    cfg := tls.client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!.with_alpn(["h2"])
    # a real config has a non-negative handle; the error sentinels are negative.
    assert(cfg.handle >= 0)

# --- deframer ---------------------------------------------------------------

test "deframer yields a single message from one push":
    d := new_deframer()
    msg := encoding.from_hex("0a03616263")!
    d.push(frame_message(msg))
    assert(d.ready())
    assert_eq(d.next()!, msg)
    assert(not d.ready())

test "deframer yields two messages from one push":
    d := new_deframer()
    a := encoding.from_hex("01")!
    b := encoding.from_hex("0203")!
    d.push(bytes.concat(frame_message(a), frame_message(b)))
    assert(d.ready())
    assert_eq(d.next()!, a)
    assert(d.ready())
    assert_eq(d.next()!, b)
    assert(not d.ready())

test "deframer reassembles a message split across two pushes":
    d := new_deframer()
    framed := frame_message(encoding.from_hex("deadbeef")!)
    d.push(framed.slice(0, 3))
    assert(not d.ready())
    d.push(framed.slice(3, framed.len()))
    assert(d.ready())
    assert_eq(d.next()!, encoding.from_hex("deadbeef")!)

test "deframer waits for a five-byte prefix split across pushes":
    d := new_deframer()
    framed := frame_message(encoding.from_hex("ff")!)
    d.push(framed.slice(0, 2))
    assert(not d.ready())
    d.push(framed.slice(2, framed.len()))
    assert(d.ready())
    assert_eq(d.next()!, encoding.from_hex("ff")!)

test "deframer handles an empty message":
    d := new_deframer()
    d.push(frame_message(bytes.empty()))
    assert(d.ready())
    assert_eq(d.next()!.len(), 0)
    assert(not d.ready())

test "deframer rejects a compressed message":
    d := new_deframer()
    d.push(encoding.from_hex("010000000155")!)
    assert(d.ready())
    assert(d.next().is_err)

# --- server-stream reader ---------------------------------------------------

test "stream reader deframes messages across events then reads OK status":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200"), hpack.header_field("content-type", "application/grpc")], false))!
    r.feed(http2.data_event(frame_message(encoding.from_hex("0a0161")!), false))!
    assert(r.ready())
    assert_eq(r.take()!, encoding.from_hex("0a0161")!)
    framed := frame_message(encoding.from_hex("0a0263")!)
    r.feed(http2.data_event(framed.slice(0, 3), false))!
    assert(not r.ready())
    r.feed(http2.data_event(framed.slice(3, framed.len()), false))!
    assert(r.ready())
    assert_eq(r.take()!, encoding.from_hex("0a0263")!)
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

test "stream reader surfaces a non-OK trailer status":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "5"), hpack.header_field("grpc-message", "gone")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_NOT_FOUND)
    assert_eq(r.final_message(), "gone")

test "stream reader treats a reset as an error":
    r := new_stream_reader()
    assert(r.feed(http2.reset_event(8)).is_err)

# --- client / bidi shapes ---------------------------------------------------

test "client-stream reader yields one response then finishes OK":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    msg := encoding.from_hex("0a0470697468")!
    r.feed(http2.data_event(frame_message(msg), false))!
    assert(r.ready())
    assert_eq(r.take()!, msg)
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

test "bidi reader deframes several echoed messages in order":
    r := new_stream_reader()
    r.feed(http2.headers_event([hpack.header_field(":status", "200")], false))!
    a := encoding.from_hex("0a0161")!
    b := encoding.from_hex("0a0162")!
    c := encoding.from_hex("0a0163")!
    r.feed(http2.data_event(frame_message(a), false))!
    r.feed(http2.data_event(frame_message(b), false))!
    r.feed(http2.data_event(frame_message(c), false))!
    assert(r.ready())
    assert_eq(r.take()!, a)
    assert(r.ready())
    assert_eq(r.take()!, b)
    assert(r.ready())
    assert_eq(r.take()!, c)
    assert(not r.ready())
    r.feed(http2.headers_event([hpack.header_field("grpc-status", "0")], true))!
    assert(r.finished())
    assert_eq(r.final_status(), GRPC_OK)

# a pool of n grpc channels to the same server, each its own http/2 connection.
# a single channel's reader/writer pipeline is ~one-core-bound, so concurrent
# rpcs spread round-robin across the pool run on separate cores (the same reason
# real grpc clients open multiple subchannels). use it in place of a single
# dial() channel for many concurrent calls; keep n at or below the core count
# for a throughput gain. close() shuts every channel down.
pub struct PoolConn:
    conns: List[Conn]
    mut next: Int
    pick: Mutex

impl PoolConn:
    # the index of the next channel, round-robin, safe across concurrent callers.
    fn choose() -> Int:
        self.pick.lock()
        i := self.next
        self.next = (self.next + 1) % self.conns.len()
        self.pick.unlock()
        return i

    # unary rpc over the next pooled channel; see Conn.unary.
    pub fn unary(full_method: String, request: Bytes) -> Bytes!GrpcError:
        return self.conns[self.choose()].unary(full_method, request)

    # server-streaming rpc over the next pooled channel; see Conn.server_stream.
    pub fn server_stream(full_method: String, request: Bytes) -> ServerStream!GrpcError:
        return self.conns[self.choose()].server_stream(full_method, request)

    # client-streaming rpc over the next pooled channel; see Conn.client_stream.
    pub fn client_stream(full_method: String) -> ClientStream!GrpcError:
        return self.conns[self.choose()].client_stream(full_method)

    # bidi-streaming rpc over the next pooled channel; see Conn.bidi_stream.
    pub fn bidi_stream(full_method: String) -> BidiStream!GrpcError:
        return self.conns[self.choose()].bidi_stream(full_method)

    # the number of channels in the pool.
    pub fn size() -> Int:
        return self.conns.len()

    # the i-th channel. hand a long-lived task its own channel with this (rather
    # than sharing the pool across tasks) so each task's calls stay on one
    # connection's pipeline.
    pub fn at(i: Int) -> Conn:
        return self.conns[i]

    # close every pooled channel.
    pub fn close():
        for c in self.conns:
            c.close()

# dial a pool of n grpc channels to host:port (each its own http/2 connection
# over tls, alpn "h2"). issue concurrent rpcs across it to use multiple cores;
# n above the core count gives no further gain. close() shuts them all down.
pub fn dial_pool(host: String, port: Int, n: Int) -> PoolConn!:
    mut conns: List[Conn] := []
    mut i := 0
    while i < n:
        conns.push(dial(host, port)!)
        i = i + 1
    return PoolConn(conns: conns, next: 0, pick: Mutex())

# like dial_pool but dialing each channel with the caller's tls `config` (which
# must offer alpn "h2") — e.g. one trusting a private ca.
pub fn dial_pool_with_config(host: String, port: Int, n: Int, config: tls.Config) -> PoolConn!:
    mut conns: List[Conn] := []
    mut i := 0
    while i < n:
        conns.push(dial_with_config(host, port, config)!)
        i = i + 1
    return PoolConn(conns: conns, next: 0, pick: Mutex())

# --- server ---
#
# serving grpc reuses the http/2 server: a grpc call is an http/2 POST to
# /pkg.Service/Method carrying a length-prefixed message, answered with a
# length-prefixed reply and a grpc-status trailer. serve() wraps the http/2
# server with a handler that deframes the request, dispatches by path, frames
# the reply, and sets the trailer.
#
# the dispatch fn lives in a module global because a pith closure cannot capture
# a fn-value, so there is one grpc server per process — the common case, one
# service binary per endpoint. a generated <Service>Server provides the dispatch
# (routing each path to a typed handler); a hand-written server can match paths
# itself.

GRPC_CONTENT_TYPE := "application/grpc"

mut grpc_dispatch_fn: fn(String, Bytes) -> Bytes!GrpcError := grpc_no_dispatch

fn grpc_no_dispatch(path: String, request: Bytes) -> Bytes!GrpcError:
    fail GrpcError(GRPC_UNIMPLEMENTED, "no grpc dispatch registered")

fn grpc_ok_trailers() -> Map[String, String]:
    mut t: Map[String, String] := {}
    t.insert("grpc-status", GRPC_OK.to_string())
    return t

fn grpc_status_trailers(status: Int, message: String) -> Map[String, String]:
    mut t: Map[String, String] := {}
    t.insert("grpc-status", status.to_string())
    if message.len() > 0:
        t.insert("grpc-message", message)
    return t

# extract the single request message from a unary request body (one
# length-prefixed frame). an all-default proto3 message can arrive as an empty
# body, which decodes to a default message.
fn grpc_unframe_unary(body: Bytes) -> Bytes!GrpcError:
    d := new_deframer()
    d.push(body)
    if not d.ready():
        return bytes.empty()
    return d.next()!

# the http/2 handler that turns one unary grpc request into one grpc response.
fn grpc_serve_handler(req: http.HttpRequestBytes) -> http.HttpResponse:
    path := req.path() catch ""
    request := grpc_unframe_unary(req.body_bytes())
    if request.is_err:
        return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(GRPC_INTERNAL, "malformed request frame"))
    result := grpc_dispatch_fn(path, request.ok)
    if result.is_err:
        return http.response(200).content_type(GRPC_CONTENT_TYPE).with_trailers(grpc_status_trailers(result.err.status, result.err.message))
    framed := frame_message(result.ok)
    return http.response(200).content_type(GRPC_CONTENT_TYPE).with_body_bytes(framed).with_trailers(grpc_ok_trailers())

# serve grpc over plaintext http/2 (h2c). blocks, accepting connections. the
# `dispatch` maps a full method path (/pkg.Service/Method) and the request
# message bytes to the response message bytes, or a GrpcError.
pub fn serve(host: String, port: Int, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_dispatch_fn = dispatch
    return h2server.listen_h2c(host, port, grpc_serve_handler)!

# serve grpc over http/2 with tls (alpn "h2").
pub fn serve_tls(host: String, port: Int, cert: String, key: String, dispatch: fn(String, Bytes) -> Bytes!GrpcError) -> Int!:
    grpc_dispatch_fn = dispatch
    return h2server.listen_h2_tls(host, port, cert, key, grpc_serve_handler)!
