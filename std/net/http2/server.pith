# std.net.http2.server — a native http/2 server over h2c or tls (alpn "h2").
#
# this is the mirror of the http/2 client in std.net.http2.connection: the same
# frame codec (std.net.http2.frames), the same hpack compression
# (std.net.http2.hpack), and the same reader-owns-the-decoder /
# writer-owns-the-encoder discipline — only the roles are flipped. the server
# reads request HEADERS + DATA and writes response HEADERS + DATA.
#
#   fn hello(req: http.HttpRequestBytes) -> http.HttpResponse:
#       return http.text(200, "hello from h2c\n")
#
#   server.listen_h2c("0.0.0.0", 8080, hello)!
#
# the concurrency model is task-per-connection and task-per-stream:
#
#   * one reader task per connection owns read_frame and the hpack decoder. it
#     decodes every header block in receive order (http/2 requires a single
#     decoder in wire order), demultiplexes frames by stream id, and spawns a
#     handler task for each new request stream.
#   * one writer task per connection owns the send direction and the hpack
#     encoder. handlers never touch the socket or the encoder: they submit a
#     response descriptor over a channel and the writer serializes each one in
#     turn, so concurrent handlers can never interleave header blocks and desync
#     the peer's dynamic table.
#   * one handler task per stream assembles the request from the events the
#     reader delivers, calls the user handler, and submits the response.
#
# the reader and writer touch disjoint state (the decoder vs the encoder, the
# receive buffer vs the socket write), so they run concurrently without a lock on
# the transport. the small amount of shared state — the stream table — is guarded
# by a mutex, exactly as the client guards its own.
#
# the server runs over either transport: cleartext h2c (serve_h2c_connection /
# listen_h2c) or http/2 over tls with alpn "h2" (serve_h2_tls_connection /
# listen_h2_tls). the transport is a byte-level swap inside ServerConn; the
# reader, writer, and per-stream handlers are identical for both. requests with
# bodies and full send/receive flow control are implemented and tested; the
# request-size limits below bound how much one connection can make the server
# buffer.
#
# besides the buffered handler above there is a streaming path
# (listen_h2c_streaming / listen_h2_tls_streaming): the handler receives a live
# ServerStream and reads body chunks with recv_event() while sending response
# headers, DATA, and trailers incrementally — so it can answer before the
# request has finished arriving. see "the streaming handler surface" below.

# the codec modules are imported before std.net.http on purpose, for the same
# loader-ordering reason documented in std.net.http2.connection: importing frames
# and hpack first keeps std.binary's Reader single-identity.
import std.net.http2.frames as frames
import std.net.http2.hpack as hpack
import std.bytes as bytes
import std.binary as binary
import std.net.http as http
import std.net.tls as tls
# the request-side stream event and its constructors, plus the settings ids and
# the default window, are shared as-is with the client — the server reads the
# same events the client writes. imported by name because a Channel's element
# type must be an unqualified type name.
from std.net.http2.connection import StreamEvent, headers_event, data_event, reset_event, SETTINGS_HEADER_TABLE_SIZE, SETTINGS_MAX_CONCURRENT_STREAMS, SETTINGS_INITIAL_WINDOW_SIZE, SETTINGS_MAX_FRAME_SIZE, DEFAULT_INITIAL_WINDOW

# the 24-byte client connection preface, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
# (RFC 9113 §3.4), encoded as hex so the carriage returns and line feeds are
# unambiguous in source. the client sends this before any frame; the server reads
# and validates it before the SETTINGS exchange.
PREFACE := "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

# the most streams the server will serve at once on one connection. advertised in
# the server's SETTINGS and enforced by the reader: a new stream past the cap is
# refused with RST_STREAM rather than spawned.
pub SERVER_MAX_CONCURRENT_STREAMS := 128

# the outbound work queue depth. the writer drains it continuously; a generous
# buffer keeps the reader (queuing control frames) and handlers (queuing
# responses) from stalling under a burst of concurrent streams.
OUTBOUND_CAP := 256

# the per-stream inbox depth. a request is a small number of events (headers,
# maybe a few body chunks, end-of-stream), so a modest buffer keeps the reader
# from blocking while a handler is momentarily behind.
STREAM_INBOX_CAP := 64

# how much of the receive buffer to pull from the socket per read.
RECV_CHUNK := 16384

# request-size limits, enforced before the server buffers or bridges a request, so
# a hostile client cannot exhaust memory or splice extra headers into the request.
# these are conservative fixed defaults; a later revision may make them per-server
# configurable.
#   * MAX_HEADER_LIST_BYTES caps the total size of a request's decoded header
#     fields (every name plus value), so a giant HEADERS block — even one that only
#     balloons after hpack decompression — is refused rather than buffered.
#   * MAX_HEADER_COUNT caps how many header fields one request may carry.
# the request body cap is shared with the http/1.1 server (http.MAX_REQUEST_BODY),
# so both front doors buffer at most the same amount.
MAX_HEADER_LIST_BYTES := 65536
MAX_HEADER_COUNT := 100

# the compressed HEADERS + CONTINUATION block is bounded while it is read, before
# it is handed to hpack, so a client cannot stream endless CONTINUATION frames that
# never set END_HEADERS to grow an unbounded buffer (the CVE-2024-27316 flood). the
# wire block is normally far smaller than the decoded header list, so a ceiling a
# little above MAX_HEADER_LIST_BYTES admits any legitimate block while refusing a
# flood. the frame-count cap independently stops a stream of tiny (or empty)
# CONTINUATION frames that would loop forever without growing the buffer.
MAX_HEADER_BLOCK_BYTES := 81920
MAX_CONTINUATION_FRAMES := 64

# the message assemble_request fails with when a request body outgrows
# http.MAX_REQUEST_BODY, so handle_stream can answer it with a stream reset rather
# than dropping the stream silently.
BODY_TOO_LARGE := "http2: request body exceeds the maximum"

# a per-stream send-credit poke: capacity one, since a body sender blocked on the
# peer's flow-control window only needs to learn "a window grew, re-check it". a
# coalesced poke never loses a wakeup — if one is already buffered, the sender
# still wakes and re-reads the window. mirrors the client's CREDIT_POKE_CAP.
CREDIT_POKE_CAP := 1

# --- the transport ---
#
# a ServerConn speaks over one of three transports, chosen once at construction.
# everything above the transport — the reader, the writer, the per-stream
# handlers, the frame codec — is identical for all three; only recv_chunk, send,
# and close differ, so switching h2c for tls is a byte-transport swap, not a new
# protocol path.
#   * TRANSPORT_OFFLINE feeds a preloaded buffer and records writes in `sent`, so
#     the frame tests drive the codec deterministically with no socket.
#   * TRANSPORT_TCP is cleartext h2c over an accepted tcp fd (P3a).
#   * TRANSPORT_TLS is h2 over an accepted tls session that negotiated alpn "h2",
#     using the same read_bytes/write_all_bytes the h2 client uses over tls.
TRANSPORT_OFFLINE := 0
TRANSPORT_TCP := 1
TRANSPORT_TLS := 2

# --- outbound work items ---

# what the writer pulls off its queue. OUT_RAW is a pre-serialized control frame
# the reader produced (a SETTINGS ack, PING ack, WINDOW_UPDATE, RST_STREAM, or
# GOAWAY); OUT_RESPONSE is a handler's response, still to be encoded and framed by
# the writer so the encoder stays single-owner.
OUT_RAW := 0
OUT_RESPONSE := 1

# one item on the writer's queue. only the fields for its kind are meaningful:
# OUT_RAW carries `raw` (a pre-serialized frame — a control frame, or a DATA
# frame a handler has already flow-control-gated); OUT_RESPONSE carries the
# `stream_id`, the already-built response header fields, and `end_stream` (true
# only for a bodiless response, which half-closes on the HEADERS frame).
#
# a response's headers are carried as (stream_id, header fields) rather than as a
# whole http.HttpResponse on purpose: the handler flattens the response to plain
# header fields before queuing, so no Map crosses the task boundary — passing a
# struct with a Map field through a channel currently corrupts it. the encoding
# still happens on the writer, so the encoder stays single-owner. the response
# body is not carried here: the handler streams it as flow-controlled DATA frames
# (OUT_RAW) after the headers, so the writer never blocks on a send window.
struct Outbound:
    kind: Int
    raw: Bytes
    stream_id: Int
    fields: List[hpack.HeaderField]
    end_stream: Bool

# an empty header-field list, for the OUT_RAW items and the never-used defaults.
fn no_fields() -> List[hpack.HeaderField]:
    fields: List[hpack.HeaderField] := []
    return fields

# a pre-serialized control frame for the writer to send as-is. only ever called
# with empty bytes as an unwrap_or default, so the by-value helper move is safe.
fn raw_item(wire: Bytes) -> Outbound:
    return Outbound(OUT_RAW, wire, 0, no_fields(), false)

# an http/2 connection over one transport. it mirrors the client's Connection but
# reads requests rather than responses. `transport` selects the byte transport:
# TRANSPORT_TCP uses `fd` (cleartext h2c), TRANSPORT_TLS uses `tls_handle` (h2
# over tls), and TRANSPORT_OFFLINE preloads `buf` with a constructed request
# stream and records writes into `sent` so the frame tests drive the codec with
# no socket. `buf`/`pos` coalesce partial reads (a frame can span reads). the
# encoder is owned by the writer task, the decoder by the reader task; they are
# never touched concurrently.
struct ServerConn:
    mut fd: Int
    mut tls_handle: Int
    mut transport: Int
    mut buf: Bytes
    mut pos: Int
    mut encoder: hpack.Encoder
    mut decoder: hpack.Decoder
    mut sent: Bytes

# build a live server connection over an accepted cleartext tcp socket (h2c).
fn new_live_server_conn(fd: Int) -> ServerConn:
    return ServerConn(fd, 0, TRANSPORT_TCP, bytes.empty(), 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, true), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), bytes.empty())

# build a live server connection over an accepted tls session (h2 via alpn). the
# handle addresses the same tls session the h2 client reads and writes over.
fn new_tls_server_conn(handle: Int) -> ServerConn:
    return ServerConn(0, handle, TRANSPORT_TLS, bytes.empty(), 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, true), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), bytes.empty())

# build an offline server connection that reads `data` as if it arrived from a
# client. used by the tests to drive the reader over a constructed frame stream.
fn server_conn_from_bytes(data: Bytes) -> ServerConn:
    return ServerConn(0, 0, TRANSPORT_OFFLINE, data, 0, hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false), hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE), bytes.empty())

impl ServerConn:
    # read one transport chunk: from the tcp socket or the tls session when live,
    # otherwise nothing (the offline buffer is exhausted, which reads as
    # end-of-stream).
    fn recv_chunk() -> Bytes!:
        if self.transport == TRANSPORT_TCP:
            return tcp_read_bytes(self.fd, RECV_CHUNK)!
        if self.transport == TRANSPORT_TLS:
            return tls.conn_from_handle(self.tls_handle).read_bytes(RECV_CHUNK)!
        return bytes.empty()

    # ensure at least `n` unread bytes are buffered, pulling transport chunks as
    # needed. fails if the transport closes first. the consumed prefix is dropped
    # only when a new chunk is pulled, so steady-state reading does not re-concat
    # the buffer per frame.
    fn fill(n: Int) -> Int!:
        while self.buf.len() - self.pos < n:
            chunk := self.recv_chunk()!
            if chunk.len() == 0:
                fail "http2: connection closed"
            self.buf = bytes.concat(self.buf.slice(self.pos, self.buf.len()), chunk)
            self.pos = 0
        return 0

    # read and validate the 24-byte client connection preface (RFC 9113 §3.4).
    # fails if the bytes do not match, which the caller treats as a non-http/2
    # client and drops.
    fn read_preface() -> Bool!:
        self.fill(PREFACE.len())!
        got := self.buf.slice(self.pos, self.pos + PREFACE.len())
        self.pos = self.pos + PREFACE.len()
        if (got.to_string_utf8() catch "") != PREFACE:
            fail "http2: invalid client connection preface"
        return true

    # read one frame off the transport: the 9-byte header gives the payload
    # length, then the whole frame is sliced out in one piece and the cursor
    # advanced. the codec's reader parses and bounds-checks it.
    fn read_frame() -> frames.Frame!:
        self.fill(9)!
        length_res := binary.read_u24_be_at(self.buf, self.pos)
        if length_res.is_err:
            fail length_res.err.message
        total := 9 + length_res.ok
        self.fill(total)!
        full := self.buf.slice(self.pos, self.pos + total)
        self.pos = self.pos + total
        return frames.read_frame(binary.reader(full), frames.DEFAULT_MAX_FRAME_SIZE)!

    # write raw bytes to the transport, or record them when offline. the tls path
    # uses write_all_bytes so a short tls write is retried until the whole frame
    # is sent, exactly as the h2 client writes.
    fn send(data: Bytes) -> Int!:
        if self.transport == TRANSPORT_TCP:
            return tcp_write_bytes(self.fd, data)!
        if self.transport == TRANSPORT_TLS:
            return tls.conn_from_handle(self.tls_handle).write_all_bytes(data)!
        self.sent = bytes.concat(self.sent, data)
        return data.len()

    # serialize and send one frame.
    fn send_frame(frame: frames.Frame) -> Int!:
        return self.send(frames.frame_bytes(frame)!)!

    # read a complete header block, following CONTINUATION frames until the
    # END_HEADERS flag. per RFC 9113 §6.10 nothing else may interleave, so this
    # reads frames directly rather than going through the reader loop.
    fn read_header_block(first: frames.HeadersFrame) -> Bytes!:
        out := bytes.buffer()
        defer out.free()
        out.write(first.block_fragment)!
        mut done := first.end_headers
        mut continuations := 0
        while not done:
            frame := self.read_frame()!
            if frame.header.frame_type != frames.FRAME_CONTINUATION:
                fail "http2: expected a CONTINUATION frame to complete the header block"
            if frame.header.stream_id != first.stream_id:
                fail "http2: CONTINUATION frame on the wrong stream"
            continuations = continuations + 1
            if continuations > MAX_CONTINUATION_FRAMES:
                fail "http2: too many CONTINUATION frames in one header block"
            cont := frames.parse_continuation(frame)!
            out.write(cont.block_fragment)!
            if out.len() > MAX_HEADER_BLOCK_BYTES:
                fail "http2: header block exceeds the maximum size"
            done = cont.end_headers
        return out.bytes()

    # close the underlying transport.
    fn close():
        if self.transport == TRANSPORT_TCP:
            tcp_close(self.fd)
        elif self.transport == TRANSPORT_TLS:
            tls.conn_from_handle(self.tls_handle).close()

# the SETTINGS frame the server opens with: it advertises the concurrent-stream
# cap, the default flow-control window, and the default max frame size (so a
# client must not send larger frames).
fn server_settings_frame() -> frames.Frame!:
    params := [frames.setting(SETTINGS_MAX_CONCURRENT_STREAMS, SERVER_MAX_CONCURRENT_STREAMS), frames.setting(SETTINGS_INITIAL_WINDOW_SIZE, DEFAULT_INITIAL_WINDOW), frames.setting(SETTINGS_MAX_FRAME_SIZE, frames.DEFAULT_MAX_FRAME_SIZE)]
    return frames.settings_frame(params)!

# --- per-connection server state ---

# the state one connection's tasks share. the reader and handler tasks receive
# the whole Server; the writer receives only `conn`, `outbound`, and `closed`
# (the send side) so its handle can be spawned before the Server is built. the
# mutex guards the stream table (`streams` plus the `active` id list that mirrors
# its keys) and `last_stream_id`; the channels are already safe across tasks.
struct Server:
    conn: ServerConn
    handler: fn(http.HttpRequestBytes) -> http.HttpResponse
    # true when this server hands streams to the streaming handler (see
    # ServerStream below) instead of buffering whole requests for `handler`.
    streaming: Bool
    outbound: Channel[Outbound]
    mu: Mutex
    streams: Map[Int, Channel[StreamEvent]]
    mut active: List[Int]
    mut last_stream_id: Int
    closed: AtomicInt
    # send-side flow control (RFC 9113 §6.9): we may not send more response DATA
    # than the client's windows allow. `conn_send_window` is the connection-level
    # credit (starts at the default, grows only on a stream-0 WINDOW_UPDATE);
    # `send_windows` holds each open stream's credit; `peer_initial_window` is the
    # value a new stream's window starts at (the client's SETTINGS_INITIAL_WINDOW_SIZE);
    # `peer_max_frame_size` caps how large a single DATA frame may be. `credit`
    # pokes a stream's blocked body sender when one of its windows grows. all of
    # this is guarded by `mu`, exactly like the stream table. mirrors the client's
    # send-side state so a large response is chunked and gated the same way.
    mut peer_initial_window: Int
    mut peer_max_frame_size: Int
    mut conn_send_window: Int
    send_windows: Map[Int, Int]
    credit: Map[Int, Channel[Int]]

# remove the first occurrence of `target` from a list of ints. the stream table's
# `active` mirror is small (bounded by the concurrency cap), so a linear rebuild
# is fine.
fn list_remove_int(items: List[Int], target: Int) -> List[Int]:
    mut out: List[Int] := []
    mut removed := false
    for value in items:
        if value == target and not removed:
            removed = true
        else:
            out.push(value)
    return out

impl Server:
    # register a new stream's inbox in the table and record it active. the stream
    # also gets a send window (seeded at the client's advertised initial window)
    # and a credit channel, so the handler can stream a response body under flow
    # control once it runs.
    fn register(stream_id: Int, inbox: Channel[StreamEvent]):
        self.mu.lock()
        self.streams.insert(stream_id, inbox)
        self.active.push(stream_id)
        self.send_windows.insert(stream_id, self.peer_initial_window)
        self.credit.insert(stream_id, Channel[Int](CREDIT_POKE_CAP))
        if stream_id > self.last_stream_id:
            self.last_stream_id = stream_id
        self.mu.unlock()

    # drop a stream from the table once its handler is done (or it was reset). its
    # send window is dropped and its credit channel closed, which wakes the body
    # sender if it was blocked waiting on a window (it then gives up).
    fn forget(stream_id: Int):
        self.mu.lock()
        if self.streams.contains_key(stream_id):
            self.streams.remove(stream_id)
        if self.send_windows.contains_key(stream_id):
            self.send_windows.remove(stream_id)
        if self.credit.contains_key(stream_id):
            self.credit[stream_id].close()
            self.credit.remove(stream_id)
        self.active = list_remove_int(self.active, stream_id)
        self.mu.unlock()

    # how many streams are currently open, for the concurrency cap.
    fn active_count() -> Int:
        self.mu.lock()
        n := self.active.len()
        self.mu.unlock()
        return n

    # hand an event to a stream's inbox, dropping it if the stream is already gone.
    # the channel handle is taken under the mutex and the send happens outside it,
    # so a briefly-behind handler never blocks the stream table (mirrors the
    # client's deliver()).
    fn deliver(stream_id: Int, event: StreamEvent):
        self.mu.lock()
        if not self.streams.contains_key(stream_id):
            self.mu.unlock()
            return
        inbox := self.streams[stream_id]
        self.mu.unlock()
        inbox.send(event)

    # queue a pre-serialized control frame for the writer. the outbound queue is
    # deeply buffered, so this effectively never blocks for the small control
    # frames the reader produces; if the writer has fully wedged, applying
    # backpressure to the reader is the correct response anyway.
    #
    # this uses a blocking send rather than try_send on purpose: try_send does not
    # yet copy a struct payload correctly (successive try_sends alias one slot), so
    # the outbound Outbound items would collapse to the last one enqueued.
    fn enqueue_frame(frame: frames.Frame):
        wire := frames.frame_bytes(frame)
        if wire.is_err:
            return
        # the Outbound is built inline rather than through a helper: a struct
        # passed by value into a helper and then placed in a constructor loses its
        # nested heap fields (here the wire Bytes), so the item is assembled at the
        # send site where the fields stay live.
        self.outbound.send(Outbound(OUT_RAW, wire.ok, 0, no_fields(), false))

    # reset a stream: tell the client and drop it from the table.
    fn reset(stream_id: Int, error_code: Int):
        rst := frames.rst_stream_frame(stream_id, error_code)
        if not rst.is_err:
            self.enqueue_frame(rst.ok)
        self.forget(stream_id)

    # close every open stream's inbox so handlers blocked on recv() unblock, then
    # clear the table. called when the connection winds down.
    fn shutdown_streams():
        self.mu.lock()
        self.closed.store(1)
        for stream_id in self.active:
            if self.streams.contains_key(stream_id):
                self.streams[stream_id].close()
            # closing the credit channel wakes a body sender blocked on a window so
            # it stops rather than waiting for a WINDOW_UPDATE that will never come.
            if self.credit.contains_key(stream_id):
                self.credit[stream_id].close()
        empty: Map[Int, Channel[StreamEvent]] := {}
        self.streams = empty
        empty_windows: Map[Int, Int] := {}
        self.send_windows = empty_windows
        empty_credit: Map[Int, Channel[Int]] := {}
        self.credit = empty_credit
        self.active = []
        self.mu.unlock()

# --- the streaming handler surface ---
#
# the buffered path above collects a whole request before the handler runs and
# sends a whole response after it returns. a streaming handler instead runs while
# the request is still arriving: it reads body chunks off the stream's inbox one
# at a time and sends response headers, DATA, and trailers incrementally, so it
# can answer message 1 before the client has sent message 2 (what an interactive
# grpc bidi stream needs). the machinery is the same — the per-stream inbox the
# reader already feeds, and the same outbound queue and flow-control gating the
# buffered path sends through — only the buffering in the middle is gone.

# one live request stream, handed to a streaming handler. the request HEAD
# (method, path, headers) is already parsed into `request`; the body arrives
# through recv_event(). the send side mirrors the buffered response path: headers
# first, then flow-controlled DATA, then trailers (or END_STREAM on the last
# DATA). the handler must end the stream one way or the other before returning,
# or the client is left waiting.
pub struct ServerStream:
    server: Server
    pub id: Int
    inbox: Channel[StreamEvent]
    # the request head, parsed from the HEADERS block: path, query, headers — the
    # same HttpRequestBytes a buffered handler sees, with an empty body (the body
    # is read incrementally with recv_event()).
    pub request: http.HttpRequestBytes
    # true once the request side has finished: END_STREAM seen, the stream was
    # reset, or the connection closed. recv_event() keeps the flag current.
    mut done: Bool

impl ServerStream:
    # the next request event: a DATA chunk (its `end` flag marks the last one), a
    # HEADERS event (request trailers, rare), or a RESET if the client abandoned
    # the stream. once the request side has finished, every further call returns
    # an empty end-of-stream DATA event, so a loop that reads until `end` or a
    # reset never hangs on a finished request. a closed connection reads as a
    # reset with CANCEL, so handlers treat the two the same way: stop.
    pub fn recv_event() -> StreamEvent:
        if self.done:
            return data_event(bytes.empty(), true)
        opt := self.inbox.recv()
        if opt == none:
            self.done = true
            return reset_event(frames.ERROR_CANCEL)
        event := opt.unwrap_or(reset_event(frames.ERROR_CANCEL))
        if event.is_reset() or event.end:
            self.done = true
        return event

    # queue the response HEADERS. `end_stream` true is a headers-only response;
    # false leaves the stream open for send() and send_trailers(). call once,
    # before any send(). the Outbound is built inline at the send site (a
    # by-value struct moved into a constructor inside a helper loses its heap
    # fields), same as the buffered path.
    pub fn send_headers(fields: List[hpack.HeaderField], end_stream: Bool):
        self.server.outbound.send(Outbound(OUT_RESPONSE, bytes.empty(), self.id, fields, end_stream))

    # send a chunk of response body as flow-controlled DATA, blocking while the
    # client's send windows are exhausted until a WINDOW_UPDATE grows them.
    # `end_stream` ends the response on the final frame (use send_trailers
    # instead when trailers follow). returns the bytes sent; a short count means
    # the connection dropped.
    pub fn send_data(data: Bytes, end_stream: Bool) -> Int:
        return send_stream_data(self.server, self.id, data, end_stream)

    # queue the response trailers — a trailing HEADERS block, which always ends
    # the stream. grpc carries its grpc-status here.
    pub fn send_trailers(fields: List[hpack.HeaderField]):
        self.server.outbound.send(Outbound(OUT_RESPONSE, bytes.empty(), self.id, fields, true))

# the process-wide streaming handler, set by listen_h2c_streaming /
# listen_h2_tls_streaming. a module global for the same reason grpc's dispatch
# is one: a pith closure cannot capture a fn-value, and a Server field of type
# fn(ServerStream) would make Server and ServerStream mutually recursive, which
# the type system resolves in file order and so cannot express. the cost is one
# streaming handler per process — the same shape grpc already documents.
mut stream_handler_fn: fn(ServerStream) -> Int := stream_handler_unset

# the default streaming handler: refuse the stream, so a misconfigured server
# fails loudly instead of leaving clients waiting on a stream nobody serves.
fn stream_handler_unset(stream: ServerStream) -> Int:
    stream.server.reset(stream.id, frames.ERROR_REFUSED_STREAM)
    return 0

# --- the request bridge ---

# pull a pseudo-header value out of a decoded request header list, or "" when
# absent. pseudo-headers (":method", ":path", ":authority", ":scheme") lead the
# list per RFC 9113 §8.3.
fn pseudo(fields: List[hpack.HeaderField], name: String) -> String:
    for field in fields:
        if field.name == name:
            return field.value
    return ""

# synthesize an http/1.1 request head from the request pseudo-headers and regular
# headers, then parse it into an HttpRequestBytes. this reuses all of the http/1.1
# request machinery — path, query, params, header map — so the http/2 server and
# the http/1.1 server hand user code the exact same request type.
#
# the ":authority" pseudo-header becomes the Host header; the other regular
# headers pass through unchanged. the reader has already validated that ":method"
# and ":path" are present.
fn build_request(fields: List[hpack.HeaderField], body: Bytes) -> http.HttpRequestBytes!:
    method := pseudo(fields, ":method")
    path := pseudo(fields, ":path")
    authority := pseudo(fields, ":authority")
    crlf := "\r\n"
    mut head := method + " " + path + " HTTP/1.1" + crlf
    head = head + "host: " + authority + crlf
    for field in fields:
        # pseudo-headers are h2-only; they became the request line and Host above.
        if field.name.starts_with(":"):
            continue
        head = head + field.name + ": " + field.value + crlf
    head = head + crlf
    return http.build_http_request(bytes.from_string_utf8(head), body)!

# --- the response bridge ---

# the hop-by-hop headers that are meaningless (and forbidden) in http/2: they
# describe a single http/1.1 hop, not the end-to-end message (RFC 9113 §8.2.2).
fn is_hop_by_hop(name: String) -> Bool:
    return name == "connection" or name == "transfer-encoding" or name == "keep-alive" or name == "upgrade"

# turn an HttpResponse into the http/2 response header fields: the ":status"
# pseudo-header first, then the content type, the regular headers (lowercased,
# with hop-by-hop and length/type headers dropped), and any set-cookie lines.
# content-length is omitted — http/2 conveys the body length through DATA framing.
fn response_fields(response: http.HttpResponse) -> List[hpack.HeaderField]:
    mut fields: List[hpack.HeaderField] := [hpack.header_field(":status", response.status.to_string())]
    if response.content_type != "":
        fields.push(hpack.header_field("content-type", response.content_type))
    for key in response.headers:
        name := key.to_lower()
        if is_hop_by_hop(name) or name == "content-type" or name == "content-length":
            continue
        fields.push(hpack.header_field(name, response.headers[key]))
    for cookie in response.set_cookie_headers:
        fields.push(hpack.header_field("set-cookie", cookie))
    return fields

# flatten a response's trailers into hpack header fields for the trailing HEADERS
# block. empty when the response has no trailers (the common case).
fn response_trailer_fields(response: http.HttpResponse) -> List[hpack.HeaderField]:
    mut fields: List[hpack.HeaderField] := []
    for key in response.trailers:
        fields.push(hpack.header_field(key.to_lower(), response.trailers[key]))
    return fields

# encode and send a response's HEADERS on `stream_id`: one HEADERS frame carrying
# the hpack block of `fields`, with END_HEADERS set. `end_stream` half-closes on
# the HEADERS frame, which is what a bodiless response wants; a response with a
# body passes false here and streams the body as flow-controlled DATA frames
# afterward (see send_stream_data). runs only on the writer task, the sole owner
# of the encoder and the socket.
fn send_headers(conn: ServerConn, stream_id: Int, fields: List[hpack.HeaderField], end_stream: Bool) -> Int!:
    block := conn.encoder.encode(fields)
    conn.send_frame(frames.headers_frame(stream_id, block, end_stream, true))!
    return 0

fn min_int(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

# --- send-side flow control (RFC 9113 §6.9) ---
#
# a response body larger than the client's send window must be split into DATA
# frames no larger than the client's max frame size and no larger than the credit
# its stream and connection windows currently allow, then paused until a
# WINDOW_UPDATE grants more. this mirrors the client's send-side machinery
# (send_stream_data / reserve_send / await_credit / grant_send_credit) with the
# roles flipped, and — crucially — it never runs on the writer task. the handler
# task gates the body and hands the writer only DATA frames it is already allowed
# to send, so the writer never blocks on a window. the reader task, meanwhile,
# keeps reading WINDOW_UPDATE frames and poking credit, so a blocked sender is
# always woken without the reader or writer being held up. that separation is
# what keeps a >window response from deadlocking.

impl Server:
    # reserve up to `want` bytes of send credit for `stream_id`, bounded by the
    # stream window, the connection window, and the client's max frame size.
    # returns the bytes reserved (0 when no credit is available), debiting both
    # windows by that amount. a window can be negative after a SETTINGS shrink, so
    # a non-positive result just means "wait for a WINDOW_UPDATE".
    fn reserve_send(stream_id: Int, want: Int) -> Int:
        self.mu.lock()
        mut win := 0
        if self.send_windows.contains_key(stream_id):
            win = self.send_windows[stream_id]
        mut grant := want
        if grant > win:
            grant = win
        if grant > self.conn_send_window:
            grant = self.conn_send_window
        if grant > self.peer_max_frame_size:
            grant = self.peer_max_frame_size
        if grant > 0:
            self.send_windows.insert(stream_id, win - grant)
            self.conn_send_window = self.conn_send_window - grant
        self.mu.unlock()
        if grant < 0:
            return 0
        return grant

    # block until this stream's credit is poked (a WINDOW_UPDATE grew a window),
    # returning false if the connection closed instead (its credit channel is then
    # closed and recv reports none), which tells the sender to give up.
    fn await_credit(stream_id: Int) -> Bool:
        self.mu.lock()
        if not self.credit.contains_key(stream_id):
            self.mu.unlock()
            return false
        ch := self.credit[stream_id]
        self.mu.unlock()
        opt := ch.recv()
        return opt != none

# apply an inbound WINDOW_UPDATE to our send windows and wake any body sender
# waiting on the affected stream. a stream-0 update grows the connection window,
# which may unblock any stream, so it pokes them all; a stream id grows just that
# one stream. pokes are sent outside the mutex so a full poke channel (one already
# pending) never blocks the reader. mirrors the client's grant_send_credit.
fn grant_send_credit(server: Server, stream_id: Int, increment: Int):
    server.mu.lock()
    if stream_id == 0:
        server.conn_send_window = server.conn_send_window + increment
        mut waiters: List[Channel[Int]] := []
        for sid in server.active:
            if server.credit.contains_key(sid):
                waiters.push(server.credit[sid])
        server.mu.unlock()
        for ch in waiters:
            ch.try_send(1)
        return
    if server.send_windows.contains_key(stream_id):
        server.send_windows.insert(stream_id, server.send_windows[stream_id] + increment)
    if server.credit.contains_key(stream_id):
        ch := server.credit[stream_id]
        server.mu.unlock()
        ch.try_send(1)
        return
    server.mu.unlock()

# stream `data` as flow-controlled DATA frames on `stream_id`, honoring the
# client's send windows: reserve credit bounded by the stream window, the
# connection window, and the max frame size; frame and queue that much for the
# writer; and block on the stream's credit signal when no window is available,
# until a WINDOW_UPDATE grows one. END_STREAM rides on the final frame only when
# `end_stream` is set. runs on the handler task, so the writer is never blocked on
# a window. returns the bytes sent; stops early if the connection drops (the
# credit channel closes and await_credit reports it).
fn send_stream_data(server: Server, stream_id: Int, data: Bytes, end_stream: Bool) -> Int:
    total := data.len()
    if total == 0:
        if end_stream:
            wire := frames.frame_bytes(frames.data_frame(stream_id, bytes.empty(), true))
            if wire.is_err:
                return 0
            server.outbound.send(Outbound(OUT_RAW, wire.ok, 0, no_fields(), false))
        return 0
    mut off := 0
    while off < total:
        grant := server.reserve_send(stream_id, total - off)
        if grant <= 0:
            # no credit right now: wait for a poke, or give up if the connection
            # closed.
            if not server.await_credit(stream_id):
                return off
            continue
        stop := off + grant
        last := stop == total
        wire := frames.frame_bytes(frames.data_frame(stream_id, data.slice(off, stop), last and end_stream))
        if wire.is_err:
            return off
        # OUT_RAW is built inline at the send site: a by-value struct moved into a
        # constructor inside a helper loses its nested heap fields (the wire Bytes).
        if not server.outbound.send(Outbound(OUT_RAW, wire.ok, 0, no_fields(), false)):
            return off
        off = stop
    return off

# --- the writer task ---

# drain the outbound queue and write to the socket in order. it owns the send
# direction — the socket and the hpack encoder — so no other task ever writes a
# byte or encodes a header. a closed queue (connection winding down) ends the
# loop after its buffered items flush, so a final GOAWAY still goes out. a write
# failure marks the connection closed and stops.
fn writer_loop(conn: ServerConn, outbound: Channel[Outbound], closed: AtomicInt) -> Int:
    while true:
        opt := outbound.recv()
        if opt == none:
            return 0
        # already handled none above; the default is never reached.
        item := opt.unwrap_or(raw_item(bytes.empty()))
        if item.kind == OUT_RAW:
            sent := conn.send(item.raw)
            if sent.is_err:
                closed.store(1)
                return 0
        else:
            # OUT_RESPONSE is headers only; the body follows as OUT_RAW DATA frames
            # the handler already gated against the client's send window.
            sent := send_headers(conn, item.stream_id, item.fields, item.end_stream)
            if sent.is_err:
                closed.store(1)
                return 0

# --- the handler task (one per stream) ---

# assemble the request from the events the reader delivers: the first HEADERS
# event carries the request headers, DATA events carry body chunks, and the
# stream ends when an event has its end flag set. a RST_STREAM (reset event) or a
# closed inbox abandons the request. a header block that arrives after the body
# has begun is trailers, which this phase ignores.
fn assemble_request(inbox: Channel[StreamEvent]) -> http.HttpRequestBytes!:
    body := bytes.buffer()
    defer body.free()
    mut fields: List[hpack.HeaderField] := []
    mut got_headers := false
    mut received := 0
    while true:
        opt := inbox.recv()
        if opt == none:
            fail "http2: stream closed before the request completed"
        event := opt?
        if event.is_reset():
            fail "http2: stream reset by the client"
        if event.is_headers():
            if not got_headers:
                fields = event.headers
                got_headers = true
            if event.end:
                return build_request(fields, body.bytes())!
        elif event.is_data():
            # cap the accumulated body so an endless DATA stream cannot exhaust
            # memory; the handler answers this with a stream reset.
            received = received + event.data.len()
            if received > http.MAX_REQUEST_BODY:
                fail BODY_TOO_LARGE
            body.write(event.data)!
            if event.end:
                return build_request(fields, body.bytes())!

# run one request stream to completion: assemble the request, call the user
# handler, and submit the response to the writer. an assemble failure (the client
# reset the stream, or it dropped) just drops the stream; the handler runs on its
# own task so a slow or failing request never blocks the reader or another stream.
# a streaming server hands the stream to the streaming handler instead of
# buffering (handle_streaming_stream); the buffered path below is unchanged.
fn handle_stream(server: Server, stream_id: Int, inbox: Channel[StreamEvent]):
    if server.streaming:
        handle_streaming_stream(server, stream_id, inbox)
        return
    result := assemble_request(inbox)
    if result.is_err:
        # a body that outgrew the size cap gets an explicit stream reset so the
        # client stops sending; any other failure (the client reset the stream, or
        # it dropped) just drops the handler.
        if result.err == BODY_TOO_LARGE:
            server.reset(stream_id, frames.ERROR_ENHANCE_YOUR_CALM)
        else:
            server.forget(stream_id)
        return
    response := server.handler(result.ok)
    # flatten the response to plain header fields here, in the handler task, so no
    # Map crosses to the writer. the Outbound is built inline at the send site (a
    # by-value struct moved into a constructor inside a helper loses its heap
    # fields), keeping the header list live.
    fields := response_fields(response)
    body := response.body
    has_body := body.len() > 0
    # trailers (a header block after the body) end the stream; grpc carries its
    # grpc-status here. flattened in the handler task, same as the headers.
    trailer_fields := response_trailer_fields(response)
    has_trailers := trailer_fields.len() > 0
    # queue the HEADERS first: END_STREAM rides on them only when nothing follows.
    server.outbound.send(Outbound(OUT_RESPONSE, bytes.empty(), stream_id, fields, not has_body and not has_trailers))
    if has_body:
        # stream the body as flow-controlled DATA frames on this handler task, so a
        # response larger than the client's window is chunked and paused on the
        # window without ever blocking the writer. the DATA frames queue after the
        # HEADERS above (same task, one FIFO channel), so ordering holds. END_STREAM
        # rides on the last DATA frame only when no trailers follow.
        send_stream_data(server, stream_id, body, not has_trailers)
    if has_trailers:
        # a second HEADERS block after the body is the trailers; it always ends
        # the stream. queued after the DATA on the same FIFO, so ordering holds.
        server.outbound.send(Outbound(OUT_RESPONSE, bytes.empty(), stream_id, trailer_fields, true))
    server.forget(stream_id)

# run one stream on the streaming path: read the request HEADERS off the inbox,
# parse the head, and hand the live stream to the streaming handler. the handler
# reads the body with recv_event() and sends the response incrementally while the
# request may still be arriving. when it returns, the stream is forgotten —
# whatever it did or did not send. a reset (or a dropped connection) before the
# headers just drops the stream, mirroring the buffered path's assemble failure.
fn handle_streaming_stream(server: Server, stream_id: Int, inbox: Channel[StreamEvent]):
    opt := inbox.recv()
    if opt == none:
        server.forget(stream_id)
        return
    first := opt.unwrap_or(reset_event(frames.ERROR_CANCEL))
    if not first.is_headers():
        server.forget(stream_id)
        return
    head := build_request(first.headers, bytes.empty())
    if head.is_err:
        server.reset(stream_id, frames.ERROR_PROTOCOL_ERROR)
        return
    # END_STREAM on the request HEADERS means there is no body: the stream starts
    # out done and the handler's first recv_event() reports end-of-request.
    stream := ServerStream(server, stream_id, inbox, head.ok, first.end)
    stream_handler_fn(stream)
    server.forget(stream_id)

# --- the reader task ---

# dispatch one frame. returns false when the reader should stop (a GOAWAY from
# the client). this is the mirror of the client's handle_frame: HEADERS opens or
# feeds a request stream, DATA feeds a body, and SETTINGS/PING/WINDOW_UPDATE/
# RST_STREAM/GOAWAY are connection housekeeping.
fn handle_frame(server: Server, frame: frames.Frame) -> Bool!:
    t := frame.header.frame_type
    if t == frames.FRAME_HEADERS:
        hf := frames.parse_headers(frame)!
        block := server.conn.read_header_block(hf)!
        # decode in receive order to keep the single hpack decoder in step, even
        # for a stream we are about to refuse.
        fields := server.conn.decoder.decode(block)!
        open_stream(server, hf, fields)
        return true
    if t == frames.FRAME_DATA:
        df := frames.parse_data(frame)!
        server.deliver(df.stream_id, data_event(df.data, df.end_stream))
        # flow control counts the whole frame payload; grant the credit back so a
        # larger request body keeps flowing.
        replenish(server, df.stream_id, frame.header.length, df.end_stream)
        return true
    if t == frames.FRAME_SETTINGS:
        sf := frames.parse_settings(frame)!
        if not sf.ack:
            # apply the client's limits (initial window, max frame size, header
            # table size) to our send side before acking them, so a response is
            # framed and gated to what the client accepts.
            apply_peer_settings(server, sf.settings)
            server.enqueue_frame(frames.settings_ack_frame())
        return true
    if t == frames.FRAME_WINDOW_UPDATE:
        wu := frames.parse_window_update(frame)!
        # a zero increment is a protocol error (RFC 9113 §6.9.1); ignore the frame
        # rather than tear the connection down over it.
        if wu.increment != 0:
            grant_send_credit(server, wu.stream_id, wu.increment)
        return true
    if t == frames.FRAME_PING:
        pf := frames.parse_ping(frame)!
        if not pf.ack:
            server.enqueue_frame(frames.ping_ack_frame(pf.opaque)!)
        return true
    if t == frames.FRAME_RST_STREAM:
        rs := frames.parse_rst_stream(frame)!
        server.deliver(rs.stream_id, reset_event(rs.error_code))
        return true
    if t == frames.FRAME_GOAWAY:
        # the client is winding the connection down; stop reading.
        return false
    # PRIORITY, PUSH_PROMISE, and unknown types need no action to serve requests,
    # so they are ignored.
    return true

# apply the client's SETTINGS (RFC 9113 §6.5.2) to our send side. the header
# table size bounds our hpack encoder so the indices we emit stay valid for the
# client's decoder; the max frame size caps how large a DATA frame we send; the
# initial window size seeds new streams' send credit and, per §6.9.2, adjusts
# every open stream's window by the delta from the previous value. other
# identifiers do not shape what the server sends, so they are ignored.
fn apply_peer_settings(server: Server, settings: List[frames.Setting]):
    server.mu.lock()
    for s in settings:
        if s.id == SETTINGS_HEADER_TABLE_SIZE:
            server.conn.encoder.set_max_table_size(s.value)
        elif s.id == SETTINGS_MAX_FRAME_SIZE:
            server.peer_max_frame_size = s.value
        elif s.id == SETTINGS_INITIAL_WINDOW_SIZE:
            delta := s.value - server.peer_initial_window
            server.peer_initial_window = s.value
            for sid in server.active:
                if server.send_windows.contains_key(sid):
                    server.send_windows.insert(sid, server.send_windows[sid] + delta)
    server.mu.unlock()

# whether a decoded header name or value is free of the octets that MUST NOT
# appear in an http/2 field: NUL, CR, and LF. bridging such a field into an
# http/1.1 head would splice new header lines (RFC 9113 §8.2.1 treats a field
# carrying one as malformed), so a request that contains one is refused before it
# is ever assembled.
fn field_text_is_clean(text: String) -> Bool:
    data := bytes.from_string_utf8(text)
    mut i := 0
    while i < data.len():
        b := data[i]
        if b == 0 or b == 10 or b == 13:
            return false
        i = i + 1
    return true

fn header_fields_are_clean(fields: List[hpack.HeaderField]) -> Bool:
    for field in fields:
        if not field_text_is_clean(field.name) or not field_text_is_clean(field.value):
            return false
    return true

# whether a decoded header list stays within the server's size limits, so a giant
# header block cannot exhaust memory even after hpack decompression.
fn header_list_within_limits(fields: List[hpack.HeaderField]) -> Bool:
    if fields.len() > MAX_HEADER_COUNT:
        return false
    mut total := 0
    for field in fields:
        total = total + field.name.len() + field.value.len()
    return total <= MAX_HEADER_LIST_BYTES

# open (or feed) a request stream from a decoded HEADERS block. a new odd stream
# id that passes validation gets an inbox and a handler task; a duplicate id feeds
# the existing stream (trailers). malformed requests and over-cap streams are
# refused with RST_STREAM.
fn open_stream(server: Server, hf: frames.HeadersFrame, fields: List[hpack.HeaderField]):
    stream_id := hf.stream_id
    # refuse a request whose headers would splice extra lines when bridged to
    # http/1.1, or whose header list is over-large, before opening or feeding any
    # stream. the block was already decoded by the caller, so the shared hpack
    # decoder stays in step even though we drop the request.
    if not header_fields_are_clean(fields):
        server.reset(stream_id, frames.ERROR_PROTOCOL_ERROR)
        return
    if not header_list_within_limits(fields):
        server.reset(stream_id, frames.ERROR_ENHANCE_YOUR_CALM)
        return
    # a header block for a stream we already know is the request trailers.
    server.mu.lock()
    known := server.streams.contains_key(stream_id)
    server.mu.unlock()
    if known:
        server.deliver(stream_id, headers_event(fields, hf.end_stream))
        return
    # client-initiated streams are odd (RFC 9113 §5.1.1); reject anything else.
    if stream_id % 2 == 0:
        server.reset(stream_id, frames.ERROR_PROTOCOL_ERROR)
        return
    # a request must carry ":method" and ":path" (RFC 9113 §8.3.1).
    if pseudo(fields, ":method") == "" or pseudo(fields, ":path") == "":
        server.reset(stream_id, frames.ERROR_PROTOCOL_ERROR)
        return
    # enforce the advertised concurrency cap.
    if server.active_count() >= SERVER_MAX_CONCURRENT_STREAMS:
        server.reset(stream_id, frames.ERROR_REFUSED_STREAM)
        return
    inbox := Channel[StreamEvent](STREAM_INBOX_CAP)
    server.register(stream_id, inbox)
    # spawn the handler before delivering the first event: the inbox is buffered,
    # so the send never blocks the reader waiting for the handler to start.
    spawn handle_stream(server, stream_id, inbox)
    server.deliver(stream_id, headers_event(fields, hf.end_stream))

# grant flow-control credit for consumed body bytes: at the connection level
# always, and at the stream level while the stream stays open. mirrors the
# client's replenish, routed through the writer so the socket stays single-owner.
fn replenish(server: Server, stream_id: Int, amount: Int, end_stream: Bool):
    if amount <= 0:
        return
    conn_update := frames.window_update_frame(0, amount)
    if not conn_update.is_err:
        server.enqueue_frame(conn_update.ok)
    if not end_stream:
        stream_update := frames.window_update_frame(stream_id, amount)
        if not stream_update.is_err:
            server.enqueue_frame(stream_update.ok)

# the reader loop: read frames and dispatch until the client goes away, the
# connection drops, or a frame cannot be processed (a connection-level protocol
# error). on any exit it winds the connection down: send a GOAWAY, close the
# stream inboxes so handlers unblock, and close the outbound queue so the writer
# flushes and stops.
fn run_reader(server: Server):
    while true:
        attempt := server.conn.read_frame()
        if attempt.is_err:
            break
        outcome := handle_frame(server, attempt.ok)
        if outcome.is_err:
            send_goaway(server, frames.ERROR_PROTOCOL_ERROR)
            break
        if not outcome.ok:
            break
    server.shutdown_streams()
    send_goaway(server, frames.ERROR_NO_ERROR)
    server.outbound.close()

# best-effort GOAWAY to the client, naming the highest stream id we accepted.
fn send_goaway(server: Server, error_code: Int):
    server.mu.lock()
    last := server.last_stream_id
    server.mu.unlock()
    frame := frames.goaway_frame(last, error_code, bytes.empty())
    if not frame.is_err:
        server.enqueue_frame(frame.ok)

# --- entry points ---

# serve one accepted h2c connection to completion: read and validate the client
# preface, exchange SETTINGS, then run the reader and writer tasks until the
# connection closes. errors (a bad preface, a dropped socket) are swallowed so a
# broken client only ever affects its own connection. spawn this per accepted
# socket, or call it directly to serve a single connection.
pub fn serve_h2c_connection(fd: Int, handler: fn(http.HttpRequestBytes) -> http.HttpResponse):
    conn := new_live_server_conn(fd)
    serve_connection(conn, handler) catch false
    conn.close()

# the connection lifecycle, factored out so the offline tests can drive it over a
# ServerConn without a socket. reads the preface, sends the server SETTINGS,
# spawns the writer, and runs the reader loop on the calling task; when the reader
# returns it waits for the writer to flush and stop.
fn serve_connection(conn: ServerConn, handler: fn(http.HttpRequestBytes) -> http.HttpResponse) -> Bool!:
    return run_connection(conn, handler, false)!

# serve_connection with the streaming switch explicit: `streaming` true routes
# every stream to the process-wide streaming handler instead of `handler`.
fn run_connection(conn: ServerConn, handler: fn(http.HttpRequestBytes) -> http.HttpResponse, streaming: Bool) -> Bool!:
    conn.read_preface()!
    conn.send_frame(server_settings_frame()!)!
    outbound := Channel[Outbound](OUTBOUND_CAP)
    closed := AtomicInt(0)
    writer := spawn writer_loop(conn, outbound, closed)
    streams: Map[Int, Channel[StreamEvent]] := {}
    ids: List[Int] := []
    send_windows: Map[Int, Int] := {}
    credit: Map[Int, Channel[Int]] := {}
    # the send side starts at http/2's defaults; the client's SETTINGS (its first
    # frame) revises the initial window and max frame size before any stream opens.
    server := Server(conn, handler, streaming, outbound, Mutex(), streams, ids, 0, closed, DEFAULT_INITIAL_WINDOW, frames.DEFAULT_MAX_FRAME_SIZE, DEFAULT_INITIAL_WINDOW, send_windows, credit)
    run_reader(server)
    await writer
    return true

# bind host:port for cleartext h2c and serve forever, accepting connections and
# running each on its own task. this blocks, so it is usually the last thing main
# does; spawn it if you need to keep going. mirrors std.web's listen and
# std.prometheus's serve.
pub fn listen_h2c(host: String, port: Int, handler: fn(http.HttpRequestBytes) -> http.HttpResponse) -> Int!:
    fd := tcp_listen(host, port)!
    while true:
        client := tcp_accept(fd)!
        spawn serve_h2c_connection(client, handler)
    return 0

# serve one accepted tls connection as http/2 to completion. the tls handshake
# (with its alpn negotiation) has already happened; this checks that the peer
# negotiated "h2" and then runs the same reader/writer/handler loop as h2c, only
# over the tls session instead of a plain socket. a peer that did not negotiate
# "h2" is closed without serving — an http/1.1 fallback over the same listener is
# std.web's concern (a later phase), not this native h2 server's. spawn this per
# accepted tls connection, or call it directly to serve one.
pub fn serve_h2_tls_connection(tls_conn: tls.Conn, handler: fn(http.HttpRequestBytes) -> http.HttpResponse):
    if tls_conn.negotiated_protocol() != "h2":
        tls_conn.close()
        return
    conn := new_tls_server_conn(tls_conn.handle)
    serve_connection(conn, handler) catch false
    conn.close()

# bind host:port for http/2 over tls and serve forever. it builds a tls server
# config from the pem `cert`/`key` files, offers alpn "h2" (and "http/1.1", which
# a peer may pick but this server does not yet serve — see serve_h2_tls_connection),
# accepts tls connections, and runs each on its own task. this blocks, so it is
# usually the last thing main does; spawn it if you need to keep going. mirrors
# listen_h2c, only over tls.
pub fn listen_h2_tls(host: String, port: Int, cert: String, key: String, handler: fn(http.HttpRequestBytes) -> http.HttpResponse) -> Int!:
    config := tls.server_config(cert, key)!.with_alpn(["h2", "http/1.1"])
    listener := tls.listen(host, port, config)!
    while true:
        client := tls.accept(listener)!
        spawn serve_h2_tls_connection(client, handler)
    return 0

# --- streaming entry points ---
#
# the streaming twins of the buffered entry points above. the handler receives a
# live ServerStream per request instead of a buffered HttpRequestBytes; it is
# stored in the process-wide slot (see stream_handler_fn), so one process runs
# one streaming handler. the buffered listen paths are untouched.

# the buffered-handler slot of a streaming server. never called — handle_stream
# routes to the streaming path first — but the Server struct still carries one.
fn streaming_unused_handler(req: http.HttpRequestBytes) -> http.HttpResponse:
    return http.response(500)

# serve one accepted h2c connection on the streaming path. mirrors
# serve_h2c_connection; the handler comes from the process-wide slot.
pub fn serve_h2c_streaming_connection(fd: Int):
    conn := new_live_server_conn(fd)
    run_connection(conn, streaming_unused_handler, true) catch false
    conn.close()

# bind host:port for cleartext h2c and serve forever, handing each request
# stream to `handler` while it is still arriving. mirrors listen_h2c.
pub fn listen_h2c_streaming(host: String, port: Int, handler: fn(ServerStream) -> Int) -> Int!:
    stream_handler_fn = handler
    fd := tcp_listen(host, port)!
    while true:
        client := tcp_accept(fd)!
        spawn serve_h2c_streaming_connection(client)
    return 0

# serve one accepted tls connection on the streaming path. mirrors
# serve_h2_tls_connection, including the alpn "h2" check.
pub fn serve_h2_tls_streaming_connection(tls_conn: tls.Conn):
    if tls_conn.negotiated_protocol() != "h2":
        tls_conn.close()
        return
    conn := new_tls_server_conn(tls_conn.handle)
    run_connection(conn, streaming_unused_handler, true) catch false
    conn.close()

# bind host:port for http/2 over tls and serve forever on the streaming path.
# mirrors listen_h2_tls.
pub fn listen_h2_tls_streaming(host: String, port: Int, cert: String, key: String, handler: fn(ServerStream) -> Int) -> Int!:
    stream_handler_fn = handler
    config := tls.server_config(cert, key)!.with_alpn(["h2", "http/1.1"])
    listener := tls.listen(host, port, config)!
    while true:
        client := tls.accept(listener)!
        spawn serve_h2_tls_streaming_connection(client)
    return 0

# --- offline frame tests ---
#
# these drive the server's pieces over an offline ServerConn (no socket): the
# preface check, the request bridge, the response encoder, and the control-frame
# acks. they assert the exact wire frames, so they are deterministic and fit ci.
# the concurrent reader/handler/writer round trip is exercised live against curl
# and a real h2 client (see the phase report), which does not belong in ci.

# hpack-encode a header list with a fresh encoder, so a fresh decoder (empty
# dynamic table) decodes it in isolation.
fn encode_block(fields: List[hpack.HeaderField]) -> Bytes:
    encoder := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    return encoder.encode(fields)

# the handler the test server answers every request with.
fn ok_handler(req: http.HttpRequestBytes) -> http.HttpResponse:
    return http.text(200, "ok")

# a Server over an offline connection with a real outbound queue but no live
# writer, so a test can call handle_frame/open_stream and drain what they enqueue.
fn test_server(conn: ServerConn) -> Server:
    streams: Map[Int, Channel[StreamEvent]] := {}
    ids: List[Int] := []
    send_windows: Map[Int, Int] := {}
    credit: Map[Int, Channel[Int]] := {}
    return Server(conn, ok_handler, false, Channel[Outbound](OUTBOUND_CAP), Mutex(), streams, ids, 0, AtomicInt(0), DEFAULT_INITIAL_WINDOW, frames.DEFAULT_MAX_FRAME_SIZE, DEFAULT_INITIAL_WINDOW, send_windows, credit)

# the ":status" of a decoded response header list, or 0 when absent.
fn find_status(fields: List[hpack.HeaderField]) -> Int:
    for field in fields:
        if field.name == ":status":
            return parse_int(field.value).unwrap_or(0)
    return 0

# whether a decoded header list carries `name` with `value`.
fn has_field(fields: List[hpack.HeaderField], name: String, value: String) -> Bool:
    for field in fields:
        if field.name == name and field.value == value:
            return true
    return false

# whether a decoded header list carries any field named `name`.
fn has_name(fields: List[hpack.HeaderField], name: String) -> Bool:
    for field in fields:
        if field.name == name:
            return true
    return false

test "read_preface accepts the exact client preface and rejects anything else":
    good := server_conn_from_bytes(bytes.from_string_utf8(PREFACE))
    assert(good.read_preface()!)
    # twenty-four bytes so fill() succeeds and only the comparison fails.
    bad := server_conn_from_bytes(bytes.from_string_utf8("GET / HTTP/1.1\r\n\r\nXXXXXX"))
    assert(bad.read_preface().is_err)

test "build_request synthesizes an http/1.1 request from the pseudo-headers":
    fields := [hpack.header_field(":method", "GET"), hpack.header_field(":path", "/hello?q=1"), hpack.header_field(":scheme", "http"), hpack.header_field(":authority", "example.com"), hpack.header_field("accept", "text/plain")]
    req := build_request(fields, bytes.empty())!
    assert_eq(req.method()!, "GET")
    assert_eq(req.path()!, "/hello")
    assert_eq(req.query()!, "q=1")
    assert_eq(req.header_or("host", ""), "example.com")
    assert_eq(req.header_or("accept", ""), "text/plain")

test "send_headers emits HEADERS with :status and leaves the stream open for a body":
    conn := server_conn_from_bytes(bytes.empty())
    resp := http.text(200, "hello h2c")
    # a body response: HEADERS must not carry END_STREAM (the DATA follows).
    send_headers(conn, 1, response_fields(resp), false)!
    reader := binary.reader(conn.sent)
    header_frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
    assert_eq(header_frame.header.frame_type, frames.FRAME_HEADERS)
    hf := frames.parse_headers(header_frame)!
    assert(not hf.end_stream)
    decoder := hpack.new_decoder(hpack.DEFAULT_HEADER_TABLE_SIZE)
    decoded := decoder.decode(hf.block_fragment)!
    assert_eq(find_status(decoded), 200)
    assert(has_field(decoded, "content-type", "text/plain"))
    # send_headers writes only the header block; the body is streamed separately.
    assert_eq(binary.remaining(reader), 0)

test "send_headers puts END_STREAM on HEADERS for a bodiless response":
    conn := server_conn_from_bytes(bytes.empty())
    resp := http.response(204)
    send_headers(conn, 3, response_fields(resp), true)!
    reader := binary.reader(conn.sent)
    header_frame := frames.read_frame(reader, frames.MAX_ALLOWED_FRAME_SIZE)!
    hf := frames.parse_headers(header_frame)!
    assert(hf.end_stream)
    # no DATA frame follows a bodiless response.
    assert_eq(binary.remaining(reader), 0)

test "response_fields lowercases names and strips hop-by-hop headers":
    mut resp := http.response(200)
    resp = resp.header("X-Custom", "yes")
    resp = resp.header("Connection", "close")
    fields := response_fields(resp)
    assert_eq(find_status(fields), 200)
    assert(has_field(fields, "x-custom", "yes"))
    assert(not has_name(fields, "connection"))

test "a client SETTINGS frame is answered with an ack":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    settings := frames.settings_frame([frames.setting(SETTINGS_MAX_CONCURRENT_STREAMS, 10)])!
    handle_frame(server, settings)!
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    assert_eq(item.kind, OUT_RAW)
    ack := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    assert(frames.parse_settings(ack)!.ack)

test "a client PING is answered with a PING ack carrying the same payload":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    payload := bytes.from_string_utf8("pingpong")
    handle_frame(server, frames.ping_frame(payload)!)!
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    reply := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    parsed := frames.parse_ping(reply)!
    assert(parsed.ack)
    assert_eq(parsed.opaque.to_string_utf8()!, "pingpong")

test "open_stream refuses an even stream id with RST_STREAM":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    fields := [hpack.header_field(":method", "GET"), hpack.header_field(":path", "/")]
    hf := frames.parse_headers(frames.headers_frame(2, encode_block(fields), true, true))!
    open_stream(server, hf, fields)
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    rst := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    assert_eq(rst.header.frame_type, frames.FRAME_RST_STREAM)

test "open_stream refuses a request missing :path with RST_STREAM":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    fields := [hpack.header_field(":method", "GET"), hpack.header_field(":scheme", "http")]
    hf := frames.parse_headers(frames.headers_frame(1, encode_block(fields), true, true))!
    open_stream(server, hf, fields)
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    rst := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    parsed := frames.parse_rst_stream(rst)!
    assert_eq(parsed.error_code, frames.ERROR_PROTOCOL_ERROR)

# --- request-hardening tests ---

test "the header octet check rejects CR, LF, and NUL but passes clean text":
    assert(field_text_is_clean("text/plain"))
    assert(not field_text_is_clean("a" + chr(13) + chr(10) + "b"))
    assert(not field_text_is_clean("a" + chr(10) + "b"))
    assert(not field_text_is_clean("a" + chr(0) + "b"))

test "open_stream refuses a header value carrying a CRLF injection with RST_STREAM":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    # a value that, if concatenated into an http/1.1 head, would splice a new
    # header line — exactly the request-smuggling vector the guard closes.
    evil := "keep" + chr(13) + chr(10) + "x-injected: yes"
    fields := [hpack.header_field(":method", "GET"), hpack.header_field(":path", "/"), hpack.header_field("x-note", evil)]
    hf := frames.parse_headers(frames.headers_frame(1, encode_block(fields), true, true))!
    open_stream(server, hf, fields)
    # rejected with a stream error, and no stream was opened for it.
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    rst := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    assert_eq(rst.header.frame_type, frames.FRAME_RST_STREAM)
    assert_eq(frames.parse_rst_stream(rst)!.error_code, frames.ERROR_PROTOCOL_ERROR)
    assert_eq(server.active_count(), 0)

test "open_stream refuses an over-large header list with RST_STREAM":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    mut fields: List[hpack.HeaderField] := [hpack.header_field(":method", "GET"), hpack.header_field(":path", "/")]
    # push the field count past MAX_HEADER_COUNT so the size guard trips.
    mut n := 0
    while n <= MAX_HEADER_COUNT:
        fields.push(hpack.header_field("x-pad", "v"))
        n = n + 1
    assert(not header_list_within_limits(fields))
    hf := frames.parse_headers(frames.headers_frame(1, encode_block(fields), true, true))!
    open_stream(server, hf, fields)
    opt := server.outbound.try_recv()
    assert(opt != none)
    item := opt.unwrap_or(raw_item(bytes.empty()))
    rst := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    assert_eq(rst.header.frame_type, frames.FRAME_RST_STREAM)
    assert_eq(frames.parse_rst_stream(rst)!.error_code, frames.ERROR_ENHANCE_YOUR_CALM)
    assert_eq(server.active_count(), 0)

test "read_header_block refuses a CONTINUATION flood":
    # a header block that never sets END_HEADERS, followed by more CONTINUATION
    # frames than the cap allows. before the frame-count cap this loops forever,
    # buffering every fragment; now it aborts instead of exhausting memory.
    flood := bytes.buffer()
    mut i := 0
    while i <= MAX_CONTINUATION_FRAMES:
        flood.write(frames.frame_bytes(frames.continuation_frame(1, bytes.from_string_utf8("x"), false))!)!
        i = i + 1
    conn := server_conn_from_bytes(flood.bytes())
    hf := frames.parse_headers(frames.headers_frame(1, bytes.from_string_utf8("start"), false, false))!
    result := conn.read_header_block(hf)
    assert(result.is_err)

test "read_header_block refuses a header block past the byte cap":
    # a handful of large CONTINUATION fragments push the accumulated block past the
    # byte ceiling well before the frame-count cap; the read aborts on size.
    mut big := bytes.from_string_utf8("aaaaaaaa")
    while big.len() < 16384:
        big = bytes.concat(big, big)
    flood := bytes.buffer()
    mut i := 0
    while i < 8:
        flood.write(frames.frame_bytes(frames.continuation_frame(1, big, false))!)!
        i = i + 1
    conn := server_conn_from_bytes(flood.bytes())
    hf := frames.parse_headers(frames.headers_frame(1, bytes.empty(), false, false))!
    result := conn.read_header_block(hf)
    assert(result.is_err)

test "assemble_request rejects a request body larger than the limit":
    # a single DATA event just past http.MAX_REQUEST_BODY: the accumulation cap must
    # trip before the body is fully buffered.
    mut block := bytes.from_string_utf8("0123456789abcdef")
    while block.len() <= http.MAX_REQUEST_BODY:
        block = bytes.concat(block, block)
    inbox := Channel[StreamEvent](2)
    inbox.send(data_event(block, false))
    result := assemble_request(inbox)
    assert(result.is_err)
    assert_eq(result.err, BODY_TOO_LARGE)

# --- send-side flow-control tests ---

# register a stream on an offline server with the given send windows, ready for
# the flow-control helpers to act on it (mirrors the client's arm_send_stream).
fn arm_send_stream(server: Server, stream_id: Int, stream_window: Int, conn_window: Int, max_frame: Int):
    server.active.push(stream_id)
    server.send_windows.insert(stream_id, stream_window)
    server.credit.insert(stream_id, Channel[Int](CREDIT_POKE_CAP))
    server.conn_send_window = conn_window
    server.peer_max_frame_size = max_frame

# read the next DATA frame off the server's outbound queue, failing if it closed
# or the item was not a serialized frame.
fn next_data_frame(ch: Channel[Outbound]) -> frames.DataFrame!:
    opt := ch.recv()
    if opt == none:
        fail "expected a DATA frame but the outbound queue was closed"
    item := opt.unwrap_or(raw_item(bytes.empty()))
    frame := frames.read_frame(binary.reader(item.raw), frames.MAX_ALLOWED_FRAME_SIZE)!
    return frames.parse_data(frame)!

test "reserve_send is bounded by the stream and connection windows and the frame cap":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    arm_send_stream(server, 1, 10, 6, 100)
    # min(want 8, stream 10, conn 6, frame 100) = 6, debited from both windows.
    assert_eq(server.reserve_send(1, 8), 6)
    assert_eq(server.send_windows[1], 4)
    assert_eq(server.conn_send_window, 0)
    # no connection credit left: nothing more can be reserved.
    assert_eq(server.reserve_send(1, 4), 0)

test "grant_send_credit grows the stream and connection send windows":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    arm_send_stream(server, 1, 0, 0, 100)
    grant_send_credit(server, 1, 50)
    assert_eq(server.send_windows[1], 50)
    grant_send_credit(server, 0, 30)
    assert_eq(server.conn_send_window, 30)

test "send_stream_data splits a large body across the window and finishes after a WINDOW_UPDATE":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    # a 4-byte window on both the stream and the connection, a large frame cap.
    arm_send_stream(server, 1, 4, 4, 100)
    body := bytes.from_string_utf8("abcdefghij")
    sender := spawn send_stream_data(server, 1, body, true)
    # the first DATA carries the initial 4-byte window. reading it proves the
    # sender is now blocked on more credit, so the split is deterministic.
    first := next_data_frame(server.outbound)!
    assert_eq(first.data.to_string_utf8()!, "abcd")
    assert(not first.end_stream)
    # grant the remaining six bytes on both windows; the sender wakes and finishes.
    grant_send_credit(server, 1, 6)
    grant_send_credit(server, 0, 6)
    total := await sender
    assert_eq(total, 10)
    second := next_data_frame(server.outbound)!
    assert_eq(second.data.to_string_utf8()!, "efghij")
    assert(second.end_stream)

test "send_stream_data caps each DATA frame at the client's max frame size":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    # a wide window but a tiny 4-byte frame cap forces one frame per four bytes.
    arm_send_stream(server, 1, 1000, 1000, 4)
    total := send_stream_data(server, 1, bytes.from_string_utf8("abcdefgh"), true)
    assert_eq(total, 8)
    first := next_data_frame(server.outbound)!
    assert_eq(first.data.to_string_utf8()!, "abcd")
    assert(not first.end_stream)
    second := next_data_frame(server.outbound)!
    assert_eq(second.data.to_string_utf8()!, "efgh")
    assert(second.end_stream)

test "a WINDOW_UPDATE frame grants the server send credit":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    arm_send_stream(server, 1, 0, 0, 100)
    handle_frame(server, frames.window_update_frame(1, 20)!)!
    assert_eq(server.send_windows[1], 20)
    handle_frame(server, frames.window_update_frame(0, 15)!)!
    assert_eq(server.conn_send_window, 15)

test "a client SETTINGS_INITIAL_WINDOW_SIZE resizes the server's open send windows":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    arm_send_stream(server, 1, DEFAULT_INITIAL_WINDOW, DEFAULT_INITIAL_WINDOW, 100)
    apply_peer_settings(server, [frames.setting(SETTINGS_INITIAL_WINDOW_SIZE, 1000), frames.setting(SETTINGS_MAX_FRAME_SIZE, 32768)])
    assert_eq(server.peer_initial_window, 1000)
    # the open stream shrinks by the delta: 65535 + (1000 - 65535) = 1000.
    assert_eq(server.send_windows[1], 1000)
    assert_eq(server.peer_max_frame_size, 32768)

# --- streaming-path tests ---

# a ServerStream over an offline test server: stream id 1, the given inbox, a
# minimal POST head, and the body not yet finished.
fn test_stream(server: Server, inbox: Channel[StreamEvent]) -> ServerStream!:
    fields := [hpack.header_field(":method", "POST"), hpack.header_field(":path", "/s")]
    return ServerStream(server, 1, inbox, build_request(fields, bytes.empty())!, false)

test "a streaming ServerStream reads body chunks then reports a sticky end":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    inbox := Channel[StreamEvent](4)
    inbox.send(data_event(bytes.from_string_utf8("hi"), false))
    inbox.send(data_event(bytes.empty(), true))
    stream := test_stream(server, inbox)!
    first := stream.recv_event()
    assert(first.is_data())
    assert_eq(first.data.to_string_utf8()!, "hi")
    assert(not first.end)
    second := stream.recv_event()
    assert(second.end)
    # the request has finished: recv keeps reporting end without blocking.
    third := stream.recv_event()
    assert(third.is_data())
    assert(third.end)

test "a streaming ServerStream reads a reset and a closed inbox as resets":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    inbox := Channel[StreamEvent](2)
    inbox.send(reset_event(frames.ERROR_STREAM_CLOSED))
    stream := test_stream(server, inbox)!
    ev := stream.recv_event()
    assert(ev.is_reset())
    assert_eq(ev.error_code, frames.ERROR_STREAM_CLOSED)
    # a closed inbox (the connection went away) reads as a CANCEL reset.
    closed_inbox := Channel[StreamEvent](2)
    closed_inbox.close()
    other := test_stream(server, closed_inbox)!
    ev2 := other.recv_event()
    assert(ev2.is_reset())
    assert_eq(ev2.error_code, frames.ERROR_CANCEL)

test "a streaming ServerStream sends headers, data, and trailers in order":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    arm_send_stream(server, 1, 100, 100, 100)
    inbox := Channel[StreamEvent](2)
    stream := test_stream(server, inbox)!
    stream.send_headers([hpack.header_field(":status", "200")], false)
    stream.send_data(bytes.from_string_utf8("payload"), false)
    stream.send_trailers([hpack.header_field("grpc-status", "0")])
    # the response HEADERS first, leaving the stream open.
    hopt := server.outbound.try_recv()
    assert(hopt != none)
    head := hopt.unwrap_or(raw_item(bytes.empty()))
    assert_eq(head.kind, OUT_RESPONSE)
    assert(not head.end_stream)
    assert(has_field(head.fields, ":status", "200"))
    # then the flow-controlled DATA.
    df := next_data_frame(server.outbound)!
    assert_eq(df.data.to_string_utf8()!, "payload")
    assert(not df.end_stream)
    # then the trailers, which end the stream.
    topt := server.outbound.try_recv()
    assert(topt != none)
    tail := topt.unwrap_or(raw_item(bytes.empty()))
    assert_eq(tail.kind, OUT_RESPONSE)
    assert(tail.end_stream)
    assert(has_field(tail.fields, "grpc-status", "0"))

# the streaming handler the offline handle_streaming_stream test registers: send
# a 200 head, echo each body chunk as it arrives, then trail out.
fn echo_stream_handler(stream: ServerStream) -> Int:
    stream.send_headers([hpack.header_field(":status", "200")], false)
    while true:
        ev := stream.recv_event()
        if ev.is_reset():
            return 0
        if ev.is_data() and ev.data.len() > 0:
            stream.send_data(ev.data, false)
        if ev.end:
            break
    stream.send_trailers([hpack.header_field("x-done", "1")])
    return 0

test "handle_streaming_stream parses the head and drives the streaming handler":
    server := test_server(server_conn_from_bytes(bytes.empty()))
    stream_handler_fn = echo_stream_handler
    inbox := Channel[StreamEvent](8)
    server.register(1, inbox)
    fields := [hpack.header_field(":method", "POST"), hpack.header_field(":path", "/echo")]
    inbox.send(headers_event(fields, false))
    inbox.send(data_event(bytes.from_string_utf8("ping"), true))
    handle_streaming_stream(server, 1, inbox)
    # the handler's output, in order: HEADERS, the echoed DATA, the trailers.
    hopt := server.outbound.try_recv()
    assert(hopt != none)
    head := hopt.unwrap_or(raw_item(bytes.empty()))
    assert_eq(head.kind, OUT_RESPONSE)
    assert(has_field(head.fields, ":status", "200"))
    df := next_data_frame(server.outbound)!
    assert_eq(df.data.to_string_utf8()!, "ping")
    topt := server.outbound.try_recv()
    assert(topt != none)
    tail := topt.unwrap_or(raw_item(bytes.empty()))
    assert(tail.end_stream)
    assert(has_field(tail.fields, "x-done", "1"))
    # the stream was forgotten when the handler returned.
    assert_eq(server.active_count(), 0)
