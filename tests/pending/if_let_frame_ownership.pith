# PENDING. not registered in tooling/leak_check.sh; shapes 1, 2 and 3 fail.
#
# an `if let` binds correctly in a lambda body and in a generic body now, but
# neither frame releases what the binding leaves behind, because neither frame
# runs the rc prologue a concrete named function's body runs:
#
#   - a lambda body never calls ir_emit_rc_prologue at all, so it tracks no
#     locals, zero-stores none of them, and releases none of them at exit.
#   - a generic specialization runs the bind prepass but keeps no tuple local
#     (ir_spec_local_is_confined), so an optional local's shell is allocated,
#     given its destructor, and then dropped on the floor.
#
# the leak-free arms of the same construct are gated in
# tests/leaks/leak_lambda_if_let.pith: a lambda `if let` over a CALL subject
# with a by-value payload allocates and frees its shell correctly, because the
# owned-shell release at the merge is emitted per path and owes nothing to the
# frame's local tracking.
#
# measured on this file at PITH_LEAK_ROUNDS 200000 vs 800000:
#   shape 1, lambda, if let over a bound Int? local        15.2 mb -> 52.7 mb
#   shape 2, lambda, if let over a String? call subject    10.2 mb -> 32.7 mb
#   shape 3, generic body, if let over a bound Int? local  15.1 mb -> 52.6 mb
#   shape 4, named fn, if let over a bound Int? local       2.7 mb ->  2.7 mb
#   shape 5, named fn, if let over a String? call subject   2.8 mb ->  2.7 mb
#
# shape 4 is the passing twin of shapes 1 and 3 — the same body, in a frame
# that runs the prologue — and shape 5 is the passing twin of shape 2. the
# only difference in each pair is the frame the construct sits in.
#
# shape 1's growth is the two-slot shell alone (a by-value payload strands
# nothing), so it is the unowned-shell half; shape 2's is the count the
# binding takes on a string payload, so it is the stranded-payload half.
# register shapes 1, 2 and 3 in tooling/leak_check.sh once the frames own what
# they bind.
import pendingprobe as probe
import std.env as env

fn count_of(i: Int) -> Int?:
    if i % 7 == 6:
        return none
    return i

fn name_of(i: Int) -> String?:
    if i % 5 == 4:
        return none
    return "name-" + i.to_string()

# the generic twin of shape 1: the same body, with a type parameter that makes
# the emitter take the specialization path
fn generic_bound[T](t: T, i: Int) -> Int:
    k: Int? := i % 9
    mut m := 0
    if let v = k:
        m = v
    return m

fn named_bound(i: Int) -> Int:
    k: Int? := i % 9
    mut m := 0
    if let v = k:
        m = v
    return m

fn named_call(i: Int) -> Int:
    mut m := 0
    if let v = name_of(i):
        m = v.len()
    return m

fn main():
    n := probe.rounds()
    shape := env.int_or("SHAPE", 1)

    lambda_bound := fn(i: Int) -> Int:
        k: Int? := i % 9
        mut m := 0
        if let v = k:
            m = v
        return m

    lambda_call := fn(i: Int) -> Int:
        mut m := 0
        if let v = name_of(i):
            m = v.len()
        return m

    mut i := 0
    mut total := 0
    while i < n:
        if shape == 1:
            total = total + lambda_bound(i)
        elif shape == 2:
            total = total + lambda_call(i)
        elif shape == 3:
            total = total + generic_bound(1, i)
        elif shape == 4:
            total = total + named_bound(i)
        else:
            total = total + named_call(i)
        i = i + 1
    kb := probe.peak_kb()
    if total < 0 or count_of(0) == none:
        print("unreachable")
    print("{kb}")
