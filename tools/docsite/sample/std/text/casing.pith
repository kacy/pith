## std.text.casing - a nested module using ## doc markers and a plain hyphen
##
## much of std marks doc comments this way, so the fixture pins that the whole
## run of hashes is stripped rather than just the first.

## the marker this module documents itself with.
pub MARKER := "##"

## shout a string.
##
## a second line of the same doc comment, to pin multi-line joining.
pub fn shout(text: String) -> String:
    return text.to_upper()

pub fn undocumented_on_purpose(text: String) -> String:
    return text
