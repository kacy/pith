# error handling: results with a typed error, fail, !, catch and unwrap_or.
#
# validates server settings read from a config file. each check either
# returns a value or fails with a ConfigError, an enum, so the caller can
# tell a missing key from a bad number and print a precise message. bare
# `T!` carries a String error; `T!ConfigError` carries this enum instead.

enum ConfigError:
    Missing(String)
    NotANumber(String, String)
    OutOfRange(String, Int)

impl ConfigError:
    fn message() -> String:
        return match self:
            ConfigError.Missing(key) => "{key} is missing"
            ConfigError.NotANumber(key, text) => "{key} is not a number: {text}"
            ConfigError.OutOfRange(key, value) => "{key} is out of range: {value}"

struct ServerConfig:
    host: String
    port: Int
    workers: Int

fn require(settings: Map[String, String], key: String) -> String!ConfigError:
    if let value = settings.get(key):
        return value
    fail ConfigError.Missing(key)

fn read_int(settings: Map[String, String], key: String, low: Int, high: Int) -> Int!ConfigError:
    text := require(settings, key)!
    # parse_int fails with a String; the block form of catch turns that into
    # this function's own error type
    value := parse_int(text) catch:
        fail ConfigError.NotANumber(key, text)
    if value < low or value > high:
        fail ConfigError.OutOfRange(key, value)
    return value

# `!` returns the first failure to the caller unchanged
fn load(settings: Map[String, String]) -> ServerConfig!ConfigError:
    host := require(settings, "host")!
    port := read_int(settings, "port", 1, 65535)!
    # an optional setting: any failure falls back to the default
    workers := read_int(settings, "workers", 1, 64) catch 4
    return ServerConfig(host: host, port: port, workers: workers)

fn main():
    files := [
        {"host": "api.internal", "port": "8443", "workers": "16"},
        {"host": "api.internal", "port": "8443"},
        {"host": "api.internal", "port": "http"},
        {"host": "api.internal", "port": "70000"},
        {"port": "8443"},
    ]
    for settings, index in files:
        result := load(settings)
        if result.is_err:
            print("config {index}: rejected, {result.err.message()}")
            continue
        config := result.ok
        print("config {index}: {config.host}:{config.port} with {config.workers} workers")

    # unwrap_or is the value form of a fallback for any result
    print("default port: {parse_int("not set").unwrap_or(8080)}")
