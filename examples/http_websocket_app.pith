# one std.web app serving plain http and websocket upgrades.
#
# /greet renders a page, /ws upgrades to a websocket session that echoes
# messages, and anything else is a 404. the /ws route answers with
# websocket.take_connection: once the handler returns, the server writes the
# handshake and runs the session on the connection. a plain GET on /ws gets a
# 400. main starts the server on a background task and plays the client.
#
# /greet puts a query parameter into html, so it escapes it with std.html.
# the second greeting is the proof: a script tag comes back as text.

import std.html as html
import std.net.http as http
import std.net.tcp as tcp
import std.net.websocket as websocket
import std.web as web

PORT := 18113

fn greet(req: web.Request) -> http.HttpResponse:
    name := req.query_or("name", "stranger")
    return http.html(200, "<h1>hello, {html.escape(name)}!</h1>")

fn echo_session(ws: websocket.WebSocket) -> Int!:
    mut echoed := 0
    while true:
        # recv_text fails once the client has sent its close frame.
        text := ws.recv_text() catch:
            break
        ws.send_text("echo: {text}")!
        echoed += 1
    return echoed

fn upgrade(req: web.Request) -> http.HttpResponse:
    return websocket.take_connection(req.raw, echo_session)

fn serve(port: Int) -> Int:
    app := web.new().get("/greet", greet).get("/ws", upgrade)
    return app.listen("127.0.0.1", port) catch 0

# connect until the accept loop answers, rather than sleeping for a guess.
fn wait_until_listening(port: Int) -> Bool:
    for attempt in 0..500:
        probe := tcp.connect("127.0.0.1", port) catch:
            sleep(10)
            continue
        tcp.close(probe)
        return true
    return false

fn get(path: String) -> String!:
    resp := http.get_request("127.0.0.1", PORT, path).send()!
    return "{resp.status} {resp.body_text()!}"

fn main() -> Int!:
    spawn serve(PORT)
    if not wait_until_listening(PORT):
        fail "the server never came up"

    print("GET /greet?name=pith      -> {get("/greet?name=pith")!}")
    print("GET /greet?name=<script>  -> {get("/greet?name=<script>alert(1)</script>")!}")
    print("GET /ws, not upgraded     -> {get("/ws")!}")
    print("GET /missing              -> {get("/missing")!}")

    ws := websocket.dial("127.0.0.1", PORT, "/ws")!
    for message in ["pith", "websockets"]:
        ws.send_text(message)!
        print("websocket {message} -> {ws.recv_text()!}")
    ws.close(1000, "done")!
    return 0
