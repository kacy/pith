# the locals a generic body builds and keeps to itself: a string rebound in a
# loop, a list, a map, a set, a bytes value, and a string whose only use is
# the value of a push into a list the same body built. before generic bodies
# were typed, every rc bind in a specialization was published untracked (no
# zero-store, no release of the previous value on rebind, no exit cleanup)
# and each of these leaked once per call. the body is now typed against its
# concrete types and tracked like a concrete one, so the exit cleanup
# releases exactly the count each binding took.
#
# the round's varying text arrives as a parameter, so the case measures the
# locals and nothing else. leak_generic_body_escapes covers the locals that
# leave the frame.
import leakprobe as probe
import std.bytes as bytes

fn churn[T](t: T, tag: String) -> Int:
    mut acc := "seed"
    mut j := 0
    while j < 4:
        acc = acc + "-" + tag
        j = j + 1

    parts: List[String] := []
    piece := "p" + tag
    parts.push(piece)
    parts.push(acc)

    names: Map[String, String] := {}
    seen: Set[String] := {}
    raw := bytes.from_string_utf8("b" + tag)

    return acc.len() + parts.len() + names.len() + seen.len() + raw.len()

fn main():
    n := probe.rounds()
    mut i := 0
    mut total := 0
    while i < n:
        tag := i.to_string()
        total = total + churn(1, tag)
        i = i + 1
    kb := probe.peak_kb()
    if total < 0:
        print("unreachable")
    print("{kb}")
