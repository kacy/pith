# formatter.pith — canonical source code formatter for pith
#
# uses a source-preserving approach: walks source text line by line,
# normalizing whitespace around operators, delimiters, and comments.
#
# canonical rules:
#   1. 4-space indentation (already enforced by lexer)
#   2. single space around binary operators
#   3. no space before colon, space after (in type annotations)
#   4. no trailing whitespace on lines
#   5. single blank line between top-level declarations (max)
#   6. single space after # in comments
#   7. trailing newline at end of file
#   8. no space inside parens/brackets
#   9. single space after commas

# format pith source code, returning a new string with canonical formatting.
pub fn fmt_source(source: String) -> String:
    lines := split_lines_preserve_empty(source)
    # each formatted line lands in its own slot and the file is joined
    # once at the end. appending to a growing string instead rebuilt the
    # whole file on every line, so formatting cost grew with the square
    # of the source size — on the 9600-line emitter that was most of the
    # run, and ci formats every self-hosted file on every push.
    mut formatted_lines: List[String] := []
    mut consecutive_blank := 0

    for raw_line in lines:
        # trim trailing whitespace
        line := trim_right(raw_line)

        # handle blank lines — allow at most one
        if line.len() == 0:
            consecutive_blank = consecutive_blank + 1
            if consecutive_blank <= 1:
                formatted_lines.push("")
            continue
        consecutive_blank = 0

        # detect if line is a comment (after indentation)
        trimmed := trim_left(line)
        if trimmed.len() > 0:
            if trimmed[0] == "#":
                # preserve indentation, normalize comment spacing
                indent_len := line.len() - trimmed.len()
                formatted_lines.push(line.substring(0, indent_len) + format_comment(trimmed))
                continue

        # for code lines, normalize spacing. the spacing pass appends a space
        # after an operator without knowing whether anything follows it on the
        # line, so a line that ends in one — a multi-line match arm's `=>`, a
        # trailing binary operator — comes back with a space hanging off the
        # end. trim again here so rule 4 holds for code lines too.
        formatted_lines.push(trim_right(format_code_line(line)))

    # every slot above stood for a line the old loop terminated with a
    # newline, so the joined file needs one more to match.
    mut output := formatted_lines.join(chr(10)) + chr(10)

    # ensure exactly one trailing newline
    while output.len() > 1:
        if output[output.len() - 1] == chr(10):
            if output[output.len() - 2] == chr(10):
                output = output.substring(0, output.len() - 1)
                continue
        break

    # ensure at least one trailing newline
    if output.len() > 0:
        if output[output.len() - 1] != chr(10):
            output = output + chr(10)

    return output

fn split_lines_preserve_empty(source: String) -> List[String]:
    mut lines: List[String] := []
    mut start := 0
    mut i := 0
    while i < source.len():
        if source[i] == chr(10):
            lines.push(source.substring(start, i))
            start = i + 1
        i = i + 1
    lines.push(source.substring(start, source.len()))
    return lines

# normalize a comment line: ensure single space after #
fn format_comment(comment: String) -> String:
    if comment.len() == 1:
        if comment[0] == "#":
            return "#"
    # doc comments open with two hashes; normalize after the pair so
    # "##text" becomes "## text" and "## text" stays put
    if comment.len() >= 2:
        if comment[1] == "#":
            if comment.len() == 2:
                return "##"
            if comment[2] != " ":
                return "## " + comment.substring(2, comment.len())
            return comment
    if comment.len() >= 2:
        if comment[1] != " ":
            return "# " + comment.substring(1, comment.len())
    return comment

# format a code line by normalizing operator spacing.
# preserves string contents exactly.
fn format_code_line(line: String) -> String:
    mut output := ""
    mut i := 0
    mut in_string := false
    mut brace_depth := 0

    # preserve leading whitespace (indentation)
    while i < line.len():
        if line[i] == " " or line[i] == chr(9):
            output = output + line[i]
            i = i + 1
        else:
            break

    while i < line.len():
        ch := line[i]
        quote := chr(34)

        # string handling — preserve contents exactly
        if ch == quote:
            if not in_string:
                in_string = true
                output = output + ch
                i = i + 1
                continue

        if in_string:
            if ch == chr(92):
                if i + 1 < line.len():
                    # escape sequence — copy both chars
                    output = output + ch + line[i + 1]
                    i = i + 2
                    continue
            LB := chr(123)
            RB := chr(125)
            if ch == LB:
                brace_depth = brace_depth + 1
                output = output + ch
                i = i + 1
                continue
            if ch == RB:
                if brace_depth > 0:
                    brace_depth = brace_depth - 1
                    output = output + ch
                    i = i + 1
                    continue
            if ch == quote:
                if brace_depth == 0:
                    in_string = false
                    output = output + ch
                    i = i + 1
                    continue
            output = output + ch
            i = i + 1
            continue

        # inline comment — normalize and copy rest
        if ch == "#":
            output = ensure_trimmed_trailing(output)
            output = output + " "
            output = output + format_comment(line.substring(i, line.len()))
            break

        # two-character operators
        if i + 1 < line.len():
            next := line[i + 1]

            # := — space around
            if ch == ":" and next == "=":
                output = ensure_trailing_space(output)
                output = output + ":= "
                i = i + 2
                i = skip_leading_spaces(line, i)
                continue

            # ==, !=, <=, >=, +=, -=, *=, /=, =>, ->
            if is_two_char_operator(ch, next):
                output = ensure_trailing_space(output)
                output = output + ch + next + " "
                i = i + 2
                i = skip_leading_spaces(line, i)
                continue

        # single-char binary operators: + * / %
        if ch == "+" or ch == "*" or ch == "/" or ch == "%":
            output = ensure_trailing_space(output)
            output = output + ch + " "
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # minus — could be binary or unary
        if ch == "-":
            if is_preceded_by_operand(output):
                output = ensure_trailing_space(output)
                output = output + "- "
                i = i + 1
                i = skip_leading_spaces(line, i)
                continue
            # unary — binds tight to its operand, so no space after. skipping
            # the spaces is what NORMALISES an already-damaged site: `- 1`
            # written by an older formatter comes back as `-1` rather than
            # being preserved. the binary arm above is unreachable from here,
            # so a real subtraction (`a - 1`, `x[i - 1]`) keeps its spacing.
            output = output + "-"
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # = (assignment, not ==)
        if ch == "=":
            output = ensure_trailing_space(output)
            output = output + "= "
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # < and > as comparison
        if ch == "<" or ch == ">":
            output = ensure_trailing_space(output)
            output = output + ch + " "
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # | (pipe operator)
        if ch == "|":
            output = ensure_trailing_space(output)
            output = output + "| "
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # colon — no space before, space after
        if ch == ":":
            output = trim_trailing_spaces(output)
            output = output + ":"
            i = i + 1
            if i < line.len():
                if line[i] != chr(10):
                    i = skip_leading_spaces(line, i)
                    if i < line.len():
                        output = output + " "
            continue

        # comma — no space before, space after
        if ch == ",":
            output = trim_trailing_spaces(output)
            output = output + ","
            i = i + 1
            i = skip_leading_spaces(line, i)
            if i < line.len():
                output = output + " "
            continue

        # dot — no spaces around
        if ch == ".":
            output = trim_trailing_spaces(output)
            output = output + "."
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # opening delimiters — no space after
        if ch == "(" or ch == "[":
            output = output + ch
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue
        LB := chr(123)
        if ch == LB:
            output = output + ch
            i = i + 1
            i = skip_leading_spaces(line, i)
            continue

        # closing delimiters — no space before
        if ch == ")" or ch == "]":
            output = trim_trailing_spaces(output)
            output = output + ch
            i = i + 1
            continue
        RB := chr(125)
        if ch == RB:
            output = trim_trailing_spaces(output)
            output = output + ch
            i = i + 1
            continue

        # regular character — just copy
        output = output + ch
        i = i + 1

    return output

# ---------------------------------------------------------------
# helpers
# ---------------------------------------------------------------

# check if two characters form a two-char operator
fn is_two_char_operator(ch: String, next: String) -> Bool:
    if ch == "=" and next == "=":
        return true
    if ch == "!" and next == "=":
        return true
    if ch == "<" and next == "=":
        return true
    if ch == ">" and next == "=":
        return true
    if ch == "+" and next == "=":
        return true
    if ch == "-" and next == "=":
        return true
    if ch == "*" and next == "=":
        return true
    if ch == "/" and next == "=":
        return true
    if ch == "=" and next == ">":
        return true
    if ch == "-" and next == ">":
        return true
    return false

# ensure output ends with a space (unless already has one or ends with open paren)
fn ensure_trailing_space(s: String) -> String:
    if s.len() > 0:
        last := s[s.len() - 1]
        if last != " " and last != "(" and last != "[":
            return s + " "
    return s

# trim trailing spaces from a string
fn trim_trailing_spaces(s: String) -> String:
    mut result := s
    while result.len() > 0:
        if result[result.len() - 1] == " ":
            result = result.substring(0, result.len() - 1)
        else:
            break
    return result

# trim trailing spaces and add space before (for inline comments)
fn ensure_trimmed_trailing(s: String) -> String:
    return trim_trailing_spaces(s)

# skip spaces in a line starting at position i
fn skip_leading_spaces(line: String, start: Int) -> Int:
    mut i := start
    while i < line.len():
        if line[i] == " ":
            i = i + 1
        else:
            break
    return i

# keywords that can be directly followed by an expression, and so leave a `-`
# after them unary. this is the whole keyword set except the four that are
# themselves values — `self.x - 1` and `true - 1` end with an operand, so a
# minus after those is binary like any other.
NON_OPERAND_KEYWORDS := ",fn,if,elif,else,for,in,while,match,select,default,timeout,return,fail,break,continue,spawn,await,struct,enum,interface,impl,type,pub,mut,ref,weak,import,from,as,and,or,not,catch,test,let,threadlocal,defer,errdefer,"

# check if the output so far ends with an operand (for binary vs unary minus)
fn is_preceded_by_operand(output: String) -> Bool:
    if output.len() == 0:
        return false
    # skip trailing spaces
    mut idx := output.len()
    while idx > 0:
        if output[idx - 1] == " ":
            idx = idx - 1
        else:
            break
    if idx == 0:
        return false
    last := output[idx - 1]
    if is_alphanumeric(last):
        # a trailing word may be a keyword rather than a value. `return -1` and
        # `and -1` read as alphanumeric here, but nothing has been produced for
        # the minus to bind to, so it is unary — without this, `return -1`
        # formats to `return - 1`.
        mut start := idx
        while start > 0:
            ch := output[start - 1]
            if is_alphanumeric(ch) or ch == "_":
                start = start - 1
            else:
                break
        word := output.substring(start, idx)
        if NON_OPERAND_KEYWORDS.contains("," + word + ","):
            return false
        return true
    if last == ")" or last == "]" or last == "_" or last == "?" or last == "!":
        return true
    return false

# check if a single character is alphanumeric
fn is_alphanumeric(ch: String) -> Bool:
    if ch.len() != 1:
        return false
    c := ord(ch)
    # 0-9: 48-57, A-Z: 65-90, a-z: 97-122
    if c >= 48 and c <= 57:
        return true
    if c >= 65 and c <= 90:
        return true
    if c >= 97 and c <= 122:
        return true
    return false

# trim trailing whitespace (spaces and tabs) from a string
fn trim_right(s: String) -> String:
    mut end := s.len()
    while end > 0:
        ch := s[end - 1]
        if ch == " " or ch == chr(9) or ch == chr(13):
            end = end - 1
        else:
            break
    return s.substring(0, end)

# trim leading whitespace from a string
fn trim_left(s: String) -> String:
    mut start := 0
    while start < s.len():
        if s[start] == " " or s[start] == chr(9):
            start = start + 1
        else:
            break
    return s.substring(start, s.len())

test "a unary minus after a keyword stays glued to its operand":
    # `return`, `and`, `if` and friends all end in a letter, so a naive
    # "is the last character alphanumeric" test reads them as operands and
    # spaces the minus as if it were binary. that rewrote `return -1` to
    # `return - 1` — valid, but not what anyone wrote, and 91 sites in the
    # tree had already been rewritten that way before this was caught. they
    # are normalised now; the test below covers the repair direction.
    assert(fmt_source("fn f() -> Int:" + chr(10) + "    return -1" + chr(10)).contains("return -1"))
    assert(fmt_source("fn g(a: Int) -> Int:" + chr(10) + "    return -a" + chr(10)).contains("return -a"))
    assert(fmt_source("fn h(a: Int) -> Bool:" + chr(10) + "    return a > 0 and -1 < a" + chr(10)).contains("and -1 < a"))
    assert(fmt_source("fn i(a: Int):" + chr(10) + "    if -1 < a:" + chr(10) + "        print(\"x\")" + chr(10)).contains("if -1 < a"))

test "a binary minus is still spaced, including after a value keyword":
    # the four keywords that ARE values must keep binary spacing — they end an
    # operand just like an identifier does.
    assert(fmt_source("fn f(a: Int) -> Int:" + chr(10) + "    return a - 1" + chr(10)).contains("a - 1"))
    assert(fmt_source("fn g(a: Int) -> Int:" + chr(10) + "    return f(a) - 1" + chr(10)).contains("f(a) - 1"))
    assert(fmt_source("fn h(xs: List[Int]) -> Int:" + chr(10) + "    return xs[0] - 1" + chr(10)).contains("xs[0] - 1"))

test "formatting is idempotent across the minus cases":
    src := "fn f(a: Int) -> Int:" + chr(10) + "    b := [-1, -2]" + chr(10) + "    return a - 1" + chr(10)
    once := fmt_source(src)
    assert(fmt_source(once) == once)

test "a unary minus already spaced apart is pulled back to its operand":
    # #784 stopped the formatter CREATING `return - 1`; it did not teach it to
    # repair the ~93 sites already written that way. both directions are here
    # because the discriminator has to get both right from one rule: skipping
    # the spaces after a unary minus normalises the damage, and the binary arm
    # is unreachable from that branch so a real subtraction is untouched.
    fix := "fn f(a: Int, xs: List[Int]) -> Int:" + chr(10) + "    b := - 1" + chr(10) + "    c := [-1, - 2]" + chr(10) + "    if a == - 1:" + chr(10) + "        return - 1" + chr(10) + "    return b + c[0]" + chr(10)
    out := fmt_source(fix)
    assert(out.contains("b := -1"))
    assert(out.contains("[-1, -2]"))
    assert(out.contains("if a == -1:"))
    assert(out.contains("return -1"))
    assert(not out.contains("- 1"))

    # the other direction: a binary minus must keep its spacing in every shape
    # where the left side is an operand — identifier, index, call, paren.
    keep := "fn g(a: Int, n: Int, xs: List[Int]) -> Int:" + chr(10) + "    return a - 1 + xs[n - 1] + g(n - 1, 0, xs) + (0 - 1)" + chr(10)
    kept := fmt_source(keep)
    assert(kept.contains("a - 1"))
    assert(kept.contains("xs[n - 1]"))
    assert(kept.contains("g(n - 1, 0, xs)"))
    assert(kept.contains("(0 - 1)"))

test "a line ending in an operator keeps no trailing space":
    # the spacing pass puts a space after an operator before it knows whether
    # anything follows on the line, so a multi-line match arm's `=>` came back
    # with a space hanging off the end. self-host has no multi-line arms, so
    # the fmt gate never exercised this until std came under it.
    arm := "fn f(k: Int) -> Int:" + chr(10) + "    match k:" + chr(10) + "        1 =>" + chr(10) + "            return 2" + chr(10)
    assert(fmt_source(arm).contains("1 =>" + chr(10)))
    assert(not fmt_source(arm).contains(" " + chr(10)))
