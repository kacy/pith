# `_` names a loop variable or index the body does not use.

fn main():
    mut n := 0
    for _ in [1, 2, 3]:
        n += 1
    for _ in 0..4:
        n += 1
    for _ in 1..=2:
        n += 1
    words := ["a", "b", "c"]
    mut indexes := 0
    for _, i in words:
        indexes += i
    for w, _ in words:
        print(w)
    for _ in ["x", "y"]:
        for _ in ["p", "q"]:
            n += 1
    print("{n} {indexes}")
