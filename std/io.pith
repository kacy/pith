impl Closer for ProcessStdin:
    # close the write end of the child's stdin, so a child that reads to the
    # end of its input (sort, wc) sees end of file. flush a buffered writer
    # over it first. a later write fails, and a second close is a no-op.
    fn close():
        process_close_stdin(self.handle.id)

impl BytesWriter for ProcessStdin:
    fn write_bytes(data: Bytes) -> Int!:
        return process_stdin_write_bytes(self, data)

