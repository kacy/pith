# the fused update of a key the map does not hold aborts with the same
# diagnostic `m[k]` gives on its own: the strict read is still what runs,
# it just runs inside the call that writes.
fn main():
    mut m: Map[String, Int] := {}
    m.insert("a", 1)
    print("len:{m.len()}")
    m["b"] = m["b"] + 1
    print("after:{m["b"]}")
