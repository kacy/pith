# std/compress/zstd — zstd (rfc 8878) compression and decompression.
#
# the surface mirrors gzip's: compress/decompress plus the bounded variant
# for untrusted input. unlike the deflate family, the codec itself is the
# reference implementation linked into the runtime — compression is the one
# place the repo links a kernel it could in principle write, because the
# reference encoder is the interop target and matching its ratios and edge
# cases by hand buys nothing a protocol needs. the safety property lives
# here all the same: decompression is capped during streaming decode, so a
# bomb fails at the limit instead of allocating its way to it.

import std.bytes as bytes

## the default ceiling on decompressed output: 256 MiB, matching inflate's.
pub DEFAULT_MAX_OUTPUT := 268435456

## the default compression level. zstd levels run 1 (fastest) to 22
## (smallest); 3 is the reference implementation's own default, a good
## trade for request/export bodies.
pub DEFAULT_LEVEL := 3

# compress bytes into a zstd frame at the default level.
pub fn compress(data: Bytes) -> Bytes:
    return zstd_compress(data, DEFAULT_LEVEL) catch bytes.empty()

# compress at an explicit level, 1 (fastest) to 22 (smallest). a level
# outside that range falls back to the default.
pub fn compress_level(data: Bytes, level: Int) -> Bytes!:
    return zstd_compress(data, level)!

## decompress a zstd frame, holding the output to `DEFAULT_MAX_OUTPUT` —
## use decompress_bounded for a different limit.
pub fn decompress(data: Bytes) -> Bytes!:
    return decompress_bounded(data, DEFAULT_MAX_OUTPUT)!

## decompress with an explicit ceiling on the decoded size; fails once the
## output would exceed `max_output`. use this on untrusted input (an upload,
## a `Content-Encoding: zstd` body) to bound the damage a decompression
## bomb can do — the cap is enforced while decoding, not checked after.
pub fn decompress_bounded(data: Bytes, max_output: Int) -> Bytes!:
    if max_output <= 0:
        fail "zstd: max_output must be positive"
    result := zstd_decompress(data, max_output)
    if result.is_err:
        fail "zstd: invalid frame or output over " + max_output.to_string() + " bytes"
    return result.ok

## true when the data starts with the zstd frame magic. a cheap routing
## check, not a validation — decompress is what decides malformed.
pub fn is_valid(data: Bytes) -> Bool:
    if data.len() < 4:
        return false
    return data[0] == 0x28 and data[1] == 0xB5 and data[2] == 0x2F and data[3] == 0xFD

# compress a utf-8 string into a zstd frame.
pub fn compress_string(text: String) -> Bytes:
    return compress(bytes.from_string_utf8(text))

# decompress a zstd frame and decode the result as utf-8.
pub fn decompress_string(data: Bytes) -> String!:
    return decompress(data)!.to_string_utf8()!

test "zstd round trips text and binary":
    text := "the same phrase repeats, the same phrase repeats, the same phrase repeats"
    packed := compress_string(text)
    assert(packed.len() > 0)
    assert(packed.len() < text.len())
    assert(is_valid(packed))
    assert_eq(decompress_string(packed)!, text)

    mut blob := bytes.buffer()
    mut i := 0
    while i < 4096:
        blob.write_byte(i % 251)
        i = i + 1
    raw := blob.take_bytes()
    assert_eq(decompress(compress(raw))!.len(), 4096)

test "zstd round trips empty input":
    packed := compress(bytes.empty())
    assert(is_valid(packed))
    assert_eq(decompress(packed)!.len(), 0)

test "levels trade size for effort":
    mut blob := bytes.buffer()
    mut i := 0
    while i < 2000:
        blob.write_byte((i * 7) % 13 + 97)
        i = i + 1
    raw := blob.take_bytes()
    fast := compress_level(raw, 1)!
    small := compress_level(raw, 19)!
    assert_eq(decompress(fast)!.len(), 2000)
    assert_eq(decompress(small)!.len(), 2000)
    assert(small.len() <= fast.len())

test "the bound holds during decode":
    text := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    packed := compress_string(text)
    assert(decompress_bounded(packed, 64).is_ok)
    assert(decompress_bounded(packed, 63).is_err)
    assert(decompress_bounded(packed, 0).is_err)

test "garbage is refused, not decoded":
    assert(decompress(bytes.from_string_utf8("not a zstd frame")).is_err)
    assert(not is_valid(bytes.from_string_utf8("hi")))
    # the magic alone, with the frame body torn off
    mut torn := bytes.buffer()
    torn.write_byte(0x28)
    torn.write_byte(0xB5)
    torn.write_byte(0x2F)
    torn.write_byte(0xFD)
    assert(decompress(torn.take_bytes()).is_err)
