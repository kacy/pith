# std.net.tcp — TCP networking
#
# TCP client and server functionality. All I/O is blocking — use spawn for concurrency.
# Connections are represented as plain Int file descriptors.
#
#   from std.net.tcp import connect, read, write_all, close
#
#   fd := connect("127.0.0.1", 8080)!
#   write_all(fd, "hello")!
#   data := read(fd, 1024)!
#   close(fd)

import std.bytes as bytes
import std.resilience as resilience

# ===============================================================
# Client Operations
# ===============================================================

fn tcp_connect_checked(host: String, port: Int) -> Int!:
    return tcp_connect(host, port)

# Connects to a TCP server at the specified host and port.
# Returns a file descriptor or fails if connection fails.
pub fn connect(host: String, port: Int) -> Int!:
    return tcp_connect_checked(host, port)

# ===============================================================
# Server Operations
# ===============================================================

# Starts a TCP server listening on the specified host and port.
# Returns a server file descriptor or fails if bind fails.
pub fn listen(host: String, port: Int) -> Int!:
    return tcp_listen(host, port)

# Accepts an incoming connection on a server file descriptor.
# Blocks until a client connects. Returns a client file descriptor.
pub fn accept(server_fd: Int) -> Int!:
    return tcp_accept(server_fd)

# ===============================================================
# Accept loops
# ===============================================================

# an accept loop must not die on one failed accept, and must not spin on a
# listener that will fail forever. it cannot simply pick the right response,
# because accept reports a message rather than an errno: "too many open files"
# clears on its own as soon as a connection closes, "bad file descriptor" never
# will, and both arrive as text. so a loop covers both cases at once. it backs
# off after a failure, which costs a transient failure a few milliseconds and
# keeps a permanent one from burning a core, and it gives up after a bounded run
# of consecutive failures, which is the only honest reading of a listener that
# has not produced a single connection in that many tries. one successful accept
# resets the run.
#
# the shape a caller writes:
#
#     mut failures := 0
#     while true:
#         accepted := tcp.accept(listener_fd)
#         if accepted.is_err:
#             failures = failures + 1
#             tcp.back_off_after_accept_failure(failures, accepted.err)!
#             continue
#         failures = 0
#         spawn serve(accepted.ok)
MAX_CONSECUTIVE_ACCEPT_FAILURES := 32
# the delay curve after consecutive accept failures: 5 ms doubling to a
# 500 ms ceiling, on std.resilience's shared curve.
ACCEPT_RETRY := resilience.retries(MAX_CONSECUTIVE_ACCEPT_FAILURES).base(5).cap(500)

# wait out the backoff owed after `consecutive` failed accepts in a row. it fails
# once the run reaches MAX_CONSECUTIVE_ACCEPT_FAILURES, which ends the loop; the
# error carries `last_error`, so whatever accept last complained about is what
# the caller sees.
pub fn back_off_after_accept_failure(consecutive: Int, last_error: String) -> Bool!:
    if consecutive >= MAX_CONSECUTIVE_ACCEPT_FAILURES:
        fail "accept failed " + consecutive.to_string() + " times in a row, giving up: " + last_error
    sleep(ACCEPT_RETRY.delay_ms(consecutive))
    return true

test "accept backoff grows and then flattens":
    assert_eq(ACCEPT_RETRY.delay_ms(1), 5)
    assert_eq(ACCEPT_RETRY.delay_ms(2), 10)
    assert_eq(ACCEPT_RETRY.delay_ms(3), 20)
    assert_eq(ACCEPT_RETRY.delay_ms(100), 500)

test "an accept loop gives up after a bounded run of failures":
    gave_up := back_off_after_accept_failure(MAX_CONSECUTIVE_ACCEPT_FAILURES, "bad file descriptor")
    assert(gave_up.is_err)
    assert(gave_up.err.contains("bad file descriptor"))

test "an accept loop keeps going while the run is short":
    assert(back_off_after_accept_failure(1, "too many open files") catch false)

# ===============================================================
# Connection I/O
# ===============================================================

# Reads up to max_bytes from a connection.
# Returns the data read or fails on error (e.g., connection closed).
#
# fd must be a socket. reading a descriptor that is not one stops the process
# with a diagnostic rather than returning an error, because the usual cause is a
# connection closed while something still held its number — see close().
pub fn read(fd: Int, max_bytes: Int) -> String!:
    return tcp_read(fd, max_bytes)

# Writes data to a connection.
#
# this is one write syscall, and it returns the number of bytes the kernel
# accepted — which may be fewer than were offered. a socket has a bounded send
# buffer, so a buffer larger than the space left in it is written in part and
# the rest is not written at all. the count is the whole result: ignoring it
# drops the tail silently, and the peer waits for bytes that will never come.
# reach for write_all() unless you have a reason to handle the count yourself.
#
# as with read(), fd must be a socket: a write to a descriptor that is not one
# would overwrite whatever file inherited the number, so it stops the process.
pub fn write(fd: Int, data: String) -> Int!:
    return tcp_write(fd, data)

# Writes every byte of data to a connection, and returns how many that was.
#
# a short write is normal rather than an error — the send buffer filled — so
# this resumes from where the last one stopped and keeps going until the buffer
# is out. only a write that accepts nothing at all ends it, and that means the
# reader is gone.
#
# the loop runs on bytes, not on characters: a send buffer fills at whatever
# byte offset it fills at, which may be in the middle of a multi-byte character,
# and a String cannot be cut there.
pub fn write_all(fd: Int, data: String) -> Int!:
    return write_all_bytes(fd, bytes.from_string_utf8(data))

# Writes every byte of data to a connection, and returns how many that was.
# The Bytes form of write_all(); see it for the contract.
pub fn write_all_bytes(fd: Int, data: Bytes) -> Int!:
    total := data.len()
    mut sent := 0
    mut remaining := data
    while sent < total:
        wrote := tcp_write_bytes(fd, remaining)!
        if wrote <= 0:
            fail "tcp: connection closed after writing {sent} of {total} bytes"
        sent = sent + wrote
        if sent < total:
            remaining = remaining.slice(wrote, remaining.len())
    return sent

# Set read timeout in milliseconds (0 = no timeout).
# Connections default to 5 second timeout.
pub fn set_timeout(fd: Int, ms: Int):
    tcp_set_timeout(fd, ms)

# Closes a TCP connection.
#
# close only after every task that reads or writes fd has finished. the kernel
# gives the freed number to the next file the process opens, so a read arriving
# late lands on that file instead; read() and write() stop the process when they
# can see that happen.
pub fn close(fd: Int):
    tcp_close(fd)

test "tcp wrappers report invalid descriptor errors":
    assert(read(-1, 8).is_err)
    assert(write(-1, "hello").is_err)
    assert(write_all(-1, "hello").is_err)
    assert(write_all_bytes(-1, bytes.from_string_utf8("hello")).is_err)
    set_timeout(-1, 1)
    close(-1)

test "write_all on an empty buffer writes nothing and does not fail":
    assert_eq(write_all(-1, "") catch -1, 0)
    assert_eq(write_all_bytes(-1, bytes.empty()) catch -1, 0)
