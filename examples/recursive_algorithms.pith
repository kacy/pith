# recursion: functions that call themselves on a smaller piece of the input.
#
# three classics and a tree walk. gcd and fast power shrink a number each
# call, quicksort splits a list around a pivot and sorts the halves, and a
# directory walk adds up file sizes through any depth of folders. each has a
# base case that stops the recursion; without one it would run until the
# stack ran out.

import std.fmt as fmt

fn gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a
    return gcd(b, a % b)

# squaring halves the exponent, so 2^62 takes about 6 multiplications
fn power(base: Int, exponent: Int) -> Int:
    if exponent == 0:
        return 1
    half := power(base, exponent / 2)
    if exponent % 2 == 0:
        return half * half
    return half * half * base

fn quicksort(items: List[Int]) -> List[Int]:
    if items.len() <= 1:
        return items
    pivot := items[0]
    mut sorted := quicksort(items.filter(fn(item: Int) => item < pivot))
    for item in items.filter(fn(item: Int) => item == pivot):
        sorted.push(item)
    for item in quicksort(items.filter(fn(item: Int) => item > pivot)):
        sorted.push(item)
    return sorted

# the tree is a map from each folder to the names inside it; a name with no
# entry in the map is a file. a file's size is its own, and a folder's is the
# sum of everything below it, however deep.
fn total_bytes(name: String, children: Map[String, List[String]], sizes: Map[String, Int]) -> Int:
    if let inside = children.get(name):
        mut total := 0
        for child in inside:
            total += total_bytes(child, children, sizes)
        return total
    return sizes[name]

fn print_tree(name: String, depth: Int, children: Map[String, List[String]], sizes: Map[String, Int]):
    print("{"  ".repeat(depth)}{name} ({total_bytes(name, children, sizes)} bytes)")
    for child in children.get(name).unwrap_or([]):
        print_tree(child, depth + 1, children, sizes)

fn main():
    print("gcd(1071, 462) = {gcd(1071, 462)}")
    print("3^13 = {power(3, 13)}, 2^62 = {power(2, 62)}")
    print("sorted: {fmt.ints(quicksort([38, 27, 43, 3, 9, 82, 10, 27]))}")

    children := {
        "project/": ["README.md", "src/", "tests/"],
        "src/": ["main.pith", "parser.pith", "std/"],
        "std/": ["io.pith"],
        "tests/": ["parser_test.pith"],
    }
    sizes := {"README.md": 2400, "main.pith": 5100, "parser.pith": 12800, "io.pith": 3300, "parser_test.pith": 4100}
    print_tree("project/", 0, children, sizes)
