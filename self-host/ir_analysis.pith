from ir_symbols import ir_capture_blocked_names, ir_has_generic_params, ir_ident_callee, ir_is_fn_decl_kind, ir_is_generic_method_name, ir_plain_method_name, ir_resolve_module_alias_method_call_name, ir_resolve_static_callee, ir_resolve_type_node
