# importing from a module in your own project.
#
# `from math import ...` finds math.pith next to this file and brings in the
# public functions it names. run it with `pith run examples/imports/main.pith`.

from math import add, multiply, percent_of

fn main():
    print("3 + 4 = {add(3, 4)}")
    print("5 * 6 = {multiply(5, 6)}")
    print("3 of 8 is {percent_of(3, 8)}%")
