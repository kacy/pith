# ir_optionals.pith - low-level optional IR helpers

from ir_builder import ir_emit, ir_reg
from ir_call_emit import ir_emit_call2
from ir_metadata import ir_runtime_call_name
from ir_result_abi import ir_zero_reg
from ir_struct_registry import ir_boxed_enums
from ir_type_helpers import ir_type_from_tid
from types import get_type_info, get_type_name

# load the is_some flag out of an optional's two-slot shell (offset 0):
# 0 for none, 1 for Some. reading it is a pure probe — it never touches
# the payload and takes no count — which is why `== none` counts as a
# non-owning use of an optional local.
pub fn ir_optional_flag_field(obj_r: Int) -> Int:
    r := ir_reg()
    ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 0 bool is_some")
    return r

# load the payload out of an optional's shell (offset 8), typed from
# `opt_tid`'s inner type so the ir slot gets the right kind. the read
# borrows: the optional still holds whatever count it had, so anything
# keeping the payload past the optional's life must retain it. check
# the flag first — the slot of a none holds 0 and this reads it anyway.
# when `opt_tid` is not an optional type, or its inner type is unknown,
# it emits no field load and hands back a register holding 0 rather
# than reporting anything.
pub fn ir_optional_value_field(obj_r: Int, opt_tid: Int) -> Int:
    info := get_type_info(opt_tid)
    if info.kind != "optional" or info.inner < 0:
        return ir_zero_reg()
    r := ir_reg()
    ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 8 " + ir_type_from_tid(info.inner) + " value")
    return r

# emit `optional == none` (op "eq") or `!= none` (anything else) into
# `result_reg`. it compares the flag alone and never reads the payload,
# so it is safe on an optional of any inner type and needs no type id.
# call sites pass whichever side of the comparison is not the `none`
# literal.
pub fn ir_emit_optional_none_compare(result_reg: Int, op: String, optional_r: Int):
    flag_r := ir_optional_flag_field(optional_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    if op == "eq":
        ir_emit("eq " + result_reg.to_string() + " " + flag_r.to_string() + " " + zero_r.to_string())
    else:
        ir_emit("neq " + result_reg.to_string() + " " + flag_r.to_string() + " " + zero_r.to_string())

# Structural equality between two Optionals of the same type. `opt_tid` is
# the shared optional type id; the payload comparison dispatches on its
# inner type in ir_emit_inner_value_eq below, matching the bare type's `==`.
#
# Result semantics (for eq; neq negates):
#   None == None       -> true
#   Some(x) == Some(y) -> x == y
#   Some/None mismatch -> false
pub fn ir_emit_optional_optional_compare(result_reg: Int, op: String, left_r: Int, right_r: Int, opt_tid: Int):
    info := get_type_info(opt_tid)
    lf := ir_optional_flag_field(left_r)
    rf := ir_optional_flag_field(right_r)
    lv := ir_optional_value_field(left_r, opt_tid)
    rv := ir_optional_value_field(right_r, opt_tid)

    flag_eq := ir_reg()
    ir_emit("eq " + flag_eq.to_string() + " " + lf.to_string() + " " + rf.to_string())

    val_eq := ir_emit_inner_value_eq(info.inner, lv, rv)

    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    both_none := ir_reg()
    ir_emit("eq " + both_none.to_string() + " " + lf.to_string() + " " + zero_r.to_string())

    tail := ir_reg()
    ir_emit("or " + tail.to_string() + " " + both_none.to_string() + " " + val_eq.to_string())

    ir_emit_guarded_eq(result_reg, op, flag_eq, tail)

# `x == 5` where x is an Optional and 5 is a plain value of its inner type.
# none never equals a plain value, so eq is `is_some and value == v` and neq
# is its negation. the payload comparison dispatches on the inner type in
# ir_emit_inner_value_eq, the same as the optional-optional compare above.
# reads only — the payload read borrows, so neither operand's count moves.
pub fn ir_emit_optional_plain_compare(result_reg: Int, op: String, opt_r: Int, plain_r: Int, opt_tid: Int):
    info := get_type_info(opt_tid)
    flag := ir_optional_flag_field(opt_r)
    value := ir_optional_value_field(opt_r, opt_tid)
    val_eq := ir_emit_inner_value_eq(info.inner, value, plain_r)
    ir_emit_guarded_eq(result_reg, op, flag, val_eq)

## the equality register for two values of type `tid`, decided the way `==`
## decides it for that type: an optional structurally through the compare
## above, a string or a Bytes by content, a boxed enum through its per-enum
## helper, and everything else — ints, floats, bools, and a struct, which
## `==` gives pointer identity — as i64 equality. this is what a container
## searching for an element asks, so that `xs.contains(v)` and `xs[i] == v`
## cannot disagree. `tid` must name a type; callers with none of their own
## keep whatever fallback they had.
pub fn ir_emit_value_eq_for_tid(tid: Int, a_r: Int, b_r: Int) -> Int:
    info := get_type_info(tid)
    if info.kind == "optional":
        out_r := ir_reg()
        ir_emit_optional_optional_compare(out_r, "eq", a_r, b_r, tid)
        return out_r
    return ir_emit_inner_value_eq(tid, a_r, b_r)

# the payload-equality register for one inner type, shared by both optional
# compares above. the dispatch mirrors ir_emit_value_binary's for the bare
# type's `==`: strings compare by content through __str_eq, bytes through
# bytes_eq, and a boxed enum through its per-enum structural helper — a
# boxed enum value is a pointer, so a raw eq would be identity, not
# equality. everything else (ints, floats, bools) is i64 equality.
fn ir_emit_inner_value_eq(inner_tid: Int, a_r: Int, b_r: Int) -> Int:
    inner_kind := ir_type_from_tid(inner_tid)
    inner_name := get_type_name(inner_tid)
    val_eq := ir_reg()
    if inner_kind == "string":
        str_eq_name := ir_runtime_call_name("__str_eq")
        ir_emit("call " + val_eq.to_string() + " " + str_eq_name + " bool 2 " + a_r.to_string() + " " + b_r.to_string())
    elif inner_kind == "bytes":
        ir_emit_call2(val_eq, "bytes_eq", "bool", a_r, b_r)
    elif ir_boxed_enums.contains_key(inner_name):
        ir_emit_call2(val_eq, "__enum_eq_" + inner_name, "bool", a_r, b_r)
    else:
        ir_emit("eq " + val_eq.to_string() + " " + a_r.to_string() + " " + b_r.to_string())
    return val_eq

# combine `guard_r and val_eq_r` into result_reg for op "eq", or the
# negation of that conjunction for neq (compared against 1, the emitter's
# bool encoding).
fn ir_emit_guarded_eq(result_reg: Int, op: String, guard_r: Int, val_eq_r: Int):
    if op == "eq":
        ir_emit("and " + result_reg.to_string() + " " + guard_r.to_string() + " " + val_eq_r.to_string())
    else:
        eq_result := ir_reg()
        ir_emit("and " + eq_result.to_string() + " " + guard_r.to_string() + " " + val_eq_r.to_string())
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        ir_emit("neq " + result_reg.to_string() + " " + eq_result.to_string() + " " + one_r.to_string())

fn ir_emit_call1_raw(result_reg: Int, fname: String, ret_kind: String, arg0: Int):
    ir_emit("call " + result_reg.to_string() + " " + ir_runtime_call_name(fname) + " " + ret_kind + " 1 " + arg0.to_string())

fn ir_emit_optional_tuple(flag_r: Int, value_r: Int) -> Int:
    tuple_r := ir_reg()
    field_count_r := ir_reg()
    ir_emit("iconst " + field_count_r.to_string() + " 2")
    ir_emit_call1_raw(tuple_r, "__struct_alloc", "tuple", field_count_r)
    ir_emit("sstore " + tuple_r.to_string() + " 0 " + flag_r.to_string())
    ir_emit("sstore " + tuple_r.to_string() + " 1 " + value_r.to_string())
    return tuple_r

# build a fresh `none`: a two-slot shell with the flag and the value
# slot both zero. this is what a `none` literal lowers to wherever an
# optional is expected. the shell is a struct-header allocation the
# caller owns outright, and it carries no destructor, since there is no
# payload for one to release.
pub fn ir_emit_optional_none_value() -> Int:
    flag_r := ir_reg()
    value_r := ir_reg()
    ir_emit("iconst " + flag_r.to_string() + " 0")
    ir_emit("iconst " + value_r.to_string() + " 0")
    return ir_emit_optional_tuple(flag_r, value_r)

# wrap `value_r` in a `Some` shell. the shell BORROWS its payload: no
# destructor is attached, so releasing the optional frees the two slots
# and drops nothing else. that is right for a primitive, and for a
# payload whose count is transferred into the slot and released by
# whoever unwraps it (the return path, an index read). it is wrong for a
# payload the shell is meant to own — use ir_emit_optional_owned_some for
# a struct, list, map, set, bytes, closure or string payload, or the
# target dies while the optional still points at it, or nothing ever
# releases it. the shell itself is owned by the caller.
pub fn ir_emit_optional_some_value(value_r: Int) -> Int:
    flag_r := ir_reg()
    ir_emit("iconst " + flag_r.to_string() + " 1")
    return ir_emit_optional_tuple(flag_r, value_r)

# read a weak optional field. the slot holds the target pointer directly
# (0 = none) rather than an owning tuple, so liveness is resolved through
# pith_struct_weak_load: it returns the pointer while the target is still
# alive and 0 once the target has been reclaimed. that lets a dropped target
# read back as none instead of dangling. the caller gets a fresh, borrowing
# optional tuple (Some(ptr) when alive, none otherwise) that behaves like any
# other `T?` for `.value()` and `!= none`.
pub fn ir_emit_weak_read(raw_r: Int) -> Int:
    alive_r := ir_reg()
    ir_emit("call " + alive_r.to_string() + " pith_struct_weak_load int 1 " + raw_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    flag_r := ir_reg()
    ir_emit("neq " + flag_r.to_string() + " " + alive_r.to_string() + " " + zero_r.to_string())
    return ir_emit_optional_tuple(flag_r, alive_r)

# like ir_emit_optional_some_value, but the optional OWNS its rc payload: it
# carries a destructor that releases the payload when the optional dies, so a
# `Node?` field keeps its target alive instead of borrowing a pointer that
# dangles once the target's other owner goes out of scope. the caller is
# responsible for the balancing retain when the payload arrives borrowed.
# `payload_kind` is an rc kind (struct/list/map/set/bytes/closure/string); the
# matching __opt_dtor_<kind> is emitted once per module by
# ir_emit_optional_dtors.
pub fn ir_emit_optional_owned_some(value_r: Int, payload_kind: String) -> Int:
    flag_r := ir_reg()
    ir_emit("iconst " + flag_r.to_string() + " 1")
    tuple_r := ir_emit_optional_tuple(flag_r, value_r)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __opt_dtor_" + payload_kind)
    dr := ir_reg()
    ir_emit("call " + dr.to_string() + " pith_struct_set_dtor void 2 " + tuple_r.to_string() + " " + fr.to_string())
    return tuple_r
