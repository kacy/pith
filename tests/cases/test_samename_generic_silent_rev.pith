# test_samename_generic_silent with the imports reversed. the import order
# used to decide which module's mark() body both calls ran, so this file
# printed the other module's pair of answers; both orders now agree.
import clash_gbox_b as b
import clash_gbox_a as a

fn main():
    ca := a.Cell(1, 0)
    cb := b.Cell(1, 0)
    print(ca.mark().to_string())
    print(cb.mark().to_string())
    ha := a.Holder(0)
    hb := b.Holder(0)
    print(ha.name())
    print(hb.name())
