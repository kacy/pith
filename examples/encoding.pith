# encoding: base64, base32, hex and PEM with std.encoding.
#
# the text encodings an auth service uses every day: base64 for a Basic
# authorization header, unpadded url-safe base64 for a token in a link,
# base32 for an authenticator app's secret, hex for a fingerprint, and PEM
# to wrap a key for a config file. each one turns bytes into text and back.

import std.bytes as bytes
import std.encoding as encoding

fn basic_auth_header(user: String, password: String) -> String:
    return "Basic " + encoding.b64_encode(bytes.from_string_utf8("{user}:{password}"))

fn parse_basic_auth(header: String) -> String!:
    if not header.starts_with("Basic "):
        fail "not a Basic header"
    raw := encoding.b64_decode(header.substring(6, header.len()))!
    return raw.to_string_utf8()!

fn main() -> Int!:
    header := basic_auth_header("ada", "correct horse")
    print("authorization: {header}")
    print("decoded back:  {parse_basic_auth(header)!}")
    bad := parse_basic_auth("Basic not*base64")
    print("garbage rejected: {bad.is_err}")

    # bytes that are not text, such as a random token, still need a text
    # form; the url-safe alphabet avoids + and /, which links would mangle
    token := bytes.buffer()
    for value in [251, 255, 191, 0, 62, 63]:
        token.write_byte(value)!
    token_bytes := token.take_bytes()
    print("")
    print("token, standard base64: {encoding.b64_encode(token_bytes)}")
    print("token, url-safe raw:    {encoding.b64_url_raw_encode(token_bytes)}")
    print("token, hex:             {encoding.to_hex(token_bytes)}")

    # base32 uses only capitals and digits 2-7, so a person can type it
    secret := encoding.base32_encode(bytes.from_string_utf8("12345678901234567890"))
    print("")
    print("authenticator secret: {secret}")
    print("round trip: {encoding.base32_decode(secret)!.to_string_utf8()! == "12345678901234567890"}")
    print("fingerprint: {encoding.to_hex_upper(encoding.from_hex("a1b2c3d4")!)}")

    pem := encoding.pem_encode("PITH TEST KEY", bytes.from_string_utf8("not a real key"))
    print("")
    print(pem.trim())
    block := encoding.pem_decode(pem)!
    print("label {block.kind}, {block.body.len()} bytes")
    return 0
