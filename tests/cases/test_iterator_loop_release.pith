# a for-loop over an iterator: a fresh one belongs to the loop and is released
# when the loop ends, by break or by a return from the body. a borrowed one
# stays with its owner, which can keep driving it after the loop.
import std.iter as iter

fn first_over(limit: Int) -> Int:
    for x in iter.Range(0, 100):
        if x > limit:
            return x
    return 0 - 1

fn main():
    mut total := 0
    for x in iter.Range(1, 4):
        total = total + x
    for x in iter.Range(0, 50):
        if x == 3:
            break
        total = total + x
    held := iter.Range(10, 14)
    for x in held:
        total = total + x
        if x == 11:
            break
    print(total.to_string())
    print(first_over(7).to_string())
    mut i := 0
    mut runs := 0
    while i < 1000:
        for x in iter.Range(0, 2):
            runs = runs + x
        runs = runs + first_over(1)
        i = i + 1
    print(runs.to_string())
