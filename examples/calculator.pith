# a small left-to-right calculator over space-separated expressions

fn calc(input: String) -> Int!:
    parts := input.split(" ")
    mut acc := parse_int(parts[0])!
    mut i := 1
    while i + 1 < parts.len():
        op := parts[i]
        n := parse_int(parts[i + 1])!
        if op == "+":
            acc = acc + n
        elif op == "-":
            acc = acc - n
        else:
            fail "unknown operator: {op}"
        i = i + 2
    return acc

fn main() -> Int!:
    for expr in ["3 + 4", "10 - 3", "100 + 200 + 300", "50 - 20 + 5", "0 + 0"]:
        result := calc(expr)!
        print("{expr} = {result}")
    return 0
