# a json decode target may hold a List of Int, String, Bool, Float or of
# a decode-target struct; a List whose element is a Map is refused at the
# checker, the same E219 a Map field gets (#1110). the List[String] field
# beside it, once refused the same way, is accepted.
import std.json as json

struct Order:
    pub id: Int
    pub tags: List[String]
    pub attrs: List[Map[String, Int]]

fn main():
    r := json.decode_text[Order]("x")
    if r.is_err:
        print("err")
