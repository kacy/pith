# expose pith metrics for prometheus.
#
# in a real app you spawn the endpoint and let prometheus scrape it:
#     import std.prometheus as prometheus
#     spawn prometheus.serve("0.0.0.0", 9464)
# prometheus then GETs http://host:9464/metrics on its scrape interval. here we
# just register a few labeled metrics and print exactly what a scrape returns.
import std.metrics as metrics

fn main() -> Int!:
    reqs := metrics.counter("http_requests_total")
    reqs.labels(["route", "/api", "status", "200"]).add(3.0)
    reqs.labels(["route", "/health", "status", "200"]).inc()

    metrics.gauge("inflight_requests").set(2.0)

    lat := metrics.histogram("request_latency_ms")
    lat.labels(["route", "/api"]).observe(12.0)
    lat.labels(["route", "/api"]).observe(85.0)

    # the text prometheus would receive from GET /metrics
    print(metrics.snapshot_text())
    return 0
