# optional types

# an optional return signals "maybe no answer" without a sentinel value
fn find_positive(n: Int) -> Int?:
    if n > 0:
        return n
    return none

# look up a value that might not be there
fn lookup(scores: Map[String, Int], name: String) -> Int?:
    return scores.get(name)

# an optional parameter takes a bare none at the call site
fn describe(label: String, score: Int?) -> String:
    return "{label}: {score.unwrap_or(0)}"

# an optional field can be left empty, and can default to empty
struct Entry:
    name: String
    rank: Int?
    note: String? = none

fn main():
    # if let runs the branch only when the optional has a value
    if let n = find_positive(42):
        print("found {n}")
    if let n = find_positive(0 - 5):
        print("found {n}")
    else:
        print("nothing positive")

    scores := {"ada": 95, "grace": 88}
    # unwrap_or supplies a fallback when the key is missing
    print("ada: {lookup(scores, "ada").unwrap_or(0)}")
    print("carol: {lookup(scores, "carol").unwrap_or(0)}")

    # match handles both cases explicitly
    match lookup(scores, "grace"):
        none => print("grace: unranked")
        score => print("grace: {score}")

    # none is a value you can write wherever an optional is expected: an
    # argument, a struct field, a list element. it is only accepted there —
    # `describe("x", none)` is fine, but a plain `Int` parameter rejects it.
    print(describe("unranked", none))
    print(describe("ada", lookup(scores, "ada")))

    entry := Entry("carol", none)
    print("carol rank set: {entry.rank == none}, note set: {entry.note == none}")

    # a list literal mixing none with values is a list of optionals
    ranks: List[Int?] := [1, none, 3]
    print("ranks: {ranks.len()}, second empty: {ranks[1] == none}")
