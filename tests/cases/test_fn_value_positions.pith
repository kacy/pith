# calling a function value that comes from an expression rather than a
# plain name, across every position a value can take: list and map
# elements, tuple fields, returned values, nested indexing, a bound
# struct field, an immediately-invoked lambda, and a higher-order
# parameter. each must dispatch through the value.
fn double(x: Int) -> Int:
    return x * 2

fn tag(x: Int) -> String:
    return "n=" + x.to_string()

fn pick() -> fn(Int) -> Int:
    return double

fn apply_it(f: fn(Int) -> Int, v: Int) -> Int:
    return f(v)

struct Holder:
    pub op: fn(Int) -> Int

fn main():
    ops := [double, double]
    print(ops[0](7).to_string())

    strs := [tag, tag]
    print(strs[1](42))

    print(pick()(9).to_string())

    mut m: Map[String, fn(Int) -> Int] := {}
    m.insert("d", double)
    print(m.get_default("d", double)(3).to_string())

    t := (double, 3)
    g := t.0
    print(g(6).to_string())

    print(apply_it(double, 5).to_string())

    h := Holder(double)
    hf := h.op
    print(hf(8).to_string())

    print((fn(x: Int) => x + 1)(41).to_string())

    grid := [[double]]
    print(grid[0][0](11).to_string())
