# ir_state.pith: centralized IR emitter state & atomic frame lifecycle
#
# all mutable state shared across the IR lowering layers lives here,
# grouped into three explicit lifetime tiers:
#   1. Build config & cross-module registries (persist across emit_ir calls)
#   2. Per-module registries (reset atomically by ir_reset_module_state)
#   3. Per-function & transient expression state (reset by ir_reset_func_frame,
#      saved and restored atomically via IrFuncFrame for nested lambdas,
#      spawn wrappers, and named fn-value wrappers)
#
# keeping all state at Layer 1 eliminates circular-dependency workarounds
# (*_with_state trampolines) and ensures nested function emission cannot
# forget to save or restore a per-function variable.

from ast import Node
from ir_builder import IrBuilderSnapshot, ir_builder_reset, ir_builder_reset_function, ir_builder_reset_registers, ir_builder_set_string_module_count, ir_builder_snapshot, ir_builder_restore, ir_builder_lines
from ir_common import ir_push_string

# ===========================================================================
# Shared lowering callback hooks
# ===========================================================================

## callbacks handed to Layer 3-4 lowering satellites so they can emit nested
## expressions, values, blocks, returns, or default returns without creating
## an import cycle back into ir_lower.
pub struct IrEmitHooks:
    pub emit_expr: fn(Int) -> Int
    pub emit_value: fn(Int) -> Int
    pub emit_block: fn(Int) -> Int
    pub emit_ret: fn(Int)

## callbacks handed to decode lowering for expressions, target-typed values,
## and function default returns.
pub struct IrDecodeHooks:
    pub emit_expr: fn(Int) -> Int
    pub emit_value_for_target: fn(Int, String) -> Int
    pub emit_default_ret: fn() -> Int

# ===========================================================================
# Tier 1 — Build-level config & cross-module persistent registries
# ===========================================================================

## direct import AST roots for the module about to be emitted (consumed by emit_ir).
pub mut ir_preloaded_import_roots: List[Int] := []
## resolved module paths parallel to ir_preloaded_import_roots.
pub mut ir_preloaded_import_paths: List[String] := []
## every module AST root in the build (persists across emit_ir calls).
pub mut ir_all_module_roots: List[Int] := []
## resolved module paths parallel to ir_all_module_roots.
pub mut ir_all_module_paths: List[String] := []
## entry file AST root index, or -1.
pub mut ir_entry_root := 0 - 1
## resolved module path of the module currently being emitted ("" for entry).
pub mut ir_current_module_path := ""
## true when emitting a `pith test` module build.
pub mut ir_emit_tests := false
## source file path reported in test output and assertion failures.
pub mut ir_test_source_file := ""
## when true, emit `mark` directives for the static count checker.
pub mut ir_count_marks := false
## monotonic counter bumped after each emit_ir call for module-unique symbols.
pub mut ir_module_count := 0

## arena high-water mark for the one-pass index-offset overflow scan.
pub mut ir_index_offsets_scanned := 0
## index offset node -> indexed container node for unchecked offset arithmetic.
pub mut ir_index_offset_targets: Map[Int, Int] := {}

## cached PITH_RESULT_REG flag (-1 uninitialized, 0 disabled, 1 enabled).
pub mut ir_result_reg_flag := 0 - 1
## monotonic counter for generated lambda, spawn, and fn-value wrapper symbols.
pub mut ir_lambda_count := 0
## monotonic counter for unique `for` loop slot prefixes across modules.
pub mut ir_for_count := 0

## process-unique threadlocal slot ids keyed by qualified global name.
pub mut ir_threadlocal_slots: Map[String, Int] := {}
## IR retkind for each threadlocal global.
pub mut ir_threadlocal_kinds: Map[String, String] := {}
## next threadlocal slot id to assign across the build.
pub mut ir_next_tls_slot := 0

## exported borrow-param proofs ("<sym>/<pos>" -> "result"|"optional").
pub mut ir_borrow_param_exported: Map[String, String] := {}
## exported storage-keeper proofs (qualified symbol -> true).
pub mut ir_storage_keepers_exported: Map[String, Bool] := {}
## exported CAS-return keeper proofs (qualified symbol -> true).
pub mut ir_cas_return_fns_exported: Map[String, Bool] := {}
## concrete type name -> interface runtime type id (persistent across modules).
pub mut ir_interface_type_ids: Map[String, Int] := {}

# --- public driver configuration setters ---

## declare the direct import roots and paths for the next emit_ir call.
pub fn set_import_roots(roots: List[Int], paths: List[String]):
    ir_preloaded_import_roots = roots
    ir_preloaded_import_paths = paths

## declare every module root and path in the build for cross-module impl collection.
pub fn set_all_module_roots(roots: List[Int], paths: List[String]):
    ir_all_module_roots = roots
    ir_all_module_paths = paths

## declare the entry file's AST root for cross-module generic impl dispatch.
pub fn set_entry_root(root: Int):
    ir_entry_root = root

## set the resolved module path of the module about to be emitted ("" for entry).
pub fn set_current_module_path(path: String):
    ir_current_module_path = path

## enable or disable test-mode lowering for the next emit_ir call.
pub fn set_test_mode(enabled: Bool):
    ir_emit_tests = enabled

## enable or disable count-checker `mark` lines for subsequent emissions.
pub fn set_count_marks(enabled: Bool):
    ir_count_marks = enabled

## set the source file path embedded into generated test binaries.
pub fn set_test_source_file(path: String):
    ir_test_source_file = path

