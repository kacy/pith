# TLS interop against Go's crypto/tls, a second independent reference stack.
# Covers both directions: Go client -> pith server and pith client -> Go server,
# across TLS 1.2/1.3 and RSA/ECDSA certificates. The Go peer (tests/interop/
# tls_peer) is pinned to a version so each combination is exercised explicitly.
# A Go client prints "<version> <cipher> <echo>"; the pith side asserts it.

import std.net.tls as tls
import std.os.process as process
import std.time as time

PEER := "tests/interop/tls_peer/tls_peer"

fn pith_echo_server(listener: tls.Listener):
    r := listener.accept()
    if r.is_err:
        return
    conn := r.ok
    msg := conn.read(64) catch ""
    conn.write_all("echo:" + msg) catch 0
    conn.close()

# Go client -> pith server. Reports "<version> <cipher>" from the Go client,
# or an error tag.
fn go_client_to_pith_server(label: String, port: Int, cert: String, key: String, ca: String, version: String):
    server_cfg_r := tls.server_config(cert, key)
    if server_cfg_r.is_err:
        print(label + ": server-config-error")
        return
    server_cfg := server_cfg_r.ok
    listener_r := tls.listen("127.0.0.1", port, server_cfg)
    if listener_r.is_err:
        print(label + ": listen-error")
        server_cfg.close()
        return
    listener := listener_r.ok
    spawn pith_echo_server(listener)
    out := process.command(PEER).arg("client").arg("127.0.0.1:" + port.to_string()).arg(ca).arg("localhost").arg(version).arg(version).output()
    mut result := "proc-error"
    if out.is_ok:
        line := out.ok.stdout.trim()
        if line.contains("echo:hi"):
            # drop the trailing " echo:hi" and report just version + cipher
            result = line.substring(0, line.len() - 8)
        else:
            result = "no-echo(" + line + ")"
    print(label + ": " + result)
    listener.close()
    server_cfg.close()

# pith client -> Go server. Reports the pith client's negotiated version+cipher.
fn pith_client_to_go_server(label: String, port: Int, cert: String, key: String, ca: String, version: String):
    proc_r := process.command(PEER).arg("server").arg(port.to_string()).arg(cert).arg(key).arg(version).arg(version).start()
    if proc_r.is_err:
        print(label + ": peer-unavailable")
        return
    proc := proc_r.ok
    cfg := tls.client_config_with_ca_file(ca) catch tls.Config(0 - 1)
    mut result := "no-connection"
    mut attempt := 0
    while attempt < 25 and result == "no-connection":
        r := tls.dial_with_config("127.0.0.1", port, "localhost", cfg)
        if r.is_ok:
            conn := r.ok
            v := conn.version_name() + " " + conn.cipher_suite_name()
            wrote := conn.write_all("hi")
            mut echoed := ""
            if wrote.is_ok:
                echoed = conn.read(64) catch ""
            conn.close()
            if echoed == "echo:hi":
                result = v
            else:
                result = "no-echo"
        attempt = attempt + 1
        time.delay(40)
    print(label + ": " + result)
    cfg.close()
    proc.kill()
    proc.wait()

RSA_CERT := "tests/live/fixtures/localhost.crt"
RSA_KEY := "tests/live/fixtures/localhost.key"
RSA_CA := "tests/live/fixtures/localhost-ca.crt"
EC_CERT := "tests/live/fixtures/localhost-ecdsa.crt"
EC_KEY := "tests/live/fixtures/localhost-ecdsa.key"
EC_CA := "tests/live/fixtures/localhost-ecdsa-ca.crt"

fn main() -> Int!:
    go_client_to_pith_server("go->pith rsa 1.2", 44500, RSA_CERT, RSA_KEY, RSA_CA, "1.2")
    go_client_to_pith_server("go->pith rsa 1.3", 44501, RSA_CERT, RSA_KEY, RSA_CA, "1.3")
    go_client_to_pith_server("go->pith ecdsa 1.2", 44502, EC_CERT, EC_KEY, EC_CA, "1.2")
    go_client_to_pith_server("go->pith ecdsa 1.3", 44503, EC_CERT, EC_KEY, EC_CA, "1.3")
    pith_client_to_go_server("pith->go rsa 1.3", 44504, RSA_CERT, RSA_KEY, RSA_CA, "1.3")
    return 0
