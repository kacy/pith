# `.value()` on a none stops with a runtime error. the payload read used to
# run unconditionally: a struct payload came back as a null handle and the
# next field read segfaulted.
struct Point:
    x: Int

fn find(points: List[Point], x: Int) -> Point?:
    for p in points:
        if p.x == x:
            return p
    return none

fn main():
    points := [Point(x: 1), Point(x: 2)]
    print("found:{find(points, 2).value().x}")
    print("missing:{find(points, 3).value().x}")
