fn main() -> Int!:
    xs: List[Int] := [0, 10, 20]
    print("get0_present:" + (xs.get(0) != none).to_string())
    print("get0_value:" + xs.get(0).unwrap_or(-1).to_string())
    print("get2_value:" + xs.get(2).unwrap_or(-1).to_string())
    print("get_neg:" + (xs.get(-1) == none).to_string())
    print("get_oob:" + (xs.get(3) == none).to_string())
    print("first_value:" + xs.first().unwrap_or(-1).to_string())
    print("last_value:" + xs.last().unwrap_or(-1).to_string())

    empty: List[Int] := []
    print("empty_get_none:" + (empty.get(0) == none).to_string())
    print("empty_first_none:" + (empty.first() == none).to_string())
    print("empty_last_none:" + (empty.last() == none).to_string())

    zero_only: List[Int] := [0]
    print("zero_first_present:" + (zero_only.first() != none).to_string())
    print("zero_first_value:" + zero_only.first().unwrap_or(-1).to_string())
    print("zero_last_value:" + zero_only.last().unwrap_or(-1).to_string())
    return 0
