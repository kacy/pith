# a state machine: an enum for the states, one match per input.
#
# parses the head of an http request one character at a time, the way a
# server reads bytes off a socket. each State says what the parser is in the
# middle of, and a single match decides what a character means there. the
# checker rejects a match that forgets a state, so a new state cannot be
# half wired in.

enum State:
    Method
    Path
    Version
    HeaderName
    HeaderValue
    Done

struct Request:
    method: String
    path: String
    version: String
    headers: Map[String, String]

fn parse_head(input: String) -> Request:
    request := Request(method: "", path: "", version: "", headers: {})
    mut state := State.Method
    mut current := ""
    mut header_name := ""

    for character in input:
        match state:
            State.Method =>
                if character == " ":
                    request.method = current
                    current = ""
                    state = State.Path
                else:
                    current = current + character
            State.Path =>
                if character == " ":
                    request.path = current
                    current = ""
                    state = State.Version
                else:
                    current = current + character
            State.Version =>
                if character == "\n":
                    request.version = current
                    current = ""
                    state = State.HeaderName
                else:
                    current = current + character
            State.HeaderName =>
                # an empty line ends the head
                if character == "\n":
                    state = State.Done
                elif character == ":":
                    header_name = current.to_lower()
                    current = ""
                    state = State.HeaderValue
                else:
                    current = current + character
            State.HeaderValue =>
                if character == "\n":
                    request.headers[header_name] = current.trim()
                    current = ""
                    state = State.HeaderName
                else:
                    current = current + character
            State.Done =>
                break
    return request

fn main():
    raw_requests := [
        "GET /index.html HTTP/1.1\nHost: example.com\nAccept: text/html\n\n",
        "POST /api/orders HTTP/1.1\nHost: shop.example\nContent-Type: application/json\nContent-Length: 27\n\n{\"item\": \"tea\"}",
    ]
    for raw in raw_requests:
        request := parse_head(raw)
        print("{request.method} {request.path} ({request.version})")
        print("  host: {request.headers.get("host").unwrap_or("none")}")
        print("  content type: {request.headers.get("content-type").unwrap_or("none")}")
        print("  {request.headers.len()} headers")
