; a field read from a struct after its last release, under PITH_QUARANTINE=1.
; nothing but generated code touches the struct between the release and the
; read, so a sanitizer sees nothing: the load is not instrumented, and with
; the struct pool on the block may already hold another value. quarantine
; keeps the block, and the build's struct check reports the read.
string m0s0 "before:"
func main 0 void
iconst 1 3
iconst 2 4
iconst 3 2
call 4 pith_struct_alloc struct:Point 1 3
sstore 4 0 1
sstore 4 1 2
field 5 4 0 int x
strref 6 m0s0
call 7 int_to_string string 1 5
concat 8 6 7
call 9 pith_print_cstr unknown 1 8
call 10 pith_struct_release void 1 4
field 11 4 0 int x
call 12 int_to_string string 1 11
call 13 pith_print_cstr unknown 1 12
iconst 14 0
ret 14
endfunc
