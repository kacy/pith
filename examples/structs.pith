# structs: declaring fields, building values, field defaults and updates.
#
# lays out boxes for a shipment: each box has a size and a weight, the
# shipping options have defaults most orders keep, and a pallet collects the
# boxes. structs are reference values, so a box changed through one name is
# changed everywhere it is held.

struct Size:
    width: Int
    depth: Int
    height: Int

struct Parcel:
    label: String
    size: Size
    grams: Int

# fields with defaults can be left out when the struct is built
struct ShippingOptions:
    carrier: String = "post"
    insured: Bool = false
    signature: Bool = false

struct Pallet:
    parcels: List[Parcel]
    max_grams: Int

fn volume_litres(size: Size) -> Int:
    return size.width * size.depth * size.height / 1000

fn total_grams(pallet: Pallet) -> Int:
    mut total := 0
    for parcel in pallet.parcels:
        total += parcel.grams
    return total

fn describe(options: ShippingOptions) -> String:
    return "{options.carrier}, insured: {options.insured}, signature: {options.signature}"

fn main():
    # positional construction is fine when the order is obvious; name the
    # fields when several share a type
    books := Parcel("books", Size(30, 20, 15), 6200)
    lamp := Parcel(label: "lamp", size: Size(width: 40, depth: 40, height: 60), grams: 2100)
    pallet := Pallet(parcels: [books, lamp], max_grams: 10000)

    for parcel in pallet.parcels:
        print("{parcel.label:<6} {volume_litres(parcel.size):>3} l  {parcel.grams:>5} g")
    print("pallet weight: {total_grams(pallet)} g of {pallet.max_grams} g")

    # the pallet holds the same parcel as `books`, so the update shows there
    books.grams = 7400
    print("after repacking the books: {total_grams(pallet)} g")

    standard := ShippingOptions()
    fragile := ShippingOptions(insured: true, signature: true)
    print("standard: {describe(standard)}")
    print("fragile: {describe(fragile)}")
