# std.testing — lightweight testing helpers
#
# these belong in a `main()` that ends with done(), which prints the tally. a
# check that fails prints a line and lets the run continue, so one broken case
# does not hide the next twenty.
#
#   from std.testing import assert_eq, assert_ne, check_true, check_not, done
#
#   fn main():
#       assert_eq(1 + 1, 2)
#       assert_eq("hello", "hello")
#       assert_ne(2 + 2, 5)
#       check_true(10 > 5, "comparison")
#       done()
#
# inside a colocated `test "..."` block, reach for the built-in assert/assert_eq
# instead: they read better and they say where they failed. these still work
# there — a check that fails fails the block, because a recorded failure sets
# the same process verdict a built-in assertion does. that used to be two
# separate counts, and a check made inside a block landed in the one the block
# never printed, which turned a failing assertion into a line of output nobody
# was reading.

import std.fs as fs

# the tally, and the lock over it. an assertion made from a spawned task is a
# perfectly ordinary thing to write — testing concurrent code is what spawning
# in a test is for — and two tasks incrementing a bare counter lose results,
# which here means a failure that never gets reported. the lock covers the
# counters and the silent flag; the line is printed after it is released, so a
# slow terminal never serializes the tasks under test.
mut counts_mu := Mutex()
mut pass_count: Int := 0
mut fail_count: Int := 0
mut silent: Bool := false

# clear the tally and, with it, the process verdict. the only caller is a test
# of the tally itself, which provokes failures on purpose; clearing the verdict
# it just set is how those failures stay the subject rather than becoming the
# result. anything else that resets counts is saying the same thing.
fn reset_counts():
    counts_mu.lock()
    pass_count = 0
    fail_count = 0
    silent = false
    counts_mu.unlock()
    set_test_failed(false)

## stop printing a line per check and per case. the tally still counts, and a
## failure still fails the run — this only quietens the output, for a caller
## that runs a table many thousands of times and wants its own line at the end
## rather than one per row.
pub fn silence_output():
    counts_mu.lock()
    silent = true
    counts_mu.unlock()

fn record_pass(name: String):
    counts_mu.lock()
    pass_count = pass_count + 1
    quiet := silent
    counts_mu.unlock()
    if quiet:
        return
    print("  ok   " + name)

fn record_fail(name: String, detail: String):
    counts_mu.lock()
    fail_count = fail_count + 1
    quiet := silent
    counts_mu.unlock()
    # the run has failed whether or not anyone is listening. marking it here,
    # rather than only counting it, is what makes a failed check inside a `test`
    # block fail that block instead of vanishing into a tally it never prints.
    set_test_failed(true)
    if quiet:
        return
    print("  FAIL " + name + " -- " + detail)

# assert that two values are equal.
pub fn assert_eq[T](got: T, want: T):
    if got == want:
        record_pass("assert_eq")
    else:
        record_fail("assert_eq", "got {got}, want {want}")

# assert that two values are different.
pub fn assert_ne[T](left: T, right: T):
    if left != right:
        record_pass("assert_ne")
    else:
        record_fail("assert_ne", "values should differ: {left}")

# two integers are equal
pub fn check[T](got: T, want: T, name: String):
    if got == want:
        record_pass(name)
        return
    record_fail(name, "got {got}, want {want}")

# two strings are equal
pub fn check_str(got: String, want: String, name: String):
    check(got, want, name)

# two integers differ
pub fn check_ne(a: Int, b: Int, name: String):
    if a == b:
        record_fail(name, "values should differ")
        return
    record_pass(name)

# condition is true
pub fn check_true(cond: Bool, name: String):
    if not cond:
        record_fail(name, "expected true")
        return
    record_pass(name)

# condition is false
pub fn check_not(cond: Bool, name: String):
    if cond:
        record_fail(name, "expected false")
        return
    record_pass(name)

# assert that a condition is true.
pub fn assert_true(cond: Bool):
    if cond:
        record_pass("assert_true")
    else:
        record_fail("assert_true", "expected true")

# assert that a condition is false.
pub fn assert_false(cond: Bool):
    if not cond:
        record_pass("assert_false")
    else:
        record_fail("assert_false", "expected false")

# assert that a string contains the expected substring.
pub fn assert_contains(text: String, part: String):
    if text.contains(part):
        record_pass("assert_contains")
    else:
        record_fail("assert_contains", "missing substring: " + chr(34) + part + chr(34))

# assert that two strings are equal and print a compact diff hint.
pub fn assert_eq_text(got: String, want: String):
    if got == want:
        record_pass("assert_eq_text")
        return
    record_fail("assert_eq_text", text_difference(got, want))

## assert that a failure carried the reason it was supposed to. pass the
## error's message — `r.err` for a String error, `r.err.message` for a struct
## one — and the text it should mention.
##
##   r := jwt.verify_hs256(tampered, key, options)
##   assert(r.is_err)
##   assert_err_contains(r.err, "signature")
##
## a negative test written as `assert(r.is_err)` alone passes just as happily
## when the call fails for a reason nobody intended — a malformed fixture, a
## renamed field, a check that ran before the one under test. naming the reason
## is what makes it a test of the rejection rather than of any failure at all.
pub fn assert_err_contains(message: String, part: String):
    if message.contains(part):
        record_pass("assert_err_contains")
        return
    record_fail("assert_err_contains", "error said " + chr(34) + message + chr(34) + ", expected it to mention " + chr(34) + part + chr(34))

## where two strings first differ, with a little of each side for context.
## reporting the two lengths — which is what this used to do — tells you
## nothing about a mismatch four hundred characters in.
##
## the scan compares bytes, so two strings that differ inside the same
## multi-byte character stop on a byte that is not a character boundary. the
## report is cut at the boundary before that, because a String cannot be cut
## anywhere else: `assert_eq_text("é", "ê")` — the same lead byte, different
## second byte — used to stop the whole test process instead of reporting a
## difference.
pub fn text_difference(got: String, want: String) -> String:
    mut i := 0
    mut limit := got.len()
    if want.len() < limit:
        limit = want.len()
    while i < limit and got[i] == want[i]:
        i = i + 1
    if i == limit:
        return "identical for {limit} bytes, then got {got.len()} bytes total, want {want.len()}"
    return "first differ at byte {i}: got " + chr(34) + window(got, character_start(got, i)) + chr(34) + ", want " + chr(34) + window(want, character_start(want, i)) + chr(34)

# the start of the character `at` falls inside, so a report is cut where a
# String can be cut.
fn character_start(text: String, at: Int) -> Int:
    mut back := at
    while back > 0 and back < text.len() and continues_character(text, back):
        back = back - 1
    return back

fn continues_character(text: String, at: Int) -> Bool:
    code := ord(text[at])
    return code >= 128 and code < 192

# up to sixteen bytes of `text` from `at`, ending on a character boundary so a
# report never asks for half of one.
fn window(text: String, at: Int) -> String:
    if at >= text.len():
        return ""
    mut end := at + 16
    if end > text.len():
        end = text.len()
    while end > at and end < text.len() and continues_character(text, end):
        end = end - 1
    return text.substring(at, end)

# assert that a file exists.
pub fn assert_file_exists(path: String):
    if fs.exists(path) and fs.is_file(path):
        record_pass("assert_file_exists")
    else:
        record_fail("assert_file_exists", "missing file: " + path)

# assert that a directory exists.
pub fn assert_dir_exists(path: String):
    if fs.exists(path) and fs.is_dir(path):
        record_pass("assert_dir_exists")
    else:
        record_fail("assert_dir_exists", "missing dir: " + path)

# run a callback with a temporary directory and remove it afterwards.
pub fn with_temp_dir(prefix: String, run: fn(String) -> Bool) -> Bool:
    dir := fs.make_temp_dir(prefix)
    if dir.is_err:
        record_fail("with_temp_dir", "could not create temp dir")
        return false
    ok := run(dir.ok)
    fs.remove_tree(dir.ok)
    if ok:
        record_pass("with_temp_dir")
    else:
        record_fail("with_temp_dir", "callback returned false")
    return ok

# --- table-driven cases -----------------------------------------------------
#
# a table of rows checked by one body is a loop you write by hand, and a loop
# has no per-row identity: the first row that fails ends the whole block, the
# failure names the assertion rather than the row that provoked it, and there is
# no way to ask for one row back. `each` gives every row a result line of its
# own and a name `--filter` can select.

# between a test's name and a case label, in a case identity and in a filter.
# the runner knows this separator too: a filter that begins with a test's name
# and this is aimed at a case inside that test, so the test runs rather than
# being filtered out on its own name, and `each` sorts the rows out from there.
CASE_SEPARATOR := " / "

## one row of a table-driven test: the label that names it in the result line
## and in `--filter`, and the value the body is run against.
pub struct Case[T]:
    pub label: String
    pub value: T

## build one labeled row for `each`.
##
##   case("trailing junk", "12x")
pub fn case[T](label: String, value: T) -> Case[T]:
    return Case(label: label, value: value)

# a row's full name: the test it sits in, the separator, and its label. outside
# a test — a std.testing `main()` — there is no enclosing name, so the label is
# the whole identity.
fn case_identity(prefix: String, label: String) -> String:
    if prefix == "":
        return label
    return prefix + CASE_SEPARATOR + label

## run `body` once per row, reporting every row under its own name.
##
##   from std.testing import case, each
##
##   test "parse_int rejects what is not a number":
##       each([
##           case("empty", ""),
##           case("letters", "abc"),
##           case("trailing junk", "12x"),
##       ], fn(text: String) => parse_int(text).is_err)
##
## a row passes when the body returns true and no check inside it recorded a
## failure. a row that fails is named — by label and by position — and every row
## after it still runs, which is the point: a hand-written loop stops at the
## first failure and reports the assertion instead of the row.
##
## the built-in `assert`, `assert_eq` and `assert_ne` end the process where they
## fail, so a case body that reaches for one takes its siblings down with it.
## import this module's assertions instead — `from std.testing import assert_eq`
## makes the recording version win for the whole file — and a failing row prints
## both sides before `each` names it.
##
## a row runs under `--filter` when its identity contains the filter, so
## `--filter "parse_int rejects what is not a number / letters"` runs one row
## and `--filter "parse_int rejects"` runs the table.
pub fn each[T](rows: List[Case[T]], body: fn(T) -> Bool):
    filter := env("PITH_TEST_FILTER")
    prefix := test_name()
    for row, i in rows:
        if filter != "" and not case_identity(prefix, row.label).contains(filter):
            continue
        name := "[" + (i + 1).to_string() + "] " + row.label
        before := failure_count()
        ok := body(row.value)
        failed_checks := failure_count() - before
        if failed_checks > 0:
            # the checks inside the row have already printed their detail and
            # counted themselves. naming the row is the part they cannot do.
            mut detail := "a check above failed"
            if failed_checks > 1:
                detail = failed_checks.to_string() + " checks above failed"
            name_case_failure(name, detail)
        elif ok:
            record_pass(name)
        else:
            record_fail(name, "the case did not hold")

fn failure_count() -> Int:
    counts_mu.lock()
    n := fail_count
    counts_mu.unlock()
    return n

# say which row a failure belongs to without counting it a second time: the
# check inside it already moved the tally and set the verdict.
fn name_case_failure(name: String, detail: String):
    counts_mu.lock()
    quiet := silent
    counts_mu.unlock()
    if quiet:
        return
    print("  FAIL " + name + " -- " + detail)

# print summary
pub fn done():
    counts_mu.lock()
    passed := pass_count
    failed := fail_count
    counts_mu.unlock()
    print("")
    if failed == 0:
        print((passed + failed).to_string() + " passed")
    else:
        print(passed.to_string() + " passed, " + failed.to_string() + " failed")

test "testing helpers count passing checks":
    reset_counts()
    silence_output()

    assert_eq(1, 1)
    assert_ne(1, 2)
    check(3, 3, "ints")
    check_str("pith", "pith", "strings")
    check_ne(1, 2, "different ints")
    check_true(true, "truth")
    check_not(false, "falsehood")
    assert_true(true)
    assert_false(false)
    assert_contains("hello pith", "pith")
    assert_eq_text("same", "same")

    assert(pass_count == 11)
    assert(fail_count == 0)

test "testing helpers count failing checks":
    reset_counts()
    silence_output()

    assert_eq(1, 2)
    assert_ne(1, 1)
    check(1, 2, "bad ints")
    check_str("left", "right", "bad strings")
    check_ne(1, 1, "same ints")
    check_true(false, "not true")
    check_not(true, "not false")
    assert_true(false)
    assert_false(true)
    assert_contains("hello", "pith")
    assert_eq_text("left", "right")

    assert(pass_count == 0)
    assert(fail_count == 11)

    # those eleven failures are what this test is about, not what it reports.
    # without this the block would end on a failed verdict and be counted, quite
    # correctly, as a failing test.
    reset_counts()

test "testing helpers inspect files and temp dirs":
    reset_counts()
    silence_output()

    ok := with_temp_dir("pith-std-testing-", fn(dir: String) => fs.is_dir(dir))

    assert(ok)
    assert(pass_count == 1)
    assert(fail_count == 0)

# assert from a task, so the tally takes concurrent writes. the counters are
# private to this module, which is why this regression lives beside them rather
# than in tests/cases.
fn assert_from_task(rounds: Int) -> Int:
    mut i := 0
    while i < rounds:
        assert_eq(i, i)
        assert_ne(i, i + 1)
        i = i + 1
    return rounds * 2

test "the tally survives assertions made from several tasks at once":
    reset_counts()
    silence_output()

    per := 2000
    a := spawn assert_from_task(per)
    b := spawn assert_from_task(per)
    c := spawn assert_from_task(per)
    d := spawn assert_from_task(per)

    mut expected := 0
    expected = expected + await a
    expected = expected + await b
    expected = expected + await c
    expected = expected + await d

    assert(pass_count == expected)
    assert(fail_count == 0)

# a payload enum for the compiler regression test below. the two payload
# variants deliberately carry different heap types so the test can reuse
# one binding name across arms.
enum MatchProbe:
    Unset
    Word(String)
    Nums(List[Int])

# regression: a match with payload bindings written directly in a test
# body used to miscompile ("unknown load source") because test functions
# skipped the locals prologue ordinary functions get. the arms also reuse
# the binding name `v` with different payload types, which used to trip a
# second miscompile in any function body.
test "match payload bindings work directly in a test body":
    reset_counts()
    silence_output()

    w := MatchProbe.Word("star")
    got := match w:
        MatchProbe.Word(v) => v
        MatchProbe.Nums(v) => v.len().to_string()
        _ => ""
    assert_eq(got, "star")

    n := MatchProbe.Nums([1, 2, 3])
    count := match n:
        MatchProbe.Word(v) => v
        MatchProbe.Nums(v) => v.len().to_string()
        _ => ""
    assert_eq(count, "3")

    assert(pass_count == 2)
    assert(fail_count == 0)

test "a table reports every row, and one bad row does not end the table":
    reset_counts()
    silence_output()

    each([
        case("empty", ""),
        case("short", "ab"),
        case("too long", "abcdefghij"),
        case("still short", "cd"),
], fn(s: String) => s.len() < 5)

    # three rows passed and the fourth still ran after the third failed, which
    # is the whole difference from a hand-written loop.
    assert(pass_count == 3)
    assert(fail_count == 1)

    reset_counts()

test "a row that fails a check is named once, not counted twice":
    reset_counts()
    silence_output()

    body := fn(n: Int):
        check(n, 1, "is one")
        return true

    each([case("one", 1), case("two", 2)], body)

    # the passing row counts as a result of its own, the way with_temp_dir
    # does, so the tally reads two passes: the check and the row it held. the
    # failing check counted itself, and naming the row it belongs to does not
    # count it a second time.
    assert(pass_count == 2)
    assert(fail_count == 1)

    reset_counts()

test "a case identity is the test name and the label":
    reset_counts()
    silence_output()

    assert_eq(test_name(), "a case identity is the test name and the label")
    assert_eq(case_identity(test_name(), "a row"), test_name() + " / a row")
    # outside a test there is no enclosing name, so the label stands alone.
    assert_eq(case_identity("", "a row"), "a row")

    reset_counts()

test "a table of input and expected pairs reads as a table":
    reset_counts()
    silence_output()

    each([
        case("empty", ("", 0)),
        case("one character", ("a", 1)),
        case("several", ("abcd", 4)),
], fn(c: (String, Int)) => c.0.len() == c.1)

    assert(pass_count == 3)
    assert(fail_count == 0)

    reset_counts()
