# range patterns in match: inclusive ..=, exclusive .., or-patterns
# combining ranges, guards on top, and range arms beside literal arms.

fn grade(score: Int) -> String:
    match score:
        90..=100 => "A"
        80..=89 => "B"
        70..=79 => "C"
        0..70 => "F"
        _ => "invalid"

fn bucket(n: Int) -> String:
    match n:
        0 => "zero"
        1..=9 | 20..=29 => "small or twenties"
        10..=19 if n % 2 == 0 => "even teen"
        10..=19 => "odd teen"
        _ => "big"

fn main():
    print(grade(95))
    print(grade(80))
    print(grade(70))
    print(grade(69))
    print(grade(101))
    print(bucket(0))
    print(bucket(5))
    print(bucket(25))
    print(bucket(12))
    print(bucket(13))
    print(bucket(50))
