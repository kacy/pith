# std.redis — a small redis client speaking RESP over a tcp socket.
#
# connect to a server, then send commands with `command` (the general form) or
# the typed helpers (get/set/del/incr/...). replies come back as a `Reply`,
# a tagged value that mirrors RESP: a status line, an error, an integer, a bulk
# string, nil, or an array of nested replies.
#
# a reply is text: a bulk string carrying bytes that are not utf-8 comes back
# as an error rather than as a string quietly filled with replacement
# characters. reach for a redis client that speaks bytes if you store blobs.
#
# reads go straight to the tcp_* builtins, the same ones std.io wraps. writes
# go through std.net.tcp's write_all, because a single write syscall stops once
# the send buffer is full and a large command has to resume from there.

import std.bytes as bytes
import std.net.tcp as tcp

# replies come off an untrusted socket, so the length and count fields a server
# advertises are bounded before we act on them: a hostile or buggy peer must not
# be able to drive the client to OOM or overflow the native stack.
MAX_LINE_LEN := 65536 # a status/error/header line before its CRLF
MAX_BULK_LEN := 536870912 # 512 MiB — a single bulk string
MAX_ARRAY_ITEMS := 10485760 # elements in one array reply
MAX_REPLY_DEPTH := 64 # nested-array nesting

# bytes asked for in one socket read while looking for the end of a line. a
# read allocates and zeroes everything it asks for, so asking for more than a
# reply header needs makes every small reply pay for the one large one.
READ_CHUNK := 4096

# bytes asked for in one socket read while gathering a bulk payload of a known
# length. the size is already known here, so a larger read is a straight saving
# in syscalls and never over-reads: what is asked for is what is still missing,
# up to this.
PAYLOAD_CHUNK := 65536

# the most a bulk read reserves up front. the payload length comes off the
# wire, so reserving all of it would let a twelve-byte header ask for half a
# gigabyte before a single payload byte has arrived; the buffer grows as the
# data actually lands instead.
MAX_RESERVE := 262144

# the two bytes that terminate every RESP line.
CR := 13
LF := 10

# a reply from redis. `Bulk` and `Array` may be absent, reported as `Nil`.
# an array's elements are flattened to strings (a scalar becomes its text, a
# nil becomes ""), which covers the common list-returning commands; reach for
# `command` and parse yourself if you need nested structure.
pub enum Reply:
    Status(String)
    Error(String)
    Integer(Int)
    Bulk(String)
    Nil
    Array(List[String])

# the scalar text of a reply, for flattening array elements.
fn reply_text(r: Reply) -> String:
    return match r:
        Reply.Status(s) => s
        Reply.Error(s) => s
        Reply.Integer(n) => n.to_string()
        Reply.Bulk(s) => s
        Reply.Nil => ""
        Reply.Array(_) => ""

# true when the reply is a server error (RESP `-ERR ...`).
fn reply_is_error(r: Reply) -> Bool:
    return match r:
        Reply.Error(_) => true
        _ => false

# a connection to a redis server. `buf` holds the bytes read off the socket
# that have not been parsed yet, and `pos` is how far into them the parser has
# got. the cursor is what keeps the client linear: consuming a line or a
# payload only moves `pos`, and the bytes already consumed are dropped in one
# step when the next read comes in, so no byte of a reply is copied twice.
pub struct Client:
    fd: Int
    mut buf: Bytes
    mut pos: Int

# open a connection to a redis server.
pub fn connect(host: String, port: Int) -> Client!:
    fd := tcp_connect(host, port)!
    return Client(fd: fd, buf: bytes.empty(), pos: 0)

impl Client:
    # bytes read off the socket that the parser has not consumed yet.
    fn buffered() -> Int:
        return self.buf.len() - self.pos

    # decode a byte range of the buffer as text. a reply is text as far as this
    # client is concerned, so bytes that are not utf-8 are an error rather than
    # a string quietly filled with replacement characters.
    fn text(start: Int, end: Int) -> String!:
        decoded := bytes.substring_utf8(self.buf, start, end)
        if decoded.is_err:
            fail "redis: reply is not valid utf-8"
        return decoded.ok

    # pull one more chunk from the socket into the buffer; false at end of
    # stream. the consumed prefix is dropped here, once per read, rather than
    # on every parse step.
    fn fill() -> Bool!:
        chunk := tcp_read_bytes(self.fd, READ_CHUNK)!
        if chunk.len() == 0:
            return false
        if self.buffered() == 0:
            self.buf = chunk
        else:
            self.buf = self.buf.slice(self.pos, self.buf.len()).concat(chunk)
        self.pos = 0
        return true

    # index of the first CRLF at or after `start`, or -1 when there is none in
    # the bytes read so far.
    fn find_crlf(start: Int) -> Int:
        mut i := start
        if i < self.pos:
            i = self.pos
        limit := self.buf.len() - 1
        while i < limit:
            if self.buf[i] == CR and self.buf[i + 1] == LF:
                return i
            i = i + 1
        return -1

    # read one CRLF-terminated line, returning it without the terminator.
    fn read_line() -> String!:
        mut idx := self.find_crlf(self.pos)
        while idx < 0:
            # a server that never sends the terminator must not grow the buffer
            # without bound.
            if self.buffered() > MAX_LINE_LEN:
                fail "redis: reply line exceeds maximum length"
            searched := self.buffered()
            if not self.fill()!:
                fail "redis: connection closed"
            # resume one byte back, so a CR that was the last byte of the
            # previous read still pairs with the LF that follows it. every
            # other byte is looked at once, whatever sizes the reply arrives in.
            mut resume := self.pos + searched - 1
            if resume < self.pos:
                resume = self.pos
            idx = self.find_crlf(resume)
        line := self.text(self.pos, idx)!
        self.pos = idx + 2
        return line

    # read exactly `count` payload bytes plus the trailing CRLF.
    fn read_payload(count: Int) -> String!:
        need := count + 2
        if self.buffered() >= need:
            data := self.text(self.pos, self.pos + count)!
            self.pos = self.pos + need
            return data
        # the length is known, so the rest of the payload is read straight into
        # a buffer that grows: the payload is copied once on the way in and
        # once on the way out, however many reads it takes to arrive.
        mut reserve := need
        if reserve > MAX_RESERVE:
            reserve = MAX_RESERVE
        out := bytes.buffer_with_capacity(reserve)
        errdefer out.free()
        mut got := self.buffered()
        if got > 0:
            # the range is the unconsumed tail by construction, so a refusal
            # here would mean the cursor and the buffer had come apart. say so
            # rather than carry on having silently dropped the head of a reply.
            if not out.write_range(self.buf, self.pos, got):
                fail "redis: buffered range is outside the read buffer"
        self.buf = bytes.empty()
        self.pos = 0
        while got < need:
            mut want := need - got
            if want > PAYLOAD_CHUNK:
                want = PAYLOAD_CHUNK
            chunk := tcp_read_bytes(self.fd, want)!
            if chunk.len() == 0:
                fail "redis: connection closed"
            out.write(chunk)!
            got = got + chunk.len()
        # nothing is read past the payload, so the buffer is empty afterwards
        # and the gathered bytes are released as soon as the text is out.
        gathered := out.take_bytes()
        payload := bytes.substring_utf8(gathered, 0, count)
        if payload.is_err:
            fail "redis: reply is not valid utf-8"
        return payload.ok

    # parse one reply off the wire, recursing for arrays.
    fn read_reply() -> Reply!:
        return self.read_reply_at(0)!

    # `depth` bounds nested-array recursion so a server streaming `*1\r\n*1\r\n…`
    # can't overflow the native stack.
    fn read_reply_at(depth: Int) -> Reply!:
        if depth > MAX_REPLY_DEPTH:
            fail "redis: reply nesting too deep"
        line := self.read_line()!
        # read_line returns what came before the terminator, so a bare CRLF
        # arrives as an empty line. indexing a String is strict — line[0] on an
        # empty one stops the process — and a malformed reply must fail the call
        # rather than take the program down with it.
        if line.len() == 0:
            fail "redis: empty reply line"
        tag := line[0]
        # every reply tag is one ascii byte, and that has to be established
        # before the body is cut off the front. a String is cut in bytes, so
        # cutting at offset 1 asks for the tail of whatever character starts the
        # line — and a line that starts with a multi-byte character stopped the
        # client process outright, uncatchably, while every other malformed
        # reply in this parser came back as an ordinary error. the reply comes
        # off a socket, so the server decides which one it is.
        if tag != "+" and tag != "-" and tag != ":" and tag != "$" and tag != "*":
            fail "redis: unexpected reply: {line}"
        body := line.substring(1, line.len())
        if tag == "+":
            return Reply.Status(body)
        if tag == "-":
            return Reply.Error(body)
        if tag == ":":
            return Reply.Integer(parse_int(body)!)
        if tag == "$":
            n := parse_int(body)!
            if n < 0:
                return Reply.Nil
            if n > MAX_BULK_LEN:
                fail "redis: bulk string exceeds maximum length"
            return Reply.Bulk(self.read_payload(n)!)
        if tag == "*":
            n := parse_int(body)!
            if n < 0:
                return Reply.Nil
            if n > MAX_ARRAY_ITEMS:
                fail "redis: array exceeds maximum length"
            mut items: List[String] := []
            mut i := 0
            while i < n:
                items.push(reply_text(self.read_reply_at(depth + 1)!))
                i = i + 1
            return Reply.Array(items)
        fail "redis: unexpected reply: {line}"

    # send a command as a RESP array of bulk strings, then read one reply. a
    # server error reply (RESP `-ERR ...`) surfaces as a failed result rather
    # than a value, so callers do not silently read a default past an error.
    pub fn command(args: List[String]) -> Reply!:
        # build the RESP array through a piece list joined once: concatenating
        # each argument onto a growing string is quadratic in the total command
        # size, which bites on a pipeline or a bulk value.
        mut parts: List[String] := ["*{args.len()}\r\n"]
        for a in args:
            parts.push("${a.len()}\r\n{a}\r\n")
        tcp.write_all(self.fd, parts.join(""))!
        reply := self.read_reply()!
        if reply_is_error(reply):
            fail "redis: {reply_text(reply)}"
        return reply

    # send a command expecting an array reply, returning its elements as
    # strings (empty when the reply is nil or not an array).
    pub fn command_list(args: List[String]) -> List[String]!:
        reply := self.command(args)!
        return match reply:
            Reply.Array(items) => items
            _ => []

    # close the connection.
    pub fn close():
        tcp_close(self.fd)

    # --- typed helpers over `command` ---

    # PING, returning the pong text ("PONG" normally).
    pub fn ping() -> String!:
        reply := self.command(["PING"])!
        return match reply:
            Reply.Status(s) => s
            _ => ""

    # SET key value, true when the server replies OK.
    pub fn set(key: String, value: String) -> Bool!:
        reply := self.command(["SET", key, value])!
        return match reply:
            Reply.Status(s) => s == "OK"
            _ => false

    # GET key. a missing key (nil bulk) comes back as the empty string; use
    # `exists` first when you need to tell "" apart from absent.
    pub fn get(key: String) -> String!:
        reply := self.command(["GET", key])!
        return match reply:
            Reply.Bulk(s) => s
            _ => ""

    # DEL key, returning the number of keys removed (0 or 1).
    pub fn del(key: String) -> Int!:
        reply := self.command(["DEL", key])!
        return match reply:
            Reply.Integer(n) => n
            _ => 0

    # INCR key, returning the new value.
    pub fn incr(key: String) -> Int!:
        reply := self.command(["INCR", key])!
        return match reply:
            Reply.Integer(n) => n
            _ => 0

    # EXISTS key.
    pub fn exists(key: String) -> Bool!:
        reply := self.command(["EXISTS", key])!
        return match reply:
            Reply.Integer(n) => n > 0
            _ => false

    # KEYS pattern, returning the matching keys.
    pub fn keys(pattern: String) -> List[String]!:
        return self.command_list(["KEYS", pattern])!

# --- connection pool ---

# a small connection pool: hand out live clients and take them back for reuse,
# so callers skip the tcp connect on every command. it keeps up to `max_idle`
# clients around; extras are closed on release.
pub struct Pool:
    mut idle: List[Client]
    host: String
    port: Int
    max_idle: Int

# create a pool that dials the given server, opening clients lazily.
pub fn pool(host: String, port: Int, max_idle: Int) -> Pool:
    return Pool(idle: [], host: host, port: port, max_idle: max_idle)

impl Pool:
    # take a client from the pool, opening a fresh one if none are idle.
    pub fn acquire() -> Client!:
        n := self.idle.len()
        if n > 0:
            client := self.idle[n - 1]
            self.idle = self.idle.slice(0, n - 1)
            return client
        return connect(self.host, self.port)!

    # return a client for reuse, or close it if the pool is already full.
    pub fn release(client: Client):
        if self.idle.len() < self.max_idle:
            self.idle.push(client)
        else:
            client.close()

    # close every idle client.
    pub fn close():
        for client in self.idle:
            client.close()
        self.idle = []
