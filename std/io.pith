    while buf.len() < count:
        chunk := process_stderr_read_bytes(reader, count - buf.len())!
        if chunk.is_empty():
            fail "unexpected eof"
        buf.write(chunk)!
    return buf.take_bytes()

fn read_exact_process_stderr_bytes_ctx(reader: ProcessStderr, ctx: Context, count: Int) -> Bytes!BlockingError:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    while buf.len() < count:
        chunk := process_stderr_read_bytes_ctx(reader, ctx, count - buf.len())!
        if chunk.is_empty():
            fail blocking_failed("unexpected eof")
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
    return buf.take_bytes()

fn read_all_buffered_bytes_reader(reader: BufferedBytesReader) -> Bytes!:
    return read_all_buffered_bytes_reader_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_buffered_bytes_reader_chunked(reader: BufferedBytesReader, chunk_size: Int) -> Bytes!:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    mut chunk := reader.read_bytes(size)!
    while not chunk.is_empty():
        buf.write(chunk)!
        chunk = reader.read_bytes(size)!
    return buf.take_bytes()

fn write_all_buffered_bytes_writer(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    mut total := 0
    mut remaining := data
    while not remaining.is_empty():
        wrote := writer.write_bytes(remaining)!
        if wrote <= 0:
            fail "write returned 0"
        total = total + wrote
        remaining = bytes_after_write(remaining, wrote)
    return total

fn buffered_bytes_reader_read_internal(reader: BufferedBytesReader, max_bytes: Int) -> Bytes!:
    if max_bytes <= 0:
        return bytes.empty()
    if not buffered_bytes_reader_source_handles.contains_key(reader.handle):
        return bytes.empty()

    buf := bytes.buffer_with_capacity(max_bytes)
    while buf.len() < max_bytes:
        mut cached := buffered_bytes_reader_cache_get(reader.handle)
        if cached.is_empty():
            filled := buffered_bytes_reader_fill(reader.handle)!
            if filled <= 0:
                return buf.take_bytes()
            cached = buffered_bytes_reader_cache_get(reader.handle)
        mut take := max_bytes - buf.len()
        if take > cached.len():
            take = cached.len()
        buf.write(cached.slice(0, take))!
        buffered_bytes_reader_consume(reader.handle, take)
    return buf.take_bytes()

fn buffered_bytes_reader_read_until_internal(reader: BufferedBytesReader, sep: Bytes) -> Bytes!:
    return buffered_bytes_reader_read_until_with_sep_internal(reader, sep, false, 0)

fn buffered_bytes_reader_read_until_including_internal(reader: BufferedBytesReader, sep: Bytes) -> Bytes!:
    return buffered_bytes_reader_read_until_with_sep_internal(reader, sep, true, 0)

# `cap` bounds the bytes accumulated before the separator is found: a
# positive value fails a peer that floods without ever sending it, 0 or
# less leaves the read unbounded (what the two wrappers above pass).
fn buffered_bytes_reader_read_until_with_sep_internal(reader: BufferedBytesReader, sep: Bytes, include_sep: Bool, cap: Int) -> Bytes!:
    if sep.is_empty():
        fail "empty separator"
    if not buffered_bytes_reader_source_handles.contains_key(reader.handle):
        return bytes.empty()

    buf := bytes.buffer()
    while true:
        if cap > 0 and buf.len() > cap:
            fail "read_until exceeded {cap} bytes without the separator"
        mut cached := buffered_bytes_reader_cache_get(reader.handle)
        sep_pos := find_bytes_sep(cached, sep)
        if sep_pos >= 0:
            if sep_pos > 0:
                buf.write(cached.slice(0, sep_pos))!
            if include_sep:
                buf.write(sep)!
            buffered_bytes_reader_consume(reader.handle, sep_pos + sep.len())
            return buf.take_bytes()
        keep := sep.len() - 1
        if cached.len() > keep:
            flush_len := cached.len() - keep
            buf.write(cached.slice(0, flush_len))!
            buffered_bytes_reader_consume(reader.handle, flush_len)
        filled := buffered_bytes_reader_fill(reader.handle)!
        if filled <= 0:
            cached = buffered_bytes_reader_cache.take(reader.handle)
            if not cached.is_empty():
                buf.write(cached)!
            buffered_bytes_reader_cache.insert(reader.handle, bytes.empty())
            return buf.take_bytes()
    return buf.take_bytes()

fn buffered_bytes_reader_fill(handle: Int) -> Int!:
    if not buffered_bytes_reader_source_handles.contains_key(handle):
        return 0

    source_kind := buffered_bytes_reader_source_kinds[handle]
    source_handle := buffered_bytes_reader_source_handles[handle]
    mut chunk_size := DEFAULT_CHUNK_SIZE
    if buffered_bytes_reader_chunk_sizes.contains_key(handle):
        chunk_size = buffered_bytes_reader_chunk_sizes[handle]

    mut chunk := bytes.empty()
    if source_kind == BUFFERED_BYTES_SOURCE_CURSOR:
        chunk = bytes_cursor_read(BytesCursor(source_handle), chunk_size)!
    elif source_kind == BUFFERED_BYTES_SOURCE_TCP:
        chunk = tcp_stream_read_bytes(TcpStream(source_handle), chunk_size)!
    elif source_kind == BUFFERED_BYTES_SOURCE_FILE:
        chunk = file_stream_read_bytes(FileStream(source_handle), chunk_size)!
    elif source_kind == BUFFERED_BYTES_SOURCE_PROCESS_STDOUT:
        chunk = process_stdout_read_bytes(ProcessStdout(source_handle), chunk_size)!
    elif source_kind == BUFFERED_BYTES_SOURCE_PROCESS_STDERR:
        chunk = process_stderr_read_bytes(ProcessStderr(source_handle), chunk_size)!
    io_registry_mu.lock()
    cached := buffered_bytes_reader_cache.take(handle)
    buffered_bytes_reader_cache.insert(handle, cached.concat(chunk))
    io_registry_mu.unlock()
    return chunk.len()

fn buffered_bytes_writer_write_internal(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    if not buffered_bytes_writer_target_handles.contains_key(writer.handle):
        return 0

    io_registry_mu.lock()
    cached := buffered_bytes_writer_cache.take(writer.handle)
    buffered_bytes_writer_cache.insert(writer.handle, cached.concat(data))
    io_registry_mu.unlock()
    if buffered_bytes_writer_should_flush(writer.handle):
        buffered_bytes_writer_flush_internal(writer)!
    return data.len()

fn buffered_bytes_writer_flush_internal(writer: BufferedBytesWriter) -> Int!:
    if not buffered_bytes_writer_target_handles.contains_key(writer.handle):
        return 0

    io_registry_mu.lock()
    cached := buffered_bytes_writer_cache.take(writer.handle)
    if cached.is_empty():
        buffered_bytes_writer_cache.insert(writer.handle, cached)
        io_registry_mu.unlock()
        return 0

    target_kind := buffered_bytes_writer_target_kinds[writer.handle]
    target_handle := buffered_bytes_writer_target_handles[writer.handle]
    # the target write below must not run under the registry lock: a
    # blocked socket would stall every other stream's registry access
    io_registry_mu.unlock()
    mut wrote := 0
    if target_kind == BUFFERED_BYTES_TARGET_BUFFER:
        wrote = write_all_byte_buffer(ByteBuffer(target_handle), cached)!
    elif target_kind == BUFFERED_BYTES_TARGET_TCP:
        wrote = write_all_tcp_stream_bytes(TcpStream(target_handle), cached)!
    elif target_kind == BUFFERED_BYTES_TARGET_FILE:
        wrote = write_all_file_stream_bytes(FileStream(target_handle), cached)!
    elif target_kind == BUFFERED_BYTES_TARGET_PROCESS_STDIN:
        wrote = write_all_process_stdin_bytes(ProcessStdin(target_handle), cached)!
    io_registry_mu.lock()
    buffered_bytes_writer_cache.insert(writer.handle, bytes.empty())
    io_registry_mu.unlock()
    return wrote

# ---------------------------------------------------------------------------
# buffered text readers
#
# one implementation of read, read_line and read_until serves every text
# source. the five sources differed in nothing but which function `fill` called,
# so they are told apart by a kind tag rather than by five copies of the code.
#
# two things keep the cost linear in the bytes read. the result is collected as
# a list of pieces and joined once, because appending to a String rebuilds the
# whole String each time. and the buffer carries a read cursor, so consuming a
# line out of it moves an integer instead of re-slicing the bytes behind it —
# without that, reading a 4 KiB buffer one byte at a time copies it 4096 times.

# concatenate what a read gathered.
#
# a read that came out of the buffer in one piece is the common case, and it
# gets its own answer back rather than a copy of it.
fn join_parts(parts: List[String]) -> String:
    if parts.len() == 0:
        return ""
    if parts.len() == 1:
        return parts[0]
    return parts.join("")

fn buffered_text_reader_live(handle: Int) -> Bool:
    return buffered_text_reader_sources.contains_key(handle)

fn buffered_text_reader_data(handle: Int) -> String:
    if buffered_text_reader_cache.contains_key(handle):
        return buffered_text_reader_cache[handle]
    return ""

fn buffered_text_reader_cursor(handle: Int) -> Int:
    if buffered_text_reader_cursors.contains_key(handle):
        return buffered_text_reader_cursors[handle]
    return 0

fn buffered_text_reader_chunk_size(handle: Int) -> Int:
    if buffered_text_reader_chunk_sizes.contains_key(handle):
        return buffered_text_reader_chunk_sizes[handle]
    return DEFAULT_CHUNK_SIZE

fn buffered_text_reader_clear(handle: Int):
    buffered_text_reader_cache.insert(handle, "")
    buffered_text_reader_cursors.insert(handle, 0)

# add a freshly read chunk, dropping whatever the cursor has already passed.
#
# this is the only place the buffer is rebuilt, and what sits in front of the
# cursor here is bounded: a read leaves nothing behind, and a read_until holds
# back at most one byte less than its separator. so the copy is bounded by the
# chunk size, not by how much has been read through the reader over its life.
fn buffered_text_reader_append(handle: Int, chunk: String):
    cursor := buffered_text_reader_cursor(handle)
    data := buffered_text_reader_data(handle)
    if cursor >= data.len():
        buffered_text_reader_cache.insert(handle, chunk)
    else:
        buffered_text_reader_cache.insert(handle, data.substring(cursor, data.len()) + chunk)
    buffered_text_reader_cursors.insert(handle, 0)

fn buffered_text_reader_partial(handle: Int) -> Bytes:
    if buffered_text_reader_partials.contains_key(handle):
        return buffered_text_reader_partials[handle]
    return bytes.empty()

# how many bytes the character starting with `lead` occupies.
fn character_width(lead: Int) -> Int:
    if lead >= 240:
        return 4
    if lead >= 224:
        return 3
    return 2

# the length of the longest prefix of `data` that ends on a character boundary
# with no truncated character behind it.
#
# only the last three bytes can be in question: a utf-8 character is four bytes
# at most, so the start of the last character is never further back than that.
# malformed input is left alone and reported by the decode, which is the one
# place that can tell the difference between a chunk that is short and a stream
# that is not text.
fn complete_character_prefix(data: Bytes) -> Int:
    if data.is_empty():
        return 0
    mut lead := data.len() - 1
    mut steps := 0
    while lead > 0 and steps < 3 and continues_a_character(bytes.get(data, lead)):
        lead = lead - 1
        steps = steps + 1
    first := bytes.get(data, lead)
    if first < 192:
        return data.len()
    if data.len() - lead >= character_width(first):
        return data.len()
    return lead

# true when a byte continues a character rather than starting one.
fn continues_a_character(code: Int) -> Bool:
    return code >= 128 and code < 192

# decode as much of `arrived` as ends on a character boundary, holding the rest
# back for the next fill.
#
# a source read stops at a byte count, so the last character in a chunk can be
# missing its tail. decoding the chunk as it stands would call that a decode
# error and lose the whole read, which is what a buffered reader over a utf-8
# file used to do whenever an accented character straddled a 4 KiB boundary.
fn buffered_text_decode(handle: Int, arrived: Bytes) -> String!:
    held := buffered_text_reader_partial(handle)
    mut data := arrived
    if not held.is_empty():
        data = bytes.concat(held, arrived)
    cut := complete_character_prefix(data)
    if cut >= data.len():
        buffered_text_reader_partials.insert(handle, bytes.empty())
        return data.to_string_utf8()!
    buffered_text_reader_partials.insert(handle, data.slice(cut, data.len()))
    return data.slice(0, cut).to_string_utf8()!

fn buffered_text_fill(handle: Int) -> Int!:
    if not buffered_text_reader_live(handle):
        return 0
    kind := buffered_text_reader_kinds[handle]
    source := buffered_text_reader_sources[handle]
    size := buffered_text_reader_chunk_size(handle)
    # a read whose bytes were all the front of one character adds no text, and
    # an empty fill is how every caller here recognises end of stream — so keep
    # reading until there is a whole character to hand over, or the stream ends.
    while true:
        arrived := text_source_read_bytes(kind, source, size)!
        if arrived.is_empty():
            if not buffered_text_reader_partial(handle).is_empty():
                fail "stream ended in the middle of a character"
            return 0
        chunk := buffered_text_decode(handle, arrived)!
        if chunk.len() > 0:
            buffered_text_reader_append(handle, chunk)
            return chunk.len()
    return 0

# the deadline-aware twin of `buffered_text_fill`. this is the only place a
# context reaches, and it has to: waiting for a chunk is the one part of a
# buffered read that can block, so the deadline is checked around the source
# read rather than around the buffering.
fn buffered_text_fill_ctx(handle: Int, ctx: Context) -> Int!BlockingError:
    if not buffered_text_reader_live(handle):
        return 0
    kind := buffered_text_reader_kinds[handle]
    source := buffered_text_reader_sources[handle]
    size := buffered_text_reader_chunk_size(handle)
    while true:
        arrived := text_source_read_bytes_ctx(kind, source, ctx, size)!
        if arrived.is_empty():
            if not buffered_text_reader_partial(handle).is_empty():
                fail blocking_failed("stream ended in the middle of a character")
            return 0
        chunk := buffered_text_decode(handle, arrived)
        if chunk.is_err:
            fail blocking_failed(chunk.err)
        if chunk.ok.len() > 0:
            buffered_text_reader_append(handle, chunk.ok)
            return chunk.ok.len()
    return 0

fn buffered_text_read_internal(handle: Int, max_bytes: Int) -> String!:
    if max_bytes <= 0:
        return ""
    if not buffered_text_reader_live(handle):
        return ""

    # the buffer already holds what was asked for. this is the case a buffered
    # reader exists for — every read short of a refill lands here — so it takes
    # its slice and moves the cursor, with no accumulator and no source read.
    cursor := buffered_text_reader_cursor(handle)
    data := buffered_text_reader_data(handle)
    if data.len() - cursor >= max_bytes:
        stop := read_stop(data, cursor, cursor + max_bytes)
        buffered_text_reader_cursors.insert(handle, stop)
        return data.substring(cursor, stop)

    parts := empty_string_parts()
    mut got := 0
    while got < max_bytes:
        mut at := buffered_text_reader_cursor(handle)
        mut buf := buffered_text_reader_data(handle)
        if at >= buf.len():
            filled := buffered_text_fill(handle)!
            if filled <= 0:
                return join_parts(parts)
            at = buffered_text_reader_cursor(handle)
            buf = buffered_text_reader_data(handle)
        mut take := max_bytes - got
        avail := buf.len() - at
        if take > avail:
            take = avail
        # what is left to ask for can be less than the next character is long.
        # once something has been read that is simply where the read stops;
        # only a read that has taken nothing at all takes the whole character,
        # since coming back empty is how a caller recognises end of stream.
        mut stop := boundary_at_or_before(buf, at + take, at)
        if stop == at:
            if got > 0:
                return join_parts(parts)
            stop = boundary_at_or_after(buf, at + take)
        parts.push(buf.substring(at, stop))
        buffered_text_reader_cursors.insert(handle, stop)
        got = got + stop - at
    return join_parts(parts)

fn buffered_text_read_internal_ctx(handle: Int, ctx: Context, max_bytes: Int) -> String!BlockingError:
    if max_bytes <= 0:
        return ""
    if not buffered_text_reader_live(handle):
        return ""

    # see `buffered_text_read_internal`: served from the buffer, no source read,
    # so the deadline never comes into it.
    cursor := buffered_text_reader_cursor(handle)
    data := buffered_text_reader_data(handle)
    if data.len() - cursor >= max_bytes:
        stop := read_stop(data, cursor, cursor + max_bytes)
        buffered_text_reader_cursors.insert(handle, stop)
        return data.substring(cursor, stop)

    parts := empty_string_parts()
    mut got := 0
    while got < max_bytes:
        mut at := buffered_text_reader_cursor(handle)
        mut buf := buffered_text_reader_data(handle)
        if at >= buf.len():
            filled := buffered_text_fill_ctx(handle, ctx)!
            if filled <= 0:
                return join_parts(parts)
            at = buffered_text_reader_cursor(handle)
            buf = buffered_text_reader_data(handle)
        mut take := max_bytes - got
        avail := buf.len() - at
        if take > avail:
            take = avail
        # see `buffered_text_read_internal`.
        mut stop := boundary_at_or_before(buf, at + take, at)
        if stop == at:
            if got > 0:
                return join_parts(parts)
            stop = boundary_at_or_after(buf, at + take)
        parts.push(buf.substring(at, stop))
        buffered_text_reader_cursors.insert(handle, stop)
        got = got + stop - at
    return join_parts(parts)

fn buffered_text_read_line_internal(handle: Int) -> String!:
    if not buffered_text_reader_live(handle):
        return ""

    parts := empty_string_parts()
    while true:
        mut cursor := buffered_text_reader_cursor(handle)
        mut data := buffered_text_reader_data(handle)
        if cursor >= data.len():
            filled := buffered_text_fill(handle)!
            if filled <= 0:
                return join_parts(parts)
            cursor = buffered_text_reader_cursor(handle)
            data = buffered_text_reader_data(handle)
        newline := find_newline_from(data, cursor)
        if newline >= 0:
            parts.push(data.substring(cursor, newline))
            buffered_text_reader_cursors.insert(handle, newline + 1)
            return trim_trailing_cr(join_parts(parts))
        parts.push(data.substring(cursor, data.len()))
        buffered_text_reader_clear(handle)

fn buffered_text_read_line_internal_ctx(handle: Int, ctx: Context) -> String!BlockingError:
    if not buffered_text_reader_live(handle):
        return ""

    parts := empty_string_parts()
    while true:
        mut cursor := buffered_text_reader_cursor(handle)
        mut data := buffered_text_reader_data(handle)
        if cursor >= data.len():
            filled := buffered_text_fill_ctx(handle, ctx)!
            if filled <= 0:
                return join_parts(parts)
            cursor = buffered_text_reader_cursor(handle)
            data = buffered_text_reader_data(handle)
        newline := find_newline_from(data, cursor)
        if newline >= 0:
            parts.push(data.substring(cursor, newline))
            buffered_text_reader_cursors.insert(handle, newline + 1)
            return trim_trailing_cr(join_parts(parts))
        parts.push(data.substring(cursor, data.len()))
        buffered_text_reader_clear(handle)

fn buffered_text_read_until_internal(handle: Int, sep: String, include_sep: Bool) -> String!:
    if sep.len() == 0:
        fail "empty separator"
    if not buffered_text_reader_live(handle):
        return ""

    parts := empty_string_parts()
    while true:
        mut cursor := buffered_text_reader_cursor(handle)
        mut data := buffered_text_reader_data(handle)
        mut sep_pos := 0 - 1
        if data.len() > cursor:
            sep_pos = find_sep_from(data, sep, cursor)
        if sep_pos >= 0:
            parts.push(data.substring(cursor, sep_pos))
            if include_sep:
                parts.push(sep)
            buffered_text_reader_cursors.insert(handle, sep_pos + sep.len())
            return join_parts(parts)
        # hold back one byte less than the separator, so a separator split
        # across two reads is still found once the second one lands.
        #
        # the hold-back is a byte count and can leave the flush stopping inside
        # a character, so the flush stops at the boundary before that instead
        # and the few bytes it did not take stay in the buffer. it must not
        # round the other way: the bytes past that point are the ones being held
        # back for the separator.
        keep := sep.len() - 1
        avail := data.len() - cursor
        if avail > keep:
            stop := boundary_at_or_before(data, cursor + avail - keep, cursor)
            if stop > cursor:
                parts.push(data.substring(cursor, stop))
                buffered_text_reader_cursors.insert(handle, stop)
        filled := buffered_text_fill(handle)!
        if filled <= 0:
            cursor = buffered_text_reader_cursor(handle)
            data = buffered_text_reader_data(handle)
            if data.len() > cursor:
                parts.push(data.substring(cursor, data.len()))
                buffered_text_reader_clear(handle)
            return join_parts(parts)
    return join_parts(parts)

fn buffered_text_read_until_internal_ctx(handle: Int, ctx: Context, sep: String, include_sep: Bool) -> String!BlockingError:
    if sep.len() == 0:
        fail blocking_failed("empty separator")
    if not buffered_text_reader_live(handle):
        return ""

    parts := empty_string_parts()
    while true:
        mut cursor := buffered_text_reader_cursor(handle)
        mut data := buffered_text_reader_data(handle)
        mut sep_pos := 0 - 1
        if data.len() > cursor:
            sep_pos = find_sep_from(data, sep, cursor)
        if sep_pos >= 0:
            parts.push(data.substring(cursor, sep_pos))
            if include_sep:
                parts.push(sep)
            buffered_text_reader_cursors.insert(handle, sep_pos + sep.len())
            return join_parts(parts)
        # see `buffered_text_read_until_internal`: the hold-back is a byte count
        # and the flush stops at the boundary before it.
        keep := sep.len() - 1
        avail := data.len() - cursor
        if avail > keep:
            stop := boundary_at_or_before(data, cursor + avail - keep, cursor)
            if stop > cursor:
                parts.push(data.substring(cursor, stop))
                buffered_text_reader_cursors.insert(handle, stop)
        filled := buffered_text_fill_ctx(handle, ctx)!
        if filled <= 0:
            cursor = buffered_text_reader_cursor(handle)
            data = buffered_text_reader_data(handle)
            if data.len() > cursor:
                parts.push(data.substring(cursor, data.len()))
                buffered_text_reader_clear(handle)
            return join_parts(parts)
    return join_parts(parts)

fn buffered_string_reader_read_internal(reader: BufferedStringReader, max_bytes: Int) -> String!:
    return buffered_text_read_internal(reader.handle, max_bytes)

fn buffered_string_reader_read_line_internal(reader: BufferedStringReader) -> String!:
    return buffered_text_read_line_internal(reader.handle)

fn buffered_string_reader_read_until_internal(reader: BufferedStringReader, sep: String) -> String!:
    return buffered_string_reader_read_until_with_sep_internal(reader, sep, false)

fn buffered_string_reader_read_until_including_internal(reader: BufferedStringReader, sep: String) -> String!:
    return buffered_string_reader_read_until_with_sep_internal(reader, sep, true)

fn buffered_string_reader_read_until_with_sep_internal(reader: BufferedStringReader, sep: String, include_sep: Bool) -> String!:
    return buffered_text_read_until_internal(reader.handle, sep, include_sep)

fn buffered_string_writer_write_internal(writer: BufferedStringWriter, data: String) -> Int!:
    if not buffered_string_writer_targets.contains_key(writer.handle):
        return 0

    cached := buffered_string_writer_cache_get(writer.handle)
    buffered_string_writer_cache.insert(writer.handle, cached + data)
    if buffered_string_writer_should_flush(writer.handle):
        buffered_string_writer_flush_internal(writer)!
    return data.len()

fn buffered_string_writer_flush_internal(writer: BufferedStringWriter) -> Int!:
    if not buffered_string_writer_targets.contains_key(writer.handle):
        return 0

    cached := buffered_string_writer_cache_get(writer.handle)
    if cached.len() == 0:
        return 0

    target_handle := buffered_string_writer_targets[writer.handle]
    wrote := write_all_string(StringBuffer(target_handle), cached)!
    buffered_string_writer_cache.insert(writer.handle, "")
    return wrote

fn buffered_tcp_stream_read_internal(reader: BufferedTcpStream, max_bytes: Int) -> String!:
    return buffered_text_read_internal(reader.handle, max_bytes)

fn buffered_tcp_stream_read_internal_ctx(reader: BufferedTcpStream, ctx: Context, max_bytes: Int) -> String!BlockingError:
    return buffered_text_read_internal_ctx(reader.handle, ctx, max_bytes)

fn buffered_tcp_stream_read_line_internal(reader: BufferedTcpStream) -> String!:
    return buffered_text_read_line_internal(reader.handle)

fn buffered_tcp_stream_read_line_internal_ctx(reader: BufferedTcpStream, ctx: Context) -> String!BlockingError:
    return buffered_text_read_line_internal_ctx(reader.handle, ctx)

fn buffered_tcp_stream_read_until_internal(reader: BufferedTcpStream, sep: String) -> String!:
    return buffered_tcp_stream_read_until_with_sep_internal(reader, sep, false)

fn buffered_tcp_stream_read_until_including_internal(reader: BufferedTcpStream, sep: String) -> String!:
    return buffered_tcp_stream_read_until_with_sep_internal(reader, sep, true)

