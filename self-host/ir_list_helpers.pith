# ir_list_helpers.pith - list method and higher-order list IR helpers

from ir_builder import ir_emit, ir_reg, ir_label
from ir_metadata import ir_runtime_call_name
from ir_optionals import ir_emit_value_eq_for_tid

fn ir_emit_call_text_raw(result_reg: Int, fname: String, ret_kind: String, arg_count: Int, arg_text: String):
    mut call_line := "call " + result_reg.to_string() + " " + ir_runtime_call_name(fname) + " " + ret_kind + " " + arg_count.to_string()
    if arg_text.len() > 0:
        call_line = call_line + arg_text
    ir_emit(call_line)

fn ir_emit_call0_raw(result_reg: Int, fname: String, ret_kind: String):
    ir_emit_call_text_raw(result_reg, fname, ret_kind, 0, "")

fn ir_emit_call1_raw(result_reg: Int, fname: String, ret_kind: String, arg0: Int):
    ir_emit_call_text_raw(result_reg, fname, ret_kind, 1, " " + arg0.to_string())

fn ir_emit_call2_raw(result_reg: Int, fname: String, ret_kind: String, arg0: Int, arg1: Int):
    ir_emit_call_text_raw(result_reg, fname, ret_kind, 2, " " + arg0.to_string() + " " + arg1.to_string())

fn ir_emit_list_loop_step(idx_name: String, i_r: Int, loop_l: String):
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    next_i_r := ir_reg()
    ir_emit("add " + next_i_r.to_string() + " " + i_r.to_string() + " " + one_r.to_string())
    ir_emit("store " + idx_name + " " + next_i_r.to_string())
    ir_emit("jmp " + loop_l)

## true for the object types backed by the runtime list: the bare "list",
## "list_string", and the tagged "list:<elem>" forms. this is the gate on
## the self-hosted list methods (is_empty, index_of, contains, map, filter,
## reduce); a receiver type that fails it falls through to the generic
## method path instead.
pub fn ir_is_list_runtime_type(obj_type: String) -> Bool:
    return obj_type == "list" or obj_type == "list_string" or obj_type.starts_with("list:")

## emit the loop behind `xs.map(f)`. `ctor` is the list constructor the
## caller picked from the checked element type: a tagged one makes the
## result own its elements, which is what the mapper's fresh results need
## since nothing else keeps them alive.
pub fn ir_emit_list_map_loop(list_r: Int, ctor: String, mapper_name: String, result_kind: String, elem_kind: String, mapped_kind: String, idx_name: String) -> Int:
    result_r := ir_reg()
    ir_emit_call0_raw(result_r, ctor, result_kind)
    len_r := ir_reg()
    ir_emit_call1_raw(len_r, "pith_list_len", "int", list_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    done_l := ir_label()
    ir_emit("label " + loop_l)
    i_r := ir_reg()
    ir_emit("load " + i_r.to_string() + " " + idx_name)
    keep_loop_r := ir_reg()
    ir_emit("lt " + keep_loop_r.to_string() + " " + i_r.to_string() + " " + len_r.to_string())
    ir_emit("brif " + keep_loop_r.to_string() + " " + body_l + " " + done_l)
    ir_emit("label " + body_l)
    item_r := ir_reg()
    ir_emit_call2_raw(item_r, "__list_get", elem_kind, list_r, i_r)
    mapped_r := ir_reg()
    ir_emit_call_text_raw(mapped_r, mapper_name, mapped_kind, 1, " " + item_r.to_string())
    # the mapper hands back a value it owns and the loop stops tracking it
    # here, so the push takes that count rather than adding a second one an
    # empty-handed loop would never release. an untagged result list has no
    # count to take and the transfer is a no-op, as it was before.
    ir_emit_call2_raw(ir_reg(), "pith_list_push_value_owned", "void", result_r, mapped_r)
    ir_emit_list_loop_step(idx_name, i_r, loop_l)
    ir_emit("label " + done_l)
    return result_r

## emit the loop behind `xs.filter(keep)`. unlike `map`, the elements are
## the source list's own, so the plain retaining push is what the result
## needs: it takes a count of its own and can outlive the list it came from.
pub fn ir_emit_list_filter_loop(list_r: Int, ctor: String, keep_name: String, result_kind: String, elem_kind: String, idx_name: String) -> Int:
    result_r := ir_reg()
    ir_emit_call0_raw(result_r, ctor, result_kind)
    len_r := ir_reg()
    ir_emit_call1_raw(len_r, "pith_list_len", "int", list_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    push_l := ir_label()
    step_l := ir_label()
    done_l := ir_label()
    ir_emit("label " + loop_l)
    i_r := ir_reg()
    ir_emit("load " + i_r.to_string() + " " + idx_name)
    keep_loop_r := ir_reg()
    ir_emit("lt " + keep_loop_r.to_string() + " " + i_r.to_string() + " " + len_r.to_string())
    ir_emit("brif " + keep_loop_r.to_string() + " " + body_l + " " + done_l)
    ir_emit("label " + body_l)
    item_r := ir_reg()
    ir_emit_call2_raw(item_r, "__list_get", elem_kind, list_r, i_r)
    pred_r := ir_reg()
    ir_emit_call_text_raw(pred_r, keep_name, "int", 1, " " + item_r.to_string())
    ir_emit("brif " + pred_r.to_string() + " " + push_l + " " + step_l)
    ir_emit("label " + push_l)
    ir_emit_call2_raw(ir_reg(), "__list_push", "void", result_r, item_r)
    ir_emit("label " + step_l)
    ir_emit_list_loop_step(idx_name, i_r, loop_l)
    ir_emit("label " + done_l)
    return result_r

## emit the loop behind `xs.reduce(init, f)`. the caller stores the seed
## into acc_name and the reducer into reducer_name before calling; this
## walks the list front to back, replacing the accumulator each step, and
## returns a register holding the final load of acc_name. unlike map and
## filter it builds no container, so no ownership question arises here —
## whatever the reducer returns simply becomes the next accumulator.
pub fn ir_emit_list_reduce_loop(list_r: Int, reducer_name: String, acc_name: String, elem_kind: String, result_kind: String, idx_name: String) -> Int:
    len_r := ir_reg()
    ir_emit_call1_raw(len_r, "pith_list_len", "int", list_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    done_l := ir_label()
    ir_emit("label " + loop_l)
    i_r := ir_reg()
    ir_emit("load " + i_r.to_string() + " " + idx_name)
    keep_loop_r := ir_reg()
    ir_emit("lt " + keep_loop_r.to_string() + " " + i_r.to_string() + " " + len_r.to_string())
    ir_emit("brif " + keep_loop_r.to_string() + " " + body_l + " " + done_l)
    ir_emit("label " + body_l)
    item_r := ir_reg()
    ir_emit_call2_raw(item_r, "__list_get", elem_kind, list_r, i_r)
    acc_r := ir_reg()
    ir_emit("load " + acc_r.to_string() + " " + acc_name)
    next_acc_r := ir_reg()
    ir_emit_call_text_raw(next_acc_r, reducer_name, result_kind, 2, " " + acc_r.to_string() + " " + item_r.to_string())
    ir_emit("store " + acc_name + " " + next_acc_r.to_string())
    ir_emit_list_loop_step(idx_name, i_r, loop_l)
    ir_emit("label " + done_l)
    out_r := ir_reg()
    ir_emit("load " + out_r.to_string() + " " + acc_name)
    return out_r

## emit `xs.is_empty()` as a length-against-zero compare, returning the
## register holding the boolean. straight-line: no branch, no loop, and no
## element is touched.
pub fn ir_emit_list_is_empty(list_r: Int) -> Int:
    len_r := ir_reg()
    ir_emit_call1_raw(len_r, "pith_list_len", "int", list_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    out_r := ir_reg()
    ir_emit("eq " + out_r.to_string() + " " + len_r.to_string() + " " + zero_r.to_string())
    return out_r

# the register holding "this element equals the search target". with the
# element type in hand the comparison is the one `==` performs on that type,
# so an optional element compares by tag and payload rather than by the
# address of its shell — the shape that used to make `xs.contains(b)` answer
# false for a b equal to an element the list holds. elem_tid is -1 only where
# the checker left the list untyped, and there the old kind-driven pair is
# all there is: a string by content, anything else by raw slot.
fn ir_emit_list_item_eq(elem_kind: String, elem_tid: Int, item_r: Int, target_r: Int) -> Int:
    if elem_tid >= 0:
        return ir_emit_value_eq_for_tid(elem_tid, item_r, target_r)
    out_r := ir_reg()
    if elem_kind == "string":
        ir_emit_call2_raw(out_r, "__str_eq", "bool", item_r, target_r)
        return out_r
    ir_emit("eq " + out_r.to_string() + " " + item_r.to_string() + " " + target_r.to_string())
    return out_r

## emit the -1 that the index-search family uses for "not found". it is both
## the search loop's starting value and the answer for a search call the
## emitter cannot make sense of. callers convert it before it escapes:
## index_of wraps it into an optional and contains compares it against zero,
## so the bare sentinel is never a pith-level value.
pub fn ir_emit_list_missing_index_result() -> Int:
    missing_r := ir_reg()
    ir_emit("iconst " + missing_r.to_string() + " -1")
    return missing_r

## emit the linear scan behind `xs.index_of(v)`: returns a register holding
## the first matching index, or -1 when nothing matches. result_name and
## idx_name must be locals the caller reserved for this loop alone. how the
## match is decided comes from elem_tid: an element compares the way `==`
## compares its type, so a string or a Bytes by content, an optional by tag
## and payload, a boxed enum through its structural helper, and a struct by
## identity, which is the comparison `==` gives a struct too.
pub fn ir_emit_list_index_search_loop(list_r: Int, target_r: Int, elem_kind: String, elem_tid: Int, result_name: String, idx_name: String) -> Int:
    missing_r := ir_emit_list_missing_index_result()
    ir_emit("store " + result_name + " " + missing_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())
    len_r := ir_reg()
    ir_emit_call1_raw(len_r, "pith_list_len", "int", list_r)

    loop_l := ir_label()
    body_l := ir_label()
    match_l := ir_label()
    step_l := ir_label()
    done_l := ir_label()
    ir_emit("label " + loop_l)
    i_r := ir_reg()
    ir_emit("load " + i_r.to_string() + " " + idx_name)
    in_range_r := ir_reg()
    ir_emit("lt " + in_range_r.to_string() + " " + i_r.to_string() + " " + len_r.to_string())
    ir_emit("brif " + in_range_r.to_string() + " " + body_l + " " + done_l)
    ir_emit("label " + body_l)
    item_r := ir_reg()
    ir_emit_call2_raw(item_r, "__list_get", elem_kind, list_r, i_r)
    eq_r := ir_emit_list_item_eq(elem_kind, elem_tid, item_r, target_r)
    ir_emit("brif " + eq_r.to_string() + " " + match_l + " " + step_l)
    ir_emit("label " + match_l)
    ir_emit("store " + result_name + " " + i_r.to_string())
    ir_emit("jmp " + done_l)
    ir_emit("label " + step_l)
    ir_emit_list_loop_step(idx_name, i_r, loop_l)
    ir_emit("label " + done_l)
    out_r := ir_reg()
    ir_emit("load " + out_r.to_string() + " " + result_name)
    return out_r

## turn an index-search result into the boolean `xs.contains(v)` wants: true
## for any index at or above zero, false for the -1 miss. it consumes the
## register ir_emit_list_index_search_loop already produced, so contains
## costs one scan and not two.
pub fn ir_emit_list_contains_from_index(index_r: Int) -> Int:
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    out_r := ir_reg()
    ir_emit("gte " + out_r.to_string() + " " + index_r.to_string() + " " + zero_r.to_string())
    return out_r
