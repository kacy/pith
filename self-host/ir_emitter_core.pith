# --- current function locals ---
mut ir_map_value_types: Map[String, String] := {} # map variable name -> value type

# enums with at least one payload-carrying variant are boxed: a value is a
# heap struct with the tag in slot 0 and payload values in slots 1..n.
# payload-free enums stay plain integer tags.

# checked tid of the innermost match subject, for tuple-pattern element
# types; set by the match emitters before lowering arms
# declared return kinds of closure-typed parameters in the current
# function: `key: fn(T) -> String` records "string" under "key", so a
# call through the parameter infers its result kind even where checked
# types are suppressed (generic bodies)
mut ir_closure_return_kinds: Map[String, String] := {}

# rc-managed locals owned by the current function, in binding order, with a
# parallel kind list (string/list/map/set). collected by a pre-pass before
# the body emits so every name can be zero-stored in the prologue; that
# makes the release loads at each return valid on every path (releasing 0
# is a no-op). lists, not maps, so cleanup order is deterministic and the
# emitted ir stays bootstrap-stable.
mut ir_string_locals: List[String] := []
mut ir_rc_local_kinds: List[String] := []

# tuple locals (a `T!`/`T?` bound to a name) release only their 3-slot shell at
# cleanup by default, which leaks the owned payload at slot 8 (and the error at
# slot 16). these two lists track, per function, the tuple locals whose EVERY use
# is a flag check (`.is_ok`/`.is_err`/`== none`), a borrowing `.ok`/`.err`
# read, a result extraction, or an argument of a same-module call whose body
# provably only reads the parameter — uses that leave the tuple holding the
# count it was built with, so the cleanup path is the payload's only releaser.
# for those the cleanup releases the live payload before freeing the shell. a
# local with any other use (returned, bound, matched, iterated, captured, ...)
# is left out and keeps the shell-only behavior, which may still leak but
# can never double-free. see ir_tuple_use_is_whitelisted.
mut ir_tuple_local_tid: Map[String, Int] := {} # tuple local name -> producing expr's type id
mut ir_tuple_cascade_names: List[String] := [] # tuple locals whose payload is safe to cascade
# the module root emit_ir is currently lowering: the cascade walk reads a
# same-module callee's declaration through it to judge an argument borrow
# (ir_tuple_call_arg_is_borrow). and the (callee, param) pairs that walk is
# already inside, so a recursive call chain answers "not safe" instead of
# looping.
mut ir_tuple_walk_root: Int := 0 - 1
mut ir_tuple_borrow_walk_active: List[String] := []

# --- module globals collected during the prepass ---

# --- type and symbol metadata copied from the checker ---

mut ir_local_struct_names: List[String] := [] # structs declared by this module
mut ir_tracer_memo: Map[String, Int] := {} # 1 needs tracer, 2 no/undecided
mut ir_tuple_dtor_sigs: List[String] := [] # rc-element signatures seen this module
mut ir_tuple_cascade_sigs: List[String] := [] # (ok,err) payload signatures needing a cascade helper

mut ir_func_result_ok_kinds: Map[String, String] := {}
# `threadlocal` module globals: name -> a process-unique slot id, and name ->
# the global's ir retkind (for the init thunk header + access typing). Reads and
# writes of these names route through pith_tls_get_or_init / pith_tls_set instead
# of a shared data slot. Accumulated across modules; slots stay unique.
mut ir_threadlocal_slots: Map[String, Int] := {}
mut ir_threadlocal_kinds: Map[String, String] := {}
mut ir_next_tls_slot := 0
mut ir_named_fn_value_wrappers: Map[String, String] := {}

# --- the two-register result ABI (PITH_RESULT_REG=1) ---
# functions in this registry return (is_ok, payload) in two registers via
# ret2, and their call sites bind the pair with rcall, instead of passing a
# heap-allocated three-slot result box. everything OUTSIDE these paths still
# sees the declared retkind "tuple": a call site that is not consuming the
# pair directly materializes a box from it on the spot, so the box world and
# its ARC rules are untouched — with the flag off, not one instruction moves.
# eligibility (ir_maybe_register_result_reg) is deliberately narrow for the
# measured prototype: non-generic free functions whose ok payload is an Int
# or Bool. the error payload is always a single register (a handle or zero).
mut ir_result_reg_funcs: Map[String, Bool] := {}
mut ir_result_reg_flag := 0 - 1
# the pair handshake: a consumer that can use (flag, payload) directly (the
# `!` emitter) stores its operand node index here before emitting it; the
# call emitter delivers the pair through the three registers below only when
# the call it is lowering IS that node — an argument's nested call never
# matches, so it materializes a box like any other context.
mut ir_rcall_defer_idx := 0 - 1
mut ir_rcall_current_idx := 0 - 1
mut ir_rcall_pair_ready := false
mut ir_rcall_flag_reg := 0
mut ir_rcall_val_reg := 0
mut ir_lambda_count := 0
mut ir_for_count := 0
mut ir_break_stack: List[String] := []
mut ir_continue_stack: List[String] := []

# a `for` loop's variables are scoped to the loop — the checker rejects reading
# one after the loop ends — but the emitter's locals are a single flat namespace
# per function, so `for root in roots` and a later `root := ...` used to land in
# the same slot. the loop stores a *borrowed* element there, so the rebind's
# release-the-old (and the exit cleanup, on an early return) dropped a count the
# loop never took. this map gives each loop variable its own slot for the length
# of the body: source name -> slot name, "" meaning "no loop slot, use the name".
# ir_emit_name_load / ir_emit_name_store consult it, so every read and write the
# body lowers lands in the loop's own slot and can never alias a function local.
mut ir_loop_var_slots: Map[String, String] := {}

# the slot `name` currently resolves to, or "" when no enclosing loop bound it.
fn ir_loop_var_slot(name: String) -> String:
    if ir_loop_var_slots.contains_key(name):
        return ir_loop_var_slots[name]
    return ""

# bind `name` to `slot` for a loop body and hand back the mapping it replaced,
# so a nested loop reusing an outer loop's variable name restores the outer
# slot when it ends. "" is the empty mapping, so there is nothing to erase.
fn ir_loop_var_push(name: String, slot: String) -> String:
    if name.len() == 0:
        return ""
    previous := ir_loop_var_slot(name)
    ir_loop_var_slots.insert(name, slot)
    return previous

fn ir_loop_var_pop(name: String, previous: String):
    if name.len() > 0:
        ir_loop_var_slots.insert(name, previous)

# the storage a loop variable gets. the loop id keeps two loops in one function
# apart, including an inner loop that reuses an outer loop's variable name.
fn ir_loop_var_slot_name(fid: Int, name: String) -> String:
    return "__loopvar_" + fid.to_string() + "_" + name

# defer support (statically emitted, zero runtime machinery). deferred
# statements are re-emitted at every scope-exit edge in LIFO order, before the
# ARC cleanup. ir_defer_nodes is a flat stack of the inner statement node
# indices currently in scope; ir_defer_is_err is a parallel stack marking each
# entry as an `errdefer` (1) or plain `defer` (0) — errdefers are skipped at
# success exits and emitted only at error exits. ir_defer_scope_starts marks
# where each open block scope begins in the flat stack; ir_defer_loop_base_stack
# records the flat-stack length at each loop entry so break/continue emit only
# the defers registered inside the loop. all four reset per function.
mut ir_defer_nodes: List[Int] := []
mut ir_defer_is_err: List[Int] := []
mut ir_defer_scope_starts: List[Int] := []
mut ir_defer_loop_base_stack: List[Int] := []
# open owned loop iterables (a split result, a keys() list). a `for` loop
# releases its iterable at the loop's normal end label, but an early exit
# (`return`, `fail`, `!`) leaves the function without reaching that label, so
# the release is skipped and the iterable leaks. these parallel stacks name the
# iterable local and its rc kind for every loop currently open; the function
# exit edges release them, and each loop pops its own entry once its body ends.
mut ir_loop_iter_vars: List[String] := []
mut ir_loop_iter_kinds: List[String] := []
mut ir_lambda_bodies: List[String] := [] # deferred lambda function IR
mut ir_module_count := 0 # increments per emit_ir call for unique naming

# Per-instantiation specialized impl method names, kept separate from
# ir_impl_methods because that map is reset between modules and would wipe
# specializations registered during an earlier module's emission. Key is
# "InstanceType.method" (e.g. "MapIter[Range,Int,Int].next") and value is the
# specialized symbol name. Read via ir_lookup_specialized_method.

mut ir_current_func_optional_inner_kind := ""

# True while emitting the body of a function that returns a Result (T! or
# T!E). Used by the index expression codegen to decide whether `map[k]` /
# `list[i]` should propagate a fail on miss (T! context) or fall through
# to the loud-miss runtime (non-T! context).
mut ir_current_func_returns_result := false
# the impl block's target type, set while a method body is being emitted, so
# `self.field = ...` knows what struct fields to look up
mut ir_current_impl_type := ""
# When a specialized impl method body is being emitted these hold the struct's
# generic param names and the concrete type names for this instantiation, so
# `self.field` references whose declared type is a struct param (`I`, `T`, `U`)
# resolve to the right concrete type for dispatch (e.g., `Range` not `I`).
mut ir_current_impl_subst_params: List[String] := []
mut ir_current_impl_subst_args: List[String] := []
# per-instance destructors needed for generic structs built via the backend
# constructor call (`Name[params](...)` inside a generic function). keyed by the
# sanitized instance symbol: one map holds the base struct name, the other the
# instance's concrete type-arg names (joined by chr(1), which never appears in a
# type name) so the destructor body can substitute them into each field type.
mut ir_generic_dtor_base: Map[String, String] := {}
mut ir_generic_dtor_args: Map[String, String] := {}
mut ir_preloaded_import_roots: List[Int] := []
mut ir_preloaded_import_paths: List[String] := []
# every module in the build, not just the emitted module's direct imports.
# a method can live in an impl block a module away from both the struct's
# declaration and the call site (std.io's impl FileStream, called on the
# stream std.fs returned), so impl-method collection must see the whole
# graph or the call lowers to a name no function carries.
mut ir_all_module_roots: List[Int] := []
mut ir_all_module_paths: List[String] := []
# the resolved module path of the module currently being emitted ("" for the
# entry file). lets an impl target in this module resolve to the module's own
# declaration even when another module registered the same name globally.
mut ir_current_module_path := ""
mut ir_emit_tests := false
mut ir_emitting_test_func := false

pub fn set_import_roots(roots: List[Int], paths: List[String]):
    ir_preloaded_import_roots = roots
    ir_preloaded_import_paths = paths

pub fn set_all_module_roots(roots: List[Int], paths: List[String]):
    ir_all_module_roots = roots
    ir_all_module_paths = paths

pub fn set_current_module_path(path: String):
    ir_current_module_path = path

pub fn set_test_mode(enabled: Bool):
    ir_emit_tests = enabled

fn ir_reset_local_state():
    ir_builder_reset()
    ir_builder_set_string_module_count(ir_module_count)
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()
    ir_map_value_types = {}

fn ir_reset_global_state():
    ir_global_int_names = []
    ir_global_string_names = []
    ir_global_list_string_names = []
    ir_global_list_names = []
    ir_global_map_names = []
    ir_global_map_int_names = []
    ir_global_map_value_types = {}
    ir_global_set_names = []
    ir_global_set_int_names = []
    ir_global_bool_names = []

fn ir_reset_type_state():
    ir_local_struct_names = []
    ir_reset_dtor_memo()
    ir_tracer_memo = {}
    ir_tuple_dtor_sigs = []
    ir_tuple_cascade_sigs = []
    ir_struct_names.clear()
    ir_struct_field_lookup.clear()
    ir_struct_field_index_lookup.clear()
    ir_struct_decl_nodes.clear()
    ir_struct_field_default_nodes.clear()
    ir_impl_methods.clear()
    ir_impl_method_owner.clear()
    ir_import_renames = {}
    ir_func_returns.clear()
    ir_func_result_ok_kinds = {}
    ir_result_reg_funcs = {}
    ir_rcall_defer_idx = 0 - 1
    ir_rcall_current_idx = 0 - 1
    ir_rcall_pair_ready = false
    ir_named_fn_value_wrappers = {}
    ir_module_aliases = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    ir_current_func_return_kind = ""
    ir_current_func_optional_inner_kind = ""
    ir_current_func_returns_result = false
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}
    ir_generic_specialization_keys = []
    ir_generic_specialization_names = {}
    ir_generic_specialization_type_lists = {}
    ir_generic_emitted_specializations = {}
    ir_active_generic_params = []
    ir_active_generic_concrete_types = []
    ir_active_generic_module_path = ""

fn ir_reset_control_flow_state():
    ir_break_stack = []
    ir_continue_stack = []

pub fn ir_reset():
    ir_reset_local_state()
    ir_reset_global_state()
    ir_reset_type_state()
    ir_reset_control_flow_state()

fn ir_lookup_map_value_type(name: String) -> String:
    if ir_map_value_types.contains_key(name):
        return ir_map_value_types[name]
    return ""

fn ir_lookup_map_value_type_for_expr(idx: Int) -> String:
    return ir_lookup_map_value_type_for_expr_with_state(idx, ir_map_value_types)

# the ir return kind of a struct's fn-value field (e.g. `make: fn() -> T!`),
# or "" when the field isn't a fn_type. a `self.make()` call is a closure-field
# call, not a method, so this lets its result kind be reported correctly — a
# Result-returning factory forwards its result instead of being re-wrapped.
fn ir_struct_fn_field_return_kind(struct_name: String, field_name: String) -> String:
    if not ir_struct_decl_nodes.contains_key(struct_name):
        return ""
    decl := get_node(ir_struct_decl_nodes[struct_name])
    for child in decl.children:
        field_node := ir_unwrap_pub_node(child)
        if field_node.kind == "field" and ir_struct_field_name(field_node) == field_name:
            if field_node.children.len() > 0:
                tn := get_node(field_node.children[0])
                if tn.kind == "fn_type" and tn.children.len() > 0:
                    last := get_node(tn.children[tn.children.len() - 1])
                    if last.kind == "returns" and last.children.len() > 0:
                        return ir_resolve_type_node(last.children[0])
    return ""

fn ir_expr_result_kind(idx: Int) -> String:
    # prefer the kind the checker already recorded; otherwise recover it from
    # the callee. calls and method calls each resolve their callee differently,
    # so they get a helper apiece; anything else falls back to legacy inference.
    checked_kind := ir_checked_result_kind(idx)
    if checked_kind.len() > 0:
        return checked_kind
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        return ir_call_result_kind(idx, node)
    if node.kind == "method_call":
        return ir_method_call_result_kind(idx, node)
    return ir_expr_legacy_result_kind(idx)

# The ir result kind (how a Result is carried in the abi) of a plain call.
# A call through a fn-value local forwards that local's recorded closure return
# kind; a generic callee is specialized first; then the callee's declared kind
# wins over the builtin table, with legacy inference as the fallback.
fn ir_call_result_kind(idx: Int, node: Node) -> String:
    # a call through a fn-value local (`f()` where `f := self.make`) carries
    # its recorded closure return kind, so a `fn() -> T!` factory forwards
    # its Result rather than getting re-wrapped.
    fn_local := get_node(node.children[0])
    if fn_local.kind == "ident" and ir_closure_return_kinds.contains_key(fn_local.value):
        return ir_closure_return_kinds[fn_local.value]
    mut callee := ir_resolve_static_callee(node.children[0])
    if callee.name.len() > 0:
        if ir_is_generic_function_name(callee.name):
            mut explicit_generic_types: List[String] := []
            callee_node := get_node(node.children[0])
            if callee_node.kind == "index":
                explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
            mut concrete_types := explicit_generic_types
            if concrete_types.len() == 0:
                concrete_types = ir_infer_generic_concrete_types(callee.name, node)
            mut generic_ret_type := ir_checked_type(idx)
            if generic_ret_type.len() == 0:
                generic_ret_type = ir_infer_type(idx)
            ir_record_generic_spec_arg_tids(callee.name, concrete_types, ir_generic_arg_tids(node))
            callee = ResolvedCallee(ir_queue_generic_specialization(callee.name, concrete_types, generic_ret_type), false)
        declared_kind := ir_declared_callable_ir_retkind(callee.name)
        if declared_kind.len() > 0:
            return declared_kind
        builtin_kind := ir_builtin_result_retkind(callee.name)
        if builtin_kind.len() > 0:
            return builtin_kind
    return ir_expr_legacy_result_kind(idx)

# The ir result kind of a method call. A module-qualified call (`mod.fn(...)`)
# resolves like a static call; otherwise dispatch to the impl method, then to a
# `self.make()` closure field inside a generic impl, then the builtin table,
# with legacy inference as the fallback.
fn ir_method_call_result_kind(idx: Int, node: Node) -> String:
    mut call_name := ir_resolve_module_alias_method_call_name(idx)
    if call_name.len() > 0:
        if ir_is_generic_function_name(call_name):
            mut generic_ret_type := ir_checked_type(idx)
            if generic_ret_type.len() == 0:
                generic_ret_type = ir_infer_type(idx)
            call_name = ir_queue_generic_specialization(call_name, ir_infer_generic_concrete_types(call_name, node), generic_ret_type)
        declared_kind := ir_declared_callable_ir_retkind(call_name)
        if declared_kind.len() > 0:
            return declared_kind
        builtin_kind := ir_builtin_result_retkind(call_name)
        if builtin_kind.len() > 0:
            return builtin_kind
        return ir_expr_legacy_result_kind(idx)
    obj_type := ir_method_receiver_type(node)
    method_name := ir_plain_method_name(node.value)
    impl_name := ir_lookup_impl_method_for(node.children[0], obj_type, method_name)
    if impl_name.len() > 0:
        declared_kind := ir_declared_callable_ir_retkind(impl_name)
        if declared_kind.len() > 0:
            return declared_kind
    # `self.make()` inside a generic impl where `make` is a closure field:
    # no method of that name, so the result kind is the field's declared
    # fn_type return kind. without this a `fn() -> T!` factory reads back as
    # "unknown" and its Result gets wrapped in a second Result.
    if impl_name.len() == 0 and ir_current_impl_type.len() > 0:
        recv_node := get_node(node.children[0])
        if recv_node.kind == "self":
            field_kind := ir_struct_fn_field_return_kind(ir_strip_type_args(ir_current_impl_type), method_name)
            if field_kind.len() > 0:
                return field_kind
    emit_name := ir_method_emit_name(method_name, obj_type)
    declared_kind := ir_declared_callable_ir_retkind(emit_name)
    if declared_kind.len() > 0:
        return declared_kind
    builtin_kind := ir_builtin_result_retkind(emit_name)
    if builtin_kind.len() > 0:
        return builtin_kind
    return ir_expr_legacy_result_kind(idx)

fn ir_generic_result_ok_kind(name: String, concrete_types: List[String]) -> String:
    if not ir_generic_decl_indices.contains_key(name):
        return ""
    decl_idx := ir_generic_decl_indices[name]
    decl_node := get_node(decl_idx)
    generic_params := ir_collect_generic_param_names(decl_node)
    for child in decl_node.children:
        returns_node := get_node(child)
        if returns_node.kind != "returns":
            continue
        for type_idx in returns_node.children:
            type_node := get_node(type_idx)
            if type_node.kind == "result" or type_node.kind == "result_type":
                if type_node.children.len() > 0:
                    return ir_retkind(ir_resolve_type_node_with_subst(type_node.children[0], generic_params, concrete_types))
    return ""

fn ir_result_ok_kind_for_expr(idx: Int) -> String:
    tid := c_get_expr_type(idx)
    if tid >= 0:
        field_kind := ir_result_field_kind(tid, "ok")
        if field_kind != "unknown":
            return field_kind
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        mut callee := ir_resolve_static_callee(node.children[0])
        if callee.name.len() == 0:
            return ""
        if ir_is_generic_function_name(callee.name):
            mut explicit_generic_types: List[String] := []
            callee_node := get_node(node.children[0])
            if callee_node.kind == "index":
                explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
            mut concrete_types := explicit_generic_types
            if concrete_types.len() == 0:
                concrete_types = ir_infer_generic_concrete_types(callee.name, node)
            result_ok_kind := ir_generic_result_ok_kind(callee.name, concrete_types)
            if result_ok_kind.len() > 0:
                return result_ok_kind
        if ir_func_result_ok_kinds.contains_key(callee.name):
            return ir_retkind(ir_func_result_ok_kinds[callee.name])
        return ir_builtin_result_ok_kind(callee.name)
    if node.kind == "method_call":
        call_name := ir_resolve_module_alias_method_call_name(idx)
        if call_name.len() > 0:
            if ir_func_result_ok_kinds.contains_key(call_name):
                return ir_retkind(ir_func_result_ok_kinds[call_name])
            return ir_builtin_result_ok_kind(call_name)
        obj_type := ir_method_receiver_type(node)
        method_name := ir_plain_method_name(node.value)
        impl_name := ir_lookup_impl_method_for(node.children[0], obj_type, method_name)
        if impl_name.len() > 0 and ir_func_result_ok_kinds.contains_key(impl_name):
            return ir_retkind(ir_func_result_ok_kinds[impl_name])
        emit_name := ir_method_emit_name(method_name, obj_type)
        if ir_func_result_ok_kinds.contains_key(emit_name):
            return ir_retkind(ir_func_result_ok_kinds[emit_name])
        return ir_builtin_result_ok_kind(emit_name)
    return ""

fn ir_emit_result_ok_field_for_expr(obj_r: Int, expr_idx: Int) -> Int:
    mut field_kind := ir_result_ok_kind_for_expr(expr_idx)
    if field_kind.len() == 0:
        field_kind = "unknown"
    r := ir_reg()
    ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 8 " + field_kind + " ok")
    return r

fn ir_find_free_vars(idx: Int, bound: List[String]) -> List[String]:
    # ir_var_regs holds the enclosing scope's live variables, so a captured name
    # that shadows a same-named global is recognized as a real local.
    return ir_capture_find_free_vars(idx, bound, ir_capture_blocked_names(), ir_var_regs)

# --- collect strings (iterative to avoid deep recursion crashes) ---
fn ir_collect_strings(idx: Int):
    nodes := ir_cached_string_nodes(idx)
    for node_idx in nodes:
        ir_str(get_node(node_idx).value)

fn ir_struct_field_name(field_node: Node) -> String:
    mut field_name := field_node.value
    if field_name.contains(" "):
        field_name = field_name.split(" ")[0]
    return field_name

# a `weak` field holds its optional target without keeping it alive, so a
# parent<->child ring reclaims instead of leaking. the parser stashes the
# modifier in the field node's value ("parent weak"), which is where the
# checker's E249 validation reads it from too.
fn ir_struct_field_is_weak(struct_name: String, field_name: String) -> Bool:
    layout_name := ir_struct_layout_name_with_state(struct_name, ir_struct_names)
    if not ir_struct_decl_nodes.contains_key(layout_name):
        return false
    decl := get_node(ir_struct_decl_nodes[layout_name])
    for child in decl.children:
        field_node := ir_unwrap_pub_node(child)
        if field_node.kind != "field":
            continue
        if ir_struct_field_name(field_node) == field_name:
            return field_node.value.contains(" weak")
    return false

# lower a weak field's incoming value to the bare target pointer it should
# store, taking a weak reference in the process. `none` collapses to 0; an
# already-optional value is unwrapped to its payload (0 when none); a bare
# struct value is the target directly. pith_struct_weak_retain(0) is a no-op,
# so the null cases need no branch. the returned pointer is what the field
# slot holds — no owning tuple, which is what keeps the ring from cycling.
fn ir_emit_weak_payload(val_idx: Int) -> Int:
    vnode := get_node(val_idx)
    if vnode.kind == "none_lit" or vnode.kind == "none":
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        return zero_r
    val_r := ir_expr(val_idx)
    mut payload_r := val_r
    if ir_rc_kind(ir_infer_type(val_idx)) == "tuple":
        # already an optional tuple: the payload sits at offset 8 (0 when none)
        payload_r = ir_reg()
        ir_emit("field " + payload_r.to_string() + " " + val_r.to_string() + " 8 unknown value")
    retain_r := ir_reg()
    ir_emit("call " + retain_r.to_string() + " pith_struct_weak_retain void 1 " + payload_r.to_string())
    return payload_r

fn ir_collect_struct_field_strings(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        actual := ir_unwrap_pub_node(item_idx)
        if actual.kind == "struct_decl" or actual.kind == "struct":
            # the string table is emitted before function bodies, so the
            # labels the synthesized struct display uses must be interned
            # here, not when the display code emits.
            ir_str(actual.value + "(")
            ir_str(")")
            ir_str("...")
            # the single-pass json decoder references a packed field spec;
            # intern it here so the strref resolves. built by the same
            # function the decoder uses, so the strings match exactly.
            ir_str(ir_json_decode_spec_from_decl(actual))
            mut first := true
            for child in actual.children:
                field_node := get_node(child)
                if field_node.kind == "field":
                    fname := ir_struct_field_name(field_node)
                    ir_str(fname)
                    if first:
                        ir_str(fname + ": ")
                        first = false
                    else:
                        ir_str(", " + fname + ": ")

fn ir_is_sync_primitive_name(name: String) -> Bool:
    return name == "Mutex" or name == "WaitGroup" or name == "Semaphore" or name == "AtomicInt"

fn ir_emit_func_header(name: String, param_count: Int, ret_type: String):
    ir_emit("func " + name + " " + param_count.to_string() + " " + ir_retkind(ret_type))

# kinds a cycle tracer reports: children that can themselves hold
# references. a string or bytes value is a leaf — it never points back —
# and a weak field holds no strong count, so none of those are visited.
fn ir_trace_kind_enabled(kind: String) -> Bool:
    return kind == "struct" or kind == "list" or kind == "map" or kind == "set" or kind == "closure" or kind == "tuple"

# true when any variant of a boxed enum carries a traceable payload, so
# the enum's destructor gets a tracer twin. mirrors ir_enum_needs_dtor.
fn ir_enum_needs_tracer(ename: String) -> Bool:
    if not ir_enum_variant_lists.contains_key(ename):
        return false
    for variant in ir_enum_variant_lists[ename].split(","):
        vkey := ename + "." + variant
        if ir_enum_payload_kinds.contains_key(vkey):
            for pk in ir_enum_payload_kinds[vkey].split(","):
                if ir_trace_kind_enabled(ir_rc_field_kind(pk)):
                    return true
    return false

# true when at least one field is a traceable child, so the struct's
# destructor gets a tracer twin. a struct that needs a dtor but holds only
# string/bytes/weak fields gets none: it is a leaf to the collector.
# mirrors ir_struct_needs_dtor, with its own memo.
fn ir_struct_needs_tracer(raw_name: String) -> Bool:
    sname := ir_struct_base_name(raw_name)
    if ir_tracer_memo.contains_key(sname):
        return ir_tracer_memo[sname] == 1
    # mark first so self-referential fields don't recurse forever; a
    # direct traceable field still sets the final answer below
    ir_tracer_memo.insert(sname, 2)
    # a boxed enum's releasable slots are tagged payloads, not declared
    # fields, so answer from the variants.
    if ir_boxed_enums.contains_key(sname):
        enum_needs := ir_enum_needs_tracer(sname)
        if enum_needs:
            ir_tracer_memo.insert(sname, 1)
        return enum_needs
    count := ir_struct_field_count(sname)
    mut i := 0
    mut needs := false
    while i < count:
        fname := ir_struct_field_name_at(sname, i)
        ftype := ir_struct_field_type_name(sname, fname)
        if not ir_struct_field_is_weak(sname, fname):
            if ir_trace_kind_enabled(ir_rc_field_kind(ftype)):
                needs = true
        i = i + 1
    if needs:
        ir_tracer_memo.insert(sname, 1)
    return needs

# a map target whose value type is string picks the heap-value
# constructor for empty literals, so runtime inserts retain
fn ir_map_init_target(name: String, target_type: String) -> String:
    mut val_type := ir_lookup_map_value_type(name)
    if val_type.len() == 0 and ir_global_map_value_types.contains_key(name):
        val_type = ir_global_map_value_types[name]
    if val_type == "string":
        if target_type == "map":
            return "map_str_val"
        if target_type == "map_int":
            return "map_int_str_val"
    return target_type

fn ir_rc_local_kind(name: String) -> String:
    mut i := 0
    while i < ir_string_locals.len():
        if ir_string_locals[i] == name and i < ir_rc_local_kinds.len():
            return ir_rc_local_kinds[i]
        i = i + 1
    return ""

fn ir_rc_track_local(name: String, kind: String):
    if not ir_string_locals.contains(name):
        ir_string_locals.push(name)
        ir_rc_local_kinds.push(kind)

# weak locals captured from an enclosing function, live only while a lambda
# body emits (saved and restored around it, so nesting composes). reads of
# these wrap in the weak liveness resolution exactly like a weak local's,
# but the names are NOT tracked in ir_string_locals: the closure environment
# owns the single weak reference — dropped by its tag-8 slot when the
# closure frees — so the lambda's per-call exit cleanup must leave the slot
# alone or the weak count underflows.
mut ir_weak_capture_names: List[String] := []

# true when reading `name` must resolve liveness through
# pith_struct_weak_load: a weak local of the emitting function, or a weak
# binding captured from the enclosing one. a loop variable shadowing the
# name reads its own slot (a strong element) and stays plain.
fn ir_name_is_weak_read(name: String) -> Bool:
    if ir_loop_var_slot(name).len() > 0:
        return false
    if ir_rc_local_kind(name) == "weak":
        return true
    return ir_weak_capture_names.contains(name)

# true when the expression reads a value some other owner keeps a count
# for: variables, collection elements, struct fields. anything else that
# produces a string (concat, substring, to_string, ...) hands us a fresh
# owned count.
fn ir_string_expr_is_borrowed(idx: Int) -> Bool:
    node := get_node(idx)
    # only expressions that provably mint a fresh buffer are owned: string
    # literals (retain is a no-op for them anyway), concatenation, string
    # interpolation, and methods known to build new strings. everything
    # else — variables, extractions, calls, match values — counts as
    # borrowed. over-classifying as borrowed can only over-retain (a leak);
    # the reverse dangles a pointer.
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return false
    if node.kind == "index" and node.children.len() > 0:
        # s[i] on a string mints a fresh char (char_at); container indexing
        # borrows the element. mirrors ir_emit_index_expr's dispatch.
        if ir_expr_is_fresh_string_index(idx):
            return false
        return true
    if node.kind == "binary" or node.kind == "interp" or node.kind == "string_interp":
        return false
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_string_expr_is_borrowed(node.children[0])
    # a try (!) unwraps its inner result: ownership classification follows
    # the wrapped expression (a transferred call result stays owned)
    if (node.kind == "try" or node.kind == "try_expr") and node.children.len() > 0:
        inner := get_node(node.children[0])
        if inner.kind == "call" or inner.kind == "method_call":
            # the unwrapped ok value is a transfer: result returns route
            # through the same retain-borrowed-returns convention
            return false
        return ir_string_expr_is_borrowed(node.children[0])
    # a catch normalizes both arms to owned (the ok arm transfers the result
    # payload out of the shell; the fallback arm retains a borrow — see
    # ir_emit_catch_expr), so the result arrives owned. treating it as borrowed
    # makes the binding retain again and leaks the payload.
    if node.kind == "catch_expr" or node.kind == "catch_block":
        return false
    # awaiting a task transfers the result's count out to the single awaiter:
    # the task's thread produced the value with count 1 and stored it raw in the
    # result slot (no retain), and pith_await hands that count back. so the
    # awaited value arrives owned, exactly like a fresh call result — treating it
    # as borrowed would add a compensating retain and leak the payload by one.
    # (scalar returns carry no count, so this classification is a no-op for them.)
    if node.kind == "await":
        return false
    # collection literals mint fresh containers, and collection-typed call
    # results arrive with a transferred count (user returns exclude the
    # local, runtime producers build new containers). variable, element,
    # and field reads stay borrows.
    if node.kind == "list" or node.kind == "map" or node.kind == "set":
        return false
    if node.kind == "struct_init":
        return false
    # a tuple literal mints a fresh struct:tuple allocation with its own
    # count, the same as a struct_init.
    if node.kind == "tuple":
        return false
    # a lambda mints a fresh closure with its own count; returning or
    # binding it transfers that count rather than borrowing one.
    if node.kind == "lambda":
        return false
    # naming a function as a value does the same thing: `shout` and
    # `hash.sha256_bytes` both lower to `closure_ref`, which allocates a
    # closure with a count of one. that count is the expression's to hand
    # on — classifying it as a borrow made the binding retain a second one
    # and left the closure alive after its single release.
    if ir_expr_is_named_function_value(idx):
        return false
    if node.kind == "call" and ir_infer_type(idx) == "string":
        return false
    if node.kind == "call" or node.kind == "method_call":
        expr_kind := ir_rc_kind(ir_infer_type(idx))
        if expr_kind == "list" or expr_kind == "map" or expr_kind == "set" or expr_kind == "bytes" or expr_kind == "struct" or expr_kind == "closure" or expr_kind == "tuple":
            return false
    if node.kind == "method_call":
        # a user-defined method already settled its result's ownership on the
        # way out: it retains a returned borrow and transfers a fresh value, so
        # the result arrives owned — the caller must not retain it again (that
        # over-retain is a leak when the method returns a fresh string). only
        # builtin string methods, which don't route through that return path,
        # fall back to the known-fresh list.
        mname := ir_plain_method_name(node.value)
        recv_type := ir_method_receiver_type(node)
        if ir_lookup_impl_method_for(node.children[0], recv_type, mname).len() > 0:
            return false
        # a builtin that takes the count on its own result hands back an owned
        # value whichever branch it ran (ir_method_result_retains_over_args).
        # keyed on the resolved builtin rather than the spelling, so a
        # same-named method on another receiver keeps its own classification —
        # and on the same rc kind the call site retains through, so "owned"
        # here can never outrun the count that backs it. where the kind is
        # unknown (a generic body, where specialization suppresses the checked
        # types) no retain is emitted, so the answer stays "borrowed" and the
        # consumer adds its own count: a leak rather than a value released
        # twice.
        if ir_rc_kind(ir_infer_type(idx)).len() > 0:
            if ir_method_result_retains_over_args(ir_method_emit_name(mname, recv_type)):
                return false
        return not ir_string_method_returns_fresh(mname)
    return true

fn ir_string_method_returns_fresh(mname: String) -> Bool:
    if mname == "to_string" or mname == "trim" or mname == "substring":
        return true
    if mname == "to_upper" or mname == "to_lower" or mname == "reverse":
        return true
    if mname == "join" or mname == "repeat" or mname == "replace":
        return true
    if mname == "trim_left" or mname == "trim_right" or mname == "char_at":
        return true
    if mname == "pop":
        return true
    return false

# release every owned string local before a return, minus the one being
# returned (its count transfers to the caller). the prologue zero-stores
# each tracked name, so the loads are valid on every path.
# --- defer scope machinery ---
#
# the delicate invariant lives here: at every exit edge the deferred user
# statements run (innermost scope first) BEFORE ir_emit_string_cleanup, so a
# deferred `conn.close()` still sees the locals ARC is about to release.
# emitting one deferred entry is just ir_stmt on its stored node — fresh
# registers every time, so re-emitting at several exits is safe.

# open a new block scope: remember where its defers will start.
fn ir_defer_push_scope():
    ir_defer_scope_starts = ir_push_int(ir_defer_scope_starts, ir_defer_nodes.len())

# record a deferred statement in the innermost open scope. is_err is 1 for an
# `errdefer` (runs only on error exits) and 0 for a plain `defer`.
fn ir_defer_register(inner_idx: Int, is_err: Int):
    ir_defer_nodes.push(inner_idx)
    ir_defer_is_err.push(is_err)

# emit deferred nodes from the top of the flat stack down to `stop` (inclusive
# of `stop`), in LIFO order, WITHOUT truncating the stack. used at early exits
# where control leaves several scopes at once. at a success exit
# (is_error_exit false) the errdefer entries are filtered out; at an error exit
# every entry runs.
fn ir_defer_emit_through(stop: Int, is_error_exit: Bool):
    mut i := ir_defer_nodes.len() - 1
    while i >= stop:
        if is_error_exit or ir_defer_is_err[i] == 0:
            ir_stmt(ir_defer_nodes[i])
        i = i - 1

# emit every deferred statement still in scope, before the ARC cleanup. used at
# the function-level exit edges: pass is_error_exit true at the error edges
# (fail / `!` / `?` / index-miss) so errdefers run, false at the success edges
# (return, default return) so they are skipped.
# release every still-open loop's owned iterable at a function exit edge. the
# loop's own end label releases it on the normal path, but return/fail/`!` leave
# the function before that label, so release here — innermost loop first — to
# free what the end label would have. break/continue reach the end label and are
# not function exits, so they never call this.
fn ir_loop_iter_emit_releases():
    mut i := ir_loop_iter_vars.len() - 1
    while i >= 0:
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + ir_loop_iter_vars[i])
        ir_rc_release_reg(r, ir_loop_iter_kinds[i])
        i = i - 1

fn ir_defer_emit_to_function_frame(is_error_exit: Bool):
    ir_defer_emit_through(0, is_error_exit)
    ir_loop_iter_emit_releases()

# close the innermost block scope. falling off the end of a block is a success
# exit, so its plain defers run in LIFO order and its errdefers are skipped; if
# the block already ended in a terminator they were emitted at that edge, so
# skip them here. either way the scope's entries are dropped from both stacks.
fn ir_defer_pop_scope_emit():
    if ir_defer_scope_starts.len() == 0:
        return
    start := ir_defer_scope_starts[ir_defer_scope_starts.len() - 1]
    ir_defer_scope_starts.remove(ir_defer_scope_starts.len() - 1)
    if not ir_last_was_ret:
        mut i := ir_defer_nodes.len() - 1
        while i >= start:
            if ir_defer_is_err[i] == 0:
                ir_stmt(ir_defer_nodes[i])
            i = i - 1
    while ir_defer_nodes.len() > start:
        ir_defer_nodes.remove(ir_defer_nodes.len() - 1)
        ir_defer_is_err.remove(ir_defer_is_err.len() - 1)

# a loop records the flat-stack length at entry so break/continue emit only the
# defers registered inside the loop body, not the enclosing function's.
fn ir_defer_loop_enter():
    ir_defer_loop_base_stack = ir_push_int(ir_defer_loop_base_stack, ir_defer_nodes.len())

fn ir_defer_loop_exit():
    if ir_defer_loop_base_stack.len() > 0:
        ir_defer_loop_base_stack.remove(ir_defer_loop_base_stack.len() - 1)

# emit the current loop body's defers before a break/continue jump. break and
# continue are success exits, so errdefers are skipped here.
fn ir_defer_emit_for_loop_jump():
    if ir_defer_loop_base_stack.len() > 0:
        ir_defer_emit_through(ir_defer_loop_base_stack[ir_defer_loop_base_stack.len() - 1], false)

# record the producing result/optional type id for a tuple local. a rebind to a
# tuple of a different type (tid) can't pick one payload shape, so it is marked
# conflicting (-1) and never becomes cascade-eligible — a safe under-fix.
fn ir_tuple_record_tid(name: String, val_idx: Int):
    tid := c_get_expr_type(val_idx)
    if tid < 0:
        return
    if ir_tuple_local_tid.contains_key(name):
        if ir_tuple_local_tid[name] != tid:
            ir_tuple_local_tid.insert(name, 0 - 1)
        return
    ir_tuple_local_tid.insert(name, tid)

# true when `parent` uses its child ident `name` in a way that leaves the tuple
# holding the count it was built with, so the cleanup path is the only thing
# that ever releases the payload:
#
#   - a flag check, which only reads slot 0 and never touches the payload;
#   - a `.ok`/`.err` read, which loads slot 8 / slot 16 as a BORROW. where the
#     value escapes (`b := r.ok`, `return r.ok`) the emitter retains right after
#     the field load, so the consumer holds its own count; where it does not
#     (`f(r.ok)`, `r.ok.len()`) nothing is retained and nothing is released.
#     either way the tuple's own count survives the read.
#
# nothing on this list releases the shell, so a local whose every use is one of
# them is unambiguously the payload's sole owner at cleanup.
#
# `.ok` was excluded when the cascade first landed because whitelisting it made
# tests/cases/test_http2_tls_roundtrip fail valgrind. that turned out to be a
# separate ownership bug the leak had been hiding — a channel `try_send` handed
# its value to another task without taking a count — and is fixed.
#
# for a RESULT local the extraction forms qualify too. `name.unwrap_or(d)`,
# `name catch d`, and `name!` all classify a named operand as borrowed and
# leave the shell holding the count it was built with: the ok arm hands the
# consumer a freshly retained count (or, for a string payload, a borrow the
# escape site retains), and the err arm keeps the error in the shell. so the
# cleanup path is still the payload's sole owner, exactly like a `.ok` read.
# without these entries an extraction disqualified the local from the cascade
# and the count the shell holds was never released — one heap payload leaked
# per extraction. `is_result` gates them because the OPTIONAL unwrap_or moves
# a borrowed subject's count out to the extracted value instead of retaining
# a new one; cascading such a local would release a count it no longer holds.
#
# one whitelisted position lives in the walk instead of here: an argument of a
# same-module call whose body provably only reads the parameter
# (ir_tuple_call_uses_safe) — the parser wraps arguments in `arg` nodes, so
# this per-parent check never sees the call they belong to.
fn ir_tuple_use_is_whitelisted(parent: Node, name: String, is_result: Bool) -> Bool:
    if is_result and parent.kind == "method_call" and parent.children.len() > 0:
        recv := get_node(parent.children[0])
        if recv.kind == "ident" and recv.value == name and ir_plain_method_name(parent.value) == "unwrap_or":
            # only the receiver position is safe; the name appearing inside
            # the fallback argument is a use the walk must judge on its own
            mut ai := 1
            mut arg_mentions := false
            while ai < parent.children.len():
                if ir_subtree_mentions_ident(parent.children[ai], name):
                    arg_mentions = true
                ai = ai + 1
            return not arg_mentions
    if is_result and (parent.kind == "catch_expr" or parent.kind == "catch_block") and parent.children.len() > 1:
        operand := get_node(parent.children[0])
        if operand.kind == "ident" and operand.value == name:
            return not ir_subtree_mentions_ident(parent.children[1], name)
    if is_result and parent.kind == "try" and parent.children.len() > 0:
        operand := get_node(parent.children[0])
        if operand.kind == "ident" and operand.value == name:
            return true
    if parent.kind == "field_access":
        # the ident must be the receiver, and the field a flag or payload read
        if parent.children.len() == 0:
            return false
        recv := get_node(parent.children[0])
        if not (recv.kind == "ident" and recv.value == name):
            return false
        f := parent.value
        if f == "ok" or f == "err":
            return true
        return f == "is_ok" or f == "is_err" or f == "is_some" or f == "is_none"
    if parent.kind == "binary" and (parent.value == "eq" or parent.value == "neq"):
        # `name == none` / `name != none`: only reads the flag, never releases
        if parent.children.len() < 2:
            return false
        a := get_node(parent.children[0])
        b := get_node(parent.children[1])
        a_is_name := a.kind == "ident" and a.value == name
        b_is_name := b.kind == "ident" and b.value == name
        a_is_none := a.kind == "none_lit" or a.kind == "none"
        b_is_none := b.kind == "none_lit" or b.kind == "none"
        return (a_is_name and b_is_none) or (b_is_name and a_is_none)
    return false

# true when ident `name` appears anywhere under `idx`. used where a whole
# subtree disqualifies a local no matter how the name is spelled there: an
# assignment target, or a lambda body, both of which the surrounding walk would
# otherwise wave through on the strength of a read-shaped `.ok`.
fn ir_subtree_mentions_ident(idx: Int, name: String) -> Bool:
    node := get_node(idx)
    if node.kind == "ident" and node.value == name:
        return true
    for child_idx in node.children:
        if ir_subtree_mentions_ident(child_idx, name):
            return true
    return false

# the walk's view of one call node. an argument that is exactly the tracked
# name is a borrow only when ir_tuple_call_arg_is_borrow can prove the callee
# never keeps it; the callee position and every deeper subtree are judged by
# the ordinary rules.
fn ir_tuple_call_uses_safe(node: Node, name: String, is_result: Bool) -> Bool:
    # a named argument may land in any declared position, so a positional
    # argument's index is only trustworthy when the call has no named ones
    mut has_named := false
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "arg" and cn.value.len() > 0:
            has_named = true
    for child, i in node.children:
        cn := get_node(child)
        if i == 0:
            # the callee position: a fn value named `name` cannot be a tuple
            # local, and nothing here may wave it through
            if cn.kind == "ident" and cn.value == name:
                return false
            if cn.kind != "ident":
                if not ir_tuple_uses_all_safe(child, name, is_result):
                    return false
        else:
            mut expr_idx := child
            mut arg_name := ""
            if cn.kind == "arg":
                arg_name = cn.value
                if cn.children.len() > 0:
                    expr_idx = cn.children[0]
                else:
                    expr_idx = 0 - 1
            if expr_idx >= 0:
                en := get_node(expr_idx)
                if en.kind == "ident" and en.value == name:
                    if has_named and arg_name.len() == 0:
                        return false
                    if not ir_tuple_call_arg_is_borrow(node, i - 1, arg_name, is_result):
                        return false
                elif not ir_tuple_uses_all_safe(expr_idx, name, is_result):
                    return false
    return true

# true when handing the tracked tuple local to this call argument leaves the
# caller the payload's sole owner at cleanup. that needs the callee's body:
# only a function declared in the module being emitted qualifies, and its body
# must pass this same walk for the receiving parameter — so a callee that
# stores, returns, sends, or captures the parameter (any use the whitelist
# does not cover) answers "not safe", and the local keeps shell-only cleanup.
# everything unresolvable stays excluded the same way: an imported callee
# (its body may be checked against another module's names, so it is not
# walked), a struct or enum construction (stores every argument), a builtin
# or closure-typed callee (no declaration to read), a `mut`/`ref` parameter,
# and a recursive chain already being walked. erring that way keeps the leak
# the cascade has always tolerated and can never free a live payload.
#
# the callee's own extractions are safe on a borrowed parameter for a RESULT:
# `!`, `catch` and `unwrap_or` classify a named operand as borrowed and retain
# the payload they hand out (see ir_emit_result_unwrap_or). the OPTIONAL
# unwrap_or instead TRANSFERS the borrowed shell's payload count out, so an
# optional parameter that is extracted must disqualify the argument — which
# the walk's `is_result` gate on those clauses already does.
fn ir_tuple_call_arg_is_borrow(node: Node, arg_pos: Int, arg_name: String, is_result: Bool) -> Bool:
    callee := ir_resolve_static_callee(node.children[0])
    if callee.imported or callee.name.len() == 0:
        return false
    if ir_struct_names.contains_key(callee.name) or ir_boxed_enums.contains_key(callee.name):
        return false
    decl_idx := ir_tuple_walk_fn_decl(callee.name)
    if decl_idx < 0:
        return false
    param := ir_tuple_walk_param_name(decl_idx, arg_pos, arg_name)
    if param.len() == 0:
        return false
    body_idx := ir_tuple_walk_fn_body(decl_idx)
    if body_idx < 0:
        return false
    walk_key := callee.name + "/" + param
    if ir_tuple_borrow_walk_active.contains(walk_key):
        return false
    ir_tuple_borrow_walk_active.push(walk_key)
    safe := ir_tuple_uses_all_safe(body_idx, param, is_result)
    ir_tuple_borrow_walk_active.remove(ir_tuple_borrow_walk_active.len() - 1)
    return safe

# the declaration of a bare-named function in the module being emitted, or -1.
# ir_root_items unwraps `pub`, so public declarations resolve too.
fn ir_tuple_walk_fn_decl(fname: String) -> Int:
    if ir_tuple_walk_root < 0:
        return 0 - 1
    for item_idx in ir_root_items(ir_tuple_walk_root):
        item := get_node(item_idx)
        if ir_is_fn_decl_kind(item.kind) and item.value == fname:
            return item_idx
    return 0 - 1

# the declared parameter a call argument lands in: a named argument by its own
# name, a positional one by index among the param nodes. a `mut` or `ref`
# modifier is folded into the param node's value after a space; such a
# parameter is not a plain borrow, so the space makes the lookup miss and the
# argument stays excluded.
fn ir_tuple_walk_param_name(decl_idx: Int, arg_pos: Int, arg_name: String) -> String:
    decl := get_node(decl_idx)
    mut pi := 0
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "param":
            if arg_name.len() > 0:
                if cn.value == arg_name:
                    return arg_name
            elif pi == arg_pos:
                if cn.value.split(" ").len() > 1:
                    return ""
                return cn.value
            pi = pi + 1
    return ""

fn ir_tuple_walk_fn_body(decl_idx: Int) -> Int:
    decl := get_node(decl_idx)
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "body" and cn.children.len() > 0:
            return cn.children[0]
    return 0 - 1

# walk the subtree: every occurrence of ident `name` must appear as the child of
# a whitelisted parent. any other appearance (bound, returned, matched,
# iterated, ...) makes cascade unsafe and returns false.
fn ir_tuple_uses_all_safe(idx: Int, name: String, is_result: Bool) -> Bool:
    node := get_node(idx)
    # a lambda that mentions the local captures the three-slot shell and retains
    # only that, never the payload behind it. the closure can outlive this
    # frame, and then a `.ok` through the captured shell reads memory the
    # cascade already dropped. capture is not an extraction the walk below can
    # see, so rule the local out for the whole lambda.
    if node.kind == "lambda":
        return not ir_subtree_mentions_ident(idx, name)
    # a spawned call runs on another task that can outlive this frame, so an
    # argument there is not a borrow bounded by this function's cleanup order.
    # any mention below a spawn rules the local out, the same as a capture.
    if node.kind == "spawn":
        return not ir_subtree_mentions_ident(idx, name)
    # the whitelist covers `.ok`/`.err` as READS. on the left of an `=` the same
    # syntax is a write into the tuple, which would replace the payload the
    # cascade expects to own, so any mention of the name in an assignment target
    # rules the local out.
    if node.kind == "assignment" and node.children.len() > 0:
        if ir_subtree_mentions_ident(node.children[0], name):
            return false
    # a call gets its own walk: the parser wraps every argument in an "arg"
    # node, so the judgment needs the whole call in view, not the wrapper the
    # generic loop below would hand ir_tuple_use_is_whitelisted.
    if node.kind == "call" and node.children.len() > 0:
        return ir_tuple_call_uses_safe(node, name, is_result)
    for child_idx in node.children:
        child := get_node(child_idx)
        if child.kind == "ident" and child.value == name:
            if not ir_tuple_use_is_whitelisted(node, name, is_result):
                return false
            # a whitelisted parent consumes this ident safely; its sibling
            # children are still visited by the loop below
        else:
            if not ir_tuple_uses_all_safe(child_idx, name, is_result):
                return false
    return true

# after prologue tracking is finalized, decide which tuple locals may cascade:
# a known result/optional type with an rc payload to release, and every use in
# the body provably safe. anything unknown stays shell-only (leak, never UAF).
fn ir_tuple_cascade_scan(body_idx: Int):
    ir_tuple_cascade_names = []
    if body_idx < 0:
        return
    mut i := 0
    while i < ir_string_locals.len():
        name := ir_string_locals[i]
        mut kind := "string"
        if i < ir_rc_local_kinds.len():
            kind = ir_rc_local_kinds[i]
        # a param is a borrow: the caller owns the payload and the prologue only
        # retains the shell, so cascading one would over-release. skip anything
        # already in ir_var_regs, which at this point holds exactly the params.
        if kind == "tuple" and ir_tuple_local_tid.contains_key(name) and not ir_var_regs.contains_key(name):
            tid := ir_tuple_local_tid[name]
            if tid >= 0 and ir_tuple_local_has_rc_payload(tid):
                is_result := get_type_info(tid).kind == "result"
                if ir_tuple_uses_all_safe(body_idx, name, is_result):
                    ir_tuple_cascade_names.push(name)
        i = i + 1

# true when a result/optional type holds an rc payload worth cascading: either
# slot (ok/value or err) carries a heap value. all-scalar tuples cascade nothing,
# so they stay on the cheaper shell-only path.
fn ir_tuple_local_has_rc_payload(tid: Int) -> Bool:
    info := get_type_info(tid)
    if info.kind == "result":
        if ir_rc_kind(ir_result_field_kind(tid, "ok")).len() > 0:
            return true
        return ir_rc_kind(ir_result_field_kind(tid, "err")).len() > 0
    if info.kind == "optional" and info.inner >= 0:
        return ir_rc_kind(ir_type_from_tid(info.inner)).len() > 0
    return false

# the ok/value payload kind (slot 8) and error payload kind (slot 16) a tuple
# local's cascade must release, packed as two ir_tuple_elem_code chars. an
# optional has no error slot, so its second code is always "0".
fn ir_tuple_cascade_signature(tid: Int) -> String:
    info := get_type_info(tid)
    if info.kind == "result":
        ok_code := ir_tuple_elem_code(ir_rc_kind(ir_result_field_kind(tid, "ok")))
        err_code := ir_tuple_elem_code(ir_rc_kind(ir_result_field_kind(tid, "err")))
        return ok_code + err_code
    if info.kind == "optional" and info.inner >= 0:
        return ir_tuple_elem_code(ir_rc_kind(ir_type_from_tid(info.inner))) + "0"
    return "00"

# module-suffixed so each module carries its own copy, exactly like the tuple
# and struct destructors — no cross-module references, no name clashes.
fn ir_tuple_cascade_helper_name(sig: String) -> String:
    return "__tuple_cascade_" + sig + "_m" + ir_module_count.to_string()

# release a tracked local at cleanup / reassignment. a cascade-eligible tuple
# local additionally drops its owned payload before the shell is freed; every
# other local keeps the plain shell/handle release.
#
# the cascade is a CALL to a generated helper rather than inline branches on
# purpose: an inline brif would split the caller's basic block, and registers
# defined before the release (the freshly built value in a rebind, the return
# value at an exit edge) are still read after it. a single call keeps the
# surrounding block intact.
fn ir_rc_release_local(r: Int, kind: String, name: String):
    if kind == "tuple" and ir_tuple_cascade_names.contains(name):
        tid := ir_tuple_local_tid[name]
        info := get_type_info(tid)
        if info.kind == "result" or info.kind == "optional":
            sig := ir_tuple_cascade_signature(tid)
            if not ir_tuple_cascade_sigs.contains(sig):
                ir_tuple_cascade_sigs.push(sig)
            ir_emit_call1(ir_reg(), ir_tuple_cascade_helper_name(sig), "void", r)
            return
    ir_rc_release_reg(r, kind)

# one helper per (ok, err) payload signature used this module. each releases the
# live payload of a result/optional tuple — slot 8 when the flag is set, slot 16
# otherwise — and then frees the shell. a null shell short-circuits to a no-op,
# which is what an unassigned local (early return before its bind) or the first
# loop iteration's zero-stored previous value hands in.
fn ir_emit_tuple_cascade_helpers():
    for sig in ir_tuple_cascade_sigs:
        ok_kind := ir_tuple_dtor_code_kind(sig[0])
        err_kind := ir_tuple_dtor_code_kind(sig.substring(1, 2))
        ir_emit_func_header(ir_tuple_cascade_helper_name(sig), 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        live_r := ir_reg()
        ir_emit("neq " + live_r.to_string() + " " + pr.to_string() + " " + zero_r.to_string())
        live_l := ir_label()
        done_l := ir_label()
        ir_emit("brif " + live_r.to_string() + " " + live_l + " " + done_l)
        ir_emit_label(live_l)
        flag_r := ir_reg()
        ir_emit("field " + flag_r.to_string() + " " + pr.to_string() + " 0 bool is_ok")
        ok_l := ir_label()
        err_l := ir_label()
        rel_l := ir_label()
        ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + err_l)
        ir_emit_label(ok_l)
        if ok_kind.len() > 0:
            ok_r := ir_reg()
            ir_emit("field " + ok_r.to_string() + " " + pr.to_string() + " 8 unknown ok")
            ir_rc_release_reg(ok_r, ok_kind)
        ir_emit("jmp " + rel_l)
        ir_emit_label(err_l)
        if err_kind.len() > 0:
            err_r := ir_reg()
            ir_emit("field " + err_r.to_string() + " " + pr.to_string() + " 16 unknown err")
            ir_rc_release_reg(err_r, err_kind)
        ir_emit("jmp " + rel_l)
        ir_emit_label(rel_l)
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", pr)
        ir_emit("jmp " + done_l)
        ir_emit_label(done_l)
        ret_r := ir_reg()
        ir_emit("iconst " + ret_r.to_string() + " 0")
        ir_emit("ret " + ret_r.to_string())
        ir_emit("endfunc")

fn ir_emit_string_cleanup(exclude: String):
    mut i := 0
    while i < ir_string_locals.len():
        name := ir_string_locals[i]
        mut kind := "string"
        if i < ir_rc_local_kinds.len():
            kind = ir_rc_local_kinds[i]
        if name != exclude and ir_rc_release_enabled(kind):
            r := ir_reg()
            ir_emit_local_slot_load(r, name)
            ir_rc_release_local(r, kind, name)
        i = i + 1

# pre-pass: names of string-typed binds anywhere in the body. an
# under-approximation is safe — a missed name is never released (a leak),
# while emission-time classification only widens, never narrows, so every
# collected name really does hold owned counts.
fn ir_string_prepass_bind_type(parts: IrBindParts, names: List[String]) -> String:
    mut bind_type := ""
    if parts.type_idx >= 0:
        bind_type = ir_resolve_type_node(parts.type_idx)
    if bind_type.len() == 0 and parts.val_idx >= 0:
        # the collected names double as a type environment: a bind from an
        # already-collected name chains its tracking (and kind), so a later
        # rebind of the source cannot release a value this variable shares.
        val_node := get_node(parts.val_idx)
        if val_node.kind == "ident" and names.contains(val_node.value):
            bind_type = ir_rc_local_kind(val_node.value)
        else:
            # the checker's recorded type resolves module-qualified calls
            # (bytes.from_string_utf8 and friends) that local inference
            # cannot; inference stays as the fallback
            bind_type = ir_checked_type(parts.val_idx)
            if bind_type.len() == 0:
                bind_type = ir_infer_type(parts.val_idx)
            # in a generic impl body the checker suppresses the struct's type
            # params, so a bind from a method/call comes back with no rc kind
            # (or an unresolved optional). the emitter's own result kind still
            # resolves — the impl-subst context is active during the prologue —
            # and it is exactly the lowered kind the exit cleanup releases.
            if ir_rc_kind(bind_type).len() == 0 and (val_node.kind == "method_call" or val_node.kind == "call"):
                bind_type = ir_expr_result_kind(parts.val_idx)
            # a catch binds the guarded result's OK value. the checker leaves
            # the catch node's type empty for collections (and inference reports
            # the underlying result tuple), so a list/map/set binding would be
            # released with the wrong struct-shaped kind and leak its backing.
            # take the ok kind the emitter itself uses for the ok field.
            if (val_node.kind == "catch_expr" or val_node.kind == "catch_block") and val_node.children.len() > 0:
                catch_ok := ir_result_ok_kind_for_expr(val_node.children[0])
                if ir_rc_kind(catch_ok).len() > 0:
                    bind_type = catch_ok
            # `c := self.list[i]` on a generic list field: the checked/inferred
            # element type is suppressed to "unknown", so recover the element
            # type name from the field's declared `List[T]` node (the caller
            # substitutes T -> concrete). without this the element isn't tracked
            # and the returned value dangles once the list is mutated.
            if ir_rc_kind(ir_substitute_type_name(bind_type)).len() == 0 and val_node.kind == "index" and val_node.children.len() > 0 and ir_current_impl_type.len() > 0:
                list_node := get_node(val_node.children[0])
                if list_node.kind == "field_access":
                    elem := ir_self_list_field_element(list_node.value)
                    if elem.len() > 0:
                        bind_type = elem
    return bind_type

# the element type name of a `self`-list field declared `List[T]` on the
# current generic impl's struct (e.g. "T"/"C"), or "". reads the declaration
# node because the resolved field kind is just "list".
fn ir_self_list_field_element(field_name: String) -> String:
    if ir_current_impl_type.len() == 0:
        return ""
    base := ir_strip_type_args(ir_current_impl_type)
    if not ir_struct_decl_nodes.contains_key(base):
        return ""
    decl := get_node(ir_struct_decl_nodes[base])
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and ir_struct_field_name(fnode) == field_name:
            if fnode.children.len() > 0:
                tnode := get_node(fnode.children[0])
                if tnode.kind == "generic_type" and tnode.value == "List" and tnode.children.len() > 0:
                    return get_node(tnode.children[0]).value
    return ""

fn ir_collect_string_bind_names(idx: Int, names: List[String], poisoned: List[String]):
    node := get_node(idx)
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if parts.name.len() > 0:
            # a `weak` binding is tracked under its own kind: its slot holds a
            # bare target pointer counted on the header's WEAK count, so the
            # cleanup must weak_release it — the type-derived kind ("struct")
            # would strong-release a count the binding never took. the checker
            # rejects any reuse of a weak name in the same function, so the
            # kind-conflict poisoning below cannot silently untrack one.
            mut kind := ""
            if node.value.contains(" weak"):
                kind = "weak"
            else:
                # substitute struct params (C -> the concrete type) so a bind of a
                # generic element (c := list[i] in a generic impl) is tracked and
                # retained; otherwise the element frees when the list is mutated and
                # the returned value dangles. no-op outside a specialized body.
                kind = ir_rc_kind(ir_substitute_type_name(ir_string_prepass_bind_type(parts, names)))
            if kind.len() > 0:
                if names.contains(parts.name):
                    if ir_rc_local_kind(parts.name) != kind and not poisoned.contains(parts.name):
                        # same name, different rc kind in a sibling branch:
                        # tracking it would fire the wrong retain/release at
                        # runtime. drop it — a leak, never a wild pointer.
                        poisoned.push(parts.name)
                else:
                    ir_rc_track_local(parts.name, kind)
                # remember the producing result/optional type so the cleanup path
                # can cascade-release the payload (only for cascade-eligible locals)
                if kind == "tuple" and parts.val_idx >= 0:
                    ir_tuple_record_tid(parts.name, parts.val_idx)
            elif not poisoned.contains(parts.name):
                # bound with a non-rc (or unknown) type somewhere: same rule.
                poisoned.push(parts.name)
    # a match arm's payload bindings are owned locals too: ir_match_emit
    # retains each rc payload, so track them here for the exit cleanup to
    # release (or transfer on escape), same as any other owned local.
    if node.kind == "pat_variant" and node.children.len() > 0:
        mut variant_kinds: List[String] := []
        if ir_enum_payload_kinds.contains_key(node.value):
            variant_kinds = ir_enum_payload_kinds[node.value].split(",")
        for sub_idx, pi in node.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                mut payload_kind := ""
                if pi < variant_kinds.len():
                    payload_kind = ir_rc_kind(variant_kinds[pi])
                if payload_kind.len() > 0:
                    if names.contains(sub.value):
                        if ir_rc_local_kind(sub.value) != payload_kind and not poisoned.contains(sub.value):
                            poisoned.push(sub.value)
                    else:
                        ir_rc_track_local(sub.value, payload_kind)
                elif not poisoned.contains(sub.value):
                    # a sibling arm binds this name with an rc payload while
                    # this arm binds it as a plain value (Zed(Pack, _) versus
                    # Beta(Int, _) sharing x0). releasing the rc kind at exit
                    # would dereference whatever integer the last-run arm
                    # stored — same rule as the := path above: drop the name,
                    # a bounded leak, never a wild pointer.
                    poisoned.push(sub.value)
    for child in node.children:
        ir_collect_string_bind_names(child, names, poisoned)

# prologue for the collected names: zero-store each one and retain string
# params (params are locals under the same rule, so the exit cleanup
# releasing them stays balanced with the caller's count).
mut ir_current_arc_func := ""
# true while emitting main's own body — not a lambda defined inside it, and
# not a test function. error returns emitted under this flag also report the
# error and exit nonzero, because the entry glue pins main's exit code to 0
# and a failing program must not look like a passing one.
mut ir_emitting_main_body := false

# params are borrows: the caller keeps its count alive for the whole call,
# so an unmodified string param needs no rc traffic at all. a param the
# body reassigns becomes an owned local — retained in the prologue so
# release-on-reassign and exit cleanup stay balanced with the caller.
fn ir_collect_reassigned_string_params(idx: Int, names: List[String]):
    node := get_node(idx)
    mut target := ""
    if node.kind == "assign":
        target = node.value
    elif node.kind == "assignment" and node.children.len() > 0:
        tn := get_node(node.children[0])
        if tn.kind == "ident":
            target = tn.value
    if target.len() > 0 and not names.contains(target):
        if ir_var_regs.contains_key(target):
            kind := ir_rc_kind(ir_lookup_name_type(target))
            if kind.len() > 0:
                ir_rc_track_local(target, kind)
    for child in node.children:
        ir_collect_reassigned_string_params(child, names)

fn ir_emit_string_prologue(body_idx: Int):
    mut poisoned: List[String] := []
    if body_idx >= 0:
        ir_collect_reassigned_string_params(body_idx, ir_string_locals)
        ir_collect_string_bind_names(body_idx, ir_string_locals, poisoned)
    if poisoned.len() > 0:
        mut kept: List[String] := []
        mut kept_kinds: List[String] := []
        mut pi := 0
        while pi < ir_string_locals.len():
            if not poisoned.contains(ir_string_locals[pi]):
                kept.push(ir_string_locals[pi])
                if pi < ir_rc_local_kinds.len():
                    kept_kinds.push(ir_rc_local_kinds[pi])
                else:
                    kept_kinds.push("string")
            pi = pi + 1
        ir_string_locals = kept
        ir_rc_local_kinds = kept_kinds
        # publish the poisoned names so the match emitter skips the
        # release-of-previous-value for their bindings; the untracked name is
        # never zero-stored here, so that release would load a name the ir
        # has not declared yet (and could fire the wrong-kind release later).
        ir_untracked_rc_binds = poisoned
    # with the final tracked set known, decide which tuple locals may cascade
    # their payload at cleanup (all uses provably safe); the rest stay shell-only
    ir_tuple_cascade_scan(body_idx)
    mut i := 0
    while i < ir_string_locals.len():
        name := ir_string_locals[i]
        if ir_var_regs.contains_key(name):
            # param: retain the caller's value, no zero-store
            r := ir_reg()
            ir_emit_name_load(r, name)
            ir_rc_retain_reg(r, ir_rc_local_kind(name))
        else:
            z := ir_reg()
            ir_emit("iconst " + z.to_string() + " 0")
            ir_emit_name_store(name, z)
        i = i + 1

fn ir_ident_callee(name: String) -> ResolvedCallee:
    return ir_ident_callee_with_state(name, ir_import_renames, ir_active_generic_module_path, ir_import_declared_functions)

fn ir_resolve_static_callee(idx: Int) -> ResolvedCallee:
    return ir_resolve_static_callee_with_state(idx, ir_import_renames, ir_active_generic_module_path, ir_module_aliases, ir_import_declared_functions, ir_import_declared_globals)

fn ir_is_local_generic_callee(index_idx: Int, member_name: String, first_param_name: String) -> Bool:
    index_node := get_node(index_idx)
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind != "ident" or base_node.value != member_name:
        return false
    if not ir_generic_decl_indices.contains_key(member_name):
        return false
    return ir_param_name_at(ir_generic_decl_indices[member_name], 0) == first_param_name

fn ir_callee_uses_result_abi(callee: ResolvedCallee, idx: Int) -> Bool:
    raw_kind := ir_declared_callable_ir_retkind(callee.name)
    if raw_kind == "tuple" or raw_kind == "result_int" or raw_kind == "result_bool":
        return true
    return ir_builtin_result_retkind(callee.name).len() > 0

fn ir_temp_name(prefix: String) -> String:
    return prefix + "_" + ir_label()

# emit one call argument. a plain value the checker widened to an optional
# parameter goes through the same target-shaped emitter every other widening
# position already uses, so a `f(x: Int?)` body reads the Some(3) tuple it
# expects rather than the bare integer. everything else emits unchanged.
fn ir_emit_call_arg(expr_idx: Int) -> Int:
    if c_argument_widens_to_optional(expr_idx):
        return ir_emit_value_for_target(expr_idx, "tuple")
    return ir_expr(expr_idx)

# a widened argument's register is the optional wrapper, not the value the
# release walkers were written against — releasing it as a string or an rc
# payload would drop a count on the wrong object. the wrapper owns whatever it
# holds (ir_emit_value_for_target attaches the destructor), so skipping the
# caller-side release leaks the wrapper rather than freeing something twice.
fn ir_arg_release_is_skipped(expr_idx: Int) -> Bool:
    return expr_idx >= 0 and c_argument_widens_to_optional(expr_idx)

fn ir_collect_call_arg_regs(node: Node, start_idx: Int) -> List[Int]:
    mut arg_regs: List[Int] := []
    for child, i in node.children:
        if i < start_idx:
            continue
        child_kind := node_kind(child)
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                arg_regs.push(ir_emit_call_arg(cn.children[0]))
        else:
            arg_regs.push(ir_emit_call_arg(child))
    return arg_regs

# owned string arguments (fresh chars from s[i], concat results, fresh
# method results) die once the call they fed returns: callees borrow their
# params, and storing callees add their own count. pairs registers with the
# same child walk ir_collect_call_arg_regs used.
# method variant: pairs registers with ir_method_call_arg_expr so the walk
# can never drift from the collector's. skip_pos marks a container-store
# argument: ownership transfers to the container there, and the store
# itself completes the transfer by taking the caller's count rather than
# adding one (see ir_owned_container_store_name).
fn ir_release_owned_method_args(node: Node, arg_regs: List[Int], skip_pos: Int):
    for reg, i in arg_regs:
        if i == skip_pos:
            continue
        expr_idx := ir_method_call_arg_expr(node, i)
        if expr_idx < 0:
            continue
        if ir_arg_release_is_skipped(expr_idx):
            continue
        ir_release_owned_string_operand(expr_idx, reg, ir_infer_type(expr_idx))

# true for a builtin whose result may BE one of its arguments rather than a
# value the receiver keeps a count for. `get_default` is the only one: it
# returns its fallback unchanged when the key is missing, and the map's own
# value when the key is present, adding no count on either branch.
#
# neither branch hands back a count, so the caller has to take one — and one
# retain of the result settles both. on a miss it lands on the fallback, which
# the ordinary owned-argument release then drops back to the single count the
# caller now holds; on a hit it lands on the map's value, which is the count
# that keeps a container result alive past the map entry that lent it.
# without it, `v := m.get_default(k, [])` released the map's own list at scope
# exit and the next read of that entry was a use-after-free.
#
# the order is load-bearing: retain first. on the miss branch the register the
# release drops is the very one the retain just counted, so releasing first
# would free the value in between — that is the shape that made the first
# attempt at this hand back a recycled handle.
fn ir_method_result_retains_over_args(emit_name: String) -> Bool:
    return emit_name == "map_get_default" or emit_name == "map_get_default_ikey"

fn ir_release_owned_string_args(node: Node, start_idx: Int, arg_regs: List[Int]):
    # a named argument may land in any declared position, so a positional
    # index is only handed to the fresh-optional walk when no named
    # arguments could have shifted it
    mut has_named := false
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "arg" and cn.value.len() > 0:
            has_named = true
    mut reg_i := 0
    for child, i in node.children:
        if i < start_idx:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        mut arg_name := ""
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                continue
            arg_name = cn.value
            expr_idx = cn.children[0]
        if ir_arg_release_is_skipped(expr_idx) == false:
            ir_release_owned_string_operand(expr_idx, arg_regs[reg_i], ir_infer_type(expr_idx))
            if arg_name.len() > 0 or not has_named:
                ir_release_fresh_optional_arg(node, reg_i, arg_name, expr_idx, arg_regs[reg_i])
        reg_i = reg_i + 1

fn ir_register_struct_layout(name: String, field_names: List[String], field_types: List[String]):
    if ir_struct_names.contains_key(name):
        return
    for field_name, i in field_names:
        ir_struct_field_lookup.insert(name + "." + field_name, field_types[i])
        ir_struct_field_index_lookup.insert(name + "." + field_name, i.to_string())
    ir_struct_names.insert(name, field_names.len())
    if not ir_local_struct_names.contains(name):
        ir_local_struct_names.push(name)
    ir_emit("struct " + name + " " + field_names.join(" "))

fn ir_substitute_type_name(name: String) -> String:
    mut i := 0
    while i < ir_current_impl_subst_params.len():
        if ir_current_impl_subst_params[i] == name and i < ir_current_impl_subst_args.len():
            return ir_current_impl_subst_args[i]
        i = i + 1
    return name

fn ir_impl_target_type(node: Node) -> String:
    mut impl_type := ""
    for child in node.children:
        child_node := get_node(child)
        if child_node.kind == "type":
            impl_type = child_node.value
        elif child_node.kind == "for_type":
            for type_idx in child_node.children:
                type_child := get_node(type_idx)
                if type_child.kind == "type":
                    impl_type = type_child.value
        elif child_node.kind == "generic_type" and impl_type == "":
            impl_type = child_node.value
    return impl_type

# for `impl Iface for Concrete`, the interface's base name; "" for a plain
# `impl T:` block. the first type child is the interface, a for_type follows.
fn ir_impl_interface_base(node: Node) -> String:
    mut has_for := false
    mut first_type := ""
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "type" and first_type == "":
            first_type = cn.value
        elif cn.kind == "generic_type" and first_type == "":
            first_type = cn.value
        elif cn.kind == "for_type":
            has_for = true
    if has_for == false:
        return ""
    return ir_strip_type_args(first_type)

fn ir_impl_defines_method(node: Node, method_name: String) -> Bool:
    for child in node.children:
        mn := get_node(ir_unwrap_pub_child(child))
        if ir_is_fn_decl_kind(mn.kind) and mn.value == method_name:
            return true
    return false

# the interface-default fn_decl nodes an impl inherits: each default method on
# the interface (a fn_decl member) that the impl did not override itself.
fn ir_inherited_default_indices(node: Node) -> List[Int]:
    mut result: List[Int] := []
    iface_base := ir_impl_interface_base(node)
    if iface_base.len() == 0:
        return result
    if ir_interface_decl_index.contains_key(iface_base) == false:
        return result
    iface_node := get_node(ir_interface_decl_index[iface_base])
    for member in iface_node.children:
        mn := get_node(member)
        if ir_is_fn_decl_kind(mn.kind):
            if ir_impl_defines_method(node, mn.value) == false:
                result.push(member)
    return result

# collect each impl's associated-type bindings so a method's `-> Item` header
# resolves to the bound type (and, for heap types, gets the right return kind).
fn ir_collect_assoc_bindings_in_root(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual := node
        if node.kind == "pub":
            actual = get_node(node.children[0])
        if actual.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual)
            if impl_type.len() > 0:
                mut names: List[String] := []
                for child in actual.children:
                    cn := get_node(child)
                    if cn.kind == "assoc_type_bind":
                        ir_assoc_bindings.insert(impl_type + "." + cn.value, ir_resolve_type_node(cn.children[0]))
                        names.push(cn.value)
                if names.len() > 0:
                    ir_type_assoc_names.insert(impl_type, names.join(","))

# index every interface_decl in a root by its base name so impls can find the
# defaults they inherit. must run before impl signatures are collected.
fn ir_index_interfaces_in_root(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual_idx := item_idx
        if node.kind == "pub":
            actual_idx = node.children[0]
        actual := get_node(actual_idx)
        if actual.kind == "interface_decl":
            ir_interface_decl_index.insert(actual.value, actual_idx)

fn ir_emit_impl_methods(node: Node, impl_type: String):
    # for a generic struct, also emit one specialized copy of each method per
    # known instantiation so calls inside the body (`self.src.next()`) can
    # dispatch on the concrete type rather than the unresolved generic
    # parameter (`I.next` -> `next unknown`). emit these BEFORE the base
    # bodies so we can read each method's still-prefixed base symbol name
    # out of ir_impl_methods (ir_impl_func below overwrites it).
    ir_emit_impl_method_specializations(node, impl_type)
    for child in node.children:
        # a pub method sits behind a pub wrapper node; without this
        # unwrap the method silently never emits and calls return zero
        method_idx := ir_unwrap_pub_child(child)
        child_node := get_node(method_idx)
        if child_node.kind == "fn_decl":
            ir_impl_func(method_idx, impl_type)
    # emit a per-type copy of each interface default this impl didn't override
    for default_idx in ir_inherited_default_indices(node):
        ir_impl_func(default_idx, impl_type)

fn ir_emit_impl_method_specializations(impl_node: Node, impl_type: String):
    if not has_generic_declaration(impl_type):
        return
    sdecl := get_node(get_generic_declaration_index(impl_type))
    struct_params := collect_generic_parameter_names(sdecl)
    if struct_params.len() == 0:
        return
    instance_tids := struct_instance_tids
    for inst_tid in instance_tids:
        if struct_instance_base_name[inst_tid] != impl_type:
            continue
        if not struct_instance_type_args.contains_key(inst_tid):
            continue
        arg_tids := decode_tid_list(struct_instance_type_args[inst_tid])
        mut arg_names: List[String] := []
        for at in arg_tids:
            arg_names.push(ir_type_from_tid(at))
        instance_type_name := get_type_name(inst_tid)
        for child in impl_node.children:
            method_idx := ir_unwrap_pub_child(child)
            child_node := get_node(method_idx)
            if child_node.kind == "fn_decl":
                ir_impl_func_specialized(method_idx, impl_type, instance_type_name, struct_params, arg_names)

fn ir_impl_func_specialized(idx: Int, base_impl_type: String, instance_type: String, params: List[String], arg_names: List[String]):
    node := get_node(idx)
    orig_name := node.value
    # specialized symbol name e.g. MapIter_Range_int_int_next
    mut suffix := ""
    for an in arg_names:
        suffix = suffix + "_" + ir_sanitize_symbol(an)
    full_name := base_impl_type + suffix + "_" + orig_name
    method_key := ir_impl_method_key(instance_type, orig_name)
    # if ir_impl_methods already has a specialized entry (e.g. a previous
    # ir_impl_func_specialized for the same instance ran in this emit pass)
    # then the body is already on its way out; skip emitting it again
    if ir_impl_methods.contains_key(method_key):
        return
    ir_impl_methods.insert(method_key, full_name)
    # also record in a dedicated, non-reset map keyed by the instance-typed
    # method. derive the module-path prefix from the base method's currently
    # registered symbol (phase-two metadata inserted it with the right
    # prefix; this runs before ir_impl_func overwrites it for the current
    # module's impls) so cross-module call sites use the right linker symbol.
    base_key := ir_impl_method_key(base_impl_type, orig_name)
    expected_base_sym := base_impl_type + "_" + orig_name
    mut prefixed_full := full_name
    if ir_impl_methods.contains_key(base_key):
        base_sym := ir_impl_methods[base_key]
        if base_sym.len() > expected_base_sym.len() and base_sym.ends_with(expected_base_sym):
            prefix_len := base_sym.len() - expected_base_sym.len()
            prefixed_full = base_sym.substring(0, prefix_len) + full_name
    ir_impl_method_specializations.insert(method_key, prefixed_full)

    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx) + 1
    ret_type := ir_extract_return_type(idx)
    ir_prepare_func_emission(ret_type)
    ir_current_func_optional_inner_kind = ir_extract_optional_inner_type(idx)
    ir_current_func_returns_result = ir_fn_returns_result(idx)
    ir_current_impl_type = instance_type
    ir_current_impl_subst_params = params
    ir_current_impl_subst_args = arg_names
    ir_emit_func_header(full_name, param_count, ret_type)
    ir_emit_named_param("self", instance_type)
    ir_emit_fn_params(idx)
    # like every other function body, track owned locals so the exit cleanup
    # releases them. the impl-subst context (set above) is active here, so the
    # prologue's bind prepass can resolve a method result's lowered kind even
    # though the checker suppressed the struct's type params in this body.
    ir_emit_string_prologue(body_idx)
    ir_func_returns.insert(method_key, ret_type)
    ir_func_returns.insert(full_name, ret_type)
    ir_finish_func_emission(body_idx)
    ir_current_impl_type = ""
    ir_current_impl_subst_params = []
    ir_current_impl_subst_args = []

fn ir_declared_struct_name(node: Node) -> String:
    if node.value.contains("["):
        return node.value.substring(0, node.value.index_of("["))
    return node.value

fn ir_record_struct_field(struct_name: String, field_names: List[String], field_node: Node) -> List[String]:
    field_name := ir_struct_field_name(field_node)
    mut updated_fields := field_names
    field_index := updated_fields.len()
    updated_fields.push(field_name)
    if field_node.children.len() > 0:
        type_node := get_node(field_node.children[0])
        # a closure field (fn_type) must be recorded too, or the struct's
        # destructor won't know to release it and the closure leaks
        if type_node.kind == "type" or type_node.kind == "generic_type" or type_node.kind == "optional_type" or type_node.kind == "fn_type":
            ir_struct_field_lookup.insert(struct_name + "." + field_name, ir_resolve_type_node(field_node.children[0]))
        if field_node.children.len() > 1:
            ir_struct_field_default_nodes.insert(struct_name + "." + field_name, field_node.children[1])
    ir_struct_field_index_lookup.insert(struct_name + "." + field_name, field_index.to_string())
    return updated_fields

fn ir_collect_struct_decl(node_idx: Int, node: Node, emit_decl: Bool):
    sname := ir_declared_struct_name(node)
    ir_struct_decl_nodes.insert(sname, node_idx)
    mut field_names: List[String] := []
    for child in node.children:
        field_node := ir_unwrap_pub_node(child)
        if field_node.kind == "field":
            field_names = ir_record_struct_field(sname, field_names, field_node)
    ir_struct_names.insert(sname, field_names.len())
    if emit_decl:
        if not ir_local_struct_names.contains(sname):
            ir_local_struct_names.push(sname)
        ir_emit("struct " + sname + " " + field_names.join(" "))

fn ir_collect_enum_decl(node: Node, emit_decl: Bool):
    sname := node.value
    mut variant_names: List[String] := []
    for child in node.children:
        variant_node := ir_unwrap_pub_node(child)
        if variant_node.kind == "variant":
            variant_index := variant_names.len()
            variant_names.push(variant_node.value)
            ir_struct_field_lookup.insert(sname + "." + variant_node.value, sname)
            ir_struct_field_index_lookup.insert(sname + "." + variant_node.value, variant_index.to_string())
            if variant_node.children.len() > 0:
                mut kinds: List[String] := []
                for type_idx in variant_node.children:
                    mut kind := ir_resolve_type_node(type_idx)
                    if kind.len() == 0:
                        kind = "unknown"
                    kinds.push(kind)
                ir_enum_payload_kinds.insert(sname + "." + variant_node.value, kinds.join(","))
                ir_boxed_enums.insert(sname, true)
    ir_enum_variant_lists.insert(sname, variant_names.join(","))
    ir_struct_names.insert(sname, variant_names.len())
    if emit_decl:
        ir_emit("struct " + sname + " " + variant_names.join(" "))

fn ir_collect_struct_decls(root_idx: Int, emit_decl: Bool):
    for item_idx in ir_root_items(root_idx):
        cn := get_node(item_idx)
        if cn.kind == "struct_decl" or cn.kind == "struct":
            ir_collect_struct_decl(item_idx, cn, emit_decl)
        elif cn.kind == "enum_decl" or cn.kind == "enum":
            ir_collect_enum_decl(cn, emit_decl)

fn ir_seed_global_types():
    for name in ir_global_int_names:
        ir_var_types.insert(name, "int")
    for name in ir_global_string_names:
        ir_var_types.insert(name, "string")
    for name in ir_global_list_string_names:
        ir_var_types.insert(name, "list_string")
    for name in ir_global_list_names:
        ir_var_types.insert(name, "list")
    for name in ir_global_map_int_names:
        ir_var_types.insert(name, "map_int")
    for name in ir_global_map_names:
        ir_var_types.insert(name, "map")
    for name in ir_global_set_int_names:
        ir_var_types.insert(name, "set_int")
    for name in ir_global_set_names:
        ir_var_types.insert(name, "set")
    for name in ir_global_bool_names:
        ir_var_types.insert(name, "bool")
    for name in ir_global_map_value_types.keys():
        ir_map_value_types.insert(name, ir_global_map_value_types[name])

fn ir_register_known_import_structs():
    ir_register_struct_layout("Node", ["kind", "value", "children", "line", "col"], ["string", "string", "list", "int", "int"])
    ir_register_struct_layout("Token", ["kind", "value", "current_line", "current_column"], ["string", "string", "int", "int"])
    ir_register_struct_layout("TypeInfo", ["kind", "name", "fields", "field_types", "field_pub", "field_mut", "param_types", "return_type", "inner", "key_type", "value_type", "elements", "variants", "variant_types"], ["string", "string", "list_string", "list", "list", "list", "list", "int", "int", "int", "int", "list", "list_string", "list"])
    ir_register_struct_layout("Diagnostic", ["severity", "code", "message", "file", "line", "col", "fix"], ["string", "string", "string", "string", "int", "int", "string"])

fn ir_expr_legacy_result_kind(idx: Int) -> String:
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        callee := ir_resolve_static_callee(node.children[0])
        if ir_declared_callable_ir_retkind(callee.name).len() > 0:
            return ""
        return ir_builtin_result_retkind(callee.name)
    if node.kind == "method_call":
        alias_name := ir_resolve_module_alias_method_call_name(idx)
        if alias_name.len() > 0:
            if ir_declared_callable_ir_retkind(alias_name).len() > 0:
                return ""
            return ir_builtin_result_retkind(alias_name)
        obj_type := ir_method_receiver_type(node)
        emit_name := ir_method_emit_name(ir_plain_method_name(node.value), obj_type)
        if ir_declared_callable_ir_retkind(emit_name).len() > 0:
            return ""
        return ir_builtin_result_retkind(emit_name)
    return ""

fn ir_call_retkind(idx: Int, uses_result_abi: Bool) -> String:
    if uses_result_abi:
        node := get_node(idx)
        if node.kind == "call" and node.children.len() > 0:
            callee := ir_resolve_static_callee(node.children[0])
            declared_kind := ir_declared_callable_ir_retkind(callee.name)
            if declared_kind.len() > 0:
                return declared_kind
        if node.kind == "method_call":
            alias_name := ir_resolve_module_alias_method_call_name(idx)
            if alias_name.len() > 0:
                declared_kind := ir_declared_callable_ir_retkind(alias_name)
                if declared_kind.len() > 0:
                    return declared_kind
            obj_type := ir_method_receiver_type(node)
            method_name := ir_plain_method_name(node.value)
            impl_name := ir_lookup_impl_method_for(node.children[0], obj_type, method_name)
            if impl_name.len() > 0:
                declared_kind := ir_declared_callable_ir_retkind(impl_name)
                if declared_kind.len() > 0:
                    return declared_kind
            emit_name := ir_method_emit_name(method_name, obj_type)
            declared_kind := ir_declared_callable_ir_retkind(emit_name)
            if declared_kind.len() > 0:
                return declared_kind
        legacy_kind := ir_expr_legacy_result_kind(idx)
        if legacy_kind.len() > 0:
            return legacy_kind
        result_kind := ir_checked_result_kind(idx)
        if result_kind.len() > 0:
            return result_kind
    return ir_infer_type(idx)

fn ir_call_retkind_for_name(idx: Int, uses_result_abi: Bool, callee_name: String) -> String:
    if uses_result_abi:
        declared_kind := ir_declared_callable_ir_retkind(callee_name)
        if declared_kind.len() > 0:
            return declared_kind
    return ir_call_retkind(idx, uses_result_abi)

fn ir_known_callable_return_type(fname: String) -> String:
    struct_type := ir_known_struct_return_type(fname)
    if struct_type.len() > 0:
        return struct_type
    scalar_type := ir_known_scalar_return_type(fname)
    if scalar_type.len() > 0:
        return scalar_type
    collection_type := ir_known_collection_return_type(fname)
    if collection_type.len() > 0:
        return collection_type
    return ir_declared_callable_return_type(fname)

fn ir_field_receiver_type(recv_idx: Int) -> String:
    mut obj_type := ir_infer_type(recv_idx)
    if obj_type.contains("["):
        base := obj_type.substring(0, obj_type.index_of("["))
        if ir_struct_names.contains_key(base):
            obj_type = base
    if obj_type.len() == 0:
        recv := get_node(recv_idx)
        if recv.kind == "ident" and ir_struct_names.contains_key(recv.value):
            obj_type = recv.value
        # `self` inside a method body resolves to the impl block's target type
        elif recv.kind == "self" and ir_current_impl_type.len() > 0:
            obj_type = ir_current_impl_type
    return obj_type

# emit a struct field read using the checker's authoritative layout: the field's
# position in the struct type gives the offset, its declared type gives the kind.
# this is independent of module emission order, unlike the name-keyed lookup map
# (which is filled as each module is emitted). a struct reached only through
# another module's return type — one the current module never imports — is
# emitted after its user, so it is absent from the map when the user's field
# access is lowered, and the offset falls back to an unsound name-based guess: a
# String field read lands on the wrong slot, silently corrupting the value.
# returns the result register, or -1 when the checker does not type the receiver
# as a plain (non-weak) struct, so the caller falls back to the map path.
fn ir_try_checked_field_read(obj_r: Int, recv_idx: Int, field_name: String) -> Int:
    recv_tid := c_get_expr_type(recv_idx)
    if recv_tid < 0:
        return 0 - 1
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "struct":
        return 0 - 1
    mut field_index := 0 - 1
    for name, i in recv_info.fields:
        if name == field_name:
            field_index = i
    if field_index < 0 or field_index >= recv_info.field_types.len():
        return 0 - 1
    # a weak field needs the optional-synthesizing read path; leave those to the
    # map path, which already handles them.
    if ir_struct_field_is_weak(recv_info.name, field_name):
        return 0 - 1
    field_offset := field_index * 8
    field_kind := ir_type_from_tid(recv_info.field_types[field_index])
    r := ir_reg()
    ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " " + field_offset.to_string() + " " + field_kind + " " + field_name)
    return r

fn ir_known_method_return_type(obj_type: String, meth: String) -> String:
    impl_name := ir_lookup_impl_method_name(obj_type, meth)
    if impl_name.len() > 0:
        declared := ir_declared_callable_return_type(impl_name)
        if declared.len() > 0:
            return declared
    if ir_is_bool_returning_method(meth):
        return "bool"
    string_type := ir_known_string_method_return_type(meth)
    if string_type.len() > 0:
        return string_type
    if meth == "to_float":
        return "float"
    if meth == "len" or meth == "cap":
        return "int"
    if (meth == "slice" or meth == "concat") and obj_type == "bytes":
        return "bytes"
    collection_type := ir_known_collection_method_return_type(obj_type, meth)
    if collection_type.len() > 0:
        return collection_type
    return ""

fn ir_binary_expr_type(node: Node) -> String:
    op := node.value
    if op == "eq" or op == "neq" or op == "lt" or op == "gt" or op == "lte" or op == "gte" or op == "and" or op == "or":
        return "bool"
    if op == "add" or op == "sub" or op == "mul" or op == "div" or op == "mod":
        if node.children.len() >= 2:
            lt := ir_infer_type(node.children[0])
            rt := ir_infer_type(node.children[1])
            if lt == "float" or rt == "float":
                return "float"
            if lt == "string" or rt == "string":
                return "string"
        return "int"
    return "int"

fn ir_index_expr_type(idx: Int, node: Node) -> String:
    checked_index := ir_checked_index_type(idx)
    if checked_index.len() > 0:
        return checked_index
    if node.children.len() == 0:
        return ""
    coll_type := ir_infer_type(node.children[0])
    if coll_type == "string":
        return "string"
    if coll_type == "bytes":
        return "int"
    if coll_type == "list_string":
        return "string"
    if coll_type == "map" or coll_type == "map_int":
        return ir_lookup_map_value_type_for_expr(node.children[0])
    # inside a generic specialization the checked types are suppressed, so
    # indexing a List[T] parameter answers nothing here and the element loses
    # its rc identity — the return path then skips the retain a borrowed
    # element needs, and the caller inherits a value the dying list still
    # owns. resolve the parameter's declared type under the active
    # substitution instead.
    coll_node := get_node(node.children[0])
    if coll_node.kind == "ident":
        elem := ir_spec_param_list_element_type(coll_node.value)
        if elem.len() > 0:
            return elem
    return ""

# the element type of an indexed list parameter inside a generic
# specialization, resolved from the active declaration's type node under the
# T -> concrete substitution. "" when no specialization is active, the name
# is not a parameter of the active declaration, or its type is not a list.
fn ir_spec_param_list_element_type(name: String) -> String:
    if ir_active_generic_params.len() == 0 or ir_active_generic_decl_idx < 0:
        return ""
    decl := get_node(ir_active_generic_decl_idx)
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "param" and cn.value == name:
            for tc in cn.children:
                tn := get_node(tc)
                if tn.kind == "type" or tn.kind == "generic_type":
                    tid := ir_declared_type_node_tid(tc)
                    if tid >= 0:
                        info := get_type_info(tid)
                        if info.kind == "list":
                            return ir_type_from_tid(info.inner)
                    return ""
    return ""

fn ir_call_expr_type(idx: Int, node: Node) -> String:
    if node.children.len() == 0:
        return ""
    callee_node := get_node(node.children[0])
    if callee_node.kind == "ident" and ir_closure_return_kinds.contains_key(callee_node.value):
        return ir_closure_return_kinds[callee_node.value]
    callee := ir_resolve_static_callee(node.children[0])
    if callee.name.len() == 0:
        return ""
    return ir_known_callable_return_type(callee.name)

fn ir_method_expr_type(idx: Int, node: Node) -> String:
    alias_fname := ir_resolve_module_alias_method_call_name(idx)
    if alias_fname.len() > 0:
        return ir_known_callable_return_type(alias_fname)
    mname := ir_plain_method_name(node_value(idx))
    # inside a generic specialization an optional parameter's receiver carries
    # the unspecialized tid, so the extraction methods would answer "unknown".
    # an unknown part in an interpolation is concatenated raw, which for an
    # `Int?` means splicing an integer where a string pointer belongs.
    if node.children.len() > 0 and (mname == "unwrap_or" or mname == "value"):
        generic_recv_tid := ir_generic_param_optional_tid(get_node(node.children[0]))
        if generic_recv_tid >= 0:
            return ir_type_from_tid(get_type_info(generic_recv_tid).inner)
    mut obj_type := ""
    if node.children.len() > 0:
        obj_type = ir_infer_type(node.children[0])
    return ir_known_method_return_type(obj_type, mname)

fn ir_checked_struct_field_type(recv_idx: Int, field_name: String) -> String:
    recv_tid := c_get_expr_type(recv_idx)
    if recv_tid < 0:
        return ""
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "struct":
        return ""
    for name, i in recv_info.fields:
        if name == field_name and i < recv_info.field_types.len():
            return ir_type_from_tid(recv_info.field_types[i])
    return ""

fn ir_field_expr_type(node: Node) -> String:
    if node.children.len() == 0:
        return ""
    fname := node.value
    if fname == "is_ok" or fname == "is_err":
        return "bool"
    if fname == "ok":
        obj_tid := c_get_expr_type(node.children[0])
        if obj_tid >= 0:
            obj_info := get_type_info(obj_tid)
            if obj_info.kind == "result":
                return ir_type_from_tid(obj_info.inner)
    if fname == "err":
        obj_tid := c_get_expr_type(node.children[0])
        if obj_tid >= 0:
            obj_info := get_type_info(obj_tid)
            if obj_info.kind == "result":
                return ir_type_from_tid(obj_info.value_type)
    concrete_field_type := ir_checked_struct_field_type(node.children[0], fname)
    if concrete_field_type.len() > 0:
        return concrete_field_type
    obj_type := ir_field_receiver_type(node.children[0])
    if obj_type.len() == 0:
        return ""
    lookup_key := obj_type + "." + fname
    if ir_struct_field_lookup.contains_key(lookup_key):
        return ir_struct_field_lookup[lookup_key]
    return ""

# --- centralized type inference for AST nodes ---
# Returns: "int", "float", "bool", "string", "list", "list_string",
#          "map", "map_int", "set", "set_int", or "" (unknown)
fn ir_infer_type(idx: Int) -> String:
    # a missing child (an absent optional argument) has index -1;
    # asking its type is a normal question with an unknown answer
    if idx < 0:
        return ""
    checked := ir_checked_type(idx)
    if checked.len() > 0:
        return checked
    node := get_node(idx)
    kind := node_kind(idx)
    literal_type := ir_literal_expr_type(node, kind)
    if literal_type.len() > 0:
        return literal_type
    # identifiers — look up tracked type
    if kind == "ident":
        return ir_lookup_name_type(node.value)
    if kind == "self":
        # use the current impl block's target type so field lookups resolve
        # to the right struct; "struct" is a generic placeholder fallback
        if ir_current_impl_type.len() > 0:
            return ir_current_impl_type
        return "struct"
    # grouped expression — infer inner
    if kind == "grouped" and node.children.len() > 0:
        return ir_infer_type(node.children[0])
    # binary ops
    if kind == "binary":
        return ir_binary_expr_type(node)
    # unary
    if kind == "unary":
        return ir_unary_expr_type(node)
    # function calls
    if kind == "call":
        return ir_call_expr_type(idx, node)
    # method calls
    if kind == "method_call":
        return ir_method_expr_type(idx, node)
    if kind == "field_access":
        return ir_field_expr_type(node)
    if kind == "struct_init":
        return ir_resolve_type_hint(node.value)
    # index — depends on collection type
    if kind == "index" and node.children.len() > 0:
        return ir_index_expr_type(idx, node)
    return ""

fn ir_lookup_name_type(name: String) -> String:
    return ir_lookup_name_type_with_state(name, ir_var_types, ir_global_int_names, ir_global_string_names, ir_global_list_string_names, ir_global_list_names, ir_global_map_int_names, ir_global_map_names, ir_global_set_int_names, ir_global_set_names, ir_global_bool_names)

fn ir_emit_value_for_target(val_idx: Int, target_type: String) -> Int:
    vn := get_node(val_idx)
    if target_type == "tuple":
        if vn.kind == "none_lit":
            return ir_emit_optional_none_value()
        value_r := ir_expr(val_idx)
        actual_tid := c_get_expr_type(val_idx)
        if actual_tid >= 0:
            actual_info := get_type_info(actual_tid)
            if actual_info.kind == "optional" or actual_info.kind == "result" or actual_info.kind == "tuple":
                # a passed-through optional/result/tuple is owned at this
                # position; take a count when it arrives borrowed so the holder
                # can release it. freshly wrapped optionals below are already
                # owned, and the struct-construction site no longer retains
                # tuple-typed fields, so this is the single owning retain.
                if ir_string_expr_is_borrowed(val_idx):
                    ir_rc_retain_reg(value_r, "tuple")
                return value_r
        # in a generic impl body, a method call's checked type is often
        # TID_ERR because the body was checked with the struct's type
        # params suppressed. assume `return <method_call>` from a
        # tuple-returning function already produces the right shape rather
        # than wrap-it-as-Some.
        if ir_current_impl_subst_params.len() > 0 and (vn.kind == "method_call" or vn.kind == "call"):
            return value_r
        # an optional wrapping an rc payload (a struct, list, map, set, bytes, or
        # closure) OWNS it: take a count when the value arrives borrowed, and
        # attach a destructor so the payload is released when the optional dies.
        # this keeps a `Node?` field's target alive instead of dangling. strings
        # stay borrowed (copy-on-derive already keeps them safe).
        payload_kind := ir_rc_kind(ir_infer_type(val_idx))
        if payload_kind == "struct" or payload_kind == "list" or payload_kind == "map" or payload_kind == "set" or payload_kind == "bytes" or payload_kind == "closure":
            if ir_string_expr_is_borrowed(val_idx):
                ir_rc_retain_reg(value_r, payload_kind)
            return ir_emit_optional_owned_some(value_r, payload_kind)
        return ir_emit_optional_some_value(value_r)
    # an empty list whose element type the checker worked out goes through the
    # literal emitter, which picks the container from that element type. the
    # shortcut below only knows the coarse target kind ("list", "list_string"),
    # so it would build an untagged list for a List[Bytes] or List[SomeStruct]
    # field — one that never takes a reference to what is pushed into it.
    # ir_checked_type is empty when the checker has no type for the literal,
    # which is exactly when the shortcut is still the only thing that knows what
    # to build.
    if vn.kind == "list" and vn.children.len() == 0:
        if ir_checked_type(val_idx).starts_with("list"):
            return ir_expr(val_idx)
    empty_init_call := ir_empty_collection_init_call_name(vn.kind, vn.children.len(), target_type)
    if empty_init_call.len() > 0:
        r := ir_reg()
        ir_emit_call0(r, empty_init_call, ir_normalize_collection_target(target_type))
        return r
    return ir_expr(val_idx)

fn ir_checked_target_type(target_idx: Int, fallback_name: String) -> String:
    checked := ir_checked_type(target_idx)
    if checked.len() > 0:
        return checked
    if fallback_name.len() > 0:
        return ir_lookup_name_type(fallback_name)
    return ""

fn ir_method_receiver_type(node: Node) -> String:
    if node.children.len() == 0:
        return ""
    # `self` is always the impl type currently being emitted. reading the
    # checker's recorded type would be wrong for a shared interface-default
    # body, which is type-checked once per implementing type — the last one
    # wins and would misroute self.method() to that type.
    recv0 := get_node(node.children[0])
    if recv0.kind == "self" and ir_current_impl_type.len() > 0:
        return ir_current_impl_type
    recv_tid := c_get_expr_type(node.children[0])
    if recv_tid >= 0:
        recv_info := get_type_info(recv_tid)
        if recv_info.kind == "channel" and recv_info.inner >= 0:
            return "channel:" + ir_type_from_tid(recv_info.inner)
        if recv_info.kind == "task" and recv_info.inner >= 0:
            return "task:" + ir_type_from_tid(recv_info.inner)
        known := ir_type_from_tid(recv_tid)
        if known.len() > 0:
            return ir_substitute_type_name(known)
    checked := ir_checked_type(node.children[0])
    if checked.len() > 0:
        return ir_substitute_type_name(checked)
    inferred := ir_infer_type(node.children[0])
    if inferred.len() > 0:
        return ir_substitute_type_name(inferred)
    # fallback: if the receiver is `self.field` inside an impl method, look
    # up the field's declared type from the impl struct and substitute. this
    # is what lets a specialized MapIter[Range,_,_]_next route self.src.next()
    # to Range_next when the checker recorded self.src as TID_ERR
    recv_node := get_node(node.children[0])
    if recv_node.kind == "field_access" and recv_node.children.len() > 0 and ir_current_impl_type.len() > 0:
        inner := get_node(recv_node.children[0])
        if inner.kind == "self":
            fname := node_value(node.children[0])
            base_struct := ir_strip_type_args(ir_current_impl_type)
            field_key := base_struct + "." + fname
            if ir_struct_field_lookup.contains_key(field_key):
                return ir_substitute_type_name(ir_struct_field_lookup[field_key])
    return ""

# a read of a `weak` field or a `weak` local synthesizes a FRESH borrowing
# optional shell each time (ir_emit_weak_read) — unlike a normal optional,
# which reads the stored value in place. that shell has no destructor and
# holds a borrowed pointer, so releasing it just frees the shell. this
# predicate lets the optional consumers (`.value()`, `!= none`, `?`) free the
# throwaway shell instead of leaking one per read.
fn ir_node_is_weak_field_read(idx: Int) -> Bool:
    node := get_node(idx)
    # a weak LOCAL read — or a read of a weak binding captured into the
    # emitting lambda — mints the same throwaway shell as a weak field read
    # (see ir_emit_ident_load); a loop variable shadowing the name reads its
    # own slot plainly and must not have a shell freed out from under it.
    if node.kind == "ident":
        return ir_name_is_weak_read(node.value)
    if node.kind != "field_access":
        return false
    if node.children.len() == 0:
        return false
    recv_tid := c_get_expr_type(node.children[0])
    if recv_tid < 0:
        return false
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "struct":
        return false
    return ir_struct_field_is_weak(recv_info.name, node_value(idx))

# free a fresh weak-read optional shell after its value has been extracted; the
# shell has no destructor so this reclaims only the 3-slot allocation, leaving the
# borrowed target untouched.
fn ir_release_weak_shell(operand_idx: Int, shell_r: Int):
    if ir_node_is_weak_field_read(operand_idx):
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", shell_r)

fn ir_emit_optional_unwrap(node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    opt_tid := c_get_expr_type(node.children[0])
    weak_shell := ir_node_is_weak_field_read(node.children[0])
    flag_r := ir_optional_flag_field(recv_r)
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
    ir_emit_label(some_l)
    decoded_r := ir_optional_value_field(recv_r, opt_tid)
    if weak_shell:
        # extracted the borrowed target above; the shell is now dead on this path.
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("jmp " + merge_l)
    ir_emit_label(none_l)
    if weak_shell:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    if ir_emit_tests and ir_emitting_test_func:
        ir_test_assert_fail_return()
    else:
        # `?` on a none propagates out of the function, an early exit like a
        # fail: run the deferred statements, then release owned locals, before
        # returning the error tuple.
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        si := ir_str("unwrap of none")
        err_r := ir_reg()
        ir_emit("strref " + err_r.to_string() + " " + si)
        ir_emit_main_error_report(err_r, true)
        ir_emit_ret_err_value(err_r)
    ir_emit_label(merge_l)
    return decoded_r

fn ir_collect_method_call_regs(node: Node) -> List[Int]:
    mut regs: List[Int] := []
    for child, i in node.children:
        if i == 0:
            regs.push(ir_expr(child))
        else:
            child_kind := node_kind(child)
            if child_kind == "arg":
                cn := get_node(child)
                if cn.children.len() > 0:
                    regs.push(ir_emit_call_arg(cn.children[0]))
            else:
                regs.push(ir_emit_call_arg(child))
    return regs

# {x:8.2}-style parts: convert with precision when asked, then pad.
# the spec was validated by the parser, so parsing here is positional.
fn ir_interp_spec_width(spec: String) -> Int:
    mut i := 0
    c0 := spec[0]
    if c0 == "<" or c0 == ">" or c0 == "^":
        i = 1
    if i < spec.len() and spec[i] == "0":
        i = i + 1
    mut w := 0
    mut saw := false
    while i < spec.len() and spec[i] != ".":
        w = w * 10 + (ord(spec[i]) - 48)
        saw = true
        i = i + 1
    if not saw:
        return 0 - 1
    return w

fn ir_interp_spec_precision(spec: String) -> Int:
    dot := spec.index_of(".")
    if dot < 0:
        return 0 - 1
    mut p := 0
    mut i := dot + 1
    while i < spec.len():
        p = p * 10 + (ord(spec[i]) - 48)
        i = i + 1
    return p

ALIGN_LEFT_BYTE := 60 # '<'
ALIGN_CENTER_BYTE := 94 # '^'
ALIGN_RIGHT_BYTE := 62 # '>'
FILL_ZERO_BYTE := 48 # '0'
FILL_SPACE_BYTE := 32 # ' '

fn ir_interp_spec_align(spec: String) -> Int:
    c0 := spec[0]
    if c0 == "<":
        return ALIGN_LEFT_BYTE
    if c0 == "^":
        return ALIGN_CENTER_BYTE
    return ALIGN_RIGHT_BYTE

fn ir_interp_spec_fill(spec: String) -> Int:
    mut i := 0
    c0 := spec[0]
    if c0 == "<" or c0 == ">" or c0 == "^":
        i = 1
    if i < spec.len() and spec[i] == "0":
        return FILL_ZERO_BYTE
    return FILL_SPACE_BYTE

fn ir_emit_interp_spec_part(node: Node) -> Int:
    spec := node.value
    expr_idx := node.children[0]
    prec := ir_interp_spec_precision(spec)
    part_type := ir_infer_type(expr_idx)
    mut str_r := 0 - 1
    if prec >= 0 and part_type == "float":
        raw_r := ir_expr(expr_idx)
        prec_r := ir_reg()
        ir_emit("iconst " + prec_r.to_string() + " " + prec.to_string())
        str_r = ir_reg()
        ir_emit_call2(str_r, "float_format", "string", raw_r, prec_r)
    else:
        str_r = ir_string_interp_expr_part(expr_idx)
    width := ir_interp_spec_width(spec)
    if width <= 0:
        return str_r
    w_r := ir_reg()
    ir_emit("iconst " + w_r.to_string() + " " + width.to_string())
    a_r := ir_reg()
    ir_emit("iconst " + a_r.to_string() + " " + ir_interp_spec_align(spec).to_string())
    f_r := ir_reg()
    ir_emit("iconst " + f_r.to_string() + " " + ir_interp_spec_fill(spec).to_string())
    padded_r := ir_reg()
    ir_emit("call " + padded_r.to_string() + " format_pad string 4 " + str_r.to_string() + " " + w_r.to_string() + " " + a_r.to_string() + " " + f_r.to_string())
    # the unpadded intermediate is garbage once copied, unless it was a
    # borrowed string passed straight through
    if ir_infer_type(node.children[0]) != "string" or not ir_string_expr_is_borrowed(node.children[0]):
        ir_string_release_reg(str_r)
    return padded_r

fn ir_string_interp_expr_part(expr_idx: Int) -> Int:
    mut part_r := ir_expr(expr_idx)
    part_tid := c_get_expr_type(expr_idx)
    part_type := ir_infer_type(expr_idx)
    if part_type == "string":
        return part_r
    if part_type == "bool":
        converted := ir_reg()
        ir_emit_call1(converted, "bool_to_string", "string", part_r)
        return converted
    if part_type == "float":
        converted := ir_reg()
        ir_emit_call1(converted, "float_to_string", "string", part_r)
        return converted
    if part_type == "int":
        converted := ir_reg()
        ir_emit_call1(converted, "int_to_string", "string", part_r)
        return converted
    if part_tid >= 0:
        part_info := get_type_info(part_tid)
        if part_info.kind == "result":
            return ir_emit_result_value_to_string(part_r, part_tid)
        if part_info.kind == "list":
            return ir_emit_display_list(part_r, ir_type_from_tid(part_info.inner), false)
        if part_info.kind == "map":
            return ir_emit_display_map(part_r, ir_type_from_tid(part_info.key_type), ir_type_from_tid(part_info.value_type))
        if part_info.kind == "set":
            converted := ir_reg()
            ir_emit_call1(converted, "__set_to_list", "list", part_r)
            return ir_emit_display_list(converted, ir_type_from_tid(part_info.inner), true)
    if part_type.len() > 0 and ir_struct_names.contains_key(part_type):
        if not ir_boxed_enums.contains_key(part_type):
            return ir_emit_display_struct(part_r, part_type)
    return part_r

# kind codes shared with the runtime display helpers:
# 0=int, 1=float, 2=bool, 3=string
fn ir_display_kind_code(kind: String) -> Int:
    if kind == "float":
        return 1
    if kind == "bool":
        return 2
    if kind == "string":
        return 3
    return 0

fn ir_emit_display_list(list_r: Int, elem_kind: String, sorted: Bool) -> Int:
    kind_r := ir_reg()
    ir_emit("iconst " + kind_r.to_string() + " " + ir_display_kind_code(elem_kind).to_string())
    sort_r := ir_reg()
    mut sort_flag := "0"
    if sorted:
        sort_flag = "1"
    ir_emit("iconst " + sort_r.to_string() + " " + sort_flag)
    r := ir_reg()
    ir_emit_call3(r, "pith_display_list", "string", list_r, kind_r, sort_r)
    return r

fn ir_emit_display_map(map_r: Int, key_kind: String, val_kind: String) -> Int:
    kk_r := ir_reg()
    ir_emit("iconst " + kk_r.to_string() + " " + ir_display_kind_code(key_kind).to_string())
    vk_r := ir_reg()
    ir_emit("iconst " + vk_r.to_string() + " " + ir_display_kind_code(val_kind).to_string())
    r := ir_reg()
    ir_emit_call3(r, "pith_display_map", "string", map_r, kk_r, vk_r)
    return r

# a struct in interpolation renders through its show() impl when one
# exists; otherwise as "Name(field: value, ...)" with scalar and string
# fields formatted and anything deeper shown as "...".
fn ir_emit_display_struct(obj_r: Int, struct_name: String) -> Int:
    show_name := ir_lookup_impl_method_name(struct_name, "show")
    if show_name.len() > 0:
        r := ir_reg()
        ir_emit_call1(r, show_name, "string", obj_r)
        return r
    mut acc_r := ir_reg()
    ir_emit("strref " + acc_r.to_string() + " " + ir_str(struct_name + "("))
    total := ir_struct_field_count(struct_name)
    mut fi := 0
    while fi < total:
        field_name := ir_struct_field_name_at(struct_name, fi)
        field_kind := ir_struct_field_type_name(struct_name, field_name)
        mut label := field_name + ": "
        if fi > 0:
            label = ", " + field_name + ": "
        label_r := ir_reg()
        ir_emit("strref " + label_r.to_string() + " " + ir_str(label))
        with_label := ir_reg()
        ir_emit("concat " + with_label.to_string() + " " + acc_r.to_string() + " " + label_r.to_string())
        ir_string_release_reg(acc_r)
        field_r := ir_reg()
        ir_emit("field " + field_r.to_string() + " " + obj_r.to_string() + " " + (fi * 8).to_string() + " " + field_kind + " " + field_name)
        mut text_r := field_r
        if field_kind == "int":
            text_r = ir_reg()
            ir_emit_call1(text_r, "int_to_string", "string", field_r)
        elif field_kind == "float":
            text_r = ir_reg()
            ir_emit_call1(text_r, "float_to_string", "string", field_r)
        elif field_kind == "bool":
            text_r = ir_reg()
            ir_emit_call1(text_r, "bool_to_string", "string", field_r)
        elif field_kind != "string":
            text_r = ir_reg()
            ir_emit("strref " + text_r.to_string() + " " + ir_str("..."))
        next_acc := ir_reg()
        ir_emit("concat " + next_acc.to_string() + " " + with_label.to_string() + " " + text_r.to_string())
        ir_string_release_reg(with_label)
        if field_kind == "int" or field_kind == "float" or field_kind == "bool":
            ir_string_release_reg(text_r)
        acc_r = next_acc
        fi = fi + 1
    close_r := ir_reg()
    ir_emit("strref " + close_r.to_string() + " " + ir_str(")"))
    out_r := ir_reg()
    ir_emit("concat " + out_r.to_string() + " " + acc_r.to_string() + " " + close_r.to_string())
    ir_string_release_reg(acc_r)
    return out_r

# the runtime tag telling a closure how to release a captured slot when
# the closure is freed. matches the CLOSURE_TAG_* constants in the
# runtime; 0 means a plain value with nothing to release.
fn ir_closure_capture_tag(kind: String) -> Int:
    if kind == "string":
        return 1
    if kind == "list":
        return 2
    if kind == "map":
        return 3
    if kind == "set":
        return 4
    if kind == "bytes":
        return 5
    if kind == "struct":
        return 6
    # a tuple (an optional, result, or tuple literal) is a struct-header
    # allocation, so the struct tag releases it correctly — through
    # pith_struct_release and the box's own attached dtor. without this
    # the capture retains the box (ir_rc_retain_reg handles "tuple") but
    # tags it 0, so the closure never lets go of it.
    if kind == "tuple":
        return 6
    if kind == "closure":
        return 7
    if kind == "weak":
        return 8
    return 0

fn ir_emit_lambda_capture_setup(closure_r: Int, captures: List[String]):
    for capture_name, i in captures:
        cap_val := ir_reg()
        # this reads the enclosing scope, so a captured loop variable has to
        # come from the loop's own slot, not the function local it shadows.
        # for a weak local this hands over the BARE target pointer — the
        # slot's raw value, not a liveness-resolved optional — which is the
        # whole point: the closure refers to the target without owning it.
        ir_emit_name_load(cap_val, capture_name)
        slot := ir_reg()
        ir_emit("iconst " + slot.to_string() + " " + i.to_string())
        # the closure environment keeps its own count on captured rc values
        # so the origin scope's cleanup cannot pull them out from under it;
        # the tag lets the closure drop that count when it is freed. a weak
        # local overrides the type-derived kind: its type reads optional,
        # but the slot holds a raw pointer counted on the WEAK count, so the
        # closure takes (and later drops) a weak reference instead.
        mut cap_kind := ir_rc_kind(ir_lookup_name_type(capture_name))
        if ir_name_is_weak_read(capture_name):
            cap_kind = "weak"
        if cap_kind.len() > 0:
            ir_rc_retain_reg(cap_val, cap_kind)
            tag_r := ir_reg()
            ir_emit("iconst " + tag_r.to_string() + " " + ir_closure_capture_tag(cap_kind).to_string())
            ir_emit_call_text(ir_reg(), "pith_closure_set_env_rc", "void", 4, " " + closure_r.to_string() + " " + slot.to_string() + " " + cap_val.to_string() + " " + tag_r.to_string())
        else:
            ir_emit_call3(ir_reg(), "__closure_set_env", "void", closure_r, slot, cap_val)

fn ir_emit_lambda_hidden_param():
    closure_r := ir_reg()
    ir_var_regs.insert("__closure", closure_r)
    ir_emit("param __closure")

fn ir_emit_lambda_capture_loads(captures: List[String]):
    closure_r := ir_var_regs["__closure"]
    for capture_name, i in captures:
        cap_r := ir_reg()
        slot_r := ir_reg()
        ir_emit("iconst " + slot_r.to_string() + " " + i.to_string())
        ir_emit_call2(cap_r, "__closure_get_env", "unknown", closure_r, slot_r)
        ir_var_regs.insert(capture_name, cap_r)
        ir_emit("store " + capture_name + " " + cap_r.to_string())

fn ir_append_deferred_lambda_body():
    lines := ir_builder_lines()
    mut bodies: List[String] := ir_lambda_bodies
    for line in lines:
        bodies.push(line)
    ir_lambda_bodies = bodies

fn ir_emit_unary_expr(node: Node) -> Int:
    operand_r := ir_expr(node.children[0])
    return ir_emit_unary_op(node.value, operand_r)

fn ir_emit_binary_neq(result_reg: Int, left_r: Int, right_r: Int, is_str_op: Bool, is_bytes_op: Bool):
    if is_str_op:
        eq_r := ir_reg()
        ir_emit_call2(eq_r, "__str_eq", "bool", left_r, right_r)
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        ir_emit("sub " + result_reg.to_string() + " " + one_r.to_string() + " " + eq_r.to_string())
        return
    if is_bytes_op:
        eq_r := ir_reg()
        ir_emit_call2(eq_r, "bytes_eq", "bool", left_r, right_r)
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        ir_emit("sub " + result_reg.to_string() + " " + one_r.to_string() + " " + eq_r.to_string())
        return
    ir_emit("neq " + result_reg.to_string() + " " + left_r.to_string() + " " + right_r.to_string())

# an owned string operand (a fresh char from s[i], a concat result, a
# fresh method result) dies once the operation that consumed it emits.
# this is the loop-condition reclaim: `while s[i] == ":"` builds a fresh
# char every iteration, and the release lands in the same block as the
# compare, so dominance is never in question.
# true only for s[i] with a string receiver: that lowers to char_at,
# which always mints a fresh one-char string. everything else keeps the
# general borrowed-by-default classification.
fn ir_expr_is_fresh_string_index(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "index" or node.children.len() == 0:
        return false
    # inside generic or specialized bodies the checked types are suppressed
    # and inference can misname a map or list receiver as a string; a wrong
    # answer here frees a container's element, so freshness requires the
    # non-generic certainty path.
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return false
    # replicate ir_emit_index_expr's dispatch exactly: checked type first,
    # inference as fallback.
    mut obj_type := ir_checked_type(node.children[0])
    if obj_type.len() == 0:
        obj_type = ir_infer_type(node.children[0])
    return obj_type == "string"

fn ir_binary_op_is_comparison(simple_op: String) -> Bool:
    return simple_op == "lt" or simple_op == "gt" or simple_op == "lte" or simple_op == "gte"

fn ir_release_owned_string_operand(expr_idx: Int, reg: Int, expr_type: String):
    if expr_type == "string" and not ir_string_expr_is_borrowed(expr_idx):
        ir_string_release_reg(reg)
    elif expr_type == "bytes" and not ir_string_expr_is_borrowed(expr_idx):
        ir_rc_release_reg(reg, "bytes")
    elif ir_expr_is_fresh_string_index(expr_idx):
        # loop-condition reclaim: `while s[i] == ":"` mints a fresh char
        # per iteration; it dies with the compare, in the same block
        ir_string_release_reg(reg)
    elif ir_expr_is_transferred_call_temp(expr_idx):
        # a call result in comparison position is a transferred count
        # nothing else references: `c == chr(9)` leaked one string per
        # iteration. user returns transfer, and runtime string builders
        # (chr, conversions) mint fresh buffers.
        ir_string_release_reg(reg)
    else:
        # an owned struct/closure/collection argument dies when the call it
        # fed returns, exactly like an owned string (docs/ownership.md): the
        # callee borrowed it and a storing callee took its own count, so the
        # caller releases the count it still holds. a borrowed arg (a
        # variable/field/element the caller keeps) is not released; a fresh
        # literal (a list, a map, a struct init, a lambda) or a transferred
        # result is.
        mut arg_kind := ir_rc_kind(expr_type)
        # a fn type has no rc kind of its own, but the value in the register
        # is a closure handle either way: a lambda literal, or a named
        # function the ident load wrapped into one.
        if arg_kind.len() == 0 and (get_node(expr_idx).kind == "lambda" or ir_expr_is_named_function_value(expr_idx)):
            arg_kind = "closure"
        if ir_owned_arg_kind_releases(arg_kind) and not ir_string_expr_is_borrowed(expr_idx):
            ir_rc_release_reg(reg, arg_kind)

# the rc kinds an owned call argument hands back once the call returns.
#
# containers belong here for the same reason structs and closures do: a
# `[1, 2]`, a `{"k": v}` or an `xs.map(f)` written straight into a call is an
# allocation nothing else names, and a callee that keeps it adds a count of its
# own — a parameter is a borrow, so a store retains and a returned parameter is
# retained on the way out. leaving the container kinds off this list is what
# made every such call strand its handle for the life of the process, about 165
# bytes per list argument and 400 per map.
#
# "tuple" is deliberately absent and has to stay off. an optional and a result
# both lower to a tuple shell, so the kind does not say whether the register
# holds a real tuple literal or a wrapper whose ownership the result and
# optional extraction paths settle instead — ir_emit_struct_positional_init
# excludes tuple from its field retain for the same reason. releasing one here
# would drop a count those paths still hand on. a tuple literal written into an
# argument therefore still leaks its box.
#
# "string" and "bytes" never reach here: the branches above claim them first,
# because a fresh string has shapes (an s[i] char, a concat) that no rc kind
# describes.
fn ir_owned_arg_kind_releases(arg_kind: String) -> Bool:
    if arg_kind == "struct" or arg_kind == "closure":
        return true
    return arg_kind == "list" or arg_kind == "map" or arg_kind == "set"

# a fresh optional written straight into a call argument — `take(mk(i))` —
# is a transferred shell nothing else names, and it used to strand its
# 64-byte box on every call. the general release above must keep "tuple"
# excluded because the kind alone cannot tell a wrapper from a tuple
# literal, but when the argument expression is itself a call the register
# is a wrapper the caller alone owns, and the same body walk that
# qualifies a named tuple local's call argument can prove the callee
# leaves the caller sole owner. a qualifying argument releases through
# the cascade helper — live payload first, then the shell — right after
# the call returns; anything the walk cannot prove keeps the leak, which
# can never free a live value.
#
# extractions inside the callee are the one wrinkle: the optional
# unwrap_or transfers the borrowed shell's payload count out, so a callee
# that extracts disqualifies an rc-payload optional — but a payload with
# no rc kind has no count to move, so extraction is harmless there and
# the walk runs with its extraction clauses open. results stay excluded
# entirely for now: they ride a different return abi in places, and the
# measured leak is the optional shape.
fn ir_release_fresh_optional_arg(node: Node, arg_pos: Int, arg_name: String, expr_idx: Int, reg: Int):
    en := get_node(expr_idx)
    if en.kind != "call" and en.kind != "method_call":
        return
    # inside generic or specialized bodies the checked types are suppressed
    # and a wrong answer here frees a register that is not a shell
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return
    info := get_type_info(tid)
    if info.kind != "optional":
        return
    sig := ir_tuple_cascade_signature(tid)
    if not ir_tuple_call_arg_is_borrow(node, arg_pos, arg_name, sig == "00"):
        return
    if not ir_tuple_cascade_sigs.contains(sig):
        ir_tuple_cascade_sigs.push(sig)
    ir_emit_call1(ir_reg(), ir_tuple_cascade_helper_name(sig), "void", reg)

# true for call and method-call results whose checked or inferred type is
# string, outside generic bodies where the types cannot be trusted.
fn ir_expr_is_transferred_call_temp(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "call" and node.kind != "method_call":
        return false
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return false
    mut expr_type := ir_checked_type(idx)
    if expr_type.len() == 0:
        expr_type = ir_infer_type(idx)
    return expr_type == "string"

# the byte value (0-255) of a single-character string literal, or -1 if the
# literal is empty, multi-character, or a non-ascii/unknown escape. `raw` is the
# literal's source form *including its surrounding quotes* — e.g. `"/"` (three
# chars) or `"\n"` (four) — so it must be unquoted and unescaped before its
# length means anything. only the escapes a byte scanner actually compares
# against are decoded; anything else falls back to the normal string path.
fn ir_string_lit_single_byte(raw: String) -> Int:
    n := raw.len()
    if n < 3:
        return 0 - 1
    inner_len := n - 2
    if inner_len == 1:
        # a plain character; a lone backslash is an incomplete escape, not a byte
        c := raw[1]
        if c == "\\":
            return 0 - 1
        return ord(c)
    if inner_len == 2 and raw[1] == "\\":
        e := raw[2]
        if e == "n":
            return 10
        if e == "t":
            return 9
        if e == "r":
            return 13
        if e == "0":
            return 0
        if e == "\\":
            return 92
        if e == "\"":
            return 34
        if e == "'":
            return 39
    return 0 - 1

# a register holding one byte of string content as an integer, or -1
# when the expression can't be read as a byte. covers s[i] on strings
# (an allocation-free byte_at instead of a fresh one-char string),
# single-character literals, and chr(n) with a literal argument.
fn ir_emit_byte_operand(idx: Int) -> Int:
    node := get_node(idx)
    if node.kind == "index" and node.children.len() >= 2:
        if ir_expr_is_fresh_string_index(idx):
            obj_r := ir_expr(node.children[0])
            idx_r := ir_expr(node.children[1])
            r := ir_reg()
            # by its runtime symbol, not the short `byte_at` key: this is the
            # emitter's own lowering of `ord(s[i])`, and a user function named
            # `byte_at` must not be able to capture it — nor be captured by it.
            ir_emit_call2(r, "pith_cstring_byte_at", "int", obj_r, idx_r)
            return r
        return 0 - 1
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        b := ir_string_lit_single_byte(node.value)
        if b >= 0:
            r := ir_reg()
            ir_emit("iconst " + r.to_string() + " " + b.to_string())
            return r
        return 0 - 1
    if node.kind == "call" and node.children.len() >= 2:
        callee := get_node(node.children[0])
        arg := get_node(node.children[1])
        if callee.kind == "ident" and callee.value == "chr" and arg.kind == "int_lit":
            r := ir_reg()
            ir_emit("iconst " + r.to_string() + " " + arg.value)
            return r
    return 0 - 1

# `s[i] == ":"` compares one byte against one byte: read both sides as
# integers and skip the two string allocations plus their rc traffic.
# at least one side must be an index — the scanner-loop shape this
# exists for.
fn ir_is_byte_operand(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "index" and node.children.len() >= 2:
        return ir_expr_is_fresh_string_index(idx)
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return ir_string_lit_single_byte(node.value) >= 0
    if node.kind == "call" and node.children.len() >= 2:
        callee := get_node(node.children[0])
        arg := get_node(node.children[1])
        return callee.kind == "ident" and callee.value == "chr" and arg.kind == "int_lit"
    return false

fn ir_try_emit_byte_compare(node: Node, op: String) -> Int:
    left := get_node(node.children[0])
    right := get_node(node.children[1])
    if left.kind != "index" and right.kind != "index":
        return 0 - 1
    if ir_infer_type(node.children[0]) != "string" or ir_infer_type(node.children[1]) != "string":
        return 0 - 1
    if not ir_is_byte_operand(node.children[0]) or not ir_is_byte_operand(node.children[1]):
        return 0 - 1
    left_b := ir_emit_byte_operand(node.children[0])
    right_b := ir_emit_byte_operand(node.children[1])
    r := ir_reg()
    if op == "eq":
        ir_emit("eq " + r.to_string() + " " + left_b.to_string() + " " + right_b.to_string())
    else:
        ir_emit("neq " + r.to_string() + " " + left_b.to_string() + " " + right_b.to_string())
    return r

# Short-circuit `and` / `or`. Pith's other IR operators lower with both
# operands eagerly evaluated, but that means guards like
# `if i == 0 or item != list[i-1]` still index `list[-1]` on the LHS-true
# path. Emit a labeled branch instead so the RHS only runs when the LHS
# doesn't decide the result.
#
#   or:  eval L; if L => merge (result = L); else => eval R (result = R)
#   and: eval L; if L => eval R (result = R); else => merge (result = L)
fn ir_emit_short_circuit_logic(node: Node) -> Int:
    op := node.value
    temp_name := ir_new_temp_name(op)
    default_r := ir_reg()
    ir_emit("iconst " + default_r.to_string() + " 0")
    ir_emit("store " + temp_name + " " + default_r.to_string())
    left_r := ir_expr(node.children[0])
    ir_emit("store " + temp_name + " " + left_r.to_string())
    right_l := ir_label()
    merge_l := ir_label()
    if op == "or":
        ir_emit("brif " + left_r.to_string() + " " + merge_l + " " + right_l)
    else:
        ir_emit("brif " + left_r.to_string() + " " + right_l + " " + merge_l)
    ir_emit("label " + right_l)
    right_r := ir_expr(node.children[1])
    ir_emit("store " + temp_name + " " + right_r.to_string())
    ir_emit("label " + merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# For an operand node, return the concrete Optional tid when the node is
# a param identifier whose substituted type is Optional. Returns -1
# otherwise. The tid comes from the arg-tid map populated at spec entry —
# the emission-kind concrete_types list flattens Optional to "tuple" and
# would lose the inner type, so we route through the arg tids recorded at
# call sites.
fn ir_generic_param_optional_tid(operand_node: Node) -> Int:
    if operand_node.kind != "ident":
        return - 1
    name := operand_node.value
    if not ir_active_param_optional_tids.contains_key(name):
        return - 1
    return ir_active_param_optional_tids[name]

fn ir_emit_binary_expr(node: Node) -> Int:
    if node.value == "eq" or node.value == "neq":
        # `none == none` is decided without building either operand. both
        # sides now lower to a fresh optional tuple, so comparing the emitted
        # values would compare two heap addresses and answer false.
        both_none_r := ir_try_emit_none_to_none_compare(node)
        if both_none_r >= 0:
            return both_none_r
        fast_r := ir_try_emit_byte_compare(node, node.value)
        if fast_r >= 0:
            return fast_r
    if node.value == "and" or node.value == "or":
        return ir_emit_short_circuit_logic(node)
    left_r := ir_emit_binary_operand(node.children[0], node.value)
    right_r := ir_emit_binary_operand(node.children[1], node.value)
    r := ir_reg()
    # Optional-typed `==` / `!=` compares by (is_some, value), not by pointer
    # identity, and has several shapes; try it before the value operators.
    opt_r := ir_emit_optional_binary_compare(node, r, left_r, right_r)
    if opt_r >= 0:
        return opt_r
    return ir_emit_value_binary(node, r, left_r, right_r)

# emit one operand of a binary expression. a bare `none` under `==` / `!=` is
# the exception: every comparison shape below reads the *other* side and only
# needs the none operand to occupy a register, so building the optional tuple
# for it would allocate one per comparison and drop it unread — `x != none` in
# a loop leaked an optional a round.
fn ir_emit_binary_operand(idx: Int, op: String) -> Int:
    if op == "eq" or op == "neq":
        if node_kind(idx) == "none_lit":
            return ir_emit_zero_value()
    return ir_expr(idx)

# `none == none` / `none != none`, answered as a constant. returns -1 when
# either side is anything other than a bare `none`.
fn ir_try_emit_none_to_none_compare(node: Node) -> Int:
    if node.children.len() < 2:
        return 0 - 1
    if node_kind(node.children[0]) != "none_lit":
        return 0 - 1
    if node_kind(node.children[1]) != "none_lit":
        return 0 - 1
    r := ir_reg()
    if node.value == "eq":
        ir_emit("iconst " + r.to_string() + " 1")
    else:
        ir_emit("iconst " + r.to_string() + " 0")
    return r

# `==` / `!=` where at least one operand is an Optional. A raw pointer eq would
# compare heap addresses, so compare by (is_some, value) instead. Covers a none
# literal against an optional, `T? == T?`, and the two generic forms where the
# operand's optional type is invisible to the checker — inside a generic impl
# body (parameters suppressed at registration) or a generic specialization (the
# tid is still the un-specialized marker). Returns -1 when neither operand is an
# optional comparison, leaving the value-operator path to handle it.
fn ir_emit_optional_binary_compare(node: Node, r: Int, left_r: Int, right_r: Int) -> Int:
    op := node.value
    left_tid := c_get_expr_type(node.children[0])
    right_tid := c_get_expr_type(node.children[1])
    left_info := get_type_info(left_tid)
    right_info := get_type_info(right_tid)
    left_node := get_node(node.children[0])
    right_node := get_node(node.children[1])
    if op == "eq" or op == "neq":
        if left_node.kind == "none_lit" and right_info.kind == "optional":
            ir_emit_optional_none_compare(r, op, right_r)
            ir_release_weak_shell(node.children[1], right_r)
            return r
        if right_node.kind == "none_lit" and left_info.kind == "optional":
            ir_emit_optional_none_compare(r, op, left_r)
            ir_release_weak_shell(node.children[0], left_r)
            return r
        # in a generic impl body, the non-none side's type may be TID_ERR
        # because the struct's type parameters were suppressed at registration;
        # treat `expr == none` / `expr != none` as an optional comparison anyway
        if ir_current_impl_subst_params.len() > 0:
            if left_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, right_r)
                return r
            if right_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, left_r)
                return r
        # T? == T?: raw pointer eq would compare heap addresses, not contents.
        # Compare by (is_some, value) so callers can put an Optional inside
        # assert_eq or a generic container without silently getting identity.
        # Optional type ids are not interned (add_type_info doesn't dedupe),
        # so match by inner type rather than by tid.
        if left_info.kind == "optional" and right_info.kind == "optional" and left_info.inner >= 0 and left_info.inner == right_info.inner:
            ir_emit_optional_optional_compare(r, op, left_r, right_r, left_tid)
            return r
        # Inside a generic specialization the check-time tid is the un-
        # specialized generic marker, so left_info.kind isn't "optional"
        # even when the concrete substituted type is. Recover the tid from
        # the per-spec param map and dispatch structurally. Match by inner
        # type since add_type_info doesn't intern (the two params get
        # different Optional tids for the same shape).
        if ir_active_param_optional_tids.len() > 0:
            gen_left_tid := ir_generic_param_optional_tid(left_node)
            gen_right_tid := ir_generic_param_optional_tid(right_node)
            if gen_left_tid >= 0 and gen_right_tid >= 0:
                lg := get_type_info(gen_left_tid)
                rg := get_type_info(gen_right_tid)
                if lg.inner >= 0 and lg.inner == rg.inner:
                    ir_emit_optional_optional_compare(r, op, left_r, right_r, gen_left_tid)
                    return r
            if gen_left_tid >= 0 and right_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, left_r)
                return r
            if gen_right_tid >= 0 and left_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, right_r)
                return r
    return 0 - 1

# The scalar / string / bytes value operators: float arithmetic, string concat
# and ordered comparison (which call the runtime rather than compare pointers),
# enum structural equality, and the plain integer binops. Emits into r (already
# allocated by the caller so register numbering is stable) and returns it.
fn ir_emit_value_binary(node: Node, r: Int, left_r: Int, right_r: Int) -> Int:
    op := node.value
    left_type := ir_infer_type(node.children[0])
    right_type := ir_infer_type(node.children[1])
    is_str_op := left_type == "string" or right_type == "string"
    is_bytes_op := left_type == "bytes" and right_type == "bytes"
    is_float_op := left_type == "float" or right_type == "float"
    if is_float_op and ir_is_float_arithmetic(op):
        ir_emit_float_binary(r, op, left_r, right_r)
        return r
    if op == "add" and is_str_op:
        ir_emit("concat " + r.to_string() + " " + left_r.to_string() + " " + right_r.to_string())
        # owned operands (nested concats, interpolations, fresh method
        # results) are garbage once copied into the new buffer; borrowed
        # operands keep their owner's count. literals release as no-ops.
        ir_release_owned_string_operand(node.children[0], left_r, left_type)
        ir_release_owned_string_operand(node.children[1], right_r, right_type)
    elif op == "eq":
        if is_str_op:
            ir_emit_call2(r, "__str_eq", "bool", left_r, right_r)
            ir_release_owned_string_operand(node.children[0], left_r, left_type)
            ir_release_owned_string_operand(node.children[1], right_r, right_type)
        elif is_bytes_op:
            ir_emit_call2(r, "bytes_eq", "bool", left_r, right_r)
        elif ir_binary_enum_eq_name(node) != "":
            # boxed enum values are pointers; a raw eq is identity, not
            # equality — call the per-enum structural helper
            ir_emit_call2(r, "__enum_eq_" + ir_binary_enum_eq_name(node), "bool", left_r, right_r)
        else:
            ir_emit_simple_binary(r, "eq", left_r, right_r)
    elif op == "neq":
        if ir_binary_enum_eq_name(node) != "":
            eq_r := ir_reg()
            ir_emit_call2(eq_r, "__enum_eq_" + ir_binary_enum_eq_name(node), "bool", left_r, right_r)
            zr := ir_reg()
            ir_emit("iconst " + zr.to_string() + " 0")
            ir_emit("eq " + r.to_string() + " " + eq_r.to_string() + " " + zr.to_string())
        else:
            ir_emit_binary_neq(r, left_r, right_r, is_str_op, is_bytes_op)
            if is_str_op:
                ir_release_owned_string_operand(node.children[0], left_r, left_type)
                ir_release_owned_string_operand(node.children[1], right_r, right_type)
    else:
        simple_op := ir_binary_simple_ir_op(op)
        if simple_op.len() > 0:
            if is_str_op and ir_binary_op_is_comparison(simple_op):
                # ordered string comparison calls the runtime: the simple
                # op would compare the two pointers, which "works" only by
                # allocation-address luck
                if simple_op == "lt":
                    ir_emit_call2(r, "pith_cstring_lt", "bool", left_r, right_r)
                elif simple_op == "lte":
                    ir_emit_call2(r, "pith_cstring_lte", "bool", left_r, right_r)
                elif simple_op == "gt":
                    ir_emit_call2(r, "pith_cstring_lt", "bool", right_r, left_r)
                else:
                    ir_emit_call2(r, "pith_cstring_lte", "bool", right_r, left_r)
                ir_release_owned_string_operand(node.children[0], left_r, left_type)
                ir_release_owned_string_operand(node.children[1], right_r, right_type)
            else:
                ir_emit_simple_binary(r, simple_op, left_r, right_r)
        else:
            ir_emit("binop " + r.to_string() + " " + op + " " + left_r.to_string() + " " + right_r.to_string())
    return r

# a violated assertion ends the process. under the test runner that process is
# the child running one test, so the parent records a failure and the remaining
# tests still run; in an ordinary build it is the program, because carrying on
# past an invariant the code just declared is the silent-wrong this language
# refuses. the two cases lower the same way, which is what lets an assertion sit
# in a helper called from either.
fn ir_test_assert_fail():
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    exit_r := ir_reg()
    ir_emit_call1(exit_r, "exit", "unknown", one_r)

fn ir_test_assert_fail_return():
    ir_test_assert_fail()
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("ret " + one_r.to_string())

fn ir_assert_eq_operand_type(node: Node, child_idx: Int) -> String:
    if node.children.len() <= child_idx:
        return ""
    mut expr_idx := node.children[child_idx]
    child_node := get_node(expr_idx)
    if child_node.kind == "arg" and child_node.children.len() > 0:
        expr_idx = child_node.children[0]
    return ir_infer_type(expr_idx)

fn ir_emit_test_assert(arg_regs: List[Int]) -> Int:
    ok_l := ir_label()
    fail_l := ir_label()
    ir_emit("brif " + arg_regs[0].to_string() + " " + ok_l + " " + fail_l)
    ir_emit_label(fail_l)
    assert_r := ir_reg()
    ir_emit_call1(assert_r, "assert", "unknown", arg_regs[0])
    ir_test_assert_fail()
    ir_emit_label(ok_l)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

# the kind that drives assert_eq's value comparison and its decoded failure
# message. string wins so a string-vs-int typo still compares as text; otherwise
# the most specific known collection/scalar kind is used.
fn ir_assert_eq_kind(left: String, right: String) -> String:
    if left == "string" or right == "string":
        return "string"
    if left == "bytes" or right == "bytes":
        return "bytes"
    if left == "list_string" or right == "list_string":
        return "list_string"
    if left == "list" or right == "list":
        return "list"
    if left == "float" or right == "float":
        return "float"
    if left == "bool" or right == "bool":
        return "bool"
    return "int"

# the kind code pith_assert_eq_fail uses to decode both sides for the message.
fn ir_assert_eq_kind_code(kind: String) -> Int:
    if kind == "float":
        return 1
    if kind == "string":
        return 2
    if kind == "bytes":
        return 3
    if kind == "bool":
        return 4
    if kind == "list":
        return 5
    if kind == "list_string":
        return 6
    return 0

# assert_eq and assert_ne share every line but which branch of the comparison
# is the failing one and which reporter decodes it. keeping them together is
# what stops the pair drifting apart: assert_ne used to lower to a bare runtime
# call that compared handles and did not exit, so it passed on equal strings and
# failed on equal-content ones, in silence either way.
fn ir_emit_test_assert_eq(node: Node, arg_regs: List[Int], want_equal: Bool) -> Int:
    cmp_r := ir_reg()
    kind := ir_assert_eq_kind(ir_assert_eq_operand_type(node, 1), ir_assert_eq_operand_type(node, 2))
    # compare by value: bytes and lists otherwise compare heap handles, so two
    # equal-content collections would wrongly differ. maps/sets fall through to
    # identity for now (assert_eq on them is uncommon).
    if kind == "string":
        ir_emit_call2(cmp_r, "__str_eq", "bool", arg_regs[0], arg_regs[1])
    elif kind == "bytes":
        ir_emit_call2(cmp_r, "bytes_eq", "bool", arg_regs[0], arg_regs[1])
    elif kind == "list_string":
        ir_emit_call2(cmp_r, "pith_list_eq_string", "bool", arg_regs[0], arg_regs[1])
    elif kind == "list":
        ir_emit_call2(cmp_r, "pith_list_eq_scalar", "bool", arg_regs[0], arg_regs[1])
    else:
        ir_emit_simple_binary(cmp_r, "eq", arg_regs[0], arg_regs[1])
    ok_l := ir_label()
    fail_l := ir_label()
    if want_equal:
        ir_emit("brif " + cmp_r.to_string() + " " + ok_l + " " + fail_l)
    else:
        ir_emit("brif " + cmp_r.to_string() + " " + fail_l + " " + ok_l)
    ir_emit_label(fail_l)
    kind_r := ir_reg()
    ir_emit("iconst " + kind_r.to_string() + " " + ir_assert_eq_kind_code(kind).to_string())
    mut reporter := "pith_assert_ne_fail"
    if want_equal:
        reporter = "pith_assert_eq_fail"
    fail_r := ir_reg()
    ir_emit_call3(fail_r, reporter, "unknown", arg_regs[0], arg_regs[1], kind_r)
    ir_test_assert_fail()
    ir_emit_label(ok_l)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_local_handle_decode_text_path_call(idx: Int, node: Node, callee_node: Node) -> Int:
    arg_regs := ir_collect_call_arg_regs(node, 1)
    if arg_regs.len() < 2:
        return ir_zero_reg()

    input_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    temp_name := ir_new_temp_name("handle_decode_text_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    parse_result_r := ir_reg()
    ir_emit_call1(parse_result_r, ir_resolve_generic_module_call_name(ir_active_generic_module_path, "parse_required"), "tuple", input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    root_r := ir_emit_result_ok_field_typed(parse_result_r, "Int")

    mut generic_ret_type := ir_checked_type(idx)
    if generic_ret_type.len() == 0:
        generic_ret_type = ir_infer_type(idx)
    mut concrete_types := ir_explicit_generic_concrete_types(callee_node)
    if concrete_types.len() == 0:
        concrete_types = ir_infer_generic_concrete_types("decode_text_path", node)
    decode_path_name := ir_queue_generic_specialization("decode_path", concrete_types, generic_ret_type)
    path_result_r := ir_reg()
    ir_emit_call2(path_result_r, decode_path_name, "tuple", root_r, dotted_path_r)
    ir_emit("store " + temp_name + " " + path_result_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_list_map_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 3:
        return - 1
    return ir_emit_list_map_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]))

# map, filter and reduce open-code their loop instead of going through the
# general method call, so the release that ordinarily reclaims an owned
# argument never runs for the function they were handed. an owned one — a
# lambda literal, a named function, a call that built a closure — is ours to
# drop once the loop is done. a borrowed one (a local or a struct field
# holding the closure) belongs to that owner and must be left alone.
fn ir_release_higher_order_fn_arg(fn_idx: Int, fn_r: Int):
    if not ir_string_expr_is_borrowed(fn_idx):
        ir_rc_release_reg(fn_r, "closure")

fn ir_emit_list_map_lowering(idx: Int, list_idx: Int, mapper_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    mapper_r := ir_expr(mapper_idx)
    mapper_name := ir_temp_name("__map_fn")
    ir_emit("store " + mapper_name + " " + mapper_r.to_string())

    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = "list"
    mut elem_kind := ir_list_element_kind(list_idx)
    mapped_kind := ir_function_return_kind(mapper_idx)

    # the result's element type is what the mapper returns, and the checked
    # type of the call carries it; the mapper's own return type is the
    # fallback for a call the checker left untyped. an untagged result would
    # own nothing, and the mapper's fresh values have no other owner.
    mut result_elem_kind := ir_rc_kind(ir_list_element_kind(idx))
    if result_elem_kind.len() == 0:
        result_elem_kind = ir_rc_kind(mapped_kind)
    ctor := ir_list_ctor_for_elem_kind(result_elem_kind)

    out_r := ir_emit_list_map_loop(list_r, ctor, mapper_name, ir_retkind(result_kind), ir_retkind(elem_kind), ir_retkind(mapped_kind), ir_temp_name("__map_i"))
    ir_release_higher_order_fn_arg(mapper_idx, mapper_r)
    return out_r

fn ir_emit_list_filter_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 3:
        return - 1
    return ir_emit_list_filter_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]))

fn ir_emit_list_filter_lowering(idx: Int, list_idx: Int, keep_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    keep_r := ir_expr(keep_idx)
    keep_name := ir_temp_name("__filter_fn")
    ir_emit("store " + keep_name + " " + keep_r.to_string())

    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = ir_infer_type(list_idx)
    if result_kind.len() == 0:
        result_kind = "list"
    mut elem_kind := ir_list_element_kind(list_idx)

    # filter keeps the source's own elements, so the result's element type is
    # the source's. tagging it is what lets the result outlive the list it
    # was filtered from: the push takes a count of its own.
    ctor := ir_list_ctor_for_elem_kind(ir_rc_kind(elem_kind))

    out_r := ir_emit_list_filter_loop(list_r, ctor, keep_name, ir_retkind(result_kind), ir_retkind(elem_kind), ir_temp_name("__filter_i"))
    ir_release_higher_order_fn_arg(keep_idx, keep_r)
    return out_r

fn ir_emit_list_reduce_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 4:
        return - 1
    return ir_emit_list_reduce_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]), ir_call_arg_expr_index(node.children[3]))

fn ir_emit_list_reduce_lowering(idx: Int, list_idx: Int, init_idx: Int, reducer_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    init_r := ir_expr(init_idx)
    reducer_r := ir_expr(reducer_idx)
    reducer_name := ir_temp_name("__reduce_fn")
    acc_name := ir_temp_name("__reduce_acc")
    ir_emit("store " + reducer_name + " " + reducer_r.to_string())
    ir_emit("store " + acc_name + " " + init_r.to_string())

    elem_kind := ir_list_element_kind(list_idx)
    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = ir_infer_type(init_idx)
    if result_kind.len() == 0:
        result_kind = "unknown"

    out_r := ir_emit_list_reduce_loop(list_r, reducer_name, acc_name, ir_retkind(elem_kind), ir_retkind(result_kind), ir_temp_name("__reduce_i"))
    ir_release_higher_order_fn_arg(reducer_idx, reducer_r)
    return out_r

fn ir_emit_higher_order_list_call(idx: Int, node: Node, callee_name: String) -> Int:
    if callee_name == "map":
        return ir_emit_list_map_call(idx, node)
    if callee_name == "filter":
        return ir_emit_list_filter_call(idx, node)
    if callee_name == "reduce":
        return ir_emit_list_reduce_call(idx, node)
    return - 1

fn ir_emit_list_is_empty_method(node: Node) -> Int:
    list_r := ir_expr(node.children[0])
    return ir_emit_list_is_empty(list_r)

fn ir_emit_list_index_search(node: Node, obj_type: String) -> Int:
    if node.children.len() < 2:
        return ir_emit_list_missing_index_result()
    list_idx := node.children[0]
    target_idx := ir_method_call_arg_expr(node, 0)
    list_r := ir_expr(list_idx)
    target_r := ir_expr(target_idx)
    mut elem_kind := ir_list_element_kind(list_idx)
    if obj_type == "list_string":
        elem_kind = "string"

    return ir_emit_list_index_search_loop(list_r, target_r, ir_retkind(elem_kind), ir_temp_name("__list_index_result"), ir_temp_name("__list_index_i"))

fn ir_emit_list_contains_method(node: Node, obj_type: String) -> Int:
    index_r := ir_emit_list_index_search(node, obj_type)
    return ir_emit_list_contains_from_index(index_r)

# Wrap a raw index-search result (a valid index or -1) as an Optional[Int].
# Emits: iconst 0; ge cmp raw 0; if cmp then Some(raw) else None. Reuses
# the existing optional-tuple builders so the layout matches the rest of
# the ABI.
fn ir_emit_index_search_to_optional(raw_r: Int) -> Int:
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    found_r := ir_reg()
    ir_emit("gte " + found_r.to_string() + " " + raw_r.to_string() + " " + zero_r.to_string())
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    result_name := ir_temp_name("__idx_opt_result")
    default_r := ir_reg()
    ir_emit("iconst " + default_r.to_string() + " 0")
    ir_emit("store " + result_name + " " + default_r.to_string())
    ir_emit("brif " + found_r.to_string() + " " + some_l + " " + none_l)
    ir_emit("label " + some_l)
    some_tuple := ir_emit_optional_some_value(raw_r)
    ir_emit("store " + result_name + " " + some_tuple.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit("label " + none_l)
    none_tuple := ir_emit_optional_none_value()
    ir_emit("store " + result_name + " " + none_tuple.to_string())
    ir_emit("label " + merge_l)
    out_r := ir_reg()
    ir_emit("load " + out_r.to_string() + " " + result_name)
    return out_r

fn ir_emit_self_hosted_list_method(idx: Int, node: Node, mname: String, obj_type: String) -> Int:
    if not ir_is_list_runtime_type(obj_type):
        return - 1
    if mname == "is_empty":
        return ir_emit_list_is_empty_method(node)
    if mname == "index_of":
        raw_idx_r := ir_emit_list_index_search(node, obj_type)
        return ir_emit_index_search_to_optional(raw_idx_r)
    if mname == "contains":
        return ir_emit_list_contains_method(node, obj_type)
    if mname == "map":
        # list.map(fn): receiver is the list, child 0; the mapper is arg 0
        return ir_emit_list_map_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0))
    if mname == "filter":
        return ir_emit_list_filter_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0))
    if mname == "reduce":
        # list.reduce(init, fn): init is arg 0, reducer is arg 1
        return ir_emit_list_reduce_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0), ir_method_call_arg_expr(node, 1))
    return - 1

fn ir_emit_index_json_decode_call(idx: Int, node: Node, callee_idx: Int) -> Int:
    if ir_is_json_decode_callee(callee_idx, "decode") or ir_is_local_generic_callee(callee_idx, "decode", "input"):
        return ir_emit_json_decode_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_text") or ir_is_local_generic_callee(callee_idx, "decode_text", "input"):
        return ir_emit_json_decode_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_object") or ir_is_local_generic_callee(callee_idx, "decode_object", "handle"):
        return ir_emit_json_decode_object_call(idx, node, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_path") or ir_is_local_generic_callee(callee_idx, "decode_path", "handle"):
        return ir_emit_json_decode_path_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_text_path") or ir_is_local_generic_callee(callee_idx, "decode_text_path", "input"):
        return ir_emit_json_decode_path_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_file") or ir_is_local_generic_callee(callee_idx, "decode_file", "file_path"):
        return ir_emit_json_decode_file_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_file_path") or ir_is_local_generic_callee(callee_idx, "decode_file_path", "file_path"):
        return ir_emit_json_decode_file_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    return 0 - 1

fn ir_emit_index_handle_decode_call(idx: Int, node: Node, callee_idx: Int, callee_node: Node) -> Int:
    if ir_is_handle_decode_callee(callee_idx, "decode") or ir_is_local_generic_callee(callee_idx, "decode", "handle"):
        return ir_emit_handle_decode_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_handle_decode_callee(callee_idx, "decode_text") or ir_is_local_generic_callee(callee_idx, "decode_text", "input"):
        return ir_emit_handle_decode_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_handle_decode_callee(callee_idx, "decode_path"):
        return ir_emit_handle_decode_path_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_handle_decode_callee(callee_idx, "decode_text_path"):
        return ir_emit_handle_decode_path_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_local_generic_callee(callee_idx, "decode_text_path", "input"):
        return ir_emit_local_handle_decode_text_path_call(idx, node, callee_node)
    if ir_is_handle_decode_callee(callee_idx, "decode_file") or ir_is_local_generic_callee(callee_idx, "decode_file", "file_path"):
        return ir_emit_handle_decode_file_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_handle_decode_callee(callee_idx, "decode_file_path") or ir_is_local_generic_callee(callee_idx, "decode_file_path", "file_path"):
        return ir_emit_handle_decode_file_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    return 0 - 1

fn ir_emit_index_decode_call(idx: Int, node: Node, callee_idx: Int, callee_node: Node) -> Int:
    json_r := ir_emit_index_json_decode_call(idx, node, callee_idx)
    if json_r >= 0:
        return json_r
    config_r := ir_emit_index_config_decode_call(idx, node, callee_idx, ir_expr, ir_emit_value_for_target)
    if config_r >= 0:
        return config_r
    return ir_emit_index_handle_decode_call(idx, node, callee_idx, callee_node)

fn ir_static_struct_init_call(idx: Int, node: Node, callee_name: String) -> Int:
    expr_tid := c_get_expr_type(idx)
    if expr_tid < 0:
        return 0 - 1
    expr_info := get_type_info(expr_tid)
    if expr_info.kind != "struct":
        return 0 - 1
    if ir_is_declared_callable(callee_name) or ir_is_sync_primitive_name(callee_name):
        return 0 - 1
    # a closure-typed variable or parameter is an indirect call, not a
    # construction: the consumer dispatches through the closure handle
    if ir_lookup_name_type(callee_name) == "closure":
        return 0 - 1
    # the scope check above reads ir_var_types, which only tracks the current
    # scope's locals. a captured fn-value read inside a closure body isn't in
    # there (captures are borrowed from the env, so they're deliberately left
    # out of the type map), so its call would slip through and be miscompiled
    # as a construction of its struct return type. consult the checker's type
    # for the callee instead: any function-typed callee is an indirect call.
    if node.children.len() > 0:
        callee_tid := c_get_expr_type(node.children[0])
        if callee_tid >= 0 and get_type_info(callee_tid).kind == "function":
            return 0 - 1
    mut arg_nodes: List[Int] := []
    for child, i in node.children:
        if i == 0:
            continue
        arg_nodes.push(child)
    return ir_emit_struct_positional_init(expr_info.name, arg_nodes, expr_tid)

# substitute a base field type name that is a bare generic param (I, T, U) with
# the instance's concrete type name; anything else passes through unchanged.
fn ir_subst_generic_field_type(base_ftype: String, params: List[String], arg_names: List[String]) -> String:
    mut i := 0
    while i < params.len():
        if params[i] == base_ftype and i < arg_names.len():
            return arg_names[i]
        i = i + 1
    return base_ftype

# does a generic struct instance have any field that must be released once its
# type params are substituted in (e.g. `src: I` bound to a struct)?
fn ir_generic_instance_needs_dtor(base: String, params: List[String], arg_names: List[String]) -> Bool:
    count := ir_struct_field_count(base)
    mut i := 0
    while i < count:
        fname := ir_struct_field_name_at(base, i)
        base_ftype := ir_struct_field_type_name(base, fname)
        if ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names)).len() > 0:
            return true
        i = i + 1
    return false

# a generic struct built inside a generic function lowers to a backend
# constructor call (`call MapIter struct:MapIter`) which attaches no destructor,
# because the checker typed the construction as TID_ERR (its params were
# suppressed). at the specialization site we do know the concrete type args, so
# resolve them and attach a per-instance destructor to the freshly built struct.
# a generic struct built by base name (`Wrap(v, ...)` with no explicit `[args]`)
# lowers to a plain backend `call Wrap` that stores its fields as-is and gets no
# per-instance destructor. it still keeps only the caller's count for a borrowed
# rc field arg, so the caller's owned-arg release would free a value the struct
# still holds. retain each borrowed rc arg here to give the field its own count;
# the value's own kind classifies it, since the field's declared type is a bare
# generic param the checker leaves unresolved in a generic body.
fn ir_retain_base_name_construction_fields(node: Node, callee_name: String, arg_regs: List[Int]):
    if not ir_struct_names.contains_key(callee_name):
        return
    if not has_generic_declaration(callee_name):
        return
    mut reg_i := 0
    for child, i in node.children:
        if i == 0:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                reg_i = reg_i + 1
                continue
            expr_idx = cn.children[0]
        arg_kind := ir_rc_kind(ir_infer_type(expr_idx))
        if arg_kind.len() > 0 and ir_string_expr_is_borrowed(expr_idx):
            ir_rc_retain_reg(arg_regs[reg_i], arg_kind)
        reg_i = reg_i + 1

# true when a static call is really a generic struct being built through the
# backend constructor path (`Wrap(...)` or `Wrap[T](...)` whose base names a
# generic struct). such a call stores every argument into a field, so its
# arguments follow the container-store transfer rule rather than the
# owned-argument release rule.
fn ir_is_generic_struct_construction_call(node: Node) -> Bool:
    if node.children.len() == 0:
        return false
    cn := get_node(node.children[0])
    mut base := ""
    if cn.kind == "ident":
        base = cn.value
    elif cn.kind == "index" and cn.children.len() >= 2:
        bn := get_node(cn.children[0])
        if bn.kind == "ident":
            base = bn.value
    if base.len() == 0:
        return false
    return ir_struct_names.contains_key(base) and has_generic_declaration(base)

fn ir_attach_generic_construction_dtor(node: Node, ret_type: String, struct_r: Int, arg_regs: List[Int]):
    # the callee is `Base[args]` — an index node whose base names a generic
    # struct; that identifies this call as a generic struct construction.
    callee_node := get_node(node.children[0])
    if callee_node.kind == "ident":
        ir_retain_base_name_construction_fields(node, callee_node.value, arg_regs)
        return
    if callee_node.kind != "index" or callee_node.children.len() < 2:
        return
    base_node := get_node(callee_node.children[0])
    if base_node.kind != "ident":
        return
    base := base_node.value
    if not ir_struct_names.contains_key(base):
        return
    if not has_generic_declaration(base):
        return
    arg_names := ir_explicit_generic_concrete_types(callee_node)
    if arg_names.len() == 0:
        return
    params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
    if not ir_generic_instance_needs_dtor(base, params, arg_names):
        return
    # the backend stored the field args as-is; a borrowed rc arg (a field
    # holding another struct/closure passed by value from a local or param)
    # keeps only its caller's count. the per-instance dtor below releases it,
    # so retain it here to give the field its own count — otherwise the caller
    # and the dtor both release the one count and free it twice. a fresh arg
    # already arrives owned, so is_borrowed gates the retain exactly like the
    # non-generic ir_emit_struct_positional_init path.
    ir_retain_generic_construction_fields(node, base, params, arg_names, arg_regs)
    sym := ir_sanitize_symbol(base + "[" + arg_names.join(",") + "]")
    ir_generic_dtor_base.insert(sym, base)
    ir_generic_dtor_args.insert(sym, arg_names.join(chr(1)))
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __dtor_" + sym)
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + fr.to_string())

# retain each borrowed rc field arg of a backend-constructed generic struct so
# the field owns its own count, balancing the per-instance destructor's release.
fn ir_retain_generic_construction_fields(node: Node, base: String, params: List[String], arg_names: List[String], arg_regs: List[Int]):
    mut reg_i := 0
    for child, i in node.children:
        if i == 0:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                reg_i = reg_i + 1
                continue
            expr_idx = cn.children[0]
        field_pos := reg_i
        if field_pos < ir_struct_field_count(base):
            fname := ir_struct_field_name_at(base, field_pos)
            base_ftype := ir_struct_field_type_name(base, fname)
            fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
            if fkind.len() > 0 and ir_string_expr_is_borrowed(expr_idx):
                ir_rc_retain_reg(arg_regs[reg_i], fkind)
        reg_i = reg_i + 1

# one destructor per generic struct instance that was constructed via a backend
# constructor call, emitted after the body so every construction site recorded
# its instance. resolves each field type with the instance's args before
# deciding whether to release it.
fn ir_emit_generic_instance_dtors():
    for sym in ir_generic_dtor_base.keys():
        base := ir_generic_dtor_base[sym]
        mut arg_names: List[String] := []
        args_str := ir_generic_dtor_args[sym]
        if args_str.len() > 0:
            arg_names = args_str.split(chr(1))
        params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
        ir_emit_func_header("__dtor_" + sym, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(base)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(base, i)
            base_ftype := ir_struct_field_type_name(base, fname)
            fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
            if fkind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_release_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# the generic parameter names and substituted argument names for a recorded
# generic instance destructor, packed as (params, arg_names) lookups shared
# by the instance tracer emitter and its needs test.
fn ir_generic_instance_arg_names(sym: String) -> List[String]:
    mut arg_names: List[String] := []
    args_str := ir_generic_dtor_args[sym]
    if args_str.len() > 0:
        arg_names = args_str.split(chr(1))
    return arg_names

# true when a generic instance destructor has a traceable field once the
# instance's type arguments are substituted in — the per-instance answer to
# ir_struct_needs_tracer. weak fields are skipped like everywhere else.
fn ir_generic_instance_needs_tracer(sym: String) -> Bool:
    base := ir_generic_dtor_base[sym]
    arg_names := ir_generic_instance_arg_names(sym)
    params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
    count := ir_struct_field_count(base)
    mut i := 0
    while i < count:
        fname := ir_struct_field_name_at(base, i)
        base_ftype := ir_struct_field_type_name(base, fname)
        fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
        if not ir_struct_field_is_weak(base, fname) and ir_trace_kind_enabled(fkind):
            return true
        i = i + 1
    return false

# tracer twin of a generic instance destructor: the same substituted field
# walk, visiting traceable children instead of releasing them.
fn ir_emit_generic_instance_tracers():
    for sym in ir_generic_dtor_base.keys():
        if not ir_generic_instance_needs_tracer(sym):
            continue
        base := ir_generic_dtor_base[sym]
        arg_names := ir_generic_instance_arg_names(sym)
        params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
        ir_emit_func_header("__cc_trace_" + sym, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(base)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(base, i)
            base_ftype := ir_struct_field_type_name(base, fname)
            fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
            if not ir_struct_field_is_weak(base, fname) and ir_trace_kind_enabled(fkind):
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_visit_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_specialize_static_callee(idx: Int, node: Node, callee: ResolvedCallee, explicit_generic_types: List[String]) -> ResolvedCallee:
    if not ir_is_generic_function_name(callee.name):
        return callee
    mut generic_ret_type := ir_checked_type(idx)
    if generic_ret_type.len() == 0:
        generic_ret_type = ir_infer_type(idx)
    mut concrete_types := explicit_generic_types
    if concrete_types.len() == 0:
        concrete_types = ir_infer_generic_concrete_types(callee.name, node)
    ir_record_generic_spec_arg_tids(callee.name, concrete_types, ir_generic_arg_tids(node))
    return ResolvedCallee(ir_queue_generic_specialization(callee.name, concrete_types, generic_ret_type), false)

# a call whose callee is an expression rather than a name — a function
# value fetched from a list, a field, or another call. emit the callee
# to a register, stash it in a fresh temp so the consumer sees a named
# closure handle, and dispatch through it. without this the callee's
# base name was mistaken for the target (`ops[0](x)` called `ops`, the
# list itself, and segfaulted).
fn ir_emit_indirect_expr_call(idx: Int, node: Node, callee_idx: Int) -> Int:
    callee_r := ir_expr(callee_idx)
    tmp := ir_new_temp_name("__callee")
    ir_emit("store " + tmp + " " + callee_r.to_string())
    arg_regs := ir_collect_call_arg_regs(node, 1)
    mut ret_kind := ir_function_return_kind(callee_idx)
    if ret_kind == "unknown":
        ret_kind = "int"
    r := ir_reg()
    ir_emit_call_text(r, tmp, ret_kind, arg_regs.len(), ir_join_arg_regs(arg_regs))
    ir_release_owned_string_args(node, 1, arg_regs)
    return r

# true when the callee node is an expression (not a plain name) whose
# checked type is a function value.
fn ir_callee_is_function_expr(callee_idx: Int, callee_node: Node) -> Bool:
    if callee_node.kind == "ident":
        return false
    callee_tid := c_get_expr_type(callee_idx)
    if callee_tid < 0:
        return false
    return get_type_info(callee_tid).kind == "function"

fn ir_emit_static_call(idx: Int, node: Node) -> Int:
    mut explicit_generic_types: List[String] := []
    if node.children.len() > 0:
        callee_node := get_node(node.children[0])
        if callee_node.kind == "index":
            special_r := ir_emit_index_decode_call(idx, node, node.children[0], callee_node)
            if special_r >= 0:
                return special_r
            explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
        if ir_callee_is_function_expr(node.children[0], callee_node):
            return ir_emit_indirect_expr_call(idx, node, node.children[0])

    mut callee := ResolvedCallee("unknown", false)
    if node.children.len() > 0:
        callee = ir_resolve_static_callee(node.children[0])
        if callee.name.len() == 0:
            callee = ResolvedCallee("unknown", false)
        # a call through a loop variable: `for f in fns:` binds f to a loop
        # slot, so the call has to name that slot or the consumer will look up
        # a variable that does not exist and fall through to the error stub.
        # only a name that is not a declared function can be a variable call,
        # which keeps a loop variable that shadows nothing extra out of this.
        callee_n := get_node(node.children[0])
        if callee_n.kind == "ident" and not ir_is_declared_callable(callee.name):
            loop_slot := ir_loop_var_slot(callee.name)
            if loop_slot.len() > 0:
                callee = ResolvedCallee(loop_slot, callee.imported)
    # ord of any byte operand is just that byte: ord(s[i]) reads it with byte_at
    # instead of minting a one-character string, and ord("/") folds to a
    # constant. the argument is wrapped in an "arg" node, so unwrap it first.
    if callee.name == "ord" and node.children.len() >= 2:
        byte_r := ir_emit_byte_operand(ir_call_arg_expr_index(node.children[1]))
        if byte_r >= 0:
            return byte_r
    higher_order_r := ir_emit_higher_order_list_call(idx, node, callee.name)
    if higher_order_r >= 0:
        return higher_order_r
    struct_r := ir_static_struct_init_call(idx, node, callee.name)
    if struct_r >= 0:
        return struct_r
    callee = ir_specialize_static_callee(idx, node, callee, explicit_generic_types)
    arg_regs := ir_collect_call_arg_regs(node, 1)
    if callee.name == "Channel" and arg_regs.len() == 0:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        arg_regs.push(zero_r)

    # the built-in assertions lower the same way in every build, not only under
    # the test runner: a helper holding a table's assertions is compiled once
    # and may be reached from a test block or from ordinary code, and it has to
    # mean the same thing on both paths. a module that declares its own function
    # by one of these names keeps it — ir_is_declared_callable is that check.
    if callee.name == "assert" and arg_regs.len() >= 1 and not ir_is_declared_callable("assert"):
        return ir_emit_test_assert(arg_regs)
    if callee.name == "assert_eq" and arg_regs.len() >= 2 and not ir_is_declared_callable("assert_eq"):
        return ir_emit_test_assert_eq(node, arg_regs, true)
    if callee.name == "assert_ne" and arg_regs.len() >= 2 and not ir_is_declared_callable("assert_ne"):
        return ir_emit_test_assert_eq(node, arg_regs, false)

    mut r := ir_reg()
    uses_result_abi := ir_callee_uses_result_abi(callee, idx)
    ret_type := ir_call_retkind_for_name(idx, uses_result_abi, callee.name)
    if ir_result_reg_funcs.contains_key(callee.name):
        ir_rcall_current_idx = idx
        r = ir_emit_result_reg_call(r, callee.name, arg_regs.len(), ir_join_arg_regs(arg_regs))
        ir_rcall_current_idx = 0 - 1
    else:
        ir_emit_call_text(r, callee.name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
    # a generic struct built here (backend constructor call) gets no destructor
    # from the backend; attach a per-instance one so its rc fields release
    ir_attach_generic_construction_dtor(node, ret_type, r, arg_regs)
    # a generic construction stores every argument into a field: a borrowed one
    # is retained above, a fresh one transfers its count. either way the count
    # now belongs to the struct, so the caller must not also release it here —
    # that is the container-store transfer rule (docs/ownership.md) applied to a
    # backend struct build. ordinary calls still release their owned arguments.
    if not ir_is_generic_struct_construction_call(node):
        ir_release_owned_string_args(node, 1, arg_regs)
    if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
        if ret_type != "float" and idx == ir_rcall_defer_idx:
            return ir_emit_wrapped_legacy_pair(r, ret_type, callee.name)
        return ir_emit_wrapped_legacy_result(r, ret_type, callee.name)
    return r

fn ir_emit_map_entry_insert(map_r: Int, has_int_keys: Bool, entry: Node, val_target: String):
    if entry.kind != "entry" or entry.children.len() < 2:
        return
    k_r := ir_expr(entry.children[0])
    # wrap the value to its declared kind so an optional value type
    # stores Some(v), not the raw v — the same fix collection element
    # literals need (a map literal typed Map[K, Int?] otherwise stored
    # bare ints and a later .value() dereferenced one as a heap tuple).
    v_r := ir_emit_value_for_target(entry.children[1], val_target)
    mut store_name := "map_insert"
    if has_int_keys:
        store_name = "map_insert_ikey"
    # a heap value written straight into a literal is stored the same way one
    # written into `m[k]` is: the kind travels with it so the map owns what it
    # holds. without this `{k: inner}` left the map a bare handle whose only
    # count belonged to `inner`, and reading the entry after `inner` died read
    # freed memory.
    mut entry_kind := ir_rc_kind(val_target)
    if val_target.len() == 0:
        entry_kind = ir_rc_kind(ir_infer_type(entry.children[1]))
    entry_owned := not ir_string_expr_is_borrowed(entry.children[1])
    kind_store := ir_map_kind_store_name(store_name, entry_owned)
    if kind_store.len() > 0 and ir_store_learns_kind(entry_kind):
        tag_r := ir_emit_element_tag_const(entry_kind)
        ir_emit_call4(ir_reg(), kind_store, "void", map_r, k_r, v_r, tag_r)
        return
    ir_emit_call3(ir_reg(), store_name, "void", map_r, k_r, v_r)

fn ir_emit_map_literal(idx: Int, node: Node) -> Int:
    map_r := ir_reg()
    # the syntactic probe only recognizes an int *literal* key, so a literal
    # whose key is any other int expression ({i: 1}) looked string-keyed and
    # built a string-keyed map, then handed map_insert a raw integer where a
    # cstring pointer was expected. the checked type already knows the key
    # kind, so let it decide — the same way ir_emit_set_literal does. the
    # probe stays as the fallback for a literal the checker left untyped.
    mut has_int_keys := ir_map_uses_int_keys(node)
    if ir_checked_type(idx) == "map_int":
        has_int_keys = true
    mut val_target := ""
    tid := c_get_expr_type(idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "map" and info.value_type >= 0:
            val_target = ir_type_from_tid(info.value_type)
    # the value flavor comes from the checked value type where there is one:
    # an empty literal has no first entry to read it off, which is why `f({})`
    # for a Map[String, String] built a map that owned none of the strings put
    # into it. the first-entry probe stays as the fallback for a literal the
    # checker left untyped.
    mut val_is_string := false
    if val_target.len() > 0:
        val_is_string = ir_rc_kind(val_target) == "string"
    elif node.children.len() > 0:
        entry0 := get_node(node.children[0])
        if entry0.kind == "entry" and entry0.children.len() >= 2:
            val_is_string = ir_infer_type(entry0.children[1]) == "string"
    if has_int_keys:
        if val_is_string:
            ir_emit_call0(map_r, "__map_new_int_str_val", "map_int")
        else:
            ir_emit_call0(map_r, "__map_new_int", "map_int")
    elif val_is_string:
        ir_emit_call0(map_r, "__map_new_str_val", "map")
    else:
        ir_emit_call0(map_r, "__map_new", "map")
    for child in node.children:
        ir_emit_map_entry_insert(map_r, has_int_keys, get_node(child), val_target)
    return map_r

fn ir_emit_set_literal(idx: Int, node: Node) -> Int:
    set_r := ir_reg()
    # an empty literal carries no element evidence; the checked type
    # decides between the string and int constructors
    mut literal_type := ir_literal_expr_type(node, "set")
    checked := ir_checked_type(idx)
    if checked == "set_int" or checked == "set":
        literal_type = checked
    ir_emit_call0(set_r, ir_set_new_name(literal_type), literal_type)
    for child in node.children:
        elem_r := ir_expr(child)
        ir_emit_call2(ir_reg(), ir_set_add_name(literal_type), "void", set_r, elem_r)
    return set_r

# the list store that carries the element's kind with it, or "" when this is
# not a list store. only the borrowed stores have a kind-carrying variant: an
# owned value transfers its count instead of taking one, which the `_owned`
# stores already do.
fn ir_list_kind_store_name(emit_name: String) -> String:
    if emit_name == "push" or emit_name == "pith_list_push_value" or emit_name == "__list_push":
        return "list_push_kind"
    if emit_name == "set" or emit_name == "pith_list_set_value":
        return "list_set_kind"
    if emit_name == "list_insert":
        return "list_insert_kind"
    return ""

# the element-tag code a heap kind is written as in the ir. these are the
# codes `pith_list_new` takes and the kind-carrying map stores carry, so they
# are part of the ir contract and must not be renumbered.
fn ir_element_tag_code(kind: String) -> Int:
    if kind == "string":
        return 1
    if kind == "list":
        return 2
    if kind == "map":
        return 3
    if kind == "struct":
        return 4
    if kind == "bytes":
        return 5
    if kind == "closure":
        return 6
    if kind == "set":
        return 7
    return 0

# the value kinds a container learns from the store rather than from its
# constructor.
#
# a container's flavor is normally picked at construction from the checked
# type, but a map literal reads its value kind off the first entry, and an
# empty `{}` has none — so `f({})` and every other empty map literal built a
# map that owned nothing it held. carrying the kind on the store settles it
# where the kind is known for certain: the container adopts it at the first
# store (`MapImpl::adopt_value_tag`, `ListImpl::adopt_element_tag`), so the
# count no longer depends on the constructor having guessed right, and a
# container that cannot adopt takes the compensating count in the runtime
# instead — the same leak the emitter used to add here.
#
# it is also what stops a *tagged* container being counted twice, which is
# what a list store did: the list retained in the runtime and the emitter
# retained again, because nothing at the store told a tagged list from an
# untagged one. the kind is that missing evidence, and because the same
# `store_kind` decides both whether to carry it and whether to skip the
# compensating retain, the two cannot disagree.
#
# string values stay on the constructor path. that flavor has always been
# picked correctly there, and routing it through the kind store would rewrite
# every string insert in the tree for no change in ownership.
fn ir_store_learns_kind(store_kind: String) -> Bool:
    if store_kind == "list" or store_kind == "map" or store_kind == "set":
        return true
    return store_kind == "struct" or store_kind == "bytes" or store_kind == "closure"

# materialize an element-tag code into a register, for the store to carry.
fn ir_emit_element_tag_const(kind: String) -> Int:
    tag_r := ir_reg()
    ir_emit("iconst " + tag_r.to_string() + " " + ir_element_tag_code(kind).to_string())
    return tag_r

# the map store that carries the value's kind with it, or "" when this is not
# a map store.
fn ir_map_kind_store_name(emit_name: String, owned: Bool) -> String:
    if emit_name == "insert" or emit_name == "map_insert":
        if owned:
            return "map_insert_owned_kind"
        return "map_insert_kind"
    if emit_name == "map_insert_ikey":
        if owned:
            return "map_insert_ikey_owned_kind"
        return "map_insert_ikey_kind"
    return ""

# true when a *borrowed* value sent down a channel needs a count added here
# rather than by the receiving end. a channel is not a counted container: it
# holds a raw handle between the send and the receive, with nothing on either
# side that could take a count for it, so the sender adds one and the value
# outlives its local. that is a leak, and a missing count would be a dangling
# element.
#
# lists and maps used to be on this list too. both now carry the stored
# value's kind (ir_list_kind_store_name, ir_map_kind_store_name), so the
# runtime knows whether it owns the value and takes the count itself — the
# one place that can answer the question the emitter was guessing at.
fn ir_channel_send_needs_retain(emit_name: String, store_kind: String) -> Bool:
    return ir_is_channel_send_name(emit_name) and store_kind.len() > 0

# the value kinds a container store may take the caller's count for.
#
# struct values were the last holdout: a `for` loop variable used to write
# its borrowed element into the same named slot a later `:=` of that name
# reused, so the rebind released a count the loop never took —
# `std.crypto.x509.verify_chain_issuers` had exactly that shape — and the
# second count a struct store took was what absorbed that over-release.
# loop variables now get storage of their own, so the mask is gone and a
# struct built straight into a container transfers like every other kind.
fn ir_container_store_takes_count(store_kind: String) -> Bool:
    if store_kind == "string" or store_kind == "bytes":
        return true
    if store_kind == "struct":
        return true
    return store_kind == "list" or store_kind == "map" or store_kind == "set" or store_kind == "closure"

# the variant of a container store that takes the caller's count instead of
# adding one of its own, or "" for a store with no such variant.
#
# a value built straight into a container — `l.push("v-{i}")`, `m[k] = "v-{i}"`
# — is an owned temporary the caller stops tracking at the store. the caller
# skips its release there (ownership transfers into the container), but the
# runtime store also took a count of its own, so the value ended up with two
# counts and one release. these entry points complete the transfer by not
# taking that second count.
#
# whether there is a count to take is the runtime's call, not the emitter's:
# only the container knows if it was built tagged to own its elements. an
# untagged one takes nothing and the caller's count stays outstanding, which
# is a leak rather than an element nothing keeps alive. see docs/ownership.md.
fn ir_owned_container_store_name(emit_name: String) -> String:
    if emit_name == "push" or emit_name == "pith_list_push_value" or emit_name == "__list_push":
        return "pith_list_push_value_owned"
    if emit_name == "set" or emit_name == "pith_list_set_value":
        return "pith_list_set_value_owned"
    if emit_name == "insert" or emit_name == "map_insert":
        return "pith_map_insert_cstr_owned"
    if emit_name == "map_insert_ikey":
        return "pith_map_insert_ikey_owned"
    # insert is push with an index, and was the one container store left
    # without a transferring variant. for want of it the caller had to keep its
    # count on a fresh container — `xs.insert(0, {1, 2})` stranded the set,
    # because releasing it would have handed the list a freed handle.
    if emit_name == "list_insert":
        return "pith_list_insert_value_owned"
    return ""

fn ir_list_ctor_for_elem_kind(elem_kind: String) -> String:
    if elem_kind == "string":
        return "__list_new_str"
    if elem_kind == "list":
        return "__list_new_list"
    if elem_kind == "map":
        return "__list_new_map"
    if elem_kind == "struct":
        return "__list_new_struct"
    if elem_kind == "bytes":
        return "__list_new_bytes"
    # a route table or a middleware chain is a List of closures. untagged it
    # owned nothing, which made every closure that reached one live on a
    # count somebody else was holding — and there is no somebody else once a
    # fn value transfers its count at the call.
    if elem_kind == "closure":
        return "__list_new_closure"
    # a set is a shared handle like a list or a map, and the only collection
    # kind the runtime's element tag was missing. untagged, a List[Set] owned
    # nothing: `xs.push({1, 2})` stranded its element for the life of the
    # process, and the value position of `xs.insert(i, {1, 2})` had to keep its
    # count for want of anywhere to transfer it to.
    if elem_kind == "set":
        return "__list_new_set"
    return "__list_new"

fn ir_emit_list_literal(idx: Int, node: Node) -> Int:
    # a tagged list owns its heap elements: the runtime push retains, and
    # release cascades. the checker's type covers empty literals in any
    # position (a bare `return []` was creating untagged List[String]
    # buffers whose elements nothing owned); the first element is the
    # fallback when no checked type exists.
    mut elem_kind := ""
    # the element's own emission kind: for an optional element it is
    # "tuple", which tells ir_emit_value_for_target to wrap each value as
    # Some. without this, `[1, none, 3]` typed List[Int?] pushed raw ints
    # and a later .value() dereferenced an integer as a heap tuple.
    mut elem_target := ""
    tid := c_get_expr_type(idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "list" and info.inner >= 0:
            elem_target = ir_type_from_tid(info.inner)
            elem_kind = ir_rc_kind(elem_target)
    if elem_kind.len() == 0 and node.children.len() > 0:
        elem_kind = ir_rc_kind(ir_infer_type(node.children[0]))
    list_r := ir_reg()
    ctor := ir_list_ctor_for_elem_kind(elem_kind)
    ir_emit_call0(list_r, ctor, "list")
    # a retaining ctor (string/list/map/struct) makes __list_push retain the
    # element, so a freshly built element carries a count the list now also
    # holds — drop the fresh temp's count so the list owns exactly one, and the
    # free-time cascade balances it. a borrow keeps its owner's count (released
    # at that owner's scope), so only release non-borrowed elements. untagged
    # (primitive) lists don't retain, so nothing to drop.
    retaining := ctor != "__list_new"
    for child in node.children:
        elem_r := ir_emit_value_for_target(child, elem_target)
        ir_emit_call2(ir_reg(), "__list_push", "void", list_r, elem_r)
        if retaining and not ir_string_expr_is_borrowed(child):
            ir_rc_release_reg(elem_r, elem_kind)
    return list_r

fn ir_emit_tuple_literal_stores(tuple_r: Int, elem_regs: List[Int], elem_nodes: List[Int]):
    for elem_reg, i in elem_regs:
        if i < elem_nodes.len():
            tuple_kind := ir_rc_kind(ir_infer_type(elem_nodes[i]))
            # a fresh element transfers its count into the tuple; only a
            # borrow needs a retain, mirroring struct construction. the
            # tuple's destructor releases the slot on free either way.
            if tuple_kind.len() > 0 and ir_string_expr_is_borrowed(elem_nodes[i]):
                ir_rc_retain_reg(elem_reg, tuple_kind)
        ir_emit("sstore " + tuple_r.to_string() + " " + i.to_string() + " " + elem_reg.to_string())

# one letter per element kind, so a tuple type maps to a short signature
# ("s0" is (String, Int)). the destructor for a signature releases just
# its rc slots; two tuples with the same signature share one destructor.
fn ir_tuple_elem_code(kind: String) -> String:
    if kind == "string":
        return "s"
    if kind == "list":
        return "l"
    if kind == "map":
        return "m"
    if kind == "set":
        return "t"
    if kind == "bytes":
        return "b"
    if kind == "struct":
        return "u"
    if kind == "closure":
        return "c"
    if kind == "tuple":
        return "p"
    return "0"

fn ir_tuple_dtor_code_kind(code: String) -> String:
    if code == "s":
        return "string"
    if code == "l":
        return "list"
    if code == "m":
        return "map"
    if code == "t":
        return "set"
    if code == "b":
        return "bytes"
    if code == "u":
        return "struct"
    if code == "c":
        return "closure"
    if code == "p":
        return "tuple"
    return ""

fn ir_tuple_dtor_signature(elem_nodes: List[Int]) -> String:
    mut sig := ""
    for child in elem_nodes:
        sig = sig + ir_tuple_elem_code(ir_rc_kind(ir_infer_type(child)))
    return sig

# module-suffixed so each module carries its own copy, exactly like the
# struct destructors — no cross-module references, no name clashes.
fn ir_tuple_dtor_name(sig: String) -> String:
    return "__tuple_dtor_" + sig + "_m" + ir_module_count.to_string()

fn ir_tuple_sig_has_rc(sig: String) -> Bool:
    mut i := 0
    while i < sig.len():
        if sig[i] != "0":
            return true
        i = i + 1
    return false

# module-suffixed like the destructor it twins.
fn ir_tuple_tracer_name(sig: String) -> String:
    return "__tuple_trace_" + sig + "_m" + ir_module_count.to_string()

# a tuple destructor gets a tracer twin only when some element is a
# traceable child; string/bytes-only signatures are leaves.
fn ir_tuple_sig_has_trace(sig: String) -> Bool:
    mut i := 0
    while i < sig.len():
        if ir_trace_kind_enabled(ir_tuple_dtor_code_kind(sig[i])):
            return true
        i = i + 1
    return false

# attach the shared destructor when a tuple holds any rc element; an
# all-scalar tuple needs none (its box frees with no cascade).
fn ir_emit_attach_tuple_dtor(tuple_r: Int, elem_nodes: List[Int]):
    sig := ir_tuple_dtor_signature(elem_nodes)
    if not ir_tuple_sig_has_rc(sig):
        return
    if not ir_tuple_dtor_sigs.contains(sig):
        ir_tuple_dtor_sigs.push(sig)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " " + ir_tuple_dtor_name(sig))
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + tuple_r.to_string() + " " + fr.to_string())

fn ir_emit_tuple_literal(node: Node) -> Int:
    mut elem_regs: List[Int] := []
    mut elem_nodes: List[Int] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "none_lit":
            # a none element can only be an optional; build the canonical
            # optional none rather than a bare zero, so element reads go
            # through the optional machinery.
            elem_regs.push(ir_emit_optional_none_value())
        else:
            elem_regs.push(ir_expr(child))
        elem_nodes.push(child)
    r := ir_reg()
    nf := ir_reg()
    ir_emit("iconst " + nf.to_string() + " " + elem_regs.len().to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:tuple", nf)
    ir_emit_tuple_literal_stores(r, elem_regs, elem_nodes)
    ir_emit_attach_tuple_dtor(r, elem_nodes)
    return r

fn ir_field_lookup_key(recv_idx: Int, field_name: String) -> String:
    return ir_field_receiver_type(recv_idx) + "." + field_name

# the widest payload across an enum's variants. every variant is boxed
# at this size so a match arm can read a payload slot of a value that
# turned out to be a different, narrower variant without running past
# the allocation — the tag check still gates whether the comparison
# counts, but the read itself must stay in bounds and land on a zeroed
# slot (Event.Ping carries no payload, yet a Code(0) arm reads slot 1).
fn ir_enum_max_payload_count(enum_name: String) -> Int:
    mut max_count := 0
    if ir_enum_variant_lists.contains_key(enum_name):
        for vname in ir_enum_variant_lists[enum_name].split(","):
            vkey := enum_name + "." + vname
            if ir_enum_payload_kinds.contains_key(vkey):
                count := ir_enum_payload_kinds[vkey].split(",").len()
                if count > max_count:
                    max_count = count
    return max_count

fn ir_emit_variant_alloc(enum_name: String, variant_key: String, payload_count: Int) -> Int:
    mut slots := ir_enum_max_payload_count(enum_name)
    if payload_count > slots:
        slots = payload_count
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + (slots + 1).to_string())
    r := ir_reg()
    ir_emit_call1(r, "__struct_alloc", "struct:" + enum_name, count_r)
    tag_r := ir_reg()
    ir_emit("iconst " + tag_r.to_string() + " " + ir_struct_field_index_lookup[variant_key])
    ir_emit("sstore " + r.to_string() + " 0 " + tag_r.to_string())
    # attach the tag-aware destructor so the box releases its rc payloads when
    # it dies (self-guards: a no-op for enums with no releasable payloads).
    ir_emit_attach_dtor(r, enum_name)
    return r

# Shape.Circle(2.5): build the boxed value and store each payload argument.
fn ir_emit_variant_construction(node: Node, enum_name: String, variant_key: String) -> Int:
    mut kinds: List[String] := []
    if ir_enum_payload_kinds.contains_key(variant_key):
        kinds = ir_enum_payload_kinds[variant_key].split(",")
    r := ir_emit_variant_alloc(enum_name, variant_key, kinds.len())
    mut i := 0
    while i < kinds.len():
        arg_idx := ir_method_call_arg_expr(node, i)
        if arg_idx >= 0:
            arg_r := ir_expr(arg_idx)
            # the enum value owns a count on rc payloads, same as any
            # other struct-shaped store
            payload_kind := ir_rc_kind(kinds[i])
            if payload_kind.len() > 0 and ir_string_expr_is_borrowed(arg_idx):
                ir_rc_retain_reg(arg_r, payload_kind)
            ir_emit("sstore " + r.to_string() + " " + (i + 1).to_string() + " " + arg_r.to_string())
        i = i + 1
    return r

# `pre_obj_r` is the receiver register when the caller already evaluated it (the
# ir_expr dispatch does, to check for result fields first); pass -1 to have this
# evaluate the receiver itself. reusing it matters: evaluating a stateful
# receiver twice — e.g. reader.read_tag() — would advance it and read the wrong
# value, which is what a chained `reader.read_tag()!.field` used to do.
fn ir_emit_field_access(idx: Int, node: Node, pre_obj_r: Int) -> Int:
    fname := node_value(idx)
    if node.children.len() == 0:
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 0")
        return r
    recv_node := get_node(node.children[0])
    if recv_node.kind == "ident":
        lookup_key := recv_node.value + "." + fname
        if ir_struct_field_index_lookup.contains_key(lookup_key):
            if ir_struct_field_lookup.contains_key(lookup_key):
                if ir_struct_field_lookup[lookup_key] == recv_node.value:
                    if ir_boxed_enums.contains_key(recv_node.value):
                        return ir_emit_variant_alloc(recv_node.value, lookup_key, 0)
                    r := ir_reg()
                    ir_emit("iconst " + r.to_string() + " " + ir_struct_field_index_lookup[lookup_key])
                    return r
    recv_idx := node.children[0]
    mut obj_r := pre_obj_r
    if obj_r < 0:
        obj_r = ir_expr(recv_idx)
    r := ir_reg()
    if ir_emit_tuple_field_access(r, obj_r, recv_idx, fname):
        return r
    lk := ir_field_lookup_key(recv_idx, fname)
    # when the name-keyed layout is missing (a struct emitted after this access,
    # reached only through another module's return type), resolve the offset from
    # the checker instead of the unsound name-based guess the map path falls to.
    if not ir_struct_field_index_lookup.contains_key(lk):
        checked_r := ir_try_checked_field_read(obj_r, recv_idx, fname)
        if checked_r >= 0:
            return checked_r
    ir_emit_named_field_access(r, obj_r, lk, fname, ir_checked_struct_field_type(recv_idx, fname))
    # a weak field's slot holds the bare target pointer; synthesize the optional
    # the rest of the pipeline expects, resolving liveness so a reclaimed target
    # reads back as none.
    if lk.len() > fname.len() + 1:
        weak_struct := lk.substring(0, lk.len() - fname.len() - 1)
        if ir_struct_field_is_weak(weak_struct, fname):
            return ir_emit_weak_read(r)
    return r

fn ir_emit_result_tuple(is_ok_r: Int, ok_r: Int, err_r: Int) -> Int:
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " 3")
    result_r := ir_reg()
    ir_emit_call1(result_r, "__struct_alloc", "struct:tuple", count_r)
    ir_emit("sstore " + result_r.to_string() + " 0 " + is_ok_r.to_string())
    ir_emit("sstore " + result_r.to_string() + " 1 " + ok_r.to_string())
    ir_emit("sstore " + result_r.to_string() + " 2 " + err_r.to_string())
    return result_r

fn ir_emit_ok_result_tuple(ok_r: Int) -> Int:
    one := ir_reg()
    ir_emit("iconst " + one.to_string() + " 1")
    return ir_emit_result_tuple(one, ok_r, ir_zero_reg())

fn ir_emit_err_result_tuple(err_r: Int) -> Int:
    zero := ir_zero_reg()
    return ir_emit_result_tuple(zero, zero, err_r)

# whether the two-register result ABI is on for this process. read once: the
# emitter must make the same decision for a function's header and for every
# one of its call sites, across every module of the program.
fn ir_result_reg_enabled() -> Bool:
    if ir_result_reg_flag < 0:
        value := env_opt("PITH_RESULT_REG").unwrap_or("")
        if value == "1":
            ir_result_reg_flag = 1
        else:
            ir_result_reg_flag = 0
    return ir_result_reg_flag == 1

# register `name` for the two-register result ABI when it qualifies. the gate
# is per-FUNCTION and must be decided before any call site emits, which is why
# it runs during return-clause registration. narrow on purpose: no generics
# (specializations re-emit bodies under substitution), no `main` (the entry
# glue expects one return), and only Int/Bool ok payloads so the extracted
# value never needs reference counting. the error payload is whatever `fail`
# produced — always a single register, released by the consumer exactly as
# the box world's err slot is.
fn ir_maybe_register_result_reg(name: String, node: Node, home_module: String):
    if not ir_result_reg_enabled():
        return
    if name == "main":
        return
    if ir_has_generic_params(node):
        return
    if not ir_func_returns.contains_key(name) or ir_func_returns[name] != "tuple":
        return
    if not ir_func_result_ok_kinds.contains_key(name):
        return
    ok_kind := ir_func_result_ok_kinds[name]
    if not ir_result_reg_ok_kind_fits(ok_kind):
        return
    # the typed-decode emitters call json/config/toml/yaml helpers by raw
    # name (ir_resolve_json_call_name and friends), bypassing the rcall
    # hooks — a plain `call` into a pair-returning function reads the flag
    # as the value. keep those modules on the box ABI until the raw decode
    # call sites learn the pair. each module compiles in its own emitter
    # pass with UNPREFIXED names (the driver adds std_json_ when combining),
    # so the module identity comes from the current module path, not the
    # registered name.
    if name.starts_with("std_json_") or name.starts_with("std_config_") or name.starts_with("std_toml_") or name.starts_with("std_yaml_"):
        return
    if home_module.contains("json") or home_module.contains("config") or home_module.contains("toml") or home_module.contains("yaml"):
        return
    # a declaration containing a lambda or a spawn is excluded: their bodies
    # are emitted as separate single-return functions while the enclosing
    # function's return kind is still in effect, so a `fail` or `!` inside
    # one would try to return the pair from a function that has no pair.
    for child_idx in node.children:
        if ir_node_contains_lambda_or_spawn(child_idx):
            return
    ir_result_reg_funcs.insert(name, true)

# the ok payload kind of a method that returns a result, resolved through
# the impl's associated-type bindings the same way its header type is.
fn ir_method_result_ok_kind(impl_type: String, method_idx: Int) -> String:
    node := get_node(method_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "result_type" and rn.children.len() > 0:
                    return ir_retkind(ir_resolve_assoc_type(impl_type, ir_resolve_type_node(rn.children[0])))
    return ""

# register a plain-impl method for the register ABI when its result shape
# fits. interface impls (`impl Iface for T`) are excluded wholesale: their
# defaults are shared fn_decl nodes emitted once per conforming type, and
# their methods back generic bounds whose bodies re-emit under specialized
# names. a generic impl target is excluded the same way a generic function
# is — its methods re-emit per specialization while this registry keys the
# base name. beyond that the gate matches the free-function one exactly,
# including the json-family home-module exclusion and the lambda/spawn
# body exclusion (see ir_maybe_register_result_reg for both rationales).
fn ir_maybe_register_result_reg_method(impl_node: Node, impl_type: String, method_idx: Int, method_node: Node, module_path: String):
    if not ir_result_reg_enabled():
        return
    if ir_impl_interface_base(impl_node).len() > 0:
        return
    if impl_type.contains("["):
        return
    if ir_has_generic_params(method_node):
        return
    if ir_resolve_assoc_type(impl_type, ir_extract_return_type(method_idx)) != "tuple":
        return
    ok_kind := ir_method_result_ok_kind(impl_type, method_idx)
    if not ir_result_reg_ok_kind_fits(ok_kind):
        return
    mut home := module_path
    if home.len() == 0:
        home = ir_current_module_path
    if home.contains("json") or home.contains("config") or home.contains("toml") or home.contains("yaml"):
        return
    for child_idx in method_node.children:
        if ir_node_contains_lambda_or_spawn(child_idx):
            return
    mut full_name := impl_type + "_" + method_node.value
    if module_path.len() > 0:
        full_name = ir_import_impl_method_name(module_path, impl_type, method_node.value)
    ir_result_reg_funcs.insert(full_name, true)
    ir_func_result_ok_kinds.insert(full_name, ok_kind)

fn ir_node_contains_lambda_or_spawn(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "lambda" or node.kind == "spawn":
        return true
    for child_idx in node.children:
        if ir_node_contains_lambda_or_spawn(child_idx):
            return true
    return false

# lower a call to a pair-returning function. always emits rcall; then either
# hands the raw pair to the consumer that asked for it (the try emitter, via
# the defer handshake) or folds the pair into an ordinary result box so every
# other context — bindings, field reads, argument position, forwarding —
# behaves exactly as the box world always has.
# the ok payload kinds the register ABI carries. every entry is one i64
# register: ints and bools by value, the reference-counted kinds as handles
# whose count transfers through the register exactly as it transferred
# through the box's ok slot. Float needs the f64 pair (result_reg_f) and
# multi-word shapes (tuple, optional) have no single register — excluded.
fn ir_result_reg_ok_kind_fits(ok_kind: String) -> Bool:
    if ok_kind == "int" or ok_kind == "bool" or ok_kind == "string" or ok_kind == "bytes":
        return true
    if ok_kind == "list" or ok_kind == "list_string" or ok_kind == "map" or ok_kind == "map_int" or ok_kind == "set" or ok_kind == "set_int":
        return true
    return ok_kind.starts_with("struct:")

fn ir_emit_result_reg_call(r: Int, fname: String, arg_count: Int, arg_text: String) -> Int:
    flag_r := ir_reg()
    val_r := ir_reg()
    mut payload_kind := "int"
    if ir_func_result_ok_kinds.contains_key(fname):
        payload_kind = ir_func_result_ok_kinds[fname]
    mut line := "rcall " + flag_r.to_string() + " " + val_r.to_string() + " " + fname + " " + payload_kind + " " + arg_count.to_string()
    if arg_text.len() > 0:
        line = line + arg_text
    ir_emit(line)
    if ir_rcall_current_idx >= 0 and ir_rcall_current_idx == ir_rcall_defer_idx:
        ir_rcall_pair_ready = true
        ir_rcall_flag_reg = flag_r
        ir_rcall_val_reg = val_r
        return r
    return ir_emit_result_reg_box(flag_r, val_r)

# fold an rcall's (flag, payload) pair into a three-slot result box: the
# payload register holds the ok value on the ok path and the error on the err
# path, so each arm stores it in its own slot. ownership transfers into the
# box with no extra count, the same as a callee-built box.
fn ir_emit_result_reg_box(flag_r: Int, val_r: Int) -> Int:
    temp_name := ir_new_temp_name("rreg_box")
    ir_var_types.insert(temp_name, "tuple")
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_tuple := ir_emit_ok_result_tuple(val_r)
    ir_emit("store " + temp_name + " " + ok_tuple.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_tuple := ir_emit_err_result_tuple(val_r)
    ir_emit("store " + temp_name + " " + err_tuple.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# hand a legacy single-register result straight to the pair handshake:
# decode the sentinel into (flag, payload) registers with no box on either
# arm. the err payload is the same static message string the box path
# stores, so the consumer's release path sees nothing new. float stays on
# the box path — its payload cannot travel an int-typed temp.
fn ir_emit_wrapped_legacy_pair(raw_r: Int, legacy_kind: String, callee_name: String) -> Int:
    flag_temp := ir_new_temp_name("lp_flag")
    val_temp := ir_new_temp_name("lp_val")
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    cond_r := ir_reg()
    ir_emit("neq " + cond_r.to_string() + " " + raw_r.to_string() + " " + zero_r.to_string())
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    mut ok_r := raw_r
    if legacy_kind == "result_int" or legacy_kind == "result_bool":
        ok_r = ir_decode_result_value(raw_r, legacy_kind)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("store " + flag_temp + " " + one_r.to_string())
    ir_emit("store " + val_temp + " " + ok_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    zf_r := ir_reg()
    ir_emit("iconst " + zf_r.to_string() + " 0")
    ir_emit("store " + flag_temp + " " + zf_r.to_string())
    ir_emit("store " + val_temp + " " + ir_emit_result_error_message(callee_name).to_string())
    ir_emit_label(merge_l)
    flag_r := ir_reg()
    ir_emit("load " + flag_r.to_string() + " " + flag_temp)
    val_r := ir_reg()
    ir_emit("load " + val_r.to_string() + " " + val_temp)
    ir_rcall_pair_ready = true
    ir_rcall_flag_reg = flag_r
    ir_rcall_val_reg = val_r
    return raw_r

fn ir_emit_wrapped_legacy_result(raw_r: Int, legacy_kind: String, callee_name: String) -> Int:
    temp_name := ir_new_temp_name("legacy_result")
    ir_var_types.insert(temp_name, "tuple")
    zero_r := ir_reg()
    if legacy_kind == "float":
        ir_emit("fconst " + zero_r.to_string() + " 0.0")
    else:
        ir_emit("iconst " + zero_r.to_string() + " 0")
    cond_r := ir_reg()
    ir_emit("neq " + cond_r.to_string() + " " + raw_r.to_string() + " " + zero_r.to_string())
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    mut ok_r := raw_r
    if legacy_kind == "result_int" or legacy_kind == "result_bool":
        ok_r = ir_decode_result_value(raw_r, legacy_kind)
    ok_tuple := ir_emit_ok_result_tuple(ok_r)
    ir_emit("store " + temp_name + " " + ok_tuple.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_tuple := ir_emit_err_result_tuple(ir_emit_result_error_message(callee_name))
    ir_emit("store " + temp_name + " " + err_tuple.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_result_field_access(idx: Int, obj_r: Int, fname: String) -> Int:
    obj_tid := c_get_expr_type(node_child(idx, 0))
    if obj_tid >= 0:
        obj_info := get_type_info(obj_tid)
        if obj_info.kind == "result":
            if fname == "ok":
                return ir_emit_result_value_field(obj_r, obj_tid, "ok")
            if fname == "err":
                return ir_emit_result_value_field(obj_r, obj_tid, "err")
            if fname == "is_ok" or fname == "is_err":
                return ir_emit_result_flag_field(obj_r, fname)
    return 0 - 1

fn ir_method_call_arg_expr(node: Node, arg_index: Int) -> Int:
    actual_index := arg_index + 1
    if actual_index >= node.children.len():
        return 0 - 1
    child := node.children[actual_index]
    cn := get_node(child)
    if cn.kind == "arg" and cn.children.len() > 0:
        return cn.children[0]
    return child

# how `!`, `catch`, and `unwrap_or` should treat the shell of their result
# or optional operand:
#   "owned"    — a fresh shell this extraction is the sole owner of: a call
#                or method-call result (results and optionals always arrive
#                owned from a call; user returns retain borrowed payloads on
#                the way out, runtime producers mint new tuples), or an
#                awaited task's value.
#   "borrowed" — a shell some other owner will release: a parameter or a
#                named local (an ident), a struct field, a container
#                element. the extraction must not free the shell, and must
#                not hand out the shell's payload count as if it owned it —
#                the owner releases the shell at its own scope exit, so
#                either mistake is a double-free.
#   "opaque"   — anything else (a match or if expression value, ...): kept
#                on the historical owned-style treatment, which can leak a
#                shell but predates this classification.
# parens are transparent. mirrors ir_optional_subject_is_owned, which makes
# the same call-vs-borrow split for optional subjects.
fn ir_extraction_operand_class(idx: Int) -> String:
    node := get_node(idx)
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_extraction_operand_class(node.children[0])
    if node.kind == "call" or node.kind == "method_call" or node.kind == "await":
        return "owned"
    if node.kind == "ident" or node.kind == "field_access" or node.kind == "index":
        return "borrowed"
    return "opaque"

fn ir_emit_result_unwrap_or(idx: Int, node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    operand_class := ir_extraction_operand_class(node.children[0])
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("unwrap_or")
    arg_idx := ir_method_call_arg_expr(node, 0)
    ok_l := ir_label()
    fallback_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + fallback_l)
    ir_emit_label(ok_l)
    ok_value_r := ir_emit_result_value_field(recv_r, recv_tid, "ok")
    if operand_class == "borrowed":
        # the operand's owner keeps the shell and its payload count.
        # consumers treat a heap-kind unwrap_or value as owned (see the
        # method_call cases in ir_string_expr_is_borrowed), so hand them
        # their own count instead of the one the shell holds; a string
        # payload stays classified borrowed and keeps the retain-at-escape
        # convention, exactly like a `.ok` read.
        if not ir_string_expr_is_borrowed(idx):
            ir_rc_retain_reg(ok_value_r, ir_rc_kind(ir_result_field_kind(recv_tid, "ok")))
    else:
        # a fresh shell: the extracted payload carries the count out, and
        # the destructor-less tuple frees as just its three slots.
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + ok_value_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(fallback_l)
    # build the fallback INSIDE the error arm: on the ok path it is never
    # needed, and evaluating it eagerly before the branch leaked a heap default
    # (`r.unwrap_or(bytes.empty())`) every ok iteration. this mirrors the
    # optional unwrap_or, which already defers its default into the none arm.
    fallback_r := ir_expr(arg_idx)
    # consumers treat a heap-kind unwrap_or value as owned and release it, so
    # a fallback that arrives borrowed (a named local, a field) needs a count
    # of its own here — without one that release strips the owner's count and
    # the owner's next use reads freed memory. a string fallback is excluded
    # because a string unwrap_or stays classified borrowed (the escape site
    # retains), mirroring the ok arm.
    if not ir_string_expr_is_borrowed(idx) and ir_string_expr_is_borrowed(arg_idx):
        ir_rc_retain_reg(fallback_r, ir_rc_kind(ir_result_field_kind(recv_tid, "ok")))
    if operand_class != "borrowed":
        ir_emit_release_result_error(recv_r, recv_tid)
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + fallback_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_result_value_to_string(recv_r: Int, recv_tid: Int) -> Int:
    mut ok_tid := 0 - 1
    mut err_tid := 0 - 1
    if recv_tid >= 0:
        recv_info := get_type_info(recv_tid)
        if recv_info.kind == "result":
            ok_tid = recv_info.inner
            err_tid = recv_info.value_type
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("result_to_string")
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_r := ir_emit_result_value_field(recv_r, recv_tid, "ok")
    ir_emit("store " + temp_name + " " + ir_emit_stringify_value(ok_r, ok_tid).to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_r := ir_emit_result_value_field(recv_r, recv_tid, "err")
    ir_emit("store " + temp_name + " " + ir_emit_stringify_value(err_r, err_tid).to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_stringify_value(value_r: Int, value_tid: Int) -> Int:
    value_type := ir_type_from_tid(value_tid)
    if value_type == "string":
        return value_r
    out_r := ir_reg()
    if value_type == "bool":
        ir_emit_call1(out_r, "bool_to_string", "string", value_r)
        return out_r
    if value_type == "float":
        ir_emit_call1(out_r, "float_to_string", "string", value_r)
        return out_r
    if value_type == "int":
        ir_emit_call1(out_r, "int_to_string", "string", value_r)
        return out_r
    if value_tid >= 0:
        value_info := get_type_info(value_tid)
        if value_info.kind == "result":
            return ir_emit_result_value_to_string(value_r, value_tid)
    return value_r

fn ir_emit_result_to_string(node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    return ir_emit_result_value_to_string(recv_r, recv_tid)

fn ir_emit_named_handler_call(handler_idx: Int, arg_r: Int, ret_type: String) -> Int:
    handler_node := get_node(handler_idx)
    callee := ir_resolve_static_callee(handler_idx)
    mut call_name := callee.name
    if call_name.len() == 0 and handler_node.kind == "ident":
        call_name = handler_node.value
    if call_name.len() > 0:
        out_r := ir_reg()
        if ir_result_reg_funcs.contains_key(call_name):
            # a pair-returning handler: bind the pair and fold it into the
            # box this consumer expects.
            return ir_emit_result_reg_call(out_r, call_name, 1, " " + arg_r.to_string())
        legacy_kind := ir_builtin_result_retkind(call_name)
        mut call_type := ret_type
        if legacy_kind.len() > 0:
            call_type = legacy_kind
        ir_emit_call_text(out_r, call_name, call_type, 1, " " + arg_r.to_string())
        if legacy_kind.len() > 0 and ret_type == "tuple":
            return ir_emit_wrapped_legacy_result(out_r, legacy_kind, call_name)
        return out_r
    handler_r := ir_expr(handler_idx)
    handler_name := ir_new_temp_name("handler")
    ir_emit("store " + handler_name + " " + handler_r.to_string())
    out_r := ir_reg()
    ir_emit_call_text(out_r, handler_name, ret_type, 1, " " + arg_r.to_string())
    return out_r

fn ir_emit_result_or_else(idx: Int, node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("or_else")
    ir_var_types.insert(temp_name, "tuple")
    handler_idx := ir_method_call_arg_expr(node, 0)
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + recv_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_r := ir_emit_result_value_field(recv_r, recv_tid, "err")
    handled_r := ir_emit_named_handler_call(handler_idx, err_r, ir_checked_type(idx))
    # the handler borrowed the error; the original result is spent now,
    # so drop the error value and the tuple shell before continuing
    ir_emit_release_result_error(recv_r, recv_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + handled_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_select_recv_probe(recv_idx: Int) -> Int:
    recv_node := get_node(recv_idx)
    if recv_node.kind != "method_call" or recv_node.children.len() == 0:
        return ir_zero_reg()
    ch_r := ir_expr(recv_node.children[0])
    r := ir_reg()
    ir_emit_call1(r, "pith_channel_try_recv", "tuple", ch_r)
    return r

fn ir_emit_select_send_probe(send_idx: Int) -> Int:
    send_node := get_node(send_idx)
    if send_node.kind != "method_call" or send_node.children.len() == 0:
        return ir_zero_reg()
    ch_r := ir_expr(send_node.children[0])
    arg_idx := ir_method_call_arg_expr(send_node, 0)
    if arg_idx < 0:
        return ir_zero_reg()
    val_r := ir_expr(arg_idx)
    r := ir_reg()
    ir_emit_call2(r, "pith_channel_try_send", "bool", ch_r, val_r)
    return r

fn ir_emit_select_arm_body(body_idx: Int, bind_name: String, bind_r: Int, bind_type: String) -> Int:
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    if bind_name.len() > 0:
        if bind_type.len() > 0:
            ir_var_types.insert(bind_name, bind_type)
        ir_emit("store " + bind_name + " " + bind_r.to_string())
    body_node := get_node(body_idx)
    mut body_r := ir_zero_reg()
    if body_node.kind == "body":
        if body_node.children.len() > 0:
            body_r = ir_expr(body_node.children[0])
    elif body_node.kind == "block":
        ir_block(body_idx)
    else:
        body_r = ir_expr(body_idx)
    ir_var_regs = saved_vars
    ir_var_types = saved_types
    return body_r

fn ir_select_probe_arm_indices(node: Node) -> List[Int]:
    mut probe_arms: List[Int] := []
    for arm_idx in node.children:
        arm_node := get_node(arm_idx)
        if arm_node.kind == "select_recv_arm" or arm_node.kind == "select_send_arm":
            probe_arms.push(arm_idx)
    return probe_arms

struct IrSelectParts:
    probe_arms: List[Int]
    timeout_idx: Int
    default_idx: Int

fn ir_collect_select_parts(node: Node) -> IrSelectParts:
    mut timeout_idx := 0 - 1
    mut default_idx := 0 - 1
    for child in node.children:
        arm_node := get_node(child)
        if arm_node.kind == "select_timeout_arm" and timeout_idx < 0:
            timeout_idx = child
        elif arm_node.kind == "select_default_arm" and default_idx < 0:
            default_idx = child
    return IrSelectParts(ir_select_probe_arm_indices(node), timeout_idx, default_idx)

fn ir_emit_select_probe_arm(arm_idx: Int, result_temp: String, end_l: String):
    arm_node := get_node(arm_idx)
    if arm_node.kind == "select_recv_arm" and arm_node.children.len() >= 2:
        maybe_r := ir_emit_select_recv_probe(arm_node.children[0])
        ready_r := ir_optional_flag_field(maybe_r)
        hit_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + ready_r.to_string() + " " + hit_l + " " + next_l)
        ir_emit_label(hit_l)
        body_r := ir_emit_select_arm_body(arm_node.children[1], arm_node.value, maybe_r, ir_checked_type(arm_node.children[0]))
        ir_emit("store " + result_temp + " " + body_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(next_l)
    elif arm_node.kind == "select_send_arm" and arm_node.children.len() >= 2:
        ready_r := ir_emit_select_send_probe(arm_node.children[0])
        hit_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + ready_r.to_string() + " " + hit_l + " " + next_l)
        ir_emit_label(hit_l)
        body_r := ir_emit_select_arm_body(arm_node.children[1], "", 0, "")
        ir_emit("store " + result_temp + " " + body_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(next_l)

fn ir_emit_select_deadline(timeout_idx: Int) -> String:
    if timeout_idx < 0:
        return ""
    deadline_name := ir_new_temp_name("select_deadline")
    timeout_node := get_node(timeout_idx)
    timeout_r := ir_expr(timeout_node.children[0])
    now_r := ir_reg()
    ir_emit_call0(now_r, "time", "int")
    deadline_r := ir_reg()
    ir_emit("add " + deadline_r.to_string() + " " + now_r.to_string() + " " + timeout_r.to_string())
    ir_emit("store " + deadline_name + " " + deadline_r.to_string())
    return deadline_name

fn ir_emit_select_offset(probe_count: Int) -> String:
    if probe_count <= 1:
        return ""
    offset_name := ir_new_temp_name("select_offset")
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + probe_count.to_string())
    seed_r := ir_reg()
    ir_emit_call1(seed_r, "pith_select_next_index", "int", count_r)
    ir_emit("store " + offset_name + " " + seed_r.to_string())
    return offset_name

fn ir_emit_rotated_select_probes(probe_arms: List[Int], offset_name: String, result_temp: String, end_l: String):
    probe_count := probe_arms.len()
    probe_done_l := ir_label()
    offset_r := ir_reg()
    ir_emit("load " + offset_r.to_string() + " " + offset_name)
    mut i := 0
    while i < probe_count:
        case_l := ir_label()
        next_case_l := ir_label()
        match_r := ir_reg()
        case_r := ir_reg()
        ir_emit("iconst " + case_r.to_string() + " " + i.to_string())
        ir_emit("eq " + match_r.to_string() + " " + offset_r.to_string() + " " + case_r.to_string())
        ir_emit("brif " + match_r.to_string() + " " + case_l + " " + next_case_l)
        ir_emit_label(case_l)
        mut j := 0
        while j < probe_count:
            probe_idx := (i + j) % probe_count
            ir_emit_select_probe_arm(probe_arms[probe_idx], result_temp, end_l)
            j = j + 1
        ir_emit("jmp " + probe_done_l)
        ir_emit_label(next_case_l)
        i = i + 1
    ir_emit_label(probe_done_l)

fn ir_emit_select_probes(probe_arms: List[Int], offset_name: String, result_temp: String, end_l: String):
    probe_count := probe_arms.len()
    if probe_count == 0:
        return
    if probe_count == 1:
        ir_emit_select_probe_arm(probe_arms[0], result_temp, end_l)
        return
    ir_emit_rotated_select_probes(probe_arms, offset_name, result_temp, end_l)

fn ir_emit_select_default(default_idx: Int, result_temp: String, end_l: String):
    if default_idx < 0:
        return
    default_node := get_node(default_idx)
    if default_node.children.len() == 0:
        return
    body_r := ir_emit_select_arm_body(default_node.children[0], "", 0, "")
    ir_emit("store " + result_temp + " " + body_r.to_string())
    ir_emit("jmp " + end_l)

fn ir_emit_select_timeout(timeout_idx: Int, deadline_name: String, result_temp: String, end_l: String):
    if timeout_idx < 0:
        return
    now_r := ir_reg()
    ir_emit_call0(now_r, "time", "int")
    deadline_r := ir_reg()
    ir_emit("load " + deadline_r.to_string() + " " + deadline_name)
    expired_r := ir_reg()
    ir_emit("gte " + expired_r.to_string() + " " + now_r.to_string() + " " + deadline_r.to_string())
    timeout_l := ir_label()
    wait_l := ir_label()
    ir_emit("brif " + expired_r.to_string() + " " + timeout_l + " " + wait_l)
    ir_emit_label(timeout_l)
    timeout_node := get_node(timeout_idx)
    body_r := ir_emit_select_arm_body(timeout_node.children[1], "", 0, "")
    ir_emit("store " + result_temp + " " + body_r.to_string())
    ir_emit("jmp " + end_l)
    ir_emit_label(wait_l)

fn ir_advance_select_offset(probe_count: Int, offset_name: String):
    if probe_count <= 1:
        return
    next_offset_r := ir_reg()
    cur_offset_r := ir_reg()
    one_r := ir_reg()
    count_r := ir_reg()
    ir_emit("load " + cur_offset_r.to_string() + " " + offset_name)
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("iconst " + count_r.to_string() + " " + probe_count.to_string())
    next_sum_r := ir_reg()
    ir_emit("add " + next_sum_r.to_string() + " " + cur_offset_r.to_string() + " " + one_r.to_string())
    ir_emit("mod " + next_offset_r.to_string() + " " + next_sum_r.to_string() + " " + count_r.to_string())
    ir_emit("store " + offset_name + " " + next_offset_r.to_string())

fn ir_emit_select_wait(loop_l: String, probe_count: Int, offset_name: String):
    ir_advance_select_offset(probe_count, offset_name)
    delay_r := ir_reg()
    ir_emit("iconst " + delay_r.to_string() + " 1")
    sleep_r := ir_reg()
    ir_emit_call1(sleep_r, "sleep", "unknown", delay_r)
    ir_emit("jmp " + loop_l)

fn ir_emit_select_expr(node: Node) -> Int:
    result_temp := ir_new_temp_name("select")
    parts := ir_collect_select_parts(node)
    probe_count := parts.probe_arms.len()
    deadline_name := ir_emit_select_deadline(parts.timeout_idx)

    loop_l := ir_label()
    end_l := ir_label()
    ir_emit_label(loop_l)

    offset_name := ir_emit_select_offset(probe_count)
    ir_emit_select_probes(parts.probe_arms, offset_name, result_temp, end_l)
    ir_emit_select_default(parts.default_idx, result_temp, end_l)
    ir_emit_select_timeout(parts.timeout_idx, deadline_name, result_temp, end_l)
    ir_emit_select_wait(loop_l, probe_count, offset_name)
    ir_emit_label(end_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

# a channel send hands the value to whoever receives it, on another task and
# usually after the sender's frame is gone. both forms transfer ownership, so
# both need the same count: try_send used to be missing here, which let a
# borrowed value (`ch.try_send(wire.ok)`) reach the receiver with no count of
# its own and an owned temporary be released the moment the call returned.
# a send that fails leaves the extra count behind — a bounded leak, and the
# same trade already accepted for the blocking form.
fn ir_is_channel_send_name(emit_name: String) -> Bool:
    if emit_name == "send" or emit_name == "pith_channel_send":
        return true
    return emit_name == "try_send" or emit_name == "pith_channel_try_send"

# --- method call dispatch ---
fn ir_emit_method_call(idx: Int) -> Int:
    # A method call is lowered by a handful of specialized emitters tried in
    # order; each returns a register or -1 ("not my shape, keep looking"). The
    # order matters — an earlier shape shadows the ones after it:
    #   1. enum variant construction   Shape.Circle(2.5) / mod.Enum.Variant(..)
    #   2. type-directed builtins       Int.to_string, Result.*, Optional.*
    #   3. module-qualified call        mod.Struct(..) / mod.some_fn(..)
    #   4. general dispatch             impl methods, closure-typed fields
    variant_r := ir_emit_variant_ctor_method(idx)
    if variant_r >= 0:
        return variant_r
    typed_r := ir_emit_typed_receiver_method(idx)
    if typed_r >= 0:
        return typed_r
    alias_r := ir_emit_module_alias_method(idx)
    if alias_r >= 0:
        return alias_r
    return ir_emit_general_method_call(idx)

# `Shape.Circle(2.5)` parses as a method call on the enum type name but is
# really a variant construction. Handles both the local form and the
# module-qualified `mod.Enum.Variant(...)` form. Returns -1 when the receiver
# is not a (possibly aliased) boxed-enum name.
fn ir_emit_variant_ctor_method(idx: Int) -> Int:
    node := get_node(idx)
    # first child is the receiver, then args; value is the method name (with a
    # possible leading dot stripped by ir_plain_method_name).
    mname := ir_plain_method_name(node_value(idx))
    if node.children.len() > 0:
        ctor_recv := get_node(node.children[0])
        if ctor_recv.kind == "ident" and ir_boxed_enums.contains_key(ctor_recv.value):
            ctor_key := ctor_recv.value + "." + mname
            if ir_struct_field_index_lookup.contains_key(ctor_key):
                return ir_emit_variant_construction(node, ctor_recv.value, ctor_key)
        # a module-qualified variant, `mod.Enum.Variant(...)`: the receiver is a
        # field access `mod.Enum` where mod is an import alias and Enum is a
        # boxed enum (registered by its base name across modules). resolve it the
        # same as the local `Enum.Variant(...)` form.
        if ctor_recv.kind == "field_access" and ctor_recv.children.len() > 0:
            qual_mod := get_node(ctor_recv.children[0])
            if qual_mod.kind == "ident" and ir_module_aliases.contains_key(qual_mod.value) and ir_boxed_enums.contains_key(ctor_recv.value):
                qual_key := ctor_recv.value + "." + mname
                if ir_struct_field_index_lookup.contains_key(qual_key):
                    return ir_emit_variant_construction(node, ctor_recv.value, qual_key)
    return 0 - 1

# Methods whose lowering is chosen by the receiver's static type rather than by
# name resolution: unsigned `to_string`, the `Result` combinators, and the
# `Optional` accessors. Also handles a bare `.value()` extract inside a
# specialized generic impl body, where the receiver's optional type was
# suppressed at registration. Returns -1 when none apply.
fn ir_emit_typed_receiver_method(idx: Int) -> Int:
    node := get_node(idx)
    mname := ir_plain_method_name(node_value(idx))
    if node.children.len() > 0:
        # ir_emission_tid, not the bare checked tid: inside a generic
        # specialization an optional parameter's receiver carries the
        # unspecialized marker, and `b.unwrap_or(d)` then fell past this
        # whole block to a plain method call, emitting `call unwrap_or` —
        # a name no function ever defines.
        recv_tid := ir_emission_tid(node.children[0])
        if recv_tid >= 0:
            recv_info := get_type_info(recv_tid)
            if recv_info.kind == "primitive" and mname == "to_string":
                if recv_info.name == "UInt" or recv_info.name == "UInt8" or recv_info.name == "UInt16" or recv_info.name == "UInt32" or recv_info.name == "UInt64":
                    obj_r := ir_expr(node.children[0])
                    out_r := ir_reg()
                    ir_emit_call1(out_r, "uint_to_string", "string", obj_r)
                    return out_r
            if recv_info.kind == "result":
                if mname == "unwrap_or":
                    return ir_emit_result_unwrap_or(idx, node)
                if mname == "or_else":
                    return ir_emit_result_or_else(idx, node)
                if mname == "to_string":
                    return ir_emit_result_to_string(node)
            if recv_info.kind == "optional" and mname == "value":
                # unchecked extraction of the inner value (caller has verified
                # the optional is Some); used by iterator adapters in std.iter
                obj_r := ir_expr(node.children[0])
                val_r := ir_optional_value_field(obj_r, recv_tid)
                # free a fresh weak-read shell once its value is extracted
                ir_release_weak_shell(node.children[0], obj_r)
                return val_r
            if recv_info.kind == "optional" and mname == "unwrap_or":
                # some(v) -> v, none -> the default argument
                obj_r := ir_expr(node.children[0])
                # a fresh optional (a call/method result) is an owned shell that
                # would otherwise leak; release it once at the merge below.
                owns_subject := ir_optional_subject_is_owned(node.children[0])
                inner_kind := ir_rc_kind(ir_type_from_tid(recv_info.inner))
                flag_r := ir_optional_flag_field(obj_r)
                tmp := ir_new_temp_name("unwrap_or")
                some_l := ir_label()
                none_l := ir_label()
                end_l := ir_label()
                ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
                ir_emit_label(some_l)
                inner_r := ir_optional_value_field(obj_r, recv_tid)
                # a borrowed subject moves its inner out without a retain: the
                # subject's own cleanup is shell-only, so the single count the
                # shell holds transfers to the extracted value and is released
                # once, at that value's scope. only an owned (fresh) subject,
                # whose shell is freed just below, needs a retain first so the
                # inner survives the free. (extracting the same borrowed local
                # twice is a separate, rarer bug tracked on its own — a retain
                # here to cover it leaked the far more common single case.)
                if inner_kind.len() > 0 and owns_subject:
                    ir_rc_retain_reg(inner_r, inner_kind)
                ir_emit("store " + tmp + " " + inner_r.to_string())
                ir_emit("jmp " + end_l)
                ir_emit_label(none_l)
                default_idx := ir_method_call_arg_expr(node, 0)
                default_r := ir_expr(default_idx)
                # consumers treat a heap-kind unwrap_or value as owned and
                # release it, so a default that arrives borrowed (a named
                # local, a field) needs its own count here — without one that
                # release strips the owner's count and the owner's next use
                # reads freed memory. strings stay on the borrowed
                # classification (the escape site retains), so they are
                # excluded. mirrors the result unwrap_or's fallback arm.
                if inner_kind.len() > 0 and not ir_string_expr_is_borrowed(idx) and ir_string_expr_is_borrowed(default_idx):
                    ir_rc_retain_reg(default_r, inner_kind)
                ir_emit("store " + tmp + " " + default_r.to_string())
                ir_emit_label(end_l)
                if owns_subject:
                    ir_emit_call1(ir_reg(), "pith_struct_release", "void", obj_r)
                out_r := ir_reg()
                ir_emit("load " + out_r.to_string() + " " + tmp)
                return out_r
    # In a specialized generic impl body the receiver of `.value()` may have
    # type T? where T was suppressed at registration (so c_get_expr_type returns
    # TID_ERR). Emit the optional value-field extract directly when we're
    # clearly inside such a body.
    if mname == "value" and ir_current_impl_subst_params.len() > 0 and node.children.len() == 1:
        obj_r := ir_expr(node.children[0])
        r := ir_reg()
        ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 8 unknown value")
        return r
    return 0 - 1

# A module-qualified call, `mod.member(...)`, where `mod` is an import alias.
# Resolves to the target name and emits it — as an inline struct construction
# when the member is a struct type, otherwise as a plain (possibly generic)
# static call. Returns -1 when the receiver is not a module alias.
fn ir_emit_module_alias_method(idx: Int) -> Int:
    node := get_node(idx)
    alias_fname := ir_resolve_module_alias_method_call_name(idx)
    if alias_fname.len() > 0:
        mut call_name := alias_fname
        # a module-qualified struct construction (`mod.Struct(...)`) resolves the
        # alias member to the struct name. emit it through the same inline path as
        # a same-module construction so each field takes ownership and the struct
        # gets its destructor. the generic function-call path below would instead
        # emit a backend constructor call and then release the owned args the
        # struct just stored — dropping a fresh heap value (e.g. `body: bytes...`).
        alias_expr_tid := c_get_expr_type(idx)
        if alias_expr_tid >= 0:
            alias_expr_info := get_type_info(alias_expr_tid)
            if alias_expr_info.kind == "struct" and alias_expr_info.name == call_name:
                mut ctor_args: List[Int] := []
                for child, ci in node.children:
                    if ci == 0:
                        continue
                    ctor_args.push(child)
                return ir_emit_struct_positional_init(call_name, ctor_args, alias_expr_tid)
        if ir_is_generic_function_name(call_name):
            mut generic_ret_type := ir_checked_type(idx)
            if generic_ret_type.len() == 0:
                generic_ret_type = ir_infer_type(idx)
            mct := ir_infer_generic_concrete_types(call_name, node)
            ir_record_generic_spec_arg_tids(call_name, mct, ir_generic_arg_tids(node))
            call_name = ir_queue_generic_specialization(call_name, mct, generic_ret_type)
        arg_regs := ir_collect_call_arg_regs(node, 1)
        mut r := ir_reg()
        uses_result_abi := ir_callee_uses_result_abi(ResolvedCallee(call_name, true), idx)
        ret_type := ir_call_retkind_for_name(idx, uses_result_abi, call_name)
        if ir_result_reg_funcs.contains_key(call_name):
            ir_rcall_current_idx = idx
            r = ir_emit_result_reg_call(r, call_name, arg_regs.len(), ir_join_arg_regs(arg_regs))
            ir_rcall_current_idx = 0 - 1
        else:
            ir_emit_call_text(r, call_name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
        # module-qualified calls take the same transfer convention as
        # plain static calls: owned string temps die with the call
        ir_release_owned_string_args(node, 1, arg_regs)
        if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
            if ret_type != "float" and idx == ir_rcall_defer_idx:
                return ir_emit_wrapped_legacy_pair(r, ret_type, call_name)
            return ir_emit_wrapped_legacy_result(r, ret_type, call_name)
        return r
    return 0 - 1

# The general method dispatch: self-hosted list builtins, a call through a
# closure-typed struct field, and finally an ordinary impl-method call with its
# ARC bookkeeping (container-store retains, argument and receiver releases).
fn ir_emit_general_method_call(idx: Int) -> Int:
    node := get_node(idx)
    mname := ir_plain_method_name(node_value(idx))
    obj_type := ir_method_receiver_type(node)
    self_hosted_list_r := ir_emit_self_hosted_list_method(idx, node, mname, obj_type)
    if self_hosted_list_r >= 0:
        return self_hosted_list_r
    # `recv.f(args)` where `f` is a closure-typed field of recv's struct (not a
    # method of it): there's no method named `f`, so a naive dispatch would emit
    # a literal `call f unknown ...`. Instead load the field into a named local
    # and call it through the closure abi — the same lowering a local
    # `f := fn(...) ...; f(x)` gets, routing through pith_closure_get_fn. Covers
    # `self.f()` inside a generic impl and `h.f(x)` on any struct value; the
    # checker only reaches emission here when `f` is genuinely a fn-value field.
    cf_struct := ir_strip_type_args(obj_type)
    if cf_struct.len() > 0:
        field_key := cf_struct + "." + mname
        existing_method := ir_lookup_impl_method_for(node.children[0], obj_type, mname)
        if ir_struct_field_index_lookup.contains_key(field_key) and existing_method.len() == 0:
            recv_r := ir_expr(node.children[0])
            field_idx := ir_unpack_field_index(ir_struct_field_index_lookup[field_key])
            handle_r := ir_reg()
            ir_emit("field " + handle_r.to_string() + " " + recv_r.to_string() + " " + (field_idx * 8).to_string() + " unknown " + mname)
            tmp_name := ir_temp_name("__cl_field")
            ir_emit("store " + tmp_name + " " + handle_r.to_string())
            mut arg_regs: List[Int] := []
            mut ai := 0
            while ai < node.children.len() - 1:
                arg_idx := ir_method_call_arg_expr(node, ai)
                arg_regs.push(ir_emit_call_arg(arg_idx))
                ai = ai + 1
            r := ir_reg()
            ir_emit("call " + r.to_string() + " " + tmp_name + " unknown " + arg_regs.len().to_string() + ir_join_arg_regs(arg_regs))
            return r
    mut emit_name := ir_method_emit_name(mname, obj_type)
    if emit_name == "list_join" and ir_list_element_kind(node.children[0]) == "int":
        # list_join assumes string elements; Int lists need decimal formatting
        emit_name = "list_join_int"
    if ir_is_bool_returning_method(emit_name):
        ir_var_types.insert("__last_call", "bool")

    # prefer a specialized impl method (registered per-instantiation) so that
    # inside a generic body, self.src.next() dispatches to the specialized
    # version when src's type is itself a generic instance
    mut impl_name := ir_lookup_specialized_method(obj_type, mname)
    if impl_name.len() == 0:
        impl_name = ir_lookup_impl_method_for(node.children[0], obj_type, mname)
    impl_dispatch := impl_name.len() > 0
    if impl_dispatch:
        emit_name = impl_name

    call_regs := ir_collect_method_call_regs(node)
    obj_r := call_regs[0]
    mut arg_regs: List[Int] := []
    mut ci := 0
    while ci + 1 < call_regs.len():
        arg_regs.push(call_regs[ci + 1])
        ci = ci + 1
    mut r := ir_reg()
    uses_result_abi := ir_callee_uses_result_abi(ResolvedCallee(emit_name, impl_dispatch), idx)
    mut ret_type := ir_call_retkind_for_name(idx, uses_result_abi, emit_name)
    if ir_is_void_method(emit_name):
        ret_type = "void"
    # a container store treats its value argument specially: a borrowed value
    # travels with its kind so the container can take the count itself, an
    # owned one transfers its count into the container, and either way the
    # caller's own release is skipped.
    mut store_value_pos := 0 - 1
    if ir_is_channel_send_name(emit_name) or emit_name == "push" or emit_name == "pith_list_push_value" or emit_name == "__list_push":
        store_value_pos = 0
    elif emit_name == "insert" or emit_name == "map_insert" or emit_name == "map_insert_ikey" or emit_name == "set" or emit_name == "pith_list_set_value" or emit_name == "list_insert":
        store_value_pos = 1
    # the name the call is emitted under. an owned value swaps in the store
    # that takes the caller's count; everything else keeps the plain store.
    mut call_name := emit_name
    # a heap value stored into a list or a map travels with its kind, appended
    # after the ordinary arguments, so the container knows whether it owns the
    # kind and can take the one count itself.
    mut store_tag_r := 0 - 1
    if not impl_dispatch:
        if store_value_pos >= 0 and store_value_pos < arg_regs.len():
            value_expr := ir_method_call_arg_expr(node, store_value_pos)
            if value_expr >= 0:
                store_kind := ir_rc_kind(ir_infer_type(value_expr))
                borrowed := ir_string_expr_is_borrowed(value_expr)
                mut kind_store := ir_map_kind_store_name(emit_name, not borrowed)
                if kind_store.len() == 0 and borrowed:
                    kind_store = ir_list_kind_store_name(emit_name)
                if kind_store.len() > 0 and ir_store_learns_kind(store_kind):
                    call_name = kind_store
                    store_tag_r = ir_emit_element_tag_const(store_kind)
                elif borrowed:
                    if ir_channel_send_needs_retain(emit_name, store_kind):
                        ir_rc_retain_reg(arg_regs[store_value_pos], store_kind)
                elif ir_container_store_takes_count(store_kind):
                    # an owned value has a count nobody else will release, so
                    # hand it to the container rather than letting the store
                    # take a second one
                    owned_store := ir_owned_container_store_name(emit_name)
                    if owned_store.len() > 0:
                        call_name = owned_store
    # a builtin method on a primitive receiver lowers to its runtime call
    # name here, not at ir_emit_call_text: that helper hands any name a user
    # function declares to that function, which is right for a free call and
    # wrong for a method — the receiver's checked type already resolved the
    # builtin, and a free `fn to_int(text, fallback)` anywhere in the build
    # must not capture `(1.5).to_int()`. most names map to the same runtime
    # key they would have gotten there; the four whose short key is the
    # method name itself now emit their full symbol, which no declaration
    # can claim.
    if not impl_dispatch and ir_obj_type_is_primitive(obj_type):
        call_name = ir_primitive_method_call_name(call_name)
    call_args := ir_method_call_arg_regs(obj_r, arg_regs)
    if emit_name == "identity" and not impl_dispatch:
        return obj_r
    mut call_arg_text := ir_join_arg_regs(call_args)
    mut call_arg_count := call_args.len()
    if store_tag_r >= 0:
        call_arg_text = call_arg_text + " " + store_tag_r.to_string()
        call_arg_count = call_arg_count + 1
    if ir_result_reg_funcs.contains_key(call_name):
        # a pair-returning callee: a registered plain-impl method, or a
        # module-alias call that resolved to a pair-returning free function.
        # the handshake lets a `!` or `catch` wrapping this call consume the
        # raw pair; any other context folds it into the usual box.
        ir_rcall_current_idx = idx
        r = ir_emit_result_reg_call(r, call_name, call_arg_count, call_arg_text)
        ir_rcall_current_idx = 0 - 1
    else:
        ir_emit_call_text(r, call_name, ret_type, call_arg_count, call_arg_text)
    # a builtin that may hand an argument straight back out takes no count on
    # either branch, so the caller takes one here — before the release below,
    # which on the hand-back branch drops the very register this just counted.
    # that makes the result owned whichever branch ran, which is what lets the
    # fallback be released like any other owned argument and what stops a
    # container result from being freed out of the map it was read from.
    if not impl_dispatch and ir_method_result_retains_over_args(emit_name):
        ir_rc_retain_reg(r, ir_rc_kind(ir_infer_type(idx)))
    ir_release_owned_method_args(node, arg_regs, store_value_pos)
    if node.children.len() > 0:
        recv_idx := node.children[0]
        recv_kind := ir_rc_kind(ir_infer_type(recv_idx))
        if recv_kind.len() > 0 and not ir_string_expr_is_borrowed(recv_idx):
            # a void method's value IS its receiver (see the return below), so
            # the receiver's count must survive the call and travel with that
            # value — `sort_by_key(xs, key).reverse()` returns the reversed
            # list, and releasing the owned receiver here freed the very list
            # being returned. a discarded void-method chain now leaks its
            # receiver instead, which is the survivable direction.
            if not ir_is_void_method(emit_name):
                ir_rc_release_reg(obj_r, recv_kind)
    if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
        if ret_type != "float" and idx == ir_rcall_defer_idx:
            return ir_emit_wrapped_legacy_pair(r, ret_type, emit_name)
        return ir_emit_wrapped_legacy_result(r, ret_type, emit_name)
    if ir_is_void_method(emit_name):
        return obj_r
    return r

# --- string interpolation ---
fn ir_string_interp_part_reg(child: Int) -> Int:
    cn := get_node(child)
    if cn.kind == "lit":
        si := ir_str(cn.value)
        part_r := ir_reg()
        ir_emit("strref " + part_r.to_string() + " " + si)
        return part_r
    if cn.kind == "interp_spec":
        return ir_emit_interp_spec_part(cn)
    return ir_string_interp_expr_part(child)

fn ir_string_interp_part_owned(child: Int) -> Bool:
    cn := get_node(child)
    if cn.kind == "interp_spec":
        # spec parts allocate fresh output in every shape
        return true
    if cn.kind == "lit":
        # literal strrefs are static; releasing one is a no-op, so treating
        # them as owned keeps the fold logic uniform
        return true
    # a string-typed expression part passes through as a borrow; any other
    # part type goes through a to-string conversion and arrives fresh
    return ir_infer_type(child) != "string" or not ir_string_expr_is_borrowed(child)

fn ir_emit_string_interp(idx: Int) -> Int:
    node := get_node(idx)
    # fold the parts left to right, releasing each intermediate the moment
    # the next concat has copied it. the fold is straight-line code, so the
    # releases stay in the same block as the values they drop.
    mut result_r := 0 - 1
    mut result_owned := false
    mut _fi4 := 0
    kids4_children := node.children
    while _fi4 < kids4_children.len():
        child := kids4_children[_fi4]
        part_r := ir_string_interp_part_reg(child)
        part_owned := ir_string_interp_part_owned(child)
        if result_r < 0:
            result_r = part_r
            result_owned = part_owned
        else:
            nr := ir_reg()
            ir_emit("concat " + nr.to_string() + " " + result_r.to_string() + " " + part_r.to_string())
            if result_owned:
                ir_string_release_reg(result_r)
            if part_owned:
                ir_string_release_reg(part_r)
            result_r = nr
            result_owned = true
        _fi4 = _fi4 + 1
    if result_r < 0:
        result_r = ir_reg()
        ir_emit("strref " + result_r.to_string() + " " + ir_str(""))
        result_owned = true
    if not result_owned:
        # single borrowed part ("{s}"): callers treat interpolation results
        # as owned, so give this one its own count
        ir_string_retain_reg(result_r)
    return result_r

# --- lambda compilation ---
struct LambdaParts:
    params: List[String]
    body_idx: Int
    captures: List[String]

fn ir_collect_lambda_parts(idx: Int) -> LambdaParts:
    mut params: List[String] := []
    mut body_idx := 0 - 1
    mut i := 0
    while i < node_child_count(idx):
        child := node_child(idx, i)
        cn := get_node(child)
        if cn.kind == "param":
            params.push(cn.value)
        elif cn.kind == "body" or cn.kind == "block":
            body_idx = child
        i = i + 1
    mut captures: List[String] := []
    if body_idx >= 0:
        captures = ir_find_free_vars(body_idx, params)
    return LambdaParts(params, body_idx, captures)

fn ir_reset_lambda_emit_state():
    ir_builder_reset_function()
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()
    # a lambda / wrapper is its own function with its own slots. an enclosing
    # loop's variable slots do not exist in that frame — the capture prologue
    # stores captured values under their plain names — so start it empty. each
    # caller saves the outer mapping first and puts it back afterwards.
    ir_loop_var_slots = {}

fn ir_emit_lambda_params(params: List[String]):
    for param in params:
        lr := ir_reg()
        ir_var_regs.insert(param, lr)
        ir_emit("param " + param)

# a lambda's returned value transfers to the caller, like any function
# return: a borrowed string (a field read, a parameter) takes a count
# on the way out, so the caller's release is balanced.
fn ir_emit_lambda_expr_return(expr_idx: Int):
    br := ir_expr(expr_idx)
    if ir_infer_type(expr_idx) == "string" and ir_string_expr_is_borrowed(expr_idx):
        ir_rc_retain_reg(br, "string")
    ir_emit("ret " + br.to_string())

fn ir_emit_lambda_body_value(body_idx: Int):
    if body_idx < 0:
        return
    if node_kind(body_idx) == "body" and node_child_count(body_idx) > 0:
        ir_emit_lambda_expr_return(node_child(body_idx, 0))
        return
    if node_kind(body_idx) == "block":
        # multi-line lambda: statements run in order, return statements
        # produce the value, and the default return after this covers a
        # fall-through end
        ir_block(body_idx)
        return
    ir_emit_lambda_expr_return(body_idx)

fn ir_emit_lambda_default_return():
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")

fn ir_finish_lambda_emit(saved_builder: IrBuilderSnapshot, saved_vars: Map[String, Int], saved_types: Map[String, String]):
    ir_append_deferred_lambda_body()
    ir_builder_restore(saved_builder)
    ir_var_regs = saved_vars
    ir_var_types = saved_types

fn ir_emit_lambda(idx: Int) -> Int:
    # compile lambda body as a separate function
    lambda_name := "__lambda_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    parts := ir_collect_lambda_parts(idx)

    # decide which captures are weak while the ENCLOSING function's kind
    # state is still in place — the body emission below clears it. these
    # names read through the weak liveness resolution inside the lambda,
    # and the capture setup at the bottom stores them under tag 8.
    mut lambda_weak_caps: List[String] := []
    for cap in parts.captures:
        if ir_name_is_weak_read(cap):
            lambda_weak_caps.push(cap)

    # save current state and emit lambda to deferred buffer
    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    saved_string_locals := ir_string_locals
    saved_rc_kinds := ir_rc_local_kinds
    saved_tuple_tids := ir_tuple_local_tid
    saved_tuple_cascade := ir_tuple_cascade_names
    # the lambda body is its own function frame; open loops in the enclosing
    # function must not have their iterables released by a return inside it.
    saved_loop_iter_vars := ir_loop_iter_vars
    saved_loop_iter_kinds := ir_loop_iter_kinds
    saved_loop_var_slots := ir_loop_var_slots
    saved_weak_caps := ir_weak_capture_names
    ir_string_locals = []
    ir_rc_local_kinds = []
    ir_tuple_local_tid = {}
    ir_tuple_cascade_names = []
    ir_loop_iter_vars = []
    ir_loop_iter_kinds = []
    ir_weak_capture_names = lambda_weak_caps
    ir_reset_lambda_emit_state()
    # a lambda defined inside main is not main: an error return in its body
    # goes to whoever called the lambda, not out of the process.
    saved_in_main := ir_emitting_main_body
    ir_emitting_main_body = false
    ir_emit_func_header(lambda_name, parts.params.len() + 1, "unknown")
    ir_emit_lambda_hidden_param()
    ir_emit_lambda_params(parts.params)
    ir_emit_lambda_capture_loads(parts.captures)
    ir_emit_lambda_body_value(parts.body_idx)
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)
    ir_emitting_main_body = saved_in_main
    ir_string_locals = saved_string_locals
    ir_rc_local_kinds = saved_rc_kinds
    ir_tuple_local_tid = saved_tuple_tids
    ir_tuple_cascade_names = saved_tuple_cascade
    ir_loop_iter_vars = saved_loop_iter_vars
    ir_loop_iter_kinds = saved_loop_iter_kinds
    ir_loop_var_slots = saved_loop_var_slots
    # restored before the capture setup below, so a nested lambda's setup
    # still sees which of the ENCLOSING lambda's names are weak captures
    ir_weak_capture_names = saved_weak_caps
    # return closure handle and fill captures
    r := ir_reg()
    ir_emit("closure_ref " + r.to_string() + " " + lambda_name)
    ir_emit_lambda_capture_setup(r, parts.captures)
    return r

fn ir_emit_spawn_wrapper(call_idx: Int) -> Int:
    wrapper_name := "__spawn_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    mut captures: List[String] := []
    call_node := get_node(call_idx)
    if call_node.children.len() > 0:
        callee := ir_resolve_static_callee(call_node.children[0])
        if callee.name.len() == 0:
            captures = ir_find_free_vars(call_node.children[0], [])
        mut i := 1
        while i < call_node.children.len():
            free_in_arg := ir_find_free_vars(call_node.children[i], [])
            mut j := 0
            while j < free_in_arg.len():
                if not ir_list_contains(captures, free_in_arg[j]):
                    captures.push(free_in_arg[j])
                j = j + 1
            i = i + 1

    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    saved_loop_var_slots := ir_loop_var_slots

    ir_reset_lambda_emit_state()
    ir_emit_func_header(wrapper_name, 1, "unknown")
    ir_emit_lambda_hidden_param()
    ir_emit_lambda_capture_loads(captures)
    ir_emit("ret " + ir_expr(call_idx).to_string())
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)
    ir_loop_var_slots = saved_loop_var_slots

    closure_r := ir_reg()
    ir_emit("closure_ref " + closure_r.to_string() + " " + wrapper_name)
    ir_emit_lambda_capture_setup(closure_r, captures)
    return closure_r

fn ir_resolve_storage_name(name: String) -> String:
    if ir_import_renames.contains_key(name):
        return ir_import_renames[name]
    if ir_active_generic_module_path.len() > 0 and ir_import_declares_global(ir_active_generic_module_path, name):
        return ir_import_target_name(ir_active_generic_module_path, name)
    return name

fn ir_ident_is_function_value(idx: Int, name: String) -> Bool:
    if ir_var_regs.contains_key(name) or ir_var_types.contains_key(name):
        return false
    callee := ir_ident_callee(name)
    return ir_is_declared_callable(callee.name)

# true when the expression names a function instead of reading a value.
# there are two spellings, and both mint a closure: a bare `shout`
# (ir_emit_ident_load) and a module member `hash.sha256_bytes`
# (ir_emit_field_access_expr). the conditions below mirror those two emit
# paths, because the ownership answer has to agree with what was emitted —
# if this says "owned" where no closure was allocated, the caller releases
# a count nobody took.
fn ir_expr_is_named_function_value(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "ident":
        return ir_ident_is_function_value(idx, node.value)
    if node.kind == "field_access" and node.children.len() > 0:
        recv_node := get_node(node.children[0])
        if not (recv_node.kind == "ident" and ir_module_aliases.contains_key(recv_node.value)):
            return false
        expr_tid := c_get_expr_type(idx)
        if expr_tid < 0 or get_type_info(expr_tid).kind != "function":
            return false
        return ir_resolve_static_callee(idx).name.len() > 0
    return false

# named functions need a small adapter so they can travel through the same
# closure abi lambdas already use.
fn ir_named_function_value_wrapper(idx: Int, target_name: String) -> String:
    if ir_named_fn_value_wrappers.contains_key(target_name):
        return ir_named_fn_value_wrappers[target_name]

    wrapper_name := "__fnval_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    tid := c_get_expr_type(idx)
    info := get_type_info(tid)
    mut ret_type := ir_declared_callable_return_type(target_name)
    if ret_type.len() == 0:
        ret_type = "unknown"

    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    saved_loop_var_slots := ir_loop_var_slots

    ir_reset_lambda_emit_state()
    mut param_count := 1
    if info.kind == "function":
        param_count = info.param_types.len() + 1
    ir_emit_func_header(wrapper_name, param_count, ret_type)
    ir_emit_lambda_hidden_param()

    mut arg_names: List[String] := []
    if info.kind == "function":
        mut i := 0
        while i < info.param_types.len():
            arg_name := "__arg_" + i.to_string()
            arg_names.push(arg_name)
            ir_emit_named_param(arg_name, "")
            i = i + 1

    mut arg_regs: List[Int] := []
    for arg_name in arg_names:
        arg_r := ir_reg()
        ir_emit("load " + arg_r.to_string() + " " + arg_name)
        arg_regs.push(arg_r)

    if ret_type == "void":
        call_r := ir_reg()
        ir_emit_call_text(call_r, target_name, "void", arg_regs.len(), ir_join_arg_regs(arg_regs))
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("ret " + zero_r.to_string())
    else:
        mut call_r := ir_reg()
        if ir_result_reg_funcs.contains_key(target_name):
            # a pair-returning target reached through a fn value: the wrapper
            # itself keeps the box convention, so fold the pair into a box.
            call_r = ir_emit_result_reg_call(call_r, target_name, arg_regs.len(), ir_join_arg_regs(arg_regs))
        else:
            ir_emit_call_text(call_r, target_name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
        ir_emit("ret " + call_r.to_string())
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)
    ir_loop_var_slots = saved_loop_var_slots
    ir_named_fn_value_wrappers.insert(target_name, wrapper_name)
    return wrapper_name

fn ir_emit_ident_load(idx: Int, name: String) -> Int:
    r := ir_reg()
    if ir_ident_is_function_value(idx, name):
        callee := ir_ident_callee(name)
        wrapper_name := ir_named_function_value_wrapper(idx, callee.name)
        ir_emit("closure_ref " + r.to_string() + " " + wrapper_name)
        return r
    # normal variables and globals still load through storage; threadlocal
    # globals route through the tls runtime inside ir_emit_name_load.
    ir_emit_name_load(r, name)
    # a weak local's slot — or a weak binding captured from the enclosing
    # function — holds the bare target pointer, so every read resolves
    # liveness fresh through pith_struct_weak_load and hands back the
    # optional the checker typed it as: Some(target) while it is alive,
    # none once it has been reclaimed.
    if ir_name_is_weak_read(name):
        return ir_emit_weak_read(r)
    return r

# True when any argument carries a field name (named construction).
fn ir_struct_args_have_names(arg_nodes: List[Int]) -> Bool:
    for an_idx in arg_nodes:
        an := get_node(an_idx)
        if an.kind == "arg" and an.value.len() > 0:
            return true
    return false

# Field metadata for a struct construction, resolved by the checker's type id
# when it typed the expression. Two modules can each declare a struct with the
# same name; the name-keyed registry (and the global type table it consults)
# then collapse them, so a field given by name matches the wrong struct's
# layout and silently stores its default. The construction's checked tid names
# the exact struct, so we read its ordered fields directly — the same
# authoritative path field reads already use (ir_try_checked_field_read). We
# fall back to the name-keyed registry when the checker never assigned a plain
# struct tid (tuples and some emit-only constructions).
fn ir_ctor_field_count(sname: String, tid: Int) -> Int:
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "struct":
            return info.fields.len()
    return ir_struct_field_count(sname)

fn ir_ctor_field_name_at(sname: String, tid: Int, field_index: Int) -> String:
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "struct" and field_index >= 0 and field_index < info.fields.len():
            return info.fields[field_index]
    return ir_struct_field_name_at(sname, field_index)

fn ir_ctor_field_type_name(sname: String, tid: Int, field_name: String) -> String:
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "struct":
            for name, i in info.fields:
                if name == field_name and i < info.field_types.len():
                    return ir_type_from_tid(info.field_types[i])
    return ir_struct_field_type_name(sname, field_name)

# Emit a struct built with named fields (`Point(x: 3, y: 4)`). Fields can be
# given in any order and any defaulted field may be omitted, so we walk the
# struct's declaration order and pull each field's value by name, falling back
# to its default. The checker has already validated names and required fields.
# `tid` is the construction's checked type id (or -1), used to resolve the field
# layout unambiguously across same-named structs.
fn ir_emit_struct_named_init(sname: String, arg_nodes: List[Int], tid: Int) -> Int:
    total_fields := ir_ctor_field_count(sname, tid)
    mut field_regs: List[Int] := []
    mut field_idx := 0
    while field_idx < total_fields:
        field_name := ir_ctor_field_name_at(sname, tid, field_idx)
        field_type := ir_ctor_field_type_name(sname, tid, field_name)
        mut value_node := 0 - 1
        for an_idx in arg_nodes:
            an := get_node(an_idx)
            if an.kind == "arg" and an.value == field_name and an.children.len() > 0:
                value_node = an.children[0]
        if ir_struct_field_is_weak(sname, field_name):
            # a weak field stores the bare target pointer (0 = none), not an
            # owning tuple, so it never keeps the target alive.
            mut init_node := value_node
            if init_node < 0:
                init_node = ir_struct_field_default_node(sname, field_name)
            if init_node >= 0:
                field_regs.push(ir_emit_weak_payload(init_node))
            else:
                field_regs.push(ir_zero_reg())
        elif value_node >= 0:
            fr := ir_emit_value_for_target(value_node, field_type)
            named_field_kind := ir_rc_kind(field_type)
            # tuple-typed (optional) field values arrive already owned from
            # ir_emit_value_for_target, so they must not be retained again.
            if named_field_kind.len() > 0 and named_field_kind != "tuple" and ir_string_expr_is_borrowed(value_node):
                ir_rc_retain_reg(fr, named_field_kind)
            field_regs.push(fr)
        else:
            default_idx := ir_struct_field_default_node(sname, field_name)
            if default_idx >= 0:
                field_regs.push(ir_emit_value_for_target(default_idx, field_type))
            else:
                field_regs.push(ir_zero_reg())
        field_idx = field_idx + 1

    r := ir_reg()
    field_count_r := ir_reg()
    ir_emit("iconst " + field_count_r.to_string() + " " + total_fields.to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:" + sname, field_count_r)
    for field_reg, fi in field_regs:
        ir_emit("sstore " + r.to_string() + " " + fi.to_string() + " " + field_reg.to_string())
    ir_emit_attach_dtor(r, sname)
    return r

fn ir_emit_struct_positional_init(sname: String, arg_nodes: List[Int], tid: Int) -> Int:
    if ir_struct_args_have_names(arg_nodes):
        return ir_emit_struct_named_init(sname, arg_nodes, tid)
    mut field_regs: List[Int] := []
    mut field_idx := 0
    while field_idx < arg_nodes.len():
        child := arg_nodes[field_idx]
        cn := get_node(child)
        field_name := ir_ctor_field_name_at(sname, tid, field_idx)
        ftype := ir_ctor_field_type_name(sname, tid, field_name)
        mut value_idx := child
        if cn.kind == "field_init" and cn.children.len() > 0:
            value_idx = cn.children[0]
        elif cn.kind == "arg" and cn.children.len() > 0:
            value_idx = cn.children[0]
        if ir_struct_field_is_weak(sname, field_name):
            field_regs.push(ir_emit_weak_payload(value_idx))
            field_idx = field_idx + 1
            continue
        fr := ir_emit_value_for_target(value_idx, ftype)
        pos_field_kind := ir_rc_kind(ftype)
        # tuple-typed (optional) field values arrive already owned; don't retain.
        if pos_field_kind.len() > 0 and pos_field_kind != "tuple" and ir_string_expr_is_borrowed(value_idx):
            ir_rc_retain_reg(fr, pos_field_kind)
        field_regs.push(fr)
        field_idx = field_idx + 1
    total_fields := ir_ctor_field_count(sname, tid)
    while field_idx < total_fields:
        field_name := ir_ctor_field_name_at(sname, tid, field_idx)
        default_idx := ir_struct_field_default_node(sname, field_name)
        if default_idx >= 0:
            field_regs.push(ir_emit_value_for_target(default_idx, ir_ctor_field_type_name(sname, tid, field_name)))
        else:
            field_regs.push(ir_zero_reg())
        field_idx = field_idx + 1

    r := ir_reg()
    field_count_r := ir_reg()
    ir_emit("iconst " + field_count_r.to_string() + " " + total_fields.to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:" + sname, field_count_r)
    for field_reg, fi in field_regs:
        ir_emit("sstore " + r.to_string() + " " + fi.to_string() + " " + field_reg.to_string())
    ir_emit_attach_dtor(r, sname)
    return r

fn ir_emit_struct_init(idx: Int, node: Node) -> Int:
    return ir_emit_struct_positional_init(node.value, node.children, c_get_expr_type(idx))

fn ir_emit_spawn_expr(node: Node) -> Int:
    if node.children.len() > 0:
        inner := get_node(node.children[0])
        if inner.kind == "call":
            closure_r := ir_emit_spawn_wrapper(node.children[0])
            r := ir_reg()
            ir_emit_call1(r, "spawn", "unknown", closure_r)
            return r
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_try_expr(node: Node) -> Int:
    if node.children.len() > 0:
        result_kind := ir_expr_result_kind(node.children[0])
        # ask the call emitter for the raw (flag, payload) pair when the
        # operand is a direct call to a pair-returning function; any other
        # operand ignores the request and the box path below runs unchanged.
        saved_defer := ir_rcall_defer_idx
        ir_rcall_defer_idx = node.children[0]
        ir_rcall_pair_ready = false
        val_r := ir_expr(node.children[0])
        ir_rcall_defer_idx = saved_defer
        if ir_rcall_pair_ready:
            ir_rcall_pair_ready = false
            return ir_emit_try_pair(node.children[0], ir_rcall_flag_reg, ir_rcall_val_reg)
        if result_kind == "tuple":
            operand_class := ir_extraction_operand_class(node.children[0])
            operand_tid := c_get_expr_type(node.children[0])
            cond_r := ir_emit_result_flag_field(val_r, "is_ok")
            ok_l := ir_label()
            err_l := ir_label()
            merge_l := ir_label()
            ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
            ir_emit_label(ok_l)
            decoded_r := ir_emit_result_ok_field_for_expr(val_r, node.children[0])
            if operand_class != "borrowed":
                # a fresh shell: the extracted payload carries the count; the
                # tuple shell has no destructor, so this frees only the
                # three-slot allocation. the error path returns the same
                # tuple upward instead — its consumer releases it there.
                ir_emit_call1(ir_reg(), "pith_struct_release", "void", val_r)
            # a borrowed operand (a parameter, a live named local) keeps its
            # shell and its payload count with its owner. the unwrapped value
            # stays a borrow — a `!` over a non-call operand is classified
            # borrowed, so bindings and returns retain at the escape site,
            # the same as a `.ok` read.
            ir_emit("jmp " + merge_l)
            ir_emit_label(err_l)
            if ir_emit_tests and ir_emitting_test_func:
                ir_test_assert_fail_return()
            elif operand_class == "borrowed":
                # propagate a FRESH error tuple: returning the borrowed
                # tuple itself would hand the operand's shell to a second
                # owner, and its owner still releases it here. the error
                # value gets its own count for the new tuple; the reads
                # happen before cleanup can release a named operand's shell.
                err_kind := ir_rc_kind(ir_result_field_kind(operand_tid, "err"))
                err_r := ir_emit_result_value_field(val_r, operand_tid, "err")
                if err_kind.len() > 0:
                    ir_rc_retain_reg(err_r, err_kind)
                if ir_current_func_return_kind == "result_reg":
                    # the pair return carries the freshly-counted error in the
                    # payload register; the borrowed shell stays with its owner.
                    ir_defer_emit_to_function_frame(true)
                    ir_emit_string_cleanup("")
                    zero_flag2_r := ir_reg()
                    ir_emit("iconst " + zero_flag2_r.to_string() + " 0")
                    ir_emit("ret2 " + zero_flag2_r.to_string() + " " + err_r.to_string())
                else:
                    fresh_err_r := ir_emit_err_result_tuple(err_r)
                    ir_defer_emit_to_function_frame(true)
                    ir_emit_string_cleanup("")
                    ir_emit_main_error_report(err_r, err_kind == "string")
                    ir_emit("ret " + fresh_err_r.to_string())
            elif ir_current_func_return_kind == "result_reg":
                # the enclosing function returns the pair: take the error out
                # of the owned box, free the shell, and propagate via ret2.
                prop_err_r := ir_emit_result_value_field(val_r, operand_tid, "err")
                ir_emit_call1(ir_reg(), "pith_struct_release", "void", val_r)
                ir_defer_emit_to_function_frame(true)
                ir_emit_string_cleanup("")
                zero_flag_r := ir_reg()
                ir_emit("iconst " + zero_flag_r.to_string() + " 0")
                ir_emit("ret2 " + zero_flag_r.to_string() + " " + prop_err_r.to_string())
            else:
                # propagating the error out early skips the normal return,
                # so release the function's owned locals here too; the error
                # tuple being returned is a fresh value, not a tracked local
                ir_defer_emit_to_function_frame(true)
                ir_emit_string_cleanup("")
                if ir_emitting_main_body:
                    report_err_r := ir_emit_result_value_field(val_r, operand_tid, "err")
                    ir_emit_main_error_report(report_err_r, ir_rc_kind(ir_result_field_kind(operand_tid, "err")) == "string")
                ir_emit("ret " + val_r.to_string())
            ir_emit_label(merge_l)
            return decoded_r
        mut cond_r := val_r
        mut decoded_r := val_r
        if ir_uses_result_abi(result_kind):
            decoded_r = ir_decode_result_value(val_r, result_kind)
        elif result_kind.len() > 0:
            zero_cmp := ir_reg()
            if result_kind == "float":
                ir_emit("fconst " + zero_cmp.to_string() + " 0.0")
            else:
                ir_emit("iconst " + zero_cmp.to_string() + " 0")
            cond_r = ir_reg()
            ir_emit("neq " + cond_r.to_string() + " " + val_r.to_string() + " " + zero_cmp.to_string())
        ok_l := ir_label()
        err_l := ir_label()
        merge_l := ir_label()
        ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
        ir_emit_label(ok_l)
        ir_emit("jmp " + merge_l)
        ir_emit_label(err_l)
        if ir_emit_tests and ir_emitting_test_func:
            ir_test_assert_fail_return()
        elif ir_current_func_return_kind == "result_reg":
            # a legacy sentinel failure carries no error value; propagate the
            # pair with a zero error, matching the zero the box world returns.
            ir_defer_emit_to_function_frame(true)
            ir_emit_string_cleanup("")
            zf := ir_reg()
            ir_emit("iconst " + zf.to_string() + " 0")
            zv := ir_reg()
            ir_emit("iconst " + zv.to_string() + " 0")
            ir_emit("ret2 " + zf.to_string() + " " + zv.to_string())
        else:
            ir_defer_emit_to_function_frame(true)
            ir_emit_string_cleanup("")
            zero := ir_reg()
            ir_emit("iconst " + zero.to_string() + " 0")
            ir_emit("ret " + zero.to_string())
        ir_emit_label(merge_l)
        return decoded_r
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

# consume a two-register (flag, payload) result directly at a `!` site: no
# box exists on either path. the ok arm's payload is an Int or Bool, so
# nothing is counted; the err arm owns whatever error the callee handed over
# and propagates or reports it exactly as the box path would.
fn ir_emit_try_pair(operand_idx: Int, flag_r: Int, val_r: Int) -> Int:
    operand_tid := c_get_expr_type(operand_idx)
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    if ir_emit_tests and ir_emitting_test_func:
        ir_test_assert_fail_return()
    elif ir_current_func_return_kind == "result_reg":
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("ret2 " + zero_r.to_string() + " " + val_r.to_string())
    else:
        fresh_err_r := ir_emit_err_result_tuple(val_r)
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        ir_emit_main_error_report(val_r, ir_rc_kind(ir_result_field_kind(operand_tid, "err")) == "string")
        ir_emit("ret " + fresh_err_r.to_string())
    ir_emit_label(merge_l)
    return val_r

# on main's error-return paths, print the error and exit 1 before the ret:
# the entry glue forces main's return value to 0, so without this the error
# vanished and the process reported success. err_is_string routes a typed
# error to a generic message instead of reading a non-string pointer.
fn ir_emit_main_error_report(err_r: Int, err_is_string: Bool):
    if not ir_emitting_main_body:
        return
    flag_r := ir_reg()
    mut flag_v := "0"
    if err_is_string:
        flag_v = "1"
    ir_emit("iconst " + flag_r.to_string() + " " + flag_v)
    ir_emit_call2(ir_reg(), "pith_main_error_exit", "int", err_r, flag_r)

fn ir_emit_fail_expr(node: Node) -> Int:
    if node.children.len() > 0:
        err_r := ir_expr(node.children[0])
        # the error value transfers to the caller the same way a normal
        # return's value does: a returned local is skipped in cleanup, a
        # returned borrow gets a fresh count. the result tuple only borrows
        # the error slot, so without this the function's other owned locals
        # leaked on every fail (cleanup ran only on the normal return).
        mut exclude := ""
        expr_node := get_node(node.children[0])
        err_kind := ir_rc_kind(ir_infer_type(node.children[0]))
        if err_kind.len() > 0:
            if expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value) == err_kind:
                exclude = expr_node.value
            elif ir_string_expr_is_borrowed(node.children[0]):
                ir_rc_retain_reg(err_r, err_kind)
        if ir_current_func_return_kind == "result_reg":
            ir_defer_emit_to_function_frame(true)
            ir_emit_string_cleanup(exclude)
            zero_r := ir_reg()
            ir_emit("iconst " + zero_r.to_string() + " 0")
            ir_emit("ret2 " + zero_r.to_string() + " " + err_r.to_string())
        else:
            tuple_r := ir_emit_err_result_tuple(err_r)
            ir_defer_emit_to_function_frame(true)
            ir_emit_string_cleanup(exclude)
            ir_emit_main_error_report(err_r, ir_infer_type(node.children[0]) == "string")
            ir_emit("ret " + tuple_r.to_string())
    elif ir_current_func_return_kind == "result_reg":
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        z1 := ir_reg()
        ir_emit("iconst " + z1.to_string() + " 0")
        z2 := ir_reg()
        ir_emit("iconst " + z2.to_string() + " 0")
        ir_emit("ret2 " + z1.to_string() + " " + z2.to_string())
    else:
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        ir_emit_main_error_report(ir_zero_reg(), false)
        ir_emit("ret " + ir_emit_err_result_tuple(ir_zero_reg()).to_string())
    ub := ir_label()
    ir_emit_label(ub)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_index_expr(idx: Int, node: Node) -> Int:
    obj_r := ir_expr(node.children[0])
    idx_r := ir_expr(node.children[1])
    r := ir_reg()
    mut obj_type := ir_checked_type(node.children[0])
    mut value_type := ir_checked_index_type(idx)
    if obj_type.len() == 0:
        obj_type = ir_infer_type(node.children[0])
    if value_type.len() == 0:
        value_type = ir_lookup_map_value_type_for_expr(node.children[0])
    if value_type.len() == 0:
        value_type = ir_infer_type(idx)
    # In a T! function, propagate on miss instead of aborting. Callers
    # can `catch` or `unwrap_or` at their level. Outside T! context, the
    # strict variants keep aborting cleanly.
    if ir_current_func_returns_result and ir_index_supports_propagate(obj_type):
        return ir_emit_index_expr_propagate(node.children[1], obj_r, idx_r, obj_type, value_type)
    call_name := ir_index_get_call_name(obj_type)
    if obj_type == "string":
        ir_emit_call2(r, call_name, "string", obj_r, idx_r)
    elif obj_type == "bytes":
        ir_emit_call2(r, call_name, "int", obj_r, idx_r)
    elif obj_type == "map_int" or obj_type == "map":
        if value_type.len() == 0:
            value_type = "unknown"
        ir_emit_call2(r, call_name, value_type, obj_r, idx_r)
    else:
        ir_emit_call2(r, call_name, ir_infer_type(idx), obj_r, idx_r)
    ir_release_owned_index_key(node.children[1], idx_r)
    return r

# an index key computed in place — `m[a.to_string() + ":" + b.to_string()]` —
# arrives owned and nothing keeps it. a lookup reads the key and stores
# nothing, and a store copies the key bytes into the map's own storage rather
# than keeping the caller's string, so either way the count the caller holds
# has to die here. binding the key to a local first was always correct,
# because the local's scope cleanup released it; the inline form leaked one
# string per operation. the object operand is deliberately left alone:
# container indexing borrows the element out of the container, so releasing a
# temporary container here would free the value we are about to return.
fn ir_release_owned_index_key(key_idx: Int, key_r: Int):
    ir_release_owned_string_operand(key_idx, key_r, ir_infer_type(key_idx))

# True when obj_type has an `_opt` runtime we can dispatch to for
# fail-propagate. Maps and lists ship the opt variants; string, bytes,
# and set fall through to the strict runtime (they don't have _opt
# accessors yet).
fn ir_index_supports_propagate(obj_type: String) -> Bool:
    if obj_type == "map":
        return true
    if obj_type == "map_int":
        return true
    if obj_type == "list":
        return true
    if obj_type == "list_string":
        return true
    return false

# Emit `map[k]` / `list[i]` as a fail-propagate: call the _opt runtime,
# branch on is_some, on none return the fail result tuple, on some
# continue with the unwrapped value. Mirrors ir_emit_optional_unwrap.
fn ir_emit_index_expr_propagate(key_idx: Int, obj_r: Int, idx_r: Int, obj_type: String, value_type: String) -> Int:
    opt_name := ir_index_get_opt_call_name(obj_type)
    opt_r := ir_reg()
    ir_emit_call2(opt_r, opt_name, "tuple", obj_r, idx_r)
    # release the key before the branch: the miss arm returns early, so a
    # release placed after it would only run on the hit path.
    ir_release_owned_index_key(key_idx, idx_r)
    flag_r := ir_optional_flag_field(opt_r)
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
    ir_emit_label(some_l)
    mut val_kind := value_type
    if val_kind.len() == 0:
        val_kind = "unknown"
    unwrapped_r := ir_reg()
    ir_emit("field " + unwrapped_r.to_string() + " " + opt_r.to_string() + " 8 " + val_kind + " value")
    # the _opt wrapper is a throwaway tuple shell; free it now that the value is
    # extracted. releasing it frees only the tuple's slots (no destructor), so
    # the extracted value is untouched — without this every `list[i]` leaks it.
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    ir_emit("jmp " + merge_l)
    ir_emit_label(none_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    if ir_emit_tests and ir_emitting_test_func:
        ir_test_assert_fail_return()
    else:
        # this early return skips the normal exit, so run the deferred
        # statements and then release the function's owned locals here too —
        # without the cleanup every owned local leaked on an index miss.
        ir_defer_emit_to_function_frame(true)
        ir_emit_string_cleanup("")
        msg := ir_str("index out of bounds")
        err_r := ir_reg()
        ir_emit("strref " + err_r.to_string() + " " + msg)
        ir_emit_main_error_report(err_r, true)
        ir_emit_ret_err_value(err_r)
    ir_emit_label(merge_l)
    return unwrapped_r

fn ir_index_get_opt_call_name(obj_type: String) -> String:
    if obj_type == "map":
        return "map_get_opt"
    if obj_type == "map_int":
        return "map_get_ikey_opt"
    return "pith_list_get_opt"

fn ir_emit_index_assignment(target_idx: Int, value_idx: Int) -> Bool:
    target := get_node(target_idx)
    if target.kind != "index" or target.children.len() < 2:
        return false

    obj_r := ir_expr(target.children[0])
    idx_r := ir_expr(target.children[1])
    mut obj_type := ir_checked_type(target.children[0])
    mut value_type := ir_checked_index_type(target_idx)
    if obj_type.len() == 0:
        obj_type = ir_infer_type(target.children[0])
    if value_type.len() == 0:
        value_type = ir_lookup_map_value_type_for_expr(target.children[0])
    if value_type.len() == 0:
        value_type = ir_infer_type(value_idx)
    value_r := ir_emit_value_for_target(value_idx, value_type)
    # tagged containers retain stored elements in the runtime. a borrowed heap
    # value carries its kind with it, so the container adopts it where it has
    # none and takes exactly one count either way — a list used to get a
    # compensating retain here on top of the one the runtime store took,
    # because nothing told a tagged list from an untagged one.
    idx_store_kind := ir_rc_kind(value_type)
    mut set_name := ir_index_set_call_name(obj_type)
    idx_borrowed := ir_string_expr_is_borrowed(value_idx)
    mut idx_kind_store := ir_map_kind_store_name(set_name, not idx_borrowed)
    if idx_kind_store.len() == 0 and idx_borrowed:
        idx_kind_store = ir_list_kind_store_name(set_name)
    if idx_kind_store.len() > 0 and ir_store_learns_kind(idx_store_kind):
        tag_r := ir_emit_element_tag_const(idx_store_kind)
        ir_emit_call4(ir_reg(), idx_kind_store, "void", obj_r, idx_r, value_r, tag_r)
        ir_release_owned_index_key(target.children[1], idx_r)
        return true
    if not idx_borrowed and ir_container_store_takes_count(idx_store_kind):
        # `m[k] = "v-{i}"` builds a value nobody else tracks. the store takes
        # the count the temporary was holding instead of adding its own, which
        # is what leaves it with exactly one owner.
        owned_store := ir_owned_container_store_name(set_name)
        if owned_store.len() > 0:
            set_name = owned_store
    ir_emit_call3(ir_reg(), set_name, "void", obj_r, idx_r, value_r)
    # a store reads its key the same way a lookup does: the runtime copies the
    # key bytes into the map's own storage rather than keeping the caller's
    # string, so an owned key temporary dies here too. the stored *value* is a
    # different question — the container retains that, and it stays under the
    # container-store exception in docs/ownership.md.
    ir_release_owned_index_key(target.children[1], idx_r)
    return true

# --- expression lowering ---
#
# ir_expr is the recursion root: every value-producing node comes
# through here and leaves its result in a register. simple shapes are
# handled inline; anything with control flow or ownership subtlety
# gets its own ir_emit_* function below.
fn ir_expr(idx: Int) -> Int:
    node := get_node(idx)

    if node.kind == "int_lit" or node.kind == "int" or node.kind == "integer":
        return ir_emit_int_literal(node)

    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return ir_emit_string_literal(node)

    if node.kind == "float_lit" or node.kind == "float":
        return ir_emit_float_literal(node)

    if node.kind == "bool" or node.kind == "bool_lit":
        return ir_emit_bool_literal(node)

    # a bare `none` the checker let through is the empty case of an optional
    # — nothing else typechecks there any more — so it lowers to the canonical
    # optional tuple. the positions that know their target (return, bind,
    # tuple element, `== none`) still intercept above; this is what an
    # argument position gets, which used to fall through to the zero-value
    # fallback and hand the callee a null where it expected the wrapper.
    if node.kind == "none_lit":
        return ir_emit_optional_none_value()

    if node.kind == "ident":
        return ir_emit_ident_load(idx, node.value)

    if node.kind == "self":
        return ir_emit_ident_load(idx, "self")

    if node.kind == "unary":
        return ir_emit_unary_expr(node)

    if node.kind == "binary":
        return ir_emit_binary_expr(node)

    if node.kind == "call":
        return ir_emit_static_call(idx, node)

    else:
        return ir_expr_complex(idx, node)

fn ir_emit_zero_value() -> Int:
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_field_access_expr(idx: Int, node: Node) -> Int:
    fname := node_value(idx)
    if node.children.len() > 0:
        # a module function used as a value: `hash.sha256_bytes` where `hash`
        # is a module alias and the member is a function. resolve it the way a
        # call would and wrap it into a closure value, the same as a bare
        # function name. this must run before the receiver is evaluated — a
        # module alias is not a loadable value.
        recv_node := get_node(node.children[0])
        if recv_node.kind == "ident" and ir_module_aliases.contains_key(recv_node.value):
            expr_tid := c_get_expr_type(idx)
            if expr_tid >= 0 and get_type_info(expr_tid).kind == "function":
                callee := ir_resolve_static_callee(idx)
                if callee.name.len() > 0:
                    r := ir_reg()
                    wrapper := ir_named_function_value_wrapper(idx, callee.name)
                    ir_emit("closure_ref " + r.to_string() + " " + wrapper)
                    return r
            # `frames.FRAME_DATA` where the member is a module-level constant,
            # not a function. a module alias is not a loadable value, so this
            # can't fall through to a struct field access — resolve it to the
            # aliased module's qualified global and load it, the same as a
            # same-module global reference does.
            module_path := ir_module_aliases[recv_node.value]
            if ir_import_declares_global(module_path, fname):
                r := ir_reg()
                ir_emit("load " + r.to_string() + " " + ir_import_target_name(module_path, fname))
                return r
        # an alias-qualified no-payload variant: `sh.Phase.Alpha` arrives here
        # with fname Alpha and a field_access receiver whose base is the module
        # alias. the receiver names a type, not a value, so it must not be
        # evaluated — emit the same construction the bare Phase.Alpha path
        # does. payload variants never reach here (they are calls).
        if recv_node.kind == "field_access" and recv_node.children.len() > 0:
            base_node := get_node(recv_node.children[0])
            if base_node.kind == "ident" and ir_module_aliases.contains_key(base_node.value):
                ename := recv_node.value
                variant_key := ename + "." + fname
                if ir_struct_field_index_lookup.contains_key(variant_key):
                    if ir_struct_field_lookup.contains_key(variant_key) and ir_struct_field_lookup[variant_key] == ename:
                        if ir_boxed_enums.contains_key(ename):
                            return ir_emit_variant_alloc(ename, variant_key, 0)
                        r := ir_reg()
                        ir_emit("iconst " + r.to_string() + " " + ir_struct_field_index_lookup[variant_key])
                        return r
        obj_r := ir_expr(node.children[0])
        # result fields are special: `.ok` and status checks read the tagged value,
        # not a struct field.
        result_r := ir_emit_result_field_access(idx, obj_r, fname)
        if result_r >= 0:
            return result_r
        # hand the already-evaluated receiver to the field read so it is not
        # emitted a second time (a stateful receiver would advance and misread).
        return ir_emit_field_access(idx, node, obj_r)
    return ir_emit_field_access(idx, node, 0 - 1)

fn ir_emit_await_expr(node: Node) -> Int:
    if node.children.len() == 0:
        return ir_emit_zero_value()
    task_r := ir_expr(node.children[0])
    r := ir_reg()
    ir_emit_call1(r, "await", "unknown", task_r)
    return r

# release a result's error value when it is being discarded. the result
# tuple is a shell with no destructor, so releasing the tuple frees only
# its three slots — a heap error value (a string message, a struct error)
# would leak unless dropped here first.
fn ir_emit_release_result_error(result_r: Int, result_tid: Int):
    err_kind := ir_rc_kind(ir_result_field_kind(result_tid, "err"))
    if err_kind.len() > 0:
        err_r := ir_emit_result_value_field(result_r, result_tid, "err")
        ir_rc_release_reg(err_r, err_kind)

# fully release a discarded result: drop its live payload (the ok value or the
# err value, depending on the tag) and then free the shell. a bare call
# statement like `buf.write_byte(x)` leaves the result unowned, so without this
# its box — and any heap payload — leaks. mirrors the ownership dance in catch.
fn ir_emit_discard_result(result_r: Int, result_tid: Int):
    cond_r := ir_emit_result_flag_field(result_r, "is_ok")
    ok_l := ir_label()
    err_l := ir_label()
    done_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_kind := ir_rc_kind(ir_result_field_kind(result_tid, "ok"))
    if ok_kind.len() > 0:
        ok_r := ir_emit_result_value_field(result_r, result_tid, "ok")
        ir_rc_release_reg(ok_r, ok_kind)
    ir_emit("jmp " + done_l)
    ir_emit_label(err_l)
    ir_emit_release_result_error(result_r, result_tid)
    ir_emit("jmp " + done_l)
    ir_emit_label(done_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)

fn ir_emit_catch_expr(node: Node) -> Int:
    # the pair fast path: a direct call to a pair-returning function delivers
    # (flag, payload) through the defer handshake and no box exists at all.
    saved_defer := ir_rcall_defer_idx
    ir_rcall_defer_idx = node.children[0]
    ir_rcall_pair_ready = false
    result_r := ir_expr(node.children[0])
    ir_rcall_defer_idx = saved_defer
    if ir_rcall_pair_ready:
        ir_rcall_pair_ready = false
        return ir_emit_catch_pair(node, ir_rcall_flag_reg, ir_rcall_val_reg)
    result_tid := c_get_expr_type(node.children[0])
    operand_class := ir_extraction_operand_class(node.children[0])
    cond_r := ir_emit_result_flag_field(result_r, "is_ok")
    temp_name := ir_new_temp_name("catch")
    ok_l := ir_label()
    fallback_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + fallback_l)
    ir_emit_label(ok_l)
    ok_value_r := ir_emit_result_value_field(result_r, result_tid, "ok")
    if operand_class == "borrowed":
        # the operand's owner keeps the shell and its payload count. a catch
        # value always arrives owned at its consumer (see the catch_expr case
        # in ir_string_expr_is_borrowed), so give it a count of its own —
        # handing out the shell's count, or freeing the shell here, would
        # double-free once the owner cleans up.
        ir_rc_retain_reg(ok_value_r, ir_rc_kind(ir_result_field_kind(result_tid, "ok")))
    else:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    ir_emit("store " + temp_name + " " + ok_value_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(fallback_l)
    # the error is being thrown away for the fallback value; drop it first —
    # unless the operand is a borrow, in which case both the error and the
    # shell stay with their owner
    if operand_class != "borrowed":
        ir_emit_release_result_error(result_r, result_tid)
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    # both arms must hand back an OWNED value: the ok arm transferred the
    # result payload out of the destructor-less tuple shell, so a borrowed
    # fallback needs its own count. the whole catch is classified owned
    # (ir_string_expr_is_borrowed), so without this the payload would leak
    # (fallback) or the binding would not know to release it.
    fallback_r := ir_expr(node.children[1])
    if ir_string_expr_is_borrowed(node.children[1]):
        ir_rc_retain_reg(fallback_r, ir_rc_kind(ir_infer_type(node.children[1])))
    ir_emit("store " + temp_name + " " + fallback_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# `expr catch:` with a block. the ok arm is the same extraction the inline
# catch performs; the error arm disposes of the failed result and then runs
# the user's block, which the checker guarantees leaves (return, fail,
# continue or break). the trailing jmp is dead code on every real path — it
# only keeps the ir well formed.
fn ir_emit_catch_block(node: Node) -> Int:
    result_r := ir_expr(node.children[0])
    result_tid := c_get_expr_type(node.children[0])
    operand_class := ir_extraction_operand_class(node.children[0])
    cond_r := ir_emit_result_flag_field(result_r, "is_ok")
    temp_name := ir_new_temp_name("catch_block")
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_value_r := ir_emit_result_value_field(result_r, result_tid, "ok")
    if operand_class == "borrowed":
        # the operand's owner keeps the shell and its payload count; the
        # extracted value gets a count of its own, exactly as the inline
        # catch's ok arm does.
        ir_rc_retain_reg(ok_value_r, ir_rc_kind(ir_result_field_kind(result_tid, "ok")))
    else:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    ir_emit("store " + temp_name + " " + ok_value_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    # the error is not consumed by the block (there is no binding for it in
    # this form), so drop it before user code runs — unless the operand is a
    # borrow, in which case the error and the shell stay with their owner.
    if operand_class != "borrowed":
        ir_emit_release_result_error(result_r, result_tid)
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    ir_block(node.children[1])
    ir_emit("jmp " + merge_l)
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_grouped_expr(node: Node) -> Int:
    if node.children.len() > 0:
        return ir_expr(node.children[0])
    return ir_emit_zero_value()

# A match compiles to a linear chain of pattern tests. The subject is evaluated
# once; each arm tests its pattern (and guard) and, on a match, runs its body
# and jumps to the end. Arm bodies that are expressions store their value into a
# result temp, so the whole match can be used as an expression. Bare enum values
# lower to their integer variant index, so variant matching is an integer eq.

# When a match sits in a function's tail position its value is the function's
# implicit return. This holds that match node so its arms emit `ret` directly.

# Emit an arm body that returns its value (tail-position match). Block bodies
# run as statements (and return on their own).
fn ir_expr_complex(idx: Int, node: Node) -> Int:
    kind := node_kind(idx)
    if kind == "match_expr":
        if idx == ir_tail_match_node:
            ir_emit_match_return(idx, node, ir_expr, ir_block)
            return ir_emit_zero_value()
        return ir_emit_match_expr(idx, node, ir_expr, ir_block)
    if kind == "if_expr":
        return ir_emit_if_expr(node, ir_expr)
    if kind == "method_call":
        return ir_emit_method_call(idx)

    if kind == "string_interp":
        return ir_emit_string_interp(idx)

    if kind == "map":
        # an empty {} annotated as a set must build a set, not a map:
        # the wrong container silently swallows inserts and its method
        # calls take the map arg shapes
        checked_lit := ir_checked_type(idx)
        if checked_lit == "set" or checked_lit == "set_int":
            return ir_emit_set_literal(idx, node)
        return ir_emit_map_literal(idx, node)

    if kind == "set":
        return ir_emit_set_literal(idx, node)

    if kind == "list":
        return ir_emit_list_literal(idx, node)

    if kind == "tuple":
        return ir_emit_tuple_literal(node)

    if kind == "struct_init":
        return ir_emit_struct_init(idx, node)

    if kind == "field_access":
        return ir_emit_field_access_expr(idx, node)

    if kind == "lambda":
        return ir_emit_lambda(idx)

    if kind == "spawn":
        return ir_emit_spawn_expr(node)

    if kind == "await":
        return ir_emit_await_expr(node)

    if kind == "unwrap":
        return ir_emit_optional_unwrap(node)

    if kind == "try" or kind == "try_expr":
        return ir_emit_try_expr(node)

    if kind == "catch_expr":
        return ir_emit_catch_expr(node)
    if kind == "catch_block":
        return ir_emit_catch_block(node)

    if kind == "select_expr":
        return ir_emit_select_expr(node)

    if kind == "fail":
        return ir_emit_fail_expr(node)

    if kind == "grouped":
        return ir_emit_grouped_expr(node)

    if kind == "index":
        return ir_emit_index_expr(idx, node)

    # fallback
    return ir_emit_zero_value()

fn ir_emit_return_stmt(node: Node):
    if node.children.len() > 0:
        # `return none` builds its optional below, from the function's own
        # return kind. going through ir_expr for it would build one optional
        # tuple here and a second one there, and strand the first — every
        # `return none` in the tree leaked an optional per call.
        mut r := 0
        if node_kind(node.children[0]) == "none_lit":
            r = ir_emit_zero_value()
        elif ir_current_func_return_kind == "result_reg":
            # forwarding handshake: a direct pair-returning call (an rcall or
            # a legacy-builtin wrap) hands its (flag, payload) registers
            # straight to this return, so no box is built only to be unpacked
            # again below.
            saved_defer := ir_rcall_defer_idx
            ir_rcall_defer_idx = node.children[0]
            ir_rcall_pair_ready = false
            r = ir_expr(node.children[0])
            ir_rcall_defer_idx = saved_defer
            if ir_rcall_pair_ready:
                ir_rcall_pair_ready = false
                ir_defer_emit_to_function_frame(false)
                ir_emit_string_cleanup("")
                ir_emit("ret2 " + ir_rcall_flag_reg.to_string() + " " + ir_rcall_val_reg.to_string())
                ir_last_was_ret = true
                return
        else:
            r = ir_expr(node.children[0])
        # hand the returned string's count to the caller: a returned local
        # transfers its count (skip it in cleanup), a returned borrow gets
        # a fresh count. fresh results already arrive owned.
        mut exclude := ""
        expr_node := get_node(node.children[0])
        # a returned tracked local transfers its count to the caller, so it
        # must be skipped in the exit cleanup. trust the tracked kind directly:
        # in a generic body the inferred type can miss (a tuple-lowered
        # optional reads back as the optional type, whose rc_kind is empty),
        # yet the local is still tracked and returning it must not release it.
        if expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value).len() > 0:
            exclude = expr_node.value
        else:
            # substitute struct params (T -> the concrete type) so a specialized
            # impl method returning a borrowed T still retains it. without this
            # the inferred type stays "T", rc_kind reads empty, no retain fires,
            # and the caller's arg release frees the value the method handed back.
            ret_kind := ir_rc_kind(ir_substitute_type_name(ir_infer_type(node.children[0])))
            if ret_kind.len() > 0 and ir_string_expr_is_borrowed(node.children[0]):
                ir_rc_retain_reg(r, ret_kind)
        result_kind := ir_expr_result_kind(node.children[0])
        expr_tid := c_get_expr_type(node.children[0])
        mut expr_kind := ""
        if expr_tid >= 0:
            expr_kind = get_type_info(expr_tid).kind
        if ir_current_func_optional_inner_kind.len() > 0:
            # is the returned expression already an optional (so forward it),
            # or the inner value (so wrap in Some)? the checker knows in the
            # normal case; in a generic body a call like `c.maybe()` isn't
            # resolved to optional at declaration time, so also trust the
            # emitter's own retkind — an optional lowers to a tuple, and a
            # tuple retkind can only be the optional wrapper unless the inner
            # value is itself tuple-shaped.
            # a local tracked as a tuple already holds the optional wrapper, so
            # forwarding it (rather than wrapping in Some again) is the same
            # signal as a tuple retkind — the guard against an Optional[Tuple]
            # inner still applies.
            ident_tuple_local := expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value) == "tuple"
            already_optional := expr_kind == "optional" or ((result_kind == "tuple" or ident_tuple_local) and ir_current_func_optional_inner_kind != "tuple")
            if expr_node.kind == "none_lit":
                r = ir_emit_optional_none_value()
            elif already_optional == false:
                r = ir_emit_optional_some_value(r)
        elif ir_current_func_return_kind == "tuple":
            if result_kind != "tuple":
                r = ir_emit_ok_result_tuple(r)
        elif ir_current_func_return_kind == "result_reg":
            if result_kind == "tuple":
                # forwarding a whole result (`return other_fallible()`): the
                # expression produced a box, so unpack it into the pair. the
                # take-ok convention applies — the payload leaves with its
                # count and the destructor-less shell is freed.
                ir_emit_return_box_as_pair(r, exclude)
                ir_last_was_ret = true
                return
            ir_defer_emit_to_function_frame(false)
            ir_emit_string_cleanup(exclude)
            one_r := ir_reg()
            ir_emit("iconst " + one_r.to_string() + " 1")
            ir_emit("ret2 " + one_r.to_string() + " " + r.to_string())
            ir_last_was_ret = true
            return
        ir_defer_emit_to_function_frame(false)
        ir_emit_string_cleanup(exclude)
        ir_emit("ret " + r.to_string())
    else:
        ir_defer_emit_to_function_frame(false)
        ir_emit_string_cleanup("")
        r := ir_reg()
        if ir_current_func_return_kind == "result_reg":
            ir_emit("iconst " + r.to_string() + " 1")
            zero_r := ir_reg()
            ir_emit("iconst " + zero_r.to_string() + " 0")
            ir_emit("ret2 " + r.to_string() + " " + zero_r.to_string())
        else:
            ir_emit("iconst " + r.to_string() + " 0")
            ir_emit("ret " + r.to_string())
    ir_last_was_ret = true

# propagate `err_r` out of the current function as its error return: the
# two-register pair when the function uses the register ABI, a fresh error
# box otherwise. cleanup must already have run at the call site.
fn ir_emit_ret_err_value(err_r: Int):
    if ir_current_func_return_kind == "result_reg":
        zf := ir_reg()
        ir_emit("iconst " + zf.to_string() + " 0")
        ir_emit("ret2 " + zf.to_string() + " " + err_r.to_string())
    else:
        ir_emit("ret " + ir_emit_err_result_tuple(err_r).to_string())

# consume a two-register (flag, payload) result at a `catch` site with no
# box on either path. the ok payload arrives owned (the callee transferred
# its count through the register), exactly what a catch value's consumer
# expects; the err arm owns the error, drops it, and evaluates the fallback
# in its place — the same ownership contract as the box path's arms.
fn ir_emit_catch_pair(node: Node, flag_r: Int, val_r: Int) -> Int:
    result_tid := c_get_expr_type(node.children[0])
    temp_name := ir_new_temp_name("catch")
    ok_l := ir_label()
    fallback_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + fallback_l)
    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + val_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(fallback_l)
    err_kind := ir_rc_kind(ir_result_field_kind(result_tid, "err"))
    if err_kind.len() > 0:
        ir_rc_release_reg(val_r, err_kind)
    fallback_r := ir_expr(node.children[1])
    if ir_string_expr_is_borrowed(node.children[1]):
        ir_rc_retain_reg(fallback_r, ir_rc_kind(ir_infer_type(node.children[1])))
    ir_emit("store " + temp_name + " " + fallback_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# unpack a result box into the two-register return: branch on its flag and
# ret2 each slot's payload from its own arm. run defers and cleanup before
# the branch so both arms leave through already-settled state.
fn ir_emit_return_box_as_pair(box_r: Int, exclude: String):
    ir_defer_emit_to_function_frame(false)
    ir_emit_string_cleanup(exclude)
    flag_r := ir_emit_result_flag_field(box_r, "is_ok")
    ok_l := ir_label()
    err_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_r := ir_reg()
    ir_emit("field " + ok_r.to_string() + " " + box_r.to_string() + " 8 unknown ok")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", box_r)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("ret2 " + one_r.to_string() + " " + ok_r.to_string())
    ir_emit_label(err_l)
    err_r := ir_reg()
    ir_emit("field " + err_r.to_string() + " " + box_r.to_string() + " 16 unknown err")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", box_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("ret2 " + zero_r.to_string() + " " + err_r.to_string())

# the tagged constructor for an empty `List[T]` bind whose element type only
# the annotation knows, or "" when the normal target path already handles it.
#
# active only inside specialized generic bodies, where the checked types are
# suppressed: everywhere else the checked type on the literal picks the
# constructor, and second-guessing it here would fight that path. `List[T]`
# with T substituted to string already resolves to the list_string target
# upstream; every other heap element kind used to collapse to the coarse
# "list" target and build untagged — a list whose stores own nothing, handing
# back elements that lived on counts their source dropped at its own exit
# (algo.sort_by_key over structs was the live case).
fn ir_generic_empty_list_ctor(val_idx: Int, type_idx: Int, bind_target: String) -> String:
    if bind_target != "list" or val_idx < 0 or type_idx < 0:
        return ""
    if ir_active_generic_params.len() == 0 and ir_current_impl_subst_params.len() == 0:
        return ""
    vn := get_node(val_idx)
    if vn.kind != "list" or vn.children.len() > 0:
        return ""
    tn := get_node(type_idx)
    if tn.kind != "generic_type" or tn.value != "List" or tn.children.len() == 0:
        return ""
    mut elem := ir_resolve_type_node(tn.children[0])
    if ir_rc_kind(elem).len() == 0:
        # impl-method substitution (T -> the impl's concrete argument) is not
        # part of ir_resolve_type_node's active-generic path, so try it as the
        # fallback — and only when it actually substituted something, so a
        # still-abstract T cannot clobber a resolution that already worked
        inner := get_node(tn.children[0])
        if inner.kind == "type":
            substituted := ir_substitute_type_name(inner.value)
            if substituted != inner.value:
                elem = ir_resolve_type_hint(substituted)
    ctor := ir_list_ctor_for_elem_kind(ir_rc_kind(elem))
    if ctor == "__list_new":
        return ""
    return ctor

fn ir_emit_bind_stmt(node: Node):
    parts := ir_collect_bind_parts(node)
    name := parts.name
    val_idx := parts.val_idx
    type_idx := parts.type_idx
    # `weak name := expr` stores the bare target pointer and takes a WEAK
    # reference only, mirroring a weak struct field's store: the binding must
    # not keep its target alive, or the cycle it exists to break never
    # reclaims. every read goes back through pith_struct_weak_load (see
    # ir_emit_ident_load), so the slot never holds an owning optional. the
    # old slot value covers a loop body re-entering the binding; the
    # prologue zero-stores the slot, and weak_release(0) is a no-op.
    if node.value.contains(" weak") and ir_rc_local_kind(name) == "weak" and val_idx >= 0:
        old_w := ir_reg()
        ir_emit_local_slot_load(old_w, name)
        new_w := ir_emit_weak_payload(val_idx)
        ir_emit_name_store(name, new_w)
        ir_emit_call1(ir_reg(), "pith_struct_weak_release", "void", old_w)
        ir_var_regs.insert(name, new_w)
        return
    # a bind from a call through a closure-typed parameter carries the
    # closure's declared return kind — the one type source that stays
    # reliable in generic bodies, where checked types are suppressed
    if type_idx < 0 and val_idx >= 0:
        vn := get_node(val_idx)
        if vn.kind == "call" and vn.children.len() > 0:
            callee_n := get_node(vn.children[0])
            if callee_n.kind == "ident" and ir_closure_return_kinds.contains_key(callee_n.value):
                ir_var_types.insert(name, ir_closure_return_kinds[callee_n.value])
        # `f := self.make` binds a closure-typed field to a local; carry the
        # field's fn_type return kind so a later `f()` reports the right result
        # kind (the same reason a closure-typed parameter does).
        elif vn.kind == "field_access" and vn.children.len() > 0 and ir_current_impl_type.len() > 0:
            recv := get_node(vn.children[0])
            if recv.kind == "self":
                field_kind := ir_struct_fn_field_return_kind(ir_strip_type_args(ir_current_impl_type), vn.value)
                if field_kind.len() > 0:
                    ir_closure_return_kinds.insert(name, field_kind)
    mut target_type := ""
    if type_idx >= 0:
        target_type = ir_resolve_type_node(type_idx)
        if target_type.len() > 0:
            ir_var_types.insert(name, target_type)
        map_value_type := ir_resolve_map_value_type_node(type_idx)
        if map_value_type.len() > 0:
            ir_map_value_types.insert(name, map_value_type)
    if val_idx >= 0:
        # a tracked string local that is bound again (a loop body re-entering
        # the binding) owns a count on its previous value; capture it before
        # the new value lands, release it after the new value is retained so
        # a self-referencing bind stays alive.
        bind_kind := ir_rc_local_kind(name)
        tracked := bind_kind.len() > 0
        mut old_r := 0 - 1
        if tracked and ir_rc_release_enabled(bind_kind):
            old_r = ir_reg()
            ir_emit_name_load(old_r, name)
        bind_target := ir_map_init_target(name, target_type)
        mut r := 0 - 1
        annot_ctor := ir_generic_empty_list_ctor(val_idx, type_idx, bind_target)
        if annot_ctor.len() > 0:
            r = ir_reg()
            ir_emit_call0(r, annot_ctor, "list")
        if r < 0:
            r = ir_emit_value_for_target(val_idx, bind_target)
        if tracked and bind_target != "tuple" and ir_string_expr_is_borrowed(val_idx):
            ir_rc_retain_reg(r, bind_kind)
        if old_r >= 0:
            # a loop rebinding a cascade-eligible tuple local must cascade the
            # OLD value's payload here, not just its shell — this is where the
            # per-iteration leak lives.
            ir_rc_release_local(old_r, bind_kind, name)
        ir_var_regs.insert(name, r)
        ir_emit_name_store(name, r)
        if not ir_var_types.contains_key(name):
            inferred := ir_infer_type(val_idx)
            if inferred.len() > 0:
                ir_var_types.insert(name, inferred)

fn ir_emit_assign_stmt(node: Node):
    name := node.value
    if node.children.len() >= 2:
        if ir_emit_index_assignment(node.children[0], node.children[1]):
            return
    if node.children.len() > 0:
        # same ownership dance as rebinding; string globals get the
        # retain/release pair too but are never in the exit cleanup.
        legacy_kind := ir_rc_kind(ir_lookup_name_type(name))
        tracked := ir_rc_local_kind(name).len() > 0
        mut old_r := 0 - 1
        if legacy_kind.len() > 0 and ir_rc_release_enabled(legacy_kind):
            if tracked or (legacy_kind == "string" and ir_global_string_names.contains(name)):
                old_r = ir_reg()
                ir_emit_name_load(old_r, name)
        legacy_target := ir_map_init_target(name, ir_lookup_name_type(name))
        r := ir_emit_value_for_target(node.children[0], legacy_target)
        if legacy_kind.len() > 0 and legacy_target != "tuple" and ir_string_expr_is_borrowed(node.children[0]):
            ir_rc_retain_reg(r, legacy_kind)
        if old_r >= 0:
            ir_rc_release_local(old_r, legacy_kind, name)
        ir_var_regs.insert(name, r)
        ir_emit_name_store(name, r)

fn ir_resolve_field_lookup_key(recv_idx: Int, fname: String) -> String:
    direct := ir_field_lookup_key(recv_idx, fname)
    if ir_struct_field_index_lookup.contains_key(direct):
        return direct
    recv_type := ir_field_receiver_type(recv_idx)
    base := ir_strip_type_args(recv_type)
    if base != recv_type:
        base_key := base + "." + fname
        if ir_struct_field_index_lookup.contains_key(base_key):
            return base_key
    return ""

# Assign to a struct field target: `obj.field = value`. Returns false if the
# target is not a known struct field (so the caller falls back to other forms).
fn ir_emit_field_assignment(target_idx: Int, value_idx: Int) -> Bool:
    target := get_node(target_idx)
    if target.kind != "field_access" or target.children.len() == 0:
        return false
    fname := node_value(target_idx)
    recv_idx := target.children[0]
    lookup_key := ir_resolve_field_lookup_key(recv_idx, fname)
    if lookup_key.len() == 0:
        return false
    field_index := ir_unpack_field_index(ir_struct_field_index_lookup[lookup_key])
    obj_r := ir_expr(recv_idx)
    mut value_type := ir_checked_struct_field_type(recv_idx, fname)
    if value_type.len() == 0:
        value_type = ir_infer_type(value_idx)
    fassign_kind := ir_rc_kind(value_type)
    # a weak field stores the bare target pointer: drop the old weak reference,
    # take a new one, and never touch the strong count. no owning tuple is
    # involved, so the strong release/retain dance below is skipped entirely.
    weak_struct := lookup_key.substring(0, lookup_key.len() - fname.len() - 1)
    if ir_struct_field_is_weak(weak_struct, fname):
        old_w := ir_reg()
        ir_emit_named_field_access(old_w, obj_r, lookup_key, fname, value_type)
        new_w := ir_emit_weak_payload(value_idx)
        ir_emit("sstore " + obj_r.to_string() + " " + field_index.to_string() + " " + new_w.to_string())
        rel_r := ir_reg()
        ir_emit("call " + rel_r.to_string() + " pith_struct_weak_release void 1 " + old_w.to_string())
        return true
    # release the value already in the field before overwriting it, the same
    # ownership dance local and global assignment do. load the old value first
    # so a self-referential rhs (obj.f = obj.f...) still sees it, then release
    # after the store.
    mut old_r := 0 - 1
    if fassign_kind.len() > 0 and ir_rc_release_enabled(fassign_kind):
        old_r = ir_reg()
        ir_emit_named_field_access(old_r, obj_r, lookup_key, fname, value_type)
    value_r := ir_emit_value_for_target(value_idx, value_type)
    # a tuple-typed (optional) rhs is already owned from ir_emit_value_for_target,
    # so it must not be retained again; the old value is still released below, so
    # its payload is freed via the optional's destructor.
    if fassign_kind.len() > 0 and fassign_kind != "tuple" and ir_string_expr_is_borrowed(value_idx):
        ir_rc_retain_reg(value_r, fassign_kind)
    ir_emit("sstore " + obj_r.to_string() + " " + field_index.to_string() + " " + value_r.to_string())
    if old_r >= 0:
        ir_rc_release_reg(old_r, fassign_kind)
    return true

# Compound assign to a struct field: `obj.field += value` (and -=, *=, /=).
fn ir_emit_field_compound_assignment(target_idx: Int, value_idx: Int, compound_op: String) -> Bool:
    target := get_node(target_idx)
    if target.kind != "field_access" or target.children.len() == 0:
        return false
    fname := node_value(target_idx)
    recv_idx := target.children[0]
    lookup_key := ir_resolve_field_lookup_key(recv_idx, fname)
    if lookup_key.len() == 0:
        return false
    field_index := ir_unpack_field_index(ir_struct_field_index_lookup[lookup_key])
    obj_r := ir_expr(recv_idx)
    cur := ir_reg()
    ir_emit_named_field_access(cur, obj_r, lookup_key, fname, ir_checked_struct_field_type(recv_idx, fname))
    rhs := ir_expr(value_idx)
    res := ir_reg()
    ir_emit_simple_binary(res, compound_op, cur, rhs)
    ir_emit("sstore " + obj_r.to_string() + " " + field_index.to_string() + " " + res.to_string())
    return true

fn ir_emit_compound_assignment(node: Node):
    op := node.value
    if op == "=" and node.children.len() >= 2:
        if ir_emit_index_assignment(node.children[0], node.children[1]):
            return
        if ir_emit_field_assignment(node.children[0], node.children[1]):
            return
        tn := get_node(node.children[0])
        name := tn.value
        target_type := ir_checked_target_type(node.children[0], name)
        # same ownership dance as ir_emit_bind_stmt: retain a borrowed RHS,
        # release the value being replaced. this is the path plain
        # `name = value` statements actually take.
        mut assign_kind := ir_rc_kind(target_type)
        if assign_kind.len() == 0:
            assign_kind = ir_rc_kind(ir_lookup_name_type(name))
        tracked := ir_rc_local_kind(name).len() > 0
        mut old_r := 0 - 1
        if assign_kind.len() > 0 and ir_rc_release_enabled(assign_kind):
            if tracked or (assign_kind == "string" and ir_global_string_names.contains(name)):
                old_r = ir_reg()
                ir_emit_name_load(old_r, name)
        assign_target := ir_map_init_target(name, target_type)
        r := ir_emit_value_for_target(node.children[1], assign_target)
        # a tuple (optional) rhs is owned from ir_emit_value_for_target; don't retain.
        if assign_kind.len() > 0 and assign_target != "tuple" and ir_string_expr_is_borrowed(node.children[1]):
            ir_rc_retain_reg(r, assign_kind)
        if old_r >= 0:
            ir_rc_release_reg(old_r, assign_kind)
        ir_emit_name_store(name, r)
        return
    compound_op := ir_compound_assignment_ir_op(op)
    if compound_op.len() > 0 and node.children.len() >= 2:
        if ir_emit_field_compound_assignment(node.children[0], node.children[1], compound_op):
            return
        tn := get_node(node.children[0])
        name := tn.value
        cur := ir_reg()
        ir_emit_name_load(cur, name)
        rhs := ir_expr(node.children[1])
        res := ir_reg()
        ir_emit_simple_binary(res, compound_op, cur, rhs)
        ir_emit_name_store(name, res)

# emit a label and clear the return-tracking flag: a label starts a
# fresh block, so whatever terminator came before it belongs to a
# different path
fn ir_emit_if_branch(branch: IrIfBranch, then_label: String, next_label: String, end_label: String):
    if branch.cond_idx >= 0:
        cr := ir_expr(branch.cond_idx)
        ir_emit("brif " + cr.to_string() + " " + then_label + " " + next_label)
    ir_emit_label(then_label)
    ir_last_was_ret = false
    if branch.body_idx >= 0:
        ir_block(branch.body_idx)
    if not ir_last_was_ret:
        ir_emit("jmp " + end_label)
    ir_emit_label(next_label)

fn ir_emit_for_loop_value_binding(value_name: String, index_name: String, item_kind: String, iter_name: String, index_name_internal: String):
    it_r := ir_reg()
    ir_emit("load " + it_r.to_string() + " " + iter_name)
    idx_r := ir_reg()
    ir_emit("load " + idx_r.to_string() + " " + index_name_internal)
    elem_r := ir_reg()
    item_ret_kind := ir_for_loop_item_return_kind(item_kind)
    ir_emit_call2(elem_r, ir_for_loop_item_call_name(item_kind), item_ret_kind, it_r, idx_r)
    # always register the loop variable as a local, even when its element type
    # is unknown (as in a generic body where the element is T). otherwise a loop
    # var whose name matches a module function is mistaken for that function and
    # loaded as a fn-value. "unknown" carries no rc kind, so this is release-safe.
    ir_var_types.insert(value_name, item_ret_kind)
    ir_emit_name_store(value_name, elem_r)
    if index_name.len() > 0:
        idx_val := ir_reg()
        ir_emit("load " + idx_val.to_string() + " " + index_name_internal)
        ir_emit_name_store(index_name, idx_val)
        ir_var_types.insert(index_name, "int")

# --- statement lowering ---
#
# statements are where ownership moves: binds and assigns retain,
# rebinds release the old value, returns hand the value out. the
# string-ownership rules live in the long comment above
# ir_emit_call2; every statement shape here follows them.
fn ir_stmt(idx: Int):
    node := get_node(idx)
    kind := node.kind

    # each statement speaks for itself: without this reset, a nested
    # `if x: return` leaves the flag stuck on true, and the statements
    # after it lose their branch-merge jump — the code falls through
    # into the else arm
    ir_last_was_ret = false

    # a defer emits nothing here: record its inner statement so it can be
    # re-emitted at each exit edge of the enclosing scope. errdefer is the same
    # registration tagged as error-only (is_err = 1).
    if kind == "defer":
        if node.children.len() > 0:
            ir_defer_register(node.children[0], 0)
        return
    if kind == "errdefer":
        if node.children.len() > 0:
            ir_defer_register(node.children[0], 1)
        return

    if ir_stmt_is_expr(kind):
        r := ir_expr(idx)
        # a fire-and-forget `spawn f()` whose handle is discarded at statement
        # position must be detached, or the runtime never reclaims the task's
        # slab slot once it finishes — the slab reclaims only on await or
        # detach. an accept loop doing `spawn handle_conn(fd)` per connection
        # would otherwise grow the slab (and, on the os-thread backend, pin a
        # JoinHandle) without bound. detaching hands the runtime permission to
        # reclaim the slot on completion; a bound or awaited handle never
        # reaches here, so only the discarded case is affected.
        if kind == "spawn":
            ir_emit_call1(ir_reg(), "pith_task_detach", "void", r)
            return
        # a discarded result from a bare `foo()!`-less call owns its box: free
        # its live payload and the shell, or both leak (this is what a bare
        # `buf.write_byte(x)` did before).
        if kind == "call" or kind == "method_call":
            stmt_tid := c_get_expr_type(idx)
            if stmt_tid >= 0 and get_type_info(stmt_tid).kind == "result":
                ir_emit_discard_result(r, stmt_tid)
                return
        # a discarded owned string result (a popped element, an unused
        # fresh string) is garbage as soon as the statement ends
        if ir_infer_type(idx) == "string" and not ir_string_expr_is_borrowed(idx):
            ir_string_release_reg(r)
        return

    if kind == "block":
        ir_block(idx)
        return

    if kind == "return":
        ir_emit_return_stmt(node)
        return

    if kind == "bind" or kind == "binding":
        ir_emit_bind_stmt(node)
        return

    if kind == "assign":
        ir_emit_assign_stmt(node)
        return

    if kind == "assignment":
        ir_emit_compound_assignment(node)
        return

    ir_stmt_control(idx, node)

fn ir_emit_if_stmt(node: Node):
    mut elif_indices: List[Int] := []
    mut else_idx := 0 - 1
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "elif":
            elif_indices.push(child)
        elif cn.kind == "else":
            else_idx = child
    main_branch := ir_collect_if_branch(node)
    end_label := ir_label()
    then_label := ir_label()
    next_label := ir_label()
    ir_emit_if_branch(main_branch, then_label, next_label, end_label)
    for elif_idx in elif_indices:
        branch := ir_collect_if_branch(get_node(elif_idx))
        ir_emit_if_branch(branch, ir_label(), ir_label(), end_label)
    if else_idx >= 0:
        ir_block(else_idx)
    ir_emit_label(end_label)

# if let / while let share the match machinery: a variant pattern uses the
# match condition and binding emitters, a bare binding tests an optional's
# flag and extracts its value.
fn ir_emit_let_cond(pat_idx: Int, subj_r: Int) -> Int:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        r := ir_reg()
        ir_emit_optional_none_compare(r, "neq", subj_r)
        return r
    return ir_emit_match_cond(pat_idx, subj_r)

fn ir_emit_let_bindings(pat_idx: Int, subj_r: Int, subj_idx: Int):
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        # ir_emission_tid, not the bare checked tid: inside a generic
        # specialization an optional parameter is checked before the
        # substitution, and the value-field extract answers register zero
        # when handed a tid that is not an Optional.
        subj_tid := ir_emission_tid(subj_idx)
        val_r := ir_optional_value_field(subj_r, subj_tid)
        ir_var_regs.insert(pat.value, val_r)
        if subj_tid >= 0:
            info := get_type_info(subj_tid)
            if info.kind == "optional" and info.inner >= 0:
                inner_kind := ir_type_from_tid(info.inner)
                if inner_kind.len() > 0:
                    ir_var_types.insert(pat.value, inner_kind)
        ir_emit("store " + pat.value + " " + val_r.to_string())
        return
    ir_emit_match_bindings(pat_idx, subj_r, "")

# true when an optional subject is a fresh shell the consumer owns and must
# release after use — a call or method-call result mints one (map.get(k), f()).
# borrowed subjects (a variable, field, element, self) are owned at their own
# scope and released there, so releasing here would double-free. suppressed
# inside generic/specialized bodies where the shape can't be trusted, mirroring
# ir_expr_is_transferred_call_temp.
fn ir_optional_subject_is_owned(idx: Int) -> Bool:
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return false
    kind := node_kind(idx)
    return kind == "call" or kind == "method_call"

fn ir_emit_if_let_stmt(node: Node):
    if node.children.len() < 3:
        return
    subj_r := ir_expr(node.children[1])
    # a fresh optional (a call/method result) is an owned shell; the binding
    # below borrows its value into the loop-style scope, so the shell is
    # released once at the merge — mirroring the for-each next() path — instead
    # of leaking one shell (and its payload) per evaluation.
    owns_subject := ir_optional_subject_is_owned(node.children[1])
    cond_r := ir_emit_let_cond(node.children[0], subj_r)
    then_l := ir_label()
    else_l := ir_label()
    end_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + then_l + " " + else_l)
    ir_emit_label(then_l)
    ir_last_was_ret = false
    ir_emit_let_bindings(node.children[0], subj_r, node.children[1])
    ir_block(node.children[2])
    if not ir_last_was_ret:
        ir_emit("jmp " + end_l)
    ir_emit_label(else_l)
    ir_last_was_ret = false
    if node.children.len() > 3:
        ir_block(node.children[3])
    ir_emit_label(end_l)
    if owns_subject:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", subj_r)
    ir_last_was_ret = false

fn ir_emit_while_let_stmt(node: Node):
    if node.children.len() < 3:
        return
    head_label := ir_label()
    body_label := ir_label()
    end_label := ir_label()
    ir_emit_label(head_label)
    subj_r := ir_expr(node.children[1])
    owns_subject := ir_optional_subject_is_owned(node.children[1])
    cond_r := ir_emit_let_cond(node.children[0], subj_r)
    ir_emit("brif " + cond_r.to_string() + " " + body_label + " " + end_label)
    ir_emit_label(body_label)
    ir_last_was_ret = false
    ir_emit_let_bindings(node.children[0], subj_r, node.children[1])
    ir_break_stack = ir_push_string(ir_break_stack, end_label)
    ir_continue_stack = ir_push_string(ir_continue_stack, head_label)
    ir_defer_loop_enter()
    ir_block(node.children[2])
    ir_defer_loop_exit()
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    # release this iteration's owned shell before looping (the body borrowed its
    # value); the shell that fails the condition is released after the loop.
    if owns_subject:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", subj_r)
    ir_emit("jmp " + head_label)
    ir_emit_label(end_label)
    if owns_subject:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", subj_r)
    ir_last_was_ret = false

fn ir_emit_while_stmt(node: Node):
    head_label := ir_label()
    body_label := ir_label()
    end_label := ir_label()
    ir_emit_label(head_label)
    if node.children.len() >= 2:
        cr := ir_expr(node.children[0])
        ir_emit("brif " + cr.to_string() + " " + body_label + " " + end_label)
        ir_emit_label(body_label)
        ir_break_stack = ir_push_string(ir_break_stack, end_label)
        ir_continue_stack = ir_push_string(ir_continue_stack, head_label)
        ir_defer_loop_enter()
        ir_block(node.children[1])
        ir_defer_loop_exit()
        ir_break_stack.remove(ir_break_stack.len() - 1)
        ir_continue_stack.remove(ir_continue_stack.len() - 1)
        ir_emit("jmp " + head_label)
    ir_emit_label(end_label)

fn ir_emit_for_stmt(node: Node):
    names := ir_for_binding_names(node)
    if node.children.len() >= 2:
        if get_node(node.children[0]).kind == "range":
            ir_emit_for_range_stmt(node, names)
            return
        # iterator protocol: a struct with a `next() -> T?` method drives the
        # loop via next() instead of index-based access
        mut iter_struct := ir_infer_type(node.children[0])
        # if the inferred name is a generic struct's base and matches the base
        # of an active generic-function concrete type, promote it to the full
        # instance name so dispatch picks the specialized impl method
        if iter_struct.len() > 0 and iter_struct.contains("[") == false:
            mut gi := 0
            while gi < ir_active_generic_concrete_types.len():
                concrete := ir_active_generic_concrete_types[gi]
                if ir_strip_type_args(concrete) == iter_struct:
                    iter_struct = concrete
                    gi = ir_active_generic_concrete_types.len()
                gi = gi + 1
        # prefer a specialized method body (recorded by per-instantiation
        # emission) so iterators specialized for this instance dispatch
        # without falling back to the base body's unresolved calls
        mut next_name := ir_lookup_specialized_method(iter_struct, "next")
        if next_name.len() == 0:
            next_name = ir_lookup_impl_method_for(node.children[0], iter_struct, "next")
        if next_name.len() > 0:
            ir_emit_for_iterator_stmt(node, names, next_name)
            return
        ir_emit_for_indexed_stmt(node, names)

# `for x in list` and other index-addressable iterables (the fallback when the
# element is neither a range nor an iterator-protocol struct). Converts to a
# fresh container when the type needs it, then runs a counted loop over the
# length using get-by-index. An owned iterable is released when the loop ends,
# or at the function's exit edges if the body returns / fails early.
fn ir_emit_for_indexed_stmt(node: Node, names: IrForBindingNames):
    iter_type := ir_infer_type(node.children[0])
    mut iter_r := ir_expr(node.children[0])
    item_kind := ir_for_iter_item_kind(iter_type)
    # an owned iterable (a split result, a keys() list) dies when the
    # loop ends; a converted iterable is always a fresh container
    mut iter_release_kind := ""
    if not ir_string_expr_is_borrowed(node.children[0]):
        iter_release_kind = ir_rc_kind(iter_type)
    conversion_call := ir_for_iter_conversion_call(iter_type)
    if conversion_call.len() > 0:
        converted_r := ir_reg()
        ir_emit_call1(converted_r, conversion_call, ir_for_iter_conversion_return_kind(iter_type), iter_r)
        if iter_release_kind.len() > 0:
            ir_rc_release_reg(iter_r, iter_release_kind)
        iter_r = converted_r
        iter_release_kind = ir_rc_kind(ir_for_iter_conversion_return_kind(iter_type))
    fid := ir_for_count
    ir_for_count = ir_for_count + 1
    fi := "__for_idx_" + fid.to_string()
    fl := "__for_len_" + fid.to_string()
    ft := "__for_iter_" + fid.to_string()
    len_r := ir_reg()
    ir_emit_call1(len_r, ir_for_len_call_name(item_kind), "int", iter_r)
    idx_r := ir_reg()
    ir_emit("iconst " + idx_r.to_string() + " 0")
    ir_emit("store " + fi + " " + idx_r.to_string())
    ir_emit("store " + fl + " " + len_r.to_string())
    ir_emit("store " + ft + " " + iter_r.to_string())
    head_l := ir_label()
    body_l := ir_label()
    step_l := ir_label()
    end_l := ir_label()
    ir_emit_label(head_l)
    ci := ir_reg()
    ir_emit("load " + ci.to_string() + " " + fi)
    cl := ir_reg()
    ir_emit("load " + cl.to_string() + " " + fl)
    cmp_r := ir_reg()
    ir_emit("lt " + cmp_r.to_string() + " " + ci.to_string() + " " + cl.to_string())
    ir_emit("brif " + cmp_r.to_string() + " " + body_l + " " + end_l)
    ir_emit_label(body_l)
    prev_value_slot := ir_loop_var_push(names.value_name, ir_loop_var_slot_name(fid, names.value_name))
    prev_index_slot := ir_loop_var_push(names.index_name, ir_loop_var_slot_name(fid, names.index_name))
    ir_emit_for_loop_value_binding(names.value_name, names.index_name, item_kind, ft, fi)
    ir_break_stack = ir_push_string(ir_break_stack, end_l)
    ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
    ir_defer_loop_enter()
    # an early return/fail/`!` inside the body skips end_l's release below, so
    # register this owned iterable for the exit edges to release. break and
    # continue reach end_l, so they still release there — not here.
    mut pushed_iter := false
    if iter_release_kind.len() > 0:
        ir_loop_iter_vars.push(ft)
        ir_loop_iter_kinds.push(iter_release_kind)
        pushed_iter = true
    ir_block(node.children[1])
    if pushed_iter:
        ir_loop_iter_vars.remove(ir_loop_iter_vars.len() - 1)
        ir_loop_iter_kinds.remove(ir_loop_iter_kinds.len() - 1)
    ir_defer_loop_exit()
    ir_loop_var_pop(names.index_name, prev_index_slot)
    ir_loop_var_pop(names.value_name, prev_value_slot)
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit_label(step_l)
    idx3 := ir_reg()
    ir_emit("load " + idx3.to_string() + " " + fi)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    inc_r := ir_reg()
    ir_emit("add " + inc_r.to_string() + " " + idx3.to_string() + " " + one_r.to_string())
    ir_emit("store " + fi + " " + inc_r.to_string())
    ir_emit("jmp " + head_l)
    ir_emit_label(end_l)
    if iter_release_kind.len() > 0:
        fin_r := ir_reg()
        ir_emit("load " + fin_r.to_string() + " " + ft)
        ir_rc_release_reg(fin_r, iter_release_kind)

# `for i in lo..hi` lowers to a counted loop over an Int counter, with no
# intermediate list allocation. exclusive (`..`) stops at hi, inclusive
# (`..=`) includes it. an optional index binding tracks the 0-based position.
fn ir_emit_for_range_stmt(node: Node, names: IrForBindingNames):
    iter_node := get_node(node.children[0])
    inclusive := iter_node.value == "inclusive"
    lo_r := ir_expr(iter_node.children[0])
    hi_r := ir_expr(iter_node.children[1])
    fid := ir_for_count
    ir_for_count = ir_for_count + 1
    fv := "__for_val_" + fid.to_string()
    fh := "__for_hi_" + fid.to_string()
    fp := "__for_pos_" + fid.to_string()
    has_index := names.index_name.len() > 0
    ir_emit("store " + fv + " " + lo_r.to_string())
    ir_emit("store " + fh + " " + hi_r.to_string())
    if has_index:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("store " + fp + " " + zero_r.to_string())
    head_l := ir_label()
    body_l := ir_label()
    step_l := ir_label()
    end_l := ir_label()
    ir_emit_label(head_l)
    cv := ir_reg()
    ir_emit("load " + cv.to_string() + " " + fv)
    ch := ir_reg()
    ir_emit("load " + ch.to_string() + " " + fh)
    cmp_r := ir_reg()
    mut cmp_op := "lt"
    if inclusive:
        cmp_op = "lte"
    ir_emit(cmp_op + " " + cmp_r.to_string() + " " + cv.to_string() + " " + ch.to_string())
    ir_emit("brif " + cmp_r.to_string() + " " + body_l + " " + end_l)
    ir_emit_label(body_l)
    prev_value_slot := ir_loop_var_push(names.value_name, ir_loop_var_slot_name(fid, names.value_name))
    prev_index_slot := ir_loop_var_push(names.index_name, ir_loop_var_slot_name(fid, names.index_name))
    bind_r := ir_reg()
    ir_emit("load " + bind_r.to_string() + " " + fv)
    ir_var_types.insert(names.value_name, "int")
    ir_emit_name_store(names.value_name, bind_r)
    if has_index:
        pos_r := ir_reg()
        ir_emit("load " + pos_r.to_string() + " " + fp)
        ir_var_types.insert(names.index_name, "int")
        ir_emit_name_store(names.index_name, pos_r)
    ir_break_stack = ir_push_string(ir_break_stack, end_l)
    ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
    ir_defer_loop_enter()
    ir_block(node.children[1])
    ir_defer_loop_exit()
    ir_loop_var_pop(names.index_name, prev_index_slot)
    ir_loop_var_pop(names.value_name, prev_value_slot)
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit_label(step_l)
    v3 := ir_reg()
    ir_emit("load " + v3.to_string() + " " + fv)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    inc_r := ir_reg()
    ir_emit("add " + inc_r.to_string() + " " + v3.to_string() + " " + one_r.to_string())
    ir_emit("store " + fv + " " + inc_r.to_string())
    if has_index:
        p3 := ir_reg()
        ir_emit("load " + p3.to_string() + " " + fp)
        pone_r := ir_reg()
        ir_emit("iconst " + pone_r.to_string() + " 1")
        pinc_r := ir_reg()
        ir_emit("add " + pinc_r.to_string() + " " + p3.to_string() + " " + pone_r.to_string())
        ir_emit("store " + fp + " " + pinc_r.to_string())
    ir_emit("jmp " + head_l)
    ir_emit_label(end_l)

# `for x in it` where `it` is an iterator (a struct with `next() -> T?`).
# Drives the loop by calling next() each iteration: the result is an optional
# tuple (is_some flag at field 0, value at field 8); stop when the flag is 0.
fn ir_emit_for_iterator_stmt(node: Node, names: IrForBindingNames, next_name: String):
    iter_r := ir_expr(node.children[0])
    fid := ir_for_count
    ir_for_count = ir_for_count + 1
    it_var := "__for_it_" + fid.to_string()
    fp := "__for_pos_" + fid.to_string()
    has_index := names.index_name.len() > 0
    ir_emit("store " + it_var + " " + iter_r.to_string())
    if has_index:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("store " + fp + " " + zero_r.to_string())
    # the element type was cached on the loop-var node by the checker
    mut elem_kind := ir_retkind(ir_type_from_tid(c_get_expr_type(node.children[2])))
    if elem_kind.len() == 0:
        elem_kind = "unknown"
    head_l := ir_label()
    body_l := ir_label()
    step_l := ir_label()
    end_l := ir_label()
    ir_emit_label(head_l)
    it_cur := ir_reg()
    ir_emit("load " + it_cur.to_string() + " " + it_var)
    opt_r := ir_reg()
    ir_emit("call " + opt_r.to_string() + " " + next_name + " tuple 1 " + it_cur.to_string())
    flag_r := ir_optional_flag_field(opt_r)
    ir_emit("brif " + flag_r.to_string() + " " + body_l + " " + end_l)
    ir_emit_label(body_l)
    prev_value_slot := ir_loop_var_push(names.value_name, ir_loop_var_slot_name(fid, names.value_name))
    prev_index_slot := ir_loop_var_push(names.index_name, ir_loop_var_slot_name(fid, names.index_name))
    val_r := ir_reg()
    ir_emit("field " + val_r.to_string() + " " + opt_r.to_string() + " 8 " + elem_kind + " value")
    ir_var_types.insert(names.value_name, elem_kind)
    ir_emit_name_store(names.value_name, val_r)
    if has_index:
        pos_r := ir_reg()
        ir_emit("load " + pos_r.to_string() + " " + fp)
        ir_var_types.insert(names.index_name, "int")
        ir_emit_name_store(names.index_name, pos_r)
    ir_break_stack = ir_push_string(ir_break_stack, end_l)
    ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
    ir_defer_loop_enter()
    ir_block(node.children[1])
    ir_defer_loop_exit()
    ir_loop_var_pop(names.index_name, prev_index_slot)
    ir_loop_var_pop(names.value_name, prev_value_slot)
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit_label(step_l)
    # release the optional next() returned this iteration; the element was
    # borrowed into the loop var (the body retained it if it kept it), so the
    # tuple's own count is dropped here. without this, one optional per step
    # (and the none that ends the loop) leaks.
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    if has_index:
        p3 := ir_reg()
        ir_emit("load " + p3.to_string() + " " + fp)
        pone_r := ir_reg()
        ir_emit("iconst " + pone_r.to_string() + " 1")
        pinc_r := ir_reg()
        ir_emit("add " + pinc_r.to_string() + " " + p3.to_string() + " " + pone_r.to_string())
        ir_emit("store " + fp + " " + pinc_r.to_string())
    ir_emit("jmp " + head_l)
    ir_emit_label(end_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)

fn ir_stmt_control(idx: Int, node: Node):
    if node.kind == "if" or node.kind == "if_stmt":
        ir_emit_if_stmt(node)

    elif node.kind == "if_let":
        ir_emit_if_let_stmt(node)

    elif node.kind == "while_let":
        ir_emit_while_let_stmt(node)

    elif node.kind == "while" or node.kind == "while_stmt":
        ir_emit_while_stmt(node)

    elif node.kind == "for" or node.kind == "for_stmt":
        ir_emit_for_stmt(node)

# --- block lowering ---
#
# a block is statements plus the two loop-control jumps that need to
# know their enclosing labels (break, continue).
# Recursive block walker — unwrap block/body/then/else wrappers
# and emits statements in source order.
# returns a throwaway 0 so it can travel as a fn value: void
# functions are not yet recognized by the function-value path.
fn ir_block(idx: Int) -> Int:
    kind := node_kind(idx)
    if kind == "block" or kind == "then" or kind == "else" or kind == "body":
        ir_defer_push_scope()
        mut i := 0
        child_count := node_child_count(idx)
        while i < child_count:
            ir_block(node_child(idx, i))
            i = i + 1
        # fall-through off the end of the block runs its defers, then the
        # enclosing exit edge (or default return) runs the ARC cleanup.
        ir_defer_pop_scope_emit()
    else:
        # loop control jumps are the one statement shape that still needs
        # direct block-level handling. everything else goes through ir_stmt.
        if kind == "break":
            if ir_break_stack.len() > 0:
                # run the loop body's defers before leaving the loop
                ir_defer_emit_for_loop_jump()
                ir_emit("jmp " + ir_break_stack[ir_break_stack.len() - 1])
                ir_last_was_ret = true
            return 0
        if kind == "continue":
            if ir_continue_stack.len() > 0:
                # this iteration's defers run before jumping to the loop head
                ir_defer_emit_for_loop_jump()
                ir_emit("jmp " + ir_continue_stack[ir_continue_stack.len() - 1])
                ir_last_was_ret = true
            return 0
        ir_stmt(idx)
    return 0

# --- helpers for function emission ---

fn ir_extract_param_type(param_idx: Int) -> String:
    node := get_node(param_idx)
    if node.kind == "param" and node.children.len() > 0:
        return ir_resolve_type_node(node.children[0])
    return "Int"

fn ir_find_body(fn_idx: Int) -> Int:
    node := get_node(fn_idx)
    nk := node.children
    mut i := 0
    while i < nk.len():
        cn := get_node(nk[i])
        if cn.kind == "body":
            return nk[i]
        i = i + 1
    if nk.len() > 0:
        return nk[nk.len() - 1]
    return 0 - 1

fn ir_param_count(fn_idx: Int) -> Int:
    node := get_node(fn_idx)
    nk := node.children
    mut count := 0
    for child in nk:
        cn := get_node(child)
        if cn.kind == "param":
            count = count + 1
    return count

fn ir_record_closure_param_return(param_idx: Int):
    node := get_node(param_idx)
    if node.kind != "param" or node.children.len() == 0:
        return
    tn := get_node(node.children[0])
    if tn.kind != "fn_type" or tn.children.len() == 0:
        return
    # a fn_type node's last child wraps its return type in a "returns"
    # node; a fn type without one returns nothing
    last := get_node(tn.children[tn.children.len() - 1])
    if last.kind != "returns" or last.children.len() == 0:
        return
    ret_kind := ir_resolve_type_node(last.children[0])
    if ret_kind.len() > 0:
        ir_closure_return_kinds.insert(node.value, ret_kind)

fn ir_emit_named_param(name: String, param_type: String):
    r := ir_reg()
    ir_var_regs.insert(name, r)
    if param_type.len() > 0:
        ir_var_types.insert(name, param_type)
    ir_emit("param " + name)

fn ir_emit_fn_params(fn_idx: Int):
    node := get_node(fn_idx)
    nk := node.children
    for child in nk:
        cn := get_node(child)
        if cn.kind == "param":
            mut ptype := ir_extract_param_type(child)
            # inside an impl method, an associated-type param (`x: Item`)
            # resolves to the bound type so it gets the right arc treatment
            if ir_current_impl_type.len() > 0:
                ptype = ir_resolve_assoc_type(ir_current_impl_type, ptype)
            ir_emit_named_param(cn.value, ptype)
            ir_record_closure_param_return(child)

fn ir_extract_return_type(fn_idx: Int) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "type" or rn.kind == "generic_type" or rn.kind == "result_type" or rn.kind == "optional_type":
                    return ir_resolve_type_node(returns_child)
    return "unknown"

fn ir_extract_optional_inner_type(fn_idx: Int) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "optional_type" and rn.children.len() > 0:
                    return ir_resolve_type_node(rn.children[0])
    return ""

# True when the function declared at `fn_idx` returns a Result (T! or T!E).
# Used to decide whether index-expression codegen should propagate a fail
# on miss.
fn ir_fn_returns_result(fn_idx: Int) -> Bool:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "result_type":
                    return true
    return false

fn ir_lookup_impl_method_name(type_name: String, method_name: String) -> String:
    if type_name.len() == 0:
        return ""
    key := ir_impl_method_key(type_name, method_name)
    if ir_impl_methods.contains_key(key):
        return ir_impl_methods[key]
    resolved := ir_resolve_type_hint(type_name)
    if resolved != type_name:
        resolved_key := ir_impl_method_key(resolved, method_name)
        if ir_impl_methods.contains_key(resolved_key):
            return ir_impl_methods[resolved_key]
    if type_name.contains("["):
        base := type_name.substring(0, type_name.index_of("["))
        base_key := ir_impl_method_key(base, method_name)
        if ir_impl_methods.contains_key(base_key):
            return ir_impl_methods[base_key]
    return ""

# the receiver's checked declaration tid, or -1 when the checker never typed
# the expression as a plain struct or enum — or typed it under a different
# name than emission sees (a re-emitted generic body), in which case the tid
# is stale and must not steer dispatch.
fn ir_checked_receiver_tid(recv_idx: Int, type_name: String) -> Int:
    if recv_idx < 0:
        return 0 - 1
    mut tid := c_get_expr_type(recv_idx)
    if tid < 0:
        return 0 - 1
    mut info := get_type_info(tid)
    if info.kind == "optional" or info.kind == "result":
        if info.inner < 0:
            return 0 - 1
        tid = info.inner
        info = get_type_info(tid)
    if info.kind != "struct" and info.kind != "enum":
        return 0 - 1
    if info.name != type_name:
        return 0 - 1
    return tid

# the impl method symbol for a call on this receiver expression. two modules
# can each declare a struct with the receiver's name, and the name-keyed
# table holds whichever registered last — only the receiver's checked tid
# names the right declaration, so the tid key is tried first, mirroring how
# field reads resolve (ir_try_checked_field_read). when the receiver's tid is
# known but the name-keyed entry belongs to a different declaration, the
# entry is refused rather than lowering a method against the wrong layout.
# with no usable tid (generic bodies, emit-only receivers) the name-keyed
# lookup answers as before.
fn ir_lookup_impl_method_for(recv_idx: Int, type_name: String, method_name: String) -> String:
    tid := ir_checked_receiver_tid(recv_idx, type_name)
    if tid >= 0:
        tid_key := ir_impl_tid_key(tid, method_name)
        if ir_impl_methods.contains_key(tid_key):
            return ir_impl_methods[tid_key]
        name_key := ir_impl_method_key(type_name, method_name)
        if ir_impl_method_owner.contains_key(name_key):
            if ir_impl_method_owner[name_key] != tid:
                return ""
    return ir_lookup_impl_method_name(type_name, method_name)

fn ir_collect_impl_methods(root_idx: Int, module_path: String):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if node.kind == "impl_decl":
            ir_collect_impl_method_signatures(node, module_path)

fn ir_collect_generic_function_decls_from_root(root_idx: Int, module_path: String):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if ir_is_fn_decl_kind(node.kind) and ir_has_generic_params(node):
            ir_record_generic_function_decl(item_idx, node, module_path)

fn ir_infer_generic_concrete_types(name: String, node: Node) -> List[String]:
    if not ir_generic_decl_indices.contains_key(name):
        return ir_generic_arg_types(node)
    inferred := ir_infer_generic_concrete_types_with_state(name, node, ir_generic_decl_indices)
    return ir_fill_unknown_concretes_from_caller(name, node, inferred)

# the type node a named parameter of a function declaration was written
# with, or -1 when the name is not one of its parameters.
fn ir_decl_param_type_node(decl_idx: Int, param_name: String) -> Int:
    decl_node := get_node(decl_idx)
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "param" and cn.value == param_name and cn.children.len() > 0:
            return cn.children[0]
    return 0 - 1

# unify a callee parameter's type node against the caller parameter's type
# node that supplied the argument, binding the callee's generic params to
# concrete names resolved under the active substitution. only structurally
# parallel shapes with plain-name leaves bind; anything else stays unbound,
# which leaves the concrete "unknown" exactly as before.
fn ir_unify_generic_param_nodes(callee_idx: Int, caller_idx: Int, callee_params: List[String], bindings: Map[String, String]):
    if callee_idx < 0 or caller_idx < 0:
        return
    cn := get_node(callee_idx)
    an := get_node(caller_idx)
    if cn.kind == "type":
        if not callee_params.contains(cn.value):
            return
        if an.kind != "type":
            return
        resolved := ir_specialize_type_name(an.value, ir_active_generic_params, ir_active_generic_concrete_types)
        # an unresolved caller-side type variable must not bind: it would name
        # a type that does not exist and the specialization would misclassify
        if ir_active_generic_params.contains(resolved):
            return
        if not bindings.contains_key(cn.value):
            bindings.insert(cn.value, resolved)
        return
    if cn.kind == "generic_type" and an.kind == "generic_type" and cn.value == an.value:
        mut i := 0
        while i < cn.children.len() and i < an.children.len():
            ir_unify_generic_param_nodes(cn.children[i], an.children[i], callee_params, bindings)
            i = i + 1
        return
    if cn.kind == "fn_type" and an.kind == "fn_type":
        mut ci := 0
        mut ai := 0
        while ci < cn.children.len():
            ccn := get_node(cn.children[ci])
            while ai < an.children.len() and get_node(an.children[ai]).kind != ccn.kind:
                ai = ai + 1
            if ai < an.children.len():
                if ccn.kind == "param" and ccn.children.len() > 0:
                    acn := get_node(an.children[ai])
                    if acn.children.len() > 0:
                        ir_unify_generic_param_nodes(ccn.children[0], acn.children[0], callee_params, bindings)
                elif ccn.kind == "returns" and ccn.children.len() > 0:
                    acn := get_node(an.children[ai])
                    if acn.children.len() > 0:
                        ir_unify_generic_param_nodes(ccn.children[0], acn.children[0], callee_params, bindings)
                ai = ai + 1
            ci = ci + 1

# a generic call inside a specialized generic body has no checked argument
# types, so tid-based inference reports its type params "unknown" — and an
# unknown element type builds untagged containers whose stores own nothing
# (sort_by_key_desc's inner sort_by_key was exactly this, handing back
# structs nothing owned). when an argument is the enclosing body's own
# parameter, both declarations wrote down a type node; unifying the two
# under the active substitution recovers the concrete type. anything the
# unification cannot see stays "unknown", which is the old behavior.
fn ir_fill_unknown_concretes_from_caller(name: String, node: Node, inferred: List[String]) -> List[String]:
    if not inferred.contains("unknown"):
        return inferred
    if ir_active_generic_params.len() == 0 or ir_active_generic_decl_idx < 0:
        return inferred
    callee_decl := ir_generic_decl_indices[name]
    callee_params := ir_collect_generic_param_names(get_node(callee_decl))
    mut bindings: Map[String, String] := {}
    mut arg_pos := 0
    for child, i in node.children:
        if i == 0:
            continue
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                continue
            expr_idx = cn.children[0]
        en := get_node(expr_idx)
        if en.kind == "ident":
            caller_type_idx := ir_decl_param_type_node(ir_active_generic_decl_idx, en.value)
            if caller_type_idx >= 0:
                # a `:=` inside the body may rebind a parameter's name to a
                # different type; only unify while the tracked type still
                # matches what the parameter declared
                declared := ir_resolve_type_node(caller_type_idx)
                tracked := ir_lookup_name_type(en.value)
                if tracked.len() == 0 or tracked == declared:
                    callee_type_idx := ir_decl_param_type_node(callee_decl, ir_param_name_at(callee_decl, arg_pos))
                    ir_unify_generic_param_nodes(callee_type_idx, caller_type_idx, callee_params, bindings)
        arg_pos = arg_pos + 1
    mut filled: List[String] := []
    for concrete, i in inferred:
        if concrete == "unknown" and i < callee_params.len() and bindings.contains_key(callee_params[i]):
            filled.push(bindings[callee_params[i]])
        else:
            filled.push(concrete)
    return filled

fn ir_resolve_explicit_generic_type_arg(type_idx: Int) -> String:
    type_node := get_node(type_idx)
    if type_node.kind == "ident":
        resolved := ir_specialize_type_name(type_node.value, ir_active_generic_params, ir_active_generic_concrete_types)
        if resolved.len() > 0:
            return resolved
        return ir_resolve_type_hint(type_node.value)
    return ir_resolve_type_node_with_subst(type_idx, ir_active_generic_params, ir_active_generic_concrete_types)

fn ir_explicit_generic_concrete_types(index_node: Node) -> List[String]:
    mut concrete_types: List[String] := []
    mut i := 1
    while i < index_node.children.len():
        concrete_types.push(ir_resolve_explicit_generic_type_arg(index_node.children[i]))
        i = i + 1
    return concrete_types

fn ir_emit_fn_params_with_types(fn_idx: Int, param_types: List[String]):
    node := get_node(fn_idx)
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            mut param_type := ""
            if param_idx < param_types.len():
                param_type = param_types[param_idx]
            ir_emit_named_param(cn.value, param_type)
            ir_record_closure_param_return(child)
            param_idx = param_idx + 1

fn ir_generic_arg_types(node: Node) -> List[String]:
    mut arg_types: List[String] := []
    for child, i in node.children:
        if i == 0:
            continue
        child_kind := node_kind(child)
        mut expr_idx := child
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                expr_idx = cn.children[0]
        checked := ir_checked_type(expr_idx)
        if checked.len() > 0:
            arg_types.push(checked)
        else:
            arg_types.push(ir_infer_type(expr_idx))
    return arg_types

fn ir_generic_arg_tids(node: Node) -> List[Int]:
    mut arg_tids: List[Int] := []
    for child, i in node.children:
        if i == 0:
            continue
        child_kind := node_kind(child)
        mut expr_idx := child
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                expr_idx = cn.children[0]
        arg_tids.push(c_get_expr_type(expr_idx))
    return arg_tids

# resolve a `T.Item` type name through a generic specialization: substitute the
# base param (T -> the concrete type) then look up that type's assoc binding.
fn ir_resolve_assoc_in_generic(type_name: String, params: List[String], concrete: List[String]) -> String:
    if type_name.contains(".") == false:
        return type_name
    parts := type_name.split(".")
    if parts.len() != 2:
        return type_name
    mut i := 0
    for p in params:
        if p == parts[0] and i < concrete.len():
            akey := ir_strip_type_args(concrete[i]) + "." + parts[1]
            if ir_assoc_bindings.contains_key(akey):
                return ir_assoc_bindings[akey]
        i = i + 1
    return type_name

fn ir_emit_generic_specialization(key: String):
    if not ir_generic_specialization_names.contains_key(key):
        return
    base_name := key.split(chr(9))[0]
    if not ir_generic_decl_indices.contains_key(base_name):
        return
    decl_idx := ir_generic_decl_indices[base_name]
    decl_node := get_node(decl_idx)
    generic_params := ir_collect_generic_param_names(decl_node)
    concrete_types := ir_decode_type_list(ir_generic_specialization_type_lists[key])
    spec_name := ir_generic_specialization_names[key]
    body_idx := ir_find_body(decl_idx)
    param_count := ir_param_count(decl_idx)
    ret_type := ir_resolve_assoc_in_generic(ir_extract_return_type_with_subst(decl_idx, generic_params, concrete_types), generic_params, concrete_types)
    mut param_types := ir_extract_param_types_with_subst(decl_idx, generic_params, concrete_types)
    mut resolved_param_types: List[String] := []
    for pt in param_types:
        resolved_param_types.push(ir_resolve_assoc_in_generic(pt, generic_params, concrete_types))
    param_types = resolved_param_types
    saved_params := ir_active_generic_params
    saved_types := ir_active_generic_concrete_types
    saved_module_path := ir_active_generic_module_path
    saved_param_optional_tids := ir_active_param_optional_tids
    saved_decl_idx := ir_active_generic_decl_idx
    ir_active_generic_params = generic_params
    ir_active_generic_concrete_types = concrete_types
    ir_active_generic_decl_idx = decl_idx
    ir_active_param_optional_tids = ir_collect_param_optional_tids(decl_idx, key)
    if ir_generic_decl_module_paths.contains_key(base_name):
        ir_active_generic_module_path = ir_generic_decl_module_paths[base_name]
    else:
        ir_active_generic_module_path = ""
    ir_prepare_func_emission(ret_type)
    ir_current_func_optional_inner_kind = ir_resolve_assoc_in_generic(ir_extract_optional_inner_type_with_subst(decl_idx, generic_params, concrete_types), generic_params, concrete_types)
    ir_current_func_returns_result = ir_fn_returns_result(decl_idx)
    ir_emit_func_header(spec_name, param_count, ret_type)
    ir_emit_fn_params_with_types(decl_idx, param_types)
    ir_func_returns.insert(spec_name, ret_type)
    if concrete_types.len() == 1 and ir_is_config_decode_specialization(base_name, false, ir_active_generic_module_path, decl_idx):
        ir_emit_config_decode_specialization_body(concrete_types[0], false, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_config_decode_specialization(base_name, true, ir_active_generic_module_path, decl_idx):
        ir_emit_config_decode_specialization_body(concrete_types[0], true, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_handle_decode_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_handle_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_handle_decode_text_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_handle_decode_text_specialization_body(concrete_types[0], ir_active_generic_module_path, concrete_types, ret_type)
    elif concrete_types.len() == 1 and ir_is_handle_decode_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_handle_decode_path_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_handle_decode_text_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_handle_decode_text_path_specialization_body(concrete_types[0], ir_active_generic_module_path, concrete_types, ret_type)
    elif concrete_types.len() == 1 and ir_is_json_decode_specialization(base_name, ir_active_generic_module_path, decl_idx, false):
        ir_emit_json_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, false, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_specialization(base_name, ir_active_generic_module_path, decl_idx, true):
        ir_emit_json_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, true, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_object_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_json_decode_object_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_json_decode_path_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_emit_value_for_target, ir_emit_default_return)
    else:
        # a match payload binding's store releases the binding's previous
        # value, which loads a name the specialization's ir never declared —
        # ordinary bodies zero-store those names in the prologue. a re-emitted
        # generic body cannot run the full prologue: its exit cleanup would
        # release locals whose cross-module escape the emitter cannot see
        # from the caller's module (a result struct carrying a list, say),
        # and a recycled handle is worse than a leak. publish every rc bind
        # as untracked instead — the match emitter then skips the
        # release-of-previous and the binding's retain leaks at exit,
        # bounded and in the safe direction.
        mut spec_poisoned: List[String] := []
        ir_collect_string_bind_names(body_idx, ir_string_locals, spec_poisoned)
        for bn in ir_string_locals:
            if not ir_untracked_rc_binds.contains(bn):
                ir_untracked_rc_binds.push(bn)
        for pn in spec_poisoned:
            if not ir_untracked_rc_binds.contains(pn):
                ir_untracked_rc_binds.push(pn)
        ir_string_locals = []
        ir_rc_local_kinds = []
        ir_finish_func_emission(body_idx)
    ir_active_generic_params = saved_params
    ir_active_generic_concrete_types = saved_types
    ir_active_generic_module_path = saved_module_path
    ir_active_param_optional_tids = saved_param_optional_tids
    ir_active_generic_decl_idx = saved_decl_idx

# the tid a declared type name denotes, or -1 when it names nothing the type
# table knows. a source-level name (`Int`, a struct) resolves directly; a name
# that arrived as a substituted generic concrete is an emission kind, so map
# the primitive kinds back. anything else stays unresolved and the caller
# falls back to whatever the call sites recorded.
fn ir_tid_for_declared_type_name(name: String) -> Int:
    direct := lookup_type_id(name)
    if direct >= 0:
        return direct
    if name == "int":
        return TID_INT
    if name == "float":
        return TID_FLOAT
    if name == "bool":
        return TID_BOOL
    if name == "string":
        return TID_STRING
    if name == "bytes":
        return TID_BYTES
    return - 1

# the tid a *declared* type node denotes under the active substitution, or -1
# when the shape is one this cannot rebuild. only the shape has to be right:
# every consumer reads the emission kind off the tid, never its identity.
fn ir_declared_type_node_tid(type_idx: Int) -> Int:
    tn := get_node(type_idx)
    if tn.kind == "type":
        mut name := tn.value
        for generic_param, i in ir_active_generic_params:
            if generic_param == name and i < ir_active_generic_concrete_types.len():
                name = ir_active_generic_concrete_types[i]
        return ir_tid_for_declared_type_name(name)
    if tn.kind == "generic_type":
        if tn.value == "List" and tn.children.len() == 1:
            elem := ir_declared_type_node_tid(tn.children[0])
            if elem < 0:
                return - 1
            return add_type_info(ti_list(elem))
        if tn.value == "Set" and tn.children.len() == 1:
            elem := ir_declared_type_node_tid(tn.children[0])
            if elem < 0:
                return - 1
            return add_type_info(ti_set(elem))
        if tn.value == "Map" and tn.children.len() == 2:
            key := ir_declared_type_node_tid(tn.children[0])
            val := ir_declared_type_node_tid(tn.children[1])
            if key < 0 or val < 0:
                return - 1
            return add_type_info(ti_map(key, val))
        # a generic struct: its emission kind comes from the base name, and
        # the type arguments do not change it
        return ir_tid_for_declared_type_name(tn.value)
    if tn.kind == "tuple_type":
        mut element_tids: List[Int] := []
        for element_idx in tn.children:
            element_tid := ir_declared_type_node_tid(element_idx)
            if element_tid < 0:
                return - 1
            element_tids.push(element_tid)
        return add_type_info(ti_tuple(element_tids))
    return - 1

# the Optional tid a parameter was *declared* with, under the active
# substitution, or -1 when the declaration is not an optional (or names an
# inner type this cannot rebuild). this is what makes a parameter's
# optional-ness a property of the declaration rather than of whatever the
# first call site happened to pass.
fn ir_declared_param_optional_tid(param_node: Node) -> Int:
    if param_node.children.len() == 0:
        return - 1
    tn := get_node(param_node.children[0])
    if tn.kind != "optional_type" or tn.children.len() == 0:
        return - 1
    inner_tid := ir_declared_type_node_tid(tn.children[0])
    if inner_tid < 0:
        return - 1
    return add_type_info(ti_optional(inner_tid))

# which of a specialization's parameters are optionals, and with which tid.
#
# a parameter is optional when EITHER the declaration says so or the recorded
# call-site argument tid is an optional. the union matters in both directions:
#
#  - the declaration alone is not enough, because `fn my_eq[T](a: T, b: T)`
#    called with `Int?` has a plain `T` parameter whose optional-ness only the
#    argument knows.
#  - the argument alone is not enough, and was the bug: a bare `none` literal
#    carries TID_NONE, not an Optional tid, so `fn pick[T](a: T, b: Int?)`
#    called as `pick(x, none)` recorded no optional and lowered `b == none` as
#    a bare value compare. worse, arg tids are recorded first-call-site-wins
#    and every call site shares one specialization, so a single literal-`none`
#    site silently corrupted the sites around it that passed a real `Int?`.
#
# the argument tid is preferred when it is a genuine optional so the inner
# type keeps coming from the same place it always has; the declaration is the
# fallback that closes the hole.
fn ir_collect_param_optional_tids(fn_idx: Int, spec_key: String) -> Map[String, Int]:
    result: Map[String, Int] := {}
    arg_tids := ir_decode_generic_spec_arg_tids(spec_key)
    node := get_node(fn_idx)
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            mut tid := 0 - 1
            if param_idx < arg_tids.len():
                arg_tid := arg_tids[param_idx]
                if arg_tid >= 0 and get_type_info(arg_tid).kind == "optional":
                    tid = arg_tid
            if tid < 0:
                tid = ir_declared_param_optional_tid(cn)
            if tid >= 0:
                result.insert(cn.value, tid)
            param_idx = param_idx + 1
    return result

fn ir_emit_generic_specializations():
    mut i := 0
    while i < ir_generic_specialization_keys.len():
        key := ir_generic_specialization_keys[i]
        if not ir_generic_emitted_specializations.contains_key(key):
            ir_emit_generic_specialization(key)
            ir_generic_emitted_specializations.insert(key, 1)
        i = i + 1

fn ir_collect_impl_method_signatures(node: Node, module_path: String):
    impl_type := ir_impl_target_type(node)
    if impl_type.len() == 0:
        return
    for child in node.children:
        method_idx := ir_unwrap_pub_child(child)
        method_node := get_node(method_idx)
        if ir_is_fn_decl_kind(method_node.kind):
            ir_record_impl_method_signature(impl_type, method_idx, method_node, module_path)
            ir_maybe_register_result_reg_method(node, impl_type, method_idx, method_node, module_path)
    # inherited interface defaults get a signature under this concrete type too
    for default_idx in ir_inherited_default_indices(node):
        ir_record_impl_method_signature(impl_type, default_idx, get_node(default_idx), module_path)

# the declaration an impl target names, resolved in the impl's own module
# (falling back to the module currently being emitted, then the global
# table). a generic base has no single tid and answers -1; so does a target
# the module cannot see, and the method then stays name-keyed only.
fn ir_impl_owner_tid(impl_type: String, module_path: String) -> Int:
    if impl_type.contains("["):
        return 0 - 1
    mut path := module_path
    if path.len() == 0:
        path = ir_current_module_path
    if path.len() > 0:
        qualified := lookup_qualified_type_id(path, impl_type)
        if qualified >= 0:
            return qualified
    return lookup_type_id(impl_type)

# register one impl method under its name key and, when the impl target
# resolves to a concrete declaration, under a tid key too. the name key
# remembers its owner so dispatch on a same-named struct from another module
# can refuse it; the owner tracks the latest name-key write so the key and
# its owner always describe the same declaration.
fn ir_register_impl_method_entry(impl_type: String, method_name: String, full_name: String, module_path: String):
    key := ir_impl_method_key(impl_type, method_name)
    ir_impl_methods.insert(key, full_name)
    owner_tid := ir_impl_owner_tid(impl_type, module_path)
    if owner_tid >= 0:
        ir_impl_methods.insert(ir_impl_tid_key(owner_tid, method_name), full_name)
        ir_impl_method_owner.insert(key, owner_tid)
    elif ir_impl_method_owner.contains_key(key):
        ir_impl_method_owner.remove(key)

fn ir_record_impl_method_signature(impl_type: String, method_idx: Int, method_node: Node, module_path: String):
    method_name := method_node.value
    mut full_name := impl_type + "_" + method_name
    if module_path.len() > 0:
        full_name = ir_import_impl_method_name(module_path, impl_type, method_name)
    key := ir_impl_method_key(impl_type, method_name)
    ret_type := ir_resolve_assoc_type(impl_type, ir_extract_return_type(method_idx))
    ir_register_impl_method_entry(impl_type, method_name, full_name, module_path)
    ir_func_returns.insert(key, ret_type)
    ir_func_returns.insert(full_name, ret_type)

# returns a throwaway 0 so it can travel as a fn value: void
# functions are not yet recognized by the function-value path.
fn ir_emit_default_return() -> Int:
    ir_defer_emit_to_function_frame(false)
    ir_emit_string_cleanup("")
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    if ir_current_func_return_kind == "result_reg":
        # a pair-returning function's trailing (unreachable) default return
        # must still match the two-value signature.
        dr2 := ir_reg()
        ir_emit("iconst " + dr2.to_string() + " 0")
        ir_emit("ret2 " + dr.to_string() + " " + dr2.to_string())
    else:
        ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")
    return 0

fn ir_prepare_func_emission(ret_type: String):
    # each function starts from a clean local register/type state but keeps
    # the seeded global type tables so lowering stays consistent.
    ir_builder_reset_registers()
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()
    ir_map_value_types = {}
    ir_string_locals = []
    ir_rc_local_kinds = []
    ir_untracked_rc_binds = []
    ir_tuple_local_tid = {}
    ir_tuple_cascade_names = []
    # defers are function-scoped: start each function with empty scope stacks
    ir_defer_nodes = []
    ir_defer_is_err = []
    ir_defer_scope_starts = []
    ir_defer_loop_base_stack = []
    ir_loop_iter_vars = []
    ir_loop_iter_kinds = []
    ir_loop_var_slots = {}
    ir_seed_global_types()
    ir_current_func_return_kind = ret_type
    ir_set_pair_return(ret_type == "result_reg")
    ir_current_func_optional_inner_kind = ""

# A value-returning function whose body ends in a bare match has no explicit
# return, so the match is the implicit return value. (Such functions return 0
# today, so handling this can only fix behavior.) Returns the tail match node
# index, or -1.
# Find a tail-position match: unwrap block/body wrappers to the last statement,
# and report it if it is a match in a value-returning function. Such a function
# returns 0 today (no implicit-return support), so honoring the tail match can
# only fix behavior.
fn ir_finish_func_emission(body_idx: Int):
    if body_idx >= 0:
        # mark the tail match (if any) so it returns its value instead of
        # discarding it; ir_block emits the body, prefix statements included.
        ir_tail_match_node = ir_function_tail_match(body_idx)
        ir_block(body_idx)
        ir_tail_match_node = 0 - 1
    ir_emit_default_return()

fn ir_collect_test_decls(root_idx: Int) -> List[Int]:
    mut tests: List[Int] := []
    for item_idx in ir_root_items(root_idx):
        if get_node(item_idx).kind == "test_decl":
            tests.push(item_idx)
    return tests

fn ir_emit_test_func(idx: Int, ordinal: Int):
    body_idx := ir_find_body(idx)
    ir_prepare_func_emission("int")
    ir_emit_func_header("__test_" + ordinal.to_string(), 0, "int")
    ir_emitting_test_func = true
    # a test body is an ordinary function body: without the prologue its
    # locals are never collected or zero-stored, so a match payload binding
    # (which releases the binding's previous value) would load a name the ir
    # has not declared. mirrors ir_func.
    ir_emit_string_prologue(body_idx)
    ir_finish_func_emission(body_idx)
    ir_emitting_test_func = false

# the generated test main is a pure dispatcher: for each test it forks, runs the
# test in the child, and records the outcome in the parent. isolating each test
# in its own process means a failing assert (which exits) or a crash ends only
# that test — the rest still run and every result is reported. the parent never
# runs a test body, so no test's state leaks into the next child.
fn ir_emit_test_main(root_idx: Int):
    tests := ir_collect_test_decls(root_idx)
    if tests.len() == 0:
        return
    ir_prepare_func_emission("int")
    ir_emit_func_header("main", 0, "int")
    # test builds replace user main, so the tracer registration call the
    # normal main prelude carries is emitted here instead.
    ir_emit_call0(ir_reg(), ir_cc_register_fn_name(), "int")

    for test_idx, i in tests:
        name_r := ir_reg()
        ir_emit("strref " + name_r.to_string() + " " + ir_str(get_node(test_idx).value))

        # skip tests filtered out by PITH_TEST_FILTER before doing any work
        run_r := ir_reg()
        ir_emit_call1(run_r, "pith_test_should_run", "int", name_r)
        run_l := ir_label()
        skip_l := ir_label()
        ir_emit("brif " + run_r.to_string() + " " + run_l + " " + skip_l)

        ir_emit_label(run_l)
        pid_r := ir_reg()
        ir_emit_call0(pid_r, "pith_test_fork", "int")
        parent_l := ir_label()
        child_l := ir_label()
        ir_emit("brif " + pid_r.to_string() + " " + parent_l + " " + child_l)

        # child: remember the test name (so skip_test can name it), run the one
        # test, then exit cleanly (a failed assert or skip exits first)
        ir_emit_label(child_l)
        ir_emit_call1(ir_reg(), "pith_test_enter", "int", name_r)
        ir_emit_call0(ir_reg(), "__test_" + i.to_string(), "int")
        ir_emit_call0(ir_reg(), "pith_test_child_ok", "int")
        term_r := ir_reg()
        ir_emit("iconst " + term_r.to_string() + " 0")
        ir_emit("ret " + term_r.to_string())

        # parent: wait for the child and record pass/fail, then rejoin
        ir_emit_label(parent_l)
        ir_emit_call2(ir_reg(), "pith_test_record", "int", name_r, pid_r)
        ir_emit("jmp " + skip_l)
        ir_emit_label(skip_l)

    # exit with the failure count so `pith test` fails the process on any failure,
    # regardless of how the entry wrapper treats main's return value.
    summary_r := ir_reg()
    ir_emit_call0(summary_r, "pith_test_summary", "int")
    ir_emit_call1(ir_reg(), "exit", "unknown", summary_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("ret " + zero_r.to_string())
    ir_emit("endfunc")

# --- emit function ---
fn ir_func(idx: Int):
    node := get_node(idx)
    full_name := node.value
    name := ir_base_decl_name(full_name)
    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx)
    mut ret_type := ir_lookup_func_return(full_name, name)
    if ir_result_reg_funcs.contains_key(name):
        ret_type = "result_reg"
    ir_prepare_func_emission(ret_type)
    ir_current_arc_func = name
    ir_current_func_optional_inner_kind = ir_extract_optional_inner_type(idx)
    ir_current_func_returns_result = ir_fn_returns_result(idx)
    ir_emitting_main_body = name == "main"
    ir_emit_func_header(name, param_count, ret_type)
    ir_emit_fn_params(idx)
    if ir_emitting_main_body:
        # register this module's tracer pairs before any user code, the
        # way the driver injects the imported modules' init calls. an
        # imported module's main is stripped by the driver, so only the
        # root module's call survives into the combined program.
        ir_emit_call0(ir_reg(), ir_cc_register_fn_name(), "int")
    ir_emit_string_prologue(body_idx)
    ir_finish_func_emission(body_idx)
    ir_emitting_main_body = false

# --- emit impl method ---
fn ir_impl_func(idx: Int, impl_type: String):
    node := get_node(idx)
    orig_name := node.value
    full_name := impl_type + "_" + orig_name
    method_key := ir_impl_method_key(impl_type, orig_name)
    ir_register_impl_method_entry(impl_type, orig_name, full_name, "")

    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx) + 1
    # resolve an associated-type return (`-> Item`) to the impl's bound type so
    # the function's return kind is right — critical for heap types and arc
    ret_type := ir_resolve_assoc_type(impl_type, ir_extract_return_type(idx))
    # a registered method emits the pair signature, but the recorded return
    # below stays "tuple" — the same split ir_func keeps for free functions,
    # so everything outside the rcall paths still sees the box world.
    mut emit_ret := ret_type
    if ir_result_reg_funcs.contains_key(full_name):
        emit_ret = "result_reg"
    ir_prepare_func_emission(emit_ret)
    # an `-> Item?` return: resolve the inner kind too so the optional's
    # payload is reclaimed correctly for heap-typed bindings
    ir_current_func_optional_inner_kind = ir_resolve_assoc_type(impl_type, ir_extract_optional_inner_type(idx))
    ir_current_impl_type = impl_type
    ir_current_arc_func = full_name
    ir_emit_func_header(full_name, param_count, emit_ret)
    ir_emit_named_param("self", impl_type)
    ir_emit_fn_params(idx)
    ir_emit_string_prologue(body_idx)
    ir_func_returns.insert(method_key, ret_type)
    ir_func_returns.insert(full_name, ret_type)
    ir_finish_func_emission(body_idx)
    ir_current_impl_type = ""

fn ir_type_alias_target(node: Node) -> String:
    for tc in node.children:
        tn := get_node(tc)
        if tn.kind == "type":
            return tn.value
    return ""

fn ir_collect_import_item(node: Node):
    if node.kind == "import":
        ir_register_import_alias(node.value)
    elif node.kind == "from_import":
        ir_collect_from_import_renames(node.value)

fn ir_register_alias_structs(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        cn := get_node(item_idx)
        if cn.kind == "type_alias":
            aname := cn.value
            if ir_type_aliases.contains_key(aname):
                target := ir_type_aliases[aname]
                if ir_struct_names.contains_key(target):
                    ir_struct_names.insert(aname, ir_struct_names[target])
                    ir_emit("struct_alias " + aname + " " + target)

fn ir_record_function_return(node: Node):
    mut has_returns := false
    for returns_idx in node.children:
        returns_node := get_node(returns_idx)
        if returns_node.kind == "returns":
            ir_record_returns_clause(node.value, returns_node)
            has_returns = true
    # a function with no returns clause returns void; still record it so it is
    # recognized as a declared callable (e.g. usable as a fn-value).
    if not has_returns:
        ir_func_returns.insert(node.value, "void")
    ir_maybe_register_result_reg(node.value, node, ir_current_module_path)

fn ir_record_function_return_as(name: String, node: Node, home_module: String):
    mut has_returns := false
    for returns_idx in node.children:
        returns_node := get_node(returns_idx)
        if returns_node.kind == "returns":
            ir_record_returns_clause(name, returns_node)
            has_returns = true
    if not has_returns:
        ir_func_returns.insert(name, "void")
    ir_maybe_register_result_reg(name, node, home_module)

fn ir_record_returns_clause(name: String, returns_node: Node):
    for type_idx in returns_node.children:
        type_node := get_node(type_idx)
        # a function that returns a function type is still a declared callable,
        # and recording it is what keeps it out of a lambda's capture set: the
        # capture blocker is built from this table's keys, so a name missing
        # here is read as a free variable and the enclosing function emits a
        # `load` for it. `fn pick() -> fn(Int) -> Int` used to fail that way,
        # with "unknown load source 'pick'" — merely naming it inside a lambda
        # was enough, no call required.
        if type_node.kind == "type" or type_node.kind == "generic_type" or type_node.kind == "result_type" or type_node.kind == "optional_type" or type_node.kind == "fn_type":
            ir_func_returns.insert(name, ir_resolve_type_node(type_idx))
        if type_node.kind == "result" or type_node.kind == "result_type":
            if type_node.children.len() > 0:
                ir_func_result_ok_kinds.insert(name, ir_retkind(ir_resolve_type_node(type_node.children[0])))

fn ir_emit_global_binding(node: Node, is_threadlocal: Bool):
    gname := ir_binding_name(node)
    mut init_val := "0"
    mut global_type := ""
    mut global_map_value_type := ""
    for gc in node.children:
        gcn := get_node(gc)
        if gcn.kind == "type" or gcn.kind == "generic_type" or gcn.kind == "optional_type":
            global_type = ir_resolve_type_node(gc)
            if global_map_value_type.len() == 0:
                global_map_value_type = ir_resolve_map_value_type_node(gc)
        elif gcn.kind == "int_lit":
            init_val = gcn.value
            if global_type.len() == 0:
                global_type = "int"
        elif gcn.kind == "string_lit":
            si := ir_str(gcn.value)
            init_val = "str:" + si
            if global_type.len() == 0:
                global_type = "string"
        elif gcn.kind == "list":
            init_val = "list"
            if global_type.len() == 0:
                global_type = "list"
        elif gcn.kind == "map":
            init_val = "map"
            if global_type.len() == 0:
                global_type = "map"
        elif gcn.kind == "set":
            init_val = ir_checked_type(gc)
            if init_val.len() == 0:
                init_val = ir_infer_type(gc)
            if init_val.len() == 0:
                init_val = "set"
            if global_type.len() == 0:
                global_type = init_val
        elif gcn.kind == "bool_lit":
            if gcn.value == "true":
                init_val = "1"
            else:
                init_val = "0"
            if global_type.len() == 0:
                global_type = "bool"
    if global_type.len() > 0:
        ir_record_global_type(gname, global_type)
    if global_map_value_type.len() > 0:
        ir_global_map_value_types.insert(gname, global_map_value_type)
    if is_threadlocal:
        # per-thread storage: no shared data slot. record a unique slot and the
        # global's kind so reads/writes route through the tls runtime calls, and
        # so ir_emit_tls_thunks can generate its lazy per-thread initializer.
        # assign the slot once so re-processing the same global (across emission
        # passes) can never hand two access sites different slots.
        if not ir_threadlocal_slots.contains_key(gname):
            ir_threadlocal_slots.insert(gname, ir_next_tls_slot)
            ir_next_tls_slot = ir_next_tls_slot + 1
        ir_threadlocal_kinds.insert(gname, global_type)
        return
    ir_emit("global " + gname + " " + init_val)

# generate the per-thread lazy initializer for each threadlocal global: a
# `() -> kind` thunk that builds the same initial value a plain global would get
# at startup. pith_tls_get_or_init calls it the first time a thread reads the
# global. mirrors the value-building in ir_emit_init_globals, but returns the
# value instead of storing it into a shared slot.
fn ir_emit_tls_thunks(root: Node):
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if cn.kind != "threadlocal":
            continue
        binding := get_node(cn.children[0])
        if not ir_is_binding_kind(binding.kind):
            continue
        gname := ir_binding_name(binding)
        parts := ir_collect_bind_parts(binding)
        mut target := ""
        if parts.type_idx >= 0:
            target = ir_resolve_type_node(parts.type_idx)
        if target.len() == 0:
            target = ir_infer_type(parts.val_idx)
        ir_prepare_func_emission(target)
        ir_emit_func_header("__tlsinit_" + gname, 0, target)
        gtarget := ir_map_init_target(gname, target)
        r := ir_emit_value_for_target(parts.val_idx, gtarget)
        gkind := ir_rc_kind(target)
        if gkind.len() > 0 and gtarget != "tuple" and ir_string_expr_is_borrowed(parts.val_idx):
            ir_rc_retain_reg(r, gkind)
        ir_emit("ret " + r.to_string())
        ir_emit("endfunc")

# read a threadlocal global into dest_r: call the runtime, which returns this
# thread's value (initializing it via the thunk on first access).
fn ir_emit_tls_load(dest_r: Int, name: String):
    slot_r := ir_reg()
    ir_emit("iconst " + slot_r.to_string() + " " + ir_threadlocal_slots[name].to_string())
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __tlsinit_" + name)
    ir_emit("call " + dest_r.to_string() + " pith_tls_get_or_init " + ir_threadlocal_kinds[name] + " 2 " + slot_r.to_string() + " " + fr.to_string())

# write val_r into a threadlocal global for this thread.
fn ir_emit_tls_store(name: String, val_r: Int):
    slot_r := ir_reg()
    ir_emit("iconst " + slot_r.to_string() + " " + ir_threadlocal_slots[name].to_string())
    ir_emit("call " + ir_reg().to_string() + " pith_tls_set void 2 " + slot_r.to_string() + " " + val_r.to_string())

# a name refers to a threadlocal global only when it is a recorded threadlocal
# and not shadowed by a local of the same name in the current function.
fn ir_name_is_threadlocal(name: String) -> Bool:
    return ir_threadlocal_slots.contains_key(name) and not ir_var_regs.contains_key(name)

# emit a load of `name`, routing threadlocal globals through the tls runtime and
# everything else (locals, plain globals) through the normal storage slot. a
# name the enclosing `for` loop bound reads its own loop slot, so the loop
# variable and a function local of the same name stay separate.
fn ir_emit_name_load(dest_r: Int, name: String):
    loop_slot := ir_loop_var_slot(name)
    if loop_slot.len() > 0:
        ir_emit("load " + dest_r.to_string() + " " + loop_slot)
    elif ir_name_is_threadlocal(name):
        ir_emit_tls_load(dest_r, name)
    else:
        ir_emit("load " + dest_r.to_string() + " " + ir_resolve_storage_name(name))

# emit a store of val_r into `name`, routing threadlocal globals through the tls
# runtime and everything else through the normal storage slot. loop variables go
# to their own slot, the same as loads.
fn ir_emit_name_store(name: String, val_r: Int):
    loop_slot := ir_loop_var_slot(name)
    if loop_slot.len() > 0:
        ir_emit("store " + loop_slot + " " + val_r.to_string())
    elif ir_name_is_threadlocal(name):
        ir_emit_tls_store(name, val_r)
    else:
        ir_emit("store " + ir_resolve_storage_name(name) + " " + val_r.to_string())

# load a tracked local's own slot, ignoring any loop variable shadowing it. the
# ARC cleanup addresses the function's storage directly: a `return` inside a
# loop body must release what the local holds, not what the loop variable
# happens to be borrowing at that moment.
fn ir_emit_local_slot_load(dest_r: Int, name: String):
    if ir_name_is_threadlocal(name):
        ir_emit_tls_load(dest_r, name)
    else:
        ir_emit("load " + dest_r.to_string() + " " + ir_resolve_storage_name(name))

fn ir_emit_global_bindings(root: Node):
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if cn.kind == "threadlocal":
            inner := get_node(cn.children[0])
            if ir_is_binding_kind(inner.kind):
                ir_emit_global_binding(inner, true)
        elif ir_is_binding_kind(cn.kind):
            ir_emit_global_binding(cn, false)

# attach the type's destructor to a freshly built struct so its rc
# fields release when the struct dies
fn ir_emit_attach_dtor(struct_r: Int, raw_name: String):
    if not ir_struct_needs_dtor(raw_name):
        return
    sname := ir_struct_base_name(raw_name)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __dtor_" + sname)
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + fr.to_string())

# one destructor per known struct with rc fields: releases each such
# field, then the runtime frees the allocation. every module emits its
# own copy (module prefixing keeps the names distinct), so construction
# sites never need cross-module destructor references.
# one destructor per rc payload kind for owned optionals. an optional that owns
# a struct/list/map/set/bytes/closure payload attaches the matching dtor, which
# releases the payload (slot 1) when the optional tuple dies. release on a null
# payload is a no-op, so no is_some guard is needed — none tuples never carry a
# dtor anyway.
fn ir_emit_optional_dtors():
    kinds := ["struct", "list", "map", "set", "bytes", "closure"]
    for k in kinds:
        ir_emit_func_header("__opt_dtor_" + k, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        vr := ir_reg()
        ir_emit("field " + vr.to_string() + " " + pr.to_string() + " 8 unknown value")
        ir_rc_release_reg(vr, k)
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_emit_struct_dtors():
    for sname in ir_struct_names.keys():
        if sname.index_of("[") >= 0:
            continue
        # boxed enums live in ir_struct_names too but their releasable slots
        # are tagged payloads, not fields — ir_emit_enum_dtors handles them.
        if ir_boxed_enums.contains_key(sname):
            continue
        if not ir_struct_needs_dtor(sname):
            continue
        ir_emit_func_header("__dtor_" + sname, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(sname)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(sname, i)
            ftype := ir_struct_field_type_name(sname, fname)
            fkind := ir_rc_field_kind(ftype)
            if ir_struct_field_is_weak(sname, fname):
                # a weak field holds a bare target pointer, so drop its weak
                # reference rather than a strong one; weak_release(0) is a no-op.
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                rel_r := ir_reg()
                ir_emit("call " + rel_r.to_string() + " pith_struct_weak_release void 1 " + fr.to_string())
            elif fkind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_release_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# one tag-aware destructor per boxed enum with rc payloads: read the tag,
# and for the matching variant release each releasable payload slot. the box
# layout is [tag, payload0, payload1, ...] at offsets 0, 8, 16, mirroring the
# variant allocator and the equality helper.
fn ir_emit_enum_dtors():
    for ename in ir_boxed_enums.keys():
        if not ir_enum_needs_dtor(ename):
            continue
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_func_header("__dtor_" + ename, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        tag_r := ir_reg()
        ir_emit("field " + tag_r.to_string() + " " + pr.to_string() + " 0 int __enum_tag")
        variants := ir_enum_variant_lists[ename].split(",")
        mut vi := 0
        while vi < variants.len():
            vkey := ename + "." + variants[vi]
            if ir_enum_payload_kinds.contains_key(vkey):
                kinds := ir_enum_payload_kinds[vkey].split(",")
                mut has_rc := false
                mut c := 0
                while c < kinds.len():
                    if ir_rc_field_kind(kinds[c]).len() > 0:
                        has_rc = true
                    c = c + 1
                if has_rc:
                    vtag := ir_reg()
                    ir_emit("iconst " + vtag.to_string() + " " + vi.to_string())
                    is_v := ir_reg()
                    ir_emit("eq " + is_v.to_string() + " " + tag_r.to_string() + " " + vtag.to_string())
                    hit_l := ir_label()
                    skip_l := ir_label()
                    ir_emit("brif " + is_v.to_string() + " " + hit_l + " " + skip_l)
                    ir_emit_label(hit_l)
                    mut s := 0
                    while s < kinds.len():
                        rk := ir_rc_field_kind(kinds[s])
                        if rk.len() > 0:
                            slot_r := ir_reg()
                            ir_emit("field " + slot_r.to_string() + " " + pr.to_string() + " " + ((s + 1) * 8).to_string() + " unknown __p" + s.to_string())
                            ir_rc_release_reg(slot_r, rk)
                        s = s + 1
                    ir_emit_label(skip_l)
            vi = vi + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# --- cycle tracer twins ----------------------------------------------------
#
# every destructor that walks traceable children gets a tracer twin: the
# same field walk, but each child is reported to pith_cc_visit instead of
# released. __cc_register_tracers_m<N> pairs each destructor with its twin
# in the runtime's side table, so a future collector can enumerate a dead
# candidate's edges through the destructor pointer the box already carries
# — no per-instance cost, and destructors without a twin (only string,
# bytes or weak slots) correctly read as leaves. inert until a collector
# installs a visitor: an unhooked pith_cc_visit returns immediately.

# tracer twin of __opt_dtor_<kind>, for the payload kinds that are
# traceable children — bytes payloads are leaves and get no twin.
fn ir_emit_optional_tracers():
    kinds := ["struct", "list", "map", "set", "closure"]
    for k in kinds:
        ir_emit_func_header("__opt_trace_" + k, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        vr := ir_reg()
        ir_emit("field " + vr.to_string() + " " + pr.to_string() + " 8 unknown value")
        ir_rc_visit_reg(vr, k)
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# tracer twin of __dtor_<sname>: visit each traceable field. weak fields
# are skipped entirely — they hold no strong count, so they are not edges
# of the ownership graph the collector trial-deletes.
fn ir_emit_struct_tracers():
    for sname in ir_struct_names.keys():
        if sname.index_of("[") >= 0:
            continue
        # boxed enums get their tag-aware twin from ir_emit_enum_tracers.
        if ir_boxed_enums.contains_key(sname):
            continue
        if not ir_struct_needs_dtor(sname):
            continue
        if not ir_struct_needs_tracer(sname):
            continue
        ir_emit_func_header("__cc_trace_" + sname, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(sname)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(sname, i)
            ftype := ir_struct_field_type_name(sname, fname)
            fkind := ir_rc_field_kind(ftype)
            if not ir_struct_field_is_weak(sname, fname) and ir_trace_kind_enabled(fkind):
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_visit_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# tracer twin of a boxed enum's __dtor_<ename>: the same tag dispatch,
# visiting the matching variant's traceable payload slots.
fn ir_emit_enum_tracers():
    for ename in ir_boxed_enums.keys():
        if not ir_enum_needs_tracer(ename):
            continue
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_func_header("__cc_trace_" + ename, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        tag_r := ir_reg()
        ir_emit("field " + tag_r.to_string() + " " + pr.to_string() + " 0 int __enum_tag")
        variants := ir_enum_variant_lists[ename].split(",")
        mut vi := 0
        while vi < variants.len():
            vkey := ename + "." + variants[vi]
            if ir_enum_payload_kinds.contains_key(vkey):
                kinds := ir_enum_payload_kinds[vkey].split(",")
                mut has_trace := false
                mut c := 0
                while c < kinds.len():
                    if ir_trace_kind_enabled(ir_rc_field_kind(kinds[c])):
                        has_trace = true
                    c = c + 1
                if has_trace:
                    vtag := ir_reg()
                    ir_emit("iconst " + vtag.to_string() + " " + vi.to_string())
                    is_v := ir_reg()
                    ir_emit("eq " + is_v.to_string() + " " + tag_r.to_string() + " " + vtag.to_string())
                    hit_l := ir_label()
                    skip_l := ir_label()
                    ir_emit("brif " + is_v.to_string() + " " + hit_l + " " + skip_l)
                    ir_emit_label(hit_l)
                    mut s := 0
                    while s < kinds.len():
                        rk := ir_rc_field_kind(kinds[s])
                        if ir_trace_kind_enabled(rk):
                            slot_r := ir_reg()
                            ir_emit("field " + slot_r.to_string() + " " + pr.to_string() + " " + ((s + 1) * 8).to_string() + " unknown __p" + s.to_string())
                            ir_rc_visit_reg(slot_r, rk)
                        s = s + 1
                    ir_emit_label(skip_l)
            vi = vi + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# one equality helper per boxed enum: same pointer or same tag with
# equal payloads. string payloads compare by content and nested boxed
# enums recurse; struct payloads keep pointer identity.
# one destructor per rc-bearing tuple signature seen in this module.
# emitted after the bodies, since tuple shapes are only discovered at
# their literal sites. mirrors ir_emit_struct_dtors, keyed by the
# structural signature instead of a declared name.
fn ir_emit_tuple_dtors():
    for sig in ir_tuple_dtor_sigs:
        ir_emit_func_header(ir_tuple_dtor_name(sig), 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        mut i := 0
        while i < sig.len():
            kind := ir_tuple_dtor_code_kind(sig[i])
            if kind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown __tuple_" + i.to_string())
                ir_rc_release_reg(fr, kind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# tracer twin of a tuple destructor: visit the traceable elements. keyed
# and ordered like ir_emit_tuple_dtors — the signatures exist only after
# the bodies emitted their tuple literals.
fn ir_emit_tuple_tracers():
    for sig in ir_tuple_dtor_sigs:
        if not ir_tuple_sig_has_trace(sig):
            continue
        ir_emit_func_header(ir_tuple_tracer_name(sig), 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        mut i := 0
        while i < sig.len():
            kind := ir_tuple_dtor_code_kind(sig[i])
            if ir_trace_kind_enabled(kind):
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown __tuple_" + i.to_string())
                ir_rc_visit_reg(fr, kind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_emit_enum_eq_fns():
    for ename in ir_boxed_enums.keys():
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_func_header("__enum_eq_" + ename, 2, "bool")
        ir_emit("param a")
        ir_emit("param b")
        ra := ir_reg()
        ir_emit("load " + ra.to_string() + " a")
        rb := ir_reg()
        ir_emit("load " + rb.to_string() + " b")
        true_l := ir_label()
        false_l := ir_label()
        check_l := ir_label()
        same_r := ir_reg()
        ir_emit("eq " + same_r.to_string() + " " + ra.to_string() + " " + rb.to_string())
        ir_emit("brif " + same_r.to_string() + " " + true_l + " " + check_l)
        ir_emit_label(check_l)
        ta := ir_reg()
        ir_emit("field " + ta.to_string() + " " + ra.to_string() + " 0 int __enum_tag")
        tb := ir_reg()
        ir_emit("field " + tb.to_string() + " " + rb.to_string() + " 0 int __enum_tag")
        tags_r := ir_reg()
        ir_emit("eq " + tags_r.to_string() + " " + ta.to_string() + " " + tb.to_string())
        # only payload variants need slot comparison; for the rest an
        # equal tag is the whole story
        variants := ir_enum_variant_lists[ename].split(",")
        mut vi := 0
        mut chain_l := ir_label()
        ir_emit("brif " + tags_r.to_string() + " " + chain_l + " " + false_l)
        while vi < variants.len():
            vkey := ename + "." + variants[vi]
            if ir_enum_payload_kinds.contains_key(vkey):
                ir_emit_label(chain_l)
                chain_l = ir_label()
                vtag := ir_reg()
                ir_emit("iconst " + vtag.to_string() + " " + vi.to_string())
                is_v := ir_reg()
                ir_emit("eq " + is_v.to_string() + " " + ta.to_string() + " " + vtag.to_string())
                slots_l := ir_label()
                ir_emit("brif " + is_v.to_string() + " " + slots_l + " " + chain_l)
                ir_emit_label(slots_l)
                kinds := ir_enum_payload_kinds[vkey].split(",")
                mut k := 0
                while k < kinds.len():
                    fa := ir_reg()
                    ir_emit("field " + fa.to_string() + " " + ra.to_string() + " " + ((k + 1) * 8).to_string() + " unknown __p" + k.to_string())
                    fb := ir_reg()
                    ir_emit("field " + fb.to_string() + " " + rb.to_string() + " " + ((k + 1) * 8).to_string() + " unknown __p" + k.to_string())
                    cmp_r := ir_reg()
                    if kinds[k] == "string":
                        ir_emit_call2(cmp_r, "__str_eq", "bool", fa, fb)
                    elif ir_boxed_enums.contains_key(kinds[k]):
                        ir_emit_call2(cmp_r, "__enum_eq_" + kinds[k], "bool", fa, fb)
                    else:
                        ir_emit("eq " + cmp_r.to_string() + " " + fa.to_string() + " " + fb.to_string())
                    next_slot_l := ir_label()
                    ir_emit("brif " + cmp_r.to_string() + " " + next_slot_l + " " + false_l)
                    ir_emit_label(next_slot_l)
                    k = k + 1
                ir_emit("jmp " + true_l)
            vi = vi + 1
        ir_emit_label(chain_l)
        ir_emit("jmp " + true_l)
        ir_emit_label(false_l)
        f_r := ir_reg()
        ir_emit("iconst " + f_r.to_string() + " 0")
        ir_emit("ret " + f_r.to_string())
        ir_emit_label(true_l)
        t_r := ir_reg()
        ir_emit("iconst " + t_r.to_string() + " 1")
        ir_emit("ret " + t_r.to_string())
        ir_emit("endfunc")

# a global whose initializer is a bare literal that ir_emit_global_binding can
# inline gets its value through the declaration; anything else — calls,
# operators, interpolation, collection literals with elements — must run at
# startup. only the literal kinds ir_emit_global_binding actually inlines (a
# positive int, a string, a bool) count as inlined here. a float literal and a
# negative/unary literal are NOT inlined there (the declaration would zero them),
# so they must run at startup like any other computed initializer.
fn ir_global_needs_runtime_init(cn: Node) -> Bool:
    parts := ir_collect_bind_parts(cn)
    if parts.val_idx < 0:
        return false
    vk := get_node(parts.val_idx).kind
    if vk == "int_lit" or vk == "bool_lit" or vk == "true" or vk == "false":
        return false
    if vk == "string_lit" or vk == "string" or vk == "str_lit":
        return false
    return true

fn ir_emit_init_globals(root: Node):
    mut has_runtime_inits := false
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if ir_is_binding_kind(cn.kind) and ir_global_needs_runtime_init(cn):
            has_runtime_inits = true
    if not has_runtime_inits:
        return

    ir_emit_func_header("__init_globals", 0, "int")
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if ir_is_binding_kind(cn.kind) and ir_global_needs_runtime_init(cn):
            gname := ir_binding_name(cn)
            parts := ir_collect_bind_parts(cn)
            mut target := ""
            if parts.type_idx >= 0:
                target = ir_resolve_type_node(parts.type_idx)
            if target.len() == 0:
                target = ir_infer_type(parts.val_idx)
            gtarget := ir_map_init_target(gname, target)
            r := ir_emit_value_for_target(parts.val_idx, gtarget)
            gkind := ir_rc_kind(target)
            if gkind.len() > 0 and gtarget != "tuple" and ir_string_expr_is_borrowed(parts.val_idx):
                ir_rc_retain_reg(r, gkind)
            ir_emit("store " + gname + " " + r.to_string())
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")

fn ir_emit_top_level_items(root_idx: Int, root: Node):
    mut test_ord := 0
    for item_idx in ir_root_items(root_idx):
        actual_node := get_node(item_idx)
        if actual_node.kind == "fn" or actual_node.kind == "fn_decl":
            if ir_has_generic_params(actual_node):
                continue
            if not (ir_emit_tests and actual_node.value == "main"):
                ir_func(item_idx)
        elif actual_node.kind == "test_decl":
            if ir_emit_tests:
                ir_emit_test_func(item_idx, test_ord)
                test_ord = test_ord + 1
        elif actual_node.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual_node)
            ir_emit_impl_methods(actual_node, impl_type)
    if ir_emit_tests:
        ir_emit_test_main(root_idx)

fn ir_append_lambda_bodies():
    bodies: List[String] := ir_lambda_bodies
    ir_builder_append_lines(bodies)

fn ir_preseed_result_error_strings():
    builtin_names := "parse_int,file_open_read,file_open_write,file_open_append,byte_buffer_write,byte_buffer_write_string_utf8,byte_buffer_write_byte,file_write,file_write_bytes,tcp_connect,tcp_listen,tcp_accept,tcp_write,tcp_write_bytes,process_spawn,process_spawn_argv,process_output_argv,process_write,process_write_bytes,crypto_x25519_keygen,write_file,append_file,write_file_bytes,append_file_bytes,read_file,exec_output,dns_resolve,bytes_to_string_utf8,bytes_substring_utf8,file_read,tcp_read,process_read,process_read_err,read_file_bytes,b64_decode,from_hex,file_read_bytes,tcp_read_bytes,process_read_bytes,process_read_err_bytes,crypto_x25519_public_key,crypto_x25519_shared_secret,crypto_aes_128_gcm_seal,crypto_aes_128_gcm_open,crypto_chacha20_poly1305_seal,crypto_chacha20_poly1305_open,crypto_sign_rsa_pss_sha256_pkcs8,crypto_sign_rsa_pkcs1_sha256_pkcs8,crypto_sign_ed25519_pkcs8,crypto_sign_ecdsa_p256_sha256_pkcs8,crypto_blake2b,crypto_argon2id,zstd_compress,zstd_decompress".split(",")
    for builtin_name in builtin_names:
        ir_str(builtin_name + " failed")

fn ir_collect_root_import_metadata(root_idx: Int):
    ir_import_renames = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    for root, i in ir_preloaded_import_roots:
        ir_collect_preloaded_root_metadata(root, ir_preloaded_import_paths[i])

fn ir_collect_root_phase_one_metadata(root_idx: Int):
    ir_func_returns.clear()
    ir_type_aliases = {}
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}

    for root, preload_i in ir_preloaded_import_roots:
        mut module_path := ""
        if preload_i < ir_preloaded_import_paths.len():
            module_path = ir_preloaded_import_paths[preload_i]
        for item_idx in ir_root_items(root):
            node := get_node(item_idx)
            if ir_is_fn_decl_kind(node.kind):
                ir_record_function_return_as(ir_import_target_name(module_path, node.value), node, module_path)
        ir_collect_generic_function_decls_from_root(root, module_path)

    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        ir_collect_import_item(node)
        if node.kind == "type_alias":
            target := ir_type_alias_target(node)
            if target.len() > 0:
                ir_type_aliases.insert(node.value, target)
        elif ir_is_fn_decl_kind(node.kind):
            ir_record_function_return(node)
            if ir_has_generic_params(node):
                ir_record_generic_function_decl(item_idx, node, "")

fn ir_collect_root_phase_two_metadata(root_idx: Int):
    ir_local_struct_names = []
    ir_reset_dtor_memo()
    ir_tracer_memo = {}
    ir_struct_names.clear()
    ir_struct_field_lookup.clear()
    ir_struct_field_index_lookup.clear()
    ir_struct_decl_nodes.clear()
    ir_impl_methods.clear()
    ir_impl_method_owner.clear()
    ir_interface_decl_index.clear()
    ir_assoc_bindings.clear()
    ir_type_assoc_names.clear()
    ir_register_known_import_structs()

    # impl blocks (and the interfaces whose defaults they inherit) are
    # collected from every module in the build, not just direct imports: a
    # method can live in an impl a module away from both the struct's
    # declaration and the call site, and a call the checker resolved must
    # have a symbol to lower to. struct layout collection stays scoped to
    # direct imports. falls back to the direct list when no full graph was
    # provided.
    mut method_roots := ir_all_module_roots
    mut method_paths := ir_all_module_paths
    if method_roots.len() == 0:
        method_roots = ir_preloaded_import_roots
        method_paths = ir_preloaded_import_paths

    # index every interface (imports + root) before any impl signatures are
    # collected, so an impl can find its interface's defaults regardless of
    # declaration order across modules
    mut iface_i := 0
    while iface_i < method_roots.len():
        ir_index_interfaces_in_root(method_roots[iface_i])
        ir_collect_assoc_bindings_in_root(method_roots[iface_i])
        iface_i = iface_i + 1
    ir_index_interfaces_in_root(root_idx)
    ir_collect_assoc_bindings_in_root(root_idx)

    mut preload_i := 0
    while preload_i < ir_preloaded_import_roots.len():
        ir_collect_struct_decls(ir_preloaded_import_roots[preload_i], false)
        preload_i = preload_i + 1

    mut impl_i := 0
    while impl_i < method_roots.len():
        ir_collect_impl_methods(method_roots[impl_i], method_paths[impl_i])
        impl_i = impl_i + 1

    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if node.kind == "struct_decl" or node.kind == "struct":
            ir_collect_struct_decl(item_idx, node, true)
        elif node.kind == "enum_decl" or node.kind == "enum":
            ir_collect_enum_decl(node, true)
        elif node.kind == "impl_decl":
            ir_collect_impl_method_signatures(node, "")

    ir_register_alias_structs(root_idx)

# the module's tracer registration function: __cc_register_tracers_m<N>,
# module-suffixed like ir_tuple_dtor_name so every module carries its own
# copy for its own destructor copies. main's prelude calls the root
# module's; the driver injects the imported modules' calls next to the
# init-globals calls. always emitted — possibly empty — so that prelude
# call never dangles.
fn ir_cc_register_fn_name() -> String:
    return "__cc_register_tracers_m" + ir_module_count.to_string()

# one funcref pair + registration call: the runtime side table maps the
# destructor's address to its tracer twin's.
fn ir_emit_cc_register_pair(dtor_name: String, trace_name: String):
    dr := ir_reg()
    ir_emit("funcref " + dr.to_string() + " " + dtor_name)
    tr := ir_reg()
    ir_emit("funcref " + tr.to_string() + " " + trace_name)
    ir_emit_call2(ir_reg(), "pith_cc_register_tracer", "void", dr, tr)

# emitted after every destructor family, since the tuple and generic
# instance key sets are only complete once all bodies are. the pair loops
# repeat the emitters' own gates so exactly the destructors with a twin
# are registered.
fn ir_emit_cc_register_tracers():
    ir_emit_func_header(ir_cc_register_fn_name(), 0, "int")
    opt_kinds := ["struct", "list", "map", "set", "closure"]
    for k in opt_kinds:
        ir_emit_cc_register_pair("__opt_dtor_" + k, "__opt_trace_" + k)
    for sname in ir_struct_names.keys():
        if sname.index_of("[") >= 0:
            continue
        if ir_boxed_enums.contains_key(sname):
            continue
        if not ir_struct_needs_dtor(sname):
            continue
        if not ir_struct_needs_tracer(sname):
            continue
        ir_emit_cc_register_pair("__dtor_" + sname, "__cc_trace_" + sname)
    for ename in ir_boxed_enums.keys():
        if not ir_enum_needs_tracer(ename):
            continue
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_cc_register_pair("__dtor_" + ename, "__cc_trace_" + ename)
    for sig in ir_tuple_dtor_sigs:
        if not ir_tuple_sig_has_trace(sig):
            continue
        ir_emit_cc_register_pair(ir_tuple_dtor_name(sig), ir_tuple_tracer_name(sig))
    for sym in ir_generic_dtor_base.keys():
        if not ir_generic_instance_needs_tracer(sym):
            continue
        ir_emit_cc_register_pair("__dtor_" + sym, "__cc_trace_" + sym)
    zr := ir_reg()
    ir_emit("iconst " + zr.to_string() + " 0")
    ir_emit("ret " + zr.to_string())
    ir_emit("endfunc")

fn ir_emit_root_module(root_idx: Int, root: Node):
    ir_generic_dtor_base = {}
    ir_generic_dtor_args = {}
    ir_emit_global_bindings(root)
    ir_emit_tls_thunks(root)
    ir_emit_init_globals(root)
    ir_emit_optional_dtors()
    ir_emit_struct_dtors()
    ir_emit_enum_dtors()
    ir_emit_optional_tracers()
    ir_emit_struct_tracers()
    ir_emit_enum_tracers()
    ir_emit_enum_eq_fns()
    # pre-register all impl method specializations across the module so that
    # an earlier impl's specialized body can dispatch to a later impl's
    # specialized version (e.g. MapIter[FilterIter[..], ..].next calling
    # FilterIter[Range, Int].next)
    ir_preregister_all_impl_specializations(root_idx, root)
    ir_emit_top_level_items(root_idx, root)
    # tuple destructors last: their shapes are only known once every
    # tuple literal in the module body has been emitted.
    ir_emit_tuple_dtors()
    ir_emit_tuple_tracers()
    ir_emit_generic_specializations()
    # per-instance destructors for generic structs built via a backend
    # constructor call: emitted after the specializations, since those bodies
    # are where such constructions (and their attaches) are recorded.
    ir_emit_generic_instance_dtors()
    ir_emit_generic_instance_tracers()
    ir_append_lambda_bodies()
    # tuple cascade helpers last of all: every body (top level, specializations,
    # generic instance dtors and lambdas) has registered its signatures by now.
    ir_emit_tuple_cascade_helpers()
    # tracer registration after every destructor family above, so its pair
    # list covers the tuple and generic-instance twins too.
    ir_emit_cc_register_tracers()

# Walk every impl_decl in the current root and register specialization name
# entries into ir_impl_method_specializations without emitting bodies yet.
# Then ir_emit_impl_methods's per-impl loop can emit bodies safely; any
# cross-impl dispatch lookup will already find the right specialized symbol.
fn ir_preregister_all_impl_specializations(root_idx: Int, root: Node):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual_node := node
        if node.kind == "pub":
            actual_node = get_node(node.children[0])
        if actual_node.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual_node)
            if impl_type.len() > 0:
                ir_register_impl_method_specialization_names(actual_node, impl_type)

fn ir_register_impl_method_specialization_names(impl_node: Node, impl_type: String):
    if not has_generic_declaration(impl_type):
        return
    sdecl := get_node(get_generic_declaration_index(impl_type))
    struct_params := collect_generic_parameter_names(sdecl)
    if struct_params.len() == 0:
        return
    instance_tids := struct_instance_tids
    for inst_tid in instance_tids:
        if struct_instance_base_name[inst_tid] != impl_type:
            continue
        if not struct_instance_type_args.contains_key(inst_tid):
            continue
        arg_tids := decode_tid_list(struct_instance_type_args[inst_tid])
        mut arg_names: List[String] := []
        for at in arg_tids:
            arg_names.push(ir_type_from_tid(at))
        instance_type_name := get_type_name(inst_tid)
        for child in impl_node.children:
            child_node := get_node(child)
            if child_node.kind == "fn_decl":
                ir_register_one_specialized_method_name(child_node, impl_type, instance_type_name, arg_names)

fn ir_finish_module_emit():
    ir_module_count = ir_module_count + 1
    ir_preloaded_import_roots = []
    ir_preloaded_import_paths = []
    ir_emit_tests = false
    ir_emitting_test_func = false

# --- main entry ---
#
# per module: intern every string first (the table heads the output),
# collect import metadata so names resolve, then emit globals and
# functions in declaration order.
pub fn emit_ir(root_idx: Int) -> String:
    ir_reset()
    ir_tuple_walk_root = root_idx

    root := get_node(root_idx)
    mut preload_i := 0
    while preload_i < ir_preloaded_import_roots.len():
        ir_collect_strings(ir_preloaded_import_roots[preload_i])
        ir_collect_struct_field_strings(ir_preloaded_import_roots[preload_i])
        preload_i = preload_i + 1
    ir_collect_strings(root_idx)
    ir_collect_struct_field_strings(root_idx)
    ir_preseed_result_error_strings()
    # test names live on the test_decl node, not in a string literal the collector
    # would see, so intern them here — before the table is emitted — for the test
    # main's per-test report line.
    if ir_emit_tests:
        for test_idx in ir_collect_test_decls(root_idx):
            _name_id := ir_str(get_node(test_idx).value)
    ir_emit_string_table()

    # collect aliases first so both type and callable metadata can resolve
    # through the same table.
    ir_collect_root_import_metadata(root_idx)
    ir_collect_root_phase_one_metadata(root_idx)
    ir_collect_root_phase_two_metadata(root_idx)

    ir_lambda_count = 0
    ir_lambda_bodies = []
    ir_emit_root_module(root_idx, root)
    lines := ir_builder_lines()
    ir_finish_module_emit()
    return lines.join(chr(10))
