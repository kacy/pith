# a label that names the parameter in its position is accepted, alone or
# mixed with unlabeled arguments, on functions, methods and generics.
struct Counter:
    n: Int

impl Counter:
    fn add(by: Int, times: Int) -> Int:
        return self.n + by * times

fn scaled(a: Int, b: Int) -> Int:
    return a * 10 + b

fn first[T](a: T, b: T) -> T:
    return a

fn main():
    print("{scaled(a: 5, b: 1)}")
    print("{scaled(5, b: 2)}")
    c := Counter(1)
    print("{c.add(by: 3, times: 2)}")
    print("{first(a: 7, b: 8)}")
