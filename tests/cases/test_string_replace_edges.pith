import std.strings as strings

# replace over inputs shorter than the needle. an empty haystack used to
# read one byte past the end of the string and abort the process.
fn main():
    print("[{"".replace("&", "&amp;")}]")
    print("[{"".replace("ab", "X")}]")
    print("[{"a".replace("abc", "X")}]")
    print("[{"ab".replace("abc", "X")}]")
    print("[{"abc".replace("abc", "X")}]")
    print("[{"".replace("", "X")}]")
    print("[{"aaa".replace("a", "")}]")
    print("[{"banana".replace("na", "NA")}]")
    # replace_n with an explicit count exercises the bounded path directly,
    # including a multi-byte tail that must survive the piece-join rebuild.
    print("[{strings.replace_n("banana", "a", "X", 2)}]")
    print("[{strings.replace_n("café-café", "-", " | ", 9)}]")
