# graph_search: breadth-first search over an adjacency map.
#
# finds the route with the fewest stops between stations on a small metro
# map. the graph is a Map from each station to its neighbours; the search
# keeps a queue of stations to visit and, for each station it reaches, the
# one it came from, so the route can be read back from the destination.

fn metro() -> Map[String, List[String]]:
    mut lines: Map[String, List[String]] := {}
    connect(lines, ["harbor", "market", "center", "museum", "university"])
    connect(lines, ["airport", "center", "stadium"])
    connect(lines, ["market", "old town", "stadium", "zoo"])
    return lines

# a line is a chain of stations, each linked both ways to the next
fn connect(lines: Map[String, List[String]], stops: List[String]):
    for index in 1..stops.len():
        link(lines, stops[index - 1], stops[index])
        link(lines, stops[index], stops[index - 1])

fn link(lines: Map[String, List[String]], origin: String, destination: String):
    if not lines.contains_key(origin):
        lines[origin] = []
    lines[origin].push(destination)

fn shortest_route(lines: Map[String, List[String]], start: String, goal: String) -> List[String]?:
    mut came_from: Map[String, String] := {start: start}
    mut queue := [start]
    mut next_index := 0
    while next_index < queue.len():
        station := queue[next_index]
        next_index += 1
        if station == goal:
            break
        for neighbour in lines.get(station).unwrap_or([]):
            if not came_from.contains_key(neighbour):
                came_from[neighbour] = station
                queue.push(neighbour)

    if not came_from.contains_key(goal):
        return none
    mut route := [goal]
    while route[route.len() - 1] != start:
        route.push(came_from[route[route.len() - 1]])
    route.reverse()
    return route

fn main():
    lines := metro()
    print("{lines.len()} stations")
    trips := [("harbor", "zoo"), ("airport", "university"), ("museum", "museum"), ("zoo", "library")]
    for trip in trips:
        if let route = shortest_route(lines, trip.0, trip.1):
            stops := route.len() - 1
            print("{trip.0} to {trip.1}, {stops} stop(s): {route.join(" -> ")}")
        else:
            print("{trip.0} to {trip.1}: no route")
