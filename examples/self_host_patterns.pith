# patterns from the self-hosted compiler: an arena of nodes and a scope chain.
#
# the pith compiler is written in pith, and it keeps its syntax tree in a
# flat list. a node refers to its children by their index in the list rather
# than holding them, which keeps the nodes small and leaves no reference
# cycles to break. scopes work the same way: each scope stores the index of
# its parent. this example builds and evaluates `add(1 + 2, x)` with those
# two structures, and caches each node's value in an Int-keyed map.

# children are indices into the arena, not nodes
enum Node:
    Number(Int)
    Name(String)
    Plus(Int, Int)
    Call(String, List[Int])

struct Arena:
    nodes: List[Node]

impl Arena:
    # returns the new node's index, which is how everything else refers to it
    fn add(node: Node) -> Int:
        self.nodes.push(node)
        return self.nodes.len() - 1

    fn render(index: Int) -> String:
        return match self.nodes[index]:
            Node.Number(value) => value.to_string()
            Node.Name(name) => name
            Node.Plus(left, right) => "({self.render(left)} + {self.render(right)})"
            Node.Call(name, arguments) => "{name}({arguments.map(fn(argument: Int) => self.render(argument)).join(", ")})"

struct Scope:
    parent: Int
    names: Map[String, Int]

# walks outward through parent indices until a scope defines the name
fn lookup(scopes: List[Scope], scope_index: Int, name: String) -> Int?:
    if scope_index < 0:
        return none
    scope := scopes[scope_index]
    if let value = scope.names.get(name):
        return value
    return lookup(scopes, scope.parent, name)

fn evaluate(arena: Arena, index: Int, scopes: List[Scope], scope_index: Int, cache: Map[Int, Int]) -> Int!:
    if let cached = cache.get(index):
        return cached
    mut value := 0
    match arena.nodes[index]:
        Node.Number(number) =>
            value = number
        Node.Name(name) =>
            value = lookup(scopes, scope_index, name)?
        Node.Plus(left, right) =>
            value = evaluate(arena, left, scopes, scope_index, cache)! + evaluate(arena, right, scopes, scope_index, cache)!
        Node.Call(_, arguments) =>
            for argument in arguments:
                value += evaluate(arena, argument, scopes, scope_index, cache)!
    cache[index] = value
    return value

fn main():
    arena := Arena(nodes: [])
    one := arena.add(Node.Number(1))
    two := arena.add(Node.Number(2))
    sum := arena.add(Node.Plus(one, two))
    x := arena.add(Node.Name("x"))
    root := arena.add(Node.Call("add", [sum, x]))
    print("expression: {arena.render(root)}, {arena.nodes.len()} nodes")

    # the module scope, a function inside it, and a block inside that
    scopes := [
        Scope(parent: -1, names: {"x": 40}),
        Scope(parent: 0, names: {"y": 1}),
        Scope(parent: 1, names: {}),
    ]
    for name in ["y", "x", "z"]:
        print("lookup {name} from the innermost scope: {lookup(scopes, 2, name)}")

    mut cache: Map[Int, Int] := {}
    print("value: {evaluate(arena, root, scopes, 2, cache) catch -1}")
    print("cached nodes: {cache.len()}, node {sum} is {cache[sum]}")

    # a name that no scope defines makes evaluation fail rather than guess
    z := arena.add(Node.Name("z"))
    missing := arena.add(Node.Call("add", [one, z]))
    result := evaluate(arena, missing, scopes, 2, cache)
    print("evaluating {arena.render(missing)} fails: {result.is_err}")
