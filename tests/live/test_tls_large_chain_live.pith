# A certificate chain larger than one record's plaintext ceiling (2^14 bytes)
# must fragment across handshake records in both directions: the server
# splitting its flight on the wire, and the client reassembling messages that
# span records. The fixture leaf carries seven hundred subject alternative
# names, putting the Certificate message alone well past the ceiling. Both
# protocol versions are exercised; the 1.2 arm drives the fallback's plaintext
# flight writer, the 1.3 arm the sealed one.

import std.net.tls as tls
import std.net.tcp as tcp

CERT := "tests/live/fixtures/bigchain-leaf.crt"
KEY := "tests/live/fixtures/bigchain-leaf.key"
CA := "tests/live/fixtures/keyusage-root.crt"

fn choose_port(start: Int) -> Int!:
    mut port := start
    while port < start + 40:
        probe := tcp.tcp_listen("127.0.0.1", port)
        if probe.is_ok:
            tcp.tcp_close(probe.ok)
            return port
        port = port + 1
    fail "no free port"

fn serve_once(listener: tls.Listener):
    conn := listener.accept() catch:
        return
    msg := conn.read(64) catch ""
    conn.write_all("echo:" + msg) catch 0
    conn.close()

fn run_case(label: String, port: Int, cap_to_tls12: Bool):
    server_cfg := tls.server_config(CERT, KEY) catch:
        print(label + ": server-config-error")
        return
    listener := tls.listen("127.0.0.1", port, server_cfg) catch:
        print(label + ": listen-error")
        server_cfg.close()
        return
    spawn serve_once(listener)
    mut cfg := tls.client_config_with_ca_file(CA) catch:
        print(label + ": client-config-error")
        return
    if cap_to_tls12:
        cfg = cfg.require_tls12()
    conn := tls.dial_with_config("127.0.0.1", port, "localhost", cfg) catch:
        print(label + ": handshake-failed")
        cfg.close()
        return
    conn.write_all("big") catch 0
    reply := conn.read(64) catch ""
    print(label + ": " + conn.version_name() + " certs=" + conn.peer_certificate_count().to_string() + " " + reply)
    conn.close()
    cfg.close()
    listener.close()
    server_cfg.close()

fn main() -> Int!:
    run_case("large-chain 1.3", choose_port(44530)!, false)
    run_case("large-chain 1.2", choose_port(44570)!, true)
    return 0
