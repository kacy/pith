# a user-defined lazy map adapter on the associated-type iterator protocol: a
# struct with an associated Item and a next() -> Item?, wrapping a source
# iterator and a closure. confirms a user can define their own adapter against
# the stdlib Iterator interface, not just the ones std.iter ships. next() pulls
# from self.src.next(), unwraps with n.value(), and applies the closure field.

from std.iter import Range, to_list, Iterator

struct MapIter[I, U]:
    src: I
    f: fn(I.Item) -> U

impl Iterator for MapIter:
    type Item = U
    fn next() -> U?:
        n := self.src.next()
        if n == none:
            return none
        return self.f(n.value())

fn map_iter[I: Iterator, U](src: I, f: fn(I.Item) -> U) -> MapIter[I, U]:
    return MapIter[I, U](src, f)

fn main():
    out := to_list(map_iter(Range(0, 5), fn(x: Int) => x * 10))
    print("len: {out.len()}")
    mut s := ""
    for x in out:
        s = s + x.to_string() + " "
    print("vals: {s}")
