# a struct whose method carries its own type parameter, imported by
# test_generic_impl_methods. the specialization a call site queues is named
# after the module-qualified method symbol, so this exercises the cross-module
# half of the dispatch.

# Tagger prefixes any rendered value with a fixed tag.
pub struct Tagger:
    pub tag: String

impl Tagger:
    # render one value of any type under this tagger's tag.
    pub fn render[T](value: T) -> String:
        return self.tag + "=" + value.to_string()
