# generic interfaces: an interface with a type parameter, used as a bound.
#
# `Ordered[T]` says a type can be compared with a T. a bound written
# `T: Ordered[T]` asks for a type that compares with itself, so one
# `earliest` function finds the lowest release version and the leftmost
# point on a map. the bound can sit on a struct too, so an Earliest[T] only
# exists for a T that has an order.

interface Ordered[T]:
    fn before(other: T) -> Bool

struct Version:
    major: Int
    minor: Int
    patch: Int

impl Ordered[Version] for Version:
    fn before(other: Version) -> Bool:
        if self.major != other.major:
            return self.major < other.major
        if self.minor != other.minor:
            return self.minor < other.minor
        return self.patch < other.patch

struct Point:
    x: Int
    y: Int

# left to right, then bottom to top
impl Ordered[Point] for Point:
    fn before(other: Point) -> Bool:
        if self.x != other.x:
            return self.x < other.x
        return self.y < other.y

struct Earliest[T: Ordered[T]]:
    value: T
    compared: Int

fn earliest[T: Ordered[T]](items: List[T]) -> Earliest[T]:
    mut best := items[0]
    for item in items:
        if item.before(best):
            best = item
    return Earliest(value: best, compared: items.len())

fn main():
    releases := [Version(2, 1, 0), Version(1, 9, 4), Version(1, 10, 0), Version(1, 9, 12)]
    oldest := earliest(releases)
    print("oldest of {oldest.compared} releases: {oldest.value.major}.{oldest.value.minor}.{oldest.value.patch}")

    stops := [Point(x: 4, y: 1), Point(x: -2, y: 7), Point(x: -2, y: 3), Point(x: 0, y: 0)]
    leftmost := earliest(stops)
    print("leftmost of {leftmost.compared} stops: x {leftmost.value.x}, y {leftmost.value.y}")
