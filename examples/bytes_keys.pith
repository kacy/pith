# bytes_keys: a set and a map keyed by raw bytes.
#
# counts the opcodes in a stream of protocol frames. a Set[Bytes] or a
# Map[Bytes, V] compares keys by content, so a frame read off the wire finds
# the entry stored under an equal key built somewhere else, and the container
# keeps its own copy of each key.

import std.bytes as bytes

# frames as a protocol layer hands them over: raw bytes, some repeated
fn frames() -> List[Bytes]:
    return ["PING", "DATA", "PING", "PONG", "DATA", "DATA"].map(fn(op: String) => bytes.from_string_utf8(op))

fn main() -> Int!:
    names: Map[Bytes, String] := {}
    names[bytes.from_string_utf8("PING")] = "ping"
    names[bytes.from_string_utf8("PONG")] = "pong"

    mut seen: Set[Bytes] := {}
    mut counts: Map[Bytes, Int] := {}
    for frame in frames():
        counts[frame] = counts.get(frame).unwrap_or(0) + 1
        label := names.get(frame).unwrap_or("unknown")
        if seen.contains(frame):
            print("repeat {label}")
        else:
            seen.add(frame)
            print("first  {label}")

    print("")
    print("distinct opcodes: {seen.len()}")

    # a key assembled piece by piece still finds the entry
    key := bytes.buffer()
    key.write_string_utf8("DA")!
    key.write_string_utf8("TA")!
    print("DATA frames: {counts[key.take_bytes()]}")
    print("PING frames: {counts[bytes.from_string_utf8("PING")]}")
    return 0
