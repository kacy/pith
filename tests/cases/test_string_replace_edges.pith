# replace over inputs shorter than the needle. an empty haystack used to
# read one byte past the end of the string and abort the process.
fn main():
    print("[{"".replace("&", "&amp;")}]")
    print("[{"".replace("ab", "X")}]")
    print("[{"a".replace("abc", "X")}]")
    print("[{"ab".replace("abc", "X")}]")
    print("[{"abc".replace("abc", "X")}]")
    print("[{"".replace("", "X")}]")
    print("[{"aaa".replace("a", "")}]")
    print("[{"banana".replace("na", "NA")}]")
