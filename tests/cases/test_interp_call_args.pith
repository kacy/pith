# interpolation of function calls, including calls with string and
# multiple arguments. the escaped quotes around a string argument used
# to mis-lex, making a multi-arg call look like it had one argument.
fn takes(text: String, n: Int) -> Int:
    return text.len() + n

fn add(a: Int, b: Int) -> Int:
    return a + b

fn label(name: String) -> String:
    return "hi " + name

fn main():
    print("plain: {add(2, 3)}")
    print("string arg: {takes(\"abc\", 5)}")
    print("nested: {add(add(1, 2), 3)}")
    print("string result: {label(\"pith\")}")
    print("mixed: {takes(\"xy\", add(1, 1))}")
