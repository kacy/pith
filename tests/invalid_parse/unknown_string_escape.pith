# an escape a string does not define is E243, in a plain string, in the text
# of an interpolated one, and in a string written inside an interpolation.
# they used to keep their backslash without a word: "a\vb" had length 4.
fn main():
    n := 1
    plain := "a\vb"
    around := "x\q{n}y\e"
    inside := "{f("\x41")}"
    print(plain + around + inside)

fn f(s: String) -> String:
    return s
