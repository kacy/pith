# PENDING — issue #927. not registered in tooling/leak_check.sh; it fails.
#
# a generic function body has no rc prologue. an instantiation is emitted
# without the zero-store prologue a concrete body gets and its call results
# come back typed `unknown`, so no heap local or temporary inside it is ever
# released. the same body with the type parameter removed releases all of
# them. a generic struct built by bare name inside such a body is carried
# along with it: the instance never dies, so its destructor never runs either.
#
# measured on this file at PITH_LEAK_ROUNDS 200000 vs 800000:
#   shape 1, a string local in a generic body            18.3 mb -> 65.1 mb
#   shape 2, the same body with the parameter removed      2.7 mb ->  2.8 mb
#   shape 3, a generic instance built inside the body     21.5 mb -> 77.7 mb
#   shape 4, the instance built at the call site instead   2.7 mb ->  2.6 mb
#
# register shapes 1 and 3 in tooling/leak_check.sh once #927 is fixed; shapes
# 2 and 4 are the concrete twins that already pass and are here to show the
# type parameter is the only difference.
import pendingprobe as probe
import std.env as env

struct Holder[T]:
    pub item: T

fn generic_local[T](marker: T, i: Int) -> Int:
    s := "payload-" + i.to_string()
    return s.len()

fn concrete_local(marker: Int, i: Int) -> Int:
    s := "payload-" + i.to_string()
    return s.len()

fn generic_instance[T](v: T) -> Int:
    h := Holder(v)
    return h.item.len()

fn concrete_instance(v: String) -> Int:
    h := Holder(v)
    return h.item.len()

fn main():
    which := env.int_or("SHAPE", 1)
    n := probe.rounds()
    mut i := 0
    mut acc := 0
    while i < n:
        text := "text-" + i.to_string()
        if which == 1:
            acc = acc + generic_local(text, i)
        if which == 2:
            acc = acc + concrete_local(i, i)
        if which == 3:
            acc = acc + generic_instance(text)
        if which == 4:
            acc = acc + concrete_instance(text)
        i = i + 1
    if acc < 0:
        print("unreachable")
    kb := probe.peak_kb()
    print("{kb}")
