# a processing pipeline with a parallel stage: filter, spawn, await, combine.
#
# finds how many primes lie below each requested limit. the first stage
# drops bad requests, the second starts one task per request with spawn so
# the counts run at the same time, and the last awaits them in request order
# and combines the results. awaiting in the order the tasks were started
# keeps the output the same from run to run, whichever task finishes first.

fn is_prime(n: Int) -> Bool:
    if n < 2:
        return false
    mut divisor := 2
    while divisor * divisor <= n:
        if n % divisor == 0:
            return false
        divisor += 1
    return true

fn count_primes_below(limit: Int) -> Int:
    mut count := 0
    for n in 2..limit:
        if is_prime(n):
            count += 1
    return count

fn main():
    requests := [1000, -5, 20000, 50000, 0, 5000]

    # stage 1: keep the requests that make sense
    limits := requests.filter(fn(limit: Int) => limit > 1)
    print("stage 1: {limits.len()} of {requests.len()} requests are valid")

    # stage 2: start every count before waiting on any of them
    mut tasks := []
    for limit in limits:
        tasks.push(spawn count_primes_below(limit))
    print("stage 2: started {tasks.len()} tasks")

    # stage 3: collect in request order and combine
    mut total := 0
    for task, index in tasks:
        count := await task
        total += count
        print("  primes below {limits[index]}: {count}")
    print("stage 3: {total} primes counted in all")
