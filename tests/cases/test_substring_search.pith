# the runtime's substring primitives on the inputs a search gets wrong:
# an empty needle, a needle longer than the haystack, a needle at either
# end, repeated first bytes, a needle sharing a prefix with an earlier
# non-match, and bytes above 0x7f. the expected output was generated by the
# runtime before the search was rewritten (#1099), so it pins the old
# answers byte for byte.

fn show_find(haystack: String, needle: String):
    idx := haystack.index_of(needle)
    last := haystack.last_index_of(needle)
    has := haystack.contains(needle)
    print("[{haystack}] [{needle}] index_of={idx} last_index_of={last} contains={has}")

fn show_split(text: String, delim: String):
    parts := text.split(delim)
    print("[{text}] split [{delim}] -> {parts.len()} parts: {parts.join("|")}")

fn show_replace(text: String, needle: String, to: String):
    out := text.replace(needle, to)
    print("[{text}] replace [{needle}] -> [{to}] = [{out}]")

fn main():
    print("-- empty needle")
    show_find("", "")
    show_find("abc", "")
    show_split("abc", "")
    show_split("", "")
    show_replace("abc", "", "x")

    print("-- needle longer than haystack")
    show_find("", "a")
    show_find("ab", "abc")
    show_split("ab", "abc")
    show_replace("ab", "abc", "x")

    print("-- needle at either end")
    show_find("needle in a haystack", "needle")
    show_find("a haystack ends in a needle", "needle")
    show_find("x", "x")
    show_find("abc", "abc")
    show_find("abc", "c")
    show_find("abc", "a")
    show_split(",a,b,", ",")
    show_split("abcXYabc", "abc")
    show_replace("abcXYabc", "abc", "-")
    show_replace("abc", "abc", "")

    print("-- repeated first bytes")
    show_find("aaaaaaab", "ab")
    show_find("aaaaaaaa", "ab")
    show_find("aaaa", "aa")
    show_find("aaaaaab", "aaaaaab")
    show_find("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "aaaaaab")
    show_split("aaXaaXaa", "aa")
    show_split("a,,b,,,c", ",")
    show_replace("aaaaaaab", "ab", "!")
    show_replace("aaaa", "a", "bb")
    show_replace("aaaa", "aa", "b")
    show_replace("abab", "aba", "X")

    print("-- shared prefix with an earlier non-match")
    show_find("abcabd", "abd")
    show_find("ababac", "abac")
    show_find("ababab", "abac")
    show_find("xxabcxxabcdxx", "abcd")
    show_find("the quick brown fox", "brown fox jumps")
    show_split("abcabdabcabd", "abd")
    show_replace("abcabdabcabd", "abd", "_")
    show_replace("ababac", "abac", "Y")

    print("-- bytes above 0x7f")
    show_find("héllo wörld", "ö")
    show_find("héllo wörld", "wörld")
    show_find("héllo wörld", "é")
    show_find("héllo wörld", "ü")
    show_find("日本語のテキスト", "テキスト")
    show_find("日本語のテキスト", "語の")
    show_split("日本語のテキスト", "の")
    show_replace("héllo wörld", "ö", "oe")
    show_replace("日本語のテキスト", "の", " no ")

    print("-- prefix and suffix")
    abc := "abc"
    for prefix in ["", "ab", "abc", "abcd", "bc"]:
        starts := abc.starts_with(prefix)
        print("[{abc}] starts_with [{prefix}] = {starts}")
    for suffix in ["", "bc", "abc", "zabc", "ab"]:
        ends := abc.ends_with(suffix)
        print("[{abc}] ends_with [{suffix}] = {ends}")

    print("-- the csv and path shapes")
    show_find("user 17, region north", ",")
    show_find("user 17 region north", ",")
    show_find("data//north/./users/../users/17.json", "/")
    show_split("data//north/./users/../users/17.json", "/")
    show_split("https://example.com/api/north/users/17?score=3", "://")
    show_replace("say \"hi\" to \"them\"", "\"", "\"\"")
