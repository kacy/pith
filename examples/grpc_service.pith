# a grpc service written by hand, with no generated code.
#
# one dispatch function routes each call by its /package.Service/Method path,
# and std.protobuf encodes the messages. examples/grpc_catalog.pith builds the
# same kind of service from a .proto with tools/protogen, which is what a real
# service would do; this is the layer that generated code sits on.
#
# the server speaks plaintext http/2 (h2c), and a client in the same process
# makes its calls over one connection.

import std.net.grpc as grpc
import std.protobuf as protobuf
import std.time as time

PORT := 20251

# both messages hold one string, in field 1:
#
#   message HelloRequest { string name = 1; }
#   message HelloReply { string text = 1; }
fn decode_text(message: Bytes) -> String!protobuf.ProtoError:
    reader := protobuf.reader(message)
    mut text := ""
    while not reader.at_end():
        tag := reader.read_tag()!
        if tag.field == 1:
            text = reader.read_string()!
        else:
            reader.skip(tag.wire)!
    return text

fn encode_text(text: String) -> Bytes:
    writer := protobuf.writer()
    writer.write_string(1, text) catch false
    out := writer.bytes()
    writer.free()
    return out

# the greeter service. the server answers an unknown path with the status
# returned here, so a client can tell a missing method from a failed one.
fn greeter(path: String, request: Bytes) -> Bytes!grpc.GrpcError:
    mut name := decode_text(request) catch:
        fail grpc.GrpcError(grpc.GRPC_INVALID_ARGUMENT, "request is not a HelloRequest")
    if name == "":
        name = "world"
    match path:
        "/greeter.Greeter/SayHello" =>
            return encode_text("hello, {name}")
        "/greeter.Greeter/SayGoodbye" =>
            return encode_text("goodbye, {name}")
        _ =>
            fail grpc.GrpcError(grpc.GRPC_UNIMPLEMENTED, "no method {path}")

fn run_server() -> Int:
    return grpc.serve("127.0.0.1", PORT, greeter) catch 1

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

# make one call and describe its reply, or the status it failed with.
fn call(conn: grpc.Conn, path: String, name: String) -> String:
    reply := conn.unary(path, encode_text(name))
    if reply.is_err:
        return "{grpc.status_name(reply.err.status)}: {reply.err.message}"
    return decode_text(reply.ok) catch "unreadable reply"

fn main() -> Int!:
    spawn run_server()
    conn := connect()!
    defer conn.close()
    print("SayHello(pith)   -> " + call(conn, "/greeter.Greeter/SayHello", "pith"))
    print("SayHello()       -> " + call(conn, "/greeter.Greeter/SayHello", ""))
    print("SayGoodbye(pith) -> " + call(conn, "/greeter.Greeter/SayGoodbye", "pith"))
    print("Wave(pith)       -> " + call(conn, "/greeter.Greeter/Wave", "pith"))
    return 0
