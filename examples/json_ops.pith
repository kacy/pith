# json_ops: reading and writing JSON with std.json.
#
# handles order webhooks from a shop. a well-formed body decodes straight into
# typed structs; a malformed one is rejected with the reason. the reply is
# built node by node and encoded, and an archived copy goes to disk and back.

import std.fs as fs
import std.json as json

# json.decode fills public fields by name; a field with a default may be
# missing from the body
struct Item:
    pub sku: String
    pub quantity: Int
    pub unit_cents: Int

struct Order:
    pub id: Int
    pub customer: String
    pub items: List[Item]
    pub gift_wrap: Bool = false

# the archived copy only needs two of the receipt's fields; the rest are skipped
struct ArchivedReceipt:
    pub order: Int
    pub total_cents: Int

fn order_total(order: Order) -> Int:
    return order.items.reduce(0, fn(sum: Int, item: Item) => sum + item.quantity * item.unit_cents)

# the reply the shop expects, built as a tree and encoded once
fn receipt(order: Order) -> Int:
    skus := json.make_array()
    for item in order.items:
        json.array_push(skus, json.make_string(item.sku))
    reply := json.make_object()
    json.object_set(reply, "order", json.make_int(order.id))
    json.object_set(reply, "status", json.make_string("accepted"))
    json.object_set(reply, "total_cents", json.make_int(order_total(order)))
    json.object_set(reply, "skus", skus)
    return reply

fn handle(body: String) -> String:
    order := json.decode_text[Order](body) catch err:
        return "rejected: {err.message}"
    wrap := if order.gift_wrap: ", gift wrapped" else: ""
    print("order {order.id} for {order.customer}: {order.items.len()} line(s){wrap}")
    return json.encode(receipt(order))

fn main() -> Int!json.JsonDecodeError:
    # a literal brace in a pith string is doubled, since { starts interpolation
    bodies := [
        "{{\"id\": 1001, \"customer\": \"ada\", \"items\": [{{\"sku\": \"tea\", \"quantity\": 2, \"unit_cents\": 450}}, {{\"sku\": \"mug\", \"quantity\": 1, \"unit_cents\": 1200}}]}}",
        "{{\"id\": 1002, \"customer\": \"grace\", \"gift_wrap\": true, \"items\": [{{\"sku\": \"pot\", \"quantity\": 1, \"unit_cents\": 3000}}]}}",
        "{{\"id\": \"1003\", \"customer\": \"linus\", \"items\": []}}",
]
    mut replies: List[String] := []
    for body in bodies:
        reply := handle(body)
        print("  -> {reply}")
        replies.push(reply)

    # the tree API reads a document whose shape is not fixed ahead of time
    print("")
    event := json.parse("{{\"type\": \"refund\", \"order\": 1001, \"amount_cents\": 450, \"note\": null}}")
    print("event type: {json.object_get_string(event, "type")}")
    print("fields: {json.object_keys(event).join(", ")}")
    print("note is {json.type_of(json.object_get(event, "note"))}")
    print("reason: {json.object_get_string_or(event, "reason", "none given")}")

    # archive a receipt and read it back as a typed value
    path := "/tmp/pith_json_ops_receipt.json"
    defer fs.remove(path)
    json.save(path, json.parse(replies[1]))
    archived := json.decode_file[ArchivedReceipt](path)!
    print("archived order {archived.order}: {archived.total_cents} cents")

    # nodes live in a pool. a loop that parses many documents opens a scope
    # per pass so it does not keep every document it has ever seen; http
    # servers already do this for each request.
    before := json.pool_live_nodes()
    for index in 0..100:
        scope := json.open_scope()
        json.parse(bodies[index % 2])
        json.close_scope(scope)
    print("nodes left after 100 parses: {json.pool_live_nodes() - before}")
    return 0
