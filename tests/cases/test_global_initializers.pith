mut plain_int := 5
mut plain_str := "plain"
mut computed := 2 + 3
mut joined := "a" + "b"
mut listed := [1, 2, 3]
mut mapped: Map[String, Int] := {"k": 7}
mut stamped := time()

fn main():
    print(plain_int.to_string())
    print(plain_str)
    print(computed.to_string())
    print(joined)
    print(listed.len().to_string())
    print(mapped.get_default("k", 0).to_string())
    print((stamped > 0).to_string())
