# std.net.http — build requests with the client builder, route them on
# the server side, and inspect typed responses.

import std.net.http as http
import std.io as io

# parse wire bytes into the typed, method-style request.
fn parse(wire: Bytes) -> http.HttpRequestBytes!:
    return http.read_request_buffered_bytes(io.bytes_reader(wire).buffered_chunked(64))

# a tiny router: dispatch on method and path, return a typed response.
fn route(req: http.HttpRequestBytes) -> http.HttpResponse!:
    method := req.method()!
    path := req.path()!
    if method == "GET" and path == "/":
        return http.html(200, "<h1>welcome</h1>")
    if method == "GET" and path.starts_with("/users/"):
        id := req.path_param_or("/users/:id", "id", "?")
        return http.text(200, "user {id}")
    if method == "GET" and path == "/search":
        q := req.query_param_or("q", "everything")
        return http.text(200, "results for {q}")
    if method == "POST" and path == "/submit":
        body := req.body_text_or("")
        return http.text(201, "stored: {body}")
    return http.not_found_response()

# route one built request and print a one-line summary of the response.
fn serve(label: String, req: http.ClientRequest) -> Int!:
    response := route(parse(req.to_bytes()!)!)!
    mut status := "ok"
    if not response.is_success():
        status = "not ok"
    body := response.body_bytes().to_string_utf8()!
    print("{label}: {response.status_code()} ({status}) - {body}")
    return 0

fn main() -> Int!:
    serve("home", http.get_request("example.com", 80, "/"))!
    serve("user", http.get_request("example.com", 80, "/users/42"))!
    serve("search", http.get_request("example.com", 80, "/search?q=pith"))!
    serve("submit", http.post_request("example.com", 80, "/submit").text_body("hello"))!
    serve("missing", http.get_request("example.com", 80, "/nope"))!

    # a request also carries headers and auth, read back the same way.
    signed := http.get_request("example.com", 80, "/search?q=lang").accept("application/json").bearer("token123")
    req := parse(signed.to_bytes()!)!
    print("accept: {req.header_or("Accept", "-")}")
    print("auth: {req.header_or("Authorization", "-")}")
    print("q: {req.query_param_or("q", "-")}")
    return 0
