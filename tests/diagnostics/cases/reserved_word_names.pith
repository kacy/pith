# a reserved word where a name belongs is reported at the word itself, says
# that the word is reserved, and leaves the rest of the file parsing. a local
# named `from` used to be blamed on the end of the line above it, with the
# token kind kw_from in the message, and `for := 3` cascaded into eight errors.
fn uses(from: Int) -> Int:
    return from

fn main():
    x := 1
    from := x
    mut i := 0
    while i < 2:
        for := i
        i = i + 1
    match = 4
    y := in
    print("{x} {i}")
