# fixture_server — local multi-protocol HTTP/1.1, TLS, mTLS, HTTP/2 (h2 + h2c),
# and HTTP proxy test server for purl's end-to-end integration test suite.
#
# Usage:
#   fixture_server http <port> <max_conns>
#   fixture_server tls <port> <max_conns> <cert> <key> [client_ca]
#   fixture_server h2c <port> <max_conns>
#   fixture_server h2 <port> <max_conns> <cert> <key>
#   fixture_server proxy <port> <max_conns>
#   fixture_server socks5 <port> <max_conns> [user] [pass]
#   fixture_server unix <socket_path> <max_conns>

import std.bytes as bytes
import std.compress.gzip as gzip
import std.compress.zlib as zlib
import std.compress.zstd as zstd
import std.io as io
import std.json as json
import std.net.http as http
import std.net.http2.server as h2server
import std.net.tls as tls
import std.net.unix as unix
import std.time as time
from std.io import TcpStream
from std.net.http import HttpRequestBytes, HttpResponse
from purl_auth import build_digest_header_with_cnonce, parse_digest_challenge

flaky_counter := AtomicInt(0)

fn echo_json_response(req: HttpRequestBytes) -> HttpResponse:
    obj := json.make_object()
    json.object_set(obj, "method", json.make_string(req.method() catch ""))
    json.object_set(obj, "path", json.make_string(req.path() catch ""))
    json.object_set(obj, "query", json.make_string(req.query() catch ""))
    json.object_set(obj, "host", json.make_string(req.header_or("Host", "")))
    json.object_set(obj, "content_type", json.make_string(req.header_or("Content-Type", "")))
    json.object_set(obj, "user_agent", json.make_string(req.header_or("User-Agent", "")))
    json.object_set(obj, "authorization", json.make_string(req.header_or("Authorization", "")))
    json.object_set(obj, "x_amz_date", json.make_string(req.header_or("X-Amz-Date", "")))
    json.object_set(obj, "x_amz_sha", json.make_string(req.header_or("X-Amz-Content-Sha256", "")))
    json.object_set(obj, "if_modified_since", json.make_string(req.header_or("If-Modified-Since", "")))
    json.object_set(obj, "if_unmodified_since", json.make_string(req.header_or("If-Unmodified-Since", "")))
    json.object_set(obj, "cookie", json.make_string(req.header_or("Cookie", "")))
    json.object_set(obj, "referer", json.make_string(req.header_or("Referer", "")))
    json.object_set(obj, "x_custom", json.make_string(req.header_or("X-Custom", "")))
    json.object_set(obj, "body", json.make_string(req.body_text_or("")))
    return http.json(200, json.encode(obj))

fn route(req: HttpRequestBytes) -> HttpResponse:
    path := req.path() catch "/"
    method := req.method() catch "GET"

    if path == "/hello":
        return http.text(200, "hello from purl")

    if path == "/echo" or path.starts_with("/upload"):
        return echo_json_response(req)

    if path == "/binary":
        buf := bytes.buffer()
        defer buf.free()
        buf.write_byte(0) catch 0
        buf.write_byte(1) catch 0
        buf.write_byte(2) catch 0
        buf.write_byte(255) catch 0
        return http.response(200).content_type(http.MIME_BINARY).bytes_body(buf.bytes())

    if path == "/redirect/1":
        return http.response(302).header("Location", "/redirect/2").set_cookie(http.cookie("hop1", "alpha").path("/"))

    if path == "/redirect/2":
        return http.response(301).header("Location", "/redirect/final").set_cookie(http.cookie("hop2", "beta").path("/"))

    if path == "/redirect/final":
        return echo_json_response(req)

    if path == "/redirect-307":
        return http.response(307).header("Location", "/echo")

    if path == "/redirect-302":
        return http.response(302).header("Location", "/echo")

    if path == "/redirect-loop":
        return http.response(302).header("Location", "/redirect-loop")

    if path == "/redirect-cross":
        port_q := req.query_param_or("port", "18901")
        return http.response(302).header("Location", "http://localhost:{port_q}/echo")

    if path == "/status/404":
        return http.text(404, "missing page body")

    if path == "/status/500":
        return http.text(500, "server error body")

    if path == "/status/204":
        return http.no_content()

    if path == "/flaky":
        count := flaky_counter.fetch_add(1) + 1
        if count < 3:
            return http.text(503, "try again")
        return http.text(200, "recovered")

    if path == "/big":
        buf := bytes.buffer_with_capacity(65536)
        defer buf.free()
        chunk := bytes.from_string_utf8("0123456789abcdef")
        mut i := 0
        while i < 4096:
            buf.write(chunk) catch 0
            i = i + 1
        return http.response(200).content_type("application/octet-stream").bytes_body(buf.bytes())

    if path == "/etag":
        inm := req.header_or("If-None-Match", "").trim()
        if inm == "\"v1-etag\"":
            return http.response(304).header("ETag", "\"v1-etag\"")
        return http.text(200, "etag-body-v1").header("ETag", "\"v1-etag\"")

    if path == "/digest-sha256" or path == "/digest-md5":
        mut algo := "SHA-256"
        if path == "/digest-md5":
            algo = "MD5"
        challenge := "Digest realm=\"purl\", qop=\"auth\", algorithm=" + algo + ", nonce=\"fixednonce123\""
        auth_hdr := req.header_or("Authorization", "")
        if not auth_hdr.to_lower().starts_with("digest "):
            return http.text(401, "digest required").header("WWW-Authenticate", challenge)
        got_params := parse_digest_challenge(auth_hdr)
        cnonce := got_params.get("cnonce").unwrap_or("")
        expected := build_digest_header_with_cnonce(challenge, "alice", "secret", method, path, cnonce) catch ""
        exp_params := parse_digest_challenge(expected)
        if got_params.get("response").unwrap_or("") == exp_params.get("response").unwrap_or("") and exp_params.contains_key("response"):
            return http.text(200, "digest-ok-" + algo)
        return http.text(401, "digest mismatch").header("WWW-Authenticate", challenge)

    if path.starts_with("/item/"):
        return http.text(200, "item=" + path.substring(6, path.len()))

    if path == "/slow":
        time.delay(350)
        return http.text(200, "slow-ok")

    if path == "/gzip":
        payload := gzip.compress_string("compressed via gzip payload")
        return http.response(200).content_type("text/plain").header("Content-Encoding", "gzip").bytes_body(payload)

    if path == "/deflate":
        payload := zlib.compress_string("compressed via deflate payload")
        return http.response(200).content_type("text/plain").header("Content-Encoding", "deflate").bytes_body(payload)

    if path == "/zstd":
        payload := zstd.compress_string("compressed via zstd payload")
        return http.response(200).content_type("text/plain").header("Content-Encoding", "zstd").bytes_body(payload)

    if path == "/multipart" and method == "POST":
        parts := req.multipart_parts() catch []
        arr := json.make_array()
        for p in parts:
            item := json.make_object()
            json.object_set(item, "name", json.make_string(p.name))
            json.object_set(item, "filename", json.make_string(p.filename))
            json.object_set(item, "content_type", json.make_string(p.content_type))
            json.object_set(item, "body", json.make_string(p.body.to_string_utf8() catch ""))
            json.array_push(arr, item)
        return http.json(200, json.encode(arr))

    if path == "/download":
        full := "0123456789abcdef"
        range_hdr := req.header_or("Range", "")
        if range_hdr.starts_with("bytes="):
            spec := range_hdr.substring(6, range_hdr.len())
            dash := spec.index_of("-")
            if dash >= 0:
                start := parse_int(spec.substring(0, dash)) catch 0
                mut end_idx := full.len()
                end_text := spec.substring(dash + 1, spec.len()).trim()
                if end_text != "":
                    end_idx = (parse_int(end_text) catch (full.len() - 1)) + 1
                if start >= 0 and start < full.len() and end_idx <= full.len() and end_idx > start:
                    slice := full.substring(start, end_idx)
                    return http.text(206, slice).header("Content-Disposition", "attachment; filename=\"report.txt\"").header("Content-Range", "bytes {start}-{end_idx - 1}/{full.len()}")
        return http.text(200, full).header("Content-Disposition", "attachment; filename=\"report.txt\"")

    if path == "/cookie-set":
        return http.text(200, "cookies-set").set_cookie(http.cookie("session", "xyz99").path("/").http_only()).set_cookie(http.cookie("prefs", "compact").path("/"))

    if path == "/multi-headers":
        vals := req.header_values("X-Multi").join("|")
        mut resp := http.text(200, vals)
        resp = resp.add_header("X-Resp-Multi", "one").add_header("X-Resp-Multi", "two")
        resp = resp.add_header("Link", "</a.css>; rel=preload").add_header("Link", "</b.js>; rel=preload")
        return resp

    return http.not_found_response()

fn proxy_route(req: HttpRequestBytes) -> HttpResponse:
    obj := json.make_object()
    json.object_set(obj, "proxied", json.make_bool(true))
    json.object_set(obj, "method", json.make_string(req.method() catch ""))
    json.object_set(obj, "path", json.make_string(req.path() catch ""))
    json.object_set(obj, "host", json.make_string(req.header_or("Host", "")))
    return http.json(200, json.encode(obj))

fn relay_fd(src_fd: Int, dst_fd: Int) -> Int:
    while true:
        chunk := tcp_read_bytes(src_fd, 16384) catch bytes.empty()
        if chunk.len() == 0:
            break
        mut sent := 0
        while sent < chunk.len():
            part := chunk.slice(sent, chunk.len())
            n := tcp_write_bytes(dst_fd, part) catch -1
            if n <= 0:
                return 0
            sent = sent + n
    return 0

fn serve_socks5_conn(client_fd: Int, req_user: String, req_pass: String, wg: WaitGroup) -> Int:
    defer wg.done()
    stream := TcpStream(client_fd)
    defer stream.close()
    stream.set_timeout(5000)

    g := stream.read_exact_bytes(2) catch bytes.empty()
    if g.len() != 2 or g[0] != 5:
        return 1
    methods := stream.read_exact_bytes(g[1]) catch bytes.empty()
    if methods.len() != g[1]:
        return 1

    need_auth := req_user != ""
    sel := bytes.buffer_with_capacity(2)
    defer sel.free()
    sel.write_byte(5) catch 0
    if need_auth:
        sel.write_byte(2) catch 0
    else:
        sel.write_byte(0) catch 0
    stream.write_all_bytes(sel.bytes()) catch 0

    if need_auth:
        vu := stream.read_exact_bytes(2) catch bytes.empty()
        if vu.len() != 2:
            return 1
        u := (stream.read_exact_bytes(vu[1]) catch bytes.empty()).to_string_utf8() catch ""
        pl := stream.read_exact_bytes(1) catch bytes.empty()
        if pl.len() != 1:
            return 1
        p := (stream.read_exact_bytes(pl[0]) catch bytes.empty()).to_string_utf8() catch ""
        aresp := bytes.buffer_with_capacity(2)
        defer aresp.free()
        aresp.write_byte(1) catch 0
        if u == req_user and p == req_pass:
            aresp.write_byte(0) catch 0
        else:
            aresp.write_byte(1) catch 0
        stream.write_all_bytes(aresp.bytes()) catch 0
        if u != req_user or p != req_pass:
            return 0

    hdr := stream.read_exact_bytes(4) catch bytes.empty()
    if hdr.len() != 4 or hdr[0] != 5 or hdr[1] != 1:
        return 1
    atyp := hdr[3]
    mut target_host := ""
    if atyp == 1:
        ip4 := stream.read_exact_bytes(4) catch bytes.empty()
        if ip4.len() != 4:
            return 1
        target_host = "{ip4[0]}.{ip4[1]}.{ip4[2]}.{ip4[3]}"
    elif atyp == 3:
        dl := stream.read_exact_bytes(1) catch bytes.empty()
        if dl.len() != 1:
            return 1
        target_host = (stream.read_exact_bytes(dl[0]) catch bytes.empty()).to_string_utf8() catch ""
    elif atyp == 4:
        stream.read_exact_bytes(16) catch bytes.empty()
        target_host = "::1"
    else:
        return 1

    pb := stream.read_exact_bytes(2) catch bytes.empty()
    if pb.len() != 2:
        return 1
    target_port := pb[0] * 256 + pb[1]

    # Map synthetic remote-DNS test domain to loopback so tests verify ATYP_DOMAIN.
    mut dial_host := target_host
    if target_host == "socks-remote.test":
        dial_host = "127.0.0.1"

    up_res := io.connect(dial_host, target_port)
    if up_res.is_err:
        fail_rep := bytes.buffer_with_capacity(10)
        defer fail_rep.free()
        fail_rep.write_byte(5) catch 0
        fail_rep.write_byte(5) catch 0
        fail_rep.write_byte(0) catch 0
        fail_rep.write_byte(1) catch 0
        mut zi := 0
        while zi < 6:
            fail_rep.write_byte(0) catch 0
            zi = zi + 1
        stream.write_all_bytes(fail_rep.bytes()) catch 0
        return 1
    up := up_res.ok
    defer up.close()
    up.set_timeout(5000)

    ok_rep := bytes.buffer_with_capacity(10)
    defer ok_rep.free()
    ok_rep.write_byte(5) catch 0
    ok_rep.write_byte(0) catch 0
    ok_rep.write_byte(0) catch 0
    ok_rep.write_byte(1) catch 0
    mut zj := 0
    while zj < 6:
        ok_rep.write_byte(0) catch 0
        zj = zj + 1
    stream.write_all_bytes(ok_rep.bytes()) catch 0

    t1 := spawn relay_fd(client_fd, up.fd)
    t2 := spawn relay_fd(up.fd, client_fd)
    await t2
    # Once upstream finishes sending and closes, close both sides so t1 unblocks cleanly.
    up.close()
    stream.close()
    await t1
    return 0

fn serve_http_conn(fd: Int, wg: WaitGroup) -> Int:
    defer wg.done()
    tcp_set_timeout(fd, 5000)
    http.serve_connection_fd(fd, route) catch 0
    return 0

fn main() -> Int!:
    argv := args()
    if argv.len() < 4:
        print_err("usage: fixture_server <http|tls|h2c|h2|proxy|socks5|unix> <port|sock> <max_conns> [cert] [key] [client_ca]")
        return 2
    mode := argv[1]
    port := parse_int(argv[2]) catch 18900
    max_conns := parse_int(argv[3]) catch 20

    if mode == "unix":
        sock_path := argv[2]
        listener := unix.listen(sock_path)!
        defer listener.close()
        wg := WaitGroup()
        mut served := 0
        while served < max_conns:
            client := listener.accept_fd()!
            wg.add(1)
            spawn serve_http_conn(client, wg)
            served = served + 1
        wg.wait()
        return 0

    if mode == "http":
        fd := tcp_listen("127.0.0.1", port)!
        wg := WaitGroup()
        mut served := 0
        while served < max_conns:
            client := tcp_accept(fd)!
            wg.add(1)
            spawn serve_http_conn(client, wg)
            served = served + 1
        wg.wait()
        tcp_close(fd)
        return 0

    if mode == "proxy":
        fd := tcp_listen("127.0.0.1", port)!
        mut served := 0
        while served < max_conns:
            client := tcp_accept(fd)!
            tcp_set_timeout(client, 5000)
            http.serve_connection_fd(client, proxy_route) catch 0
            served = served + 1
        tcp_close(fd)
        return 0

    if mode == "socks5":
        mut req_user := ""
        mut req_pass := ""
        if argv.len() >= 6:
            req_user = argv[4]
            req_pass = argv[5]
        fd := tcp_listen("127.0.0.1", port)!
        wg := WaitGroup()
        mut served := 0
        while served < max_conns:
            client := tcp_accept(fd)!
            wg.add(1)
            spawn serve_socks5_conn(client, req_user, req_pass, wg)
            served = served + 1
        wg.wait()
        tcp_close(fd)
        return 0

    if mode == "h2c":
        fd := tcp_listen("127.0.0.1", port)!
        mut served := 0
        while served < max_conns:
            client := tcp_accept(fd)!
            tcp_set_timeout(client, 5000)
            h2server.serve_h2c_connection(client, route)
            served = served + 1
        tcp_close(fd)
        return 0

    if mode == "tls" or mode == "h2":
        if argv.len() < 6:
            print_err("tls/h2 mode requires <cert> <key> [client_ca]")
            return 2
        cert_path := argv[4]
        key_path := argv[5]
        mut cfg := tls.server_config(cert_path, key_path)!
        if mode == "h2":
            cfg = cfg.with_alpn(["h2", "http/1.1"])
        if argv.len() >= 7 and argv[6] != "":
            cfg = cfg.require_client_ca_file(argv[6])!
        listener := tls.listen("127.0.0.1", port, cfg)!
        mut served := 0
        while served < max_conns:
            conn_res := tls.accept(listener)
            served = served + 1
            if conn_res.is_err:
                continue
            conn := conn_res.ok
            if mode == "h2" and conn.negotiated_protocol() == "h2":
                h2server.serve_h2_tls_connection(conn, route)
            else:
                http.serve_connection_tls(conn, route) catch 0
        cfg.close()
        return 0

    print_err("unknown mode: {mode}")
    return 2
