# a `mut` global read as an argument hands the callee the global's count and
# none of its own. rename reassigns the global, which drops that count, and
# then reads its parameter, so the argument needs a pin. the same shape across
# tasks, a global one task replaces while another reads it, is refused at
# compile time (E309, tests/invalid/shared_global_string.pith).
mut msg: String := "start"

fn rename(s: String) -> Int:
    msg = "x-" + s.len().to_string()
    return s.len()

fn main():
    msg = "a-" + (3).to_string()
    n := rename(msg)
    print("n {n} {msg}")
