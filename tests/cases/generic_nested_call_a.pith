# helper for test_generic_nested_module_call: generic bodies that call a
# generic from generic_nested_call_b, once by a bare import and once through
# a module alias.
import generic_nested_call_b as b
from generic_nested_call_b import gather

pub fn reverse_all[T](xs: List[T]) -> List[T]:
    return gather(xs)

pub fn reverse_aliased[T](xs: List[T]) -> List[T]:
    return b.gather(xs)
