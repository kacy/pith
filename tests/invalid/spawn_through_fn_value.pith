# the program reaches its only spawn through a function value: `launch` is
# named, never called by name. naming a function counts as reaching it, so the
# program spawns and the library's spawn that shares `xs` is refused (E248).
import support.spawn_fn_value_lib as lib

fn main():
    xs: List[String] := []
    f := lib.launch
    print("{f(xs)}")
