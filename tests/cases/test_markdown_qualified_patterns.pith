# patterns name std.markdown's Event and Tag through the module alias, nested
# where a tag sits in an event's payload, the way a caller that imports the
# module whole writes them.
import std.markdown as markdown

fn describe(e: markdown.Event) -> String:
    return match e:
        markdown.Event.Start(markdown.Tag.Heading(level)) => "start heading {level}"
        markdown.Event.End(markdown.Tag.Heading(level)) => "end heading {level}"
        markdown.Event.Start(markdown.Tag.Link(dest, _)) => "start link " + dest
        markdown.Event.Start(markdown.Tag.List(none, tight)) => "start bullet list, tight {tight}"
        markdown.Event.Start(_) => "start"
        markdown.Event.End(_) => "end"
        markdown.Event.Text(t) => "text " + t
        markdown.Event.Code(c) => "code " + c
        markdown.Event.SoftBreak | markdown.Event.HardBreak => "break"
        _ => "other"

fn main():
    source := "# Title\n\nSome *text* with [a link](https://example.com)\nand `code`.\n\n- one\n- two\n"
    for e in markdown.events(source, markdown.options()):
        print(describe(e))
    mut texts := 0
    for e in markdown.events(source, markdown.options()):
        if let markdown.Event.Text(_) = e:
            texts = texts + 1
    print("texts {texts}")
