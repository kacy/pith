# the module test_qualified_variant_patterns imports under an alias, so its
# patterns name these enums as `ev.Event.Text(...)`.

pub enum Tag:
    Heading(Int)
    Paragraph
    Link(String)

pub enum Event:
    Start(Tag)
    End(Tag)
    Text(String)
    Rule

pub enum Slot[T]:
    Full(T)
    Empty

## a short stream of events covering each variant.
pub fn sample() -> List[Event]:
    return [Event.Start(Tag.Heading(2)), Event.Text("title"), Event.End(Tag.Heading(2)), Event.Rule, Event.Start(Tag.Link("u")), Event.Text("body"), Event.End(Tag.Paragraph)]
