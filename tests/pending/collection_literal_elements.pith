# PENDING — no issue yet. not registered in tooling/leak_check.sh; it fails.
#
# a set or a map written as a literal never releases the freshly allocated
# elements it was built from. the container itself is released — the same set
# filled a member at a time with `add`, or the same map filled by index
# assignment, is flat — and a literal over constants is flat too, since a
# constant has nothing to release. a *list* literal over the same fresh
# strings is flat as well, so this is specific to the set and map literal
# lowerings.
#
# both halves of a map literal pay it: a fresh key and a fresh value each leak
# on their own.
#
# this is not a generics defect. it turned up in a generic survey because a
# generic struct at each rc kind puts a set literal behind the type parameter,
# and the corpus had never churned one.
#
# measured on this file at PITH_LEAK_ROUNDS 200000 vs 800000:
#   shape 1, set literal over a fresh string   12.1 mb -> 40.2 mb
#   shape 2, the same set filled with add       2.7 mb ->  2.8 mb
#   shape 3, set literal over constants only    2.7 mb ->  2.7 mb
#   shape 4, map literal with a fresh value    12.2 mb -> 40.2 mb
#   shape 5, map literal with a fresh key      12.1 mb -> 40.3 mb
#   shape 6, the same map filled by index       2.8 mb ->  2.8 mb
#   shape 7, list literal over a fresh string   2.7 mb ->  2.7 mb
import pendingprobe as probe
import std.env as env

fn set_literal(tag: String) -> Int:
    a := {"set-" + tag, "other"}
    return a.len()

fn set_added(tag: String) -> Int:
    mut b: Set[String] := {}
    b.add("set-" + tag)
    b.add("other")
    return b.len()

fn set_constants(tag: String) -> Int:
    c := {"alpha", "beta"}
    return c.len() + tag.len()

fn map_fresh_value(tag: String) -> Int:
    d := {"k": "map-" + tag}
    return d.len()

fn map_fresh_key(tag: String) -> Int:
    e := {"map-" + tag: 1}
    return e.len()

fn map_indexed(tag: String) -> Int:
    mut f: Map[String, String] := {}
    f["k"] = "map-" + tag
    return f.len()

fn list_literal(tag: String) -> Int:
    g := ["list-" + tag, "other"]
    return g.len()

fn main():
    which := env.int_or("SHAPE", 1)
    n := probe.rounds()
    mut i := 0
    mut acc := 0
    while i < n:
        tag := i.to_string()
        if which == 1:
            acc = acc + set_literal(tag)
        if which == 2:
            acc = acc + set_added(tag)
        if which == 3:
            acc = acc + set_constants(tag)
        if which == 4:
            acc = acc + map_fresh_value(tag)
        if which == 5:
            acc = acc + map_fresh_key(tag)
        if which == 6:
            acc = acc + map_indexed(tag)
        if which == 7:
            acc = acc + list_literal(tag)
        i = i + 1
    if acc < 0:
        print("unreachable")
    kb := probe.peak_kb()
    print("{kb}")
