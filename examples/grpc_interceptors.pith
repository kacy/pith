# grpc interceptors: rules that run around every call, outside the methods.
#
# an interceptor wraps the dispatch the way std.web middleware wraps a route
# handler. it gets the rest of the chain and the call, so it can look at the
# call, refuse it, or look at the reply on the way out. grpc.intercept folds a
# list of them into a dispatch of the same type, so the service and the serve
# call do not change.
#
# the greeter below knows nothing about the three rules wrapped around it: a
# signed bearer token is required, calls are rate limited, and every call is
# counted by method and outcome. the client sets its token once, on the
# connection.

import std.bytes as bytes
import std.crypto.jwt as jwt
import std.metrics as metrics
import std.net.grpc as grpc
import std.protobuf as protobuf
import std.resilience as resilience
import std.time as time

PORT := 20153

# the key tokens are signed with. a real server would load it from a secret
# store, or check tokens against an issuer's public keys (std.crypto.jwks).
SECRET := bytes.from_string_utf8("an example key, not for production")

calls := metrics.counter("greeter_calls_total")

fn decode_text(message: Bytes) -> String!protobuf.ProtoError:
    reader := protobuf.reader(message)
    mut text := ""
    while not reader.at_end():
        tag := reader.read_tag()!
        if tag.field == 1:
            text = reader.read_string()!
        else:
            reader.skip(tag.wire)!
    return text

fn encode_text(text: String) -> Bytes:
    writer := protobuf.writer()
    writer.write_string(1, text) catch false
    out := writer.bytes()
    writer.free()
    return out

# the service, with no auth or limit code in it.
fn greeter(path: String, request: Bytes) -> Bytes!grpc.GrpcError:
    if path != "/demo.Greeter/Hello":
        fail grpc.GrpcError(grpc.GRPC_UNIMPLEMENTED, "no method {path}")
    name := decode_text(request) catch "world"
    return encode_text("hello, {name}")

fn has_valid_token(metadata: Map[String, String]) -> Bool:
    return jwt.verify_hs256(grpc.bearer_token(metadata), SECRET, jwt.default_options()).is_ok

# count each call by method and outcome, after the rest of the chain has run.
fn count_calls(next: fn(String, Bytes) -> Bytes!grpc.GrpcError, path: String, request: Bytes) -> Bytes!grpc.GrpcError:
    reply := next(path, request)
    mut status := grpc.GRPC_OK
    if reply.is_err:
        status = reply.err.status
    calls.labels(["method", path, "status", grpc.status_name(status)]).inc()
    return reply

fn run_server() -> Int:
    # a burst of two and a slow refill, so the third call is refused every run
    # rather than racing a token that refills partway through.
    limiter := resilience.rate_limiter(1, 2)
    # the first interceptor runs outermost, so count_calls sees the calls the
    # other two refuse.
    guarded := grpc.intercept(greeter, [count_calls, grpc.authorize(has_valid_token), grpc.rate_limit(limiter)])
    return grpc.serve("127.0.0.1", PORT, guarded) catch 1

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

# call once and describe what came back.
fn say_hello(conn: grpc.Conn, name: String) -> String:
    reply := conn.unary("/demo.Greeter/Hello", encode_text(name)) catch err:
        return grpc.status_name(err.status)
    return decode_text(reply) catch "unreadable reply"

fn main() -> Int!:
    spawn run_server()

    anonymous := connect()!
    print("no token:      " + say_hello(anonymous, "ada"))
    anonymous.close()

    conn := connect()!
    defer conn.close()
    token := jwt.claims().subject("ada").expires_in(600).sign_hs256(SECRET)!
    conn.set_credentials(["authorization", "Bearer {token}"])
    print("with a token:  " + say_hello(conn, "ada"))
    print("with a token:  " + say_hello(conn, "grace"))
    print("over the rate: " + say_hello(conn, "alan"))

    print("")
    for line in metrics.snapshot_text().split("\n"):
        if line.starts_with("greeter_calls_total{{"):
            print(line)
    return 0
