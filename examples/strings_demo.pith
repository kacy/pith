# strings_demo: the text helpers in std.strings.
#
# turns a markdown file into a table of contents. split_once and partition
# read the front matter, trim_left_chars and collapse_whitespace clean up each
# heading, title and center lay out the banner, and zfill and indent number
# and nest the entries.

import std.strings as strings

struct Heading:
    level: Int
    text: String

fn read_front_matter(block: String) -> Map[String, String]:
    mut fields: Map[String, String] := {}
    for line in strings.split_lines(block):
        parts := strings.partition(line, ":")
        if parts[1].is_empty():
            continue
        fields[parts[0].trim()] = parts[2].trim()
    return fields

fn read_headings(body: String) -> List[Heading]:
    mut found: List[Heading] := []
    for line in strings.split_lines(body):
        if not line.starts_with("#"):
            continue
        text := strings.trim_left_chars(line, "#")
        level := line.len() - text.len()
        found.push(Heading(level: level, text: strings.collapse_whitespace(text)))
    return found

fn anchor(text: String) -> String:
    return strings.split_nonempty(text.to_lower(), " ").join("-")

fn main():
    document := strings.unlines([
        "---",
        "title: a field guide to pith",
        "author: the docs team",
        "---",
        "# getting   started",
        "some text",
        "## install the toolchain",
        "## hello,  world",
        "# working with text",
        "## strings and bytes",
        "### when bytes are not text",
        "# where to go next",
])

    # the front matter sits between the first two `---` lines
    split := strings.split_once(strings.after(document, "---\n"), "---\n")
    meta := read_front_matter(split.left)
    # center pads both sides, and trailing blanks are noise in a terminal
    print(strings.trim_right(strings.center(strings.title(meta["title"]), 44)))
    print(strings.trim_right(strings.center("by " + meta["author"], 44)))
    print("")

    # one counter per heading level; a heading resets every level below it
    mut counters := [0, 0, 0]
    for heading in read_headings(split.right):
        depth := heading.level - 1
        counters[depth] = counters[depth] + 1
        for deeper in depth + 1..counters.len():
            counters[deeper] = 0
        if depth == 0:
            chapter := strings.zfill(counters[0].to_string(), 2)
            print("{chapter}  {strings.capitalize(heading.text):<28}#{anchor(heading.text)}")
            continue
        number := strings.zfill(counters[0].to_string(), 2) + "." + counters.slice(1, depth + 1).map(fn(n: Int) => n.to_string()).join(".")
        print(strings.indent("{number}  {heading.text}", strings.repeat("  ", depth)))
