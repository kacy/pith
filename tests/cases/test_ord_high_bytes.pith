# ord gives a byte from 0 to 255 however the byte is reached. read through
# a variable, a byte from 128 up used to come out negative (`é` starts with
# 0xc3: 195 by index, -61 through a variable), so the two spellings disagreed.
fn main():
    s := "é"
    c := s[0]
    print("by index: {ord(s[0])}")
    print("through a variable: {ord(c)}")
    print("same: {ord(c) == ord(s[0])}")
    print("whole string: {ord(s)}")
    print("ascii: {ord("A")}")
    print("empty: {ord("")}")
