# a `holding` clause after a bare result type: `-> Int! holding mu` read the
# clause's keyword as the result's error type and failed to parse
guard mu:
    mut total := 0

fn add(n: Int) -> Int! holding mu:
    if n < 0:
        fail "negative"
    total = total + n
    return total

fn main():
    locked mu:
        print("{add(2) catch 0} {add(3) catch 0} {add(0 - 1) catch 99}")
