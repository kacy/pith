# std.crypto.x509 — certificate parsing helpers
#
# this is the start of the native tls stack: enough der/x.509 support to
# inspect certificates and apply hostname checks without leaning on rust.

import std.bits as bits
import std.bytes as bytes
import std.encoding as encoding
import std.crypto.signature as signature
import std.time as time

TAG_BOOLEAN := 1
TAG_INTEGER := 2
TAG_BIT_STRING := 3
TAG_OCTET_STRING := 4
TAG_NULL := 5
TAG_OBJECT_ID := 6
TAG_UTF8_STRING := 12
TAG_SEQUENCE := 48
TAG_SET := 49
TAG_PRINTABLE_STRING := 19
TAG_IA5_STRING := 22
TAG_UTC_TIME := 23
TAG_GENERALIZED_TIME := 24
TAG_DNS_NAME := 130
TAG_IP_ADDRESS := 135
TAG_EXTENSIONS := 163
# name-constraints subtrees are implicitly tagged [0] (permitted) and [1]
# (excluded); both are constructed context tags wrapping a sequence of subtrees.
TAG_PERMITTED_SUBTREES := 160
TAG_EXCLUDED_SUBTREES := 161

OID_COMMON_NAME := "2.5.4.3"
OID_SUBJECT_ALT_NAME := "2.5.29.17"
OID_BASIC_CONSTRAINTS := "2.5.29.19"
OID_KEY_USAGE := "2.5.29.15"
OID_EXTENDED_KEY_USAGE := "2.5.29.37"
OID_NAME_CONSTRAINTS := "2.5.29.30"
# extendedKeyUsage purpose ids we recognise for a tls server certificate.
OID_SERVER_AUTH := "1.3.6.1.5.5.7.3.1"
OID_ANY_EKU := "2.5.29.37.0"

# one der tag-length-value entry.
pub struct DerValue:
    pub tag: Int
    pub header_start: Int
    pub value_start: Int
    pub value_end: Int
    pub next: Int
    pub constructed: Bool

# parsed x.509 certificate metadata used by tls verification.
pub struct Certificate:
    pub der: Bytes
    pub tbs_der: Bytes
    pub subject_public_key_info: Bytes
    pub subject_public_key: Bytes
    pub signature: Bytes
    pub version: Int
    pub serial_hex: String
    pub signature_algorithm: String
    pub public_key_algorithm: String
    pub issuer_common_name: String
    pub subject_common_name: String
    pub not_before: String
    pub not_after: String
    pub dns_names: List[String]
    pub ip_addresses: List[String]
    pub is_ca: Bool
    # raw der of the issuer and subject distinguished names, used for exact
    # full-dn matching when selecting the issuer of a certificate.
    pub issuer_dn: Bytes
    pub subject_dn: Bytes
    # extendedKeyUsage: has_eku is false when the extension is absent (which
    # rfc 5280 treats as "valid for any purpose"). when present, eku_oids holds
    # every listed purpose object identifier.
    pub has_eku: Bool
    pub eku_oids: List[String]
    # dnsname name-constraints copied from this certificate when it is a ca.
    # empty lists mean the certificate constrains no dnsnames.
    pub permitted_dns: List[String]
    pub excluded_dns: List[String]
    # keyUsage: has_key_usage is false when the extension is absent (rfc 5280
    # treats that as "valid for any purpose"). when present, key_cert_sign is
    # the keyCertSign bit, which a certificate must carry to sign others.
    pub has_key_usage: Bool
    pub key_cert_sign: Bool
    # basicConstraints pathLenConstraint: has_path_len is false when absent.
    # when present, path_len bounds how many intermediate cas may appear below
    # this one on a valid path.
    pub has_path_len: Bool
    pub path_len: Int

# result from native certificate verification preflight.
pub struct VerificationResult:
    pub ok: Bool
    pub hostname_ok: Bool
    pub issuer_ok: Bool
    pub root_ca_ok: Bool
    pub signature_verified: Bool
    pub reason: String

fn read_len(data: Bytes, pos: Int, available_end: Int) -> Int!:
    if pos >= available_end:
        fail "truncated der length"
    first := data[pos]
    if bits.band(first, 128) == 0:
        return first
    count := bits.band(first, 127)
    if count == 0:
        fail "indefinite der length is not supported"
    if count > 4:
        fail "der length is too large"
    if pos + count >= available_end:
        fail "truncated der long length"
    mut value := 0
    mut i := 0
    while i < count:
        value = bits.shl(value, 8) + data[pos + 1 + i]
        i = i + 1
    return value

fn len_width(data: Bytes, pos: Int) -> Int!:
    first := data[pos]
    if bits.band(first, 128) == 0:
        return 1
    count := bits.band(first, 127)
    if count == 0:
        fail "indefinite der length is not supported"
    return 1 + count

# read one der value at offset.
pub fn read_value(data: Bytes, pos: Int) -> DerValue!:
    if pos + 2 > data.len():
        fail "truncated der value"
    length := read_len(data, pos + 1, data.len())!
    width := len_width(data, pos + 1)!
    value_start := pos + 1 + width
    value_end := value_start + length
    if value_end > data.len():
        fail "der value extends past input"
    tag := data[pos]
    return DerValue(tag, pos, value_start, value_end, value_end, bits.band(tag, 32) != 0)

fn expect_tag(data: Bytes, pos: Int, tag: Int) -> DerValue!:
    value := read_value(data, pos)!
    if value.tag != tag:
        fail "unexpected der tag"
    return value

fn value_bytes(data: Bytes, value: DerValue) -> Bytes:
    return data.slice(value.value_start, value.value_end)

fn read_oid_value(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_OBJECT_ID:
        fail "expected object id"
    body := value_bytes(data, value)
    if body.len() == 0:
        fail "empty object id"
    first := body[0]
    mut parts: List[String] := []
    if first < 40:
        parts.push("0")
        parts.push(first.to_string())
    elif first < 80:
        parts.push("1")
        parts.push((first - 40).to_string())
    else:
        parts.push("2")
        parts.push((first - 80).to_string())
    mut component := 0
    mut i := 1
    while i < body.len():
        b := body[i]
        component = bits.shl(component, 7) + bits.band(b, 127)
        if bits.band(b, 128) == 0:
            parts.push(component.to_string())
            component = 0
        i = i + 1
    if component != 0:
        fail "truncated object id"
    return parts.join(".")

# decode an object identifier value to dotted form.
pub fn read_oid(data: Bytes, pos: Int) -> String!:
    return read_oid_value(data, expect_tag(data, pos, TAG_OBJECT_ID)!)!

fn read_der_string(data: Bytes, value: DerValue) -> String!:
    if value.tag == TAG_UTF8_STRING or value.tag == TAG_PRINTABLE_STRING or value.tag == TAG_IA5_STRING or value.tag == TAG_UTC_TIME or value.tag == TAG_GENERALIZED_TIME:
        return value_bytes(data, value).to_string_utf8()!
    fail "unsupported der string tag"

fn read_int_hex(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_INTEGER:
        fail "expected integer"
    return encoding.to_hex(value_bytes(data, value))

fn read_bit_string(data: Bytes, value: DerValue) -> Bytes!:
    if value.tag != TAG_BIT_STRING:
        fail "expected bit string"
    body := value_bytes(data, value)
    if body.len() == 0:
        fail "empty bit string"
    if body[0] != 0:
        fail "bit strings with unused bits are not supported"
    return body.slice(1, body.len())

fn read_algorithm_oid(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected algorithm sequence"
    oid_value := expect_tag(data, value.value_start, TAG_OBJECT_ID)!
    return read_oid_value(data, oid_value)!

fn parse_name_common_name(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected name sequence"
    mut pos := value.value_start
    while pos < value.value_end:
        rdn := expect_tag(data, pos, TAG_SET)!
        mut rdn_pos := rdn.value_start
        while rdn_pos < rdn.value_end:
            attr := expect_tag(data, rdn_pos, TAG_SEQUENCE)!
            oid := read_oid(data, attr.value_start)!
            attr_value := read_value(data, read_value(data, attr.value_start)!.next)!
            if oid == OID_COMMON_NAME:
                return read_der_string(data, attr_value)!
            rdn_pos = attr.next
        pos = rdn.next
    return ""

fn parse_validity(data: Bytes, value: DerValue) -> List[String]!:
    if value.tag != TAG_SEQUENCE:
        fail "expected validity sequence"
    first := read_value(data, value.value_start)!
    second := read_value(data, first.next)!
    mut out: List[String] := []
    out.push(read_der_string(data, first)!)
    out.push(read_der_string(data, second)!)
    return out

fn parse_spki_algorithm(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected public key info sequence"
    alg := expect_tag(data, value.value_start, TAG_SEQUENCE)!
    return read_algorithm_oid(data, alg)!

fn parse_spki_public_key(data: Bytes, value: DerValue) -> Bytes!:
    if value.tag != TAG_SEQUENCE:
        fail "expected public key info sequence"
    alg := expect_tag(data, value.value_start, TAG_SEQUENCE)!
    key_bits := expect_tag(data, alg.next, TAG_BIT_STRING)!
    return read_bit_string(data, key_bits)!

fn byte_to_decimal(value: Int) -> String:
    return value.to_string()

fn read_ip_address(data: Bytes, value: DerValue) -> String!:
    body := value_bytes(data, value)
    if body.len() == 4:
        return byte_to_decimal(body[0]) + "." + byte_to_decimal(body[1]) + "." + byte_to_decimal(body[2]) + "." + byte_to_decimal(body[3])
    return encoding.to_hex(body)

fn parse_san(data: Bytes, extn_value: DerValue, dns_names: List[String], ip_addresses: List[String]) -> Bool!:
    inner := value_bytes(data, extn_value)
    names := expect_tag(inner, 0, TAG_SEQUENCE)!
    mut pos := names.value_start
    while pos < names.value_end:
        name := read_value(inner, pos)!
        if name.tag == TAG_DNS_NAME:
            dns_names.push(value_bytes(inner, name).to_string_utf8()!)
        elif name.tag == TAG_IP_ADDRESS:
            ip_addresses.push(read_ip_address(inner, name)!)
        pos = name.next
    return true

# The cA flag and optional pathLenConstraint from a basicConstraints extension.
struct BasicConstraints:
    is_ca: Bool
    has_path_len: Bool
    path_len: Int

# read a small non-negative der integer body into an Int. path lengths are
# tiny; an absurd value is clamped so the multiply can never wrap.
fn der_small_int(body: Bytes) -> Int:
    mut value := 0
    mut i := 0
    while i < body.len():
        if value > 1000000:
            return 1000000
        value = value * 256 + body[i]
        i = i + 1
    return value

fn parse_basic_constraints(data: Bytes, extn_value: DerValue) -> BasicConstraints!:
    inner := value_bytes(data, extn_value)
    seq := expect_tag(inner, 0, TAG_SEQUENCE)!
    if seq.value_start >= seq.value_end:
        return BasicConstraints(false, false, 0)
    mut pos := seq.value_start
    first := read_value(inner, pos)!
    mut is_ca := false
    if first.tag == TAG_BOOLEAN:
        body := value_bytes(inner, first)
        is_ca = body.len() > 0 and body[0] != 0
        pos = first.next
    # pathLenConstraint is only meaningful for a ca and follows the cA boolean.
    if is_ca and pos < seq.value_end:
        next := read_value(inner, pos)!
        if next.tag == TAG_INTEGER:
            return BasicConstraints(true, true, der_small_int(value_bytes(inner, next)))
    return BasicConstraints(is_ca, false, 0)

fn parse_eku(data: Bytes, extn_value: DerValue, eku_oids: List[String]) -> Bool!:
    inner := value_bytes(data, extn_value)
    seq := expect_tag(inner, 0, TAG_SEQUENCE)!
    mut pos := seq.value_start
    while pos < seq.value_end:
        oid_value := expect_tag(inner, pos, TAG_OBJECT_ID)!
        eku_oids.push(read_oid_value(inner, oid_value)!)
        pos = oid_value.next
    return true

# collect the dnsname bases from one generalsubtrees value. we only look at
# dnsname (context tag [2]); other name types are left unconstrained here.
fn collect_dns_subtrees(inner: Bytes, subtrees: DerValue, out: List[String]) -> Bool!:
    mut pos := subtrees.value_start
    while pos < subtrees.value_end:
        subtree := expect_tag(inner, pos, TAG_SEQUENCE)!
        base := read_value(inner, subtree.value_start)!
        if base.tag == TAG_DNS_NAME:
            out.push(value_bytes(inner, base).to_string_utf8()!)
        pos = subtree.next
    return true

fn parse_name_constraints(data: Bytes, extn_value: DerValue, permitted_dns: List[String], excluded_dns: List[String]) -> Bool!:
    inner := value_bytes(data, extn_value)
    constraints := expect_tag(inner, 0, TAG_SEQUENCE)!
    mut pos := constraints.value_start
    while pos < constraints.value_end:
        field := read_value(inner, pos)!
        if field.tag == TAG_PERMITTED_SUBTREES:
            collect_dns_subtrees(inner, field, permitted_dns)!
        elif field.tag == TAG_EXCLUDED_SUBTREES:
            collect_dns_subtrees(inner, field, excluded_dns)!
        pos = field.next
    return true

# whether the keyUsage extension asserts keyCertSign (bit 5). a BIT STRING is
# [unused-bit-count][bits...], MSB first, so keyCertSign sits in bit 2 of the
# first content byte. an absent keyUsage extension permits every usage.
fn parse_key_usage_cert_sign(data: Bytes, extn_value: DerValue) -> Bool!:
    inner := value_bytes(data, extn_value)
    bit_str := expect_tag(inner, 0, TAG_BIT_STRING)!
    body := value_bytes(inner, bit_str)
    if body.len() < 2:
        return false
    return bits.band(bits.shr(body[1], 2), 1) == 1

# extension data gathered in one pass over the certificate's extensions.
struct ParsedExtensions:
    is_ca: Bool
    has_eku: Bool
    has_key_usage: Bool
    key_cert_sign: Bool
    has_path_len: Bool
    path_len: Int

fn parse_extensions(data: Bytes, value: DerValue, dns_names: List[String], ip_addresses: List[String], eku_oids: List[String], permitted_dns: List[String], excluded_dns: List[String]) -> ParsedExtensions!:
    extensions := expect_tag(data, value.value_start, TAG_SEQUENCE)!
    mut is_ca := false
    mut has_eku := false
    mut has_key_usage := false
    mut key_cert_sign := false
    mut has_path_len := false
    mut path_len := 0
    mut pos := extensions.value_start
    while pos < extensions.value_end:
        ext := expect_tag(data, pos, TAG_SEQUENCE)!
        oid_value := read_value(data, ext.value_start)!
        oid := read_oid_value(data, oid_value)!
        mut child_pos := oid_value.next
        mut is_critical := false
        mut child := read_value(data, child_pos)!
        if child.tag == TAG_BOOLEAN:
            # DER criticality flag: any non-zero body byte is TRUE (canonical
            # DER uses 0xFF). absent means false, the default.
            crit_body := value_bytes(data, child)
            is_critical = crit_body.len() > 0 and crit_body[0] != 0
            child_pos = child.next
            child = read_value(data, child_pos)!
        if child.tag != TAG_OCTET_STRING:
            fail "expected extension value"
        if oid == OID_SUBJECT_ALT_NAME:
            parse_san(data, child, dns_names, ip_addresses)!
        elif oid == OID_BASIC_CONSTRAINTS:
            bc := parse_basic_constraints(data, child)!
            is_ca = bc.is_ca
            has_path_len = bc.has_path_len
            path_len = bc.path_len
        elif oid == OID_EXTENDED_KEY_USAGE:
            has_eku = true
            parse_eku(data, child, eku_oids)!
        elif oid == OID_KEY_USAGE:
            has_key_usage = true
            key_cert_sign = parse_key_usage_cert_sign(data, child)!
        elif oid == OID_NAME_CONSTRAINTS:
            parse_name_constraints(data, child, permitted_dns, excluded_dns)!
        elif is_critical:
            # RFC 5280 §4.2 / §6.1: a certificate carrying a critical extension
            # this validator does not recognise MUST be rejected. otherwise a
            # CA-signed CT precertificate (the critical poison extension
            # 1.3.6.1.4.1.11129.2.4.3), or a cert with critical policy or
            # keyUsage restrictions we do not enforce, would validate as an
            # ordinary certificate.
            fail "unrecognised critical extension: " + oid
        pos = ext.next
    return ParsedExtensions(is_ca, has_eku, has_key_usage, key_cert_sign, has_path_len, path_len)

fn skip_optional_tbs_field(tag: Int) -> Bool:
    return tag == 129 or tag == 161 or tag == 130 or tag == 162

fn parse_tbs(data: Bytes, tbs: DerValue, signature_value: Bytes) -> Certificate!:
    mut pos := tbs.value_start
    mut version := 1
    first := read_value(data, pos)!
    if first.tag == 160:
        version_value := expect_tag(data, first.value_start, TAG_INTEGER)!
        version_body := value_bytes(data, version_value)
        if version_body.len() > 0:
            version = version_body[version_body.len() - 1] + 1
        pos = first.next

    serial := expect_tag(data, pos, TAG_INTEGER)!
    pos = serial.next
    signature_alg := expect_tag(data, pos, TAG_SEQUENCE)!
    pos = signature_alg.next
    issuer := expect_tag(data, pos, TAG_SEQUENCE)!
    pos = issuer.next
    validity := expect_tag(data, pos, TAG_SEQUENCE)!
    pos = validity.next
    subject := expect_tag(data, pos, TAG_SEQUENCE)!
    pos = subject.next
    spki := expect_tag(data, pos, TAG_SEQUENCE)!
    pos = spki.next

    validity_parts := parse_validity(data, validity)!
    mut dns_names: List[String] := []
    mut ip_addresses: List[String] := []
    mut eku_oids: List[String] := []
    mut permitted_dns: List[String] := []
    mut excluded_dns: List[String] := []
    mut is_ca := false
    mut has_eku := false
    mut has_key_usage := false
    mut key_cert_sign := false
    mut has_path_len := false
    mut path_len := 0
    while pos < tbs.value_end:
        child := read_value(data, pos)!
        if child.tag == TAG_EXTENSIONS:
            parsed := parse_extensions(data, child, dns_names, ip_addresses, eku_oids, permitted_dns, excluded_dns)!
            is_ca = parsed.is_ca
            has_eku = parsed.has_eku
            has_key_usage = parsed.has_key_usage
            key_cert_sign = parsed.key_cert_sign
            has_path_len = parsed.has_path_len
            path_len = parsed.path_len
        elif not skip_optional_tbs_field(child.tag):
            fail "unexpected tbs certificate field"
        pos = child.next

    issuer_dn := data.slice(issuer.header_start, issuer.next)
    subject_dn := data.slice(subject.header_start, subject.next)
    return Certificate(data, data.slice(tbs.header_start, tbs.next), data.slice(spki.header_start, spki.next), parse_spki_public_key(data, spki)!, signature_value, version, read_int_hex(data, serial)!, read_algorithm_oid(data, signature_alg)!, parse_spki_algorithm(data, spki)!, parse_name_common_name(data, issuer)!, parse_name_common_name(data, subject)!, validity_parts[0], validity_parts[1], dns_names, ip_addresses, is_ca, issuer_dn, subject_dn, has_eku, eku_oids, permitted_dns, excluded_dns, has_key_usage, key_cert_sign, has_path_len, path_len)

# parse a der-encoded x.509 certificate.
pub fn parse_der(data: Bytes) -> Certificate!:
    cert := expect_tag(data, 0, TAG_SEQUENCE)!
    tbs := expect_tag(data, cert.value_start, TAG_SEQUENCE)!
    outer_sig_alg := expect_tag(data, tbs.next, TAG_SEQUENCE)!
    sig_bits := expect_tag(data, outer_sig_alg.next, TAG_BIT_STRING)!
    return parse_tbs(data, tbs, read_bit_string(data, sig_bits)!)!

# parse the first certificate in a pem document.
pub fn parse_pem(text: String) -> Certificate!:
    block := encoding.pem_decode(text)!
    if block.kind != "CERTIFICATE":
        fail "pem block is not a certificate"
    return parse_der(block.body)!

# parse every certificate in a pem document.
pub fn parse_pem_chain(text: String) -> List[Certificate]!:
    blocks := encoding.pem_decode_all(text)!
    mut certs: List[Certificate] := []
    for block in blocks:
        if block.kind == "CERTIFICATE":
            certs.push(parse_der(block.body)!)
    if certs.len() == 0:
        fail "pem certificate not found"
    return certs

fn host_is_ip(host: String) -> Bool:
    if host.contains(":"):
        return true
    parts := host.split(".")
    if parts.len() != 4:
        return false
    for part in parts:
        if part.len() == 0:
            return false
        n := parse_int(part)
        if n.is_err:
            return false
        if n.ok < 0 or n.ok > 255:
            return false
    return true

fn wildcard_matches(pattern: String, host: String) -> Bool:
    if not pattern.starts_with("*."):
        return false
    suffix := pattern.substring(1, pattern.len())
    if not host.ends_with(suffix):
        return false
    prefix_len := host.len() - suffix.len()
    if prefix_len <= 0:
        return false
    return not host.substring(0, prefix_len).contains(".")

# match a hostname or ip address against the certificate's san list. legacy
# certificates without any san entries (auto-generated database certs are the
# common case) fall back to the subject common name.
pub fn matches_hostname(cert: Certificate, host: String) -> Bool:
    target := host.to_lower()
    for ip in cert.ip_addresses:
        if ip.to_lower() == target:
            return true
    if host_is_ip(target):
        return false
    for name in cert.dns_names:
        pattern := name.to_lower()
        if pattern == target or wildcard_matches(pattern, target):
            return true
    # deliberately NO Common Name fallback. RFC 9525 (and every modern TLS
    # client since ~2017) matches a hostname only against subjectAltName; a
    # CN-only certificate matches nothing here. this also closes a
    # name-constraint bypass: a name-constrained sub-CA could issue a leaf
    # with NO SAN and an arbitrary CN (CN=www.bank.com), which
    # name_constraints_permit_leaf — checking only SAN dnsNames — waved
    # through, and a CN fallback would then have matched. subject_common_name
    # remains available for display, just not for identity.
    return false

impl Certificate:
    fn matches_hostname(host: String) -> Bool:
        return matches_hostname(self, host)

# candidate-selection check: does `issuer` look like the certificate that
# signed `cert`? we compare the full distinguished names byte-for-byte rather
# than just the common name. this only narrows which issuer we try; the
# signature check in verify_signature is the real gate.
fn issuer_matches(cert: Certificate, issuer: Certificate) -> Bool:
    return cert.issuer_dn.len() > 0 and bytes.eq(cert.issuer_dn, issuer.subject_dn)

# a tls server leaf may carry an extendedKeyUsage extension. when it does, it
# must allow serverAuth (or the anyExtendedKeyUsage escape hatch); a cert that
# lists only clientAuth, emailProtection, codeSigning, etc. is being misused as
# a server certificate and is rejected. an absent eku extension permits any
# purpose per rfc 5280, so those certs pass.
fn leaf_permits_server_auth(cert: Certificate) -> Bool:
    if not cert.has_eku:
        return true
    for oid in cert.eku_oids:
        if oid == OID_SERVER_AUTH or oid == OID_ANY_EKU:
            return true
    return false

# rfc 5280 dnsname constraint match: a constraint of "example.com" matches
# "example.com" and any subdomain; a leading-dot constraint (".example.com")
# matches subdomains only. an empty constraint matches everything.
fn dns_constraint_matches(constraint: String, name: String) -> Bool:
    c := constraint.to_lower()
    n := name.to_lower()
    if c == "":
        return true
    if c.starts_with("."):
        return n.ends_with(c)
    if n == c:
        return true
    return n.ends_with("." + c)

# enforce a ca's dnsname name-constraints against the leaf's dns sans. a leaf
# name inside an excluded subtree is rejected; when the ca lists permitted
# dnsname subtrees, every leaf dns name must fall inside one of them. only
# dnsname constraints are enforced (see module notes); other name types pass.
fn name_constraints_permit_leaf(leaf: Certificate, ca: Certificate) -> Bool:
    for name in leaf.dns_names:
        for excluded in ca.excluded_dns:
            if dns_constraint_matches(excluded, name):
                return false
    if ca.permitted_dns.len() > 0:
        for name in leaf.dns_names:
            mut inside := false
            for permitted in ca.permitted_dns:
                if dns_constraint_matches(permitted, name):
                    inside = true
            if not inside:
                return false
    return true

# read two ascii digits at `start` as an integer.
#
# the bytes are read in place rather than sliced out. len() counts bytes and
# substring() takes byte offsets, so the length check above proves nothing
# about where these cuts land, and a cut through a multi-byte character stops
# the process — during a handshake, on a certificate that has not been verified
# yet and whose contents the peer chose. checking each byte is an ascii digit
# proves exactly what the cut needed proving, and rejects the field either way.
fn parse_two_digits(text: String, start: Int) -> Int!:
    if start < 0 or start + 2 > text.len():
        fail "invalid der time digits"
    tens := ord(text[start]) - 48
    ones := ord(text[start + 1]) - 48
    if tens < 0 or tens > 9 or ones < 0 or ones > 9:
        fail "invalid der time digits"
    return tens * 10 + ones

# days from the unix epoch (1970-01-01) to a civil date, via howard hinnant's
# well-known algorithm. valid for any proleptic gregorian date; certificate
# dates are always well inside its range.
fn days_from_civil(year: Int, month: Int, day: Int) -> Int:
    mut y := year
    if month <= 2:
        y = y - 1
    era := y / 400
    year_of_era := y - era * 400
    # shift so march is month 0, which keeps the leap day at the year's end.
    mut month_index := month + 9
    if month > 2:
        month_index = month - 3
    day_of_year := (153 * month_index + 2) / 5 + day - 1
    day_of_era := year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468

# convert an x.509 validity timestamp to unix epoch milliseconds.
#
# rfc 5280 pins both encodings to utc with whole seconds: utctime as
# yymmddhhmmssz (13 chars) and generalizedtime as yyyymmddhhmmssz (15 chars).
# we reject anything else rather than risk reading a local time as utc.
fn der_time_to_epoch_ms(text: String) -> Int!:
    if not text.ends_with("Z"):
        fail "der time is not utc"
    mut year := 0
    mut idx := 0
    if text.len() == 13:
        # utctime two-digit year: rfc 5280 reads >= 50 as 19yy, else 20yy.
        yy := parse_two_digits(text, 0)!
        if yy >= 50:
            year = 1900 + yy
        else:
            year = 2000 + yy
        idx = 2
    elif text.len() == 15:
        year = parse_two_digits(text, 0)! * 100 + parse_two_digits(text, 2)!
        idx = 4
    else:
        fail "unsupported der time length"
    month := parse_two_digits(text, idx)!
    day := parse_two_digits(text, idx + 2)!
    hour := parse_two_digits(text, idx + 4)!
    minute := parse_two_digits(text, idx + 6)!
    second := parse_two_digits(text, idx + 8)!
    if month < 1 or month > 12 or day < 1 or day > 31:
        fail "der time has an invalid date"
    days := days_from_civil(year, month, day)
    epoch_seconds := ((days * 24 + hour) * 60 + minute) * 60 + second
    return epoch_seconds * 1000

# true when `now_ms` falls inside the certificate's validity window. a leaked
# but expired (or not-yet-valid) certificate must not verify, otherwise an
# attacker holding an old cert+key for the hostname could impersonate the
# server indefinitely. an unparseable timestamp fails closed.
fn validity_contains(cert: Certificate, now_ms: Int) -> Bool:
    not_before := der_time_to_epoch_ms(cert.not_before)
    not_after := der_time_to_epoch_ms(cert.not_after)
    if not_before.is_err or not_after.is_err:
        return false
    if now_ms < not_before.ok:
        return false
    if now_ms > not_after.ok:
        return false
    return true

EXPIRED_REASON := "certificate is expired or not yet valid"
EKU_REASON := "certificate is not valid for tls server authentication"
NAME_CONSTRAINT_REASON := "certificate name is outside a ca name constraint"
KEY_USAGE_REASON := "certificate issuer is not permitted to sign certificates"
PATH_LEN_REASON := "certificate chain exceeds a ca path length constraint"

fn verify_signature_for_algorithm(cert: Certificate, issuer: Certificate) -> Bool:
    if cert.signature_algorithm == "1.2.840.113549.1.1.11":
        return signature.verify_rsa_pkcs1_sha256(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.113549.1.1.12":
        return signature.verify_rsa_pkcs1_sha384(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.10045.4.3.2":
        return signature.verify_ecdsa_p256_sha256_asn1(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.10045.4.3.3":
        return signature.verify_ecdsa_p384_sha384_asn1(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.3.101.112":
        return signature.verify_ed25519(issuer.subject_public_key, cert.tbs_der, cert.signature)
    return false

# verify a certificate signature with its issuer certificate.
pub fn verify_signature(cert: Certificate, issuer: Certificate) -> Bool:
    if cert.signature.len() == 0 or cert.tbs_der.len() == 0:
        return false
    return verify_signature_for_algorithm(cert, issuer)

fn verification_reason(hostname_ok: Bool, issuer_ok: Bool, root_ca_ok: Bool, signature_verified: Bool) -> String:
    if not hostname_ok:
        return "hostname does not match certificate san"
    if not issuer_ok:
        return "issuer does not match trusted root metadata"
    if not root_ca_ok:
        return "trusted root is not a ca certificate"
    if not signature_verified:
        return "certificate signature verification failed"
    return "ok"

fn find_issuer_in_chain(cert: Certificate, chain: List[Certificate], start: Int) -> Certificate!:
    mut i := start
    while i < chain.len():
        candidate := chain[i]
        if issuer_matches(cert, candidate):
            return candidate
        i = i + 1
    fail "issuer not found in chain"

fn find_issuer_in_roots(cert: Certificate, roots: List[Certificate]) -> Certificate!:
    for root in roots:
        if issuer_matches(cert, root):
            return root
    fail "issuer not found in trusted roots"

fn verify_chain_issuers(chain: List[Certificate], trusted_roots: List[Certificate], hostname_ok: Bool) -> VerificationResult:
    # one clock read for the whole walk so every certificate is judged against
    # the same instant.
    now_ms := time.now()
    # the leaf must be within its validity window before we trust it, even on
    # the pinned-certificate fast path below.
    if not validity_contains(chain[0], now_ms):
        return VerificationResult(false, hostname_ok, false, false, false, EXPIRED_REASON)
    # a trust anchor byte-identical to the leaf is a pinned certificate:
    # trusting the exact certificate needs no ca bit and no chain walk. this
    # is how self-signed servers (a dev postgres or a database with an
    # auto-generated cert) verify — pass the server's own pem as the ca file.
    for root in trusted_roots:
        if bytes.eq(root.der, chain[0].der):
            return VerificationResult(hostname_ok, hostname_ok, true, true, true, verification_reason(hostname_ok, true, true, true))
    mut current := chain[0]
    mut next_chain_index := 1
    mut issuer_ok := false
    mut root_ca_ok := false
    mut signature_verified := false
    mut depth := 0
    while depth < chain.len() + trusted_roots.len() + 1:
        issuer_from_chain := find_issuer_in_chain(current, chain, next_chain_index)
        if issuer_from_chain.is_ok:
            issuer := issuer_from_chain.ok
            # an expired intermediate breaks trust just as a bad signature does.
            if not validity_contains(issuer, now_ms):
                return VerificationResult(false, hostname_ok, true, false, false, EXPIRED_REASON)
            issuer_ok = true
            root_ca_ok = issuer.is_ca
            signature_verified = verify_signature(current, issuer)
            if not root_ca_ok or not signature_verified:
                return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, verification_reason(hostname_ok, issuer_ok, root_ca_ok, signature_verified))
            # a ca with a keyUsage that omits keyCertSign may not sign a
            # certificate, and a pathLenConstraint bounds how many intermediates
            # may sit below it (next_chain_index-1 of them do here).
            if issuer.has_key_usage and not issuer.key_cert_sign:
                return VerificationResult(false, hostname_ok, issuer_ok, false, signature_verified, KEY_USAGE_REASON)
            if issuer.has_path_len and next_chain_index - 1 > issuer.path_len:
                return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, PATH_LEN_REASON)
            # a name-constrained intermediate may not sign outside its namespace.
            if not name_constraints_permit_leaf(chain[0], issuer):
                return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, NAME_CONSTRAINT_REASON)
            current = issuer
            next_chain_index = next_chain_index + 1
        else:
            root_result := find_issuer_in_roots(current, trusted_roots)
            if root_result.is_err:
                return VerificationResult(false, hostname_ok, false, false, false, "certificate issuer is not trusted")
            root := root_result.ok
            # the trust anchor is rejected once it falls outside its window.
            if not validity_contains(root, now_ms):
                return VerificationResult(false, hostname_ok, true, false, false, EXPIRED_REASON)
            issuer_ok = true
            root_ca_ok = root.is_ca
            signature_verified = verify_signature(current, root)
            if root_ca_ok and signature_verified and root.has_key_usage and not root.key_cert_sign:
                return VerificationResult(false, hostname_ok, issuer_ok, false, signature_verified, KEY_USAGE_REASON)
            if root_ca_ok and signature_verified and root.has_path_len and next_chain_index - 1 > root.path_len:
                return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, PATH_LEN_REASON)
            # a name-constrained root may not anchor a chain outside its namespace.
            if root_ca_ok and signature_verified and not name_constraints_permit_leaf(chain[0], root):
                return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, NAME_CONSTRAINT_REASON)
            ok := hostname_ok and issuer_ok and root_ca_ok and signature_verified
            return VerificationResult(ok, hostname_ok, issuer_ok, root_ca_ok, signature_verified, verification_reason(hostname_ok, issuer_ok, root_ca_ok, signature_verified))
        depth = depth + 1
    return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, "certificate chain is too deep")

# check the server name against the certificate san list.
pub fn verify_hostname(cert: Certificate, host: String) -> VerificationResult:
    hostname_ok := matches_hostname(cert, host)
    return VerificationResult(hostname_ok, hostname_ok, true, true, true, verification_reason(hostname_ok, true, true, true))

# run the native trust preflight for a server certificate and root.
#
# this checks hostname, issuer metadata, ca constraints, and certificate signature.
pub fn preflight_server_certificate(cert: Certificate, trusted_root: Certificate, host: String) -> VerificationResult:
    hostname_ok := matches_hostname(cert, host)
    # both the leaf and the trust anchor must be inside their validity windows.
    now_ms := time.now()
    if not validity_contains(cert, now_ms) or not validity_contains(trusted_root, now_ms):
        return VerificationResult(false, hostname_ok, false, false, false, EXPIRED_REASON)
    # a leaf whose eku forbids server authentication is being misused as a
    # server certificate, even if it chains and its name matches.
    if not leaf_permits_server_auth(cert):
        return VerificationResult(false, hostname_ok, false, false, false, EKU_REASON)
    issuer_ok := issuer_matches(cert, trusted_root)
    root_ca_ok := trusted_root.is_ca
    signature_verified := verify_signature(cert, trusted_root)
    ok := hostname_ok and issuer_ok and root_ca_ok and signature_verified
    return VerificationResult(ok, hostname_ok, issuer_ok, root_ca_ok, signature_verified, verification_reason(hostname_ok, issuer_ok, root_ca_ok, signature_verified))

# verify a server certificate chain against trusted roots.
pub fn verify_server_chain(chain: List[Certificate], trusted_roots: List[Certificate], host: String) -> VerificationResult:
    if chain.len() == 0:
        return VerificationResult(false, false, false, false, false, "certificate chain is empty")
    if trusted_roots.len() == 0:
        return VerificationResult(false, false, false, false, false, "trusted roots are empty")
    leaf := chain[0]
    hostname_ok := matches_hostname(leaf, host)
    if not hostname_ok:
        return VerificationResult(false, false, true, true, true, verification_reason(false, true, true, true))
    # reject a leaf whose extendedKeyUsage does not permit tls server auth
    # before doing the more expensive chain walk.
    if not leaf_permits_server_auth(leaf):
        return VerificationResult(false, hostname_ok, false, false, false, EKU_REASON)

    return verify_chain_issuers(chain, trusted_roots, hostname_ok)

# verify a client certificate chain against trusted roots.
pub fn verify_client_chain(chain: List[Certificate], trusted_roots: List[Certificate]) -> VerificationResult:
    if chain.len() == 0:
        return VerificationResult(false, true, false, false, false, "certificate chain is empty")
    if trusted_roots.len() == 0:
        return VerificationResult(false, true, false, false, false, "trusted roots are empty")
    return verify_chain_issuers(chain, trusted_roots, true)

test "x509 does not match a hostname against a certificate's common name":
    # a leaf with NO subjectAltName and CN=www.bank.com must not match the
    # hostname www.bank.com — RFC 9525, and the close of a name-constraint
    # bypass (a constrained sub-CA could mint such a leaf for any name).
    cert := parse_pem(read_file("tests/live/fixtures/cn-only-no-san.crt")!)!
    assert_eq(cert.subject_common_name, "www.bank.com")
    assert(not cert.matches_hostname("www.bank.com"))
    # a cert that carries the name as a SAN still matches (the localhost
    # fixture has DNS:localhost).
    ok := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    assert(ok.matches_hostname("localhost"))

test "x509 rejects a certificate carrying an unrecognised critical extension":
    # a CT precertificate is a CA-signed cert whose only mark of not-a-real-cert
    # is the critical poison extension 1.3.6.1.4.1.11129.2.4.3. RFC 5280 requires
    # rejecting an unrecognised critical extension; accepting it would let a
    # precert pulled from a public CT log validate as a genuine certificate.
    result := parse_pem(read_file("tests/live/fixtures/poison-critical-ext.crt")!)
    assert(result.is_err)
    # a benign cert with a critical keyUsage (which this validator DOES
    # recognise) must still parse — the localhost fixture carries exactly that.
    ok := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)
    assert(ok.is_ok)

test "x509 rejects a clientauth-only leaf used as a server certificate":
    # this leaf is legitimately issued and chains to its ca, but its
    # extendedKeyUsage lists only clientAuth. it must not verify as a server
    # certificate even though the hostname and signature are fine.
    leaf := parse_pem(read_file("tests/live/fixtures/clientauth-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/eku-ca.crt")!)!

    assert(leaf.has_eku)
    assert(not leaf.eku_oids.contains(OID_SERVER_AUTH))

    server := verify_server_chain([leaf], [ca], "localhost")
    assert(not server.ok)
    assert_eq(server.reason, EKU_REASON)

    # the same certificate is valid for client authentication, proving it is a
    # real chain that we reject only for the wrong purpose.
    client := verify_client_chain([leaf], [ca])
    assert(client.ok)

test "x509 accepts a serverauth leaf and an eku-less leaf":
    # localhost.crt carries a serverAuth eku and must be accepted.
    with_eku := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    assert(with_eku.has_eku)
    assert(with_eku.eku_oids.contains(OID_SERVER_AUTH))
    good := verify_server_chain([with_eku], [ca], "localhost")
    assert(good.ok)

    # a certificate with no eku extension is valid for any purpose, so the
    # server-auth check must not reject it.
    assert(not ca.has_eku)
    assert(leaf_permits_server_auth(ca))

test "x509 enforces dnsname name-constraints on the chain":
    good := parse_pem(read_file("tests/live/fixtures/nc-good-leaf.crt")!)!
    bad := parse_pem(read_file("tests/live/fixtures/nc-bad-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/nc-ca.crt")!)!

    assert(ca.permitted_dns.contains("example.com"))

    # good.example.com falls inside the permitted example.com subtree.
    inside := verify_server_chain([good], [ca], "good.example.com")
    assert(inside.ok)

    # evil.com is outside the permitted subtree; the constrained ca may not
    # anchor it even though the signature verifies and the hostname matches.
    outside := verify_server_chain([bad], [ca], "evil.com")
    assert(not outside.ok)
    assert_eq(outside.reason, NAME_CONSTRAINT_REASON)

test "der oid decoder reads common object ids":
    data := encoding.from_hex("0603551D11")!
    assert_eq(read_oid(data, 0)!, OID_SUBJECT_ALT_NAME)

test "x509 parses tls fixture certificates":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!

    assert_eq(cert.version, 3)
    assert_eq(cert.subject_common_name, "localhost")
    assert_eq(cert.issuer_common_name, "pith-test-ca")
    assert_eq(cert.signature_algorithm, "1.2.840.113549.1.1.11")
    assert_eq(cert.public_key_algorithm, "1.2.840.113549.1.1.1")
    assert(cert.tbs_der.len() > 0)
    assert(cert.subject_public_key_info.len() > 0)
    assert(cert.subject_public_key.len() > 0)
    assert(cert.signature.len() > 0)
    assert(cert.dns_names.contains("localhost"))
    assert(cert.ip_addresses.contains("127.0.0.1"))
    assert(not cert.is_ca)
    assert(ca.is_ca)

test "x509 hostname matching uses san names":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!

    assert(cert.matches_hostname("localhost"))
    assert(cert.matches_hostname("127.0.0.1"))
    assert(not cert.matches_hostname("example.com"))

test "x509 parses pem certificate chains":
    chain := read_file("tests/live/fixtures/localhost.crt")! + read_file("tests/live/fixtures/localhost-ca.crt")!
    certs := parse_pem_chain(chain)!

    assert_eq(certs.len(), 2)
    assert_eq(certs[0].subject_common_name, "localhost")
    assert_eq(certs[1].subject_common_name, "pith-test-ca")

test "x509 trust preflight verifies fixture signature":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := preflight_server_certificate(cert, ca, "localhost")
    bad_host := preflight_server_certificate(cert, ca, "example.com")

    assert(verify_signature(cert, ca))
    assert(good.hostname_ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(good.ok)
    assert_eq(good.reason, "ok")
    assert(not bad_host.hostname_ok)

test "x509 verifies server chains against trusted roots":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := verify_server_chain([cert], [ca], "localhost")
    bad_host := verify_server_chain([cert], [ca], "example.com")
    bad_roots := verify_server_chain([cert], [], "localhost")

    assert(good.ok)
    assert(good.hostname_ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(not bad_host.ok)
    assert(not bad_host.hostname_ok)
    assert(not bad_roots.ok)

test "x509 enforces keyCertSign and pathLenConstraint on ca certificates":
    fx := "tests/live/fixtures/"
    root := parse_pem(read_file(fx + "constraint-root.crt")!)!
    # a well-formed chain through a keyCertSign ca still verifies.
    good := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-good.crt")!)!, parse_pem(read_file(fx + "constraint-int-good.crt")!)!], [root], "leaf.test")
    assert(good.ok)
    # an intermediate whose keyUsage omits keyCertSign may not sign the leaf.
    no_sign := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-no-keycertsign.crt")!)!, parse_pem(read_file(fx + "constraint-int-no-keycertsign.crt")!)!], [root], "leaf.test")
    assert(not no_sign.ok)
    assert_eq(no_sign.reason, KEY_USAGE_REASON)
    # a pathlen:0 intermediate may not have another intermediate below it.
    too_deep := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-pathlen.crt")!)!, parse_pem(read_file(fx + "constraint-int-below-pathlen0.crt")!)!, parse_pem(read_file(fx + "constraint-int-pathlen0.crt")!)!], [root], "leaf.test")
    assert(not too_deep.ok)
    assert_eq(too_deep.reason, PATH_LEN_REASON)

test "x509 verifies client chains against trusted roots":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := verify_client_chain([cert], [ca])
    bad_roots := verify_client_chain([cert], [])

    assert(good.ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(not bad_roots.ok)

test "x509 verifies an ecdsa p-384 sha-384 chain signature":
    leaf := parse_pem(read_file("tests/live/fixtures/p384-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/p384-ca.crt")!)!

    # public ca intermediates sign with ecdsa-with-sha384; this is the
    # algorithm the tls client needs to walk a real chain to a public root.
    assert_eq(leaf.signature_algorithm, "1.2.840.10045.4.3.3")
    assert(verify_signature(leaf, ca))
    # a leaf does not verify against its own key.
    assert(not verify_signature(leaf, leaf))

test "x509 verifies an rsa sha-384 chain signature":
    leaf := parse_pem(read_file("tests/live/fixtures/rsa384-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/rsa384-ca.crt")!)!

    assert_eq(leaf.signature_algorithm, "1.2.840.113549.1.1.12")
    assert(verify_signature(leaf, ca))
    assert(not verify_signature(leaf, leaf))

test "x509 der time parses utctime and generalizedtime to epoch millis":
    # unix epoch expressed as a two-digit utctime year.
    assert_eq(der_time_to_epoch_ms("700101000000Z")!, 0)
    # a full generalizedtime; 2020-01-01 00:00:00 utc.
    assert_eq(der_time_to_epoch_ms("20200101000000Z")!, 1577836800000)
    # utctime years below 50 resolve into the 2000s, matching generalizedtime.
    assert_eq(der_time_to_epoch_ms("260721123456Z")!, der_time_to_epoch_ms("20260721123456Z")!)
    # a timestamp without the mandatory utc marker is rejected, not misread.
    assert(der_time_to_epoch_ms("20200101000000").is_err)
    # a field that is the right length and ends in the marker but is not ascii
    # digits. the digits used to be sliced two at a time, and a String is cut in
    # bytes, so a multi-byte character straddling one of those cuts stopped the
    # process — during a handshake, on a certificate nobody had verified yet.
    # "7é101000000Z" is thirteen bytes with the character sitting across the
    # first cut.
    assert(der_time_to_epoch_ms("7é101000000Z").is_err)
    # the same, fifteen bytes, for the generalizedtime branch.
    assert(der_time_to_epoch_ms("2é01010000000Z").is_err)

test "x509 rejects an expired certificate":
    expired := parse_pem(read_file("tests/live/fixtures/expired-localhost.crt")!)!
    # the hostname still matches, but the window closed in 2021, so both the
    # pinned-trust fast path and the preflight must refuse the certificate.
    pinned := verify_server_chain([expired], [expired], "localhost")
    preflight := preflight_server_certificate(expired, expired, "localhost")

    assert(expired.matches_hostname("localhost"))
    assert(not pinned.ok)
    assert_eq(pinned.reason, EXPIRED_REASON)
    assert(not preflight.ok)
    assert_eq(preflight.reason, EXPIRED_REASON)

test "x509 fixture key signs rsa pss messages":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    key := encoding.pem_decode(read_file("tests/live/fixtures/localhost.key")!)!
    message := bytes.from_string_utf8("pith signature")
    sig := signature.sign_rsa_pss_sha256_pkcs8(key.body, message)!

    assert(signature.verify_rsa_pss_sha256(cert.subject_public_key, message, sig))
