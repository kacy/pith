# std.otlp - encode pith spans and metrics as OTLP protobuf and push them.
#
# OTLP (the OpenTelemetry protocol) is how a program ships its traces and
# metrics to a collector. this module does two things:
#
#   - encode: turn std.trace spans and std.metrics samples into the protobuf
#     wire form of an ExportTraceServiceRequest / ExportMetricsServiceRequest,
#     built by hand on top of std.protobuf the same way the database drivers
#     hand-write their wire protocols. there is no `.proto` code generation.
#   - export: POST that protobuf to an OTLP/HTTP collector at /v1/traces or
#     /v1/metrics with content-type application/x-protobuf. the export path is
#     production-grade: it sends configured auth headers, honors a per-request
#     timeout, optionally gzip-compresses the body, and retries transient
#     failures (429/5xx and transport errors) with exponential backoff.
#
# std.obs.init wires this up from the environment; you rarely call it directly.
#
# scope (v1): spans with typed (string/int/bool/double) attributes and a status;
# counter and gauge metrics in full; histograms as a count+sum data point (no
# per-bucket detail, see encode_metrics). transport is OTLP/HTTP only — grpc is
# not implemented.

import std.bytes as bytes
import std.compress.gzip as gzip
import std.encoding as encoding
import std.env as env
import std.metrics as metrics
import std.net.http as http
import std.net.tls as tls
import std.net.url as url_mod
import std.protobuf as protobuf
import std.strings as strings
import std.time as time
import std.trace as trace

# the telemetry.sdk.version reported on every exported resource.
SDK_VERSION := "0.1.0"

# the OTLP/HTTP protocol value obs uses by default.
pub PROTOCOL_HTTP := "http/protobuf"
# the OTLP/grpc protocol value (recognized but not implemented in v1).
pub PROTOCOL_GRPC := "grpc"

# the content type an OTLP/HTTP collector expects for a protobuf body.
pub OTLP_CONTENT_TYPE := "application/x-protobuf"

# the standard OTLP/HTTP port, used when an endpoint gives no explicit port.
pub DEFAULT_HTTP_PORT := 4318

# the default per-request timeout (ms) for an export POST when the target sets
# none. obs also uses this as the OTEL_EXPORTER_OTLP_TIMEOUT fallback.
pub DEFAULT_TIMEOUT_MS := 10000

# retry policy for a transient export failure. we try an export up to
# MAX_EXPORT_ATTEMPTS times, backing off BACKOFF_BASE_MS and doubling each retry
# up to BACKOFF_MAX_MS. the exporter is best-effort, so once these are exhausted
# the batch is dropped rather than blocking the program.
MAX_EXPORT_ATTEMPTS := 5
BACKOFF_BASE_MS := 1000
BACKOFF_MAX_MS := 30000

# OTLP AggregationTemporality.CUMULATIVE — the only temporality pith reports,
# since std.metrics counters and histograms accumulate for the process lifetime.
CUMULATIVE := 2

# where to send exported telemetry: a collector origin plus the resource's
# service.name. build one with target() from an OTEL_EXPORTER_OTLP_ENDPOINT.
pub struct Target:
    pub service_name: String
    # the resource's service.version ("" when unset); reported as a resource attr.
    pub service_version: String
    # the resource's service.instance.id ("" when unset); reported as a resource attr.
    pub service_instance_id: String
    pub host: String
    pub port: Int
    pub use_tls: Bool
    # any path prefix from the endpoint (usually ""); /v1/traces is appended.
    pub base_path: String
    # "http/protobuf" or "grpc"; only http/protobuf is implemented.
    pub protocol: String
    # extra request headers as a flat [k1, v1, k2, v2, ...] list, sent on every
    # export POST. this is how OTEL_EXPORTER_OTLP_HEADERS auth/tenant headers
    # (e.g. "x-honeycomb-team=KEY") reach a SaaS collector.
    pub headers: List[String]
    # per-request timeout in ms; 0 or less leaves the http client default.
    pub timeout_ms: Int
    # when true, gzip-compress each export body and set Content-Encoding: gzip.
    pub use_gzip: Bool

# build a Target from a service name, an endpoint like http://host:4318, and a
# protocol. an https endpoint turns tls on; a missing port defaults to 4318. a
# trailing "/" on the endpoint path is dropped so /v1/traces joins cleanly. the
# resource carries only service.name; use target_with_resource to add a version
# and instance id.
pub fn target(service_name: String, endpoint: String, protocol: String) -> Target:
    return target_with_resource(service_name, "", "", endpoint, protocol)

# like target(), but also records a service.version and service.instance.id on
# the resource (either may be "" to omit it). std.obs fills these in from the
# environment and a generated instance id.
pub fn target_with_resource(service_name: String, service_version: String, service_instance_id: String, endpoint: String, protocol: String) -> Target:
    parsed := url_mod.parse(endpoint)
    use_tls := parsed.scheme == "https"
    mut port := parsed.port
    if port < 0:
        port = DEFAULT_HTTP_PORT
    mut base_path := parsed.path
    if base_path == "/":
        base_path = ""
    if base_path.len() > 0 and base_path.ends_with("/"):
        base_path = base_path.substring(0, base_path.len() - 1)
    # start with no extra headers, the default timeout, and gzip off; callers
    # layer transport options on with the with_* setters below.
    no_headers: List[String] := []
    return Target(service_name, service_version, service_instance_id, parsed.host, port, use_tls, base_path, protocol, no_headers, DEFAULT_TIMEOUT_MS, false)

impl Target:
    # a copy of this target that sends `headers` (a flat [k1, v1, ...] list) on
    # every export request, carrying OTEL_EXPORTER_OTLP_HEADERS auth/tenant headers.
    fn with_headers(headers: List[String]) -> Target:
        return Target(self.service_name, self.service_version, self.service_instance_id, self.host, self.port, self.use_tls, self.base_path, self.protocol, headers, self.timeout_ms, self.use_gzip)

    # a copy with a per-request timeout in ms; 0 or less leaves the client default.
    fn with_timeout(timeout_ms: Int) -> Target:
        return Target(self.service_name, self.service_version, self.service_instance_id, self.host, self.port, self.use_tls, self.base_path, self.protocol, self.headers, timeout_ms, self.use_gzip)

    # a copy that gzip-compresses each export body and sets Content-Encoding: gzip.
    fn with_gzip(use_gzip: Bool) -> Target:
        return Target(self.service_name, self.service_version, self.service_instance_id, self.host, self.port, self.use_tls, self.base_path, self.protocol, self.headers, self.timeout_ms, use_gzip)

# --- trace encoding ---------------------------------------------------------

# decode a hex id (32 chars for a trace id, 16 for a span id) into exactly
# `width` bytes, since OTLP carries ids as raw bytes rather than hex. a
# malformed or short id falls back to zero-fill so encoding never fails on it.
fn id_bytes(hex: String, width: Int) -> Bytes:
    decoded := encoding.from_hex(hex) catch bytes.empty()
    if decoded.len() == width:
        return decoded
    # normalize to exactly `width` bytes: copy what we have, zero-pad the rest.
    buf := bytes.buffer_with_capacity(width)
    mut i := 0
    while i < width:
        if i < decoded.len():
            buf.write_byte(decoded[i]) catch 0
        else:
            buf.write_byte(0) catch 0
        i = i + 1
    out := buf.bytes()
    buf.free()
    return out

# encode one KeyValue { key = 1, value = AnyValue { ... } } for a typed span
# attribute. the AnyValue field is chosen by the attribute's kind:
# string_value=1, bool_value=2, int_value=3, double_value=4.
fn encode_attr(attr: trace.Attr) -> Bytes!protobuf.ProtoError:
    any_value := protobuf.writer()
    if attr.kind == trace.ATTR_INT:
        any_value.write_int64(3, attr.i)!
    elif attr.kind == trace.ATTR_BOOL:
        any_value.write_bool(2, attr.b)!
    elif attr.kind == trace.ATTR_FLOAT:
        any_value.write_double(4, attr.f)!
    else:
        any_value.write_string(1, attr.s)!
    any_bytes := any_value.bytes()
    any_value.free()

    kv := protobuf.writer()
    kv.write_string(1, attr.key)!
    kv.write_message(2, any_bytes)!
    out := kv.bytes()
    kv.free()
    return out

# encode one KeyValue with a plain string value — used for resource attributes,
# which are always strings. a thin wrapper over encode_attr.
fn encode_string_key_value(key: String, value: String) -> Bytes!protobuf.ProtoError:
    return encode_attr(trace.Attr(key, trace.ATTR_STRING, value, 0, false, 0.0))!

# write a list of typed attributes as repeated KeyValue messages under the given
# field number (span attributes are field 9).
fn write_attributes(w: protobuf.Writer, field: Int, attrs: List[trace.Attr]) -> Bool!protobuf.ProtoError:
    for attr in attrs:
        w.write_message(field, encode_attr(attr)!)!
    return true

# write a flat [k1,v1,k2,v2,...] string attribute list as repeated KeyValue
# messages under the given field number. metric labels are string-only, so they
# ride the simpler flat representation rather than typed Attrs.
fn write_string_attributes(w: protobuf.Writer, field: Int, pairs: List[String]) -> Bool!protobuf.ProtoError:
    mut i := 0
    while i + 1 < pairs.len():
        w.write_message(field, encode_string_key_value(pairs[i], pairs[i + 1])!)!
        i = i + 2
    return true

# encode a Status { message = 2, code = 3 }.
fn encode_status(code: Int, message: String) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    if message != "":
        w.write_string(2, message)!
    w.write_enum(3, code)!
    out := w.bytes()
    w.free()
    return out

# encode one Span.Event { time_unix_nano=1 (fixed64), name=2, attributes=3,
# dropped_attributes_count=4 }.
fn encode_event(event: trace.SpanEvent) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_fixed64(1, event.time_unix_ns)!
    w.write_string(2, event.name)!
    write_attributes(w, 3, event.attrs)!
    out := w.bytes()
    w.free()
    return out

# encode one Span.Link { trace_id=1 (16 bytes), span_id=2 (8 bytes),
# attributes=3, dropped_attributes_count=4 }. pith links carry only the ids.
fn encode_link(link: trace.Link) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_bytes(1, id_bytes(link.trace_id, 16))!
    w.write_bytes(2, id_bytes(link.span_id, 8))!
    out := w.bytes()
    w.free()
    return out

# encode one Span. field numbers follow opentelemetry.proto.trace.v1.Span:
# trace_id=1, span_id=2, parent_span_id=4, name=5, kind=6, start=7, end=8,
# attributes=9, dropped_attributes_count=10, events=11, dropped_events_count=12,
# links=13, dropped_links_count=14, status=15. ids are bytes; the two timestamps
# are fixed64. the dropped counts are written only when non-zero.
fn encode_span(span: trace.Span) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_bytes(1, id_bytes(span.trace_id, 16))!
    w.write_bytes(2, id_bytes(span.span_id, 8))!
    if span.parent_id != "":
        w.write_bytes(4, id_bytes(span.parent_id, 8))!
    w.write_string(5, span.name)!
    w.write_enum(6, span.kind)!
    w.write_fixed64(7, span.start_unix_ns)!
    w.write_fixed64(8, span.end_unix_ns)!
    write_attributes(w, 9, span.attrs)!
    if span.dropped_attributes_count > 0:
        w.write_uint32(10, span.dropped_attributes_count)!
    for event in span.events:
        w.write_message(11, encode_event(event)!)!
    if span.dropped_events_count > 0:
        w.write_uint32(12, span.dropped_events_count)!
    for link in span.links:
        w.write_message(13, encode_link(link)!)!
    if span.dropped_links_count > 0:
        w.write_uint32(14, span.dropped_links_count)!
    if span.status != trace.STATUS_UNSET or span.status_message != "":
        w.write_message(15, encode_status(span.status, span.status_message)!)!
    out := w.bytes()
    w.free()
    return out

# the environment variable carrying extra resource attributes, as "k1=v1,k2=v2".
OTEL_RESOURCE_ATTRIBUTES := "OTEL_RESOURCE_ATTRIBUTES"

# parse an OTEL_RESOURCE_ATTRIBUTES spec ("k1=v1,k2=v2") into string attributes.
# each entry is split once on "=", key and value are trimmed, and any entry
# without a "=" or with an empty key is skipped.
fn parse_resource_attributes(spec: String) -> List[trace.Attr]:
    mut out: List[trace.Attr] := []
    for entry in spec.split(","):
        pair := strings.split_once(entry, "=")
        if not pair.found:
            continue
        key := pair.left.trim()
        value := pair.right.trim()
        if key == "":
            continue
        out.push(trace.Attr(key, trace.ATTR_STRING, value, 0, false, 0.0))
    return out

# the extra resource attributes from OTEL_RESOURCE_ATTRIBUTES, or an empty list.
fn resource_env_attrs() -> List[trace.Attr]:
    return parse_resource_attributes(env.str_or(OTEL_RESOURCE_ATTRIBUTES, ""))

# encode a Resource { attributes = 1 }. it always carries service.name and the
# telemetry.sdk.* identity; service.version and service.instance.id are included
# when set on the target. `extra` holds any OTEL_RESOURCE_ATTRIBUTES pairs, which
# are appended as-is (they do not replace the reserved keys above).
fn encode_resource(cfg: Target, extra: List[trace.Attr]) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_message(1, encode_string_key_value("service.name", cfg.service_name)!)!
    if cfg.service_version != "":
        w.write_message(1, encode_string_key_value("service.version", cfg.service_version)!)!
    if cfg.service_instance_id != "":
        w.write_message(1, encode_string_key_value("service.instance.id", cfg.service_instance_id)!)!
    w.write_message(1, encode_string_key_value("telemetry.sdk.name", "pith")!)!
    w.write_message(1, encode_string_key_value("telemetry.sdk.language", "pith")!)!
    w.write_message(1, encode_string_key_value("telemetry.sdk.version", SDK_VERSION)!)!
    for attr in extra:
        w.write_message(1, encode_attr(attr)!)!
    out := w.bytes()
    w.free()
    return out

# encode an InstrumentationScope { name = 1 } naming this library.
fn encode_scope() -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_string(1, "pith")!
    out := w.bytes()
    w.free()
    return out

# encode an ExportTraceServiceRequest for these spans: a single ResourceSpans
# (resource=1, scope_spans=2) with one ScopeSpans (scope=1, spans=2) holding
# every span. the target supplies the resource; an empty span list still
# produces a valid (empty-of-spans) request.
pub fn encode_traces(cfg: Target, spans: List[trace.Span]) -> Bytes!protobuf.ProtoError:
    scope_spans := protobuf.writer()
    scope_spans.write_message(1, encode_scope()!)!
    for span in spans:
        scope_spans.write_message(2, encode_span(span)!)!
    scope_spans_bytes := scope_spans.bytes()
    scope_spans.free()

    resource_spans := protobuf.writer()
    resource_spans.write_message(1, encode_resource(cfg, resource_env_attrs())!)!
    resource_spans.write_message(2, scope_spans_bytes)!
    resource_spans_bytes := resource_spans.bytes()
    resource_spans.free()

    request := protobuf.writer()
    request.write_message(1, resource_spans_bytes)!
    out := request.bytes()
    request.free()
    return out

# --- metric encoding --------------------------------------------------------

# encode a NumberDataPoint for a counter or gauge: time_unix_nano=3 (fixed64),
# as_double=1 (double), attributes=7. metric values are floats, so as_double is
# the right representation (integers ride along exactly).
fn encode_number_point(value: Float, now_ns: Int, labels: List[String]) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_double(1, value)!
    w.write_fixed64(3, now_ns)!
    write_string_attributes(w, 7, labels)!
    out := w.bytes()
    w.free()
    return out

# encode a HistogramDataPoint: time_unix_nano=3 (fixed64), count=4 (fixed64),
# sum=5 (double), bucket_counts=6 (repeated fixed64), explicit_bounds=7 (repeated
# double), attributes=9, min=11 (double), max=12 (double). the metric sample
# carries cumulative le-counts (prometheus semantics); OTLP wants per-bucket
# counts with one extra entry for the implicit +Inf overflow bucket, so we
# difference them here. this is a real explicit-bucket histogram, enough for
# percentile estimation, not just a count+sum.
fn encode_histogram_point(sample: metrics.MetricSample, now_ns: Int) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    count := sample.value.to_int()
    w.write_fixed64(3, now_ns)!
    w.write_fixed64(4, count)!
    w.write_double(5, sample.sum)!
    # per-bucket counts = differences of the cumulative counts, plus the overflow
    # bucket (everything above the last bound).
    mut prev := 0
    for cumulative in sample.bucket_cumulative:
        w.write_fixed64(6, cumulative - prev)!
        prev = cumulative
    w.write_fixed64(6, count - prev)!
    for bound in sample.bucket_bounds:
        w.write_double(7, bound)!
    write_string_attributes(w, 9, sample.labels)!
    if count > 0:
        w.write_double(11, sample.min)!
        w.write_double(12, sample.max)!
    out := w.bytes()
    w.free()
    return out

# encode a Sum { data_points=1, aggregation_temporality=2, is_monotonic=3 }.
# pith counters only ever increase, so is_monotonic is true.
fn encode_sum(point: Bytes) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_message(1, point)!
    w.write_enum(2, CUMULATIVE)!
    w.write_bool(3, true)!
    out := w.bytes()
    w.free()
    return out

# encode a Gauge { data_points = 1 }.
fn encode_gauge(point: Bytes) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_message(1, point)!
    out := w.bytes()
    w.free()
    return out

# encode a Histogram { data_points=1, aggregation_temporality=2 }.
fn encode_histogram(point: Bytes) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_message(1, point)!
    w.write_enum(2, CUMULATIVE)!
    out := w.bytes()
    w.free()
    return out

# encode one Metric { name=1, description=2, unit=3, gauge=5 | sum=7 |
# histogram=9 } from a sample, mapping the pith metric kind to the matching OTLP
# data type.
fn encode_metric(sample: metrics.MetricSample, now_ns: Int) -> Bytes!protobuf.ProtoError:
    w := protobuf.writer()
    w.write_string(1, sample.name)!
    if sample.description != "":
        w.write_string(2, sample.description)!
    if sample.unit != "":
        w.write_string(3, sample.unit)!
    if sample.kind == "gauge":
        point := encode_number_point(sample.value, now_ns, sample.labels)!
        w.write_message(5, encode_gauge(point)!)!
    elif sample.kind == "histogram":
        point := encode_histogram_point(sample, now_ns)!
        w.write_message(9, encode_histogram(point)!)!
    else:
        point := encode_number_point(sample.value, now_ns, sample.labels)!
        w.write_message(7, encode_sum(point)!)!
    out := w.bytes()
    w.free()
    return out

# encode an ExportMetricsServiceRequest for these samples: a single
# ResourceMetrics (resource=1, scope_metrics=2) with one ScopeMetrics
# (scope=1, metrics=2) holding every metric. the target supplies the resource.
pub fn encode_metrics(cfg: Target, samples: List[metrics.MetricSample]) -> Bytes!protobuf.ProtoError:
    now_ns := time.now() * 1000000
    scope_metrics := protobuf.writer()
    scope_metrics.write_message(1, encode_scope()!)!
    for sample in samples:
        scope_metrics.write_message(2, encode_metric(sample, now_ns)!)!
    scope_metrics_bytes := scope_metrics.bytes()
    scope_metrics.free()

    resource_metrics := protobuf.writer()
    resource_metrics.write_message(1, encode_resource(cfg, resource_env_attrs())!)!
    resource_metrics.write_message(2, scope_metrics_bytes)!
    resource_metrics_bytes := resource_metrics.bytes()
    resource_metrics.free()

    request := protobuf.writer()
    request.write_message(1, resource_metrics_bytes)!
    out := request.bytes()
    request.free()
    return out

# --- export over OTLP/HTTP --------------------------------------------------

# prepare the request body for a target: gzip it when compression is enabled,
# otherwise pass it through unchanged. returns the bytes to send and whether they
# are gzipped (so the caller can set Content-Encoding). factored out so the
# compression path is unit-testable without a live collector.
fn prepare_body(cfg: Target, body: Bytes) -> (Bytes, Bool):
    if cfg.use_gzip:
        return (gzip.compress(body), true)
    return (body, false)

# whether an OTLP/HTTP response status should be retried. 429 (too many requests)
# and any 5xx are transient, so we back off and retry; every other 4xx is a
# permanent client error (bad request, unauthorized, ...) and a 2xx already
# succeeded, so neither is retried.
pub fn is_retryable(status: Int) -> Bool:
    return status == 429 or status >= 500

# exponential backoff for retry `attempt` (0-indexed): BACKOFF_BASE_MS, then
# double each step, capped at BACKOFF_MAX_MS. deterministic (no jitter) so the
# behavior is easy to test and reason about.
fn backoff_ms(attempt: Int) -> Int:
    mut delay := BACKOFF_BASE_MS
    mut i := 0
    while i < attempt:
        delay = delay * 2
        if delay >= BACKOFF_MAX_MS:
            return BACKOFF_MAX_MS
        i = i + 1
    return delay

# how long to wait before the next retry: the exponential backoff, unless the
# collector sent a larger Retry-After (in seconds) we should honor instead.
fn retry_delay_ms(resp: http.HttpResponse, attempt: Int) -> Int:
    backoff := backoff_ms(attempt)
    retry_after := resp.header_value("Retry-After")
    if retry_after == "":
        return backoff
    server_ms := (parse_int(retry_after) catch 0) * 1000
    if server_ms > backoff:
        return server_ms
    return backoff

# POST an encoded protobuf body to a signal path (e.g. /v1/traces) on the
# collector, returning the response. sends the target's configured headers, the
# content type, and (when enabled) gzip; applies the per-request timeout. a plain
# http endpoint uses send(); an https one uses the system trust roots. a failed
# send propagates as an error so the retry loop can treat it as transient.
fn post_signal(cfg: Target, signal_path: String, body: Bytes) -> http.HttpResponse!:
    full_path := cfg.base_path + signal_path
    prepared := prepare_body(cfg, body)
    mut req := http.post_request(cfg.host, cfg.port, full_path).body_bytes(prepared.0).header("Content-Type", OTLP_CONTENT_TYPE)
    if prepared.1:
        req = req.header("Content-Encoding", "gzip")
    # layer on the configured auth/tenant headers (flat [k1, v1, ...] pairs).
    mut i := 0
    while i + 1 < cfg.headers.len():
        req = req.header(cfg.headers[i], cfg.headers[i + 1])
        i = i + 2
    if cfg.timeout_ms > 0:
        req = req.with_timeout(cfg.timeout_ms)
    if cfg.use_tls:
        return req.send_tls_with_config(cfg.host, tls.client_config()!)!
    return req.send()!

# POST a signal with retries. best-effort: returns true once the collector
# accepts the body (2xx). a transport error or a retryable status (429/5xx) backs
# off and retries until MAX_EXPORT_ATTEMPTS is reached; a permanent rejection (any
# other 4xx) is dropped immediately. never propagates, so callers keep running.
fn post_with_retry(cfg: Target, signal_path: String, body: Bytes) -> Bool:
    mut attempt := 0
    while attempt < MAX_EXPORT_ATTEMPTS:
        result := post_signal(cfg, signal_path, body)
        last_attempt := attempt + 1 >= MAX_EXPORT_ATTEMPTS
        if result.is_err:
            # transport failure (connect/timeout/reset): retry while attempts remain.
            if last_attempt:
                return false
            time.delay(backoff_ms(attempt))
        else:
            status := result.ok.status
            if status >= 200 and status < 300:
                return true
            if not is_retryable(status):
                # a permanent client error: drop the batch, no point retrying.
                return false
            if last_attempt:
                return false
            time.delay(retry_delay_ms(result.ok, attempt))
        attempt = attempt + 1
    return false

# export these spans to the collector's /v1/traces. an empty list is a no-op
# (returns true). grpc endpoints fail with a clear message until implemented.
pub fn export_traces(cfg: Target, spans: List[trace.Span]) -> Bool!:
    if spans.len() == 0:
        return true
    if cfg.protocol == PROTOCOL_GRPC:
        fail "otlp: grpc transport is not implemented; use http/protobuf"
    encoded := encode_traces(cfg, spans)
    if encoded.is_err:
        fail "otlp: encode traces: " + encoded.err.message
    return post_with_retry(cfg, "/v1/traces", encoded.ok)

# export these metric samples to the collector's /v1/metrics. an empty list is
# a no-op (returns true). grpc endpoints fail until implemented.
pub fn export_metrics(cfg: Target, samples: List[metrics.MetricSample]) -> Bool!:
    if samples.len() == 0:
        return true
    if cfg.protocol == PROTOCOL_GRPC:
        fail "otlp: grpc transport is not implemented; use http/protobuf"
    encoded := encode_metrics(cfg, samples)
    if encoded.is_err:
        fail "otlp: encode metrics: " + encoded.err.message
    return post_with_retry(cfg, "/v1/metrics", encoded.ok)

# --- tests ------------------------------------------------------------------

# read the first embedded message at `field` from an encoded message, skipping
# any other fields. a small helper the round-trip tests use to descend the
# nested OTLP structure.
fn first_message(data: Bytes, field: Int) -> Bytes!protobuf.ProtoError:
    r := protobuf.reader(data)
    while not r.at_end():
        tag := r.read_tag()!
        if tag.field == field and tag.wire == protobuf.WIRE_LEN:
            return r.read_message()!
        r.skip(tag.wire)!
    fail protobuf.ProtoError("field not found")

# read every embedded message at `field`, in order. the attribute round-trip
# tests use it to pull out each KeyValue.
fn read_messages(data: Bytes, field: Int) -> List[Bytes]!protobuf.ProtoError:
    mut out: List[Bytes] := []
    r := protobuf.reader(data)
    while not r.at_end():
        tag := r.read_tag()!
        if tag.field == field and tag.wire == protobuf.WIRE_LEN:
            out.push(r.read_message()!)
        else:
            r.skip(tag.wire)!
    return out

# the string value of the resource attribute named `key`, or "" when absent.
# resource attributes are all strings, so their AnyValue is always string_value.
fn resource_attr(resource: Bytes, key: String) -> String!protobuf.ProtoError:
    for kv in read_messages(resource, 1)!:
        r := protobuf.reader(kv)
        r.read_tag()!                 # key
        found_key := r.read_string()!
        r.read_tag()!                 # value (AnyValue)
        any_value := protobuf.reader(r.read_message()!)
        any_value.read_tag()!         # string_value
        if found_key == key:
            return any_value.read_string()!
    return ""

fn sample_span() -> trace.Span:
    trace.set_active(true)
    trace.set_sink(true)
    trace.clear_context()
    root := trace.start("parent")
    child := trace.start_kind("db.query", trace.CLIENT)
    child.set_attr("db.system", "postgres")
    child.set_status(trace.STATUS_ERROR, "timeout")
    child.end()
    root.end()
    spans := trace.drain_finished_spans()
    trace.set_active(false)
    trace.set_sink(false)
    # the child ends first, so it is spans[0].
    return spans[0]

test "config parses an http endpoint into host, port, and tls off":
    cfg := target("svc", "http://collector.local:4318", PROTOCOL_HTTP)
    assert_eq(cfg.host, "collector.local")
    assert_eq(cfg.port, 4318)
    assert(not cfg.use_tls)
    assert_eq(cfg.base_path, "")

test "config defaults the port and reads https as tls":
    cfg := target("svc", "https://collector.example.com", PROTOCOL_HTTP)
    assert_eq(cfg.port, DEFAULT_HTTP_PORT)
    assert(cfg.use_tls)

test "a trace request round-trips through the reader":
    span := sample_span()
    cfg := target("checkout", "http://collector.local:4318", PROTOCOL_HTTP)
    encoded := encode_traces(cfg, [span])!

    # ExportTraceServiceRequest.resource_spans[0]
    resource_spans := first_message(encoded, 1)!
    # ResourceSpans.resource -> Resource.attributes[0] -> KeyValue
    resource := first_message(resource_spans, 1)!
    kv := first_message(resource, 1)!
    kr := protobuf.reader(kv)
    kr.read_tag()!
    assert_eq(kr.read_string()!, "service.name")
    kr.read_tag()!
    any_value := kr.read_message()!
    ar := protobuf.reader(any_value)
    ar.read_tag()!
    assert_eq(ar.read_string()!, "checkout")

    # ResourceSpans.scope_spans -> ScopeSpans.spans[0] -> Span
    scope_spans := first_message(resource_spans, 2)!
    span_msg := first_message(scope_spans, 2)!
    mut trace_id_len := 0
    mut span_id_len := 0
    mut name := ""
    mut kind := 0
    sr := protobuf.reader(span_msg)
    while not sr.at_end():
        tag := sr.read_tag()!
        if tag.field == 1:
            trace_id_len = sr.read_bytes()!.len()
        elif tag.field == 2:
            span_id_len = sr.read_bytes()!.len()
        elif tag.field == 5:
            name = sr.read_string()!
        elif tag.field == 6:
            kind = sr.read_enum()!
        else:
            sr.skip(tag.wire)!
    assert_eq(trace_id_len, 16)
    assert_eq(span_id_len, 8)
    assert_eq(name, "db.query")
    assert_eq(kind, trace.CLIENT)

# the string value inside the first KeyValue attribute of a data point message
# (attributes are field 7 on a NumberDataPoint), or "" when there are none.
fn first_attr_value(point: Bytes) -> String!protobuf.ProtoError:
    pr := protobuf.reader(point)
    while not pr.at_end():
        tag := pr.read_tag()!
        if tag.field == 7:
            kv := protobuf.reader(pr.read_message()!)
            kv.read_tag()!            # key
            kv.read_string()!
            kv.read_tag()!            # value (AnyValue)
            any_value := protobuf.reader(kv.read_message()!)
            any_value.read_tag()!     # string_value
            return any_value.read_string()!
        pr.skip(tag.wire)!
    return ""

test "a counter encodes as a monotonic sum with an int data point":
    metrics.reset()
    metrics.counter("requests_total").labels(["route", "/api"]).add(5.0)
    encoded := encode_metrics(target("checkout", "http://collector.local:4318", PROTOCOL_HTTP), metrics.snapshot())!

    resource_metrics := first_message(encoded, 1)!
    scope_metrics := first_message(resource_metrics, 2)!

    # creating a labeled counter also registers the bare series (value 0), so we
    # scan every Metric and look for the labeled one carrying as_int == 5.
    mut found := false
    mut monotonic := false
    mut temporality := 0
    mut route := ""
    sm := protobuf.reader(scope_metrics)
    while not sm.at_end():
        tag := sm.read_tag()!
        if tag.field != 2:
            sm.skip(tag.wire)!
            continue
        metric := sm.read_message()!
        sum_bytes := first_message(metric, 7)!    # Sum
        point := first_message(sum_bytes, 1)!      # NumberDataPoint

        mut as_double := 0.0
        pr := protobuf.reader(point)
        while not pr.at_end():
            inner := pr.read_tag()!
            if inner.field == 1:
                as_double = pr.read_double()!
            else:
                pr.skip(inner.wire)!
        if as_double == 5.0:
            found = true
            route = first_attr_value(point)!
            su := protobuf.reader(sum_bytes)
            while not su.at_end():
                st := su.read_tag()!
                if st.field == 2:
                    temporality = su.read_enum()!
                elif st.field == 3:
                    monotonic = su.read_bool()!
                else:
                    su.skip(st.wire)!
    assert(found)
    assert(monotonic)
    assert_eq(temporality, CUMULATIVE)
    assert_eq(route, "/api")

test "a histogram encodes count and sum on its data point":
    metrics.reset()
    h := metrics.histogram("latency_ms")
    h.observe(10.0)
    h.observe(30.0)
    encoded := encode_metrics(target("checkout", "http://collector.local:4318", PROTOCOL_HTTP), metrics.snapshot())!

    resource_metrics := first_message(encoded, 1)!
    scope_metrics := first_message(resource_metrics, 2)!
    metric := first_message(scope_metrics, 2)!
    histogram_bytes := first_message(metric, 9)!
    point := first_message(histogram_bytes, 1)!

    mut count := 0
    mut sum := 0.0
    hr := protobuf.reader(point)
    while not hr.at_end():
        tag := hr.read_tag()!
        if tag.field == 4:
            count = hr.read_fixed64()!
        elif tag.field == 5:
            sum = hr.read_double()!
        else:
            hr.skip(tag.wire)!
    assert_eq(count, 2)
    assert_eq(sum, 40.0)

test "a histogram encodes explicit buckets, min, and max":
    metrics.reset()
    h := metrics.histogram("latency_ms").buckets([10.0, 100.0])
    h.observe(5.0)      # falls in the <=10 bucket
    h.observe(50.0)     # falls in the (10,100] bucket
    h.observe(500.0)    # overflow, above the last bound
    encoded := encode_metrics(target("checkout", "http://collector.local:4318", PROTOCOL_HTTP), metrics.snapshot())!

    resource_metrics := first_message(encoded, 1)!
    scope_metrics := first_message(resource_metrics, 2)!
    metric := first_message(scope_metrics, 2)!
    histogram_bytes := first_message(metric, 9)!
    point := first_message(histogram_bytes, 1)!

    mut count := 0
    mut bounds: List[Float] := []
    mut counts: List[Int] := []
    mut lo := 0.0
    mut hi := 0.0
    hr := protobuf.reader(point)
    while not hr.at_end():
        tag := hr.read_tag()!
        if tag.field == 4:
            count = hr.read_fixed64()!
        elif tag.field == 6:
            counts.push(hr.read_fixed64()!)
        elif tag.field == 7:
            bounds.push(hr.read_double()!)
        elif tag.field == 11:
            lo = hr.read_double()!
        elif tag.field == 12:
            hi = hr.read_double()!
        else:
            hr.skip(tag.wire)!
    assert_eq(count, 3)
    assert_eq(bounds.len(), 2)
    assert_eq(bounds[0], 10.0)
    assert_eq(bounds[1], 100.0)
    # per-bucket, non-cumulative, with a +Inf overflow entry: 1, 1, 1.
    assert_eq(counts.len(), 3)
    assert_eq(counts[0], 1)
    assert_eq(counts[1], 1)
    assert_eq(counts[2], 1)
    assert_eq(lo, 5.0)
    assert_eq(hi, 500.0)

test "a metric encodes its description and unit":
    metrics.reset()
    metrics.counter("requests_total").describe("total requests handled", "1").inc()
    encoded := encode_metrics(target("svc", "http://collector.local:4318", PROTOCOL_HTTP), metrics.snapshot())!

    resource_metrics := first_message(encoded, 1)!
    scope_metrics := first_message(resource_metrics, 2)!

    mut desc := ""
    mut unit := ""
    sm := protobuf.reader(scope_metrics)
    while not sm.at_end():
        tag := sm.read_tag()!
        if tag.field != 2:
            sm.skip(tag.wire)!
            continue
        metric := sm.read_message()!
        mut name := ""
        mut d := ""
        mut u := ""
        mr := protobuf.reader(metric)
        while not mr.at_end():
            mt := mr.read_tag()!
            if mt.field == 1:
                name = mr.read_string()!
            elif mt.field == 2:
                d = mr.read_string()!
            elif mt.field == 3:
                u = mr.read_string()!
            else:
                mr.skip(mt.wire)!
        if name == "requests_total":
            desc = d
            unit = u
    assert_eq(desc, "total requests handled")
    assert_eq(unit, "1")

test "empty exports are a no-op":
    empty_spans: List[trace.Span] := []
    empty_samples: List[metrics.MetricSample] := []
    cfg := target("svc", "http://127.0.0.1:4318", PROTOCOL_HTTP)
    assert(export_traces(cfg, empty_spans)!)
    assert(export_metrics(cfg, empty_samples)!)

test "each attribute type encodes to its AnyValue field":
    trace.set_active(true)
    trace.set_sink(true)
    trace.clear_context()
    span := trace.start("work")
    span.set_attr("str", "hi").set_attr_int("num", 7).set_attr_bool("flag", true).set_attr_float("ratio", 1.5)
    span.end()
    spans := trace.drain_finished_spans()
    trace.set_active(false)
    trace.set_sink(false)

    span_bytes := encode_span(spans[0])!
    attrs := read_messages(span_bytes, 9)!    # Span.attributes
    assert_eq(attrs.len(), 4)

    # string -> AnyValue.string_value = 1
    sr := protobuf.reader(attrs[0])
    sr.read_tag()!
    assert_eq(sr.read_string()!, "str")
    sr.read_tag()!
    sv := protobuf.reader(sr.read_message()!)
    s_tag := sv.read_tag()!
    assert_eq(s_tag.field, 1)
    assert_eq(sv.read_string()!, "hi")

    # int -> AnyValue.int_value = 3
    ir := protobuf.reader(attrs[1])
    ir.read_tag()!
    assert_eq(ir.read_string()!, "num")
    ir.read_tag()!
    iv := protobuf.reader(ir.read_message()!)
    i_tag := iv.read_tag()!
    assert_eq(i_tag.field, 3)
    assert_eq(iv.read_int64()!, 7)

    # bool -> AnyValue.bool_value = 2
    br := protobuf.reader(attrs[2])
    br.read_tag()!
    assert_eq(br.read_string()!, "flag")
    br.read_tag()!
    bv := protobuf.reader(br.read_message()!)
    b_tag := bv.read_tag()!
    assert_eq(b_tag.field, 2)
    assert(bv.read_bool()!)

    # float -> AnyValue.double_value = 4
    fr := protobuf.reader(attrs[3])
    fr.read_tag()!
    assert_eq(fr.read_string()!, "ratio")
    fr.read_tag()!
    fv := protobuf.reader(fr.read_message()!)
    f_tag := fv.read_tag()!
    assert_eq(f_tag.field, 4)
    assert_eq(fv.read_double()!, 1.5)

test "a span's events and links round-trip through the reader":
    trace.set_active(true)
    trace.set_sink(true)
    trace.clear_context()
    span := trace.start("work")
    event_attrs: List[trace.Attr] := [trace.Attr("exception.type", trace.ATTR_STRING, "IOError", 0, false, 0.0)]
    span.add_event_attrs("exception", event_attrs)
    span.add_link(trace.SpanContext("0af7651916cd43dd8448eb211c80319c", "b7ad6b7169203331", true))
    span.end()
    spans := trace.drain_finished_spans()
    trace.set_active(false)
    trace.set_sink(false)

    span_bytes := encode_span(spans[0])!

    # Span.events[0] -> Span.Event { time_unix_nano=1, name=2, attributes=3 }
    event := first_message(span_bytes, 11)!
    mut event_time := 0
    mut event_name := ""
    er := protobuf.reader(event)
    while not er.at_end():
        t := er.read_tag()!
        if t.field == 1:
            event_time = er.read_fixed64()!
        elif t.field == 2:
            event_name = er.read_string()!
        else:
            er.skip(t.wire)!
    assert(event_time > 0)
    assert_eq(event_name, "exception")

    # the event's attribute (Span.Event.attributes = 3) -> KeyValue.key = 1
    event_kv := first_message(event, 3)!
    kr := protobuf.reader(event_kv)
    kr.read_tag()!
    assert_eq(kr.read_string()!, "exception.type")

    # Span.links[0] -> Span.Link { trace_id=1 (16 bytes), span_id=2 (8 bytes) }
    link := first_message(span_bytes, 13)!
    mut link_trace_len := 0
    mut link_span_len := 0
    lr := protobuf.reader(link)
    while not lr.at_end():
        t := lr.read_tag()!
        if t.field == 1:
            link_trace_len = lr.read_bytes()!.len()
        elif t.field == 2:
            link_span_len = lr.read_bytes()!.len()
        else:
            lr.skip(t.wire)!
    assert_eq(link_trace_len, 16)
    assert_eq(link_span_len, 8)

test "a span over the attribute cap encodes dropped_attributes_count":
    trace.set_active(true)
    trace.set_sink(true)
    trace.clear_context()
    span := trace.start("work")
    mut i := 0
    while i < 130:
        span.set_attr_int("k", i)
        i = i + 1
    span.end()
    spans := trace.drain_finished_spans()
    trace.set_active(false)
    trace.set_sink(false)

    span_bytes := encode_span(spans[0])!
    # Span.dropped_attributes_count = 10 (varint), present because we exceeded 128.
    mut dropped := 0
    sr := protobuf.reader(span_bytes)
    while not sr.at_end():
        t := sr.read_tag()!
        if t.field == 10:
            dropped = sr.read_uint32()!
        else:
            sr.skip(t.wire)!
    assert_eq(dropped, 2)

test "the resource carries service identity, sdk info, and extra attributes":
    cfg := target_with_resource("checkout", "1.2.3", "instance-7", "http://collector.local:4318", PROTOCOL_HTTP)
    extra := parse_resource_attributes("deployment.environment=prod")
    resource := encode_resource(cfg, extra)!
    assert_eq(resource_attr(resource, "service.name")!, "checkout")
    assert_eq(resource_attr(resource, "service.version")!, "1.2.3")
    assert_eq(resource_attr(resource, "service.instance.id")!, "instance-7")
    assert_eq(resource_attr(resource, "telemetry.sdk.name")!, "pith")
    assert_eq(resource_attr(resource, "telemetry.sdk.language")!, "pith")
    assert_eq(resource_attr(resource, "telemetry.sdk.version")!, SDK_VERSION)
    assert_eq(resource_attr(resource, "deployment.environment")!, "prod")

test "the resource omits an unset version and instance id":
    cfg := target("svc", "http://collector.local:4318", PROTOCOL_HTTP)
    no_extra: List[trace.Attr] := []
    resource := encode_resource(cfg, no_extra)!
    assert_eq(resource_attr(resource, "service.name")!, "svc")
    # absent optional keys read back as "".
    assert_eq(resource_attr(resource, "service.version")!, "")
    assert_eq(resource_attr(resource, "service.instance.id")!, "")

test "the resource-attributes parser splits k=v pairs and skips junk":
    parsed := parse_resource_attributes("region=us-east, tier = gold ,,broken,empty=")
    assert_eq(parsed.len(), 3)
    assert_eq(parsed[0].key, "region")
    assert_eq(parsed[0].s, "us-east")
    assert_eq(parsed[1].key, "tier")     # surrounding spaces trimmed
    assert_eq(parsed[1].s, "gold")
    assert_eq(parsed[2].key, "empty")    # empty value is kept
    assert_eq(parsed[2].s, "")
    assert_eq(parse_resource_attributes("").len(), 0)

test "is_retryable retries 429 and 5xx but not other statuses":
    # 2xx already succeeded; other 4xx are permanent client errors.
    assert(not is_retryable(200))
    assert(not is_retryable(400))
    assert(not is_retryable(404))
    assert(is_retryable(429))
    assert(is_retryable(500))
    assert(is_retryable(502))
    assert(is_retryable(503))
    assert(is_retryable(504))

test "backoff doubles each attempt and caps at the maximum":
    assert_eq(backoff_ms(0), BACKOFF_BASE_MS)          # first retry waits the base
    assert_eq(backoff_ms(1), BACKOFF_BASE_MS * 2)
    assert_eq(backoff_ms(2), BACKOFF_BASE_MS * 4)
    assert_eq(backoff_ms(3), BACKOFF_BASE_MS * 8)
    # it is monotonic increasing until it saturates.
    assert(backoff_ms(1) > backoff_ms(0))
    assert(backoff_ms(2) > backoff_ms(1))
    # a late attempt saturates at the cap and stays there.
    assert_eq(backoff_ms(5), BACKOFF_MAX_MS)
    assert_eq(backoff_ms(20), BACKOFF_MAX_MS)

test "prepare_body gzips only when the target enables compression":
    body := bytes.from_string_utf8("an otlp protobuf body")
    plain_cfg := target("svc", "http://collector.local:4318", PROTOCOL_HTTP)
    off := prepare_body(plain_cfg, body)
    # compression off: the body is passed through and not marked gzipped.
    assert(not off.1)
    assert_eq(off.0.to_string_utf8()!, "an otlp protobuf body")

    gzip_cfg := plain_cfg.with_gzip(true)
    on := prepare_body(gzip_cfg, body)
    # compression on: the body is gzipped and decompresses back to the original.
    assert(on.1)
    assert_eq(gzip.decompress(on.0)!.to_string_utf8()!, "an otlp protobuf body")

test "retry_delay prefers a larger Retry-After over the backoff":
    empty_headers: Map[String, String] := {}
    # no Retry-After header: fall back to the exponential backoff.
    without := http.HttpResponse(503, "", empty_headers, bytes.empty(), [])
    assert_eq(retry_delay_ms(without, 0), backoff_ms(0))

    # a Retry-After larger than the backoff wins (5s vs the 1s base backoff).
    big_headers: Map[String, String] := {"Retry-After": "5"}
    bigger := http.HttpResponse(503, "", big_headers, bytes.empty(), [])
    assert_eq(retry_delay_ms(bigger, 0), 5000)

    # a Retry-After smaller than the backoff is ignored in favor of the backoff.
    small_headers: Map[String, String] := {"Retry-After": "1"}
    smaller := http.HttpResponse(503, "", small_headers, bytes.empty(), [])
    assert_eq(retry_delay_ms(smaller, 3), backoff_ms(3))
