# password login and jwt-protected routes with std.web.
#
# the whole flow in one process: the login route checks an argon2id hash and
# issues a token from the claims builder, and a group() guard verifies the
# Authorization header for everything under /api. the client logs in, calls
# a protected route, and shows what a missing, tampered and wrong-secret
# token each get back.
#
# the guard is the part worth copying: it names the one algorithm it
# accepts (the token's own header never picks the verifier), answers 401
# from a catch block when anything fails, and hands the verified subject to
# handlers on the request itself.

import std.bytes as bytes
import std.crypto.jwt as jwt
import std.crypto.password as password
import std.json as json
import std.net.http as http
import std.web as web

PORT := 18093
ISSUER := "example-auth"
AUDIENCE := "example-api"

# in a real service this is a database row; the phc string carries its own
# salt and parameters, so one column holds everything verify needs. a plain
# module global, because every serving task must see the hash main wrote.
mut stored_hash: String := ""

# the hmac secret would come from the environment. it must be long enough
# that guessing it is not easier than forging the signature.
fn signing_secret() -> Bytes:
    return bytes.from_string_utf8("an hs256 secret kept out of the repo, 32+ bytes of it")

fn expected_claims() -> jwt.Options:
    return jwt.with_audience(jwt.with_issuer(jwt.default_options(), ISSUER), AUDIENCE)

# POST /login: check the password, mint a one-hour token for the subject.
fn handle_login(req: web.Request) -> http.HttpResponse:
    body := req.raw.body_json() catch:
        return http.bad_request_response()
    user := json.get_string(json.object_get(body, "username"))
    attempt := json.get_string(json.object_get(body, "password"))

    # verify is deliberately a Bool: an unparseable stored hash counts as a
    # failed login, never as an error a handler might read as "fine".
    if user != "ada" or not password.verify(attempt, stored_hash):
        return http.unauthorized_response()

    token := jwt.claims().issuer(ISSUER).audience(AUDIENCE).subject(user).expires_in(3600).sign_hs256(signing_secret()) catch:
        return http.server_error_response()
    return http.response(200).json_body(json.of("token", token))

# the guard for everything under /api. it names the one algorithm it will
# accept — the token's own header is never allowed to choose — and the
# subject rides the request down to the handlers.
fn require_token(next: fn(web.Request) -> http.HttpResponse, req: web.Request) -> http.HttpResponse:
    token := req.raw.bearer_token() catch:
        return http.unauthorized_response()
    # the verify error says what failed (signature, expiry, audience...) —
    # worth logging server-side, never worth echoing to the caller.
    session := jwt.verify_hs256(token, signing_secret(), expected_claims()) catch:
        return http.unauthorized_response()
    return next(req.with_value("user", session.subject()))

# a protected route: the guard has already verified the token and attached
# the caller's subject to the request.
fn handle_me(req: web.Request) -> http.HttpResponse:
    return http.response(200).json_body(json.of("user", req.value("user")))

fn build_app() -> web.App:
    mut app := web.new()
    app = app.post("/login", handle_login)
    app = app.group("/api", require_token)
    app = app.get("/api/me", handle_me)
    return app

fn serve_bg(port: Int) -> Int:
    return build_app().listen("127.0.0.1", port) catch 0

fn login(port: Int, username: String, attempt: String) -> String!:
    body := json.of_map({"username": username, "password": attempt})
    resp := http.post_request("127.0.0.1", port, "/login").json_body(body).send()!
    if resp.status != 200:
        fail "login refused"
    return json.get_string(json.object_get(resp.body_json()!, "token"))

fn get_me(port: Int, token: String) -> String!:
    mut req := http.get_request("127.0.0.1", port, "/api/me")
    if token.len() > 0:
        req = req.bearer(token)
    resp := req.send()!
    if resp.status != 200:
        return resp.status.to_string()
    return resp.status.to_string() + " user=" + json.get_string(json.object_get(resp.body_json()!, "user"))

fn main() -> Int!:
    # "register" the one user before serving. ~30ms of argon2id, once.
    stored_hash = password.hash("correct horse battery staple")!

    port := PORT
    spawn serve_bg(port)
    sleep(200)   # give the listener a moment to bind

    print("wrong password: " + ((login(port, "ada", "guess") catch "") == "").to_string())
    token := login(port, "ada", "correct horse battery staple")!
    print("login issued a token: " + (token.split(".").len() == 3).to_string())

    print("no token: " + (get_me(port, "") catch "no response"))
    print("with token: " + (get_me(port, token) catch "no response"))

    # flip the first character of the signature: same claims, dead signature.
    cut := token.last_index_of(".") + 1
    mut swapped := "A"
    if token[cut] == "A":
        swapped = "B"
    tampered := token.substring(0, cut) + swapped + token.substring(cut + 1, token.len())
    print("tampered token: " + (get_me(port, tampered) catch "no response"))

    # a token signed with a different secret fails the same way.
    forged := jwt.claims().issuer(ISSUER).audience(AUDIENCE).subject("mallory").expires_in(3600).sign_hs256(bytes.from_string_utf8("some other secret, also 32 bytes or more!"))!
    print("wrong secret: " + (get_me(port, forged) catch "no response"))
    return 0
