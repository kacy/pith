# interpolation displays containers and structs: lists and maps render
# with brackets and sorted keys, sets via their list view, structs through
# a show() impl when present or a synthesized Name(field: value) form.

struct Point:
    pub x: Int
    pub y: Int

struct Badge:
    pub label: String
    pub score: Float

impl Badge:
    fn show() -> String:
        return "<" + self.label + " @ " + self.score.to_string() + ">"

fn main():
    xs := [1, 2, 3]
    names := ["ada", "grace"]
    fs := [1.5, 2.25]
    flags := [true, false]
    print("xs = {xs}")
    print("names = {names}")
    print("fs = {fs}")
    print("flags = {flags}")
    mut m: Map[String, Int] := {}
    m.insert("b", 2)
    m.insert("a", 1)
    print("m = {m}")
    mut im: Map[Int, String] := {}
    im.insert(2, "two")
    im.insert(1, "one")
    print("im = {im}")
    p := Point(3, 4)
    print("p = {p}")
    b := Badge("gold", 9.5)
    print("b = {b}")
    mut tags: Set[String] := {"z", "a"}
    print("tags = {tags}")
