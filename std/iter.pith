# std.iter — iterator protocol, eager Range, and a generic collection terminal.
#
# A type implements the iterator protocol by declaring an associated `Item`
# type and a `fn next() -> Item?`. The compiler's `for` loop sugar recognizes
# any such type and drives it via next(), so user-defined iterators work the
# same as the language's built-in collection loops.
#
# `to_list` (below) is the canonical terminal: it drains any iterator into a
# `List[I.Item]`. The element type comes from the iterator's associated Item, so
# callers never write type arguments.

# Iterator: anything yielding values of its associated Item until it runs out.
pub interface Iterator:
    type Item
    fn next() -> Item?

# Range yields each integer in the half-open interval [lo, hi).
#
# Use this when you want a value you can hold, pass around, or pass to `to_list`.
# The for-loop sugar `for i in lo..hi:` is still faster for the common case
# because it compiles to a counted loop with no allocation.
pub struct Range:
    cur: Int
    hi: Int

impl Iterator for Range:
    type Item = Int
    fn next() -> Item?:
        if self.cur >= self.hi:
            return none
        v := self.cur
        self.cur = self.cur + 1
        return v

# Drain an iterator into a List of its element type.
pub fn to_list[I: Iterator](it: I) -> List[I.Item]:
    mut out: List[I.Item] := []
    for x in it:
        out.push(x)
    return out

# Lazy adapters. Each one wraps a source iterator + a closure and produces a
# new iterator. A chain like `to_list(filter_iter(map_iter(src, f), p))` walks
# the source once with a single allocation at to_list — no intermediate list
# per pipeline stage.
#
# Constructors are named `map_iter` / `filter_iter` so they don't collide with
# the eager free-function `map` / `filter` builtins on List from earlier in the
# language.

# Lazy map adapter: yields f(x) for each x the source iterator yields.
pub struct MapIter[I, U]:
    src: I
    f: fn(I.Item) -> U

impl Iterator for MapIter:
    type Item = U
    fn next() -> U?:
        n := self.src.next()
        if n == none:
            return none
        return self.f(n.value())

# Wrap an iterator so each yielded value passes through f.
pub fn map_iter[I: Iterator, U](src: I, f: fn(I.Item) -> U) -> MapIter[I, U]:
    return MapIter[I, U](src, f)

# Lazy filter adapter: yields only the source values that satisfy p.
pub struct FilterIter[I]:
    src: I
    p: fn(I.Item) -> Bool

impl Iterator for FilterIter:
    type Item = I.Item
    fn next() -> I.Item?:
        # pull from the source until the predicate accepts an element or the
        # source is exhausted
        mut n := self.src.next()
        while n != none:
            v := n.value()
            if self.p(v):
                return v
            n = self.src.next()
        return none

# Wrap an iterator so only values satisfying p come through.
pub fn filter_iter[I: Iterator](src: I, p: fn(I.Item) -> Bool) -> FilterIter[I]:
    return FilterIter[I](src, p)
