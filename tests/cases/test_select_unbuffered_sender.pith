# a select's receive arm meets a sender already parked on an unbuffered
# channel. the sender offered its value only to a parked receiver, and a select
# polls rather than parks, so the receive never fired and the select ran to its
# timeout; concurrent.recv_ctx, built on the same select, waited until its
# context was cancelled.
import std.concurrent as concurrent
from std.concurrent import RecvResult

fn send_one(ch: Channel[Int], v: Int):
    ch.send(v)

fn send_many(ch: Channel[String], n: Int):
    mut i := 0
    while i < n:
        ch.send("m{i}")
        i = i + 1
    ch.close()

fn main() -> Int:
    ch := Channel[Int](0)
    spawn send_one(ch, 42)
    sleep(20)
    select:
        v := ch.recv() => print("select got {v}")
        timeout 5000 => print("select timed out")

    spawn send_one(ch, 7)
    sleep(20)
    ctx := concurrent.with_timeout(concurrent.background(), 5000).0
    got := concurrent.recv_ctx(ch, ctx) catch:
        print("recv_ctx timed out")
        return 1
    match got:
        RecvResult.Value(v) => print("recv_ctx got {v}")
        RecvResult.Closed => print("recv_ctx closed")

    words := Channel[String](0)
    spawn send_many(words, 50)
    mut count := 0
    mut open := true
    while open:
        select:
            w := words.recv() =>
                if w == none:
                    open = false
                else:
                    count = count + 1
            timeout 5000 =>
                open = false
    print("select loop got {count}")
    return 0
