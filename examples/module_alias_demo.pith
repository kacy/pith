# imports: a module under an alias, and single names brought into scope.
#
# plans a short delivery route. `import std.math as math` keeps the module's
# names behind a prefix, so `math.atan2` says where it comes from. `from
# std.math import hypot, degrees` brings those two names in unprefixed, which
# reads better for names used often and unlikely to clash.

import std.math as math
from std.math import hypot, degrees

struct Stop:
    name: String
    x: Float
    y: Float

fn distance(from_stop: Stop, to_stop: Stop) -> Float:
    return hypot(to_stop.x - from_stop.x, to_stop.y - from_stop.y)

# compass bearing in degrees, clockwise from north
fn bearing(from_stop: Stop, to_stop: Stop) -> Float:
    angle := degrees(math.atan2(to_stop.x - from_stop.x, to_stop.y - from_stop.y))
    if angle < 0.0:
        return angle + 360.0
    return angle

fn main():
    route := [
        Stop(name: "depot", x: 0.0, y: 0.0),
        Stop(name: "bakery", x: 3.0, y: 4.0),
        Stop(name: "school", x: 3.0, y: -2.0),
        Stop(name: "depot", x: 0.0, y: 0.0),
    ]
    mut total := 0.0
    for i in 1..route.len():
        leg := distance(route[i - 1], route[i])
        total += leg
        print("{route[i - 1].name:>6} -> {route[i].name:<6} {leg:5.2} km, heading {bearing(route[i - 1], route[i]):5.1}")
    print("route length: {total:.2} km")
