# a lambda inside a function that returns a result is not that function. an index
# miss in it stops the program. it used to build the enclosing function's error,
# which the caller of the lambda read as its value: a number that was a pointer.
fn run() -> Int!:
    values := [10, 20]
    pick := fn(i: Int) => values[i]
    print(pick(1).to_string())
    print(pick(5).to_string())
    return 0

fn main():
    print((run() catch 1).to_string())
