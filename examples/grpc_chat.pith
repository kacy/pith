# a turn-by-turn conversation over one bidirectional grpc stream.
#
# grpc.serve collects a whole request before the handler runs, so a handler
# could not answer message 1 while the client is still deciding on message 2.
# grpc.serve_stream hands the dispatch a live GrpcStream instead: recv_message()
# returns each message as it arrives and send_message() replies at once, so the
# client here can read each answer before it sends the next line.
#
# the service is a small help desk bot. messages are protobuf with one string in
# field 1, both ways. examples/grpc_reflect.pith does the same through generated
# stubs.

import std.net.grpc as grpc
import std.protobuf as protobuf
import std.time as time

PORT := 20253

fn decode_text(message: Bytes) -> String!protobuf.ProtoError:
    reader := protobuf.reader(message)
    mut text := ""
    while not reader.at_end():
        tag := reader.read_tag()!
        if tag.field == 1:
            text = reader.read_string()!
        else:
            reader.skip(tag.wire)!
    return text

fn encode_text(text: String) -> Bytes:
    writer := protobuf.writer()
    writer.write_string(1, text) catch false
    out := writer.bytes()
    writer.free()
    return out

# the bot's answer to one line. it remembers the order number it was given,
# which is state that lives as long as the stream does.
fn answer(line: String, order: String) -> String:
    if order != "":
        return "order {order} ships tomorrow"
    if line.contains("order"):
        return "which order number?"
    return "sorry, i only know about orders"

# /help.Desk/Chat: answer each message the moment it arrives, until the client
# closes its side.
fn desk(path: String, call: grpc.GrpcStream) -> Int!grpc.GrpcError:
    if path != "/help.Desk/Chat":
        fail grpc.GrpcError(grpc.GRPC_UNIMPLEMENTED, "no method {path}")
    mut order := ""
    while true:
        step := call.recv_message()!
        if step.done:
            break
        line := decode_text(step.message) catch:
            fail grpc.GrpcError(grpc.GRPC_INVALID_ARGUMENT, "unreadable message")
        if (parse_int(line) catch -1) > 0:
            order = line
        call.send_message(encode_text(answer(line, order)))
    call.finish_ok()
    return 0

fn run_server() -> Int:
    return grpc.serve_stream("127.0.0.1", PORT, desk) catch 1

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

# send one line and wait for the reply before the caller writes the next.
fn say(chat: grpc.BidiStream, line: String) -> String!grpc.GrpcError:
    print("me:  {line}")
    chat.send(encode_text(line))
    step := chat.recv()!
    if step.done:
        fail grpc.GrpcError(grpc.GRPC_UNAVAILABLE, "the desk hung up")
    reply := decode_text(step.message) catch "?"
    print("bot: {reply}")
    return reply

fn talk(conn: grpc.Conn) -> Int!grpc.GrpcError:
    chat := conn.bidi_stream("/help.Desk/Chat")!
    defer chat.close()
    say(chat, "where is my order?")!
    say(chat, "1042")!
    chat.close_send()
    if chat.recv()!.done:
        print("conversation over")
    return 0

fn main() -> Int!:
    spawn run_server()
    conn := connect()!
    defer conn.close()
    talk(conn) catch:
        fail "chat failed"
    return 0
