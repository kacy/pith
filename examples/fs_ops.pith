# paths and directories: stage a small static site for release.
#
# std.fs works on whole files and directory trees, and std.os.path builds and
# takes apart the paths. the example lays out a site's source, copies it into
# a release directory, drops the drafts, writes a manifest atomically, and
# prints what shipped. it all happens under one temp directory that main
# removes on the way out, so it leaves nothing behind and reads the same on
# every machine.

import std.algo as algo
import std.fs as fs
import std.os.path as path

fn write_source(src: String) -> Int!:
    pages := [
        ("index.html", "<h1>welcome</h1>"),
        ("about.html", "<p>about us</p>"),
        ("drafts/launch.html", "<p>coming soon</p>"),
        ("assets/site.css", "body {{ margin: 0 }}"),
    ]
    for page in pages:
        target := path.join(src, page.0)
        fs.make_dirs(path.dir(target))
        fs.write(target, page.1)!
    return pages.len()

# every file under root, as a path relative to it, in sorted order.
fn files_under(root: String) -> List[String]!:
    mut found: List[String] := []
    for entry in fs.walk(root)!:
        if not entry.is_dir:
            found.push(path.rel(root, entry.path))
    return algo.sort_strings(found)

fn main() -> Int!:
    work := fs.make_temp_dir("pith_fs_ops_")!
    defer fs.remove_tree(work)
    src := path.join(work, "src")
    release := path.join(work, "release")

    print("wrote {write_source(src)!} source files")
    fs.copy_tree(src, release)!

    # drafts stay in the source tree but never ship.
    fs.remove_tree(path.join(release, "drafts"))
    print("draft still in source: {fs.exists(path.join(src, "drafts/launch.html"))}")

    shipped := files_under(release)!
    # write_atomic renames a finished temp file into place, so a reader never
    # sees half a manifest.
    fs.write_atomic(path.join(release, "MANIFEST"), shipped.join("\n"))!

    print("release:")
    for name in files_under(release)!:
        size := fs.size(path.join(release, name))!
        print("  {name:<18} {size:>3} bytes")
    return 0
