# the other half: the same struct name with different fields and methods.
pub struct Options:
    pub port: Int

pub fn make() -> Options:
    return Options(1)

impl Options:
    fn with_port(port: Int) -> Options:
        return Options(port)

    fn merged(with: Options) -> Options:
        return Options(self.port + with.port)

    fn only_on_b() -> Int:
        return self.port * 2
