struct Box:
    label: String
    n: Int

fn make_box(n: Int) -> Box:
    return Box("lbl-" + n.to_string(), n)

fn invoke(f: fn(Int) -> Box, x: Int) -> Box:
    return f(x)

fn twice(f: fn(Int) -> Box) -> Int:
    a := f(1)
    b := f(2)
    return a.n + b.n

fn main():
    via := invoke(make_box, 9)
    print(via.label)
    print(via.n.to_string())
    print(twice(make_box).to_string())
