# std.toml — TOML v1.0 parser
#
# parse TOML configuration files into a tree structure.
# uses opaque Int handles into a node pool.
#
#   import std.toml as toml
#   root := toml.parse(data)
#   name := toml.get_string(root, "name")
#   db := toml.get_table(root, "database")
#   host := toml.get_string(db, "host")

import std.bytes as bytes
import std.io as io

TOML_FILE_CHUNK_SIZE := 4096

## TOML decode failure with a human-readable message.
pub struct TomlDecodeError:
    pub message: String

## An open node-pool scope. Treat it as opaque and hand it straight back to
## close_scope(); the fields are the pool positions the scope rolls back to.
pub struct TomlScope:
    pub depth: Int
    pub node_mark: Int
    pub table_mark: Int
    pub array_mark: Int

fn toml_decode_fail(message: String) -> TomlDecodeError:
    return TomlDecodeError(message)

# ===============================================================
# Node Pool
# ===============================================================

# Node ids come from a counter that only ever goes up, even across a reclaim.
# Reusing ids would make a handle held past its scope silently read whatever
# document landed on that id next; leaving the counter alone costs nothing and
# turns that mistake into a plain "invalid handle".
threadlocal mut next_node_id: Int := 0
threadlocal mut node_types: Map[Int, String] := {}
threadlocal mut string_values: Map[Int, String] := {}
threadlocal mut integer_values: Map[Int, Int] := {}
threadlocal mut float_values: Map[Int, Float] := {}
threadlocal mut boolean_values: Map[Int, Bool] := {}

# Table children: flat append-only storage with offset/count
threadlocal mut table_keys_flat: List[String] := []
threadlocal mut table_values_flat: List[Int] := []
threadlocal mut table_key_offsets: Map[Int, Int] := {}
threadlocal mut table_key_counts: Map[Int, Int] := {}

# Array children: flat append-only storage with offset/count
threadlocal mut array_items_flat: List[Int] := []
threadlocal mut array_item_offsets: Map[Int, Int] := {}
threadlocal mut array_item_counts: Map[Int, Int] := {}

# How many scopes open_scope() has handed out and not yet reclaimed.
threadlocal mut open_scope_depth: Int := 0

# Allocates a new node of the specified type
fn allocate_node(kind: String) -> Int:
    idx := next_node_id
    next_node_id = next_node_id + 1
    node_types.insert(idx, kind)
    string_values.insert(idx, "")
    integer_values.insert(idx, 0)
    float_values.insert(idx, 0.0)
    boolean_values.insert(idx, false)
    table_key_offsets.insert(idx, 0)
    table_key_counts.insert(idx, 0)
    array_item_offsets.insert(idx, 0)
    array_item_counts.insert(idx, 0)
    return idx

# Sets a key-value pair in a table
fn set_table_property(handle: Int, key: String, val: Int):
    off := table_key_offsets[handle]
    cnt := table_key_counts[handle]
    # for well-formed TOML, duplicates don't occur — just append
    if cnt == 0:
        table_key_offsets.insert(handle, table_keys_flat.len())
    table_keys_flat.push(key)
    table_values_flat.push(val)
    table_key_counts.insert(handle, cnt + 1)

# Appends a value to an array
fn push_array_element(handle: Int, val: Int):
    cnt := array_item_counts[handle]
    if cnt == 0:
        array_item_offsets.insert(handle, array_items_flat.len())
    array_items_flat.push(val)
    array_item_counts.insert(handle, cnt + 1)

# ===============================================================
# Node-pool reclamation
# ===============================================================
#
# the typed decoders (decode_text[T], decode_text_path[T]) own the parse that
# fills the node pool, then copy scalars and strings out into a concrete struct.
# once that struct is materialized the nodes are dead, so the compiler brackets
# the lowered decode body with a mark taken here and a pool_restore() on every
# exit. the marks are plain ints so the bracket costs no allocation of its own.

# reclaims every node allocated since the given marks. table and array children
# live in append-only flat lists, so truncating them to the marked lengths drops
# exactly the entries added since. safe once the struct is built: its string
# fields are independent heap copies, not references back into the pool.
fn toml_restore_to(node_id_mark: Int, table_flat_mark: Int, array_flat_mark: Int):
    mut node_id := next_node_id - 1
    while node_id >= node_id_mark:
        if node_types.contains_key(node_id):
            node_types.remove(node_id)
            string_values.remove(node_id)
            integer_values.remove(node_id)
            float_values.remove(node_id)
            boolean_values.remove(node_id)
            table_key_offsets.remove(node_id)
            table_key_counts.remove(node_id)
            array_item_offsets.remove(node_id)
            array_item_counts.remove(node_id)
        node_id = node_id - 1
    # table_keys_flat and table_values_flat grow in lockstep, so one mark covers both.
    while table_keys_flat.len() > table_flat_mark:
        table_keys_flat.remove(table_keys_flat.len() - 1)
    while table_values_flat.len() > table_flat_mark:
        table_values_flat.remove(table_values_flat.len() - 1)
    while array_items_flat.len() > array_flat_mark:
        array_items_flat.remove(array_items_flat.len() - 1)

# node-pool position a compiler-lowered typed decode rolls back to.
pub fn pool_mark_node_id() -> Int:
    return next_node_id

# table-children position a compiler-lowered typed decode rolls back to.
pub fn pool_mark_table_len() -> Int:
    return table_keys_flat.len()

# array-children position a compiler-lowered typed decode rolls back to.
pub fn pool_mark_array_len() -> Int:
    return array_items_flat.len()

# reclaims the pool nodes a compiler-lowered typed decode allocated.
pub fn pool_restore(node_id_mark: Int, table_flat_mark: Int, array_flat_mark: Int):
    toml_restore_to(node_id_mark, table_flat_mark, array_flat_mark)

# opens a node-pool scope. every node parsed between here and the matching
# close_scope() is reclaimed when the scope closes. pair it with defer:
#
#     scope := toml.open_scope()
#     defer toml.close_scope(scope)
#     root := toml.parse(text)
#
# most programs read their toml once at startup and never need this. it exists
# for the ones that reload configuration on a signal or a timer, where the same
# task parses the same file over and over. copy what you need out of the tree
# before the scope closes.
pub fn open_scope() -> TomlScope:
    open_scope_depth = open_scope_depth + 1
    return TomlScope(open_scope_depth, next_node_id, table_keys_flat.len(), array_items_flat.len())

# closes a scope opened by open_scope() and reclaims the nodes parsed inside it.
#
# scopes nest and close innermost-first. closing an outer scope while an inner
# one is still open also closes the inner one — an arena can only give back a
# suffix of what it handed out. closing a scope twice does nothing. no handle
# from a closed scope can come back to life: node ids are never reused, so
# reading one reports "invalid" rather than some later document's value.
pub fn close_scope(scope: TomlScope):
    if scope.depth > open_scope_depth:
        return
    toml_restore_to(scope.node_mark, scope.table_mark, scope.array_mark)
    open_scope_depth = scope.depth - 1

# how many nodes the pool currently holds. useful for asserting in a test that
# a parse loop gives its nodes back.
pub fn pool_live_nodes() -> Int:
    return node_types.len()

# ===============================================================
# Parser (Internal)
# ===============================================================

# Parser state
threadlocal mut parser_input: String := ""
threadlocal mut parser_position: Int := 0
threadlocal mut parser_error: Bool := false
threadlocal mut parser_depth: Int := 0

# Maximum nested-array depth. Deep enough for any real document, shallow
# enough that the recursive value parser can't overflow the native stack.
# A stack overflow is a SIGSEGV, which no error handler can catch, so we have
# to stop before it happens rather than recover from it.
MAX_PARSE_DEPTH := 128

# Returns character at position i or empty string if out of bounds
fn get_char_at(i: Int) -> String:
    if i >= parser_input.len():
        return ""
    return parser_input[i]

# true when `word` sits at `at` in the input.
#
# the comparison is byte by byte rather than against a slice. len() counts
# bytes and substring() takes byte offsets, so slicing `word.len()` bytes out
# of the input to compare them would cut through whatever character happens to
# straddle that offset, and a cut through a character stops the process outright
# — no catch can intercept it. the literal probes below run on any value
# position, before anything has established that the bytes there are ascii, so
# a document with a multi-byte character in the wrong place used to end the
# process instead of failing to parse. indexing reads one byte and never cuts
# anything, so it is safe wherever a slice is not.
fn literal_at(at: Int, word: String) -> Bool:
    if at + word.len() > parser_input.len():
        return false
    mut i := 0
    while i < word.len():
        if ord(parser_input[at + i]) != ord(word[i]):
            return false
        i = i + 1
    return true

# Returns a node's kind, or "" when the handle names no live node. A kind is
# never empty, so one lookup answers both "does it exist" and "what is it".
# node ids are never reused, so a handle left over from a reclaimed scope
# reads as "no live node" rather than aliasing a later document's node.
fn node_kind(handle: Int) -> String:
    return node_types.get_default(handle, "")

# Looks up a direct key in a table and returns the child handle, or -1.
fn table_lookup(handle: Int, key: String) -> Int:
    if node_kind(handle) != "table":
        return 0 - 1
    off := table_key_offsets[handle]
    cnt := table_key_counts[handle]
    mut i := 0
    while i < cnt:
        if table_keys_flat[off + i] == key:
            return table_values_flat[off + i]
        i = i + 1
    return 0 - 1

# Skips whitespace (space, tab, carriage return)
fn skip_whitespace():
    while parser_position < parser_input.len() and (get_char_at(parser_position) == " " or get_char_at(parser_position) == chr(9) or get_char_at(parser_position) == chr(13)):
        parser_position = parser_position + 1

# Skips a comment from # to end of line
fn skip_comment():
    if parser_position < parser_input.len() and get_char_at(parser_position) == "#":
        while parser_position < parser_input.len() and get_char_at(parser_position) != chr(10):
            parser_position = parser_position + 1

# Skips the rest of the current line (ws, comment, newline)
fn skip_line():
    skip_whitespace()
    skip_comment()
    if parser_position < parser_input.len() and get_char_at(parser_position) == chr(10):
        parser_position = parser_position + 1

# Returns true if character is valid in a bare key
fn is_key_char(c: String) -> Bool:
    if c >= "a" and c <= "z":
        return true
    if c >= "A" and c <= "Z":
        return true
    if c >= "0" and c <= "9":
        return true
    if c == "-" or c == "_":
        return true
    return false

# Parses a key (quoted or bare)
fn parse_key() -> String:
    skip_whitespace()
    # quoted key
    if parser_position < parser_input.len() and get_char_at(parser_position) == chr(34):
        parser_position = parser_position + 1
        start := parser_position
        while parser_position < parser_input.len() and get_char_at(parser_position) != chr(34):
            parser_position = parser_position + 1
        if parser_position >= parser_input.len():
            # unterminated quoted key
            parser_error = true
            return ""
        result := parser_input.substring(start, parser_position)
        parser_position = parser_position + 1
        return result
    # bare key
    start := parser_position
    while parser_position < parser_input.len() and is_key_char(get_char_at(parser_position)):
        parser_position = parser_position + 1
    return parser_input.substring(start, parser_position)

# Returns true if character is valid in a number
fn is_number_char(c: String) -> Bool:
    if c >= "0" and c <= "9":
        return true
    if c == "." or c == "e" or c == "E" or c == "+" or c == "-" or c == "_":
        return true
    return false

# Parses an integer from a string manually. Sets parser_error on overflow
# instead of silently wrapping to a meaningless value.
fn parse_integer_manual(s: String) -> Int:
    mut val := 0
    mut neg := false
    mut i := 0
    if s.len() > 0 and s[0] == "-":
        neg = true
        i = 1
    if s.len() > 0 and s[0] == "+":
        i = 1
    while i < s.len():
        c := s[i]
        if c >= "0" and c <= "9":
            digit := ord(c) - 48
            if val > 922337203685477580 / 10:
                parser_error = true
                return 0
            val = val * 10 + digit
        i = i + 1
    if neg:
        return 0 - val
    return val

# Parses a float from a string manually
fn parse_float_manual(s: String) -> Float:
    # split on decimal point, compute integer + fractional parts
    mut int_part := 0
    mut frac_part := 0.0
    mut frac_div := 1.0
    mut neg := false
    mut i := 0
    mut in_frac := false
    if s.len() > 0 and s[0] == "-":
        neg = true
        i = 1
    if s.len() > 0 and s[0] == "+":
        i = 1
    while i < s.len():
        c := s[i]
        if c == ".":
            in_frac = true
        if c >= "0" and c <= "9" and not in_frac:
            int_part = int_part * 10 + (ord(c) - 48)
        if c >= "0" and c <= "9" and in_frac:
            frac_div = frac_div * 10.0
            frac_part = frac_part + (ord(c) - 48).to_float() / frac_div
        i = i + 1
    result := int_part.to_float() + frac_part
    if neg:
        return 0.0 - result
    return result

# Main recursive value parser.
# Guards nesting depth so a pathological "k = [[[[..." value fails cleanly
# instead of crashing the process with a stack overflow.
fn parse_value() -> Int:
    parser_depth = parser_depth + 1
    if parser_depth > MAX_PARSE_DEPTH:
        parser_error = true
        parser_depth = parser_depth - 1
        return 0 - 1
    result := parse_value_node()
    parser_depth = parser_depth - 1
    return result

fn parse_value_node() -> Int:
    skip_whitespace()
    if parser_position >= parser_input.len():
        parser_error = true
        return 0 - 1
    c := get_char_at(parser_position)

    # string
    if c == chr(34):
        parser_position = parser_position + 1
        start := parser_position
        while parser_position < parser_input.len() and get_char_at(parser_position) != chr(34):
            if get_char_at(parser_position) == chr(92):
                parser_position = parser_position + 1
            parser_position = parser_position + 1
        if parser_position >= parser_input.len():
            # unterminated string — reject rather than accept the truncation
            parser_error = true
            return 0 - 1
        val := parser_input.substring(start, parser_position)
        parser_position = parser_position + 1
        idx := allocate_node("string")
        string_values.insert(idx, val)
        return idx

    # boolean true
    if literal_at(parser_position, "true"):
        parser_position = parser_position + 4
        idx := allocate_node("bool")
        boolean_values.insert(idx, true)
        return idx
    # boolean false
    if literal_at(parser_position, "false"):
        parser_position = parser_position + 5
        idx := allocate_node("bool")
        return idx

    # array
    if c == "[":
        parser_position = parser_position + 1
        arr := allocate_node("array")
        skip_whitespace()
        mut iterations := 0
        mut last_pos := parser_position
        while parser_position < parser_input.len() and get_char_at(parser_position) != "]":
            iterations = iterations + 1
            # Safety: prevent infinite loops on malformed input
            if iterations > 10000:
                parser_error = true
                return 0 - 1
            # Ensure we're making progress
            if parser_position == last_pos and iterations > 1:
                parser_error = true
                return 0 - 1
            last_pos = parser_position
            skip_whitespace()
            if parser_position < parser_input.len() and get_char_at(parser_position) == chr(10):
                parser_position = parser_position + 1
            if parser_position < parser_input.len() and get_char_at(parser_position) == "#":
                skip_comment()
            if parser_position < parser_input.len() and get_char_at(parser_position) != "]" and get_char_at(parser_position) != chr(10) and get_char_at(parser_position) != "#":
                val := parse_value()
                if parser_error:
                    return 0 - 1
                push_array_element(arr, val)
                skip_whitespace()
                if parser_position < parser_input.len() and get_char_at(parser_position) == ",":
                    parser_position = parser_position + 1
                skip_whitespace()
                while parser_position < parser_input.len() and get_char_at(parser_position) == chr(10):
                    parser_position = parser_position + 1
        if parser_position < parser_input.len():
            parser_position = parser_position + 1
        return arr

    # number (int or float)
    if (c >= "0" and c <= "9") or c == "-" or c == "+":
        start := parser_position
        mut is_float := false
        if c == "-" or c == "+":
            parser_position = parser_position + 1
        while parser_position < parser_input.len() and is_number_char(get_char_at(parser_position)):
            d := get_char_at(parser_position)
            if d == "." or d == "e" or d == "E":
                is_float = true
            parser_position = parser_position + 1
        num_str := parser_input.substring(start, parser_position)
        if is_float:
            idx := allocate_node("float")
            float_values.insert(idx, parse_float_manual(num_str))
            return idx
        if not is_float:
            idx := allocate_node("int")
            integer_values.insert(idx, parse_integer_manual(num_str))
            return idx

    parser_error = true
    return 0 - 1

# Ensures a nested table path exists, creating intermediate tables as needed.
# Takes a dot-separated path like "database.connection" and returns the table handle.
fn ensure_table_path(root: Int, path: String) -> Int:
    mut current := root
    mut start := 0
    mut i := 0
    while i <= path.len():
        mut is_sep := i == path.len()
        if not is_sep and i < path.len() and path[i] == ".":
            is_sep = true
        if is_sep:
            key := path.substring(start, i)
            # look up existing child in current table
            off := table_key_offsets[current]
            cnt := table_key_counts[current]
            mut found := 0 - 1
            mut j := 0
            while j < cnt:
                if table_keys_flat[off + j] == key:
                    found = table_values_flat[off + j]
                j = j + 1
            if found < 0:
                found = allocate_node("table")
                set_table_property(current, key, found)
            current = found
            start = i + 1
        i = i + 1
    return current

# ===============================================================
# Public API — Parsing
# ===============================================================

# Parses a TOML string and returns a root table handle.
# Returns -1 on parse error. The root is a table containing all top-level keys.
pub fn parse(input: String) -> Int:
    return toml_parse(input)

fn toml_parse(input: String) -> Int:
    parser_input = input
    parser_position = 0
    parser_error = false
    parser_depth = 0
    root := allocate_node("table")
    mut current_table := root

    while parser_position < parser_input.len():
        skip_whitespace()
        if parser_position >= parser_input.len():
            return root
        c := get_char_at(parser_position)

        # skip blank lines
        if c == chr(10):
            parser_position = parser_position + 1
        # skip comments
        if c == "#":
            skip_comment()
        # table header [name]
        if c == "[":
            parser_position = parser_position + 1
            skip_whitespace()
            start := parser_position
            while parser_position < parser_input.len() and get_char_at(parser_position) != "]":
                parser_position = parser_position + 1
            section := parser_input.substring(start, parser_position)
            if parser_position < parser_input.len():
                parser_position = parser_position + 1
            current_table = ensure_table_path(root, section)
            skip_line()
        # key = value
        if c != chr(10) and c != "#" and c != "[":
            key := parse_key()
            skip_whitespace()
            if parser_position < parser_input.len() and get_char_at(parser_position) == "=":
                parser_position = parser_position + 1
            val := parse_value()
            if parser_error:
                return 0 - 1
            set_table_property(current_table, key, val)
            skip_line()

    if parser_error:
        return 0 - 1
    return root

# parse a toml file from disk.
pub fn parse_file(path: String) -> Int:
    return toml_parse_file(path)

fn toml_parse_file(path: String) -> Int:
    return toml_parse_file_chunked(path, TOML_FILE_CHUNK_SIZE)

# parse a toml file using a custom read chunk size.
pub fn parse_file_chunked(path: String, chunk_size: Int) -> Int:
    return toml_parse_file_chunked(path, chunk_size)

fn toml_parse_file_chunked(path: String, chunk_size: Int) -> Int:
    data_result := io.read_file_text_chunked(path, chunk_size)
    if data_result.is_err:
        return 0 - 1
    return toml_parse(data_result.ok)

## Parse TOML and fail if the input is invalid.
# --- flat scalar scanning ---------------------------------------------------
#
# most toml a program reads is a flat block of `key = value` lines, and building
# the node tree for it costs an order of magnitude more than the read that
# follows. scan_scalars walks the text once and fills three maps, allocating no
# nodes and needing no scope, which is what makes it worth having next to
# parse(): on a twelve-key document it is roughly fifteen times faster end to
# end.
#
# it is deliberately narrow. the moment it meets anything it cannot represent
# exactly — a [table] header, an array, an inline table, a float, a date, a
# multi-line string — it reports `ok: false` rather than skipping the field and
# handing back a half-read document. a scanner that silently drops what it does
# not understand is worse than no scanner, so callers that need the whole
# grammar fall back to parse().

## the scalar fields of a flat toml document, scanned without building nodes.
## `ok` is false when the document is not flat scalars end to end, in which
## case the maps are empty and parse() is the tool to reach for.
pub struct TomlScalars:
    pub ok: Bool
    pub strings: Map[String, String]
    pub ints: Map[String, Int]
    pub bools: Map[String, Bool]

fn empty_scalars(ok: Bool) -> TomlScalars:
    strings: Map[String, String] := {}
    ints: Map[String, Int] := {}
    bools: Map[String, Bool] := {}
    return TomlScalars(ok, strings, ints, bools)

# a bare key runs to the '=' and holds only the characters toml allows unquoted.
fn is_bare_key_byte(b: Int) -> Bool:
    if b >= 97 and b <= 122:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 48 and b <= 57:
        return true
    return b == 95 or b == 45

fn skip_blanks(data: Bytes, start: Int) -> Int:
    mut i := start
    while i < data.len() and (data[i] == 32 or data[i] == 9):
        i = i + 1
    return i

# where a value ends: at the newline, or at a trailing comment, which config
# files use constantly and which carries no value of its own.
fn value_ends(data: Bytes, at: Int, stop: Int) -> Bool:
    i := skip_blanks(data, at)
    if i >= stop:
        return true
    return data[i] == 35

# the end of the line starting at `start` — the index of its newline, or the end.
fn line_end(data: Bytes, start: Int) -> Int:
    mut i := start
    while i < data.len() and data[i] != 10:
        i = i + 1
    return i

## scan a flat toml document's scalar fields in one pass. see the note above for
## what "flat" means and why anything else reports `ok: false`.
pub fn scan_scalars(input: String) -> TomlScalars:
    data := bytes.from_string_utf8(input)
    mut out := empty_scalars(true)
    mut pos := 0
    while pos < data.len():
        pos = skip_blanks(data, pos)
        if pos >= data.len():
            return out
        b := data[pos]
        # a blank line or a comment carries no field
        if b == 10:
            pos = pos + 1
            continue
        if b == 35:
            pos = line_end(data, pos) + 1
            continue
        # a table header means the document is not flat
        if b == 91:
            return empty_scalars(false)

        key_start := pos
        while pos < data.len() and is_bare_key_byte(data[pos]):
            pos = pos + 1
        if pos == key_start:
            return empty_scalars(false)
        key := data.slice(key_start, pos).to_string_utf8() catch ""
        if key.len() == 0:
            return empty_scalars(false)

        pos = skip_blanks(data, pos)
        if pos >= data.len() or data[pos] != 61:
            return empty_scalars(false)
        pos = skip_blanks(data, pos + 1)
        if pos >= data.len():
            return empty_scalars(false)

        stop := line_end(data, pos)
        v := data[pos]
        if v == 34:
            # a basic string, and only one that ends on this line with nothing
            # after it. an escape means the value needs the real unescaper.
            mut i := pos + 1
            mut escaped := false
            while i < stop and data[i] != 34:
                if data[i] == 92:
                    escaped = true
                i = i + 1
            if i >= stop or escaped:
                return empty_scalars(false)
            text := data.slice(pos + 1, i).to_string_utf8() catch ""
            if not value_ends(data, i + 1, stop):
                return empty_scalars(false)
            out.strings.insert(key, text)
        elif match_word(data, pos, "true", stop):
            out.bools.insert(key, true)
        elif match_word(data, pos, "false", stop):
            out.bools.insert(key, false)
        else:
            # an integer, and nothing that merely starts like one: a float, a
            # date, or a trailing token all fall through to the tree parser.
            n := read_int(data, pos, stop)
            if not n.ok:
                return empty_scalars(false)
            out.ints.insert(key, n.value)
        pos = stop + 1
    return out

# whether `word` sits at `pos` and the rest of the line after it is blank.
fn match_word(data: Bytes, pos: Int, word: String, stop: Int) -> Bool:
    w := bytes.from_string_utf8(word)
    if pos + w.len() > stop:
        return false
    mut i := 0
    while i < w.len():
        if data[pos + i] != w[i]:
            return false
        i = i + 1
    return value_ends(data, pos + w.len(), stop)

struct ScannedInt:
    ok: Bool
    value: Int

# the integer filling [pos, stop) exactly, underscores allowed as toml spells
# them. anything else — a sign with no digits, a decimal point, a stray token —
# is not an integer this scanner will claim.
fn read_int(data: Bytes, pos: Int, stop: Int) -> ScannedInt:
    mut i := pos
    mut negative := false
    if i < stop and (data[i] == 43 or data[i] == 45):
        negative = data[i] == 45
        i = i + 1
    mut digits := 0
    mut value := 0
    while i < stop:
        b := data[i]
        if b == 95:
            i = i + 1
            continue
        if b < 48 or b > 57:
            break
        value = value * 10 + (b - 48)
        digits = digits + 1
        i = i + 1
    if digits == 0 or not value_ends(data, i, stop):
        return ScannedInt(false, 0)
    if negative:
        value = 0 - value
    return ScannedInt(true, value)

## scan a flat toml document's scalars, or fail with a typed error when it is
## not flat. the loud form of scan_scalars, and the mirror of json's
## decode_scalars.
pub fn decode_scalars(input: String) -> TomlScalars!TomlDecodeError:
    out := scan_scalars(input)
    if not out.ok:
        fail toml_decode_fail("toml document is not a flat block of scalar fields")
    return out

impl TomlScalars:
    ## the string at `key`, or a typed error when the document has no such
    ## string field.
    pub fn require_string(key: String) -> String!TomlDecodeError:
        if self.strings.contains_key(key):
            return self.strings[key]
        fail toml_decode_fail("missing string field: " + key)

    ## the integer at `key`, or a typed error.
    pub fn require_int(key: String) -> Int!TomlDecodeError:
        if self.ints.contains_key(key):
            return self.ints[key]
        fail toml_decode_fail("missing int field: " + key)

    ## the boolean at `key`, or a typed error.
    pub fn require_bool(key: String) -> Bool!TomlDecodeError:
        if self.bools.contains_key(key):
            return self.bools[key]
        fail toml_decode_fail("missing bool field: " + key)

    ## the string at `key`, or `fallback` when it is absent.
    pub fn string_or(key: String, fallback: String) -> String:
        if self.strings.contains_key(key):
            return self.strings[key]
        return fallback

    ## the integer at `key`, or `fallback` when it is absent.
    pub fn int_or(key: String, fallback: Int) -> Int:
        if self.ints.contains_key(key):
            return self.ints[key]
        return fallback

    ## the boolean at `key`, or `fallback` when it is absent.
    pub fn bool_or(key: String, fallback: Bool) -> Bool:
        if self.bools.contains_key(key):
            return self.bools[key]
        return fallback

    ## whether a string field named `key` was scanned.
    pub fn has_string(key: String) -> Bool:
        return self.strings.contains_key(key)

    ## whether an integer field named `key` was scanned.
    pub fn has_int(key: String) -> Bool:
        return self.ints.contains_key(key)

    ## whether a boolean field named `key` was scanned.
    pub fn has_bool(key: String) -> Bool:
        return self.bools.contains_key(key)

## parses a toml document and returns the root table handle or a typed error.
pub fn parse_required(input: String) -> Int!TomlDecodeError:
    root := parse(input)
    if root < 0 or type_of(root) != "table":
        fail toml_decode_fail("invalid toml document")
    return root

## parses a toml file and returns the root table handle or a typed error.
pub fn parse_file_required(file_path: String) -> Int!TomlDecodeError:
    root := parse_file(file_path)
    if root < 0 or type_of(root) != "table":
        fail toml_decode_fail("invalid toml document")
    return root

# ===============================================================
# Public API — Type and Introspection
# ===============================================================

# Returns the type of a node: "string", "int", "float", "bool", "table", or "array".
# Returns "invalid" for invalid handles.
pub fn type_of(handle: Int) -> String:
    return toml_type_of(handle)

fn toml_type_of(handle: Int) -> String:
    kind := node_kind(handle)
    if kind == "":
        return "invalid"
    return kind

# ===============================================================
# Public API — Table Value Accessors
# ===============================================================

# Gets a child value handle by key from a table. Returns -1 if not found.
pub fn get_value(handle: Int, key: String) -> Int:
    return table_lookup(handle, key)

# Gets a string value by key from a table. Returns empty string if not found or wrong type.
pub fn get_string(handle: Int, key: String) -> String:
    return toml_get_string(handle, key)

fn toml_get_string(handle: Int, key: String) -> String:
    v := table_lookup(handle, key)
    if node_kind(v) == "string":
        return string_values[v]
    return ""

## get a required string field or return a typed decode error.
pub fn require_string(handle: Int, key: String) -> String!TomlDecodeError:
    v := table_lookup(handle, key)
    if v < 0:
        fail toml_decode_fail("missing string field: " + key)
    if node_kind(v) != "string":
        fail toml_decode_fail("expected string field: " + key)
    return string_values[v]

# Gets a string value by key from a table with a fallback.
pub fn get_string_or(handle: Int, key: String, default_value: String) -> String:
    v := table_lookup(handle, key)
    if node_kind(v) == "string":
        return string_values[v]
    return default_value

# Gets an integer value by key from a table. Returns 0 if not found or wrong type.
pub fn get_int(handle: Int, key: String) -> Int:
    return toml_get_int(handle, key)

fn toml_get_int(handle: Int, key: String) -> Int:
    v := table_lookup(handle, key)
    if node_kind(v) == "int":
        return integer_values[v]
    return 0

## get a required int field or return a typed decode error.
pub fn require_int(handle: Int, key: String) -> Int!TomlDecodeError:
    v := table_lookup(handle, key)
    if v < 0:
        fail toml_decode_fail("missing int field: " + key)
    if node_kind(v) != "int":
        fail toml_decode_fail("expected int field: " + key)
    return integer_values[v]

# Gets an integer value by key from a table with a fallback.
pub fn get_int_or(handle: Int, key: String, default_value: Int) -> Int:
    v := table_lookup(handle, key)
    if node_kind(v) == "int":
        return integer_values[v]
    return default_value

# Gets a float value by key from a table. Returns 0.0 if not found or wrong type.
pub fn get_float(handle: Int, key: String) -> Float:
    return toml_get_float(handle, key)

fn toml_get_float(handle: Int, key: String) -> Float:
    v := table_lookup(handle, key)
    if node_kind(v) == "float":
        return float_values[v]
    return 0.0

# Gets a float value by key from a table with a fallback.
pub fn get_float_or(handle: Int, key: String, default_value: Float) -> Float:
    v := table_lookup(handle, key)
    if node_kind(v) == "float":
        return float_values[v]
    return default_value

# Gets a boolean value by key from a table. Returns false if not found or wrong type.
pub fn get_bool(handle: Int, key: String) -> Bool:
    return toml_get_bool(handle, key)

fn toml_get_bool(handle: Int, key: String) -> Bool:
    v := table_lookup(handle, key)
    if node_kind(v) == "bool":
        return boolean_values[v]
    return false

## get a required bool field or return a typed decode error.
pub fn require_bool(handle: Int, key: String) -> Bool!TomlDecodeError:
    v := table_lookup(handle, key)
    if v < 0:
        fail toml_decode_fail("missing bool field: " + key)
    if node_kind(v) != "bool":
        fail toml_decode_fail("expected bool field: " + key)
    return boolean_values[v]

# Gets a boolean value by key from a table with a fallback.
pub fn get_bool_or(handle: Int, key: String, default_value: Bool) -> Bool:
    v := table_lookup(handle, key)
    if node_kind(v) == "bool":
        return boolean_values[v]
    return default_value

# Gets a sub-table handle by key. Returns -1 if not found or not a table.
pub fn get_table(handle: Int, key: String) -> Int:
    return toml_get_table(handle, key)

fn toml_get_table(handle: Int, key: String) -> Int:
    v := table_lookup(handle, key)
    if node_kind(v) == "table":
        return v
    return 0 - 1

# Gets an array handle by key. Returns -1 if not found or not an array.
pub fn get_array(handle: Int, key: String) -> Int:
    return toml_get_array(handle, key)

fn toml_get_array(handle: Int, key: String) -> Int:
    v := table_lookup(handle, key)
    if node_kind(v) == "array":
        return v
    return 0 - 1

# ===============================================================
# Public API — Array Operations
# ===============================================================

# Returns the number of elements in an array. Returns 0 for non-arrays.
pub fn array_len(handle: Int) -> Int:
    return toml_array_len(handle)

fn toml_array_len(handle: Int) -> Int:
    if node_kind(handle) != "array":
        return 0
    return array_item_counts[handle]

# Gets the handle of an array element by index. Returns -1 if out of bounds.
pub fn array_get(handle: Int, index: Int) -> Int:
    return toml_array_get(handle, index)

fn toml_array_get(handle: Int, index: Int) -> Int:
    if node_kind(handle) != "array":
        return 0 - 1
    if index < 0 or index >= array_item_counts[handle]:
        return 0 - 1
    return array_items_flat[array_item_offsets[handle] + index]

# ===============================================================
# Public API — Table Introspection
# ===============================================================

# Returns the list of keys in a table (insertion order).
pub fn keys(handle: Int) -> List[String]:
    return toml_keys(handle)

fn toml_keys(handle: Int) -> List[String]:
    mut result: List[String] := []
    if node_kind(handle) != "table":
        return result
    off := table_key_offsets[handle]
    cnt := table_key_counts[handle]
    mut i := 0
    while i < cnt:
        result.push(table_keys_flat[off + i])
        i = i + 1
    return result

# Returns true if a table contains the specified key.
pub fn has(handle: Int, key: String) -> Bool:
    return toml_has(handle, key)

fn toml_has(handle: Int, key: String) -> Bool:
    return table_lookup(handle, key) >= 0

## decode a toml table handle into a concrete struct with public string/int/bool fields.
pub fn decode[T](handle: Int) -> T!TomlDecodeError:
    fail toml_decode_fail("toml.decode requires compiler support")

## parse toml text and decode it into a concrete struct.
pub fn decode_text[T](input: String) -> T!TomlDecodeError:
    fail toml_decode_fail("toml.decode_text requires compiler support")

## the sub-table a key names, or a typed error when the key is missing or does
## not hold a table. this is the step a dotted decode path walks with.
pub fn require_table(handle: Int, key: String) -> Int!TomlDecodeError:
    child := table_lookup(handle, key)
    if child < 0:
        fail toml_decode_fail("missing table field: " + key)
    if node_kind(child) != "table":
        fail toml_decode_fail("expected table field: " + key)
    return child

## decode a nested table selected by a dotted path.
pub fn decode_path[T](handle: Int, dotted_path: String) -> T!TomlDecodeError:
    mut current := handle
    for part in dotted_path.split("."):
        if part == "":
            continue
        current = require_table(current, part)!
    return decode[T](current)!

## parse toml text and decode a nested table selected by a dotted path.
pub fn decode_text_path[T](input: String, dotted_path: String) -> T!TomlDecodeError:
    root := parse_required(input)!
    return decode_path[T](root, dotted_path)!

## loads a toml file and decodes it into a concrete struct.
pub fn decode_file[T](file_path: String) -> T!TomlDecodeError:
    return decode[T](parse_file_required(file_path)!)!

## loads a toml file and decodes a nested table selected by a dotted path.
pub fn decode_file_path[T](file_path: String, dotted_path: String) -> T!TomlDecodeError:
    return decode_path[T](parse_file_required(file_path)!, dotted_path)!

struct TomlNestedFixture:
    pub host: String
    pub port: Int

test "toml parses scalar values":
    doc := "title = " + chr(34) + "pith" + chr(34) + chr(10) + "version = 3" + chr(10) + "pi = 3.14" + chr(10) + "enabled = true"
    root := parse(doc)

    assert_eq(type_of(root), "table")
    assert_eq(get_string(root, "title"), "pith")
    assert_eq(get_int(root, "version"), 3)
    assert(get_float(root, "pi") > 3.1)
    assert(get_bool(root, "enabled"))
    assert_eq(get_string_or(root, "missing", "fallback"), "fallback")

test "toml rejects an unterminated string":
    dq := chr(34)
    # a value string that runs off the end without a closing quote is invalid
    assert(parse("k = " + dq + "unclosed") < 0)
    # a quoted key with no closing quote is invalid
    assert(parse(dq + "unclosed-key") < 0)
    # the well-formed value still parses
    assert(parse("k = " + dq + "ok" + dq) >= 0)

test "toml parses tables and arrays":
    doc := "[server]" + chr(10) + "host = " + chr(34) + "localhost" + chr(34) + chr(10) + "ports = [8000, 9000]"
    root := parse(doc)
    server := get_table(root, "server")
    ports := get_array(server, "ports")

    assert_eq(type_of(server), "table")
    assert_eq(get_string(server, "host"), "localhost")
    assert_eq(array_len(ports), 2)
    assert_eq(type_of(array_get(ports, 0)), "int")
    assert_eq(keys(root).join(","), "server")

test "toml accessors handle missing values":
    root := parse("title = " + chr(34) + "pith" + chr(34))

    assert(has(root, "title"))
    assert(not has(root, "missing"))
    assert_eq(get_table(root, "missing"), 0 - 1)
    assert_eq(get_array(root, "missing"), 0 - 1)
    assert_eq(array_get(get_array(root, "missing"), 0), 0 - 1)

test "the scalar scanner reads a flat document":
    doc := "host = \"a.example\"\nport = 8080\ndebug = true\nretries = -3\n"
    cfg := decode_scalars(doc)!
    assert_eq(cfg.require_string("host")!, "a.example")
    assert_eq(cfg.require_int("port")!, 8080)
    assert(cfg.require_bool("debug")!)
    assert_eq(cfg.require_int("retries")!, -3)
    assert(cfg.has_string("host"))
    assert(not cfg.has_int("host"))

test "the scalar scanner defaults and reports missing fields":
    cfg := decode_scalars("host = \"a\"\n")!
    assert_eq(cfg.string_or("host", "z"), "a")
    assert_eq(cfg.string_or("nope", "z"), "z")
    assert_eq(cfg.int_or("nope", 42), 42)
    assert(cfg.bool_or("nope", true))
    assert(cfg.require_int("host").is_err)
    assert(cfg.require_string("nope").is_err)

test "the scalar scanner skips blanks and comments":
    # whole-line comments, blank lines, and trailing comments all carry no field
    doc := "# lead\n\nhost = \"a\"   # which host\nport = 80 # which port\ndebug = true  # noisy\n\n# tail\n"
    cfg := decode_scalars(doc)!
    assert_eq(cfg.require_string("host")!, "a")
    assert_eq(cfg.require_int("port")!, 80)
    assert(cfg.require_bool("debug")!)

test "the scalar scanner refuses what it cannot represent exactly":
    # a table header means the document is not flat
    assert(not scan_scalars("[server]\nhost = \"a\"\n").ok)
    # an array, an inline table, and a float all need the tree parser
    assert(not scan_scalars("ports = [1, 2]\n").ok)
    assert(not scan_scalars("server = {{ host = \"a\" }}\n").ok)
    assert(not scan_scalars("ratio = 1.5\n").ok)
    # an escape needs the real unescaper, so it is refused rather than mangled
    assert(not scan_scalars("path = \"a\\nb\"\n").ok)
    # so is a value that runs past its line, or a key with no value
    assert(not scan_scalars("host = \"unterminated\n").ok)
    assert(not scan_scalars("host\n").ok)
    # and the loud form says so
    assert(decode_scalars("[server]\n").is_err)

test "the scalar scanner and the tree parser agree on a flat document":
    doc := "host = \"a.example\"\nport = 8080\ndebug = false\n"
    cfg := decode_scalars(doc)!
    root := parse_required(doc)!
    assert_eq(cfg.require_string("host")!, require_string(root, "host")!)
    assert_eq(cfg.require_int("port")!, require_int(root, "port")!)
    assert_eq(cfg.require_bool("debug")!, require_bool(root, "debug")!)
