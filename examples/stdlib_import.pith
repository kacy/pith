# builtins and the standard library: what needs an import and what does not.
#
# compares savings plans. the common numeric helpers (abs, min, max, clamp,
# pow, sqrt, floor, ceil, round) are builtins and need no import. anything
# else comes from a std module, here the constant E from std.math for
# interest compounded continuously, and std.fmt for printing a list.

from std.math import E
import std.fmt as fmt

fn compound(principal: Float, rate: Float, periods_per_year: Int, years: Int) -> Float:
    per_year := periods_per_year.to_float()
    return principal * pow(1.0 + rate / per_year, per_year * years.to_float())

fn continuous(principal: Float, rate: Float, years: Int) -> Float:
    return principal * pow(E(), rate * years.to_float())

fn main():
    principal := 10000.0
    rate := 0.05
    years := 10

    yearly := compound(principal, rate, 1, years)
    monthly := compound(principal, rate, 12, years)
    always := continuous(principal, rate, years)
    print("yearly       {yearly:.2}")
    print("monthly      {monthly:.2}")
    print("continuously {always:.2}")

    # whole currency units: round to nearest, or always down, or always up
    print("rounded {round(monthly)}, floor {floor(monthly)}, ceil {ceil(monthly)}")

    # the gap between the best and worst plan, in whole units
    best := max(round(always).to_int(), round(yearly).to_int())
    worst := min(round(always).to_int(), round(yearly).to_int())
    print("best minus worst: {abs(worst - best)}")

    # a risk score from the plan length, kept on a 1 to 5 scale
    scores := [3, 10, 25].map(fn(plan_years: Int) => clamp(plan_years / 5, 1, 5))
    print("risk scores for 3, 10 and 25 years: {fmt.ints(scores)}")
