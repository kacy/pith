# a struct that implements Drop runs its drop method when the last value
# naming it goes away, wherever that happens: at scope exit, at a rebind, when
# a list or a struct holding it is freed, and when a value returned to a caller
# dies in the caller's frame. an explicit close before that is not doubled,
# because close is idempotent and drop only calls close.
#
# the expected output was generated from the control in the file's history —
# the same program without the Drop impl and with an explicit close() written
# at every point the destructor is meant to fire — so it pins where the hook
# runs, not just that it runs.
mut closed: List[Int] := []

struct Slot:
    pub id: Int

impl Slot:
    fn close():
        if closed.contains(self.id):
            return
        closed.push(self.id)
        print("closed {self.id}")

impl Drop for Slot:
    fn drop():
        self.close()

# a drop body may bind self: the runtime runs the destructor under a guard
# count, so the bind's retain and release balance without re-entering it.
struct Guarded:
    pub id: Int

impl Drop for Guarded:
    fn drop():
        me := self
        print("guarded {me.id} dropped")

struct Holder:
    slot: Slot

fn make(id: Int) -> Slot:
    return Slot(id)

fn scope_exit():
    s := make(1)
    print("using {s.id}")

fn rebind():
    mut s := make(2)
    s = make(3)
    print("holding {s.id}")

fn in_list():
    xs: List[Slot] := [make(4), make(5)]
    print("list of {xs.len()}")

fn explicit_then_drop():
    s := make(6)
    s.close()
    print("closed early {s.id}")

fn in_field():
    h := Holder(make(7))
    print("held {h.slot.id}")

fn returned() -> Slot:
    return make(8)

fn caller():
    r := returned()
    print("got {r.id}")

fn guarded():
    g := Guarded(9)
    print("guarded {g.id} live")

fn main():
    scope_exit()
    rebind()
    in_list()
    explicit_then_drop()
    in_field()
    caller()
    guarded()
    print("closed {closed.len()} slots")
