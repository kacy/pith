# a worker with woken tasks to run must still start a task that has never run.
# two tasks ping-pong over a channel until a task spawned behind them says stop.
# with one worker the pair keeps that worker's pinned queue full, and a fresh task
# waits in the local queue, which is only looked at once pinned is empty. the
# periodic turn in `find_work` is what gets it started.
#
# a regression shows up as this test never finishing: the pair only stops once the
# fresh task has run.

fn pinger(to: Channel[Int], back: Channel[Int], stop: AtomicInt) -> Int:
    # started from here so the pair is already running when the fresh task queues
    helper := spawn set_stop(stop)
    mut rounds := 0
    while stop.load() == 0:
        to.send(rounds)
        back.recv()
        rounds = rounds + 1
    to.close()
    await helper
    return 1

fn ponger(to: Channel[Int], back: Channel[Int]) -> Int:
    while true:
        v := to.recv()
        if v == none:
            break
        back.send(v.unwrap_or(0))
    return 1

fn set_stop(stop: AtomicInt) -> Int:
    stop.store(1)
    return 1

fn main():
    to := Channel[Int](1)
    back := Channel[Int](1)
    stop := AtomicInt(0)
    p2 := spawn ponger(to, back)
    p1 := spawn pinger(to, back, stop)
    print("pair:" + ((await p1) + (await p2)).to_string())
