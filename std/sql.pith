# std.sql — the database abstraction shared across drivers.
#
# pith dispatches statically, so there is no runtime driver registry like Go's
# database/sql. instead each driver (std.sql.sqlite, std.sql.postgres, ...)
# ships concrete `open` / connection / rows types that implement the interfaces
# below, and the shared `Value` / `Row` types unify results across all of them.
# generic code binds on the interfaces to stay driver-agnostic; a result set is
# an iterator, so `for row in rows:` and `to_list(rows)` work everywhere.

import std.bytes as bytes

# a column value crossing the driver boundary, in either direction. this is the
# null-safe boundary — a missing value is `Null`, never a zero in disguise.
pub enum Value:
    Null
    Integer(Int)
    Real(Float)
    Text(String)
    Blob(Bytes)

# constructors for values and rows. call these rather than the enum/struct
# forms directly: they build the type inside std.sql, which keeps callers in
# other modules working regardless of cross-module construction support.
pub fn integer(n: Int) -> Value:
    return Value.Integer(n)

# the Value wrapping a real number.
pub fn real(f: Float) -> Value:
    return Value.Real(f)

# the Value wrapping a text string.
pub fn text(s: String) -> Value:
    return Value.Text(s)

# the Value wrapping a byte blob.
pub fn blob(b: Bytes) -> Value:
    return Value.Blob(b)

# the null Value.
pub fn null_value() -> Value:
    return Value.Null

# a materialized result row: the column values in order, alongside their names.
pub struct Row:
    pub values: List[Value]
    pub names: List[String]

# build a Row from its column values and their names.
pub fn row(values: List[Value], names: List[String]) -> Row:
    return Row(values: values, names: names)

impl Row:
    # the raw value at a column index.
    pub fn get(col: Int) -> Value:
        return self.values[col]

    # typed accessors. they coerce where it is lossless (an Integer read as Real)
    # and fall back to a zero value otherwise, so callers that know their schema
    # stay terse; use `get` + a match when a column may be null or of mixed type.
    pub fn as_int(col: Int) -> Int:
        return match self.values[col]:
            Value.Integer(n) => n
            Value.Real(f) => f.to_int()
            _ => 0

    # the column read as a Float (an Integer coerces).
    pub fn as_real(col: Int) -> Float:
        return match self.values[col]:
            Value.Real(f) => f
            Value.Integer(n) => n.to_float()
            _ => 0.0

    # the column read as text, or "" when it is not text.
    pub fn as_text(col: Int) -> String:
        return match self.values[col]:
            Value.Text(s) => s
            _ => ""

    # the column read as a byte blob, or empty when it is not a blob.
    pub fn as_blob(col: Int) -> Bytes:
        return match self.values[col]:
            Value.Blob(b) => b
            _ => bytes.empty()

    # true when the column is null.
    pub fn is_null(col: Int) -> Bool:
        return match self.values[col]:
            Value.Null => true
            _ => false

    # the index of a column by name, or none when the name is not present.
    pub fn column(name: String) -> Int?:
        for n, i in self.names:
            if n == name:
                return i
        return none

    # --- accessors by column name ---
    #
    # these read a column by name and coerce like the index accessors above: an
    # unknown name or a type mismatch yields the zero value, and the opt_ forms
    # return none for a null or missing column. names come straight off the
    # result's column descriptions, so `row.int("id")` reads how the query is
    # written.

    # the named column as an Int (zero when missing, null, or non-numeric).
    pub fn int(name: String) -> Int:
        col := self.column(name)
        if col == none:
            return 0
        return self.as_int(col.value())

    # the named column as a Float (zero when missing, null, or non-numeric).
    pub fn float(name: String) -> Float:
        col := self.column(name)
        if col == none:
            return 0.0
        return self.as_real(col.value())

    # the named column as text ("" when missing or not text).
    pub fn text(name: String) -> String:
        col := self.column(name)
        if col == none:
            return ""
        return self.as_text(col.value())

    # the named column as a bool. databases hand booleans back as 0/1, so any
    # nonzero integer reads true; a missing or null column reads false.
    pub fn bool(name: String) -> Bool:
        col := self.column(name)
        if col == none:
            return false
        return self.as_int(col.value()) != 0

    # the named column as a byte blob (empty when missing or not a blob).
    pub fn blob(name: String) -> Bytes:
        col := self.column(name)
        if col == none:
            return bytes.empty()
        return self.as_blob(col.value())

    # --- accessors by column index ---
    #
    # the same coercions, addressed positionally. `int_at(0)` mirrors `as_int(0)`;
    # the shorter names line up with the by-name and opt_ families.

    # the column at `col` as an Int.
    pub fn int_at(col: Int) -> Int:
        return self.as_int(col)

    # the column at `col` as a Float.
    pub fn float_at(col: Int) -> Float:
        return self.as_real(col)

    # the column at `col` as text.
    pub fn text_at(col: Int) -> String:
        return self.as_text(col)

    # the column at `col` as a bool (any nonzero integer is true).
    pub fn bool_at(col: Int) -> Bool:
        return self.as_int(col) != 0

    # the column at `col` as a byte blob.
    pub fn blob_at(col: Int) -> Bytes:
        return self.as_blob(col)

    # --- nullable accessors ---
    #
    # for columns that may be null: these return none for a null or missing
    # column and the typed value otherwise, so a nullable column reads as an
    # Int?, Float?, and so on rather than collapsing to a zero.

    # the named column as an Int?, or none when null or missing.
    pub fn opt_int(name: String) -> Int?:
        col := self.column(name)
        if col == none:
            return none
        return self.opt_int_at(col.value())

    # the named column as a Float?, or none when null or missing.
    pub fn opt_float(name: String) -> Float?:
        col := self.column(name)
        if col == none:
            return none
        return self.opt_float_at(col.value())

    # the named column as a String?, or none when null or missing.
    pub fn opt_text(name: String) -> String?:
        col := self.column(name)
        if col == none:
            return none
        return self.opt_text_at(col.value())

    # the named column as a Bool?, or none when null or missing.
    pub fn opt_bool(name: String) -> Bool?:
        col := self.column(name)
        if col == none:
            return none
        return self.opt_bool_at(col.value())

    # the column at `col` as an Int?, or none when null.
    pub fn opt_int_at(col: Int) -> Int?:
        if self.is_null(col):
            return none
        return self.as_int(col)

    # the column at `col` as a Float?, or none when null.
    pub fn opt_float_at(col: Int) -> Float?:
        if self.is_null(col):
            return none
        return self.as_real(col)

    # the column at `col` as a String?, or none when null.
    pub fn opt_text_at(col: Int) -> String?:
        if self.is_null(col):
            return none
        return self.as_text(col)

    # the column at `col` as a Bool?, or none when null.
    pub fn opt_bool_at(col: Int) -> Bool?:
        if self.is_null(col):
            return none
        return self.as_int(col) != 0

# a driver's result set implements std.iter.Iterator with `type Item = Row`, so
# it drops straight into `for row in rows:` and `std.iter.to_list(rows)`. (there
# is no separate Rows interface: pith interfaces don't compose, so a second
# interface would not also be an Iterator — the convention is simpler and
# works.) drivers add `columns()` and `close()` as plain methods on their
# concrete rows type.

# --- typed scanning ---

# map every row through `f`, collecting the results into a typed list. pair it
# with `std.iter.to_list(rows)` to scan a driver's result set into your own type:
#   users := sql.scan(to_list(rows), fn(r: sql.Row) => User(id: r.as_int(0)))
pub fn scan[T](rows: List[Row], f: fn(Row) -> T) -> List[T]:
    mut out: List[T] := []
    for row in rows:
        out.push(f(row))
    return out

# map the first row through `f`, or none when there are no rows.
pub fn scan_one[T](rows: List[Row], f: fn(Row) -> T) -> T?:
    if rows.len() == 0:
        return none
    return f(rows[0])

test "scan maps rows into typed values":
    rows := [row([integer(1), text("ada")], ["id", "name"]), row([integer(2), text("grace")], ["id", "name"])]
    ids := scan(rows, fn(r: Row) => r.as_int(0))
    names := scan(rows, fn(r: Row) => r.as_text(1))

    assert_eq(ids.len(), 2)
    assert_eq(ids[0], 1)
    assert_eq(ids[1], 2)
    assert_eq(names[0], "ada")
    assert_eq(names[1], "grace")

test "scan_one maps the first row or none":
    rows := [row([integer(7)], ["n"])]
    top := scan_one(rows, fn(r: Row) => r.as_int(0))
    empty := scan_one([], fn(r: Row) => r.as_int(0))

    assert(top != none)
    assert_eq(top.value(), 7)
    assert(empty == none)

test "typed accessors read a column by name":
    r := row([integer(42), text("ada"), real(9.5), integer(1)], ["id", "name", "score", "active"])
    assert_eq(r.int("id"), 42)
    assert_eq(r.text("name"), "ada")
    assert_eq(r.float("score"), 9.5)
    assert_eq(r.bool("active"), true)

test "typed accessors read a column by index":
    r := row([integer(42), text("ada"), integer(0)], ["id", "name", "active"])
    assert_eq(r.int_at(0), 42)
    assert_eq(r.text_at(1), "ada")
    assert_eq(r.bool_at(2), false)

test "a missing column reads as a zero value":
    r := row([integer(1)], ["id"])
    assert_eq(r.int("nope"), 0)
    assert_eq(r.text("nope"), "")
    assert_eq(r.float("nope"), 0.0)
    assert_eq(r.bool("nope"), false)

test "opt_ accessors return none for null or missing":
    r := row([integer(5), null_value()], ["id", "score"])
    present := r.opt_int("id")
    assert(present != none)
    assert_eq(present.value(), 5)
    assert(r.opt_float("score") == none)
    assert(r.opt_text("missing") == none)
    assert(r.opt_int_at(1) == none)
