# result-returning decode helper calls, routed through the register-ABI
# registry: a registered pair-returning helper is rcall'd and its pair
# folded back into the result box every decode consumer here expects;
# anything else keeps the plain call. the decode emitters reach helpers
# by resolved name outside the normal call paths, which is what kept the
# json family off the register ABI until these wrappers.
fn ir_emit_decode_result_call1(result_reg: Int, fname: String, arg0: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 1, " " + arg0.to_string())
        return
    ir_emit_call1(result_reg, fname, "tuple", arg0)

fn ir_emit_decode_result_call2(result_reg: Int, fname: String, arg0: Int, arg1: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 2, " " + arg0.to_string() + " " + arg1.to_string())
        return
    ir_emit_call2(result_reg, fname, "tuple", arg0, arg1)

fn ir_emit_decode_result_call3(result_reg: Int, fname: String, arg0: Int, arg1: Int, arg2: Int):
    if ir_result_reg_funcs.contains_key(fname):
        ir_emit_registered_rcall_boxed_into(result_reg, fname, 3, " " + arg0.to_string() + " " + arg1.to_string() + " " + arg2.to_string())
        return
    ir_emit_call3(result_reg, fname, "tuple", arg0, arg1, arg2)

# the concrete struct tid a decode call targets, or -1 when there is none.
#
# at a plain call site (json.decode_text[User](...)) the checker already
# knows the result is User!, so we take the struct straight from the
# expression type. inside a generic wrapper body — parse[T] specialized as
# parse__User — the checker only ever saw the abstract T, so the expression
# type is the type parameter, not the concrete struct. in that case we
# recover the struct from the call's explicit type argument ([T]) by
# substituting it through the active generic bindings (T -> User).
pub fn ir_decode_target_tid(idx: Int, node: Node) -> Int:
    ret_tid := c_get_expr_type(idx)
    if ret_tid >= 0:
        ret_info := get_type_info(ret_tid)
        if ret_info.kind == "result" and get_type_info(ret_info.inner).kind == "struct":
            return ret_info.inner
    # fall back to the explicit type argument under the active substitution.
    if node.children.len() == 0:
        return 0 - 1
    index_node := get_node(node.children[0])
    if index_node.kind != "index" or index_node.children.len() < 2:
        return 0 - 1
    type_arg := get_node(index_node.children[1])
    concrete_name := ir_specialize_type_name_with_state(type_arg.value, ir_active_generic_params, ir_active_generic_concrete_types, ir_type_aliases, ir_struct_names)
    concrete_tid := lookup_type_id(concrete_name)
    if concrete_tid < 0:
        return 0 - 1
    if get_type_info(concrete_tid).kind != "struct":
        return 0 - 1
    return concrete_tid

## per-argument expression emission through the threaded hook.
fn ir_decode_collect_arg_regs(node: Node, start_idx: Int, emit_expr: fn(Int) -> Int) -> List[Int]:
    mut arg_regs: List[Int] := []
    for child, i in node.children:
        if i < start_idx:
            continue
        if node_kind(child) == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                arg_regs.push(emit_expr(cn.children[0]))
        else:
            arg_regs.push(emit_expr(child))
    return arg_regs

# the expression node of the decode's first argument, walked the same way
# ir_decode_collect_arg_regs walks so the two can never disagree.
fn ir_decode_arg_expr_idx(node: Node, start_idx: Int) -> Int:
    for child, i in node.children:
        if i < start_idx:
            continue
        if node_kind(child) == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                return cn.children[0]
            continue
        return child
    return 0 - 1

# the two temp vars that hold a json node-pool mark across a lowered decode
# body, so it can be reloaded and handed to pool_restore at every exit.
struct IrJsonPoolMark:
    node_id_var: String
    array_len_var: String

# emit `node_mark := json.pool_mark_node_id()` and the array-length mark,
# storing both in fresh int temps. the returned handle carries their names so
# the matching restore can reload them after the decode's single exit label.
# mark_node_id_name / mark_array_len_name are the already-resolved std symbols
# (they differ between a plain call site and a generic specialization body).
# a result tuple that has passed its error branch is finished the moment
# its ok payload is read out: the error path stored the tuple for the
# catch to consume (or returned it), and the success path abandons the
# shell. result shells carry no destructor, so releasing one frees exactly
# the three-slot allocation while the extracted payload keeps the count
# the callee transferred — the same shape the catch lowering emits. every
# require step of a typed decode leaked its shell before these.
fn ir_take_json_ok(result_r: Int, field_tid: Int) -> Int:
    ok_r := ir_emit_json_field_ok(result_r, field_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_take_result_ok(result_r: Int, tid: Int) -> Int:
    ok_r := ir_emit_result_value_field(result_r, tid, "ok")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_take_result_ok_typed(result_r: Int, type_name: String) -> Int:
    ok_r := ir_emit_result_ok_field_typed(result_r, type_name)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    return ok_r

fn ir_emit_json_pool_mark(mark_node_id_name: String, mark_array_len_name: String) -> IrJsonPoolMark:
    node_r := ir_reg()
    ir_emit_call0(node_r, mark_node_id_name, "int")
    node_var := ir_new_temp_name("json_pool_node_mark")
    ir_var_types.insert(node_var, "int")
    ir_emit("store " + node_var + " " + node_r.to_string())
    array_r := ir_reg()
    ir_emit_call0(array_r, mark_array_len_name, "int")
    array_var := ir_new_temp_name("json_pool_array_mark")
    ir_var_types.insert(array_var, "int")
    ir_emit("store " + array_var + " " + array_r.to_string())
    return IrJsonPoolMark(node_var, array_var)

# emit `json.pool_restore(node_mark, array_mark)`, reclaiming every pool node
# the decode allocated. call this after the result struct is materialized and
# just before the body returns it.
fn ir_emit_json_pool_restore(mark: IrJsonPoolMark, restore_name: String):
    node_r := ir_reg()
    ir_emit("load " + node_r.to_string() + " " + mark.node_id_var)
    array_r := ir_reg()
    ir_emit("load " + array_r.to_string() + " " + mark.array_len_var)
    ir_emit_call2(ir_reg(), restore_name, "void", node_r, array_r)

# a handle-pool node pool splits mapping children and sequence children into
# separate flat lists, so its mark carries three positions instead of json's two.
struct IrHandlePoolMark:
    node_id_var: String
    table_len_var: String
    array_len_var: String

# emit the three handle-pool marks into fresh int temps. the names are the
# already-resolved std symbols (they differ between a call site and a spec body).
fn ir_emit_handle_pool_mark(mark_node_id_name: String, mark_table_len_name: String, mark_array_len_name: String) -> IrHandlePoolMark:
    node_r := ir_reg()
    ir_emit_call0(node_r, mark_node_id_name, "int")
    node_var := ir_new_temp_name("handle_pool_node_mark")
    ir_var_types.insert(node_var, "int")
    ir_emit("store " + node_var + " " + node_r.to_string())
    table_r := ir_reg()
    ir_emit_call0(table_r, mark_table_len_name, "int")
    table_var := ir_new_temp_name("handle_pool_table_mark")
    ir_var_types.insert(table_var, "int")
    ir_emit("store " + table_var + " " + table_r.to_string())
    array_r := ir_reg()
    ir_emit_call0(array_r, mark_array_len_name, "int")
    array_var := ir_new_temp_name("handle_pool_array_mark")
    ir_var_types.insert(array_var, "int")
    ir_emit("store " + array_var + " " + array_r.to_string())
    return IrHandlePoolMark(node_var, table_var, array_var)

# emit `pool_restore(node_mark, table_mark, array_mark)` on the owning module.
fn ir_emit_handle_pool_restore(mark: IrHandlePoolMark, restore_name: String):
    node_r := ir_reg()
    ir_emit("load " + node_r.to_string() + " " + mark.node_id_var)
    table_r := ir_reg()
    ir_emit("load " + table_r.to_string() + " " + mark.table_len_var)
    array_r := ir_reg()
    ir_emit("load " + array_r.to_string() + " " + mark.array_len_var)
    ir_emit_call3(ir_reg(), restore_name, "void", node_r, table_r, array_r)

## emit the json generic name sequence.
pub fn ir_json_generic_name(base_name: String) -> String:
    return ir_json_generic_name_with_state(base_name, ir_generic_decl_indices)

## emit the config generic name sequence.
pub fn ir_config_generic_name(base_name: String) -> String:
    return ir_config_generic_name_with_state(base_name, ir_generic_decl_indices)

## emit the handle-pool generic name sequence.
pub fn ir_handle_generic_name(base_name: String, module_path: String) -> String:
    return ir_handle_generic_name_with_state(base_name, module_path, ir_generic_decl_indices)

## decode a nested struct field through its helper.
pub fn ir_emit_nested_decode_path(parent_handle_r: Int, key_r: Int, target_tid: Int, require_name: String, decode_name: String, temp_prefix: String) -> Int:
    child_result_r := ir_reg()
    ir_emit_decode_result_call2(child_result_r, require_name, parent_handle_r, key_r)
    done_l := ir_label()
    temp_name := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(temp_name, "tuple")
    ir_emit_result_store_error_branch(child_result_r, temp_name, done_l)
    child_handle_r := ir_take_result_ok(child_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(decode_name, [ir_type_from_tid(target_tid)], "tuple"), child_handle_r)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

## the std.json helpers a list-of-structs field on the node-pool path
## calls, resolved for the call site: the direct decode resolves them
## against its receiver, a specialization body against its module path.
struct IrJsonListHelpers:
    require_array: String
    array_len: String
    require_element: String
    element_error: String
    decode_object: String

fn ir_json_list_helpers_for_call(index_idx: Int) -> IrJsonListHelpers:
    decode_name := ir_generic_preferred_name(ir_resolve_json_call_name(index_idx, "decode_object"), "decode_object")
    return IrJsonListHelpers(ir_resolve_json_call_name(index_idx, "object_require_array"), ir_resolve_json_call_name(index_idx, "array_len"), ir_resolve_json_call_name(index_idx, "require_object_element"), ir_resolve_json_call_name(index_idx, "element_decode_error"), decode_name)

fn ir_json_list_helpers_for_module(module_path: String) -> IrJsonListHelpers:
    return IrJsonListHelpers(ir_resolve_generic_module_call_name(module_path, "object_require_array"), ir_resolve_generic_module_call_name(module_path, "array_len"), ir_resolve_generic_module_call_name(module_path, "require_object_element"), ir_resolve_generic_module_call_name(module_path, "element_decode_error"), ir_json_generic_name("decode_object"))

## a list-of-structs field read out of a parsed object node, as a loop
## over the array under the key: each element is checked to be an object
## and decoded through the element type's decode_object specialization,
## and the struct it yields is pushed into a struct-owning list. the
## result box comes back in the returned register, as the scalar
## accessors' does. an element that fails releases the list, and with it
## every element built before, and comes back as an error naming the
## position (`rows[1]: missing string field: name`, the message the
## filler gives the same document). the loop is emitted here rather than
## written as a std.json generic because a generic body specialized from
## a decode site is emitted without the checker's re-check, and read its
## `T`-typed result at the wrong offset.
fn ir_emit_json_struct_list_field(handle_r: Int, key_r: Int, elem_tid: Int, helpers: IrJsonListHelpers) -> Int:
    temp_name := ir_new_temp_name("json_struct_list")
    ir_var_types.insert(temp_name, "tuple")
    list_name := ir_new_temp_name("json_struct_list_out")
    len_name := ir_new_temp_name("json_struct_list_len")
    idx_name := ir_new_temp_name("json_struct_list_idx")
    arr_name := ir_new_temp_name("json_struct_list_arr")
    ir_var_types.insert(list_name, "list")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(arr_name, "int")
    done_l := ir_label()

    arr_result_r := ir_reg()
    ir_emit_decode_result_call2(arr_result_r, helpers.require_array, handle_r, key_r)
    ir_emit_result_store_error_branch(arr_result_r, temp_name, done_l)
    ir_emit("store " + arr_name + " " + ir_take_result_ok(arr_result_r, lookup_type_id("Int")).to_string())
    list_r := ir_reg()
    ir_emit_call0(list_r, "__list_new_struct", "list")
    ir_emit("store " + list_name + " " + list_r.to_string())
    arr_r := ir_reg()
    ir_emit("load " + arr_r.to_string() + " " + arr_name)
    len_r := ir_reg()
    ir_emit_call1(len_r, helpers.array_len, "int", arr_r)
    ir_emit("store " + len_name + " " + len_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ir_emit_label(loop_l)
    loop_idx_r := ir_reg()
    ir_emit("load " + loop_idx_r.to_string() + " " + idx_name)
    loop_len_r := ir_reg()
    ir_emit("load " + loop_len_r.to_string() + " " + len_name)
    cond_r := ir_reg()
    ir_emit("lt " + cond_r.to_string() + " " + loop_idx_r.to_string() + " " + loop_len_r.to_string())
    ir_emit("brif " + cond_r.to_string() + " " + body_l + " " + loop_done_l)

    ir_emit_label(body_l)
    body_arr_r := ir_reg()
    ir_emit("load " + body_arr_r.to_string() + " " + arr_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    elem_result_r := ir_reg()
    ir_emit_decode_result_call3(elem_result_r, helpers.require_element, body_arr_r, key_r, body_idx_r)
    # a non-object element: its error is already worded by position, so
    # it becomes this field's result once the list is dropped
    elem_ok_r := ir_emit_result_flag_field(elem_result_r, "is_ok")
    elem_ok_l := ir_label()
    ir_emit("brif " + elem_ok_r.to_string() + " " + elem_ok_l + " " + fail_l)
    ir_emit_label(elem_ok_l)
    elem_r := ir_take_result_ok(elem_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(helpers.decode_object, [ir_type_from_tid(elem_tid)], "tuple"), elem_r)
    decode_ok_r := ir_emit_result_flag_field(decode_result_r, "is_ok")
    decode_ok_l := ir_label()
    decode_err_l := ir_label()
    ir_emit("brif " + decode_ok_r.to_string() + " " + decode_ok_l + " " + decode_err_l)
    # a failed element: wrap its error under the position, drop the
    # element's box and error, and hand the wrapped box to fail_l
    ir_emit_label(decode_err_l)
    inner_err_r := ir_reg()
    ir_emit("field " + inner_err_r.to_string() + " " + decode_result_r.to_string() + " 16 struct:JsonDecodeError err")
    wrapped_r := ir_reg()
    ir_emit_call3(wrapped_r, helpers.element_error, "struct:JsonDecodeError", key_r, body_idx_r, inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", decode_result_r)
    wrapped_box_r := ir_emit_err_result_tuple_raw(wrapped_r)
    ir_emit("store " + temp_name + " " + wrapped_box_r.to_string())
    drop_list_r := ir_reg()
    ir_emit("load " + drop_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", drop_list_r)
    ir_emit("jmp " + done_l)
    # a decoded element: the list takes the count the decode minted
    ir_emit_label(decode_ok_l)
    value_r := ir_take_json_ok(decode_result_r, elem_tid)
    push_list_r := ir_reg()
    ir_emit("load " + push_list_r.to_string() + " " + list_name)
    ir_emit_call2(ir_reg(), "pith_list_push_value_owned", "void", push_list_r, value_r)
    step_idx_r := ir_reg()
    ir_emit("load " + step_idx_r.to_string() + " " + idx_name)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    next_idx_r := ir_reg()
    ir_emit("add " + next_idx_r.to_string() + " " + step_idx_r.to_string() + " " + one_r.to_string())
    ir_emit("store " + idx_name + " " + next_idx_r.to_string())
    ir_emit("jmp " + loop_l)

    # the element check failed: its box is the field's result
    ir_emit_label(fail_l)
    ir_emit("store " + temp_name + " " + elem_result_r.to_string())
    fail_list_r := ir_reg()
    ir_emit("load " + fail_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", fail_list_r)
    ir_emit("jmp " + done_l)

    ir_emit_label(loop_done_l)
    out_list_r := ir_reg()
    ir_emit("load " + out_list_r.to_string() + " " + list_name)
    ir_emit("store " + temp_name + " " + ir_emit_ok_result_tuple_raw(out_list_r).to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

## the std.json helpers the general node builder calls, resolved for the
## call site the way IrJsonListHelpers are: the direct decode against its
## receiver, a specialization body against its module path.
struct IrJsonNodeHelpers:
    require_array: String
    require_map: String
    array_len: String
    array_get: String
    object_get: String
    member_count: String
    member_key: String
    node_int: String
    node_string: String
    node_bool: String
    node_float: String
    node_object: String
    node_array: String
    node_map: String
    element_path: String
    member_path: String
    path_error: String
    decode_object: String

fn ir_json_node_helpers_for_call(index_idx: Int) -> IrJsonNodeHelpers:
    decode_name := ir_generic_preferred_name(ir_resolve_json_call_name(index_idx, "decode_object"), "decode_object")
    return IrJsonNodeHelpers(ir_resolve_json_call_name(index_idx, "object_require_array"), ir_resolve_json_call_name(index_idx, "object_require_map"), ir_resolve_json_call_name(index_idx, "array_len"), ir_resolve_json_call_name(index_idx, "array_get"), ir_resolve_json_call_name(index_idx, "object_get"), ir_resolve_json_call_name(index_idx, "object_member_count"), ir_resolve_json_call_name(index_idx, "object_member_key"), ir_resolve_json_call_name(index_idx, "node_require_int"), ir_resolve_json_call_name(index_idx, "node_require_string"), ir_resolve_json_call_name(index_idx, "node_require_bool"), ir_resolve_json_call_name(index_idx, "node_require_float"), ir_resolve_json_call_name(index_idx, "node_require_object"), ir_resolve_json_call_name(index_idx, "node_require_array"), ir_resolve_json_call_name(index_idx, "node_require_map"), ir_resolve_json_call_name(index_idx, "element_path"), ir_resolve_json_call_name(index_idx, "member_path"), ir_resolve_json_call_name(index_idx, "path_decode_error"), decode_name)

fn ir_json_node_helpers_for_module(module_path: String) -> IrJsonNodeHelpers:
    return IrJsonNodeHelpers(ir_resolve_generic_module_call_name(module_path, "object_require_array"), ir_resolve_generic_module_call_name(module_path, "object_require_map"), ir_resolve_generic_module_call_name(module_path, "array_len"), ir_resolve_generic_module_call_name(module_path, "array_get"), ir_resolve_generic_module_call_name(module_path, "object_get"), ir_resolve_generic_module_call_name(module_path, "object_member_count"), ir_resolve_generic_module_call_name(module_path, "object_member_key"), ir_resolve_generic_module_call_name(module_path, "node_require_int"), ir_resolve_generic_module_call_name(module_path, "node_require_string"), ir_resolve_generic_module_call_name(module_path, "node_require_bool"), ir_resolve_generic_module_call_name(module_path, "node_require_float"), ir_resolve_generic_module_call_name(module_path, "node_require_object"), ir_resolve_generic_module_call_name(module_path, "node_require_array"), ir_resolve_generic_module_call_name(module_path, "node_require_map"), ir_resolve_generic_module_call_name(module_path, "element_path"), ir_resolve_generic_module_call_name(module_path, "member_path"), ir_resolve_generic_module_call_name(module_path, "path_decode_error"), ir_json_generic_name("decode_object"))

# how a container holds a value of type `tid`: "string", "list", "map" or
# "struct" for the kinds held by count, where a store takes the count the
# decode minted; "" for an int, a bool or a float, copied as a word. asked
# of the checker's type, not of the ir kind string, because
# ir_type_from_tid names a struct by its bare name.
fn ir_json_value_ownership(tid: Int) -> String:
    info := get_type_info(tid)
    if info.kind == "primitive" and info.name == "String":
        return "string"
    if info.kind == "list" or info.kind == "map" or info.kind == "struct":
        return info.kind
    return ""

# the element-tag code a kind-carrying map store takes for values held
# the `ownership` way: the codes pith_list_new takes, part of the ir
# contract.
fn ir_json_value_tag_code(ownership: String) -> Int:
    if ownership == "string":
        return 1
    if ownership == "list":
        return 2
    if ownership == "map":
        return 3
    return 4

# the list constructor for elements held the `ownership` way, the one a
# literal of that element type gets, so the list owns strings, lists,
# maps and structs.
fn ir_json_list_ctor_for_ownership(ownership: String) -> String:
    if ownership == "string":
        return "__list_new_str"
    if ownership == "list":
        return "__list_new_list"
    if ownership == "map":
        return "__list_new_map"
    if ownership == "struct":
        return "__list_new_struct"
    return "__list_new"

fn ir_json_node_scalar_helper(helpers: IrJsonNodeHelpers, info: TypeInfo) -> String:
    if info.name == "String":
        return helpers.node_string
    if info.name == "Bool":
        return helpers.node_bool
    if info.name == "Float":
        return helpers.node_float
    return helpers.node_int

## the general node builder: a `tid`-typed value read out of the parsed
## node `node_r`, which sits at `path_r` in the document (`grid[1]`,
## `scores.bob`), as a result box in the returned register. a scalar
## goes through its node accessor, which checks the kind and words its
## error by the path (`expected int element: grid[1][3]`); a struct
## through the element type's decode_object specialization, its own
## error placed under the path (`scores.bob: missing int field: x`); a
## list and a map through the loops below, which build the container
## first and store each value as it is built, so a failed value drops the
## container and everything in it before the error comes back. this is
## the node-pool path's reading of the shapes the filler builds in place
## for a target without optional or defaulted fields: a `Map[String, T]`
## and a list of lists or of maps, at any depth. the messages are the
## filler's for the same document. a list of scalars and a list of
## structs keep the accessors and the loop they had before this builder.
fn ir_emit_json_node_value(node_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    info := get_type_info(tid)
    if info.kind == "primitive":
        result_r := ir_reg()
        ir_emit_decode_result_call2(result_r, ir_json_node_scalar_helper(helpers, info), node_r, path_r)
        return result_r
    if info.kind == "struct":
        return ir_emit_json_node_struct(node_r, path_r, tid, helpers)
    temp_name := ir_new_temp_name("json_node_value")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    container_result_r := ir_reg()
    if info.kind == "list":
        ir_emit_decode_result_call2(container_result_r, helpers.node_array, node_r, path_r)
    else:
        ir_emit_decode_result_call2(container_result_r, helpers.node_map, node_r, path_r)
    ir_emit_result_store_error_branch(container_result_r, temp_name, done_l)
    container_r := ir_take_result_ok(container_result_r, lookup_type_id("Int"))
    mut built_r := 0
    if info.kind == "list":
        built_r = ir_emit_json_node_list_from_array(container_r, path_r, tid, helpers)
    else:
        built_r = ir_emit_json_node_map_from_object(container_r, path_r, tid, helpers)
    ir_emit("store " + temp_name + " " + built_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_json_node_struct(node_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    temp_name := ir_new_temp_name("json_node_struct")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    obj_result_r := ir_reg()
    ir_emit_decode_result_call2(obj_result_r, helpers.node_object, node_r, path_r)
    ir_emit_result_store_error_branch(obj_result_r, temp_name, done_l)
    obj_r := ir_take_result_ok(obj_result_r, lookup_type_id("Int"))
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, ir_queue_generic_specialization(helpers.decode_object, [ir_type_from_tid(tid)], "tuple"), obj_r)
    ok_r := ir_emit_result_flag_field(decode_result_r, "is_ok")
    ok_l := ir_label()
    err_l := ir_label()
    ir_emit("brif " + ok_r.to_string() + " " + ok_l + " " + err_l)
    # a failed struct: its error under the path, the box and the error
    # it came in dropped
    ir_emit_label(err_l)
    inner_err_r := ir_reg()
    ir_emit("field " + inner_err_r.to_string() + " " + decode_result_r.to_string() + " 16 struct:JsonDecodeError err")
    wrapped_r := ir_reg()
    ir_emit_call2(wrapped_r, helpers.path_error, "struct:JsonDecodeError", path_r, inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", inner_err_r)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", decode_result_r)
    ir_emit("store " + temp_name + " " + ir_emit_err_result_tuple_raw(wrapped_r).to_string())
    ir_emit("jmp " + done_l)
    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## a `List[T]` built out of the array node `arr_r` at `path_r`: one
## element per node, each through ir_emit_json_node_value under
## `<path>[<i>]`, pushed as it is built. the result box in the returned
## register holds the list, or the first element's error once the list
## and every element before it are released.
fn ir_emit_json_node_list_from_array(arr_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    elem_tid := get_type_info(tid).inner
    elem_ownership := ir_json_value_ownership(elem_tid)
    temp_name := ir_new_temp_name("json_node_list")
    ir_var_types.insert(temp_name, "tuple")
    list_name := ir_new_temp_name("json_node_list_out")
    len_name := ir_new_temp_name("json_node_list_len")
    idx_name := ir_new_temp_name("json_node_list_idx")
    arr_name := ir_new_temp_name("json_node_list_arr")
    ir_var_types.insert(list_name, ir_type_from_tid(tid))
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(arr_name, "int")
    done_l := ir_label()
    ir_emit("store " + arr_name + " " + arr_r.to_string())
    list_r := ir_reg()
    ir_emit_call0(list_r, ir_json_list_ctor_for_ownership(elem_ownership), ir_type_from_tid(tid))
    ir_emit("store " + list_name + " " + list_r.to_string())
    len_arr_r := ir_reg()
    ir_emit("load " + len_arr_r.to_string() + " " + arr_name)
    len_r := ir_reg()
    ir_emit_call1(len_r, helpers.array_len, "int", len_arr_r)
    ir_emit("store " + len_name + " " + len_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ok_l := ir_label()
    ir_emit_label(loop_l)
    loop_idx_r := ir_reg()
    ir_emit("load " + loop_idx_r.to_string() + " " + idx_name)
    loop_len_r := ir_reg()
    ir_emit("load " + loop_len_r.to_string() + " " + len_name)
    cond_r := ir_reg()
    ir_emit("lt " + cond_r.to_string() + " " + loop_idx_r.to_string() + " " + loop_len_r.to_string())
    ir_emit("brif " + cond_r.to_string() + " " + body_l + " " + loop_done_l)

    ir_emit_label(body_l)
    body_arr_r := ir_reg()
    ir_emit("load " + body_arr_r.to_string() + " " + arr_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    elem_node_r := ir_reg()
    ir_emit_call2(elem_node_r, helpers.array_get, "int", body_arr_r, body_idx_r)
    elem_path_r := ir_reg()
    ir_emit_call2(elem_path_r, helpers.element_path, "string", path_r, body_idx_r)
    elem_result_r := ir_emit_json_node_value(elem_node_r, elem_path_r, elem_tid, helpers)
    ir_string_release_reg(elem_path_r)
    elem_ok_r := ir_emit_result_flag_field(elem_result_r, "is_ok")
    ir_emit("brif " + elem_ok_r.to_string() + " " + ok_l + " " + fail_l)
    # a failed element: its box is the list's result, the list goes
    ir_emit_label(fail_l)
    ir_emit("store " + temp_name + " " + elem_result_r.to_string())
    fail_list_r := ir_reg()
    ir_emit("load " + fail_list_r.to_string() + " " + list_name)
    ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", fail_list_r)
    ir_emit("jmp " + done_l)
    # a built element: the list takes the count the build minted
    ir_emit_label(ok_l)
    value_r := ir_take_json_ok(elem_result_r, elem_tid)
    push_list_r := ir_reg()
    ir_emit("load " + push_list_r.to_string() + " " + list_name)
    if elem_ownership.len() > 0:
        ir_emit_call2(ir_reg(), "pith_list_push_value_owned", "void", push_list_r, value_r)
    else:
        ir_emit_call2(ir_reg(), "pith_list_push_value", "void", push_list_r, value_r)
    step_idx_r := ir_reg()
    ir_emit("load " + step_idx_r.to_string() + " " + idx_name)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    next_idx_r := ir_reg()
    ir_emit("add " + next_idx_r.to_string() + " " + step_idx_r.to_string() + " " + one_r.to_string())
    ir_emit("store " + idx_name + " " + next_idx_r.to_string())
    ir_emit("jmp " + loop_l)

    ir_emit_label(loop_done_l)
    out_list_r := ir_reg()
    ir_emit("load " + out_list_r.to_string() + " " + list_name)
    ir_emit("store " + temp_name + " " + ir_emit_ok_result_tuple_raw(out_list_r).to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

## a `Map[String, T]` built out of the object node `obj_r` at `path_r`:
## one member per key slot of the node, its value read through
## `object_get` (the last value under a repeated key, as the node
## accessors read it) and built through ir_emit_json_node_value under
## `<path>.<key>`, then stored under the key; a repeated key stores the
## same last value twice, which the map resolves to one entry. a heap
## value goes in through the kind-carrying owned store, so the map owns
## it; the result box holds the map, or the first member's error once
## the map and every value before it are released.
fn ir_emit_json_node_map_from_object(obj_r: Int, path_r: Int, tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    val_tid := get_type_info(tid).value_type
    val_ownership := ir_json_value_ownership(val_tid)
    temp_name := ir_new_temp_name("json_node_map")
    ir_var_types.insert(temp_name, "tuple")
    map_name := ir_new_temp_name("json_node_map_out")
    count_name := ir_new_temp_name("json_node_map_count")
    idx_name := ir_new_temp_name("json_node_map_idx")
    obj_name := ir_new_temp_name("json_node_map_obj")
    ir_var_types.insert(map_name, "map")
    ir_var_types.insert(count_name, "int")
    ir_var_types.insert(idx_name, "int")
    ir_var_types.insert(obj_name, "int")
    done_l := ir_label()
    ir_emit("store " + obj_name + " " + obj_r.to_string())
    map_r := ir_reg()
    ir_emit_call0(map_r, "__map_new", "map")
    ir_emit("store " + map_name + " " + map_r.to_string())
    count_obj_r := ir_reg()
    ir_emit("load " + count_obj_r.to_string() + " " + obj_name)
    count_r := ir_reg()
    ir_emit_call1(count_r, helpers.member_count, "int", count_obj_r)
    ir_emit("store " + count_name + " " + count_r.to_string())
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + idx_name + " " + zero_r.to_string())

    loop_l := ir_label()
    body_l := ir_label()
    loop_done_l := ir_label()
    fail_l := ir_label()
    ok_l := ir_label()
    ir_emit_label(loop_l)
    loop_idx_r := ir_reg()
    ir_emit("load " + loop_idx_r.to_string() + " " + idx_name)
    loop_count_r := ir_reg()
    ir_emit("load " + loop_count_r.to_string() + " " + count_name)
    cond_r := ir_reg()
    ir_emit("lt " + cond_r.to_string() + " " + loop_idx_r.to_string() + " " + loop_count_r.to_string())
    ir_emit("brif " + cond_r.to_string() + " " + body_l + " " + loop_done_l)

    ir_emit_label(body_l)
    body_obj_r := ir_reg()
    ir_emit("load " + body_obj_r.to_string() + " " + obj_name)
    body_idx_r := ir_reg()
    ir_emit("load " + body_idx_r.to_string() + " " + idx_name)
    key_r := ir_reg()
    ir_emit_call2(key_r, helpers.member_key, "string", body_obj_r, body_idx_r)
    val_node_r := ir_reg()
    ir_emit_call2(val_node_r, helpers.object_get, "int", body_obj_r, key_r)
    member_path_r := ir_reg()
    ir_emit_call2(member_path_r, helpers.member_path, "string", path_r, key_r)
    val_result_r := ir_emit_json_node_value(val_node_r, member_path_r, val_tid, helpers)
    ir_string_release_reg(member_path_r)
    val_ok_r := ir_emit_result_flag_field(val_result_r, "is_ok")
    ir_emit("brif " + val_ok_r.to_string() + " " + ok_l + " " + fail_l)
    # a failed value: its box is the map's result, the map and the key go
    ir_emit_label(fail_l)
    ir_string_release_reg(key_r)
    ir_emit("store " + temp_name + " " + val_result_r.to_string())
    fail_map_r := ir_reg()
    ir_emit("load " + fail_map_r.to_string() + " " + map_name)
    ir_emit_call1(ir_reg(), "pith_map_release_handle", "void", fail_map_r)
    ir_emit("jmp " + done_l)
    # a built value: stored under the key, which the map copies, so the
    # key string dies here; a counted value hands the map its count
    ir_emit_label(ok_l)
    value_r := ir_take_json_ok(val_result_r, val_tid)
    store_map_r := ir_reg()
    ir_emit("load " + store_map_r.to_string() + " " + map_name)
    if val_ownership.len() > 0:
        tag_r := ir_reg()
        ir_emit("iconst " + tag_r.to_string() + " " + ir_json_value_tag_code(val_ownership).to_string())
        ir_emit_call4(ir_reg(), "map_insert_owned_kind", "void", store_map_r, key_r, value_r, tag_r)
    else:
        ir_emit_call3(ir_reg(), "map_insert", "void", store_map_r, key_r, value_r)
    ir_string_release_reg(key_r)
    step_idx_r := ir_reg()
    ir_emit("load " + step_idx_r.to_string() + " " + idx_name)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    next_idx_r := ir_reg()
    ir_emit("add " + next_idx_r.to_string() + " " + step_idx_r.to_string() + " " + one_r.to_string())
    ir_emit("store " + idx_name + " " + next_idx_r.to_string())
    ir_emit("jmp " + loop_l)

    ir_emit_label(loop_done_l)
    out_map_r := ir_reg()
    ir_emit("load " + out_map_r.to_string() + " " + map_name)
    ir_emit("store " + temp_name + " " + ir_emit_ok_result_tuple_raw(out_map_r).to_string())
    ir_emit_label(done_l)
    result_r := ir_reg()
    ir_emit("load " + result_r.to_string() + " " + temp_name)
    return result_r

## a collection field the general builder reads out of a parsed object
## node: the array or object under `key_r` (missing or of the wrong kind
## is the field's error, `missing map field: scores`, `expected list
## field: grid`), then the list or map built from it with the key as the
## path. the result box comes back in the returned register.
fn ir_emit_json_node_collection_field(handle_r: Int, key_r: Int, field_tid: Int, helpers: IrJsonNodeHelpers) -> Int:
    temp_name := ir_new_temp_name("json_node_field")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    container_result_r := ir_reg()
    is_map := ir_json_map_value_tid(field_tid) >= 0
    if is_map:
        ir_emit_decode_result_call2(container_result_r, helpers.require_map, handle_r, key_r)
    else:
        ir_emit_decode_result_call2(container_result_r, helpers.require_array, handle_r, key_r)
    ir_emit_result_store_error_branch(container_result_r, temp_name, done_l)
    container_r := ir_take_result_ok(container_result_r, lookup_type_id("Int"))
    mut built_r := 0
    if is_map:
        built_r = ir_emit_json_node_map_from_object(container_r, key_r, field_tid, helpers)
    else:
        built_r = ir_emit_json_node_list_from_array(container_r, key_r, field_tid, helpers)
    ir_emit("store " + temp_name + " " + built_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json nested decode path sequence.
pub fn ir_emit_json_nested_decode_path(parent_handle_r: Int, key_r: Int, target_tid: Int, index_idx: Int) -> Int:
    decode_name := ir_generic_preferred_name(ir_resolve_json_call_name(index_idx, "decode_object"), "decode_object")
    return ir_emit_nested_decode_path(parent_handle_r, key_r, target_tid, ir_resolve_json_call_name(index_idx, "object_require_object"), decode_name, "json_nested_decode")

## emit the config nested decode prefix sequence.
pub fn ir_emit_config_nested_decode_prefix(cfg_r: Int, prefix_r: Int, target_tid: Int, index_idx: Int) -> Int:
    decode_name := ir_generic_preferred_name(ir_resolve_config_call_name(index_idx, "decode_prefix"), "decode_prefix")
    result_r := ir_reg()
    ir_emit_decode_result_call2(result_r, ir_queue_generic_specialization(decode_name, [ir_type_from_tid(target_tid)], "tuple"), cfg_r, prefix_r)
    return result_r

## emit the config nested decode prefix specialized sequence.
pub fn ir_emit_config_nested_decode_prefix_specialized(cfg_r: Int, prefix_r: Int, target_tid: Int) -> Int:
    decode_name := ir_config_generic_name("decode_prefix")
    result_r := ir_reg()
    ir_emit_decode_result_call2(result_r, ir_queue_generic_specialization(decode_name, [ir_type_from_tid(target_tid)], "tuple"), cfg_r, prefix_r)
    return result_r

## emit the handle-pool nested decode path sequence.
pub fn ir_emit_handle_nested_decode_path(handle_r: Int, key_r: Int, target_tid: Int, index_idx: Int) -> Int:
    decode_name := ir_generic_preferred_name(ir_resolve_handle_decode_call_name(index_idx, "decode"), "decode")
    return ir_emit_nested_decode_path(handle_r, key_r, target_tid, ir_resolve_handle_decode_call_name(index_idx, "require_table"), decode_name, "handle_nested_decode")

## emit the handle-pool nested decode path specialized sequence.
pub fn ir_emit_handle_nested_decode_path_specialized(handle_r: Int, key_r: Int, target_tid: Int, module_path: String) -> Int:
    decode_name := ir_handle_generic_name("decode", module_path)
    return ir_emit_nested_decode_path(handle_r, key_r, target_tid, ir_resolve_generic_module_call_name(module_path, "require_table"), decode_name, "handle_nested_decode")

## emit the config field key sequence.
pub fn ir_emit_config_field_key(field_name: String, prefix_r: Int, index_idx: Int) -> Int:
    key_r := ir_reg()
    ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
    if prefix_r < 0:
        return key_r
    full_key_r := ir_reg()
    ir_emit_call2(full_key_r, ir_resolve_config_call_name(index_idx, "dotted_key"), "string", prefix_r, key_r)
    return full_key_r

## emit the config specialized field key sequence.
pub fn ir_emit_config_specialized_field_key(field_name: String, prefix_r: Int) -> Int:
    key_r := ir_reg()
    ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
    if prefix_r < 0:
        return key_r
    full_key_r := ir_reg()
    ir_emit_call2(full_key_r, "std_config_dotted_key", "string", prefix_r, key_r)
    return full_key_r

struct IrDecodeFieldBranch:
    field_temp: String
    present_l: String
    merge_l: String

## open the has-field branch pair for one field.
pub fn ir_begin_decode_field_branch(has_r: Int, temp_prefix: String, temp_type: String) -> IrDecodeFieldBranch:
    present_l := ir_label()
    missing_l := ir_label()
    merge_l := ir_label()
    field_temp := ir_new_temp_name(temp_prefix)
    ir_var_types.insert(field_temp, temp_type)
    ir_emit("brif " + has_r.to_string() + " " + present_l + " " + missing_l)
    ir_emit_label(missing_l)
    return IrDecodeFieldBranch(field_temp, present_l, merge_l)

## begin the field-present branch.
pub fn ir_decode_field_present(branch: IrDecodeFieldBranch):
    ir_emit("jmp " + branch.merge_l)
    ir_emit_label(branch.present_l)

## store the branch value and jump to the merge point.
pub fn ir_decode_field_store_and_merge(branch: IrDecodeFieldBranch, value_r: Int):
    ir_emit("store " + branch.field_temp + " " + value_r.to_string())
    ir_emit("jmp " + branch.merge_l)

## load the merged field value after both branches join.
pub fn ir_decode_field_load_after_merge(branch: IrDecodeFieldBranch) -> Int:
    ir_emit_label(branch.merge_l)
    loaded_r := ir_reg()
    ir_emit("load " + loaded_r.to_string() + " " + branch.field_temp)
    return loaded_r

## missing optional field: store none.
pub fn ir_decode_field_store_missing_optional(branch: IrDecodeFieldBranch, default_idx: Int, emit_value: fn(Int, String) -> Int):
    if default_idx >= 0:
        ir_decode_field_store_and_merge(branch, emit_value(default_idx, "tuple"))
    else:
        ir_decode_field_store_and_merge(branch, ir_emit_optional_none_value())

## missing field with a default: store the default.
pub fn ir_decode_field_store_missing_default(branch: IrDecodeFieldBranch, default_idx: Int, target_kind: String, emit_value: fn(Int, String) -> Int):
    ir_decode_field_store_and_merge(branch, emit_value(default_idx, target_kind))

struct IrDecodeFieldValue:
    ok: Bool
    value_r: Int

## the value a missing decode helper yields.
pub fn ir_decode_missing_helper_value(emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    emit_default_ret()
    return IrDecodeFieldValue(false, 0 - 1)

## emit the config spec optional struct field sequence.
pub fn ir_emit_config_spec_optional_struct_field(cfg_r: Int, full_key_r: Int, default_idx: Int, optional_struct_tid: Int, emit_value: fn(Int, String) -> Int) -> IrDecodeFieldValue:
    has_r := ir_reg()
    ir_emit_call2(has_r, "std_config_has_prefix", "bool", cfg_r, full_key_r)
    branch := ir_begin_decode_field_branch(has_r, "config_spec_optional_struct_field", "tuple")
    ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_emit_config_nested_decode_prefix_specialized(cfg_r, full_key_r, optional_struct_tid)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the config spec nested struct field sequence.
pub fn ir_emit_config_spec_nested_struct_field(cfg_r: Int, full_key_r: Int, field_tid: Int, default_idx: Int, nested_struct_tid: Int, emit_value: fn(Int, String) -> Int) -> IrDecodeFieldValue:
    if default_idx < 0:
        field_result_r := ir_emit_config_nested_decode_prefix_specialized(cfg_r, full_key_r, nested_struct_tid)
        ir_emit_result_return_error_branch(field_result_r)
        return IrDecodeFieldValue(true, ir_take_json_ok(field_result_r, field_tid))

    has_r := ir_reg()
    ir_emit_call2(has_r, "std_config_has_prefix", "bool", cfg_r, full_key_r)
    branch := ir_begin_decode_field_branch(has_r, "config_spec_default_struct_field", ir_type_from_tid(field_tid))
    ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_emit_config_nested_decode_prefix_specialized(cfg_r, full_key_r, nested_struct_tid)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the config spec optional scalar field sequence.
pub fn ir_emit_config_spec_optional_scalar_field(cfg_r: Int, full_key_r: Int, default_idx: Int, optional_inner_tid: Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    helper_name := ir_config_require_full_name_for_type_name(ir_type_from_tid(optional_inner_tid))
    if helper_name.len() == 0:
        return ir_decode_missing_helper_value(emit_default_ret)
    has_r := ir_reg()
    ir_emit_call2(has_r, "std_config_has", "bool", cfg_r, full_key_r)
    branch := ir_begin_decode_field_branch(has_r, "config_spec_optional_field", "tuple")
    ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_reg()
    ir_emit_decode_result_call2(field_result_r, helper_name, cfg_r, full_key_r)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the config spec scalar field sequence.
pub fn ir_emit_config_spec_scalar_field(cfg_r: Int, full_key_r: Int, field_tid: Int, default_idx: Int, emit_expr: fn(Int) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    helper_name := ir_config_require_full_name_for_type_name(ir_type_from_tid(field_tid))
    if helper_name.len() == 0:
        return ir_decode_missing_helper_value(emit_default_ret)
    if default_idx < 0:
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, helper_name, cfg_r, full_key_r)
        ir_emit_result_return_error_branch(field_result_r)
        return IrDecodeFieldValue(true, ir_take_json_ok(field_result_r, field_tid))

    has_r := ir_reg()
    ir_emit_call2(has_r, "std_config_has", "bool", cfg_r, full_key_r)
    branch := ir_begin_decode_field_branch(has_r, "config_spec_default_field", ir_type_from_tid(field_tid))
    ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
    ir_decode_field_present(branch)
    field_result_r := ir_reg()
    ir_emit_decode_result_call2(field_result_r, helper_name, cfg_r, full_key_r)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the config spec field sequence.
pub fn ir_emit_config_spec_field(cfg_r: Int, prefix_r: Int, field_name: String, field_tid: Int, default_idx: Int, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    full_key_r := ir_emit_config_specialized_field_key(field_name, prefix_r)
    optional_inner_tid := ir_optional_inner_tid(field_tid)
    if optional_inner_tid >= 0:
        optional_struct_tid := ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            return ir_emit_config_spec_optional_struct_field(cfg_r, full_key_r, default_idx, optional_struct_tid, emit_value)
    nested_struct_tid := ir_struct_decode_field_tid(field_tid)
    if nested_struct_tid >= 0:
        return ir_emit_config_spec_nested_struct_field(cfg_r, full_key_r, field_tid, default_idx, nested_struct_tid, emit_value)
    if optional_inner_tid >= 0:
        return ir_emit_config_spec_optional_scalar_field(cfg_r, full_key_r, default_idx, optional_inner_tid, emit_value, emit_default_ret)
    return ir_emit_config_spec_scalar_field(cfg_r, full_key_r, field_tid, default_idx, emit_expr, emit_default_ret)

## emit the config decode specialization body sequence.
pub fn ir_emit_config_decode_specialization_body(struct_name: String, prefixed: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    if not ir_struct_names.contains_key(struct_name):
        emit_default_ret()
        return
    struct_tid := lookup_type_id(struct_name)
    if struct_tid < 0:
        emit_default_ret()
        return
    struct_info := get_type_info(struct_tid)
    cfg_r := ir_reg()
    ir_emit("load " + cfg_r.to_string() + " cfg")
    mut prefix_r := -1
    if prefixed:
        prefix_r = ir_reg()
        ir_emit("load " + prefix_r.to_string() + " prefix")

    mut field_regs: List[Int] := []
    field_count := ir_struct_field_count(struct_name)
    mut i := 0
    while i < field_count:
        field_name := ir_struct_field_name_at(struct_name, i)
        field_tid := ir_struct_field_tid_at(struct_name, i, struct_info.field_types[i])
        default_idx := ir_struct_field_default_node(struct_name, field_name)
        field_value := ir_emit_config_spec_field(cfg_r, prefix_r, field_name, field_tid, default_idx, emit_expr, emit_value, emit_default_ret)
        if not field_value.ok:
            return
        field_regs.push(field_value.value_r)
        i = i + 1

    ir_emit_struct_result_return(field_regs, "struct:" + struct_name)

## emit the config decode value sequence.
pub fn ir_emit_config_decode_value(target_info: TypeInfo, cfg_r: Int, prefix_r: Int, index_idx: Int, temp_name: String, done_l: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int):
    mut field_regs: List[Int] := []
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        default_idx := ir_struct_field_default_node(target_info.name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        full_key_r := ir_emit_config_field_key(field_name, prefix_r, index_idx)
        mut optional_struct_tid := 0 - 1
        if optional_inner_tid >= 0:
            optional_struct_tid = ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_config_call_name(index_idx, "has_prefix"), "bool", cfg_r, full_key_r)
            branch := ir_begin_decode_field_branch(has_r, "config_optional_struct_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_emit_config_nested_decode_prefix(cfg_r, full_key_r, optional_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        nested_struct_tid := ir_struct_decode_field_tid(field_tid)
        if nested_struct_tid >= 0:
            if default_idx >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_config_call_name(index_idx, "has_prefix"), "bool", cfg_r, full_key_r)
                branch := ir_begin_decode_field_branch(has_r, "config_default_struct_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_config_nested_decode_prefix(cfg_r, full_key_r, nested_struct_tid, index_idx)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            field_result_r := ir_emit_config_nested_decode_prefix(cfg_r, full_key_r, nested_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            continue
        if optional_inner_tid >= 0:
            helper_name := ir_config_require_helper_name(optional_inner_tid)
            if helper_name.len() == 0:
                continue
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_config_call_name(index_idx, "has"), "bool", cfg_r, full_key_r)
            branch := ir_begin_decode_field_branch(has_r, "config_optional_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_config_call_name(index_idx, helper_name), cfg_r, full_key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        helper_name := ir_config_require_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        if default_idx >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_config_call_name(index_idx, "has"), "bool", cfg_r, full_key_r)
            branch := ir_begin_decode_field_branch(has_r, "config_default_field", ir_type_from_tid(field_tid))
            ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_config_call_name(index_idx, helper_name), cfg_r, full_key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, ir_resolve_config_call_name(index_idx, helper_name), cfg_r, full_key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))

    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)

## emit the handle-pool spec optional struct field sequence.
pub fn ir_emit_handle_spec_optional_struct_field(handle_r: Int, key_r: Int, module_path: String, default_idx: Int, optional_struct_tid: Int, emit_value: fn(Int, String) -> Int) -> IrDecodeFieldValue:
    has_r := ir_reg()
    ir_emit_call2(has_r, ir_resolve_generic_module_call_name(module_path, "has"), "bool", handle_r, key_r)
    branch := ir_begin_decode_field_branch(has_r, "handle_spec_optional_struct_field", "tuple")
    ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_emit_handle_nested_decode_path_specialized(handle_r, key_r, optional_struct_tid, module_path)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the handle-pool spec nested struct field sequence.
pub fn ir_emit_handle_spec_nested_struct_field(handle_r: Int, key_r: Int, module_path: String, field_tid: Int, default_idx: Int, nested_struct_tid: Int, emit_value: fn(Int, String) -> Int) -> IrDecodeFieldValue:
    if default_idx < 0:
        field_result_r := ir_emit_handle_nested_decode_path_specialized(handle_r, key_r, nested_struct_tid, module_path)
        ir_emit_result_return_error_branch(field_result_r)
        return IrDecodeFieldValue(true, ir_take_json_ok(field_result_r, field_tid))

    has_r := ir_reg()
    ir_emit_call2(has_r, ir_resolve_generic_module_call_name(module_path, "has"), "bool", handle_r, key_r)
    branch := ir_begin_decode_field_branch(has_r, "handle_spec_default_struct_field", ir_type_from_tid(field_tid))
    ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_emit_handle_nested_decode_path_specialized(handle_r, key_r, nested_struct_tid, module_path)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the handle-pool spec optional scalar field sequence.
pub fn ir_emit_handle_spec_optional_scalar_field(handle_r: Int, key_r: Int, module_path: String, default_idx: Int, optional_inner_tid: Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    helper_name := ir_handle_require_full_name_for_type_name(ir_type_from_tid(optional_inner_tid), module_path)
    if helper_name.len() == 0:
        return ir_decode_missing_helper_value(emit_default_ret)
    has_r := ir_reg()
    ir_emit_call2(has_r, ir_resolve_generic_module_call_name(module_path, "has"), "bool", handle_r, key_r)
    branch := ir_begin_decode_field_branch(has_r, "handle_spec_optional_field", "tuple")
    ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
    ir_decode_field_present(branch)
    field_result_r := ir_reg()
    ir_emit_decode_result_call2(field_result_r, helper_name, handle_r, key_r)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the handle-pool spec scalar field sequence.
pub fn ir_emit_handle_spec_scalar_field(handle_r: Int, key_r: Int, module_path: String, field_tid: Int, default_idx: Int, emit_expr: fn(Int) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    helper_name := ir_handle_require_full_name_for_type_name(ir_type_from_tid(field_tid), module_path)
    if helper_name.len() == 0:
        return ir_decode_missing_helper_value(emit_default_ret)
    if default_idx < 0:
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, helper_name, handle_r, key_r)
        ir_emit_result_return_error_branch(field_result_r)
        return IrDecodeFieldValue(true, ir_take_json_ok(field_result_r, field_tid))

    has_r := ir_reg()
    ir_emit_call2(has_r, ir_resolve_generic_module_call_name(module_path, "has"), "bool", handle_r, key_r)
    branch := ir_begin_decode_field_branch(has_r, "handle_spec_default_field", ir_type_from_tid(field_tid))
    ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
    ir_decode_field_present(branch)
    field_result_r := ir_reg()
    ir_emit_decode_result_call2(field_result_r, helper_name, handle_r, key_r)
    ir_emit_result_return_error_branch(field_result_r)
    ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
    return IrDecodeFieldValue(true, ir_decode_field_load_after_merge(branch))

## emit the handle-pool spec field sequence.
pub fn ir_emit_handle_spec_field(handle_r: Int, module_path: String, field_name: String, field_tid: Int, default_idx: Int, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int) -> IrDecodeFieldValue:
    key_r := ir_reg()
    ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
    optional_inner_tid := ir_optional_inner_tid(field_tid)
    if optional_inner_tid >= 0:
        optional_struct_tid := ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            return ir_emit_handle_spec_optional_struct_field(handle_r, key_r, module_path, default_idx, optional_struct_tid, emit_value)
    nested_struct_tid := ir_struct_decode_field_tid(field_tid)
    if nested_struct_tid >= 0:
        return ir_emit_handle_spec_nested_struct_field(handle_r, key_r, module_path, field_tid, default_idx, nested_struct_tid, emit_value)
    if optional_inner_tid >= 0:
        return ir_emit_handle_spec_optional_scalar_field(handle_r, key_r, module_path, default_idx, optional_inner_tid, emit_value, emit_default_ret)
    return ir_emit_handle_spec_scalar_field(handle_r, key_r, module_path, field_tid, default_idx, emit_expr, emit_default_ret)

## the type id of field `i` of a struct a specialization body is decoding.
## a specialization body has no call node to take the checker's field
## tids from, so it used to ask the layout with no fallback, and the
## layout has no id of its own for a field whose kind is an optional, a
## list or a map: those came back -1, the body skipped the field, and
## every slot after it shifted (a nested struct with an optional field
## read its optional as the next field's value and crashed). the
## checker's type for the struct, looked up by name, supplies the tid the
## layout cannot; a scalar or struct field still resolves through the
## layout first, as it always did.
fn ir_specialized_struct_field_tid(struct_name: String, i: Int) -> Int:
    mut fallback := 0 - 1
    struct_tid := lookup_type_id(struct_name)
    if struct_tid >= 0:
        info := get_type_info(struct_tid)
        if info.kind == "struct" and i < info.field_types.len():
            fallback = info.field_types[i]
    return ir_struct_field_tid_at(struct_name, i, fallback)

## emit the handle-pool decode struct from handle sequence.
pub fn ir_emit_handle_decode_struct_from_handle(struct_name: String, module_path: String, handle_name: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    if not ir_struct_names.contains_key(struct_name):
        emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " " + handle_name)

    mut field_regs: List[Int] := []
    field_count := ir_struct_field_count(struct_name)
    mut i := 0
    while i < field_count:
        field_name := ir_struct_field_name_at(struct_name, i)
        field_tid := ir_specialized_struct_field_tid(struct_name, i)
        default_idx := ir_struct_field_default_node(struct_name, field_name)
        field_value := ir_emit_handle_spec_field(handle_r, module_path, field_name, field_tid, default_idx, emit_expr, emit_value, emit_default_ret)
        if not field_value.ok:
            return
        field_regs.push(field_value.value_r)
        i = i + 1

    ir_emit_struct_result_return(field_regs, "struct:" + struct_name)

## emit the handle-pool decode specialization body sequence.
pub fn ir_emit_handle_decode_specialization_body(struct_name: String, module_path: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    ir_emit_handle_decode_struct_from_handle(struct_name, module_path, "handle", emit_expr, emit_value, emit_default_ret)

## emit the handle-pool decode path specialization body sequence.
pub fn ir_emit_handle_decode_path_specialization_body(struct_name: String, module_path: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    dotted_path_r := ir_reg()
    ir_emit("load " + dotted_path_r.to_string() + " dotted_path")
    ir_emit_dotted_path_lookup_or_return(handle_r, dotted_path_r, ir_resolve_generic_module_call_name(module_path, "require_table"), "current", "__for_iter_handle_path", "__for_len_handle_path", "__for_idx_handle_path")
    ir_emit_handle_decode_struct_from_handle(struct_name, module_path, "current", emit_expr, emit_value, emit_default_ret)

## emit the handle-pool decode text specialization body sequence.
pub fn ir_emit_handle_decode_text_specialization_body(struct_name: String, module_path: String, concrete_types: List[String], ret_type: String):
    input_r := ir_reg()
    ir_emit("load " + input_r.to_string() + " input")
    temp_name := ir_new_temp_name("handle_decode_text")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # this body owns the parse that fills the pool, so mark it now and reclaim
    # at the single exit. the decode sub-call materializes the struct (copying
    # strings out), so the nodes are dead by the time we restore.
    mark := ir_emit_handle_pool_mark(ir_resolve_generic_module_call_name(module_path, "pool_mark_node_id"), ir_resolve_generic_module_call_name(module_path, "pool_mark_table_len"), ir_resolve_generic_module_call_name(module_path, "pool_mark_array_len"))
    parse_result_r := ir_reg()
    ir_emit_decode_result_call1(parse_result_r, ir_resolve_generic_module_call_name(module_path, "parse_required"), input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    root_r := ir_take_result_ok_typed(parse_result_r, "Int")
    decode_base := ir_resolve_generic_module_call_name(module_path, "decode")
    decode_name := ir_queue_generic_specialization(decode_base, concrete_types, ret_type)
    decode_result_r := ir_reg()
    ir_emit_decode_result_call1(decode_result_r, decode_name, root_r)
    ir_emit("store " + temp_name + " " + decode_result_r.to_string())
    ir_emit_label(done_l)
    ir_emit_handle_pool_restore(mark, ir_resolve_generic_module_call_name(module_path, "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the handle-pool decode text path specialization body sequence.
pub fn ir_emit_handle_decode_text_path_specialization_body(struct_name: String, module_path: String, concrete_types: List[String], ret_type: String):
    input_r := ir_reg()
    ir_emit("load " + input_r.to_string() + " input")
    temp_name := ir_new_temp_name("handle_decode_text_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # owns the parse, so bracket it and reclaim at the single exit.
    mark := ir_emit_handle_pool_mark(ir_resolve_generic_module_call_name(module_path, "pool_mark_node_id"), ir_resolve_generic_module_call_name(module_path, "pool_mark_table_len"), ir_resolve_generic_module_call_name(module_path, "pool_mark_array_len"))
    parse_result_r := ir_reg()
    ir_emit_decode_result_call1(parse_result_r, ir_resolve_generic_module_call_name(module_path, "parse_required"), input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    root_r := ir_take_result_ok_typed(parse_result_r, "Int")
    path_r := ir_reg()
    ir_emit("load " + path_r.to_string() + " dotted_path")
    decode_path_base := ir_resolve_generic_module_call_name(module_path, "decode_path")
    decode_path_name := ir_queue_generic_specialization(decode_path_base, concrete_types, ret_type)
    path_result_r := ir_reg()
    ir_emit_decode_result_call2(path_result_r, decode_path_name, root_r, path_r)
    ir_emit("store " + temp_name + " " + path_result_r.to_string())
    ir_emit_label(done_l)
    ir_emit_handle_pool_restore(mark, ir_resolve_generic_module_call_name(module_path, "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the config decode call sequence.
pub fn ir_emit_config_decode_call(idx: Int, node: Node, prefixed: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    cfg_r := arg_regs[0]
    mut prefix_r := -1
    if prefixed:
        if arg_regs.len() < 2:
            return ir_zero_reg()
        prefix_r = arg_regs[1]

    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("config_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    ir_emit_config_decode_value(target_info, cfg_r, prefix_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the config loader decode call sequence.
pub fn ir_emit_config_loader_decode_call(idx: Int, node: Node, loader_name: String, prefixed: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    input_r := arg_regs[0]
    mut prefix_r := -1
    if prefixed:
        if arg_regs.len() < 2:
            return ir_zero_reg()
        prefix_r = arg_regs[1]

    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("config_loader_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    load_result_r := ir_reg()
    ir_emit_decode_result_call1(load_result_r, ir_resolve_config_call_name(node.children[0], loader_name), input_r)
    ir_emit_result_store_error_branch(load_result_r, temp_name, done_l)
    cfg_r := ir_take_result_ok(load_result_r, lookup_type_id("Config"))
    ir_emit_config_decode_value(target_info, cfg_r, prefix_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the config file decode call sequence.
pub fn ir_emit_config_file_decode_call(idx: Int, node: Node, loader_name: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    return ir_emit_config_loader_decode_call(idx, node, loader_name, false, emit_expr, emit_value)

## emit the handle-pool decode value sequence.
pub fn ir_emit_handle_decode_value(target_info: TypeInfo, handle_r: Int, index_idx: Int, temp_name: String, done_l: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int):
    mut field_regs: List[Int] := []

    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        default_idx := ir_struct_field_default_node(target_info.name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        mut optional_struct_tid := 0 - 1
        if optional_inner_tid >= 0:
            optional_struct_tid = ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_handle_decode_call_name(index_idx, "has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "handle_optional_struct_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_emit_handle_nested_decode_path(handle_r, key_r, optional_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        nested_struct_tid := ir_struct_decode_field_tid(field_tid)
        if nested_struct_tid >= 0:
            if default_idx >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_handle_decode_call_name(index_idx, "has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "handle_default_struct_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_handle_nested_decode_path(handle_r, key_r, nested_struct_tid, index_idx)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            field_result_r := ir_emit_handle_nested_decode_path(handle_r, key_r, nested_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            continue
        if optional_inner_tid >= 0:
            helper_name := ir_handle_require_helper_name(optional_inner_tid)
            if helper_name.len() == 0:
                continue
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_handle_decode_call_name(index_idx, "has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "handle_optional_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_handle_decode_call_name(index_idx, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        helper_name := ir_handle_require_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        if default_idx >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_handle_decode_call_name(index_idx, "has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "handle_default_field", ir_type_from_tid(field_tid))
            ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_handle_decode_call_name(index_idx, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, ir_resolve_handle_decode_call_name(index_idx, helper_name), handle_r, key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))

    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)

## emit the handle-pool decode call sequence.
pub fn ir_emit_handle_decode_call(idx: Int, node: Node, text_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    mut handle_r := arg_regs[0]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("handle_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # only the text form owns the parse that fills the pool; the handle form is
    # handed an already-parsed root the caller owns and must not roll back.
    mut mark := IrHandlePoolMark("", "", "")
    if text_input:
        mark = ir_emit_handle_pool_mark(ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_table_len"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_array_len"))
        parse_result_r := ir_reg()
        ir_emit_decode_result_call1(parse_result_r, ir_resolve_handle_decode_call_name(node.children[0], "parse_required"), handle_r)
        ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
        handle_r = ir_take_result_ok(parse_result_r, lookup_type_id("Int"))

    ir_emit_handle_decode_value(target_info, handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    if text_input:
        ir_emit_handle_pool_restore(mark, ir_resolve_handle_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the handle-pool decode path call sequence.
pub fn ir_emit_handle_decode_path_call(idx: Int, node: Node, text_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() < 2:
        return ir_zero_reg()

    mut handle_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("handle_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()

    # only the text form owns the parse; the handle form must not roll back.
    mut mark := IrHandlePoolMark("", "", "")
    if text_input:
        mark = ir_emit_handle_pool_mark(ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_table_len"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_array_len"))
        parse_result_r := ir_reg()
        ir_emit_decode_result_call1(parse_result_r, ir_resolve_handle_decode_call_name(node.children[0], "parse_required"), handle_r)
        ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
        handle_r = ir_take_result_ok(parse_result_r, lookup_type_id("Int"))

    current_name := ir_new_temp_name("handle_decode_current")
    parts_name := ir_new_temp_name("handle_decode_parts")
    len_name := ir_new_temp_name("handle_decode_parts_len")
    idx_name := ir_new_temp_name("handle_decode_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    final_handle_r := ir_emit_dotted_path_lookup(handle_r, dotted_path_r, ir_resolve_handle_decode_call_name(node.children[0], "require_table"), lookup_type_id("Int"), current_name, parts_name, len_name, idx_name, temp_name, done_l)
    ir_emit_handle_decode_value(target_info, final_handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    if text_input:
        ir_emit_handle_pool_restore(mark, ir_resolve_handle_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the handle-pool decode file call sequence.
pub fn ir_emit_handle_decode_file_call(idx: Int, node: Node, path_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    file_path_r := arg_regs[0]
    if not path_input:
        target_tid := ir_decode_target_tid(idx, node)
        if target_tid < 0:
            return ir_zero_reg()
        target_info := get_type_info(target_tid)

        temp_name := ir_new_temp_name("handle_decode_file")
        ir_var_types.insert(temp_name, "tuple")
        done_l := ir_label()
        # reads and parses the file itself, so it owns the pool nodes.
        mark := ir_emit_handle_pool_mark(ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_table_len"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_array_len"))
        parse_result_r := ir_reg()
        ir_emit_decode_result_call1(parse_result_r, ir_resolve_handle_decode_call_name(node.children[0], "parse_file_required"), file_path_r)
        ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
        handle_r := ir_take_result_ok(parse_result_r, lookup_type_id("Int"))
        ir_emit_handle_decode_value(target_info, handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
        ir_emit_label(done_l)
        ir_emit_handle_pool_restore(mark, ir_resolve_handle_decode_call_name(node.children[0], "pool_restore"))
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + temp_name)
        return r

    if arg_regs.len() < 2:
        return ir_zero_reg()
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("handle_decode_file_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # owns the file parse, so bracket the pool and reclaim at done_l.
    mark := ir_emit_handle_pool_mark(ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_table_len"), ir_resolve_handle_decode_call_name(node.children[0], "pool_mark_array_len"))
    parse_result_r := ir_reg()
    ir_emit_decode_result_call1(parse_result_r, ir_resolve_handle_decode_call_name(node.children[0], "parse_file_required"), file_path_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    handle_r := ir_take_result_ok(parse_result_r, lookup_type_id("Int"))

    current_name := ir_new_temp_name("handle_decode_file_current")
    parts_name := ir_new_temp_name("handle_decode_file_parts")
    len_name := ir_new_temp_name("handle_decode_file_parts_len")
    idx_name := ir_new_temp_name("handle_decode_file_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    final_handle_r := ir_emit_dotted_path_lookup(handle_r, dotted_path_r, ir_resolve_handle_decode_call_name(node.children[0], "require_table"), lookup_type_id("Int"), current_name, parts_name, len_name, idx_name, temp_name, done_l)
    ir_emit_handle_decode_value(target_info, final_handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    ir_emit_handle_pool_restore(mark, ir_resolve_handle_decode_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# a flat struct whose fields are all plain required scalars can decode
# straight from the object bytes with per-key scanners, skipping the
# intermediate scalar-object (and its three maps and key allocations).
fn ir_json_decode_all_required_scalar(target_info: TypeInfo) -> Bool:
    if target_info.fields.len() == 0:
        return false
    if not ir_struct_decl_nodes.contains_key(target_info.name):
        return false
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_optional_inner_tid(field_tid) >= 0:
            return false
        if ir_struct_field_default_node(target_info.name, field_name) >= 0:
            return false
        if ir_json_scan_required_helper_name(field_tid).len() == 0:
            return false
    return true

# the fast path: one per-key byte scan per field, no scalar-object.
# build the packed field spec ("<type><name>,..." in declaration order,
# so a field's position is its struct slot) from a struct's decl node.
# used both when interning the spec in the string prepass and when the
# decoder references it, so the two always produce the identical string.
pub fn ir_json_decode_spec_from_decl(decl: Node) -> String:
    mut spec := ""
    mut first := true
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and fnode.children.len() > 0:
            if not first:
                spec = spec + ","
            first = false
            fname := fnode.value.split(" ")[0]
            type_node := get_node(fnode.children[0])
            spec = spec + ir_json_type_name_char(type_node.value) + fname
    return spec

# 2^n - 1: one bit per field, the mask when every field was filled.
fn ir_json_required_mask(n: Int) -> Int:
    mut mask := 0
    mut i := 0
    while i < n:
        mask = mask * 2 + 1
        i = i + 1
    return mask

# string is the only rc scalar, so the struct needs its destructor when
# any field is a string — otherwise those field strings would leak.
fn ir_json_decode_has_string(target_info: TypeInfo) -> Bool:
    for field_name, i in target_info.fields:
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_json_field_type_char(field_tid) == "s":
            return true
    return false

# the fast path: decode a flat scalar struct in a single pass. the
# runtime fills a pre-allocated struct — destructor attached — in place,
# so there is no scalar-object, no per-field result tuple, and no leaked
# field strings. a mask of the filled fields is checked against the
# required set; any miss releases the struct and returns the decode error.
fn ir_emit_json_decode_scan_fields(input_r: Int, target_info: TypeInfo) -> Int:
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    ok_l := ir_label()
    err_l := ir_label()
    done_l := ir_label()
    n := target_info.fields.len()

    struct_r := ir_reg()
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + n.to_string())
    ir_emit_call1(struct_r, "__struct_alloc", "struct:" + target_info.name, count_r)
    if ir_json_decode_has_string(target_info):
        dtor_r := ir_reg()
        ir_emit("funcref " + dtor_r.to_string() + " __dtor_" + ir_struct_base_name(target_info.name))
        ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + dtor_r.to_string())

    spec_r := ir_reg()
    ir_emit("strref " + spec_r.to_string() + " " + ir_str(ir_json_decode_spec_from_decl(get_node(ir_struct_decl_nodes[target_info.name]))))

    mask_r := ir_reg()
    ir_emit_call_text(mask_r, "pith_json_fill_struct", "int", 3, " " + input_r.to_string() + " " + spec_r.to_string() + " " + struct_r.to_string())

    req_r := ir_reg()
    ir_emit("iconst " + req_r.to_string() + " " + ir_json_required_mask(n).to_string())
    eq_r := ir_reg()
    ir_emit("eq " + eq_r.to_string() + " " + mask_r.to_string() + " " + req_r.to_string())
    ir_emit("brif " + eq_r.to_string() + " " + ok_l + " " + err_l)

    ir_emit_label(err_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", struct_r)
    err_res_r := ir_reg()
    ir_emit_call_text(err_res_r, "pith_json_decode_missing_error", "tuple", 2, " " + mask_r.to_string() + " " + spec_r.to_string())
    ir_emit("store " + temp_name + " " + err_res_r.to_string())
    ir_emit("jmp " + done_l)

    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + ir_emit_ok_result_tuple_raw(struct_r).to_string())

    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# --- the nested fill path --------------------------------------------------
#
# a struct with a nested struct field used to parse into the node pool and
# copy its fields out through the object accessors, at about five hundred
# times the cost of the flat fill above (docs/performance.md, nested json
# decoding). it now fills in place too: the lowering allocates the whole
# tree of structs, each with its destructor and each sub-struct stored in
# its parent's slot, and hands the runtime one spec that carries the
# sub-struct's layout inside the field's entry, `o<name>(<sub-spec>)`.
# the runtime recurses into the struct it reads out of the slot, so it
# never allocates and never learns a destructor's address.
#
# the nested spec is a string the decode references with a strref, so
# like the flat spec it has to be interned before any body is emitted.
# a struct with a struct field is common in programs that never decode,
# so the prepass interns a spec only for the structs the program's
# decode calls target, resolved through the checker's type for each
# call; a decode whose target is a type parameter (web.parse[T] and the
# like) cannot be resolved there, so a program with one gets the spec of
# every struct that has one. either way the specs are appended after
# everything else the prepass interns, and a program that does not
# decode gets the string table it always had.
#
# both the prepass and the decode build the spec from declarations, with
# a struct field's written type name resolved through the one map the
# prepass built (ir_json_nested_decls), so the two strings are the same
# by construction. before taking this path the decode checks that the
# declaration each written name resolved to is the one the checker's
# type for that field points at, and that the spec is in the table, and
# takes the node-pool path otherwise (a same-named struct in two
# modules, an aliased or generic type, a target the prepass missed).

# bare struct name -> declaration node index, over every root of the
# program; a name declared more than once is left out so it resolves to
# nothing rather than to the wrong one.
pub mut ir_json_nested_decls: Map[String, Int] := {}

fn ir_json_nested_decl_index(type_name: String) -> Int:
    if ir_json_nested_decls.contains_key(type_name):
        return ir_json_nested_decls[type_name]
    return 0 - 1

fn ir_json_is_struct_decl_kind(kind: String) -> Bool:
    return kind == "struct_decl" or kind == "struct"

fn ir_json_bare_decl_name(node: Node) -> String:
    if node.value.contains("["):
        return node.value.substring(0, node.value.index_of("["))
    return node.value

# the structs whose destructor address the nested filler needs, in the
# order the spec's `#<k>` indices name them: the element struct of every
# list and every struct field under one, which the filler allocates
# itself because their count is the document's. rebuilt by every spec
# build, so the table a decode passes matches the spec it passes; the
# prepass builds the same spec and discards the list.
pub mut ir_json_spec_dtor_names: List[String] := []

fn ir_json_spec_dtor_index(name: String) -> Int:
    for existing, i in ir_json_spec_dtor_names:
        if existing == name:
            return i
    ir_json_spec_dtor_names.push(name)
    return ir_json_spec_dtor_names.len() - 1

# the nested spec of a declaration: the flat spec's `<type><name>` entries
# with a struct field written as `o<name>(<sub-spec>)`, a list field as
# `l<name>(<elem>)` and a `Map[String, T]` field as `m<name>(<elem>)`,
# where the element is a scalar letter, `l(<elem>)`, `m(<elem>)` or
# `o#<k>(<sub-spec>)`; parentheses, not braces, because an IR string
# literal reads `}}` as one escaped brace and a doubly nested spec ends
# in two. a struct the filler allocates itself (a list element, a map
# value, or a struct field inside one) carries `#<k>`, the index of its
# destructor in the table the decode hands over; a struct the lowering
# pre-allocates does not. "" when a field is neither a scalar, a
# collection of these, nor a struct this map resolves, or the nesting
# runs deeper than any real shape; such a struct has no nested spec and
# its decode takes the node-pool path.
pub fn ir_json_decode_nested_spec_from_decl(decl: Node, depth: Int) -> String:
    ir_json_spec_dtor_names = []
    return ir_json_nested_spec_of_decl(decl, depth, false)

fn ir_json_nested_spec_of_decl(decl: Node, depth: Int, under_list: Bool) -> String:
    if depth > 16:
        return ""
    mut spec := ""
    mut first := true
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and fnode.children.len() > 0:
            if not first:
                spec = spec + ","
            first = false
            fname := fnode.value.split(" ")[0]
            type_node := get_node(fnode.children[0])
            if ir_json_type_node_is_list(type_node):
                elem := ir_json_nested_elem_spec(get_node(type_node.children[0]), depth + 1)
                if elem.len() == 0:
                    return ""
                spec = spec + "l" + fname + "(" + elem + ")"
                continue
            if ir_json_type_node_is_string_map(type_node):
                elem := ir_json_nested_elem_spec(get_node(type_node.children[1]), depth + 1)
                if elem.len() == 0:
                    return ""
                spec = spec + "m" + fname + "(" + elem + ")"
                continue
            type_char := ir_json_type_name_char(type_node.value)
            if type_char.len() > 0:
                spec = spec + type_char + fname
                continue
            if type_node.kind != "type":
                return ""
            sub_idx := ir_json_nested_decl_index(type_node.value)
            if sub_idx < 0:
                return ""
            mut marker := ""
            if under_list:
                marker = "#" + ir_json_spec_dtor_index(type_node.value).to_string()
            sub_spec := ir_json_nested_spec_of_decl(get_node(sub_idx), depth + 1, under_list)
            if sub_spec.len() == 0:
                return ""
            spec = spec + "o" + fname + marker + "(" + sub_spec + ")"
    return spec

# a written `List[...]` type: one of the two generics the nested spec reads.
fn ir_json_type_node_is_list(type_node: Node) -> Bool:
    return type_node.kind == "generic_type" and type_node.value == "List" and type_node.children.len() == 1

# a written `Map[String, ...]` type: the other generic the nested spec
# reads. a map with any other key type has no spec entry, as the checker
# refuses it (a json object's keys are strings).
fn ir_json_type_node_is_string_map(type_node: Node) -> Bool:
    if type_node.kind != "generic_type" or type_node.value != "Map" or type_node.children.len() != 2:
        return false
    key_node := get_node(type_node.children[0])
    return key_node.kind == "type" and key_node.value == "String"

# the element part of a list or map entry: a scalar letter, `l(<elem>)`
# for a list, `m(<elem>)` for a string-keyed map, or `o#<k>(<sub-spec>)`
# for a struct the map resolves, whose fields are laid out under the
# filler's ownership. "" for anything else.
fn ir_json_nested_elem_spec(type_node: Node, depth: Int) -> String:
    if depth > 16:
        return ""
    if ir_json_type_node_is_list(type_node):
        inner := ir_json_nested_elem_spec(get_node(type_node.children[0]), depth + 1)
        if inner.len() == 0:
            return ""
        return "l(" + inner + ")"
    if ir_json_type_node_is_string_map(type_node):
        inner := ir_json_nested_elem_spec(get_node(type_node.children[1]), depth + 1)
        if inner.len() == 0:
            return ""
        return "m(" + inner + ")"
    if type_node.kind != "type":
        return ""
    type_char := ir_json_type_name_char(type_node.value)
    if type_char.len() > 0:
        return type_char
    sub_idx := ir_json_nested_decl_index(type_node.value)
    if sub_idx < 0:
        return ""
    marker := "#" + ir_json_spec_dtor_index(type_node.value).to_string()
    sub_spec := ir_json_nested_spec_of_decl(get_node(sub_idx), depth + 1, true)
    if sub_spec.len() == 0:
        return ""
    return "o" + marker + "(" + sub_spec + ")"

# true when a declaration has a field the flat spec cannot carry: a
# struct, a list or a map. the declarations the prepass interns a nested
# spec for.
fn ir_json_decl_has_nested_field(decl: Node) -> Bool:
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and fnode.children.len() > 0:
            type_node := get_node(fnode.children[0])
            if type_node.kind == "type" and ir_json_type_name_char(type_node.value).len() == 0:
                return true
            if ir_json_type_node_is_list(type_node) or ir_json_type_node_is_string_map(type_node):
                return true
    return false

fn ir_json_intern_nested_spec_of(decl_idx: Int):
    node := get_node(decl_idx)
    if ir_json_is_struct_decl_kind(node.kind) and ir_json_decl_has_nested_field(node):
        spec := ir_json_decode_nested_spec_from_decl(node, 0)
        if spec.len() > 0:
            ir_str(spec)

## the string prepass step for the nested fill: build the declaration map
## over `roots`, then intern the nested spec of every struct a decode call
## in the program targets, or of every struct that has one when a call's
## target cannot be resolved before specialization. called after
## everything else the prepass interns, so the strings it adds only ever
## append to the table.
pub fn ir_json_intern_nested_specs(roots: List[Int]):
    ir_json_nested_decls = {}
    mut ambiguous: List[String] := []
    for root in roots:
        for item_idx in ir_root_items(root):
            node := get_node(item_idx)
            if not ir_json_is_struct_decl_kind(node.kind):
                continue
            name := ir_json_bare_decl_name(node)
            if ir_json_nested_decls.contains_key(name):
                ambiguous.push(name)
            else:
                ir_json_nested_decls.insert(name, item_idx)
    for name in ambiguous:
        ir_json_nested_decls.remove(name)
    mut targets: List[Int] := []
    mut unresolved := false
    for root in roots:
        for call_idx in ir_cached_decode_call_nodes(root):
            ret_tid := c_get_expr_type(call_idx)
            mut resolved := false
            if ret_tid >= 0:
                ret_info := get_type_info(ret_tid)
                if ret_info.kind == "result" and get_type_info(ret_info.inner).kind == "struct":
                    # a struct target the map does not know by its bare name
                    # gets no spec, and its decode takes the node-pool path
                    resolved = true
                    target_idx := ir_json_nested_decl_index(get_type_info(ret_info.inner).name)
                    if target_idx >= 0:
                        targets.push(target_idx)
            if not resolved:
                unresolved = true
    if unresolved:
        for root in roots:
            for item_idx in ir_root_items(root):
                ir_json_intern_nested_spec_of(item_idx)
        return
    for target_idx in targets:
        ir_json_intern_nested_spec_of(target_idx)

# the nested spec a decode of `target_info` hands the runtime, or "" when
# the target does not take the nested fill: it must have a struct field,
# be of the fill shape at every depth, and its spec must already be in
# the string table.
fn ir_json_decode_nested_spec_for(target_info: TypeInfo) -> String:
    if not ir_struct_has_nested_decode_fields(target_info):
        return ""
    if not ir_json_decode_nested_fill_shape(target_info, 0):
        return ""
    spec := ir_json_decode_nested_spec_from_decl(get_node(ir_struct_decl_nodes[target_info.name]), 0)
    if spec.len() == 0 or not ir_str_interned(spec):
        return ""
    return spec

# true when the target is of the nested fill's shape: every field at
# every depth is a required scalar or a struct of the same shape, the
# declaration's fields line up with the checker's type, and each struct
# field's written name resolves to the declaration its type points at.
fn ir_json_decode_nested_fill_shape(target_info: TypeInfo, depth: Int) -> Bool:
    if depth > 16:
        return false
    n := target_info.fields.len()
    if n == 0 or n > 63:
        return false
    if not ir_struct_decl_nodes.contains_key(target_info.name):
        return false
    decl := get_node(ir_struct_decl_nodes[target_info.name])
    mut i := 0
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind != "field":
            continue
        if fnode.children.len() == 0:
            return false
        if i >= n or i >= target_info.field_types.len():
            return false
        field_name := target_info.fields[i]
        if fnode.value.split(" ")[0] != field_name:
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_optional_inner_tid(field_tid) >= 0:
            return false
        if ir_struct_field_default_node(target_info.name, field_name) >= 0:
            return false
        type_node := get_node(fnode.children[0])
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0:
            if type_node.kind != "type":
                return false
            if not ir_json_struct_decl_matches(nested_tid, type_node.value, depth):
                return false
        elif ir_json_list_elem_tid(field_tid) >= 0:
            if not ir_json_type_node_is_list(type_node):
                return false
            if not ir_json_elem_fill_shape(ir_json_list_elem_tid(field_tid), get_node(type_node.children[0]), depth + 1):
                return false
        elif ir_json_map_value_tid(field_tid) >= 0:
            if not ir_json_type_node_is_string_map(type_node):
                return false
            if not ir_json_elem_fill_shape(ir_json_map_value_tid(field_tid), get_node(type_node.children[1]), depth + 1):
                return false
        elif ir_json_type_name_char(type_node.value).len() == 0 or ir_json_type_name_char(type_node.value) != ir_json_field_type_char(field_tid):
            return false
        i = i + 1
    return i == n

# true when the struct type `struct_tid` is the one the written name
# resolves to in the declaration map, and is itself of the fill shape.
fn ir_json_struct_decl_matches(struct_tid: Int, written_name: String, depth: Int) -> Bool:
    nested_info := get_type_info(struct_tid)
    resolved := ir_json_nested_decl_index(written_name)
    if resolved < 0 or not ir_struct_decl_nodes.contains_key(nested_info.name):
        return false
    if ir_struct_decl_nodes[nested_info.name] != resolved:
        return false
    return ir_json_decode_nested_fill_shape(nested_info, depth + 1)

# true when a list element or map value type is one the filler builds: a
# scalar whose written name agrees with the checker's type, a list or a
# string-keyed map of such elements, or a struct of the fill shape whose
# written name resolves to its declaration.
fn ir_json_elem_fill_shape(elem_tid: Int, elem_node: Node, depth: Int) -> Bool:
    if depth > 16:
        return false
    elem_info := get_type_info(elem_tid)
    if elem_info.kind == "primitive":
        if elem_node.kind != "type":
            return false
        return ir_json_type_name_char(elem_node.value).len() > 0 and ir_json_type_name_char(elem_node.value) == ir_json_field_type_char(elem_tid)
    if elem_info.kind == "list":
        if not ir_json_type_node_is_list(elem_node) or elem_info.inner < 0:
            return false
        return ir_json_elem_fill_shape(elem_info.inner, get_node(elem_node.children[0]), depth + 1)
    if elem_info.kind == "map":
        if not ir_json_type_node_is_string_map(elem_node) or ir_json_map_value_tid(elem_tid) < 0:
            return false
        return ir_json_elem_fill_shape(elem_info.value_type, get_node(elem_node.children[1]), depth + 1)
    if elem_info.kind == "struct":
        if elem_node.kind != "type":
            return false
        return ir_json_struct_decl_matches(elem_tid, elem_node.value, depth)
    return false

# true when a field at any depth of the target is a list or a map: the
# decode then hands the filler the destructor table and calls the
# collection-aware entry point.
fn ir_json_target_has_collection_field(target_info: TypeInfo, depth: Int) -> Bool:
    if depth > 16:
        return false
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            return false
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        if ir_json_list_elem_tid(field_tid) >= 0 or ir_json_map_value_tid(field_tid) >= 0:
            return true
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0 and ir_json_target_has_collection_field(get_type_info(nested_tid), depth + 1):
            return true
    return false

# allocate the struct tree the nested fill writes into: the struct, its
# destructor when the type needs one, and each struct field's own tree
# stored into its slot. the returned struct owns everything under it from
# here on, so one release on any failure drops the whole tree.
fn ir_emit_json_nested_alloc(target_info: TypeInfo) -> Int:
    struct_r := ir_reg()
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + target_info.fields.len().to_string())
    ir_emit_call1(struct_r, "__struct_alloc", "struct:" + target_info.name, count_r)
    if ir_struct_needs_dtor(target_info.name):
        dtor_r := ir_reg()
        ir_emit("funcref " + dtor_r.to_string() + " __dtor_" + ir_struct_base_name(target_info.name))
        ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + dtor_r.to_string())
    for field_name, i in target_info.fields:
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        nested_tid := ir_struct_decode_field_tid(field_tid)
        if nested_tid >= 0:
            sub_r := ir_emit_json_nested_alloc(get_type_info(nested_tid))
            ir_emit("sstore " + struct_r.to_string() + " " + i.to_string() + " " + sub_r.to_string())
    return struct_r

# the nested fast path: allocate the tree, hand the runtime the input,
# the nested spec and the root, and take the result box it returns. the
# runtime releases the tree itself on any failure, so there is no branch
# here; `check_utf8` is what a bytes input got from the node path, which
# validated it before parsing.
#
# a target with a list or a map field anywhere in it goes to the
# collection-aware entry point with a destructor table: the filler
# allocates a list's element structs and a map's value structs itself,
# so it needs the address of each one's destructor, and the table holds
# them in the order the spec's `#<k>` markers name them
# (ir_json_spec_dtor_names, as the spec build just left it). the table
# is a bare struct this decode releases after the call; a struct that
# needs no destructor gets a 0 entry. a target with no collection field
# calls the entry point it always did, so its ir is unchanged.
fn ir_emit_json_decode_fill_nested(input_r: Int, target_info: TypeInfo, spec: String, check_utf8: Bool) -> Int:
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    struct_r := ir_emit_json_nested_alloc(target_info)
    spec_r := ir_reg()
    ir_emit("strref " + spec_r.to_string() + " " + ir_str(spec))
    flag_r := ir_reg()
    mut flag := 0
    if check_utf8:
        flag = 1
    ir_emit("iconst " + flag_r.to_string() + " " + flag.to_string())
    result_r := ir_reg()
    if not ir_json_target_has_collection_field(target_info, 0):
        ir_emit_call_text(result_r, "pith_json_fill_struct_nested", "tuple", 4, " " + input_r.to_string() + " " + spec_r.to_string() + " " + struct_r.to_string() + " " + flag_r.to_string())
        ir_emit("store " + temp_name + " " + result_r.to_string())
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + temp_name)
        return r
    dtor_names := ir_json_spec_dtor_names
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + dtor_names.len().to_string())
    table_r := ir_reg()
    if dtor_names.len() == 0:
        ir_emit("iconst " + table_r.to_string() + " 0")
    else:
        ir_emit_call1(table_r, "__struct_alloc", "tuple", count_r)
        for name, k in dtor_names:
            entry_r := ir_reg()
            if ir_struct_needs_dtor(name):
                ir_emit("funcref " + entry_r.to_string() + " __dtor_" + ir_struct_base_name(name))
            else:
                ir_emit("iconst " + entry_r.to_string() + " 0")
            ir_emit("sstore " + table_r.to_string() + " " + k.to_string() + " " + entry_r.to_string())
    ir_emit_call_text(result_r, "pith_json_fill_struct_lists", "tuple", 6, " " + input_r.to_string() + " " + spec_r.to_string() + " " + struct_r.to_string() + " " + flag_r.to_string() + " " + table_r.to_string() + " " + count_r.to_string())
    if dtor_names.len() > 0:
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", table_r)
    ir_emit("store " + temp_name + " " + result_r.to_string())
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json decode map call sequence.
pub fn ir_emit_json_decode_map_call(input_r: Int, target_info: TypeInfo, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    if ir_json_decode_all_required_scalar(target_info):
        return ir_emit_json_decode_scan_fields(input_r, target_info)

    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()

    scan_r := ir_reg()
    ir_emit_decode_result_call1(scan_r, "std_json_decode_scalars_bytes", input_r)
    ir_emit_result_store_error_branch(scan_r, temp_name, done_l)
    fields_r := ir_take_result_ok(scan_r, -1)
    # the scalar object and its maps are this decode's to drop: every exit
    # from here on, the built struct and each field error alike, passes
    # through fields_done_l, which releases it before done_l. it used to be
    # stranded, about a kilobyte per decode of a struct with an optional
    # or defaulted field.
    fields_done_l := ir_label()

    mut field_regs: List[Int] := []
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        default_idx := ir_struct_field_default_node(target_info.name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        if optional_inner_tid >= 0:
            helper_name := ir_json_require_helper_name(optional_inner_tid)
            has_name := ir_json_scalar_has_helper_name(optional_inner_tid)
            if helper_name.len() == 0 or has_name.len() == 0:
                continue
            key_r := ir_reg()
            ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
            has_r := ir_reg()
            ir_emit_call2(has_r, has_name, "bool", fields_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "json_optional_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, helper_name, fields_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, fields_done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        helper_name := ir_json_require_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        if default_idx >= 0:
            has_name := ir_json_scalar_has_helper_name(field_tid)
            if has_name.len() == 0:
                continue
            key_r := ir_reg()
            ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
            has_r := ir_reg()
            ir_emit_call2(has_r, has_name, "bool", fields_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "json_default_field", ir_type_from_tid(field_tid))
            ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, helper_name, fields_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, fields_done_l)
            ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, helper_name, fields_r, key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, fields_done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))

    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)
    ir_emit_label(fields_done_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", fields_r)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json decode object value sequence.
pub fn ir_emit_json_decode_object_value(target_info: TypeInfo, handle_r: Int, index_idx: Int, temp_name: String, done_l: String, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int):
    mut field_regs: List[Int] := []
    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := ir_struct_field_tid_at(target_info.name, i, target_info.field_types[i])
        default_idx := ir_struct_field_default_node(target_info.name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        mut optional_struct_tid := 0 - 1
        if optional_inner_tid >= 0:
            optional_struct_tid = ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "json_object_optional_struct_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_emit_json_nested_decode_path(handle_r, key_r, optional_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        nested_struct_tid := ir_struct_decode_field_tid(field_tid)
        if nested_struct_tid >= 0:
            if default_idx >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_struct_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_nested_decode_path(handle_r, key_r, nested_struct_tid, index_idx)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            field_result_r := ir_emit_json_nested_decode_path(handle_r, key_r, nested_struct_tid, index_idx)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            continue
        # a list of structs, plain, optional or defaulted: the
        # object_require_list specialization for the element type builds
        # the list element by element through decode_object
        mut struct_list_tid := ir_json_struct_list_elem_tid(field_tid)
        if optional_inner_tid >= 0:
            struct_list_tid = ir_json_struct_list_elem_tid(optional_inner_tid)
        if struct_list_tid >= 0:
            list_helpers := ir_json_list_helpers_for_call(index_idx)
            if optional_inner_tid >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "json_object_optional_list_field", "tuple")
                ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            if default_idx >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_list_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            continue
        # a map, or a list of lists or of maps, plain, optional or
        # defaulted: the general node builder walks the parsed node
        mut node_built_tid := field_tid
        if optional_inner_tid >= 0:
            node_built_tid = optional_inner_tid
        if ir_json_node_built_collection(node_built_tid):
            node_helpers := ir_json_node_helpers_for_call(index_idx)
            if optional_inner_tid >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "json_object_optional_collection_field", "tuple")
                ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, optional_inner_tid, node_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            if default_idx >= 0:
                has_r := ir_reg()
                ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_collection_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, field_tid, node_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                continue
            field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, field_tid, node_helpers)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            continue
        if optional_inner_tid >= 0:
            helper_name := ir_json_object_helper_name(optional_inner_tid)
            if helper_name.len() == 0:
                continue
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "json_object_optional_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_json_call_name(index_idx, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        helper_name := ir_json_object_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        if default_idx >= 0:
            has_r := ir_reg()
            ir_emit_call2(has_r, ir_resolve_json_call_name(index_idx, "object_has"), "bool", handle_r, key_r)
            branch := ir_begin_decode_field_branch(has_r, "json_object_default_field", ir_type_from_tid(field_tid))
            ir_decode_field_store_and_merge(branch, emit_expr(default_idx))
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_json_call_name(index_idx, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            continue
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, ir_resolve_json_call_name(index_idx, helper_name), handle_r, key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))

    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)

## emit the json decode flat6 call sequence.
## emit the json decode call sequence.
pub fn ir_emit_json_decode_call(idx: Int, node: Node, text_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)
    mut input_r := arg_regs[0]
    # an argument minted by a call (`decode[T](bytes.from_string_utf8(s))`, a
    # body read, `decode_text[T](req.body())`) is transferred to this
    # expression and dies with the decode; a named local or field stays the
    # caller's. a text argument's conversion below mints the bytes this call
    # frees either way; the text itself is released here only when a call
    # minted it, which used to strand one string per `decode_text[T](f())`.
    mut fresh_bytes_input := false
    mut fresh_text_input := false
    input_expr := ir_decode_arg_expr_idx(node, 1)
    if input_expr >= 0:
        input_kind := get_node(input_expr).kind
        fresh_input := input_kind == "call" or input_kind == "method_call"
        if text_input:
            fresh_text_input = fresh_input
        else:
            fresh_bytes_input = fresh_input
    text_r := input_r
    owns_input := text_input or fresh_bytes_input
    has_optional_fields := ir_struct_has_optional_fields(target_info)
    has_default_fields := ir_struct_has_default_fields(target_info)
    has_nested_fields := ir_struct_has_nested_decode_fields(target_info)
    # a nested shape of required scalars and structs fills in place, like
    # the flat one below; anything else with a struct field parses into
    # the node pool.
    nested_spec := ir_json_decode_nested_spec_for(target_info)
    if nested_spec.len() > 0:
        mut fill_input_r := input_r
        if text_input:
            converted_r := ir_reg()
            ir_emit_call1(converted_r, "std_bytes_from_string_utf8", "bytes", input_r)
            fill_input_r = converted_r
        fill_r := ir_emit_json_decode_fill_nested(fill_input_r, target_info, nested_spec, not text_input)
        if owns_input:
            ir_rc_release_reg(fill_input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return fill_r
    if has_nested_fields:
        temp_name := ir_new_temp_name("json_decode_nested")
        ir_var_types.insert(temp_name, "tuple")
        done_l := ir_label()
        # this call owns the parse below, so bracket it: mark the pool now and
        # reclaim the nodes once the struct is built (all paths reach done_l).
        mark := ir_emit_json_pool_mark(ir_resolve_json_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_json_call_name(node.children[0], "pool_mark_array_len"))
        mut handle_r := input_r
        if text_input:
            parsed_r := ir_reg()
            ir_emit_call1(parsed_r, ir_resolve_json_call_name(node.children[0], "parse"), "int", input_r)
            handle_r = parsed_r
        else:
            parse_result_r := ir_reg()
            ir_emit_decode_result_call1(parse_result_r, ir_resolve_json_call_name(node.children[0], "parse_bytes_required"), input_r)
            ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
            handle_r = ir_take_result_ok(parse_result_r, lookup_type_id("Int"))
        checked_r := ir_reg()
        ir_emit_decode_result_call1(checked_r, ir_resolve_json_call_name(node.children[0], "require_object_handle"), handle_r)
        ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
        object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
        ir_emit_json_decode_object_value(target_info, object_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
        ir_emit_label(done_l)
        ir_emit_json_pool_restore(mark, ir_resolve_json_call_name(node.children[0], "pool_restore"))
        if fresh_bytes_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + temp_name)
        return r
    if text_input:
        converted_r := ir_reg()
        ir_emit_call1(converted_r, "std_bytes_from_string_utf8", "bytes", input_r)
        input_r = converted_r
    # any flat struct of required scalars decodes in one pass straight
    # into a pre-allocated struct, whatever its field count.
    if ir_json_decode_all_required_scalar(target_info):
        scan_r := ir_emit_json_decode_scan_fields(input_r, target_info)
        if owns_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return scan_r
    if target_info.fields.len() > 3 or has_optional_fields or has_default_fields:
        map_r := ir_emit_json_decode_map_call(input_r, target_info, emit_expr, emit_value)
        if owns_input:
            ir_rc_release_reg(input_r, "bytes")
        if fresh_text_input:
            ir_string_release_reg(text_r)
        return map_r

    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    mut field_regs: List[Int] := []

    for field_name, i in target_info.fields:
        if i >= target_info.field_types.len():
            continue
        field_tid := target_info.field_types[i]
        helper_name := ir_json_field_helper_name(field_tid)
        if helper_name.len() == 0:
            continue
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, helper_name, input_r, key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))

    ir_emit_struct_result_store(field_regs, "struct:" + target_info.name, temp_name)
    ir_emit_label(done_l)
    if owns_input:
        ir_rc_release_reg(input_r, "bytes")
    if fresh_text_input:
        ir_string_release_reg(text_r)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json nested decode path specialized sequence.
pub fn ir_emit_json_nested_decode_path_specialized(parent_handle_r: Int, key_r: Int, target_tid: Int, module_path: String) -> Int:
    decode_name := ir_json_generic_name("decode_object")
    return ir_emit_nested_decode_path(parent_handle_r, key_r, target_tid, ir_resolve_generic_module_call_name(module_path, "object_require_object"), decode_name, "json_nested_decode")

## emit the json object has sequence.
pub fn ir_emit_json_object_has(handle_r: Int, key_r: Int, module_path: String) -> Int:
    has_r := ir_reg()
    ir_emit_call2(has_r, ir_resolve_generic_module_call_name(module_path, "object_has"), "bool", handle_r, key_r)
    return has_r

## emit the json decode object value specialized sequence.
pub fn ir_emit_json_decode_object_value_specialized(struct_name: String, handle_r: Int, module_path: String, temp_name: String, done_l: String, emit_value: fn(Int, String) -> Int):
    mut field_regs: List[Int] := []
    field_count := ir_struct_field_count(struct_name)
    mut i := 0
    while i < field_count:
        field_name := ir_struct_field_name_at(struct_name, i)
        field_tid := ir_specialized_struct_field_tid(struct_name, i)
        default_idx := ir_struct_field_default_node(struct_name, field_name)
        optional_inner_tid := ir_optional_inner_tid(field_tid)
        key_r := ir_reg()
        ir_emit("strref " + key_r.to_string() + " " + ir_str(field_name))
        mut optional_struct_tid := 0 - 1
        if optional_inner_tid >= 0:
            optional_struct_tid = ir_struct_decode_field_tid(optional_inner_tid)
        if optional_struct_tid >= 0:
            has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
            branch := ir_begin_decode_field_branch(has_r, "json_object_optional_struct_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_emit_json_nested_decode_path_specialized(handle_r, key_r, optional_struct_tid, module_path)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_struct_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            i = i + 1
            continue
        nested_struct_tid := ir_struct_decode_field_tid(field_tid)
        if nested_struct_tid >= 0:
            if default_idx >= 0:
                has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_struct_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_nested_decode_path_specialized(handle_r, key_r, nested_struct_tid, module_path)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                i = i + 1
                continue
            field_result_r := ir_emit_json_nested_decode_path_specialized(handle_r, key_r, nested_struct_tid, module_path)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            i = i + 1
            continue
        # a list of structs, plain, optional or defaulted, through the
        # object_require_list specialization for the element type
        mut struct_list_tid := ir_json_struct_list_elem_tid(field_tid)
        if optional_inner_tid >= 0:
            struct_list_tid = ir_json_struct_list_elem_tid(optional_inner_tid)
        if struct_list_tid >= 0:
            list_helpers := ir_json_list_helpers_for_module(module_path)
            if optional_inner_tid >= 0:
                has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
                branch := ir_begin_decode_field_branch(has_r, "json_object_optional_list_field", "tuple")
                ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                i = i + 1
                continue
            if default_idx >= 0:
                has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_list_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                i = i + 1
                continue
            field_result_r := ir_emit_json_struct_list_field(handle_r, key_r, struct_list_tid, list_helpers)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            i = i + 1
            continue
        # a map, or a list of lists or of maps, plain, optional or
        # defaulted, through the general node builder
        mut node_built_tid := field_tid
        if optional_inner_tid >= 0:
            node_built_tid = optional_inner_tid
        if ir_json_node_built_collection(node_built_tid):
            node_helpers := ir_json_node_helpers_for_module(module_path)
            if optional_inner_tid >= 0:
                has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
                branch := ir_begin_decode_field_branch(has_r, "json_object_optional_collection_field", "tuple")
                ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, optional_inner_tid, node_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                i = i + 1
                continue
            if default_idx >= 0:
                has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
                branch := ir_begin_decode_field_branch(has_r, "json_object_default_collection_field", ir_type_from_tid(field_tid))
                ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
                ir_decode_field_present(branch)
                field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, field_tid, node_helpers)
                ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
                ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
                field_regs.push(ir_decode_field_load_after_merge(branch))
                i = i + 1
                continue
            field_result_r := ir_emit_json_node_collection_field(handle_r, key_r, field_tid, node_helpers)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            field_regs.push(ir_take_json_ok(field_result_r, field_tid))
            i = i + 1
            continue
        if optional_inner_tid >= 0:
            helper_name := ir_json_object_helper_name(optional_inner_tid)
            if helper_name.len() == 0:
                # advance i: a bare continue re-tests `while i < field_count` on
                # the same field and hangs the compiler (this loop indexes by hand).
                i = i + 1
                continue
            has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
            branch := ir_begin_decode_field_branch(has_r, "json_object_optional_field", "tuple")
            ir_decode_field_store_missing_optional(branch, default_idx, emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_generic_module_call_name(module_path, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_emit_optional_some_value(ir_take_json_ok(field_result_r, optional_inner_tid)))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            i = i + 1
            continue
        helper_name := ir_json_object_helper_name(field_tid)
        if helper_name.len() == 0:
            # advance i: a bare continue re-tests `while i < field_count` on
            # the same field and hangs the compiler (this loop indexes by hand).
            i = i + 1
            continue
        if default_idx >= 0:
            has_r := ir_emit_json_object_has(handle_r, key_r, module_path)
            branch := ir_begin_decode_field_branch(has_r, "json_object_default_field", ir_type_from_tid(field_tid))
            ir_decode_field_store_missing_default(branch, default_idx, ir_type_from_tid(field_tid), emit_value)
            ir_decode_field_present(branch)
            field_result_r := ir_reg()
            ir_emit_decode_result_call2(field_result_r, ir_resolve_generic_module_call_name(module_path, helper_name), handle_r, key_r)
            ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
            ir_decode_field_store_and_merge(branch, ir_take_json_ok(field_result_r, field_tid))
            field_regs.push(ir_decode_field_load_after_merge(branch))
            i = i + 1
            continue
        field_result_r := ir_reg()
        ir_emit_decode_result_call2(field_result_r, ir_resolve_generic_module_call_name(module_path, helper_name), handle_r, key_r)
        ir_emit_result_store_error_branch(field_result_r, temp_name, done_l)
        field_regs.push(ir_take_json_ok(field_result_r, field_tid))
        i = i + 1

    ir_emit_struct_result_store(field_regs, "struct:" + struct_name, temp_name)
    ir_emit_label(done_l)

## emit the json decode object specialization body sequence.
pub fn ir_emit_json_decode_object_specialization_body(struct_name: String, module_path: String, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    if not ir_struct_names.contains_key(struct_name):
        emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    temp_name := ir_new_temp_name("json_decode_object")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    ir_emit_json_decode_object_value_specialized(struct_name, handle_r, module_path, temp_name, done_l, emit_value)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the json decode specialization body sequence.
pub fn ir_emit_json_decode_specialization_body(struct_name: String, module_path: String, text_input: Bool, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    if not ir_struct_names.contains_key(struct_name):
        emit_default_ret()
        return
    input_r := ir_reg()
    ir_emit("load " + input_r.to_string() + " input")
    temp_name := ir_new_temp_name("json_decode")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # bracket the whole body: this decode owns the parse below, so mark the pool
    # now and reclaim its nodes at the single exit (done_l). every error path
    # routes through done_l, so one restore covers success and failure alike.
    mark := ir_emit_json_pool_mark(ir_resolve_generic_module_call_name(module_path, "pool_mark_node_id"), ir_resolve_generic_module_call_name(module_path, "pool_mark_array_len"))
    mut handle_r := input_r
    if text_input:
        parsed_r := ir_reg()
        ir_emit_call1(parsed_r, ir_resolve_generic_module_call_name(module_path, "parse"), "int", input_r)
        handle_r = parsed_r
    else:
        parse_result_r := ir_reg()
        ir_emit_decode_result_call1(parse_result_r, ir_resolve_generic_module_call_name(module_path, "parse_bytes_required"), input_r)
        ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
        handle_r = ir_take_result_ok(parse_result_r, 0)
    checked_r := ir_reg()
    ir_emit_decode_result_call1(checked_r, ir_resolve_generic_module_call_name(module_path, "require_object_handle"), handle_r)
    ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
    object_r := ir_take_result_ok(checked_r, 0)
    ir_emit_json_decode_object_value_specialized(struct_name, object_r, module_path, temp_name, done_l, emit_value)
    ir_emit_json_pool_restore(mark, ir_resolve_generic_module_call_name(module_path, "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the json decode path specialization body sequence.
pub fn ir_emit_json_decode_path_specialization_body(struct_name: String, module_path: String, emit_value: fn(Int, String) -> Int, emit_default_ret: fn() -> Int):
    if not ir_struct_names.contains_key(struct_name):
        emit_default_ret()
        return
    handle_r := ir_reg()
    ir_emit("load " + handle_r.to_string() + " handle")
    root_result_r := ir_reg()
    ir_emit_decode_result_call1(root_result_r, ir_resolve_generic_module_call_name(module_path, "require_object_handle"), handle_r)
    temp_name := ir_new_temp_name("json_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    ir_emit_result_store_error_branch(root_result_r, temp_name, done_l)
    current_name := ir_new_temp_name("json_current")
    parts_name := ir_new_temp_name("json_parts")
    len_name := ir_new_temp_name("json_parts_len")
    idx_name := ir_new_temp_name("json_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    root_r := ir_take_result_ok(root_result_r, 0)
    dotted_path_r := ir_reg()
    ir_emit("load " + dotted_path_r.to_string() + " dotted_path")
    final_handle_r := ir_emit_dotted_path_lookup(root_r, dotted_path_r, ir_resolve_generic_module_call_name(module_path, "object_require_object"), 0, current_name, parts_name, len_name, idx_name, temp_name, done_l)
    ir_emit_json_decode_object_value_specialized(struct_name, final_handle_r, module_path, temp_name, done_l, emit_value)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    ir_emit("ret " + r.to_string())
    ir_emit("endfunc")

## emit the json decode object call sequence.
pub fn ir_emit_json_decode_object_call(idx: Int, node: Node, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    handle_r := arg_regs[0]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("json_decode_object")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    checked_r := ir_reg()
    ir_emit_decode_result_call1(checked_r, ir_resolve_json_call_name(node.children[0], "require_object_handle"), handle_r)
    ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
    object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
    ir_emit_json_decode_object_value(target_info, object_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json decode path call sequence.
pub fn ir_emit_json_decode_path_call(idx: Int, node: Node, text_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() < 2:
        return ir_zero_reg()

    mut handle_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("json_decode_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()

    # only the text form owns the parse that fills the pool; the handle form is
    # handed an already-parsed root the caller still owns, so it must not roll
    # the pool back. bracket the parse only when we did it ourselves.
    mut mark := IrJsonPoolMark("", "")
    if text_input:
        mark = ir_emit_json_pool_mark(ir_resolve_json_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_json_call_name(node.children[0], "pool_mark_array_len"))
        parsed_r := ir_reg()
        ir_emit_call1(parsed_r, ir_resolve_json_call_name(node.children[0], "parse"), "int", handle_r)
        handle_r = parsed_r

    root_result_r := ir_reg()
    ir_emit_decode_result_call1(root_result_r, ir_resolve_json_call_name(node.children[0], "require_object_handle"), handle_r)
    ir_emit_result_store_error_branch(root_result_r, temp_name, done_l)

    current_name := ir_new_temp_name("json_current")
    parts_name := ir_new_temp_name("json_parts")
    len_name := ir_new_temp_name("json_parts_len")
    idx_name := ir_new_temp_name("json_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    root_r := ir_take_result_ok(root_result_r, lookup_type_id("Int"))
    final_handle_r := ir_emit_dotted_path_lookup(root_r, dotted_path_r, ir_resolve_json_call_name(node.children[0], "object_require_object"), lookup_type_id("Int"), current_name, parts_name, len_name, idx_name, temp_name, done_l)
    ir_emit_json_decode_object_value(target_info, final_handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    if text_input:
        ir_emit_json_pool_restore(mark, ir_resolve_json_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the json decode file call sequence.
pub fn ir_emit_json_decode_file_call(idx: Int, node: Node, path_input: Bool, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    arg_regs := ir_decode_collect_arg_regs(node, 1, emit_expr)
    if arg_regs.len() == 0:
        return ir_zero_reg()

    file_path_r := arg_regs[0]
    if not path_input:
        target_tid := ir_decode_target_tid(idx, node)
        if target_tid < 0:
            return ir_zero_reg()
        target_info := get_type_info(target_tid)

        temp_name := ir_new_temp_name("json_decode_file")
        ir_var_types.insert(temp_name, "tuple")
        done_l := ir_label()
        # this call reads and parses the file itself, so it owns the pool nodes
        # and reclaims them at done_l once the struct is built.
        mark := ir_emit_json_pool_mark(ir_resolve_json_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_json_call_name(node.children[0], "pool_mark_array_len"))
        parsed_r := ir_reg()
        ir_emit_call1(parsed_r, ir_resolve_json_call_name(node.children[0], "parse_file"), "int", file_path_r)
        checked_r := ir_reg()
        ir_emit_decode_result_call1(checked_r, ir_resolve_json_call_name(node.children[0], "require_object_handle"), parsed_r)
        ir_emit_result_store_error_branch(checked_r, temp_name, done_l)
        object_r := ir_take_result_ok(checked_r, lookup_type_id("Int"))
        ir_emit_json_decode_object_value(target_info, object_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
        ir_emit_label(done_l)
        ir_emit_json_pool_restore(mark, ir_resolve_json_call_name(node.children[0], "pool_restore"))
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + temp_name)
        return r

    if arg_regs.len() < 2:
        return ir_zero_reg()
    dotted_path_r := arg_regs[1]
    target_tid := ir_decode_target_tid(idx, node)
    if target_tid < 0:
        return ir_zero_reg()
    target_info := get_type_info(target_tid)

    temp_name := ir_new_temp_name("json_decode_file_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    # owns the file parse, so bracket the pool and reclaim at done_l.
    mark := ir_emit_json_pool_mark(ir_resolve_json_call_name(node.children[0], "pool_mark_node_id"), ir_resolve_json_call_name(node.children[0], "pool_mark_array_len"))
    parsed_r := ir_reg()
    ir_emit_call1(parsed_r, ir_resolve_json_call_name(node.children[0], "parse_file"), "int", file_path_r)
    root_result_r := ir_reg()
    ir_emit_decode_result_call1(root_result_r, ir_resolve_json_call_name(node.children[0], "require_object_handle"), parsed_r)
    ir_emit_result_store_error_branch(root_result_r, temp_name, done_l)

    current_name := ir_new_temp_name("json_file_current")
    parts_name := ir_new_temp_name("json_file_parts")
    len_name := ir_new_temp_name("json_file_parts_len")
    idx_name := ir_new_temp_name("json_file_parts_idx")
    ir_var_types.insert(current_name, "int")
    ir_var_types.insert(parts_name, "list_string")
    ir_var_types.insert(len_name, "int")
    ir_var_types.insert(idx_name, "int")
    root_r := ir_take_result_ok(root_result_r, lookup_type_id("Int"))
    final_handle_r := ir_emit_dotted_path_lookup(root_r, dotted_path_r, ir_resolve_json_call_name(node.children[0], "object_require_object"), lookup_type_id("Int"), current_name, parts_name, len_name, idx_name, temp_name, done_l)
    ir_emit_json_decode_object_value(target_info, final_handle_r, node.children[0], temp_name, done_l, emit_expr, emit_value)
    ir_emit_label(done_l)
    ir_emit_json_pool_restore(mark, ir_resolve_json_call_name(node.children[0], "pool_restore"))
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

## emit the index config decode call sequence.
pub fn ir_emit_index_config_decode_call(idx: Int, node: Node, callee_idx: Int, emit_expr: fn(Int) -> Int, emit_value: fn(Int, String) -> Int) -> Int:
    if ir_is_config_decode_callee(callee_idx, "decode"):
        return ir_emit_config_decode_call(idx, node, false, emit_expr, emit_value)
    if ir_is_config_decode_callee(callee_idx, "decode_prefix"):
        return ir_emit_config_decode_call(idx, node, true, emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_file_typed"):
        return ir_emit_config_file_decode_call(idx, node, "from_toml_file", emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_file_typed"):
        return ir_emit_config_file_decode_call(idx, node, "from_json_file", emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_toml", true, emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_json", true, emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_toml_file_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_toml_file", true, emit_expr, emit_value)
    if ir_is_config_file_decode_callee(callee_idx, "from_json_file_typed_prefix"):
        return ir_emit_config_loader_decode_call(idx, node, "from_json_file", true, emit_expr, emit_value)
    return 0 - 1
