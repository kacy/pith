# type aliases: a second name for an existing type.
#
# tracks response times per endpoint. the aliases name what a value means
# (milliseconds, an endpoint path) and shorten the collection and function
# types that would otherwise be repeated. an alias is the same type as the
# one it names, so a Millis passes anywhere an Int does; it documents intent
# rather than adding a check.

type Millis = Int
type Endpoint = String
type Timings = Map[Endpoint, List[Millis]]
type Budget = fn(Millis) -> Bool

fn record(timings: Timings, endpoint: Endpoint, elapsed: Millis):
    if not timings.contains_key(endpoint):
        timings[endpoint] = []
    timings[endpoint].push(elapsed)

fn slowest(samples: List[Millis]) -> Millis:
    mut worst := 0
    for sample in samples:
        worst = max(worst, sample)
    return worst

fn within(limit: Millis) -> Budget:
    return fn(elapsed: Millis) => elapsed <= limit

fn main():
    mut timings: Map[Endpoint, List[Millis]] := {}
    record(timings, "/login", 120)
    record(timings, "/search", 340)
    record(timings, "/login", 95)
    record(timings, "/search", 910)
    record(timings, "/health", 3)
    record(timings, "/health", 4)

    budget := within(500)
    for endpoint in ["/health", "/login", "/search"]:
        worst := slowest(timings[endpoint])
        verdict := if budget(worst): "ok" else: "over budget"
        print("{endpoint:<8} {timings[endpoint].len()} calls, slowest {worst} ms, {verdict}")
