# a ByteBuffer is a buffer like a list: two tasks writing one would race on
# its storage. its handle is an Int, which the sharing checks used to read as a
# plain number.

import std.bytes as bytes
from std.bytes import ByteBuffer

fn writer(b: ByteBuffer, n: Int) -> Int!:
    for i in 0..n:
        b.write_string_utf8("abc")!
    return n

fn main() -> Int!:
    b := bytes.buffer()
    t1 := spawn writer(b, 1000)
    t2 := spawn writer(b, 1000)
    print("{(await t1)!} {(await t2)!}")
    return 0
