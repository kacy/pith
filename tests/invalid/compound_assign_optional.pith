# a compound assignment reads its target, applies an operator and writes it
# back, so an optional target has to be unwrapped first. it used to be accepted
# and then emitted against the shell's address: an Int? holding 5 answered 0
# after `+= 3`, with no diagnostic anywhere.
fn main() -> Int:
    mut x: Int? := 5
    x += 3
    mut y: Int? := none
    y *= 1000000
    return 0
