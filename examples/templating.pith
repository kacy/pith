# html templates that escape by default
#
# std.template renders a page from a context. every `<%= %>` value goes
# through html.escape on the way out, so the hostile note in this example is
# displayed rather than executed. the only unescaped path is `<%raw %>`, which
# a human has to type, and which is greppable precisely so it can be audited.
#
# Run: pith run examples/templating.pith
import std.html as html
import std.template as template

# the page. `<% %>` rather than `{{ }}` because pith already owns braces
# inside string literals — a mustache tag would need doubling everywhere.
fn page_source() -> String:
    return [
        "<h1>notes for <%= user.name %></h1>",
        "<% if notes %>",
        "<ul>",
        "<% for note in notes %>",
        "<li><a href=\"<%raw note.link %>\"><%= note.title %></a>: <%= note.body %></li>",
        "<% end %>",
        "</ul>",
        "<% else %>",
        "<p>no notes yet</p>",
        "<% end %>",
        "<footer><%raw footer %></footer>",
    ].join("")

# one note. `link` is built in pith with html.escape_url, because a url in an
# href needs its scheme filtered and escaping alone would leave
# "javascript:alert(1)" clickable. it is emitted with `<%raw %>` since it has
# already been escaped once and escaping it twice would break the url.
fn note(title: String, body: String, link: String) -> template.Ctx:
    return template.context().set("title", title).set("body", body).set("link", html.escape_url(link))

fn render_notes() -> Int!template.TemplateError:
    page := template.compile(page_source())!

    # everything below arrived from outside: a display name, note titles and
    # bodies, and two urls, one of which is an attack.
    notes := template.list()
    notes.push(note("shopping", "milk & eggs", "/notes/1"))
    notes.push(note("<script>alert(1)</script>", "\" onmouseover=\"alert(1)", "javascript:alert(1)"))

    # the footer is markup this program wrote, not input, so it is the one
    # value that opts out of escaping.
    ctx := template.context()
    ctx.set_child("user", template.context().set("name", "ada & co"))
    ctx.set_child("notes", notes)
    ctx.set("footer", "<em>generated by pith</em>")

    rendered := template.render(page, ctx)!
    print(rendered)

    # what the escaping bought, stated as checks rather than left to the reader
    # to spot in the markup above.
    script_survived := rendered.contains("<script>")
    attribute_escaped := rendered.contains("onmouseover=\"alert")
    javascript_url := rendered.contains("javascript:")
    footer_is_markup := rendered.contains("<em>generated by pith</em>")
    print("script tag survived: {script_survived}")
    print("attribute broken out of: {attribute_escaped}")
    print("javascript url survived: {javascript_url}")
    print("trusted footer is markup: {footer_is_markup}")

    # the empty case takes the else branch.
    empty := template.context()
    empty.set_child("user", template.context().set("name", "nobody"))
    empty.set_child("notes", template.list())
    empty.set("footer", "")
    print(template.render(page, empty)!)
    return 0

# whether a template is rejected. a syntax error surfaces when the template is
# compiled, not when it is rendered, so compiling your pages at startup turns a
# broken template into a failure to boot rather than a 500 under traffic.
fn rejected(source: String) -> Bool:
    template.compile(source) catch:
        return true
    return false

fn main() -> Int!:
    outcome := render_notes() catch:
        print("render failed")
        return 1
    print("unclosed block rejected: {rejected("<% if x %>never closed")}")
    print("unknown tag rejected: {rejected("<% while x %><% end %>")}")
    print("expression rejected: {rejected("<%= name.upper() %>")}")
    return outcome
