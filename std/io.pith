# std.io - io interfaces and generic helpers
#
# this is the first pass at a shared io foundation for the stdlib.
# the public surface still offers both string and bytes helpers, but
# the transport-facing string layer now rides on top of bytes where it can.
#
# the key idea is simple:
# - transports implement a small interface surface
# - generic helpers like read_all and copy do the repetitive work once
# - higher-level stdlib modules build on the same contracts
#
# handle-backed in-memory adapters are included so the helpers are easy to test.

import std.bytes as bytes
import std.time as time
from std.bytes import ByteBuffer
from std.concurrent import Context, BlockingError, blocking_cancelled, blocking_deadline_exceeded, blocking_failed, background

DEFAULT_CHUNK_SIZE := 4096

# the stream registries below are threadlocal, which under the green backend
# means per task: a buffered reader or writer is created and used inside one
# task, so its entries are never shared and need no lock. a process-wide mutex
# used to wrap every buffer access anyway; at 32 workers an http server spent
# most of its time queued on it.
#
# the handles that key them come from one process-wide counter, so a handle
# names an entry in exactly one task's maps. a value can still die on another
# task than the one that built it (it was handed through a channel, or a
# spawned task held the last count), and its destructor then looks the handle
# up in that task's maps. with a counter per task, the same number named that
# task's own reader and the destructor closed it. with one counter it finds
# nothing there and does nothing, which is what a close on that task does too.
IO_HANDLES := AtomicInt(1)

# the next registry handle. never reissued, and never 0.
fn next_io_handle() -> Int:
    while true:
        handle := IO_HANDLES.load()
        if IO_HANDLES.compare_set(handle, handle + 1):
            return handle
    return 0

threadlocal mut string_reader_data: Map[Int, String] := {}
threadlocal mut string_reader_offsets: Map[Int, Int] := {}

# a string buffer is a handle onto one growable byte buffer (the runtime's
# byte buffer, the same storage std.bytes builds on). each write appends its
# bytes in place and the storage doubles as it fills, so building a string
# of n bytes copies O(n) bytes in total; string() copies the whole content
# out once per call. the map owns the byte buffer: the entry's removal on
# close() is what frees it.
threadlocal mut string_buffer_stores: Map[Int, Int] := {}

threadlocal mut bytes_reader_data: Map[Int, Bytes] := {}
threadlocal mut bytes_reader_offsets: Map[Int, Int] := {}

interface Reader:
    fn read(max_bytes: Int) -> String!

interface Writer:
    fn write(data: String) -> Int!

interface BytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!

interface BytesWriter:
    fn write_bytes(data: Bytes) -> Int!

interface Closer:
    fn close()

interface Flusher:
    fn flush() -> Int!

# what a buffered text reader fills from: one read of raw bytes, and the same
# read given a context to give up on. a source that never blocks checks the
# context and then reads.
#
# the chunk comes back as bytes and not as text. a byte stream read of `size`
# bytes ends wherever the count lands, which can be halfway through a
# character, so the decode belongs to the reader, which knows where it wants
# its boundaries. the names differ from BytesReader's so a type can implement
# both: one type cannot declare a method twice across interface impls.
interface TextSource:
    fn read_chunk(max_bytes: Int) -> Bytes!
    fn read_chunk_ctx(ctx: Context, max_bytes: Int) -> Bytes!BlockingError

# what a buffered text writer flushes into: a write of the whole string, and
# the same write given a context to give up on.
interface TextTarget:
    fn write_all(data: String) -> Int!
    fn write_all_ctx(ctx: Context, data: String) -> Int!BlockingError

# a buffered bytes reader's state: the source a fill reads from, how much it
# asks for at a time, and what it has read and not handed out yet. a reader
# keeps all of it in one entry, so an operation finds it with one lookup.
struct BufferedBytesReaderState:
    source: BytesReader
    chunk_size: Int
    cache: Bytes

# a buffered bytes writer's state: its target, how much it holds before it
# flushes, and what it holds.
struct BufferedBytesWriterState:
    target: BytesWriter
    chunk_size: Int
    cache: Bytes

threadlocal mut buffered_bytes_readers: Map[Int, BufferedBytesReaderState] := {}

threadlocal mut buffered_bytes_writers: Map[Int, BufferedBytesWriterState] := {}

# a buffered text reader's state. a reader over a string, a socket, a file or
# a child's stdout or stderr differs only in its source, which is an interface
# value, so one read, read_line and read_until serve every source.
#
# `cursor` is the read cursor into `cache`: consuming moves the cursor rather
# than re-slicing the string, so taking a line out of a 4 KiB buffer does not
# copy the 4 KiB behind it. the consumed prefix is dropped in one step when the
# next chunk arrives, which keeps the cache from growing without bound.
#
# `partial` holds the bytes of a character the last fill stopped in the middle
# of, waiting for the rest of it to arrive. a source read is counted in bytes
# and ends wherever the count lands, so this holds at most three bytes and is
# empty most of the time.
struct BufferedReaderState:
    source: TextSource
    chunk_size: Int
    cache: String
    cursor: Int
    partial: Bytes

# a buffered text writer's state: its target, how much it holds before it
# flushes, and what it holds.
struct BufferedWriterState:
    target: TextTarget
    chunk_size: Int
    cache: String

threadlocal mut buffered_readers: Map[Int, BufferedReaderState] := {}

threadlocal mut buffered_writers: Map[Int, BufferedWriterState] := {}

struct StringReader:
    pub handle: Int

struct StringBuffer:
    pub handle: Int

struct BytesCursor:
    pub handle: Int

struct BufferedBytesReader:
    pub handle: Int

struct BufferedBytesWriter:
    pub handle: Int

# a buffered text reader over any TextSource.
struct BufferedReader:
    pub handle: Int

# a buffered text writer over any TextTarget.
struct BufferedWriter:
    pub handle: Int

# a view of a socket. it does not own the socket and has no destructor: std
# builds one over a handle other code owns (std.net.tls, the database drivers,
# from_fd), so whoever opened the socket closes it.
struct TcpStream:
    pub fd: Int

struct FileStream:
    pub handle: Int

# the child process a Process and its pipe views stand for. the process and
# every view share one of these, so the child is closed when the last of them
# dies: a pipe view outlives a Process that went out of scope. closing gives
# back the runtime's entry and the pipe fds. it neither waits for the child nor
# kills it: a child still running is reaped without blocking once it exits.
pub struct ProcessHandle:
    pub id: Int

# a child process started by spawn_process.
struct Process:
    pub handle: ProcessHandle

struct ProcessStdin:
    pub handle: ProcessHandle

struct ProcessStdout:
    pub handle: ProcessHandle

struct ProcessStderr:
    pub handle: ProcessHandle

impl StringReader:
    fn read(max_bytes: Int) -> String!:
        return string_reader_read(self, max_bytes)

    fn read_all() -> String!:
        return read_all(self)

    fn read_all_chunked(chunk_size: Int) -> String!:
        return read_all_chunked(self, chunk_size)

    fn buffered() -> BufferedReader:
        return buffered_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_chunked(chunk_size: Int) -> BufferedReader:
        return buffered_reader(self, chunk_size)

impl Reader for StringReader:
    fn read(max_bytes: Int) -> String!:
        return string_reader_read(self, max_bytes)

impl Closer for StringReader:
    # drop the reader's registry entries. a closed reader reads as end of
    # input; a second close is a no-op.
    fn close():
        close_string_reader_state(self.handle)

# a reader nobody closes gives its entries back when its last value dies.
impl Drop for StringReader:
    fn drop():
        self.close()

impl StringBuffer:
    fn write(data: String) -> Int!:
        return string_buffer_write(self, data)

    fn write_all(data: String) -> Int!:
        return write_all(self, data)

    fn write_line(data: String) -> Int!:
        return string_buffer_write_line(self, data)

    fn newline() -> Int!:
        return string_buffer_write(self, chr(10))

    fn string() -> String:
        return string_buffer_string(self)

    fn len() -> Int:
        return string_buffer_len(self)

    fn is_empty() -> Bool:
        return string_buffer_len(self) == 0

    fn clear():
        string_buffer_clear(self)

    fn buffered() -> BufferedWriter:
        return buffered_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_chunked(chunk_size: Int) -> BufferedWriter:
        return buffered_writer(self, chunk_size)

impl Writer for StringBuffer:
    fn write(data: String) -> Int!:
        return string_buffer_write(self, data)

impl Closer for StringBuffer:
    # free the buffer's storage and drop its registry entry, discarding the
    # accumulated text: read string() first. strings string() already
    # returned are copies and stay valid. a write or clear after close
    # leaves the buffer closed and reports nothing written; a second close
    # is a no-op.
    fn close():
        close_string_buffer_state(self.handle)

# a buffer nobody closes frees its storage when its last value dies.
impl Drop for StringBuffer:
    fn drop():
        self.close()

impl BytesCursor:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return bytes_cursor_read(self, max_bytes)

    fn read_exact_bytes(count: Int) -> Bytes!:
        return read_exact_bytes_from(self, count)

    fn read_all_bytes() -> Bytes!:
        return read_all_bytes_from(self, DEFAULT_CHUNK_SIZE)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_bytes_from(self, chunk_size)

    fn buffered() -> BufferedBytesReader:
        return buffered_bytes_reader(self, DEFAULT_CHUNK_SIZE)

    fn buffered_chunked(chunk_size: Int) -> BufferedBytesReader:
        return buffered_bytes_reader(self, chunk_size)

impl BytesReader for BytesCursor:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return bytes_cursor_read(self, max_bytes)

impl Closer for BytesCursor:
    # drop the cursor's registry entries, releasing the bytes it was built
    # over. a closed cursor reads as end of input; a second close is a no-op.
    fn close():
        close_bytes_cursor_state(self.handle)

# a cursor nobody closes gives its entries back when its last value dies.
impl Drop for BytesCursor:
    fn drop():
        self.close()

impl BytesWriter for ByteBuffer:
    fn write_bytes(data: Bytes) -> Int!:
        return self.write(data)

impl ByteBuffer:
    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_bytes_to(self, data)

    fn write_n_bytes(data: Bytes, count: Int) -> Int!:
        return write_n_bytes(self, data, count)

    fn buffered() -> BufferedBytesWriter:
        return buffered_bytes_writer(self, DEFAULT_CHUNK_SIZE)

    fn buffered_chunked(chunk_size: Int) -> BufferedBytesWriter:
        return buffered_bytes_writer(self, chunk_size)

impl BufferedBytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return buffered_bytes_reader_read(self, max_bytes)

    fn read_exact_bytes(count: Int) -> Bytes!:
        return read_exact_bytes_from(self, count)

    fn read_until_bytes(sep: Bytes) -> Bytes!:
        return buffered_bytes_reader_read_until_internal(self, sep)

    fn read_until_bytes_including(sep: Bytes) -> Bytes!:
        return buffered_bytes_reader_read_until_including_internal(self, sep)

    # like read_until_bytes_including, but fails once the accumulated bytes
    # pass `cap` before the separator arrives — so a peer that never sends
    # the separator cannot grow the buffer without bound. a `cap` of 0 or
    # less means no limit, matching the unbounded form.
    fn read_until_bytes_including_bounded(sep: Bytes, cap: Int) -> Bytes!:
        return buffered_bytes_reader_read_until_with_sep_internal(self, sep, true, cap)

    # reads through the empty line that ends an http-style head (see
    # head_end), so a head whose lines end in LF alone is found as quickly as
    # one whose lines end in CRLF. fails like read_until_bytes_including_bounded
    # once more than `cap` bytes arrive without that line, and returns what
    # arrived at end of stream.
    fn read_head_bounded(cap: Int) -> Bytes!:
        return buffered_bytes_reader_read_head_internal(self, cap)

    # how many bytes are buffered, after one read from the source when none
    # are: it waits for the first byte of whatever comes next. 0 means end of
    # stream.
    fn wait_bytes() -> Int!:
        if not buffered_bytes_readers.contains_key(self.handle):
            return 0
        state := buffered_bytes_readers[self.handle]
        cached := state.cache.len()
        if cached > 0:
            return cached
        return buffered_bytes_reader_fill(state)

    fn read_all_bytes() -> Bytes!:
        return read_all_bytes_from(self, DEFAULT_CHUNK_SIZE)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_bytes_from(self, chunk_size)

    # how many bytes this reader holds that nothing has read yet.
    fn cached_len() -> Int:
        if not buffered_bytes_readers.contains_key(self.handle):
            return 0
        return buffered_bytes_readers[self.handle].cache.len()

    fn free():
        free_buffered_bytes_reader(self)

# a reader nobody frees gives its entry back when its last value dies. the
# source is released with the entry, so a source with a destructor of its own,
# such as a file, closes then if nothing else holds it.
impl Drop for BufferedBytesReader:
    fn drop():
        self.free()

# what a buffered reader holds now, or what one read of its source brings, up to
# `max_bytes`. empty at end of input. unlike read_bytes this does not wait for
# `max_bytes` to arrive, which is what a stream of small pieces needs.
pub fn buffered_read_available(reader: BufferedBytesReader, max_bytes: Int) -> Bytes!:
    if max_bytes <= 0 or not buffered_bytes_readers.contains_key(reader.handle):
        return bytes.empty()
    state := buffered_bytes_readers[reader.handle]
    if state.cache.is_empty():
        if buffered_bytes_reader_fill(state)! <= 0:
            return bytes.empty()
    cached := state.cache
    if cached.len() <= max_bytes:
        state.cache = bytes.empty()
        return cached
    state.cache = cached.slice(max_bytes, cached.len())
    return cached.slice(0, max_bytes)

impl BytesReader for BufferedBytesReader:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return buffered_bytes_reader_read(self, max_bytes)

impl BufferedBytesWriter:
    fn write_bytes(data: Bytes) -> Int!:
        return buffered_bytes_writer_write(self, data)

    fn write_all_bytes(data: Bytes) -> Int!:
        return write_all_bytes_to(self, data)

    # write all of `data` and flush, returning the count written. the same
    # bytes reach the target as write_all_bytes then flush send, but data
    # written with nothing buffered ahead of it is not copied into the buffer.
    fn write_all_and_flush(data: Bytes) -> Int!:
        return buffered_bytes_writer_write_all_flush(self, data)

    fn flush() -> Int!:
        return buffered_bytes_writer_flush(self)

    fn free():
        free_buffered_bytes_writer(self)

# a writer nobody frees gives its entry back when its last value dies. this
# does not flush: a flush is a write that can block, and a destructor can run
# on any task at any point, so what is still buffered is dropped, as it is when
# free() runs first. flush() before letting a writer go.
impl Drop for BufferedBytesWriter:
    fn drop():
        self.free()

impl BytesWriter for BufferedBytesWriter:
    fn write_bytes(data: Bytes) -> Int!:
        return buffered_bytes_writer_write(self, data)

impl Flusher for BufferedBytesWriter:
    fn flush() -> Int!:
        return buffered_bytes_writer_flush(self)

# build an in-memory string reader from text.
pub fn string_reader(data: String) -> StringReader:
    return StringReader(allocate_string_reader_handle(data))

# build an in-memory string writer.
pub fn string_buffer() -> StringBuffer:
    return StringBuffer(allocate_string_buffer_handle())

# build an in-memory bytes reader from raw bytes.
pub fn bytes_reader(data: Bytes) -> BytesCursor:
    return BytesCursor(allocate_bytes_reader_handle(data))

# a buffered reader over any bytes source. it reads `chunk_size` bytes at a
# time, or the default chunk size when that is 0 or less.
pub fn buffered_bytes_reader(source: BytesReader, chunk_size: Int) -> BufferedBytesReader:
    handle := next_io_handle()
    buffered_bytes_readers.insert(handle, BufferedBytesReaderState(source, normalized_chunk_size(chunk_size), bytes.empty()))
    return BufferedBytesReader(handle)

# a buffered writer over any bytes target. it flushes once it holds
# `chunk_size` bytes, or the default chunk size when that is 0 or less.
pub fn buffered_bytes_writer(target: BytesWriter, chunk_size: Int) -> BufferedBytesWriter:
    handle := next_io_handle()
    buffered_bytes_writers.insert(handle, BufferedBytesWriterState(target, normalized_chunk_size(chunk_size), bytes.empty()))
    return BufferedBytesWriter(handle)

# a buffered text reader over any text source, filling `chunk_size` bytes at a
# time.
pub fn buffered_reader(source: TextSource, chunk_size: Int) -> BufferedReader:
    handle := next_io_handle()
    buffered_readers.insert(handle, BufferedReaderState(source, normalized_chunk_size(chunk_size), "", 0, bytes.empty()))
    return BufferedReader(handle)

# a buffered text writer over any text target, flushing once it holds
# `chunk_size` bytes.
pub fn buffered_writer(target: TextTarget, chunk_size: Int) -> BufferedWriter:
    handle := next_io_handle()
    buffered_writers.insert(handle, BufferedWriterState(target, normalized_chunk_size(chunk_size), ""))
    return BufferedWriter(handle)

fn decode_utf8(data: Bytes) -> String!:
    return data.to_string_utf8()!

fn encode_utf8(data: String) -> Bytes:
    return bytes.from_string_utf8(data)

fn tcp_stream_connect(host: String, port: Int) -> TcpStream!:
    return TcpStream(tcp_connect(host, port)!)

fn tcp_stream_from_fd(fd: Int) -> TcpStream:
    return TcpStream(fd)

fn tcp_stream_read(stream: TcpStream, max_bytes: Int) -> String!:
    return decode_utf8(tcp_stream_read_bytes(stream, max_bytes)!)

fn tcp_stream_read_bytes(stream: TcpStream, max_bytes: Int) -> Bytes!:
    return tcp_read_bytes(stream.fd, max_bytes)

fn tcp_stream_wait_readable(stream: TcpStream, timeout_ms: Int) -> Int:
    return tcp_wait_readable(stream.fd, timeout_ms)

fn tcp_stream_write(stream: TcpStream, data: String) -> Int!:
    return tcp_stream_write_bytes(stream, encode_utf8(data))

fn tcp_stream_write_bytes(stream: TcpStream, data: Bytes) -> Int!:
    return tcp_write_bytes(stream.fd, data)

fn tcp_stream_wait_writable(stream: TcpStream, timeout_ms: Int) -> Int:
    return tcp_wait_writable(stream.fd, timeout_ms)

fn tcp_stream_set_timeout(stream: TcpStream, ms: Int):
    tcp_set_timeout(stream.fd, ms)

fn tcp_stream_close(stream: TcpStream):
    tcp_close(stream.fd)

fn file_stream_open_read(path: String) -> FileStream!:
    return FileStream(file_open_read(path)!)

fn file_stream_open_write(path: String) -> FileStream!:
    return FileStream(file_open_write(path)!)

fn file_stream_open_append(path: String) -> FileStream!:
    return FileStream(file_open_append(path)!)

fn file_stream_read(stream: FileStream, max_bytes: Int) -> String!:
    return decode_utf8(file_stream_read_bytes(stream, max_bytes)!)

fn file_stream_read_bytes(stream: FileStream, max_bytes: Int) -> Bytes!:
    return file_read_bytes(stream.handle, max_bytes)

fn file_stream_write(stream: FileStream, data: String) -> Int!:
    return file_stream_write_bytes(stream, encode_utf8(data))

fn file_stream_write_bytes(stream: FileStream, data: Bytes) -> Int!:
    return file_write_bytes(stream.handle, data)

fn file_stream_close(stream: FileStream):
    file_close(stream.handle)

# spawn a shell command and return a process handle.
pub fn spawn_process(command: String) -> Process!:
    return Process(ProcessHandle(process_spawn(command)!))

fn process_stdin(process: Process) -> ProcessStdin:
    return ProcessStdin(process.handle)

fn process_stdout(process: Process) -> ProcessStdout:
    return ProcessStdout(process.handle)

fn process_stderr(process: Process) -> ProcessStderr:
    return ProcessStderr(process.handle)

fn process_stdin_write_bytes(writer: ProcessStdin, data: Bytes) -> Int!:
    return process_write_bytes(writer.handle.id, data)

fn process_stdout_read_bytes(reader: ProcessStdout, max_bytes: Int) -> Bytes!:
    return process_read_bytes(reader.handle.id, max_bytes)

fn process_stderr_read_bytes(reader: ProcessStderr, max_bytes: Int) -> Bytes!:
    return process_read_err_bytes(reader.handle.id, max_bytes)

fn process_stdin_write_worker(writer: ProcessStdin, data: String) -> Int!:
    return process_stdin_write(writer, data)

fn process_stdin_write_bytes_worker(writer: ProcessStdin, data: Bytes) -> Int!:
    return process_stdin_write_bytes(writer, data)

fn process_stdout_read_worker(reader: ProcessStdout, max_bytes: Int) -> String!:
    return process_stdout_read(reader, max_bytes)

fn process_stdout_read_bytes_worker(reader: ProcessStdout, max_bytes: Int) -> Bytes!:
    return process_stdout_read_bytes(reader, max_bytes)

fn process_stderr_read_worker(reader: ProcessStderr, max_bytes: Int) -> String!:
    return process_stderr_read(reader, max_bytes)

fn process_stderr_read_bytes_worker(reader: ProcessStderr, max_bytes: Int) -> Bytes!:
    return process_stderr_read_bytes(reader, max_bytes)

fn wait_process(process: Process) -> Int:
    return process_wait(process.handle.id)

fn kill_process(process: Process) -> Bool:
    return process_kill(process.handle.id)

fn close_process(process: Process):
    process.handle.close()

fn empty_string_parts() -> List[String]:
    return []

fn string_buffer_len(buf: StringBuffer) -> Int:
    if not string_buffer_stores.contains_key(buf.handle):
        return 0
    return byte_buffer_len(string_buffer_stores[buf.handle])

# the accumulated text as a fresh string: one copy of the storage, taken
# verbatim (the buffer holds whatever bytes were written, valid utf-8 or
# not, so nothing is decoded). the copy is what keeps an earlier snapshot
# unchanged when the buffer is written to, cleared or closed afterwards.
fn string_buffer_string(buf: StringBuffer) -> String:
    if not string_buffer_stores.contains_key(buf.handle):
        return ""
    return byte_buffer_string(string_buffer_stores[buf.handle])

fn string_buffer_write_line(buf: StringBuffer, data: String) -> Int!:
    wrote := string_buffer_write_internal(buf, data)
    if wrote.is_err:
        return wrote
    wrote_nl := string_buffer_write_internal(buf, chr(10))
    if wrote_nl.is_err:
        return wrote_nl
    return wrote.ok + wrote_nl.ok

fn string_buffer_reset(buf: StringBuffer):
    # see string_buffer_write_internal: clearing a closed buffer must not
    # re-register it. the storage keeps its capacity, so a buffer that is
    # cleared and refilled in a loop stops allocating after the first fill.
    if not string_buffer_stores.contains_key(buf.handle):
        return
    byte_buffer_clear(string_buffer_stores[buf.handle])

fn string_buffer_clear(buf: StringBuffer):
    string_buffer_reset(buf)

fn string_reader_read(reader: StringReader, max_bytes: Int) -> String!:
    return string_reader_read_internal(reader, max_bytes)

fn string_buffer_write(buf: StringBuffer, data: String) -> Int!:
    return string_buffer_write_internal(buf, data)

fn bytes_cursor_read(reader: BytesCursor, max_bytes: Int) -> Bytes!:
    return bytes_cursor_read_internal(reader, max_bytes)

fn buffered_bytes_reader_read(reader: BufferedBytesReader, max_bytes: Int) -> Bytes!:
    return buffered_bytes_reader_read_internal(reader, max_bytes)

fn buffered_bytes_writer_write(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    return buffered_bytes_writer_write_internal(writer, data)

fn buffered_bytes_writer_flush(writer: BufferedBytesWriter) -> Int!:
    return buffered_bytes_writer_flush_internal(writer)

# read the rest of a string reader with the default chunk size.
pub fn read_all(reader: StringReader) -> String!:
    return read_all_string(reader)

# read the rest of a string reader with an explicit chunk size.
pub fn read_all_chunked(reader: StringReader, chunk_size: Int) -> String!:
    return read_all_string_chunked(reader, chunk_size)

# keep writing until the full string is written.
pub fn write_all(writer: StringBuffer, data: String) -> Int!:
    return write_all_string(writer, data)

# copy all text from a reader into a writer.
pub fn copy(reader: StringReader, writer: StringBuffer) -> Int!:
    return copy_string(reader, writer)

# copy all text from a reader into a writer with an explicit chunk size.
pub fn copy_chunked(reader: StringReader, writer: StringBuffer, chunk_size: Int) -> Int!:
    return copy_string_chunked(reader, writer, chunk_size)

# read the rest of a bytes reader with the default chunk size.
pub fn read_all_bytes(reader: BytesCursor) -> Bytes!:
    return read_all_bytes_from(reader, DEFAULT_CHUNK_SIZE)

# read exactly count bytes or fail with unexpected eof.
pub fn read_exact_bytes(reader: BytesCursor, count: Int) -> Bytes!:
    return read_exact_bytes_from(reader, count)

# read exactly count bytes from a buffered bytes reader.
pub fn read_exact_buffered_bytes(reader: BufferedBytesReader, count: Int) -> Bytes!:
    return read_exact_bytes_from(reader, count)

# read the rest of a bytes reader with an explicit chunk size.
pub fn read_all_bytes_chunked(reader: BytesCursor, chunk_size: Int) -> Bytes!:
    return read_all_bytes_from(reader, chunk_size)

# keep writing until the full byte slice is written.
pub fn write_all_bytes(writer: ByteBuffer, data: Bytes) -> Int!:
    return write_all_bytes_to(writer, data)

# copy all bytes from a reader into a byte buffer.
pub fn copy_bytes(reader: BytesCursor, writer: ByteBuffer) -> Int!:
    return copy_bytes_cursor(reader, writer)

# copy all bytes from a reader into a byte buffer with an explicit chunk size.
pub fn copy_bytes_chunked(reader: BytesCursor, writer: ByteBuffer, chunk_size: Int) -> Int!:
    return copy_bytes_cursor_chunked(reader, writer, chunk_size)

# copy exactly count characters from a string reader into a string buffer.
pub fn copy_n(reader: StringReader, writer: StringBuffer, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut total := 0
    mut remaining := count
    while remaining > 0:
        mut take := remaining
        if take > DEFAULT_CHUNK_SIZE:
            take = DEFAULT_CHUNK_SIZE
        chunk := reader.read(take)!
        if chunk.len() == 0:
            fail "unexpected eof"
        total = total + write_all_string(writer, chunk)!
        remaining = remaining - chunk.len()
    return total

# copy exactly count bytes from a bytes reader into a byte buffer.
pub fn copy_n_bytes(reader: BytesCursor, writer: ByteBuffer, count: Int) -> Int!:
    if count <= 0:
        return 0
    data := read_exact_bytes_from(reader, count)!
    return write_all_bytes_to(writer, data)

# write at most count bytes from the input string.
#
# the count is in bytes, as every count in this module is, and it can land
# inside a multi-byte character. a character is never written in halves, so a
# count that falls inside one stops before it and the write is that much
# shorter — which is what "at most" already promised.
pub fn write_n(writer: StringBuffer, data: String, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut end := count
    if end > data.len():
        end = data.len()
    end = boundary_at_or_before(data, end, 0)
    return write_all_string(writer, data.substring(0, end))

# write at most count bytes from the input bytes.
pub fn write_n_bytes(writer: ByteBuffer, data: Bytes, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut end := count
    if end > data.len():
        end = data.len()
    return write_all_bytes_to(writer, data.slice(0, end))

# open a tcp client connection.
pub fn connect(host: String, port: Int) -> TcpStream!:
    return tcp_stream_connect(host, port)

# wrap a connection handle from std.net.tcp (or one of the tcp builtins) as a
# tcp stream. the handle names a socket pith opened; any other number is a
# stale handle, and every call on the stream fails.
pub fn from_fd(fd: Int) -> TcpStream:
    return tcp_stream_from_fd(fd)

# set how long a read on this socket may wait, in milliseconds. a read that
# reaches the deadline with nothing to show for it fails; zero or less clears
# the deadline and puts the socket back to waiting indefinitely, which is what
# a socket that was never given one does.
#
# the deadline holds on both concurrency backends. see std.net.tcp.set_timeout.
pub fn set_timeout(stream: TcpStream, ms: Int):
    tcp_stream_set_timeout(stream, ms)

# get the writable stdin handle for a spawned process.
pub fn stdin(process: Process) -> ProcessStdin:
    return process_stdin(process)

# get the readable stdout handle for a spawned process.
pub fn stdout(process: Process) -> ProcessStdout:
    return process_stdout(process)

# get the readable stderr handle for a spawned process.
pub fn stderr(process: Process) -> ProcessStderr:
    return process_stderr(process)

# wait for a process to exit and return its exit code.
pub fn wait(process: Process) -> Int:
    return wait_process(process)

# request that a process be terminated.
pub fn kill(process: Process) -> Bool:
    return kill_process(process)

# write a full string to process stdin.
pub fn write_stdin(process: Process, data: String) -> Int!:
    return write_all_process_stdin(stdin(process), data)

# write raw bytes to process stdin.
pub fn write_stdin_bytes(process: Process, data: Bytes) -> Int!:
    return write_all_bytes_to(stdin(process), data)

# read all text from process stdout.
pub fn read_stdout(process: Process) -> String!:
    return read_all_process_stdout(stdout(process))

# read all text from process stdout with an explicit chunk size.
pub fn read_stdout_chunked(process: Process, chunk_size: Int) -> String!:
    return read_all_process_stdout_chunked(stdout(process), chunk_size)

# read all bytes from process stdout.
pub fn read_stdout_bytes(process: Process) -> Bytes!:
    return read_all_bytes_from(stdout(process), DEFAULT_CHUNK_SIZE)

# read all bytes from process stdout with an explicit chunk size.
pub fn read_stdout_bytes_chunked(process: Process, chunk_size: Int) -> Bytes!:
    return read_all_bytes_from(stdout(process), chunk_size)

# read all text from process stderr.
pub fn read_stderr(process: Process) -> String!:
    return read_all_process_stderr(stderr(process))

# read all bytes from process stderr.
pub fn read_stderr_bytes(process: Process) -> Bytes!:
    return read_all_bytes_from(stderr(process), DEFAULT_CHUNK_SIZE)

# read all bytes from process stderr with an explicit chunk size.
pub fn read_stderr_bytes_chunked(process: Process, chunk_size: Int) -> Bytes!:
    return read_all_bytes_from(stderr(process), chunk_size)

# read all text from process stderr with an explicit chunk size.
pub fn read_stderr_chunked(process: Process, chunk_size: Int) -> String!:
    return read_all_process_stderr_chunked(stderr(process), chunk_size)

# read the rest of a file stream as text.
pub fn read_text(stream: FileStream) -> String!:
    return read_all_file_stream(stream)

# read the rest of a file stream as text with an explicit chunk size.
pub fn read_text_chunked(stream: FileStream, chunk_size: Int) -> String!:
    return read_all_file_stream_chunked(stream, chunk_size)

# write a full string to a file stream.
pub fn write_text(stream: FileStream, data: String) -> Int!:
    return write_all_file_stream(stream, data)

# close a file stream handle.
pub fn close_file(stream: FileStream):
    file_stream_close(stream)

fn process_stdin_write(writer: ProcessStdin, data: String) -> Int!:
    return process_stdin_write_bytes(writer, encode_utf8(data))

fn process_stdout_read(reader: ProcessStdout, max_bytes: Int) -> String!:
    return decode_utf8(process_stdout_read_bytes(reader, max_bytes)!)

fn process_stderr_read(reader: ProcessStderr, max_bytes: Int) -> String!:
    return decode_utf8(process_stderr_read_bytes(reader, max_bytes)!)

fn normalized_chunk_size(chunk_size: Int) -> Int:
    if chunk_size <= 0:
        return DEFAULT_CHUNK_SIZE
    return chunk_size

fn context_blocking_error(ctx: Context) -> BlockingError:
    if ctx.error_code() == 2:
        return blocking_deadline_exceeded()
    return blocking_cancelled()

fn context_wait_slice_ms(ctx: Context) -> Int:
    deadline := ctx.deadline_ms
    if deadline < 0:
        return 10
    remaining := deadline - time.now()
    if remaining <= 0:
        return 0
    if remaining < 10:
        return remaining
    return 10

# a plain read's or write's result in the error type the deadline-aware calls
# use, for a source or target that never blocks.
fn blocking_bytes(read: Bytes!) -> Bytes!BlockingError:
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn blocking_count(wrote: Int!) -> Int!BlockingError:
    if wrote.is_err:
        fail blocking_failed(wrote.err)
    return wrote.ok

fn tcp_stream_read_bytes_ctx(stream: TcpStream, ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
    while true:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        waited := tcp_stream_wait_readable(stream, context_wait_slice_ms(ctx))
        if waited > 0:
            chunk := tcp_stream_read_bytes(stream, max_bytes)
            if chunk.is_err:
                fail blocking_failed(chunk.err)
            return chunk.ok
        if waited < 0:
            fail blocking_failed("tcp read wait failed")

fn tcp_stream_read_ctx(stream: TcpStream, ctx: Context, max_bytes: Int) -> String!BlockingError:
    bytes_result := tcp_stream_read_bytes_ctx(stream, ctx, max_bytes)
    if bytes_result.is_err:
        fail bytes_result.err
    text := decode_utf8(bytes_result.ok)
    if text.is_err:
        fail blocking_failed(text.err)
    return text.ok

fn tcp_stream_write_bytes_ctx(stream: TcpStream, ctx: Context, data: Bytes) -> Int!BlockingError:
    while true:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        waited := tcp_stream_wait_writable(stream, context_wait_slice_ms(ctx))
        if waited > 0:
            wrote := tcp_stream_write_bytes(stream, data)
            if wrote.is_err:
                fail blocking_failed(wrote.err)
            return wrote.ok
        if waited < 0:
            fail blocking_failed("tcp write wait failed")

fn tcp_stream_write_ctx(stream: TcpStream, ctx: Context, data: String) -> Int!BlockingError:
    return tcp_stream_write_bytes_ctx(stream, ctx, encode_utf8(data))

fn allocate_string_reader_handle(data: String) -> Int:
    handle := next_io_handle()
    string_reader_data.insert(handle, data)
    string_reader_offsets.insert(handle, 0)
    return handle

fn allocate_string_buffer_handle() -> Int:
    handle := next_io_handle()
    string_buffer_stores.insert(handle, byte_buffer_new())
    return handle

fn allocate_bytes_reader_handle(data: Bytes) -> Int:
    handle := next_io_handle()
    bytes_reader_data.insert(handle, data)
    bytes_reader_offsets.insert(handle, 0)
    return handle

## drop a buffered reader's registry entries. a long-running process
## must free readers when the stream is done, or every request's
## buffers stay reachable forever.
pub fn free_buffered_bytes_reader(reader: BufferedBytesReader):
    buffered_bytes_readers.remove(reader.handle)

## drop a buffered writer's registry entries; the counterpart of
## free_buffered_bytes_reader for the write side.
pub fn free_buffered_bytes_writer(writer: BufferedBytesWriter):
    buffered_bytes_writers.remove(writer.handle)

# --- deregistration ---------------------------------------------------------
#
# every reader, buffer and cursor above is a handle into threadlocal maps, and
# a handle is never reissued, so an entry that is not removed lives for the
# rest of the thread. close() on each type removes its entries; a second close
# finds nothing and is a no-op. closing a buffered reader or writer releases
# its registry state only — the stream, buffer or process underneath is closed
# by whoever built it.

fn close_string_reader_state(handle: Int):
    string_reader_data.remove(handle)
    string_reader_offsets.remove(handle)

fn close_string_buffer_state(handle: Int):
    if not string_buffer_stores.contains_key(handle):
        return
    byte_buffer_free(string_buffer_stores[handle])
    string_buffer_stores.remove(handle)

fn close_bytes_cursor_state(handle: Int):
    bytes_reader_data.remove(handle)
    bytes_reader_offsets.remove(handle)

fn remaining_after_write(data: String, wrote: Int) -> String:
    if wrote >= data.len():
        return ""
    return data.substring(wrote, data.len())

# drop the CR of a CRLF line ending.
#
# the test reads the last byte rather than slicing it off: a String is indexed
# in bytes, and `substring(len - 1, len)` on a line ending in any non-ascii
# character asks for the tail of a multi-byte character, which is a hard error.
# a line ending in "é" is ordinary text, so it must not stop the process.
fn trim_trailing_cr(line: String) -> String:
    if line.len() == 0:
        return ""
    end := line.len()
    if ord(line[end - 1]) == 13:
        return line.substring(0, end - 1)
    return line

# --- character boundaries ---------------------------------------------------
#
# every read and every write here is counted in bytes, and a String is indexed
# in bytes, so the byte a transfer stops at is whatever byte the count landed
# on — which can be inside a multi-byte character. slicing a String there is a
# runtime trap that no catch can intercept, so nothing below stops at a byte
# count without first moving to the character boundary beside it.
#
# the walk is over raw bytes and needs no unicode tables: in utf-8 a byte in
# 0x80..0xBF continues a character and every other byte starts one, so the
# boundary next to any offset is at most three bytes away.

# true when the byte at `at` continues a character rather than starting one.
fn continues_character(data: String, at: Int) -> Bool:
    code := ord(data[at])
    return code >= 128 and code < 192

# the character boundary at or before `at`, and never before `floor`.
#
# `at` may be `data.len()`, which is a boundary and is not read.
fn boundary_at_or_before(data: String, at: Int, floor: Int) -> Int:
    mut back := at
    while back > floor and back < data.len() and continues_character(data, back):
        back = back - 1
    return back

# the character boundary at or after `at`.
fn boundary_at_or_after(data: String, at: Int) -> Int:
    mut ahead := at
    while ahead < data.len() and continues_character(data, ahead):
        ahead = ahead + 1
    return ahead

# where a read that asked to stop at byte `at` stops instead.
#
# the boundary before `at` keeps the read inside what was asked for. when that
# boundary is the read's own start the read would come back empty, and an empty
# read is how every caller here recognises end of stream, so a read that would
# make no progress takes the whole character instead of none of it.
fn read_stop(data: String, start: Int, at: Int) -> Int:
    stop := boundary_at_or_before(data, at, start)
    if stop > start:
        return stop
    return boundary_at_or_after(data, at)

# byte offset of the first newline at or after `start`, or -1.
#
# `ord(data[i])` reads the byte in place. comparing `data[i]` against a
# one-character string instead would allocate a fresh string per byte scanned,
# which on a 4 KiB buffer is 4096 allocations to find one newline.
fn find_newline_from(data: String, start: Int) -> Int:
    mut i := start
    while i < data.len():
        if ord(data[i]) == 10:
            return i
        i = i + 1
    return 0 - 1

# byte offset of the first occurrence of `sep` at or after `start`, or -1.
#
# `index_of` searches a String from the beginning, so scanning a buffer from a
# cursor with it would need the tail sliced out first — the copy the cursor
# exists to avoid.
fn find_sep_from(data: String, sep: String, start: Int) -> Int:
    if sep.len() == 0:
        return 0 - 1
    first := ord(sep[0])
    mut i := start
    limit := data.len() - sep.len()
    while i <= limit:
        if ord(data[i]) == first:
            mut j := 1
            while j < sep.len():
                if ord(data[i + j]) != ord(sep[j]):
                    break
                j = j + 1
            if j == sep.len():
                return i
        i = i + 1
    return 0 - 1

fn find_bytes_sep(data: Bytes, sep: Bytes) -> Int:
    return bytes.index_of(data, sep)

# drain a source to end-of-stream.
#
# the bytes are gathered and decoded once at the end. decoding each chunk as it
# arrived would reject the whole read whenever a chunk boundary fell inside a
# character, which is an ordinary thing for a 4 KiB read of ordinary text to do:
# a utf-8 file with one accent in it was unreadable through this path whenever
# the accent straddled the boundary. a character split across two chunks is not
# a decode error, it is two chunks.
fn read_all_text_source[S: TextSource](source: S, chunk_size: Int) -> String!:
    return drain_text_source(source, normalized_chunk_size(chunk_size))!.to_string_utf8()!

# the bytes of a source up to end-of-stream. the buffer has no destructor, so
# it is taken on success and freed on a failed read.
fn drain_text_source[S: TextSource](source: S, size: Int) -> Bytes!:
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := source.read_chunk(size)!
    while not chunk.is_empty():
        buf.write(chunk)!
        chunk = source.read_chunk(size)!
    return buf.take_bytes()

# the deadline-aware twin of `read_all_text_source`.
fn read_all_text_source_ctx[S: TextSource](source: S, ctx: Context, chunk_size: Int) -> String!BlockingError:
    drained := drain_text_source_ctx(source, ctx, normalized_chunk_size(chunk_size))!
    decoded := drained.to_string_utf8()
    if decoded.is_err:
        fail blocking_failed(decoded.err)
    return decoded.ok

# the deadline-aware twin of `drain_text_source`.
fn drain_text_source_ctx[S: TextSource](source: S, ctx: Context, size: Int) -> Bytes!BlockingError:
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := source.read_chunk_ctx(ctx, size)!
    while not chunk.is_empty():
        written := buf.write(chunk)
        if written.is_err:
            fail blocking_failed(written.err)
        chunk = source.read_chunk_ctx(ctx, size)!
    return buf.take_bytes()

fn read_all_string(reader: StringReader) -> String!:
    return read_all_string_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_string_chunked(reader: StringReader, chunk_size: Int) -> String!:
    return read_all_text_source(reader, chunk_size)

fn write_all_string(writer: StringBuffer, data: String) -> Int!:
    mut total := 0
    mut remaining := data
    while remaining.len() > 0:
        wrote := writer.write(remaining)!
        if wrote <= 0:
            fail "write returned 0"
        total = total + wrote
        remaining = remaining_after_write(remaining, wrote)
    return total

# the text write_all loops all resume through their bytes counterpart rather
# than re-slicing the String. a write stops at whatever byte offset the send
# buffer or the pipe ran out at, and that offset can be in the middle of a
# multi-byte character — which a String cannot be cut at, so resuming as text
# would stop the process on the first non-ascii payload big enough to be split.
fn write_all_tcp_stream(writer: TcpStream, data: String) -> Int!:
    return write_all_bytes_to(writer, encode_utf8(data))

fn write_all_tcp_stream_ctx(writer: TcpStream, ctx: Context, data: String) -> Int!BlockingError:
    return write_all_tcp_stream_bytes_ctx(writer, ctx, encode_utf8(data))

fn write_all_file_stream(writer: FileStream, data: String) -> Int!:
    return write_all_bytes_to(writer, encode_utf8(data))

fn copy_string(reader: StringReader, writer: StringBuffer) -> Int!:
    return copy_string_chunked(reader, writer, DEFAULT_CHUNK_SIZE)

fn copy_string_chunked(reader: StringReader, writer: StringBuffer, chunk_size: Int) -> Int!:
    size := normalized_chunk_size(chunk_size)
    mut total := 0
    mut chunk := reader.read(size)!
    while chunk.len() > 0:
        total = total + write_all_string(writer, chunk)!
        chunk = reader.read(size)!
    return total

fn read_all_tcp_stream(stream: TcpStream) -> String!:
    return read_all_tcp_stream_chunked(stream, DEFAULT_CHUNK_SIZE)

fn read_all_tcp_stream_chunked(stream: TcpStream, chunk_size: Int) -> String!:
    return read_all_text_source(stream, chunk_size)

fn read_all_tcp_stream_ctx(stream: TcpStream, ctx: Context) -> String!BlockingError:
    return read_all_tcp_stream_chunked_ctx(stream, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_tcp_stream_chunked_ctx(stream: TcpStream, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(stream, ctx, chunk_size)

fn read_all_file_stream(stream: FileStream) -> String!:
    return read_all_file_stream_chunked(stream, DEFAULT_CHUNK_SIZE)

fn read_all_file_stream_chunked(stream: FileStream, chunk_size: Int) -> String!:
    return read_all_text_source(stream, chunk_size)

# read a whole file as text.
#
# one call, not a stream: the whole file is coming into memory either way, and
# under the green backend every open and every chunk read is a separate handoff
# to the runtime's file thread pool. use the chunked variant when the file is
# big enough that reading it in pieces is the point.
#
# fails on a file that is not valid utf-8, the same as `fs.read`. reading bytes
# that are not text is what `read_file_bytes` is for.
pub fn read_file_text(path: String) -> String!:
    return read_file(path)

# read a whole file as text with an explicit chunk size.
pub fn read_file_text_chunked(path: String, chunk_size: Int) -> String!:
    stream := file_stream_open_read(path)!
    defer stream.close()
    return read_all_file_stream_chunked(stream, chunk_size)

# write text to a file, replacing existing contents. returns the bytes written.
#
# one call for the same reason `read_file_text` is one call. the write either
# lands whole or fails, so on success the count is the length of what was
# handed in.
pub fn write_file_text(path: String, data: String) -> Int!:
    write_file(path, data)!
    return data.len()

# write text to a file with an explicit chunk size.
pub fn write_file_text_chunked(path: String, data: String, chunk_size: Int) -> Int!:
    stream := file_stream_open_write(path)!
    defer stream.close()
    writer := stream.buffered_writer_chunked(chunk_size)
    # `write` already counts everything it accepted, whether it went to the file
    # or into the buffer. flush moves the buffered part along and reports it a
    # second time, so adding the two counts a small payload twice — the flush is
    # here to write and to surface its error, not for its number.
    total := writer.write(data)!
    writer.flush()!
    return total

# append text to a file. returns the bytes written.
pub fn append_file_text(path: String, data: String) -> Int!:
    append_file(path, data)!
    return data.len()

# append text to a file with an explicit chunk size.
pub fn append_file_text_chunked(path: String, data: String, chunk_size: Int) -> Int!:
    stream := file_stream_open_append(path)!
    defer stream.close()
    writer := stream.buffered_writer_chunked(chunk_size)
    # see `write_file_text_chunked`: the flush is for its effect, not its count.
    total := writer.write(data)!
    writer.flush()!
    return total

fn write_all_process_stdin(writer: ProcessStdin, data: String) -> Int!:
    return write_all_bytes_to(writer, encode_utf8(data))

fn read_all_process_stdout(reader: ProcessStdout) -> String!:
    return read_all_process_stdout_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_process_stdout_chunked(reader: ProcessStdout, chunk_size: Int) -> String!:
    return read_all_text_source(reader, chunk_size)

fn read_all_process_stderr(reader: ProcessStderr) -> String!:
    return read_all_process_stderr_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_process_stderr_chunked(reader: ProcessStderr, chunk_size: Int) -> String!:
    return read_all_text_source(reader, chunk_size)

fn process_stdin_write_ctx(writer: ProcessStdin, ctx: Context, data: String) -> Int!BlockingError:
    task := spawn process_stdin_write_worker(writer, data)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    wrote := await task
    if wrote.is_err:
        fail blocking_failed(wrote.err)
    return wrote.ok

fn write_all_process_stdin_ctx(writer: ProcessStdin, ctx: Context, data: String) -> Int!BlockingError:
    return write_all_process_stdin_bytes_ctx(writer, ctx, encode_utf8(data))

fn process_stdout_read_ctx(reader: ProcessStdout, ctx: Context, max_bytes: Int) -> String!BlockingError:
    task := spawn process_stdout_read_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stdout_ctx(reader: ProcessStdout, ctx: Context) -> String!BlockingError:
    return read_all_process_stdout_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stdout_chunked_ctx(reader: ProcessStdout, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(reader, ctx, chunk_size)

fn process_stderr_read_ctx(reader: ProcessStderr, ctx: Context, max_bytes: Int) -> String!BlockingError:
    task := spawn process_stderr_read_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stderr_ctx(reader: ProcessStderr, ctx: Context) -> String!BlockingError:
    return read_all_process_stderr_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stderr_chunked_ctx(reader: ProcessStderr, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(reader, ctx, chunk_size)

fn string_reader_read_internal(reader: StringReader, max_bytes: Int) -> String!:
    if max_bytes <= 0:
        return ""
    if not string_reader_data.contains_key(reader.handle):
        return ""

    data := string_reader_data[reader.handle]
    mut offset := 0
    if string_reader_offsets.contains_key(reader.handle):
        offset = string_reader_offsets[reader.handle]
    if offset >= data.len():
        return ""

    mut end := offset + max_bytes
    if end > data.len():
        end = data.len()
    # the count can land inside a character; the read stops beside it. this is
    # the one text source that slices rather than decoding, so it is the one
    # that has to do this for itself — the others come back as bytes and are
    # decoded a whole character at a time.
    end = read_stop(data, offset, end)
    chunk := data.substring(offset, end)
    string_reader_offsets.insert(reader.handle, end)
    return chunk

fn string_buffer_write_internal(buf: StringBuffer, data: String) -> Int!:
    # a closed buffer stays closed: writing must not re-create the registry
    # entry close() removed, so it reports nothing written instead.
    if not string_buffer_stores.contains_key(buf.handle):
        return 0
    # the bytes go straight into the storage; nothing is allocated for the
    # write itself, and the builtin answers with the count it appended.
    return byte_buffer_write_string_utf8(string_buffer_stores[buf.handle], data)

fn bytes_after_write(data: Bytes, wrote: Int) -> Bytes:
    if wrote >= data.len():
        return bytes.empty()
    return data.slice(wrote, data.len())

fn bytes_cursor_read_internal(reader: BytesCursor, max_bytes: Int) -> Bytes!:
    if max_bytes <= 0:
        return bytes.empty()
    if not bytes_reader_data.contains_key(reader.handle):
        return bytes.empty()

    data := bytes_reader_data[reader.handle]
    mut offset := 0
    if bytes_reader_offsets.contains_key(reader.handle):
        offset = bytes_reader_offsets[reader.handle]
    if offset >= data.len():
        return bytes.empty()

    mut end := offset + max_bytes
    if end > data.len():
        end = data.len()
    chunk := data.slice(offset, end)
    bytes_reader_offsets.insert(reader.handle, end)
    return chunk

# write all of `data`, calling `write_bytes` until it has taken every byte.
fn write_all_bytes_to[W: BytesWriter](writer: W, data: Bytes) -> Int!:
    mut total := 0
    mut remaining := data
    while not remaining.is_empty():
        wrote := writer.write_bytes(remaining)!
        if wrote <= 0:
            fail "write returned 0"
        total = total + wrote
        remaining = bytes_after_write(remaining, wrote)
    return total

# the rest of a bytes source, read `chunk_size` bytes at a time. the buffer
# has no destructor, so it is taken on success and freed on a failed read.
fn read_all_bytes_from[R: BytesReader](reader: R, chunk_size: Int) -> Bytes!:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := reader.read_bytes(size)!
    while not chunk.is_empty():
        buf.write(chunk)!
        chunk = reader.read_bytes(size)!
    return buf.take_bytes()

# exactly `count` bytes from a source, failing with unexpected eof when it
# ends first.
fn read_exact_bytes_from[R: BytesReader](reader: R, count: Int) -> Bytes!:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    errdefer buf.free()
    while buf.len() < count:
        chunk := reader.read_bytes(count - buf.len())!
        if chunk.is_empty():
            fail "unexpected eof"
        buf.write(chunk)!
    return buf.take_bytes()

fn copy_bytes_cursor(reader: BytesCursor, writer: ByteBuffer) -> Int!:
    return copy_bytes_cursor_chunked(reader, writer, DEFAULT_CHUNK_SIZE)

fn copy_bytes_cursor_chunked(reader: BytesCursor, writer: ByteBuffer, chunk_size: Int) -> Int!:
    size := normalized_chunk_size(chunk_size)
    mut total := 0
    mut chunk := reader.read_bytes(size)!
    while not chunk.is_empty():
        total = total + writer.write_bytes(chunk)!
        chunk = reader.read_bytes(size)!
    return total

fn read_all_tcp_stream_bytes_ctx(stream: TcpStream, ctx: Context) -> Bytes!BlockingError:
    return read_all_tcp_stream_bytes_chunked_ctx(stream, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_tcp_stream_bytes_chunked_ctx(stream: TcpStream, ctx: Context, chunk_size: Int) -> Bytes!BlockingError:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := tcp_stream_read_bytes_ctx(stream, ctx, size)!
    while not chunk.is_empty():
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
        chunk = tcp_stream_read_bytes_ctx(stream, ctx, size)!
    return buf.take_bytes()

fn write_all_tcp_stream_bytes_ctx(stream: TcpStream, ctx: Context, data: Bytes) -> Int!BlockingError:
    mut total := 0
    mut remaining := data
    while not remaining.is_empty():
        wrote := tcp_stream_write_bytes_ctx(stream, ctx, remaining)!
        if wrote <= 0:
            fail blocking_failed("write returned 0")
        total = total + wrote
        remaining = bytes_after_write(remaining, wrote)
    return total

fn process_stdin_write_bytes_ctx(writer: ProcessStdin, ctx: Context, data: Bytes) -> Int!BlockingError:
    task := spawn process_stdin_write_bytes_worker(writer, data)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    wrote := await task
    if wrote.is_err:
        fail blocking_failed(wrote.err)
    return wrote.ok

fn write_all_process_stdin_bytes_ctx(writer: ProcessStdin, ctx: Context, data: Bytes) -> Int!BlockingError:
    mut total := 0
    mut remaining := data
    while not remaining.is_empty():
        wrote := process_stdin_write_bytes_ctx(writer, ctx, remaining)!
        if wrote <= 0:
            fail blocking_failed("write returned 0")
        total = total + wrote
        remaining = bytes_after_write(remaining, wrote)
    return total

fn process_stdout_read_bytes_ctx(reader: ProcessStdout, ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
    task := spawn process_stdout_read_bytes_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stdout_bytes_ctx(reader: ProcessStdout, ctx: Context) -> Bytes!BlockingError:
    return read_all_process_stdout_bytes_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stdout_bytes_chunked_ctx(reader: ProcessStdout, ctx: Context, chunk_size: Int) -> Bytes!BlockingError:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := process_stdout_read_bytes_ctx(reader, ctx, size)!
    while not chunk.is_empty():
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
        chunk = process_stdout_read_bytes_ctx(reader, ctx, size)!
    return buf.take_bytes()

fn process_stderr_read_bytes_ctx(reader: ProcessStderr, ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
    task := spawn process_stderr_read_bytes_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stderr_bytes_ctx(reader: ProcessStderr, ctx: Context) -> Bytes!BlockingError:
    return read_all_process_stderr_bytes_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stderr_bytes_chunked_ctx(reader: ProcessStderr, ctx: Context, chunk_size: Int) -> Bytes!BlockingError:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    errdefer buf.free()
    mut chunk := process_stderr_read_bytes_ctx(reader, ctx, size)!
    while not chunk.is_empty():
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
        chunk = process_stderr_read_bytes_ctx(reader, ctx, size)!
    return buf.take_bytes()

fn read_exact_tcp_stream_bytes_ctx(stream: TcpStream, ctx: Context, count: Int) -> Bytes!BlockingError:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    errdefer buf.free()
    while buf.len() < count:
        chunk := tcp_stream_read_bytes_ctx(stream, ctx, count - buf.len())!
        if chunk.is_empty():
            fail blocking_failed("unexpected eof")
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
    return buf.take_bytes()

fn read_exact_process_stdout_bytes_ctx(reader: ProcessStdout, ctx: Context, count: Int) -> Bytes!BlockingError:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    errdefer buf.free()
    while buf.len() < count:
        chunk := process_stdout_read_bytes_ctx(reader, ctx, count - buf.len())!
        if chunk.is_empty():
            fail blocking_failed("unexpected eof")
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
    return buf.take_bytes()

fn read_exact_process_stderr_bytes_ctx(reader: ProcessStderr, ctx: Context, count: Int) -> Bytes!BlockingError:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    errdefer buf.free()
    while buf.len() < count:
        chunk := process_stderr_read_bytes_ctx(reader, ctx, count - buf.len())!
        if chunk.is_empty():
            fail blocking_failed("unexpected eof")
        wrote := buf.write(chunk)
        if wrote.is_err:
            fail blocking_failed(wrote.err)
    return buf.take_bytes()

fn buffered_bytes_reader_read_internal(reader: BufferedBytesReader, max_bytes: Int) -> Bytes!:
    if max_bytes <= 0:
        return bytes.empty()
    if not buffered_bytes_readers.contains_key(reader.handle):
        return bytes.empty()
    state := buffered_bytes_readers[reader.handle]

    buf := bytes.buffer_with_capacity(max_bytes)
    errdefer buf.free()
    while buf.len() < max_bytes:
        if state.cache.is_empty():
            filled := buffered_bytes_reader_fill(state)!
            if filled <= 0:
                return buf.take_bytes()
        cached := state.cache
        mut take := max_bytes - buf.len()
        if take > cached.len():
            take = cached.len()
        buf.write(cached.slice(0, take))!
        buffered_bytes_reader_consume(state, take)
    return buf.take_bytes()

fn buffered_bytes_reader_read_until_internal(reader: BufferedBytesReader, sep: Bytes) -> Bytes!:
    return buffered_bytes_reader_read_until_with_sep_internal(reader, sep, false, 0)

fn buffered_bytes_reader_read_until_including_internal(reader: BufferedBytesReader, sep: Bytes) -> Bytes!:
    return buffered_bytes_reader_read_until_with_sep_internal(reader, sep, true, 0)

# the failure a bounded read_until reports once the accumulated bytes pass
# its cap without the separator arriving. a caller that bounds a protocol
# element this way (an http request head) tests for it with
# is_read_until_limit_error to answer with the protocol's own limit error,
# and lets any other failure — a dropped socket, a deadline — through.
READ_UNTIL_LIMIT_PREFIX := "read_until exceeded "

## true when `message` is the failure a bounded read_until reports once
## the accumulated bytes pass its cap without the separator arriving.
pub fn is_read_until_limit_error(message: String) -> Bool:
    return message.starts_with(READ_UNTIL_LIMIT_PREFIX)

# `cap` bounds the bytes accumulated before the separator is found: a
# positive value fails a peer that floods without ever sending it, 0 or
# less leaves the read unbounded (what the two wrappers above pass).
fn buffered_bytes_reader_read_until_with_sep_internal(reader: BufferedBytesReader, sep: Bytes, include_sep: Bool, cap: Int) -> Bytes!:
    if sep.is_empty():
        fail "empty separator"
    if not buffered_bytes_readers.contains_key(reader.handle):
        return bytes.empty()
    state := buffered_bytes_readers[reader.handle]

    buf := bytes.buffer()
    # the buffer is a handle with no destructor: the cap failure below and
    # a failed fill both have to give it back by hand
    errdefer buf.free()
    while true:
        if cap > 0 and buf.len() > cap:
            fail READ_UNTIL_LIMIT_PREFIX + "{cap} bytes without the separator"
        cached := state.cache
        sep_pos := find_bytes_sep(cached, sep)
        if sep_pos >= 0:
            if sep_pos > 0:
                buf.write(cached.slice(0, sep_pos))!
            if include_sep:
                buf.write(sep)!
            buffered_bytes_reader_consume(state, sep_pos + sep.len())
            return buf.take_bytes()
        keep := sep.len() - 1
        if cached.len() > keep:
            flush_len := cached.len() - keep
            buf.write(cached.slice(0, flush_len))!
            buffered_bytes_reader_consume(state, flush_len)
        filled := buffered_bytes_reader_fill(state)!
        if filled <= 0:
            buffered_bytes_reader_drain_into(state, buf)!
            return buf.take_bytes()
    return buf.take_bytes()

## the offset just past the empty line that ends an http-style head in
## `data`, or -1 when it holds no complete head yet. a line ends in LF or in
## CRLF, so the head ends at the first LF that another LF or a CRLF follows.
## the scan starts at `start`, which lets a caller skip bytes it has already
## searched.
pub fn head_end(data: Bytes, start: Int) -> Int:
    n := data.len()
    mut i := start
    while i + 1 < n:
        if data[i] == 10:
            next := data[i + 1]
            if next == 10:
                return i + 2
            if next == 13 and i + 2 < n and data[i + 2] == 10:
                return i + 3
        i = i + 1
    return 0 - 1

# the end of a head can start up to two bytes before the end of what has
# arrived (an LF, then the CR of a CRLF), so those bytes stay cached for the
# next scan.
HEAD_END_OVERLAP := 2

fn buffered_bytes_reader_read_head_internal(reader: BufferedBytesReader, cap: Int) -> Bytes!:
    if not buffered_bytes_readers.contains_key(reader.handle):
        return bytes.empty()
    state := buffered_bytes_readers[reader.handle]
    # the common case: the whole head is already cached, so it comes back as
    # one slice with no staging buffer
    mut cached := state.cache
    mut end := head_end(cached, 0)
    if end >= 0:
        buffered_bytes_reader_consume(state, end)
        return cached.slice(0, end)
    buf := bytes.buffer()
    # as in the read_until loop, the buffer has no destructor
    errdefer buf.free()
    while true:
        if cached.len() > HEAD_END_OVERLAP:
            flush_len := cached.len() - HEAD_END_OVERLAP
            buf.write(cached.slice(0, flush_len))!
            buffered_bytes_reader_consume(state, flush_len)
        if cap > 0 and buf.len() > cap:
            fail READ_UNTIL_LIMIT_PREFIX + "{cap} bytes without the separator"
        filled := buffered_bytes_reader_fill(state)!
        if filled <= 0:
            buffered_bytes_reader_drain_into(state, buf)!
            return buf.take_bytes()
        cached = state.cache
        end = head_end(cached, 0)
        if end >= 0:
            buf.write(cached.slice(0, end))!
            buffered_bytes_reader_consume(state, end)
            return buf.take_bytes()
    return buf.take_bytes()

# read one chunk from the reader's source onto what it has cached, returning
# the count read; 0 at end of stream.
fn buffered_bytes_reader_fill(state: BufferedBytesReaderState) -> Int!:
    chunk := state.source.read_bytes(state.chunk_size)!
    state.cache = state.cache.concat(chunk)
    return chunk.len()

# drop the first `consumed` cached bytes of a reader.
fn buffered_bytes_reader_consume(state: BufferedBytesReaderState, consumed: Int):
    state.cache = state.cache.slice(consumed, state.cache.len())

# move whatever a reader has cached to `buf`, at end of stream.
fn buffered_bytes_reader_drain_into(state: BufferedBytesReaderState, buf: ByteBuffer) -> Int!:
    cached := state.cache
    state.cache = bytes.empty()
    if not cached.is_empty():
        buf.write(cached)!
    return cached.len()

fn buffered_bytes_writer_write_internal(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    if not buffered_bytes_writers.contains_key(writer.handle):
        return 0
    state := buffered_bytes_writers[writer.handle]

    state.cache = state.cache.concat(data)
    if state.cache.len() >= state.chunk_size:
        buffered_bytes_writer_flush_state(state)!
    return data.len()

fn buffered_bytes_writer_flush_internal(writer: BufferedBytesWriter) -> Int!:
    if not buffered_bytes_writers.contains_key(writer.handle):
        return 0
    return buffered_bytes_writer_flush_state(buffered_bytes_writers[writer.handle])

# send what a writer holds to its target. the held bytes are let go of
# before the write, so a failed write does not leave them to go out again.
fn buffered_bytes_writer_flush_state(state: BufferedBytesWriterState) -> Int!:
    cached := state.cache
    if cached.is_empty():
        return 0
    state.cache = bytes.empty()
    return write_all_bytes_to(state.target, cached)!

# write_all_bytes followed by flush. with nothing buffered, the data goes
# straight to the target instead of being copied into the buffer first.
fn buffered_bytes_writer_write_all_flush(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    if buffered_bytes_writers.contains_key(writer.handle) and not data.is_empty():
        state := buffered_bytes_writers[writer.handle]
        if state.cache.is_empty():
            return write_all_bytes_to(state.target, data)!
    written := write_all_bytes_to(writer, data)!
    buffered_bytes_writer_flush_internal(writer)!
    return written

# ---------------------------------------------------------------------------
# buffered text readers and writers
#
# one implementation of read, read_line and read_until serves every text
# source: a fill reads the next chunk through the source's interface value,
# and nothing else depends on what the source is. the same holds for the
# writer and its target.
#
# two things keep the cost linear in the bytes read. the result is collected as
# a list of pieces and joined once, because appending to a String rebuilds the
# whole String each time. and the buffer carries a read cursor, so consuming a
# line out of it moves an integer instead of re-slicing the bytes behind it.
# without that, reading a 4 KiB buffer one byte at a time copies it 4096 times.

# concatenate what a read gathered.
#
# a read that came out of the buffer in one piece is the common case, and it
# gets its own answer back rather than a copy of it.
fn join_parts(parts: List[String]) -> String:
    if parts.len() == 0:
        return ""
    if parts.len() == 1:
        return parts[0]
    return parts.join("")

fn buffered_reader_clear(state: BufferedReaderState):
    state.cache = ""
    state.cursor = 0

# add a freshly read chunk, dropping whatever the cursor has already passed.
#
# this is the only place the buffer is rebuilt, and what sits in front of the
# cursor here is bounded: a read leaves nothing behind, and a read_until holds
# back at most one byte less than its separator. so the copy is bounded by the
# chunk size, not by how much has been read through the reader over its life.
fn buffered_reader_append(state: BufferedReaderState, chunk: String):
    data := state.cache
    if state.cursor >= data.len():
        state.cache = chunk
    else:
        state.cache = data.substring(state.cursor, data.len()) + chunk
    state.cursor = 0

# how many bytes the character starting with `lead` occupies.
fn character_width(lead: Int) -> Int:
    if lead >= 240:
        return 4
    if lead >= 224:
        return 3
    return 2

# the length of the longest prefix of `data` that ends on a character boundary
# with no truncated character behind it.
#
# only the last three bytes can be in question: a utf-8 character is four bytes
# at most, so the start of the last character is never further back than that.
# malformed input is left alone and reported by the decode, which is the one
# place that can tell the difference between a chunk that is short and a stream
# that is not text.
fn complete_character_prefix(data: Bytes) -> Int:
    if data.is_empty():
        return 0
    mut lead := data.len() - 1
    mut steps := 0
    while lead > 0 and steps < 3 and continues_a_character(bytes.get(data, lead)):
        lead = lead - 1
        steps = steps + 1
    first := bytes.get(data, lead)
    if first < 192:
        return data.len()
    if data.len() - lead >= character_width(first):
        return data.len()
    return lead

# true when a byte continues a character rather than starting one.
fn continues_a_character(code: Int) -> Bool:
    return code >= 128 and code < 192

# decode as much of `arrived` as ends on a character boundary, holding the rest
# back for the next fill.
#
# a source read stops at a byte count, so the last character in a chunk can be
# missing its tail. decoding the chunk as it stands would call that a decode
# error and lose the whole read, which is what a buffered reader over a utf-8
# file used to do whenever an accented character straddled a 4 KiB boundary.
fn buffered_text_decode(state: BufferedReaderState, arrived: Bytes) -> String!:
    held := state.partial
    mut data := arrived
    if not held.is_empty():
        data = bytes.concat(held, arrived)
    cut := complete_character_prefix(data)
    if cut >= data.len():
        state.partial = bytes.empty()
        return data.to_string_utf8()!
    state.partial = data.slice(cut, data.len())
    return data.slice(0, cut).to_string_utf8()!

# read the next chunk from the source onto the buffer, returning how many bytes
# of text it added; 0 at end of stream.
fn buffered_text_fill(state: BufferedReaderState) -> Int!:
    # a read whose bytes were all the front of one character adds no text, and
    # an empty fill is how every caller here recognises end of stream, so keep
    # reading until there is a whole character to hand over, or the stream ends.
    while true:
        arrived := state.source.read_chunk(state.chunk_size)!
        if arrived.is_empty():
            if not state.partial.is_empty():
                fail "stream ended in the middle of a character"
            return 0
        chunk := buffered_text_decode(state, arrived)!
        if chunk.len() > 0:
            buffered_reader_append(state, chunk)
            return chunk.len()
    return 0

# the deadline-aware twin of `buffered_text_fill`. this is the only place a
# context reaches, and it has to: waiting for a chunk is the one part of a
# buffered read that can block, so the deadline is checked around the source
# read rather than around the buffering.
fn buffered_text_fill_ctx(state: BufferedReaderState, ctx: Context) -> Int!BlockingError:
    while true:
        arrived := state.source.read_chunk_ctx(ctx, state.chunk_size)!
        if arrived.is_empty():
            if not state.partial.is_empty():
                fail blocking_failed("stream ended in the middle of a character")
            return 0
        chunk := buffered_text_decode(state, arrived)
        if chunk.is_err:
            fail blocking_failed(chunk.err)
        if chunk.ok.len() > 0:
            buffered_reader_append(state, chunk.ok)
            return chunk.ok.len()
    return 0

fn buffered_text_read(reader: BufferedReader, max_bytes: Int) -> String!:
    if max_bytes <= 0 or not buffered_readers.contains_key(reader.handle):
        return ""
    state := buffered_readers[reader.handle]

    # the buffer already holds what was asked for. this is the case a buffered
    # reader exists for (every read short of a refill lands here), so it takes
    # its slice and moves the cursor, with no accumulator and no source read.
    cursor := state.cursor
    data := state.cache
    if data.len() - cursor >= max_bytes:
        stop := read_stop(data, cursor, cursor + max_bytes)
        state.cursor = stop
        return data.substring(cursor, stop)

    parts := empty_string_parts()
    mut got := 0
    while got < max_bytes:
        if state.cursor >= state.cache.len():
            if buffered_text_fill(state)! <= 0:
                return join_parts(parts)
        at := state.cursor
        buf := state.cache
        mut take := max_bytes - got
        avail := buf.len() - at
        if take > avail:
            take = avail
        # what is left to ask for can be less than the next character is long.
        # once something has been read that is simply where the read stops;
        # only a read that has taken nothing at all takes the whole character,
        # since coming back empty is how a caller recognises end of stream.
        mut stop := boundary_at_or_before(buf, at + take, at)
        if stop == at:
            if got > 0:
                return join_parts(parts)
            stop = boundary_at_or_after(buf, at + take)
        parts.push(buf.substring(at, stop))
        state.cursor = stop
        got = got + stop - at
    return join_parts(parts)

fn buffered_text_read_ctx(reader: BufferedReader, ctx: Context, max_bytes: Int) -> String!BlockingError:
    if max_bytes <= 0 or not buffered_readers.contains_key(reader.handle):
        return ""
    state := buffered_readers[reader.handle]

    # see `buffered_text_read`: served from the buffer, no source read, so the
    # deadline never comes into it.
    cursor := state.cursor
    data := state.cache
    if data.len() - cursor >= max_bytes:
        stop := read_stop(data, cursor, cursor + max_bytes)
        state.cursor = stop
        return data.substring(cursor, stop)

    parts := empty_string_parts()
    mut got := 0
    while got < max_bytes:
        if state.cursor >= state.cache.len():
            if buffered_text_fill_ctx(state, ctx)! <= 0:
                return join_parts(parts)
        at := state.cursor
        buf := state.cache
        mut take := max_bytes - got
        avail := buf.len() - at
        if take > avail:
            take = avail
        # see `buffered_text_read`.
        mut stop := boundary_at_or_before(buf, at + take, at)
        if stop == at:
            if got > 0:
                return join_parts(parts)
            stop = boundary_at_or_after(buf, at + take)
        parts.push(buf.substring(at, stop))
        state.cursor = stop
        got = got + stop - at
    return join_parts(parts)

# the next line, or none at the end of input. read_line and read_line_opt
# share this; read_line turns none into "".
fn buffered_text_read_line(reader: BufferedReader) -> String?!:
    if not buffered_readers.contains_key(reader.handle):
        return none
    state := buffered_readers[reader.handle]

    parts := empty_string_parts()
    while true:
        if state.cursor >= state.cache.len():
            if buffered_text_fill(state)! <= 0:
                return line_at_end(parts)
        cursor := state.cursor
        data := state.cache
        newline := find_newline_from(data, cursor)
        if newline >= 0:
            parts.push(data.substring(cursor, newline))
            state.cursor = newline + 1
            return trim_trailing_cr(join_parts(parts))
        parts.push(data.substring(cursor, data.len()))
        buffered_reader_clear(state)

fn buffered_text_read_line_ctx(reader: BufferedReader, ctx: Context) -> String?!BlockingError:
    if not buffered_readers.contains_key(reader.handle):
        return none
    state := buffered_readers[reader.handle]

    parts := empty_string_parts()
    while true:
        if state.cursor >= state.cache.len():
            if buffered_text_fill_ctx(state, ctx)! <= 0:
                return line_at_end(parts)
        cursor := state.cursor
        data := state.cache
        newline := find_newline_from(data, cursor)
        if newline >= 0:
            parts.push(data.substring(cursor, newline))
            state.cursor = newline + 1
            return trim_trailing_cr(join_parts(parts))
        parts.push(data.substring(cursor, data.len()))
        buffered_reader_clear(state)

fn buffered_text_read_until(reader: BufferedReader, sep: String, include_sep: Bool) -> String!:
    if sep.len() == 0:
        fail "empty separator"
    if not buffered_readers.contains_key(reader.handle):
        return ""
    state := buffered_readers[reader.handle]

    parts := empty_string_parts()
    while true:
        cursor := state.cursor
        data := state.cache
        mut sep_pos := 0 - 1
        if data.len() > cursor:
            sep_pos = find_sep_from(data, sep, cursor)
        if sep_pos >= 0:
            parts.push(data.substring(cursor, sep_pos))
            if include_sep:
                parts.push(sep)
            state.cursor = sep_pos + sep.len()
            return join_parts(parts)
        # hold back one byte less than the separator, so a separator split
        # across two reads is still found once the second one lands.
        #
        # the hold-back is a byte count and can leave the flush stopping inside
        # a character, so the flush stops at the boundary before that instead
        # and the few bytes it did not take stay in the buffer. it must not
        # round the other way: the bytes past that point are the ones being held
        # back for the separator.
        keep := sep.len() - 1
        avail := data.len() - cursor
        if avail > keep:
            stop := boundary_at_or_before(data, cursor + avail - keep, cursor)
            if stop > cursor:
                parts.push(data.substring(cursor, stop))
                state.cursor = stop
        if buffered_text_fill(state)! <= 0:
            buffered_text_take_rest(state, parts)
            return join_parts(parts)
    return join_parts(parts)

fn buffered_text_read_until_ctx(reader: BufferedReader, ctx: Context, sep: String, include_sep: Bool) -> String!BlockingError:
    if sep.len() == 0:
        fail blocking_failed("empty separator")
    if not buffered_readers.contains_key(reader.handle):
        return ""
    state := buffered_readers[reader.handle]

    parts := empty_string_parts()
    while true:
        cursor := state.cursor
        data := state.cache
        mut sep_pos := 0 - 1
        if data.len() > cursor:
            sep_pos = find_sep_from(data, sep, cursor)
        if sep_pos >= 0:
            parts.push(data.substring(cursor, sep_pos))
            if include_sep:
                parts.push(sep)
            state.cursor = sep_pos + sep.len()
            return join_parts(parts)
        # see `buffered_text_read_until`: the hold-back is a byte count and the
        # flush stops at the boundary before it.
        keep := sep.len() - 1
        avail := data.len() - cursor
        if avail > keep:
            stop := boundary_at_or_before(data, cursor + avail - keep, cursor)
            if stop > cursor:
                parts.push(data.substring(cursor, stop))
                state.cursor = stop
        if buffered_text_fill_ctx(state, ctx)! <= 0:
            buffered_text_take_rest(state, parts)
            return join_parts(parts)
    return join_parts(parts)

# at end of input, the last line when it had no terminator, or none when
# nothing was left. an empty line before the end was already returned at its
# newline, so an empty rest here always means the end.
fn line_at_end(parts: List[String]) -> String?:
    rest := join_parts(parts)
    if rest == "":
        return none
    return rest

# at end of stream, move whatever is left in the buffer onto `parts`.
fn buffered_text_take_rest(state: BufferedReaderState, parts: List[String]):
    if state.cache.len() > state.cursor:
        parts.push(state.cache.substring(state.cursor, state.cache.len()))
        buffered_reader_clear(state)

fn buffered_text_write(writer: BufferedWriter, data: String) -> Int!:
    if not buffered_writers.contains_key(writer.handle):
        return 0
    state := buffered_writers[writer.handle]
    state.cache = state.cache + data
    if state.cache.len() >= state.chunk_size:
        buffered_text_flush_state(state)!
    return data.len()

fn buffered_text_write_ctx(writer: BufferedWriter, ctx: Context, data: String) -> Int!BlockingError:
    if not buffered_writers.contains_key(writer.handle):
        return 0
    state := buffered_writers[writer.handle]
    state.cache = state.cache + data
    if state.cache.len() >= state.chunk_size:
        buffered_text_flush_state_ctx(state, ctx)!
    return data.len()

fn buffered_text_flush(writer: BufferedWriter) -> Int!:
    if not buffered_writers.contains_key(writer.handle):
        return 0
    return buffered_text_flush_state(buffered_writers[writer.handle])

fn buffered_text_flush_ctx(writer: BufferedWriter, ctx: Context) -> Int!BlockingError:
    if not buffered_writers.contains_key(writer.handle):
        return 0
    return buffered_text_flush_state_ctx(buffered_writers[writer.handle], ctx)

# send what a writer holds to its target. the text stays held until the write
# succeeds.
fn buffered_text_flush_state(state: BufferedWriterState) -> Int!:
    cached := state.cache
    if cached.len() == 0:
        return 0
    wrote := state.target.write_all(cached)!
    state.cache = ""
    return wrote

fn buffered_text_flush_state_ctx(state: BufferedWriterState, ctx: Context) -> Int!BlockingError:
    cached := state.cache
    if cached.len() == 0:
        return 0
    wrote := state.target.write_all_ctx(ctx, cached)!
    state.cache = ""
    return wrote

impl BufferedReader:
    fn read(max_bytes: Int) -> String!:
        return buffered_text_read(self, max_bytes)

    fn read_ctx(ctx: Context, max_bytes: Int) -> String!BlockingError:
        return buffered_text_read_ctx(self, ctx, max_bytes)

    # the next line without its terminator, or "" at the end of input. an
    # empty line also reads as "", so use read_line_opt to tell them apart.
    fn read_line() -> String!:
        line := buffered_text_read_line(self)!
        return line.unwrap_or("")

    fn read_line_ctx(ctx: Context) -> String!BlockingError:
        line := buffered_text_read_line_ctx(self, ctx)!
        return line.unwrap_or("")

    # the next line without its terminator, or none at the end of input, so
    # an empty line ("") and the end are different values. a last line with
    # no terminator is still returned before the none.
    fn read_line_opt() -> String?!:
        return buffered_text_read_line(self)

    fn read_line_opt_ctx(ctx: Context) -> String?!BlockingError:
        return buffered_text_read_line_ctx(self, ctx)

    fn read_until(sep: String) -> String!:
        return buffered_text_read_until(self, sep, false)

    fn read_until_ctx(ctx: Context, sep: String) -> String!BlockingError:
        return buffered_text_read_until_ctx(self, ctx, sep, false)

    fn read_until_including(sep: String) -> String!:
        return buffered_text_read_until(self, sep, true)

    fn read_until_including_ctx(ctx: Context, sep: String) -> String!BlockingError:
        return buffered_text_read_until_ctx(self, ctx, sep, true)

impl Reader for BufferedReader:
    fn read(max_bytes: Int) -> String!:
        return buffered_text_read(self, max_bytes)

impl Closer for BufferedReader:
    # drop the reader's registry entry, including any buffered text; the
    # source is closed by whoever built it. a closed reader reads as end of
    # input; a second close is a no-op.
    fn close():
        buffered_readers.remove(self.handle)

# a reader nobody closes gives its entry back when its last value dies.
impl Drop for BufferedReader:
    fn drop():
        self.close()

impl BufferedWriter:
    fn write(data: String) -> Int!:
        return buffered_text_write(self, data)

    fn write_ctx(ctx: Context, data: String) -> Int!BlockingError:
        return buffered_text_write_ctx(self, ctx, data)

    fn write_all(data: String) -> Int!:
        return self.write(data)

    fn write_all_ctx(ctx: Context, data: String) -> Int!BlockingError:
        return self.write_ctx(ctx, data)

    fn flush() -> Int!:
        return buffered_text_flush(self)

    fn flush_ctx(ctx: Context) -> Int!BlockingError:
        return buffered_text_flush_ctx(self, ctx)

impl Writer for BufferedWriter:
    fn write(data: String) -> Int!:
        return buffered_text_write(self, data)

impl Flusher for BufferedWriter:
    fn flush() -> Int!:
        return buffered_text_flush(self)

impl Closer for BufferedWriter:
    # drop the writer's registry entry, discarding anything unflushed, so
    # flush() first. the target is closed by whoever built it; a write after
    # close reports nothing written, and a second close is a no-op.
    fn close():
        buffered_writers.remove(self.handle)

# a writer nobody closes gives its entry back when its last value dies,
# without a flush (see BufferedBytesWriter's destructor): unflushed text is
# lost, as it is with close(). flush() before letting a writer go.
impl Drop for BufferedWriter:
    fn drop():
        self.close()

# the text sources and targets. a string reader's data is already text, so it
# slices on a character boundary itself and what it hands over is always
# whole. a string reader, a string buffer and a file never block, so their
# deadline-aware calls check the context and then do the plain call.

impl TextSource for StringReader:
    fn read_chunk(max_bytes: Int) -> Bytes!:
        return encode_utf8(string_reader_read(self, max_bytes)!)

    fn read_chunk_ctx(ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        return blocking_bytes(self.read_chunk(max_bytes))

impl TextTarget for StringBuffer:
    fn write_all(data: String) -> Int!:
        return write_all(self, data)

    fn write_all_ctx(ctx: Context, data: String) -> Int!BlockingError:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        return blocking_count(self.write_all(data))

impl TextSource for TcpStream:
    fn read_chunk(max_bytes: Int) -> Bytes!:
        return tcp_stream_read_bytes(self, max_bytes)

    fn read_chunk_ctx(ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
        return tcp_stream_read_bytes_ctx(self, ctx, max_bytes)

impl TextTarget for TcpStream:
    fn write_all(data: String) -> Int!:
        return write_all_tcp_stream(self, data)

    fn write_all_ctx(ctx: Context, data: String) -> Int!BlockingError:
        return write_all_tcp_stream_ctx(self, ctx, data)

