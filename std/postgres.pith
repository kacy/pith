# std.postgres — a pure-pith postgresql client (version 3 wire protocol).
#
# connect with host/port/user/password/database, run a query, and iterate the
# rows as std.sql values:
#
#   conn := postgres.connect("127.0.0.1", 5432, "me", "pw", "mydb")!
#   for row in postgres.query(conn, "select id, name from users")!:
#       print("{row.as_int(0)} {row.as_text(1)}")
#   conn.close()
#
# authentication is SCRAM-SHA-256 (the modern postgres default) with a
# cleartext-password fallback. `query` uses the simple protocol; `query_params`
# and `exec_params` use the extended protocol to bind `$1`, `$2`, ... values off
# the sql string. results come back in text form and are decoded by column type.
#
# `connect_tls` upgrades the socket with the postgres SSLRequest dance before
# the startup message. for a server with a self-signed certificate, pass its
# own pem as the ca file — the verifier treats an exact match as a pinned
# certificate:
#
#   cfg := tls.client_config_with_ca_file("/etc/ssl/certs/server.pem")!
#   conn := postgres.connect_tls("db.internal", 5432, "me", "pw", "mydb", "db.internal", cfg)!

import std.sql as sql
import std.decimal as decimal
import std.bytes as bytes
import std.bits as bits
import std.encoding as encoding
import std.hash as hash
import std.crypto.hmac as hmac
import std.crypto.kdf as kdf
import std.crypto.random as random
import std.net.tcp as tcp
import std.net.tls as tls
from std.io import TcpStream
from std.iter import Iterator

# backend messages come off an untrusted socket, so the frame length the server
# advertises is bounded before it drives a read: a hostile or MITM'd peer must
# not be able to commit the client to buffering gigabytes. postgres rows can be
# large, but a message beyond this is corruption or an attack, not data.
MAX_MESSAGE_LEN := 268435456 # 256 MiB

# --- byte helpers ---

# a 4-byte big-endian integer.
fn be32(n: Int) -> Bytes:
    out := bytes.buffer()
    out.write_byte(bits.mask8(bits.shr(n, 24))) catch 0
    out.write_byte(bits.mask8(bits.shr(n, 16))) catch 0
    out.write_byte(bits.mask8(bits.shr(n, 8))) catch 0
    out.write_byte(bits.mask8(n)) catch 0
    result := out.bytes()
    out.free()
    return result

# a 2-byte big-endian integer.
fn be16(n: Int) -> Bytes:
    out := bytes.buffer()
    out.write_byte(bits.mask8(bits.shr(n, 8))) catch 0
    out.write_byte(bits.mask8(n)) catch 0
    result := out.bytes()
    out.free()
    return result

# read a big-endian integer of `width` bytes at `off`.
fn read_be(data: Bytes, off: Int, width: Int) -> Int:
    mut value := 0
    mut i := 0
    while i < width:
        value = bits.bor(bits.shl(value, 8), bytes.get(data, off + i))
        i = i + 1
    return value

# xor two equal-length byte strings.
fn xor_bytes(a: Bytes, b: Bytes) -> Bytes:
    out := bytes.buffer()
    mut i := 0
    while i < bytes.len(a):
        out.write_byte(bits.xor(bytes.get(a, i), bytes.get(b, i))) catch 0
        i = i + 1
    return out.bytes()

# a decoded backend message: a type byte and its payload.
struct Message:
    mtype: Int
    payload: Bytes

# --- connection ---

# an open connection to a postgres server; `buf` holds bytes read past the
# current message. when `secure` is set the socket was upgraded by connect_tls
# and all reads and writes go through the tls session identified by `tls_handle`.
pub struct Conn:
    fd: Int
    mut buf: Bytes
    mut pos: Int
    secure: Bool
    tls_handle: Int

impl Conn:
    # read one chunk from the transport: the tls session when secure, the plain
    # socket otherwise.
    fn recv_chunk() -> Bytes!:
        if self.secure:
            return tls.conn_from_handle(self.tls_handle).read_bytes(4096)!
        return tcp_read_bytes(self.fd, 4096)!

    # read exactly `n` bytes, pulling more from the transport as needed. the
    # unconsumed tail moves into a growable buffer once and chunks append to
    # it, so a message spanning many reads costs one copy per chunk rather
    # than recopying everything buffered so far on every chunk.
    fn recv_exact(n: Int) -> Bytes!:
        if bytes.len(self.buf) - self.pos < n:
            acc := bytes.buffer()
            errdefer acc.free()
            acc.write(bytes.slice(self.buf, self.pos, bytes.len(self.buf))) catch 0
            while acc.len() < n:
                chunk := self.recv_chunk()!
                if bytes.len(chunk) == 0:
                    fail "postgres: connection closed"
                acc.write(chunk) catch 0
            self.buf = acc.take_bytes()
            self.pos = 0
        out := bytes.slice(self.buf, self.pos, self.pos + n)
        self.pos = self.pos + n
        return out

    # read one framed backend message: [type:1][length:4][payload:length-4].
    fn read_message() -> Message!:
        head := self.recv_exact(1)!
        mtype := bytes.get(head, 0)
        len_bytes := self.recv_exact(4)!
        total := read_be(len_bytes, 0, 4)
        # the length covers its own 4 bytes, so anything below 4 would ask
        # recv_exact for a negative payload. reject a malformed/hostile frame.
        if total < 4:
            fail "postgres: backend message length {total} is too small"
        if total > MAX_MESSAGE_LEN:
            fail "postgres: backend message length {total} exceeds the {MAX_MESSAGE_LEN}-byte limit"
        payload := self.recv_exact(total - 4)!
        return Message(mtype: mtype, payload: payload)

    # write raw bytes to the transport: the tls session when secure, the plain
    # socket otherwise.
    fn send_raw(data: Bytes) -> Int!:
        if self.secure:
            return tls.conn_from_handle(self.tls_handle).write_all_bytes(data)!
        return tcp.write_all_bytes(self.fd, data)!

    # frame and send a message. a `type_byte` of 0 omits the type prefix, as the
    # startup message requires.
    fn send(type_byte: Int, payload: Bytes) -> Int!:
        out := bytes.buffer()
        if type_byte != 0:
            out.write_byte(type_byte) catch 0
        out.write(be32(bytes.len(payload) + 4)) catch 0
        out.write(payload) catch 0
        n := self.send_raw(out.bytes())!
        out.free()
        return n

    # close the connection.
    pub fn close():
        if self.secure:
            tls.conn_from_handle(self.tls_handle).close()
        tcp_close(self.fd)

# a string followed by a null terminator, the wire's cstring form.
fn cstring(text: String) -> Bytes:
    out := bytes.buffer()
    out.write_string_utf8(text) catch 0
    out.write_byte(0) catch 0
    result := out.bytes()
    out.free()
    return result

# pull the human-readable message out of an ErrorResponse payload: a series of
# type-tagged cstrings, where 'M' holds the message.
fn error_text(payload: Bytes) -> String:
    mut i := 0
    while i < bytes.len(payload):
        field := bytes.get(payload, i)
        if field == 0:
            return "unknown error"
        start := i + 1
        mut j := start
        while j < bytes.len(payload) and bytes.get(payload, j) != 0:
            j = j + 1
        if field == 77:
            return bytes.to_string_utf8(bytes.slice(payload, start, j)) catch "error"
        i = j + 1
    return "unknown error"

# --- startup and authentication ---

# open a connection and complete the startup handshake and authentication.
pub fn connect(host: String, port: Int, user: String, password: String, database: String) -> Conn!:
    fd := tcp_connect(host, port)!
    conn := Conn(fd: fd, buf: bytes.empty(), pos: 0, secure: false, tls_handle: 0)
    # the conn now owns the socket, but nothing closes it until the caller does.
    # if the handshake fails the caller never sees this conn, so close the socket
    # here rather than leak it on every failed dial.
    started := conn.handshake(user, password, database)
    if started.is_err:
        conn.close()
        fail started.err
    return conn

# like connect, but upgrade the socket to tls first: send SSLRequest, expect
# the server's 'S', run the tls handshake against `server_name` with `config`,
# then run startup and authentication over the encrypted channel.
pub fn connect_tls(host: String, port: Int, user: String, password: String, database: String, server_name: String, config: tls.Config) -> Conn!:
    fd := tcp_connect(host, port)!
    # until the socket is wrapped in a Conn (or handed to the tls session), no
    # owner will close it, so every failure below closes the fd by hand.
    request := bytes.concat(be32(8), be32(80877103))
    sent := tcp.write_all_bytes(fd, request)
    if sent.is_err:
        tcp_close(fd)
        fail sent.err
    reply_result := tcp_read_bytes(fd, 1)
    if reply_result.is_err:
        tcp_close(fd)
        fail reply_result.err
    reply := reply_result.ok
    if bytes.len(reply) == 0 or bytes.get(reply, 0) != 83:
        tcp_close(fd)
        fail "postgres: server refused tls"
    session_result := tls.client(TcpStream(fd), server_name, config)
    if session_result.is_err:
        tcp_close(fd)
        fail session_result.err
    session := session_result.ok
    conn := Conn(fd: fd, buf: bytes.empty(), pos: 0, secure: true, tls_handle: session.handle)
    # from here the tls session owns the socket and will close it. on a failed
    # handshake close through the session once — not conn.close(), which would
    # also tcp_close the same fd a second time.
    started := conn.handshake(user, password, database)
    if started.is_err:
        tls.conn_from_handle(session.handle).close()
        fail started.err
    return conn

impl Conn:
    fn handshake(user: String, password: String, database: String) -> Bool!:
        # StartupMessage: protocol 3.0, then null-terminated key/value pairs.
        params := bytes.buffer()
        params.write(be32(196608)) catch 0
        params.write(cstring("user")) catch 0
        params.write(cstring(user)) catch 0
        params.write(cstring("database")) catch 0
        params.write(cstring(database)) catch 0
        params.write_byte(0) catch 0
        self.send(0, params.bytes())!

        # SCRAM state carried across the two AuthenticationSASL rounds.
        mut client_nonce := ""
        mut client_first_bare := ""
        mut server_signature := ""
        mut scram_verified := false
        while true:
            msg := self.read_message()!
            if msg.mtype == 69:
                fail "postgres: {error_text(msg.payload)}"
            elif msg.mtype == 82:
                auth := read_be(msg.payload, 0, 4)
                if auth == 0:
                    # AuthenticationOk — keep reading until ReadyForQuery. once
                    # SCRAM is under way it counts only after the server proved
                    # itself in SASLFinal; a MITM that never saw the password
                    # can send a bare AuthenticationOk.
                    if client_first_bare != "" and not scram_verified:
                        fail "postgres: server skipped SCRAM signature verification"
                    continue
                elif auth == 3:
                    # cleartext password
                    self.send(112, cstring(password))!
                elif auth == 10:
                    # AuthenticationSASL: begin SCRAM-SHA-256.
                    client_nonce = encoding.b64_encode(random.bytes(18)!)
                    client_first_bare = "n=,r=" + client_nonce
                    client_first := "n,," + client_first_bare
                    initial := bytes.buffer()
                    initial.write(cstring("SCRAM-SHA-256")) catch 0
                    initial.write(be32(client_first.len())) catch 0
                    initial.write_string_utf8(client_first) catch 0
                    self.send(112, initial.bytes())!
                elif auth == 11:
                    # AuthenticationSASLContinue: server-first-message.
                    server_first := bytes.to_string_utf8(bytes.slice(msg.payload, 4, bytes.len(msg.payload)))!
                    final := scram_client_final(server_first, client_first_bare, password)!
                    server_signature = final.server_signature
                    self.send(112, bytes.from_string_utf8(final.message))!
                elif auth == 12:
                    # AuthenticationSASLFinal: the server proves it holds the
                    # server key by echoing v=ServerSignature. a server that
                    # cannot produce it never had the credentials this client
                    # is authenticating against.
                    server_final := bytes.to_string_utf8(bytes.slice(msg.payload, 4, bytes.len(msg.payload)))!
                    if not scram_server_verified(server_final, server_signature):
                        fail "postgres: SCRAM server signature verification failed"
                    scram_verified = true
                else:
                    fail "postgres: unsupported auth method {auth}"
            elif msg.mtype == 90:
                # ReadyForQuery
                return true
            else:
                # ParameterStatus (83), BackendKeyData (75), NoticeResponse (78) — ignore.
                continue

# the client-final-message plus the base64 ServerSignature the backend must
# echo in AuthenticationSASLFinal to prove it holds the server key.
struct ScramFinal:
    message: String
    server_signature: String

# build the SCRAM client-final-message from the server-first-message, together
# with the server signature the backend has to answer with.
fn scram_client_final(server_first: String, client_first_bare: String, password: String) -> ScramFinal!:
    mut server_nonce := ""
    mut salt_b64 := ""
    mut iterations := 0
    for part in server_first.split(","):
        if part.starts_with("r="):
            server_nonce = part.substring(2, part.len())
        elif part.starts_with("s="):
            salt_b64 = part.substring(2, part.len())
        elif part.starts_with("i="):
            iterations = parse_int(part.substring(2, part.len()))!

    salt := encoding.b64_decode(salt_b64)!
    pw := bytes.from_string_utf8(password)
    salted := kdf.pbkdf2_sha256(pw, salt, iterations, 32)!
    client_key := hmac.sha256(salted, bytes.from_string_utf8("Client Key"))
    stored_key := hash.sha256_bytes(client_key)

    client_final_bare := "c=biws,r=" + server_nonce
    auth_message := client_first_bare + "," + server_first + "," + client_final_bare
    client_sig := hmac.sha256(stored_key, bytes.from_string_utf8(auth_message))
    proof := xor_bytes(client_key, client_sig)
    server_key := hmac.sha256(salted, bytes.from_string_utf8("Server Key"))
    server_sig := hmac.sha256(server_key, bytes.from_string_utf8(auth_message))
    return ScramFinal(message: client_final_bare + ",p=" + encoding.b64_encode(proof), server_signature: encoding.b64_encode(server_sig))

# whether the server-final-message carries exactly the ServerSignature the
# handshake computed. an empty expectation means no SASL round happened, so an
# unsolicited SASLFinal never verifies.
fn scram_server_verified(server_final: String, expected: String) -> Bool:
    if expected == "":
        return false
    for part in server_final.split(","):
        if part.starts_with("v="):
            return part.substring(2, part.len()) == expected
    return false

# --- queries ---

# a result set: rows buffered from one simple query, iterated as sql.Row.
pub struct Rows:
    mut rows: List[sql.Row]
    mut pos: Int

impl Iterator for Rows:
    type Item = sql.Row
    fn next() -> sql.Row?:
        if self.pos >= self.rows.len():
            return none
        r := self.rows[self.pos]
        self.pos = self.pos + 1
        return r

# the outcome of one round-trip: the rows (empty for a non-select) and the
# number of rows the command affected (from the CommandComplete tag).
struct QueryResult:
    rows: List[sql.Row]
    affected: Int

# the affected-row count from a CommandComplete tag ("INSERT 0 3", "UPDATE 2",
# "SELECT 5"): the last space-separated token.
fn command_affected(payload: Bytes) -> Int:
    mut end := 0
    while end < bytes.len(payload) and bytes.get(payload, end) != 0:
        end = end + 1
    tag := bytes.to_string_utf8(bytes.slice(payload, 0, end)) catch ""
    parts := tag.split(" ")
    if parts.len() == 0:
        return 0
    return parse_int(parts[parts.len() - 1]) catch 0

# read the backend's reply stream up to ReadyForQuery, collecting rows and the
# affected-row count. shared by the simple and extended query paths.
fn read_response(conn: Conn) -> QueryResult!:
    mut names: List[String] := []
    mut oids: List[Int] := []
    mut rows: List[sql.Row] := []
    mut affected := 0
    while true:
        msg := conn.read_message()!
        if msg.mtype == 69:
            fail "postgres: {error_text(msg.payload)}"
        elif msg.mtype == 84:
            # RowDescription: field count, then a descriptor per field.
            count := read_be(msg.payload, 0, 2)
            mut off := 2
            mut f := 0
            while f < count:
                start := off
                while bytes.get(msg.payload, off) != 0:
                    off = off + 1
                names.push(bytes.to_string_utf8(bytes.slice(msg.payload, start, off))!)
                # skip null + table_oid(4) + col(2), then read type_oid(4)
                oids.push(read_be(msg.payload, off + 7, 4))
                # advance past name-null(1) + 18 fixed descriptor bytes
                off = off + 1 + 18
                f = f + 1
        elif msg.mtype == 68:
            # DataRow: field count, then length-prefixed values (text format).
            count := read_be(msg.payload, 0, 2)
            mut values: List[sql.Value] := []
            mut off := 2
            mut c := 0
            while c < count:
                vlen := read_be(msg.payload, off, 4)
                off = off + 4
                if vlen == bits.mask32(0 - 1):
                    values.push(sql.null_value())
                else:
                    # any length other than the NULL sentinel must fit inside
                    # the message; a forged one would swallow the rest of the
                    # row or push `off` out of range.
                    if off + vlen > bytes.len(msg.payload):
                        fail "postgres: DataRow field length {vlen} overruns the message"
                    raw := bytes.to_string_utf8(bytes.slice(msg.payload, off, off + vlen))!
                    # a hostile/buggy server can send a DataRow with more fields
                    # than the RowDescription declared; indexing oids past its end
                    # would crash, so fall back to a text oid for the extras.
                    mut col_oid := 0
                    if c < oids.len():
                        col_oid = oids[c]
                    values.push(decode_value(raw, col_oid))
                    off = off + vlen
                c = c + 1
            rows.push(sql.row(values, names))
        elif msg.mtype == 67:
            # CommandComplete
            affected = command_affected(msg.payload)
        elif msg.mtype == 90:
            # ReadyForQuery
            return QueryResult(rows: rows, affected: affected)
        else:
            # ParseComplete (49), BindComplete (50), notices, etc. — ignore.
            continue

impl Conn:
    # Parse a statement under `name` (empty for the unnamed statement). the query
    # text carries `$1`, `$2`, ... placeholders; no parameter types are declared,
    # so the server infers them.
    fn send_parse(name: String, text: String):
        parse := bytes.buffer()
        parse.write(cstring(name)) catch 0
        parse.write(cstring(text)) catch 0
        parse.write(be16(0)) catch 0
        self.send(80, parse.bytes()) catch 0
        parse.free()

    # Bind `params` (in text form) to the statement `stmt_name` through the
    # unnamed portal, then Describe/Execute/Sync it. shared by the one-shot and
    # prepared paths.
    fn send_bind_execute(stmt_name: String, params: List[String]):
        bind := bytes.buffer()
        bind.write(cstring("")) catch 0
        bind.write(cstring(stmt_name)) catch 0
        bind.write(be16(0)) catch 0
        bind.write(be16(params.len())) catch 0
        for param in params:
            value := bytes.from_string_utf8(param)
            bind.write(be32(bytes.len(value))) catch 0
            bind.write(value) catch 0
        bind.write(be16(0)) catch 0
        self.send(66, bind.bytes()) catch 0
        bind.free()

        describe := bytes.buffer()
        describe.write_byte(80) catch 0
        describe.write(cstring("")) catch 0
        self.send(68, describe.bytes()) catch 0
        describe.free()

        execute := bytes.buffer()
        execute.write(cstring("")) catch 0
        execute.write(be32(0)) catch 0
        self.send(69, execute.bytes()) catch 0
        execute.free()

        self.send(83, bytes.empty()) catch 0

    # Parse/Bind/Describe/Execute/Sync for one parameterized statement using the
    # unnamed statement and portal, so nothing is left prepared on the server.
    fn send_extended(text: String, params: List[String]):
        self.send_parse("", text)
        self.send_bind_execute("", params)

# run a query through the simple query protocol and collect its rows.
pub fn query(conn: Conn, text: String) -> Rows!:
    conn.send(81, cstring(text))!
    result := read_response(conn)!
    return Rows(rows: result.rows, pos: 0)

# run a parameterized query. `$1`, `$2`, ... bind to `params` (in text form),
# which keeps values off the sql string.
pub fn query_params(conn: Conn, text: String, params: List[String]) -> Rows!:
    conn.send_extended(text, params)
    result := read_response(conn)!
    return Rows(rows: result.rows, pos: 0)

# run a statement for its effect (insert/update/delete/ddl), returning the
# number of rows it affected.
pub fn exec(conn: Conn, text: String) -> Int!:
    conn.send(81, cstring(text))!
    result := read_response(conn)!
    return result.affected

# like exec, but with `$1`, `$2`, ... bound to `params`.
pub fn exec_params(conn: Conn, text: String, params: List[String]) -> Int!:
    conn.send_extended(text, params)
    result := read_response(conn)!
    return result.affected

# --- prepared statements ---

# parse a statement once under `name` so it can run many times without
# re-parsing. run it with query_prepared / exec_prepared, passing the same name.
# names live for the session; re-preparing an existing name is an error on the
# server, so pick a fresh one per distinct query.
pub fn prepare(conn: Conn, name: String, text: String) -> Int!:
    conn.send_parse(name, text)
    conn.send(83, bytes.empty())!
    read_response(conn)!
    return 0

# run a prepared statement, binding `params`, and collect its rows.
pub fn query_prepared(conn: Conn, name: String, params: List[String]) -> Rows!:
    conn.send_bind_execute(name, params)
    result := read_response(conn)!
    return Rows(rows: result.rows, pos: 0)

# run a prepared statement for its effect, returning the number of rows it
# affected.
pub fn exec_prepared(conn: Conn, name: String, params: List[String]) -> Int!:
    conn.send_bind_execute(name, params)
    result := read_response(conn)!
    return result.affected

# --- connection pool ---

# a small connection pool: it hands out live connections and takes them back
# for reuse, so callers skip the tcp + SCRAM handshake on every query.
#
# `max_open` is a hard cap on how many connections exist at once. a `slots`
# channel holds one token per allowed connection; acquire() takes a token and
# release() returns it, so when every connection is checked out the next
# acquirer blocks on the channel — yielding under the green scheduler — until
# one comes back, rather than opening an unbounded number and exhausting the
# server. an idle connection is reused before a token buys a fresh one, so the
# pool never holds more than `max_open` connections live at a time.
#
# the pool is self-synchronizing: `mu` guards the idle list and `slots` is a
# channel (already safe across tasks), so many green tasks can share one pool
# without an outer lock, and the connect/close network i/o stays outside `mu`.
pub struct Pool:
    mut idle: List[Conn]
    host: String
    port: Int
    user: String
    password: String
    database: String
    max_open: Int
    mu: Mutex
    slots: Channel[Bool]

# create a pool that dials the given server. it opens connections lazily, on the
# first acquire that has nothing idle to reuse, and never holds more than
# `max_open` connections at once (clamped to at least one).
pub fn pool(host: String, port: Int, user: String, password: String, database: String, max_open: Int) -> Pool:
    cap := clamp_open(max_open)
    slots := Channel[Bool](cap)
    mut i := 0
    while i < cap:
        slots.send(true)
        i = i + 1
    return Pool(idle: [], host: host, port: port, user: user, password: password, database: database, max_open: cap, mu: Mutex(), slots: slots)

# a pool must allow at least one connection.
fn clamp_open(max_open: Int) -> Int:
    if max_open < 1:
        return 1
    return max_open

impl Pool:
    # take a connection from the pool. it first claims a slot — blocking (and
    # yielding) when all `max_open` connections are checked out — then reuses an
    # idle connection or, failing that, opens a fresh one outside the lock. on a
    # failed dial it hands the slot back so the cap does not leak.
    pub fn acquire() -> Conn!:
        self.slots.recv()
        self.mu.lock()
        n := self.idle.len()
        mut reused: Conn? := none
        if n > 0:
            reused = self.idle[n - 1]
            self.idle = self.idle.slice(0, n - 1)
        self.mu.unlock()
        if reused != none:
            return reused?
        fresh := connect(self.host, self.port, self.user, self.password, self.database)
        if fresh.is_err:
            self.slots.send(true)
            fail fresh.err
        return fresh.ok

    # return a connection for reuse, or close it if the pool is already full,
    # then hand its slot back. the idle list is updated before the slot returns,
    # so an acquirer woken by that slot finds the connection waiting for it and
    # does not open a redundant one.
    pub fn release(conn: Conn):
        self.mu.lock()
        keep := self.idle.len() < self.max_open
        if keep:
            self.idle.push(conn)
        self.mu.unlock()
        if not keep:
            conn.close()
        self.slots.send(true)

    # close a checked-out connection that must not go back into rotation (it is
    # out of protocol sync after a failed statement) and hand its slot back. like
    # release it returns the slot, so a discarded connection never leaks the cap.
    pub fn discard(conn: Conn):
        conn.close()
        self.slots.send(true)

    # close every idle connection.
    pub fn close():
        self.mu.lock()
        idle := self.idle
        self.idle = []
        self.mu.unlock()
        for conn in idle:
            conn.close()

# decode a text-format value by its column type oid.
#
# every branch falls back to the raw text rather than to a zero when the value
# does not parse. postgres sends `NaN`, `Infinity` and `-Infinity` for a
# numeric, and none of those is a number this driver can hold — handing back
# the text keeps them intact, where a fabricated 0 would be a wrong balance
# that no one ever sees fail.
fn decode_value(raw: String, oid: Int) -> sql.Value:
    # int2, int4, int8, oid
    if oid == 21 or oid == 23 or oid == 20 or oid == 26:
        parsed := parse_int(raw)
        if parsed.is_err:
            return sql.text(raw)
        return sql.integer(parsed.ok)
    # numeric: exact by definition, so it decodes to an exact Decimal. routing
    # it through a Float would round a NUMERIC(20,2) balance on the way in.
    if oid == 1700:
        decoded := decimal.parse(raw)
        if decoded.is_err:
            return sql.text(raw)
        return sql.numeric(decoded.ok)
    # float4, float8 — these genuinely are floats
    if oid == 700 or oid == 701:
        parsed := parse_float(raw)
        if parsed.is_err:
            return sql.text(raw)
        return sql.real(parsed.ok)
    # bool
    if oid == 16:
        if raw == "t":
            return sql.integer(1)
        return sql.integer(0)
    return sql.text(raw)

# --- tests (pure logic; no server needed) ---

test "scram-sha-256 client-final matches the RFC 7677 vector":
    server_first := "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    client_first_bare := "n=user,r=rOprNGfwEbeRWgbNEkqO"
    final := scram_client_final(server_first, client_first_bare, "pencil")!
    assert_eq(final.message, "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=")
    assert_eq(final.server_signature, "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=")

test "SASLFinal verifies only the exact server signature":
    assert(scram_server_verified("v=abc", "abc"))
    assert(not scram_server_verified("v=abd", "abc"))
    assert(not scram_server_verified("e=other-error", "abc"))
    assert(not scram_server_verified("v=abc", ""))

test "big-endian int32 round-trips":
    assert_eq(read_be(be32(196608), 0, 4), 196608)
    assert_eq(read_be(be32(0), 0, 4), 0)
    assert_eq(read_be(be32(65535), 0, 4), 65535)

test "value decode honors column type oids":
    row := sql.row([decode_value("42", 23), decode_value("hi", 25), decode_value("9.5", 701), decode_value("t", 16)], ["a", "b", "c", "d"])
    assert_eq(row.as_int(0), 42)
    assert_eq(row.as_text(1), "hi")
    assert_eq(row.as_real(2), 9.5)
    assert_eq(row.as_int(3), 1)

test "a numeric column decodes exactly, digits and trailing zeros intact":
    row := sql.row([decode_value("12345678901234567.89", 1700), decode_value("1.10", 1700), decode_value("-0.00", 1700)], ["balance", "price", "zero"])
    assert_eq(decimal.to_string(row.decimal("balance")), "12345678901234567.89")
    assert_eq(decimal.to_string(row.decimal("price")), "1.10")
    assert_eq(decimal.to_string(row.decimal("zero")), "0.00")

test "a numeric postgres cannot express keeps its text instead of becoming zero":
    # postgres sends these for a numeric since version 14. decoding them as a
    # float would have produced 0.0 and looked like a real balance.
    row := sql.row([decode_value("NaN", 1700), decode_value("Infinity", 1700), decode_value("-Infinity", 1700)], ["a", "b", "c"])
    assert_eq(row.as_text(0), "NaN")
    assert_eq(row.as_text(1), "Infinity")
    assert_eq(row.as_text(2), "-Infinity")

test "an unparseable number keeps its text rather than fabricating a zero":
    row := sql.row([decode_value("nonsense", 23), decode_value("nonsense", 701)], ["i", "f"])
    assert_eq(row.as_text(0), "nonsense")
    assert_eq(row.as_text(1), "nonsense")
    assert_eq(row.as_int(0), 0)

test "error text extracts the message field":
    payload := bytes.concat(bytes.from_string_utf8("SERROR"), bytes.concat(bytes.from_string_utf8(chr(0)), bytes.concat(bytes.from_string_utf8("Mrole does not exist"), bytes.from_string_utf8(chr(0)))))
    assert_eq(error_text(payload), "role does not exist")

test "command tag affected-row count is the last token":
    update := bytes.concat(bytes.from_string_utf8("UPDATE 5"), bytes.from_string_utf8(chr(0)))
    insert := bytes.concat(bytes.from_string_utf8("INSERT 0 3"), bytes.from_string_utf8(chr(0)))
    assert_eq(command_affected(update), 5)
    assert_eq(command_affected(insert), 3)
    assert_eq(read_be(be16(258), 0, 2), 258)

test "read_message rejects a length below its own header":
    # a length field of 3 covers only part of its own 4 bytes, so total - 4
    # would ask recv_exact for a negative payload. the frame is pre-buffered,
    # so no real socket is touched.
    framed := bytes.concat(bytes.from_string_utf8("E"), be32(3))
    conn := Conn(fd: -1, buf: framed, pos: 0, secure: false, tls_handle: 0)
    assert(conn.read_message().is_err)

test "read_message rejects a length beyond the cap":
    # a frame length just past MAX_MESSAGE_LEN must be refused before it drives
    # a read. the frame is pre-buffered, so no real socket is touched.
    framed := bytes.concat(bytes.from_string_utf8("D"), be32(MAX_MESSAGE_LEN + 1))
    conn := Conn(fd: -1, buf: framed, pos: 0, secure: false, tls_handle: 0)
    assert(conn.read_message().is_err)
