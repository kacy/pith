# toml_ops: reading a package manifest with std.toml.
#
# writes a pith.toml-style manifest to a temporary file and loads it back:
# the [package] table decodes into a struct, required keys fail with a
# message, optional ones fall back to defaults, and the dependency table is
# walked key by key.

import std.fs as fs
import std.os.path as path
import std.toml as toml

struct Package:
    pub name: String
    pub version: String
    pub edition: Int = 2026

fn manifest_text() -> String:
    return [
        "[package]",
        "name = \"ledger\"",
        "version = \"0.4.1\"",
        "authors = [\"ada\", \"grace\"]",
        "",
        "[dependencies]",
        "decimal = \"1.2\"",
        "csv = \"0.9\"",
        "",
        "[build]",
        "optimize = true",
        "jobs = 8",
].join("\n") + "\n"

fn main() -> Int!toml.TomlDecodeError:
    dir := fs.make_temp_dir("pith-toml-example-") catch:
        return 1
    defer fs.remove_tree(dir)
    manifest_path := path.join(dir, "pith.toml")
    fs.write(manifest_path, manifest_text()) catch:
        return 1

    package := toml.decode_file_path[Package](manifest_path, "package")!
    print("{package.name} {package.version} (edition {package.edition})")

    root := toml.parse_file(manifest_path)
    authors := toml.get_array(toml.get_table(root, "package"), "authors")
    mut names: List[String] := []
    for index in 0..toml.array_len(authors):
        names.push(toml.array_string(authors, index))
    print("authors: {names.join(", ")}")

    print("dependencies:")
    deps := toml.get_table(root, "dependencies")
    for name in toml.keys(deps).sort():
        print("  {name:<8} {toml.get_string(deps, name)}")

    build := toml.get_table(root, "build")
    jobs := toml.get_int_or(build, "jobs", 1)
    target := toml.get_string_or(build, "target", "native")
    print("build: optimize={toml.get_bool(build, "optimize")}, {jobs} jobs, target {target}")

    # a key the program cannot do without is required, and its absence is
    # an error with a message the caller can report
    license := toml.require_string(toml.get_table(root, "package"), "license")
    if license.is_err:
        print("cannot publish: {license.err.message}")
    return 0
