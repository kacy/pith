# pith_main.pith — self-hosted compiler CLI
#
# usage:
#   pith build <file.pith>      compile to native binary
#   pith build <file> -o <out>  compile to the given output path
#   pith run <file.pith>        compile and run
#   pith test <file.pith>       run test declarations
#   pith test <file> [--filter <substr>] [--tag <name>] [--exclude-tag <name>]
#                    [--json]          flags are forwarded to the runner
#   pith check <file.pith>      type check (human-readable output)
#   pith check --json <file>  machine-readable diagnostics
#   pith fmt <file.pith>...     format source code
#   pith fmt --check <file>...  check if already formatted
#   pith lint <file.pith>...    lint for convention violations
#   pith lint --json <file>...  lint with JSON output
#   pith doc <file.pith>        generate documentation
#   pith doc <topic>            show docs/<topic>.md in the terminal
#   pith doc <file.md>          show a markdown file in the terminal
#   pith doc --json <file>    documentation as JSON
#   pith doc --check <file>...  check all pub items documented, or for a
#                             .md file that its pith code blocks type check
#   pith doc search <query>   search stdlib docs
#   pith package check        type check package root from pith.toml
#   pith package test         run package root tests
#   pith package lint         lint package root
#   pith package doc          generate package root documentation
#   pith package deps         list local path dependencies
#   pith package lock         write pith.lock from local path dependencies
#   pith package install      copy path dependencies into .pith/packages
#   pith package install --refresh recopy existing cached dependencies
#   pith package inspect [pkg] inspect current package or dependency
#   pith package context [pkg] emit an agent-readable package summary
#   pith new <name>           scaffold new package
#   pith lsp                  run the language server over stdio
#   pith lex <file.pith>        print token stream
#   pith parse <file.pith>      print AST
#   pith version              print version
#   pith help                 print usage

from lexer import lex_all
from parser import parse_with_file, parser_diagnostics, parser_has_errors
from ast import reset_arena
from checker import c_diagnostics_to_json
from check_pipeline import run_check_pipeline
from printer import print_ast
from formatter import fmt_source
from linter import lint_module, source_is_generated
from sharing_lint import lint_shared_globals
from lock_order import lint_lock_order
from errors import render_diagnostics, render_diagnostics_for_path, render_diagnostics_json, has_errors, unreadable_source_message
from docgen import doc_extract, doc_format, doc_format_json, doc_check, doc_search
from doc_examples import check_examples
from package_cli import package_root_path, cmd_package_deps, cmd_package_lock, cmd_package_install, cmd_package_inspect, cmd_package_context, cmd_new
from lsp_server import run_lsp_server
import std.fs as fs
import std.markdown as markdown
import std.markdown.terminal as terminal
import std.os as os
import std.os.path as paths
import std.term as term
import std.term.tty as tty

# ---------------------------------------------------------------
# native backend passthrough
# build/run/test still go through the Rust backend, but this CLI now forwards
# those commands so the self-hosted binary is usable in bootstrap verification.

# the directory holding this executable, from argv[0]: the path it was
# started by, or the PATH entry that holds it when it was started by bare
# name. "" when neither names a file.
fn own_dir() -> String:
    a := args()
    if a.len() == 0:
        return ""
    mut exe := a[0]
    if not exe.contains("/"):
        exe = os.which(exe)
    if exe == "":
        return ""
    return paths.dir(exe)

# the toolchain root beside this executable: the checkout holding
# `self-host/pith_main`, or the install holding `lib/pith_main`. "" when
# the directory above has no std.
fn own_root() -> String:
    dir := own_dir()
    if dir == "":
        return ""
    root := paths.join(dir, "..")
    if dir_exists(paths.join(root, "std")):
        return root
    return ""

# when PITH_HOME is unset, point it at the toolchain this executable
# belongs to, so a source file outside any checkout still finds std here
# and in the backend and ir driver this spawns. a checkout's own std still
# wins, since the import walk looks above the source file first.
fn default_pith_home():
    if env("PITH_HOME").len() > 0:
        return
    root := own_root()
    if root != "":
        _set := os.set_env("PITH_HOME", root)

# where the native backend may be, in order: the working directory's
# checkout, then beside this executable in a checkout
# (`target/release/pith` next to `self-host/pith_main`) or an install
# (`bin/pith` next to `lib/pith_main`), then under PITH_HOME.
fn native_backend_candidates() -> List[String]:
    mut out := ["./target/release/pith", "../target/release/pith"]
    dir := own_dir()
    if dir != "":
        out.push(paths.join(dir, "../target/release/pith"))
        out.push(paths.join(dir, "../bin/pith"))
    home := env("PITH_HOME")
    if home.len() > 0:
        out.push(paths.join(home, "bin/pith"))
    return out

# the native backend: PITH_NATIVE when set, else the first candidate that
# exists. a missing backend is an error naming every path tried.
fn native_backend_path() -> String:
    configured := env("PITH_NATIVE")
    if configured.len() > 0:
        if not file_exists(configured):
            print_err("error: PITH_NATIVE is set to " + configured + ", which does not exist")
            exit(1)
        return configured
    tried := native_backend_candidates()
    for candidate in tried:
        if file_exists(candidate):
            return candidate
    print_err("error: cannot find the native pith backend; tried " + tried.join(", ") + ". build it with `cargo build --release` in cranelift/, or set PITH_NATIVE to its path")
    exit(1)
    return ""

# the backend is spawned without a shell, but `exec` splits its command
# line on whitespace, so no argument can carry a space. the guards below
# refuse one rather than passing a half-argument down; the native cli
# takes such paths, and the runner reads every selection flag from the
# environment too, which is the way to pass a value with a space through
# this wrapper.
fn backend_command(command: String, path: String, extra: List[String]) -> String:
    if path.contains(" "):
        print_err("error: self-hosted " + command + " cannot pass a path containing a space to the backend; run the native cli (target/release/pith " + command + ") for this path instead")
        exit(1)
    backend := native_backend_path()
    if backend.contains(" "):
        print_err("error: the native backend path " + backend + " contains a space, which self-hosted " + command + " cannot pass on; set PITH_NATIVE to a path without spaces")
        exit(1)
    mut parts := [backend, command, path]
    for arg in extra:
        if arg.contains(" "):
            print_err("error: self-hosted " + command + " cannot pass an argument containing a space to the backend; pass the value through the environment instead")
            exit(1)
        parts.push(arg)
    return parts.join(" ")

# `exec` answers -1 when the backend could not be started at all, which
# would otherwise surface as a bare exit status 255.
fn run_backend_command(command: String, path: String, extra: List[String]) -> String!:
    line := backend_command(command, path, extra)
    status := exec(line)
    if status == 0 - 1:
        print_err("error: could not start the native backend: " + line)
        exit(1)
    if status != 0:
        exit(status)
    return ""

# every argument after the path goes to the backend untouched, so `-o` on
# build and `--filter`, `--tag`, `--exclude-tag` and `--json` on test mean the
# same thing here as they do on the native cli, and an option the backend does
# not take is refused there. the wrapper does not read them.
fn cmd_build(path: String, extra: List[String]) -> String!:
    return run_backend_command("build", path, extra)

fn cmd_run(path: String, extra: List[String]) -> String!:
    return run_backend_command("run", path, extra)

fn cmd_test(path: String, extra: List[String]) -> String!:
    return run_backend_command("test", path, extra)

# ---------------------------------------------------------------
# check command
# ---------------------------------------------------------------

# the contents of path, or an error naming the file and exit status 1.
# read_file's own error does not name the file or say what went wrong
fn read_source_or_exit(path: String) -> String:
    source := read_file(path) catch:
        print_err(unreadable_source_message(path))
        exit(1)
        return ""
    return source

fn cmd_check(path: String, json_mode: Bool) -> String!:
    source := read_source_or_exit(path)
    outcome := run_check_pipeline(path)!

    if not outcome.parse_ok:
        if json_mode:
            print(render_diagnostics_json(outcome.diags))
        else:
            print(render_diagnostics(outcome.diags, source))
        exit(1)

    if not outcome.import_ok:
        if json_mode:
            print(render_diagnostics_json(outcome.diags))
        else:
            print(render_diagnostics_for_path(outcome.diags, path, source)!)
        exit(1)

    if json_mode:
        print(c_diagnostics_to_json(outcome.diags))
        if has_errors(outcome.diags):
            exit(1)
    else:
        if has_errors(outcome.diags):
            # diagnostics may span modules; render each against its own
            # source so excerpts quote the right file
            print(render_diagnostics_for_path(outcome.diags, path, source)!)
            exit(1)
        else:
            print("ok")
    return ""

# ---------------------------------------------------------------
# fmt command
# ---------------------------------------------------------------

# false when the file could not be read or written, or needs formatting
# under --check
fn cmd_fmt(path: String, check_mode: Bool) -> Bool:
    source := read_file(path) catch:
        print_err(unreadable_source_message(path))
        return false
    formatted := fmt_source(source)

    if check_mode:
        if source != formatted:
            print(path + " needs formatting")
            return false
        return true

    if source != formatted:
        _written := write_file(path, formatted) catch:
            print_err("error: cannot write " + path)
            return false
        print("formatted " + path)
    return true

# ---------------------------------------------------------------
# lint command
# ---------------------------------------------------------------

# false when the file could not be read, does not parse or resolve its
# imports, or has a lint diagnostic
fn cmd_lint(path: String, json_mode: Bool) -> Bool:
    source := read_file(path) catch:
        print_err(unreadable_source_message(path))
        return false
    outcome := run_check_pipeline(path) catch:
        print_err("error: cannot check " + path)
        return false

    if not outcome.parse_ok:
        if json_mode:
            print(render_diagnostics_json(outcome.diags))
        else:
            print(render_diagnostics(outcome.diags, source))
        return false

    if not outcome.import_ok:
        if json_mode:
            print(render_diagnostics_json(outcome.diags))
        else:
            print(render_diagnostics_for_path(outcome.diags, path, source) catch render_diagnostics(outcome.diags, source))
        return false

    # a generated file is skipped AFTER parsing and import resolution, so
    # one that does not parse still fails here — only the convention rules
    # are waived, not the checks that say the file is well formed.
    if source_is_generated(source):
        if not json_mode:
            print("ok (generated)")
        return true

    mut diags := lint_module(outcome.root, source, path)
    # the sharing rule looks at the whole program, so its errors can name a
    # global in an imported module; they are rendered against that file.
    for d in lint_shared_globals(outcome.root, path, outcome.import_roots):
        diags.push(d)
    for d in lint_lock_order(outcome.root, path, outcome.import_roots):
        diags.push(d)

    if json_mode:
        print(render_diagnostics_json(diags))
    elif diags.len() > 0:
        print(render_diagnostics_for_path(diags, path, source) catch render_diagnostics(diags, source))
    else:
        print("ok")
    # a warning fails too. every lint rule is a convention this
    # tree already follows everywhere, so a new warning means new
    # drift rather than a pre-existing debt to triage — and a
    # warning nobody has to act on is one nobody reads.
    return diags.len() == 0

# ---------------------------------------------------------------
# doc command
# ---------------------------------------------------------------

fn cmd_doc(path: String, json_mode: Bool) -> String!:
    source := read_source_or_exit(path)
    doc_extract(source)
    if json_mode:
        print(doc_format_json())
    else:
        print(doc_format())
    return ""

# `doc --check` on one file: for a .md file, that its pith code blocks
# type check (see doc_examples.pith); for a pith file, that every pub item
# has a doc comment. false when the check fails.
fn cmd_doc_check(path: String) -> Bool:
    source := read_file(path) catch:
        print_err(unreadable_source_message(path))
        return false
    if path.ends_with(".md"):
        report := check_examples(path, source)
        for line in report.errors:
            print(line)
        if report.failed > 0:
            print("{path}: {report.failed} of {report.checked} pith blocks do not check")
            return false
        print("{path}: ok ({report.checked} pith blocks checked, {report.skipped} skipped)")
        return true
    doc_extract(source)
    missing := doc_check()
    if missing > 0:
        print(missing.to_string() + " undocumented pub item(s)")
        return false
    print("ok")
    return true

# the widest a guide is laid out, however wide the terminal: longer lines
# are harder to read.
MAX_GUIDE_COLUMNS := 100

# the docs directory of the toolchain this executable belongs to: the
# checkout's docs/ or the install's. "" when neither has one.
fn guides_dir() -> String:
    for root in [own_root(), env("PITH_HOME")]:
        if root != "" and dir_exists(paths.join(root, "docs")):
            return paths.join(root, "docs")
    return ""

# the guides in `dir`, by name, for a message that lists them.
fn guide_names(dir: String) -> String:
    mut names: List[String] := []
    if dir != "":
        for name in list_dir(dir):
            if name.ends_with(".md"):
                names.push(name.substring(0, name.len() - 3))
    names = names.sort()
    return names.join(", ")

# `pith doc <topic>` and `pith doc <file.md>`: a guide from the toolchain's
# docs/, or any markdown file, laid out for the terminal with
# std.markdown.terminal. on a terminal the text takes its width and colors
# (unless NO_COLOR is set) and goes through the pager; anywhere else it is
# plain text 80 columns wide. false when there is nothing to show.
fn cmd_doc_page(name: String) -> Bool:
    mut path := name
    if not name.ends_with(".md"):
        dir := guides_dir()
        path = paths.join(dir, name + ".md")
        if dir == "" or not file_exists(path):
            print_err("error: no guide named '" + name + "'; the guides are " + guide_names(dir))
            return false
    source := read_file(path) catch:
        print_err(unreadable_source_message(path))
        return false
    on_terminal := tty.is_tty(1)
    mut columns := 80
    mut rows := 0
    if on_terminal:
        found := tty.size() catch (80, 0)
        columns = min(found.0, MAX_GUIDE_COLUMNS)
        rows = found.1
    renderer := terminal.renderer(columns).colors(on_terminal and not term.no_color())
    text := markdown.render_with(source, markdown.options(), renderer)
    if on_terminal and text.split("\n").len() >= rows and paged(text):
        return true
    print(text.substring(0, max(text.len() - 1, 0)))
    return true

# show `text` through the pager, PAGER or else `less`, the way version
# control tools do: with LESS set to FRX unless it is set already, so less
# passes the colors through and quits at once when the text fits on the
# screen. false when there is no pager to run, so the caller prints the text
# instead.
fn paged(text: String) -> Bool:
    pager := env_opt("PAGER").unwrap_or("less")
    if pager.trim() == "":
        return false
    file := fs.make_temp_file("pith-doc-", ".txt") catch:
        return false
    defer fs.remove(file)
    written := fs.write(file, text) catch false
    if not written or file.contains(" "):
        return false
    if env("LESS") == "":
        _set := os.set_env("LESS", "FRX")
    return exec(pager + " " + file) != 0 - 1

fn cmd_doc_search(query: String) -> String!:
    result := doc_search(query, ".")!
    print(result)
    return ""

# ---------------------------------------------------------------
# package command
# ---------------------------------------------------------------

fn cmd_package(action: String, args_list: List[String]) -> String!:
    root := package_root_path()!
    if action == "check":
        return cmd_check(root, false)
    if action == "test":
        return cmd_test(root, args_list.slice(3, args_list.len()))
    if action == "lint":
        if not cmd_lint(root, false):
            exit(1)
        return ""
    if action == "doc":
        return cmd_doc(root, false)
    if action == "deps":
        return cmd_package_deps()
    if action == "lock":
        return cmd_package_lock()
    if action == "install":
        mut refresh := false
        if args_list.len() >= 4:
            if args_list[3] == "--refresh":
                refresh = true
            else:
                print("usage: pith package install [--refresh]")
                exit(1)
        return cmd_package_install(refresh)
    if action == "inspect":
        mut name := "."
        mut have_name := false
        mut api_only := false
        mut files_only := false
        mut ai := 3
        while ai < args_list.len():
            arg := args_list[ai]
            if arg == "--api":
                api_only = true
            elif arg == "--files":
                files_only = true
            elif arg.starts_with("-"):
                print("usage: pith package inspect [package] [--api|--files]")
                exit(1)
            elif not have_name:
                name = arg
                have_name = true
            else:
                print("usage: pith package inspect [package] [--api|--files]")
                exit(1)
            ai = ai + 1
        return cmd_package_inspect(name, api_only, files_only)
    if action == "context":
        mut name := "."
        if args_list.len() >= 4:
            name = args_list[3]
        return cmd_package_context(name)

    print("usage: pith package <check|test|lint|doc|deps|lock|install|inspect|context>")
    exit(1)
    return ""

# ---------------------------------------------------------------
# lex command
# ---------------------------------------------------------------

fn cmd_lex(path: String) -> String!:
    source := read_source_or_exit(path)
    tokens := lex_all(source)
    for tok in tokens:
        print(tok.kind + " " + tok.value)
    return ""

# ---------------------------------------------------------------
# parse command
# ---------------------------------------------------------------

fn cmd_parse(path: String) -> String!:
    source := read_source_or_exit(path)
    tokens := lex_all(source)
    reset_arena()
    root := parse_with_file(tokens, path)
    if parser_has_errors():
        print(render_diagnostics(parser_diagnostics(), source))
        exit(1)
    print_ast(root)
    return ""

# ---------------------------------------------------------------
# help / version
# ---------------------------------------------------------------

PITH_VERSION := "0.2.16"

fn print_version():
    print("pith " + PITH_VERSION + " (self-hosted)")

fn print_help():
    print("pith — the pith programming language compiler")
    print("")
    print("usage: pith <command> [options] [file]")
    print("")
    print("commands:")
    print("  build <file.pith>        compile to native binary")
    print("    [-o <out>]             write the executable to <out>")
    print("  run <file.pith>          compile and run")
    print("  test <file.pith>         run test declarations")
    print("    [--filter <substr>] [--tag <name>] [--exclude-tag <name>] [--json]")
    print("  check <file.pith>        type check (human-readable)")
    print("  check --json <file>    type check (JSON output)")
    print("  fmt <file.pith>...       format source code")
    print("  fmt --check <file>...  check formatting")
    print("  lint <file.pith>...      lint for conventions")
    print("  lint --json <file>...  lint (JSON output)")
    print("  doc <file.pith>          generate documentation")
    print("  doc --json <file>      documentation (JSON output)")
    print("  doc --check <file>...  check all pub items documented, or the pith code in a .md file")
    print("  doc <topic>            show a guide from docs/ in the terminal, such as markdown")
    print("  doc <file.md>          show a markdown file in the terminal")
    print("  doc search <query>     search stdlib documentation")
    print("  package check          type check package root")
    print("  package test           run package root tests")
    print("  package lint           lint package root")
    print("  package doc            generate package root documentation")
    print("  package deps           list package dependencies")
    print("  package lock           write pith.lock")
    print("  package install        copy path dependencies into .pith/packages")
    print("  package install --refresh recopy existing cached dependencies")
    print("  package inspect [pkg]  inspect current package or dependency")
    print("  package context [pkg]  emit agent-readable package context")
    print("  new <name>             scaffold new package")
    print("  lsp                    run the language server over stdio")
    print("  lex <file.pith>          print token stream")
    print("  parse <file.pith>        print AST")
    print("  version                print version")
    print("  help                   print this help")

# ---------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------

# the files after `pith <command>`, past `flag` when it comes first. any
# other option is refused rather than read as a file name.
fn file_operands(a: List[String], command: String, flag: String) -> List[String]:
    mut start := 2
    if a.len() > 2 and a[2] == flag:
        start = 3
    files := a.slice(start, a.len())
    if files.len() == 0:
        print("usage: pith " + command + " [" + flag + "] <file.pith>")
        exit(1)
    for f in files:
        if f.starts_with("-"):
            print_err("error: unknown option '" + f + "' for " + command)
            exit(1)
    return files

fn run_cli() -> String!:
    a := args()
    if a.len() < 2:
        print_help()
        exit(1)

    command := a[1]

    if command == "version":
        print_version()
        return ""
    if command == "--version":
        print_version()
        return ""
    if command == "help":
        print_help()
        return ""
    if command == "--help":
        print_help()
        return ""

    if command == "check":
        files := file_operands(a, "check", "--json")
        if files.len() > 1:
            print_err("error: check takes one file, and '" + files[1] + "' is a second one")
            exit(1)
        _result := cmd_check(files[0], a[2] == "--json")!
        return ""

    # fmt and lint check every file given and fail when any of them fails
    if command == "fmt":
        mut ok := true
        for path in file_operands(a, "fmt", "--check"):
            if not cmd_fmt(path, a[2] == "--check"):
                ok = false
        if not ok:
            exit(1)
        return ""

    if command == "lint":
        mut ok := true
        for path in file_operands(a, "lint", "--json"):
            if not cmd_lint(path, a[2] == "--json"):
                ok = false
        if not ok:
            exit(1)
        return ""

    if command == "doc":
        if a.len() < 3:
            print("usage: pith doc [--json|--check] <file.pith>")
            print("       pith doc --check <file.md>...")
            print("       pith doc <topic>|<file.md>")
            print("       pith doc search <query>")
            print("topics: " + guide_names(guides_dir()))
            exit(1)
        if a[2] == "search":
            if a.len() < 4:
                print("usage: pith doc search <query>")
                exit(1)
            _result := cmd_doc_search(a[3])!
            return ""
        if a[2] == "--json":
            if a.len() < 4:
                print("usage: pith doc --json <file.pith>")
                exit(1)
            _result := cmd_doc(a[3], true)!
        elif a[2] == "--check":
            mut ok := true
            for path in file_operands(a, "doc", "--check"):
                if not cmd_doc_check(path):
                    ok = false
            if not ok:
                exit(1)
        elif a[2].ends_with(".md") or (not a[2].ends_with(".pith") and not file_exists(a[2])):
            if not cmd_doc_page(a[2]):
                exit(1)
        else:
            _result := cmd_doc(a[2], false)!
        return ""

    if command == "package":
        if a.len() < 3:
            print("usage: pith package <check|test|lint|doc|deps|lock|install|inspect|context>")
            exit(1)
        _result := cmd_package(a[2], a)!
        return ""

    if command == "new":
        if a.len() < 3:
            print("usage: pith new <name>")
            exit(1)
        _result := cmd_new(a[2])!
        return ""

    if command == "lsp":
        exit(run_lsp_server(PITH_VERSION))
        return ""

    if a.len() < 3:
        print("usage: pith " + command + " <file.pith>")
        exit(1)

    path := a[2]

    if command == "lex":
        _result := cmd_lex(path)!

    elif command == "build":
        _result := cmd_build(path, a.slice(3, a.len()))!

    elif command == "run":
        _result := cmd_run(path, a.slice(3, a.len()))!

    elif command == "test":
        _result := cmd_test(path, a.slice(3, a.len()))!

    elif command == "parse":
        _result := cmd_parse(path)!

    else:
        print("unknown command: " + command)
        print_help()
        exit(1)

    return ""

# an error that nothing below handled fails the command with a message
# and status 1
fn main():
    default_pith_home()
    result := run_cli()
    if result.is_err:
        print_err("error: " + result.err)
        exit(1)
