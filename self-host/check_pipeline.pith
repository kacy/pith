# check_pipeline.pith — the reusable front-end pipeline
#
# lex → parse → resolve imports → check, with nothing printed and no
# exit() on any path. cmd_check and cmd_lint render its outcome for the
# terminal; a long-lived tool holding editor buffers runs it repeatedly
# through the driver's source overlays and reads the outcome directly.

from lexer import lex_all
from parser import parse_with_file, parser_diagnostics, parser_has_errors
from ast import reset_arena, get_node, node_count, truncate_arena, take_nodes_from, append_relocated_nodes
from driver import init_driver, begin_driver, resolve_imports, resolve_import_list, find_imports, import_positions, record_entry_node_range, dr_read_source, get_driver_parse_diagnostics, driver_has_parse_errors, get_resolved_module_path, get_resolved_module_file, set_source_overlay, clear_source_overlays, file_for_node, import_timing_line, import_module_timings, walk_module_files, walk_is_unchanged, DriverSnapshot, take_driver_snapshot, restore_driver_snapshot
from checker import initialize_checker, set_checker_module_path, set_checker_file_path, c_run_module, get_definition_of, CheckerSnapshot, take_checker_snapshot, restore_checker_snapshot
from errors import Diagnostic
from std.collections import copy_list
import std.time as time

# where the last run's wall time went, in milliseconds per phase. the
# clock reads cost nothing next to the phases they bracket, so the split
# is collected unconditionally; the lsp server logs it on request and
# every other caller ignores it.
mut timing_lex_ms := 0
mut timing_parse_ms := 0
mut timing_imports_ms := 0
mut timing_check_ms := 0
mut timing_module_count := 0
mut timing_parse_only_ms := 0
# what the closure cache did on the last run: "off" when the cache is not
# enabled, "hit" when the imports were reused, "miss" when they were
# walked and checked again. the snapshot figure is what copying the state
# in or out cost.
mut timing_cache := "off"
mut timing_snapshot_ms := 0

# how long the checker spent on each module of the last run, in
# microseconds, in the order it checked them — imports first, entry
# file last.
mut timing_check_files: List[String] := []
mut timing_check_us: List[Int] := []

## the last pipeline run's phase split, rendered for a log line:
## reading and lexing the entry file, parsing it, resolving (which
## lexes, parses, and reads every import), and checking the closure.
pub fn last_timing_line() -> String:
    total := timing_lex_ms + timing_parse_ms + timing_imports_ms + timing_check_ms
    return "total={total}ms lex={timing_lex_ms}ms parse={timing_parse_ms}ms imports={timing_imports_ms}ms check={timing_check_ms}ms modules={timing_module_count} cache={timing_cache} snapshot={timing_snapshot_ms}ms"

## the last run broken down one line per module: an "import" line per
## file the walk read (locating, reading, lexing, and parsing it) and a
## "check" line per module the checker ran over, both in microseconds.
## the leading line splits the import phase by activity, so a closure
## that spends its time probing the filesystem is told apart from one
## that spends it parsing.
pub fn last_module_timing_lines() -> List[String]:
    mut lines: List[String] := []
    lines.push("imports " + import_timing_line())
    for entry in import_module_timings():
        lines.push("import " + entry)
    mut i := 0
    while i < timing_check_files.len():
        lines.push("check " + timing_check_files[i] + " " + timing_check_us[i].to_string() + "us")
        i = i + 1
    return lines

## one front-end run's result. a parse failure carries the parser's
## diagnostics with parse_ok false; an unresolvable or unparsable
## import carries the driver's diagnostics with import_ok false; only
## when both flags are true did the checker run, and diags holds what
## it reported (possibly nothing).
pub struct CheckOutcome:
    pub parse_ok: Bool
    pub import_ok: Bool
    pub diags: List[Diagnostic]
    pub root: Int
    pub import_roots: List[Int]

## how long the last run_parse_only call took, in milliseconds.
pub fn last_parse_only_ms() -> Int:
    return timing_parse_only_ms

## lex and parse one file and hand back only what the parser found.
## no imports are resolved and the checker never runs, so this costs
## what one file costs to parse rather than what its whole closure
## costs to check — the difference between tens of milliseconds and
## seconds on a large closure.
##
## the node arena is restored to exactly what it held on entry, so this
## can run against an arena a completed analysis is still being read
## from: the type cache, the definition map and the module ranges all
## still describe the same nodes afterwards. sources are read through
## the driver's overlays like every other entry point.
pub fn run_parse_only(path: String) -> List[Diagnostic]!:
    started := time.mono_millis()
    source := dr_read_source(path)!
    mark := node_count()
    tokens := lex_all(source)
    _root := parse_with_file(tokens, path)
    mut diags: List[Diagnostic] := []
    if parser_has_errors():
        diags = parser_diagnostics()
    truncate_arena(mark)
    timing_parse_only_ms = time.mono_millis() - started
    return diags

# ---------------------------------------------------------------
# the closure cache
# ---------------------------------------------------------------
#
# a long-lived tool runs the pipeline on the same entry file over and
# over, and nearly every run finds the import closure exactly as it was:
# the edit was in the entry file. the cache keeps what the imports
# produced, so such a run reads, lexes, parses and checks the entry file
# alone.
#
# what it keeps: the imports' nodes, left in place at the front of the
# arena; the driver's state after the walk; and the checker's whole
# state after the imports were checked, copied out. what it keys on:
# the entry path, the entry's import list in order, and the walk itself
# validated edge by edge and file by file (walk_is_unchanged), so an
# edited module, an edited overlay, a file that appeared or vanished on
# a resolution path, all miss.
#
# the arena order is the trick that makes the node indices stable. the
# plain pipeline parses the entry file first, at index 0, so an import's
# nodes shift whenever the entry file changes length. here the entry
# file is parsed, its imports are read off its nodes, and its nodes are
# lifted out (take_nodes_from) so the walk parses the imports from index
# 0; then the entry's nodes go back at the end, child indices shifted.
# a later run truncates the arena to the imports' end and parses the new
# entry text there. every index the checker's tables hold for an import
# is the same index it was.
#
# one entry at a time: the arena is one global list, so a snapshot for
# a second entry file would need its own arena. switching documents
# misses and rebuilds.

mut closure_cache_enabled := false
mut closure_cache_ready := false
mut cache_entry_path := ""
mut cache_imports: List[String] := []
mut cache_prefix_end := 0
mut cache_import_roots: List[Int] := []
# one-element lists rather than optionals: replacing the list releases
# the snapshot it held.
mut cache_driver: List[DriverSnapshot] := []
mut cache_checker: List[CheckerSnapshot] := []

## turn the closure cache on for every run_check_pipeline from here on.
## the language server calls this once; `pith check` never does, so a
## one-shot compile keeps the plain pipeline and the entry-first arena.
pub fn enable_closure_cache():
    closure_cache_enabled = true

## drop whatever the cache holds. the next run walks the closure again.
pub fn clear_closure_cache():
    closure_cache_ready = false
    cache_driver = []
    cache_checker = []
    cache_imports = []
    cache_import_roots = []

## the module files the last run's closure covered, in walk order — what
## a change to any of those files invalidates.
pub fn last_closure_files() -> List[String]:
    return walk_module_files()

fn same_imports(imports: List[String]) -> Bool:
    if imports.len() != cache_imports.len():
        return false
    for imp, i in imports:
        if imp != cache_imports[i]:
            return false
    return true

# check the entry file at `root` after the imports, whichever way the
# imports got there, and finish the outcome.
fn check_entry(path: String, root: Int, import_roots: List[Int], resolved: Int) -> CheckOutcome:
    set_checker_module_path("")
    set_checker_file_path(path)
    entry_started := time.mono_nanos()
    diags := c_run_module(root)
    timing_check_files.push(path)
    timing_check_us.push((time.mono_nanos() - entry_started) / 1000)
    timing_check_ms = time.mono_millis() - resolved
    return CheckOutcome(true, true, diags, root, import_roots)

fn run_cached_pipeline(path: String) -> CheckOutcome!:
    started := time.mono_millis()
    source := dr_read_source(path)!
    tokens := lex_all(source)
    lexed := time.mono_millis()
    timing_lex_ms = lexed - started
    timing_snapshot_ms = 0
    # the imports' nodes stay where they are; only the entry file is
    # parsed again, after them
    mut entry_start := 0
    if closure_cache_ready and cache_entry_path == path:
        truncate_arena(cache_prefix_end)
        entry_start = cache_prefix_end
    else:
        clear_closure_cache()
        reset_arena()
    mut root := parse_with_file(tokens, path)
    parsed := time.mono_millis()
    timing_parse_ms = parsed - lexed
    timing_imports_ms = 0
    timing_check_ms = 0
    timing_module_count = 1
    timing_check_files = []
    timing_check_us = []
    timing_cache = "miss"

    if parser_has_errors():
        mut no_imports: List[Int] := []
        return CheckOutcome(false, false, parser_diagnostics(), root, no_imports)

    imports := find_imports(root)
    if closure_cache_ready and same_imports(imports) and walk_is_unchanged(cache_driver[0]):
        restore_started := time.mono_millis()
        restore_driver_snapshot(cache_driver[0])
        record_entry_node_range(entry_start, node_count(), path)
        restore_checker_snapshot(cache_checker[0])
        timing_snapshot_ms = time.mono_millis() - restore_started
        import_roots := copy_list(cache_import_roots)
        resolved := time.mono_millis()
        timing_imports_ms = resolved - parsed
        timing_module_count = import_roots.len() + 1
        timing_cache = "hit"
        return check_entry(path, root, import_roots, resolved)

    # a miss: walk the closure from index 0 with the entry's nodes lifted
    # out, then put them back after the imports
    positions := import_positions(root, imports)
    taken := take_nodes_from(entry_start)
    reset_arena()
    begin_driver(path)
    import_roots := resolve_import_list(imports, positions.0, positions.1, path)!
    root = root + append_relocated_nodes(taken, entry_start)
    resolved := time.mono_millis()
    timing_imports_ms = resolved - parsed
    timing_module_count = import_roots.len() + 1
    if driver_has_parse_errors():
        return CheckOutcome(true, false, get_driver_parse_diagnostics(), root, import_roots)
    prefix_end := node_count() - taken.len()
    record_entry_node_range(prefix_end, node_count(), path)

    initialize_checker(path)
    for imp_root in import_roots:
        module_file := get_resolved_module_file(imp_root)
        set_checker_module_path(get_resolved_module_path(imp_root))
        set_checker_file_path(module_file)
        module_started := time.mono_nanos()
        c_run_module(imp_root)
        timing_check_files.push(module_file)
        timing_check_us.push((time.mono_nanos() - module_started) / 1000)
    snapshot_started := time.mono_millis()
    cache_driver = [take_driver_snapshot()]
    cache_checker = [take_checker_snapshot()]
    cache_entry_path = path
    cache_imports = copy_list(imports)
    cache_prefix_end = prefix_end
    cache_import_roots = copy_list(import_roots)
    closure_cache_ready = true
    timing_snapshot_ms = time.mono_millis() - snapshot_started
    return check_entry(path, root, import_roots, resolved)

## run the whole front end for one entry file. sources are read through
## the driver's overlays, so a caller can check unsaved buffers.
pub fn run_check_pipeline(path: String) -> CheckOutcome!:
    if closure_cache_enabled:
        return run_cached_pipeline(path)!
    timing_cache = "off"
    timing_snapshot_ms = 0
    started := time.mono_millis()
    source := dr_read_source(path)!
    tokens := lex_all(source)
    lexed := time.mono_millis()
    timing_lex_ms = lexed - started
    reset_arena()
    root := parse_with_file(tokens, path)
    parsed := time.mono_millis()
    timing_parse_ms = parsed - lexed
    timing_imports_ms = 0
    timing_check_ms = 0
    timing_module_count = 1
    timing_check_files = []
    timing_check_us = []

    if parser_has_errors():
        mut no_imports: List[Int] := []
        return CheckOutcome(false, false, parser_diagnostics(), root, no_imports)

    init_driver(path)
    import_roots := resolve_imports(root, path)!
    resolved := time.mono_millis()
    timing_imports_ms = resolved - parsed
    timing_module_count = import_roots.len() + 1
    if driver_has_parse_errors():
        return CheckOutcome(true, false, get_driver_parse_diagnostics(), root, import_roots)

    initialize_checker(path)
    for imp_root in import_roots:
        module_file := get_resolved_module_file(imp_root)
        set_checker_module_path(get_resolved_module_path(imp_root))
        set_checker_file_path(module_file)
        module_started := time.mono_nanos()
        c_run_module(imp_root)
        timing_check_files.push(module_file)
        timing_check_us.push((time.mono_nanos() - module_started) / 1000)
    set_checker_module_path("")
    set_checker_file_path(path)
    entry_started := time.mono_nanos()
    diags := c_run_module(root)
    timing_check_files.push(path)
    timing_check_us.push((time.mono_nanos() - entry_started) / 1000)
    timing_check_ms = time.mono_millis() - resolved
    return CheckOutcome(true, true, diags, root, import_roots)

## the checker's use-site -> declaration map rendered by position, one
## "useLine:useCol -> defLine:defCol" entry per resolution, sorted so
## callers and tests see a deterministic order.
pub fn definition_pairs() -> List[String]:
    defs := get_definition_of()
    mut pairs: List[String] := []
    for use_idx in defs.keys():
        use_node := get_node(use_idx)
        def_node := get_node(defs[use_idx])
        pairs.push(use_node.line.to_string() + ":" + use_node.col.to_string() + " -> " + def_node.line.to_string() + ":" + def_node.col.to_string())
    return pairs.sort()

test "pipeline checks a program held only in an overlay":
    set_source_overlay("__overlay_ok.pith", "fn main():\n    print(\"hi\")\n")
    outcome := run_check_pipeline("__overlay_ok.pith")!
    assert(outcome.parse_ok)
    assert(outcome.import_ok)
    assert_eq(outcome.diags.len(), 0)
    clear_source_overlays()

test "pipeline reports checker diagnostics from an overlay":
    set_source_overlay("__overlay_bad.pith", "fn main():\n    x := 1 + \"two\"\n    print(x.to_string())\n")
    outcome := run_check_pipeline("__overlay_bad.pith")!
    assert(outcome.parse_ok)
    assert(outcome.import_ok)
    assert(outcome.diags.len() > 0)
    clear_source_overlays()

test "parse-only reports the parser's findings and leaves the arena alone":
    set_source_overlay("__overlay_syntax_bad.pith", "fn main(:\n")
    set_source_overlay("__overlay_syntax_ok.pith", "fn main():\n    print(\"hi\")\n")
    # a completed analysis the editor would still be reading from
    outcome := run_check_pipeline("__overlay_syntax_ok.pith")!
    assert(outcome.parse_ok)
    before := node_count()
    root_kind := get_node(outcome.root).kind

    bad := run_parse_only("__overlay_syntax_bad.pith")!
    assert(bad.len() > 0)
    # the throwaway parse left no nodes of its own behind, so every
    # index the analysis handed out still points at the same node
    assert_eq(node_count(), before)
    assert_eq(get_node(outcome.root).kind, root_kind)

    good := run_parse_only("__overlay_syntax_ok.pith")!
    assert_eq(good.len(), 0)
    assert_eq(node_count(), before)
    clear_source_overlays()

test "pipeline reports parse failures without checking":
    set_source_overlay("__overlay_parse.pith", "fn main(:\n")
    outcome := run_check_pipeline("__overlay_parse.pith")!
    assert(not outcome.parse_ok)
    assert(outcome.diags.len() > 0)
    clear_source_overlays()

test "definition map links uses of a local back to its binding":
    set_source_overlay("__overlay_defs.pith", "fn main():\n    x := 41\n    y := x + x\n    print(y.to_string())\n")
    outcome := run_check_pipeline("__overlay_defs.pith")!
    assert(outcome.parse_ok)
    assert_eq(outcome.diags.len(), 0)
    pairs := definition_pairs()
    assert_eq(pairs.len(), 3)
    # both uses of x on line 3 resolve to the line-2 binding, and the
    # use of y on line 4 resolves to the line-3 binding. a binding node
    # sits at its last token's start, so "x := 41" lands on the 41
    assert(pairs[0].starts_with("3:") and pairs[0].ends_with("-> 2:10"))
    assert(pairs[1].starts_with("3:") and pairs[1].ends_with("-> 2:10"))
    assert(pairs[2].starts_with("4:") and pairs[2].ends_with("-> 3:14"))
    clear_source_overlays()

test "definition map links a call to the function it names":
    set_source_overlay("__overlay_call.pith", "fn helper() -> Int:\n    return 7\n\nfn main():\n    print(helper().to_string())\n")
    outcome := run_check_pipeline("__overlay_call.pith")!
    assert(outcome.parse_ok)
    assert_eq(outcome.diags.len(), 0)
    pairs := definition_pairs()
    # the callee ident on line 5 resolves to the helper declaration; a
    # declaration node carries the position of its last token, so the
    # definition lands on line 2 (the end of helper's body)
    assert_eq(pairs.len(), 1)
    assert(pairs[0].starts_with("5:"))
    assert(pairs[0].ends_with("-> 2:12"))
    clear_source_overlays()

test "definition map crosses modules through a qualified call":
    set_source_overlay("__overlay_dhelper.pith", "pub fn seven() -> Int:\n    return 7\n")
    set_source_overlay("__overlay_dmain.pith", "import __overlay_dhelper\n\nfn main():\n    print(__overlay_dhelper.seven().to_string())\n")
    outcome := run_check_pipeline("__overlay_dmain.pith")!
    assert(outcome.parse_ok)
    assert(outcome.import_ok)
    assert_eq(outcome.diags.len(), 0)
    defs := get_definition_of()
    # the qualified call in main resolves to the helper's declaration,
    # which lives in the helper module's file
    mut found := false
    for use_idx in defs.keys():
        def_idx := defs[use_idx]
        if file_for_node(def_idx) == "__overlay_dhelper.pith":
            assert_eq(file_for_node(use_idx), "__overlay_dmain.pith")
            # the declaration node sits at its last token, line 2
            assert_eq(get_node(def_idx).line, 2)
            found = true
    assert(found)
    clear_source_overlays()

test "file_for_node attributes nodes to the module that parsed them":
    set_source_overlay("__overlay_helper.pith", "pub fn greet() -> String:\n    return \"hello\"\n")
    set_source_overlay("__overlay_main.pith", "import __overlay_helper\n\nfn main():\n    print(__overlay_helper.greet())\n")
    outcome := run_check_pipeline("__overlay_main.pith")!
    assert(outcome.parse_ok)
    assert(outcome.import_ok)
    assert_eq(outcome.import_roots.len(), 1)
    assert_eq(file_for_node(outcome.root), "__overlay_main.pith")
    assert_eq(file_for_node(outcome.import_roots[0]), "__overlay_helper.pith")
    clear_source_overlays()

test "closure cache answers a root edit the way a cold run does":
    set_source_overlay("__cache_util.pith", "pub fn seven() -> Int:\n    return 7\n")
    set_source_overlay("__cache_main.pith", "import __cache_util\n\nfn main():\n    x := __cache_util.seven()\n    print(x.to_string())\n")
    enable_closure_cache()
    cold := run_check_pipeline("__cache_main.pith")!
    assert(cold.parse_ok and cold.import_ok)
    assert_eq(cold.diags.len(), 0)
    assert_eq(cold.import_roots.len(), 1)
    cold_pairs := definition_pairs()
    # the imports come first in the arena now, the entry file last
    assert(cold.import_roots[0] < cold.root)
    assert_eq(file_for_node(cold.import_roots[0]), "__cache_util.pith")
    assert_eq(file_for_node(cold.root), "__cache_main.pith")
    # an edit to the root: the import's node keeps its index and the
    # answers are the cold run's
    set_source_overlay("__cache_main.pith", "import __cache_util\n\nfn main():\n    x := __cache_util.seven()\n    print(x.to_string())\n# edited\n")
    warm := run_check_pipeline("__cache_main.pith")!
    assert(warm.parse_ok and warm.import_ok)
    assert_eq(warm.diags.len(), 0)
    assert_eq(warm.import_roots[0], cold.import_roots[0])
    assert_eq(definition_pairs().join(","), cold_pairs.join(","))
    assert_eq(file_for_node(warm.root), "__cache_main.pith")
    # an edit that breaks the call is reported against the cached imports
    set_source_overlay("__cache_main.pith", "import __cache_util\n\nfn main():\n    x := __cache_util.seven(1)\n    print(x.to_string())\n")
    broken := run_check_pipeline("__cache_main.pith")!
    assert(broken.import_ok)
    assert_eq(broken.diags.len(), 1)
    assert_eq(broken.diags[0].code, "E207")
    clear_closure_cache()
    clear_source_overlays()

test "closure cache misses when an import changes and reports the new signature":
    set_source_overlay("__cache2_util.pith", "pub fn seven() -> Int:\n    return 7\n")
    set_source_overlay("__cache2_main.pith", "import __cache2_util\n\nfn main():\n    print(__cache2_util.seven().to_string())\n")
    enable_closure_cache()
    first := run_check_pipeline("__cache2_main.pith")!
    assert_eq(first.diags.len(), 0)
    # the module grows a parameter: the cached imports must not answer
    set_source_overlay("__cache2_util.pith", "pub fn seven(n: Int) -> Int:\n    return n\n")
    second := run_check_pipeline("__cache2_main.pith")!
    assert(second.parse_ok and second.import_ok)
    assert_eq(second.diags.len(), 1)
    assert_eq(second.diags[0].code, "E207")
    # and back again
    set_source_overlay("__cache2_util.pith", "pub fn seven() -> Int:\n    return 7\n")
    third := run_check_pipeline("__cache2_main.pith")!
    assert_eq(third.diags.len(), 0)
    clear_closure_cache()
    clear_source_overlays()

test "closure cache misses when the entry's import list changes":
    set_source_overlay("__cache3_a.pith", "pub fn one() -> Int:\n    return 1\n")
    set_source_overlay("__cache3_b.pith", "pub fn two() -> Int:\n    return 2\n")
    set_source_overlay("__cache3_main.pith", "import __cache3_a\n\nfn main():\n    print(__cache3_a.one().to_string())\n")
    enable_closure_cache()
    first := run_check_pipeline("__cache3_main.pith")!
    assert_eq(first.import_roots.len(), 1)
    set_source_overlay("__cache3_main.pith", "import __cache3_a\nimport __cache3_b\n\nfn main():\n    print((__cache3_a.one() + __cache3_b.two()).to_string())\n")
    second := run_check_pipeline("__cache3_main.pith")!
    assert(second.parse_ok and second.import_ok)
    assert_eq(second.diags.len(), 0)
    assert_eq(second.import_roots.len(), 2)
    assert_eq(file_for_node(second.import_roots[1]), "__cache3_b.pith")
    clear_closure_cache()
    clear_source_overlays()

test "parse-only leaves a cached closure's arena alone":
    set_source_overlay("__cache4_util.pith", "pub fn seven() -> Int:\n    return 7\n")
    set_source_overlay("__cache4_main.pith", "import __cache4_util\n\nfn main():\n    print(__cache4_util.seven().to_string())\n")
    set_source_overlay("__cache4_bad.pith", "fn main(:\n")
    enable_closure_cache()
    outcome := run_check_pipeline("__cache4_main.pith")!
    before := node_count()
    bad := run_parse_only("__cache4_bad.pith")!
    assert(bad.len() > 0)
    assert_eq(node_count(), before)
    again := run_check_pipeline("__cache4_main.pith")!
    assert_eq(again.import_roots[0], outcome.import_roots[0])
    assert_eq(again.diags.len(), 0)
    clear_closure_cache()
    clear_source_overlays()
