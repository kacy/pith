# std.net.http — HTTP server and client
#
# pith still keeps the original packed-string request api, but the wire-facing
# path now goes through bytes first so request bodies can stay raw when needed.
#
#   import std.net.http as http
#
#   fn handle(fd: Int):
#       req := http.read_request(fd)
#       if http.method(req) == "GET" and http.path(req) == "/":
#           http.send_response(fd, http.html_response(200, "<h1>Hello!</h1>"))
#       else:
#           http.send_response(fd, http.not_found())
import std.bytes as bytes
import std.compress.gzip as gzip
import std.datetime as datetime
import std.encoding as encoding
import std.fs as fs
import std.json as json_mod
import std.log as log
import std.metrics as metrics
import std.net.url as url_mod
import std.net.tls as tls
import std.os.path as path_mod
import std.text.scanner as scanner
import std.time as time_mod
import std.trace as trace
import std.uuid as uuid
from std.concurrent import Context, BlockingError, blocking_cancelled, blocking_deadline_exceeded, blocking_failed
from std.io import BufferedBytesReader, BufferedBytesWriter, BufferedStringReader, TcpStream, FileStream
import std.io as io
# ===============================================================
# MIME Types
# ===============================================================
pub MIME_TEXT := "text/plain"
pub MIME_HTML := "text/html"
pub MIME_JSON := "application/json"
pub MIME_MULTIPART_FORM := "multipart/form-data"
pub MIME_FORM := "application/x-www-form-urlencoded"
pub MIME_CSS := "text/css"
pub MIME_JS := "application/javascript"
pub MIME_SVG := "image/svg+xml"
pub MIME_PNG := "image/png"
pub MIME_JPEG := "image/jpeg"
pub MIME_GIF := "image/gif"
pub MIME_WEBP := "image/webp"
pub MIME_WASM := "application/wasm"
pub MIME_BINARY := "application/octet-stream"
HTTP_FILE_STREAM_CHUNK_SIZE := 4096

# request-size limits for the http/1.1 server paths (plaintext and tls). they
# bound how much one request can make the server buffer, so a client cannot
# exhaust memory with an endless head (slowloris) or a declared-enormous body
# (a content-length DoS). they are the defaults of a ServerConfig, which can
# raise or lower them per server.
#   * MAX_HEADER_BYTES caps the request head — the request line plus header fields.
#   * MAX_REQUEST_BODY caps the request body, whether it is declared by
#     content-length or streamed as chunked. shared with the http/2 server so both
#     front doors buffer at most the same amount.
pub MAX_HEADER_BYTES := 65536
pub MAX_REQUEST_BODY := 10485760

# a chunked-transfer chunk-size line (a hex length plus optional
# extensions) and a trailer line are both tiny in any real request. this
# caps the bytes read while scanning for one line's terminating newline,
# so a peer streaming a newline-less flood on the chunked path cannot grow
# the buffer until the allocator aborts — the chunk-size *value* is already
# checked against MAX_REQUEST_BODY, but the line's own length was not.
CHUNK_LINE_LIMIT := 8192

# how much the tls head reader asks for at a time: one tls record's worth of
# plaintext, so a read takes a whole record rather than leaving most of it on
# the connection's pending tail to be sliced off a byte at a time.
TLS_READ_CHUNK := 16384

# the messages the head and body readers fail with when a limit is exceeded. the
# serve loops match on them to answer with the right status (431 / 413) and then
# close the connection, so a rejected request never leaves unread body bytes to be
# mis-parsed as the next request on a keep-alive connection.
HEADER_LIMIT_MESSAGE := "http: request header fields exceed the maximum"
BODY_LIMIT_MESSAGE := "http: request body exceeds the maximum"

HTTP_RESPONSE_BODY_NONE := 0
HTTP_RESPONSE_BODY_EXACT := 1
HTTP_RESPONSE_BODY_CHUNKED := 2
HTTP_RESPONSE_BODY_UNTIL_CLOSE := 3
# raw request parts plus decoded helpers for bytes-first request handling.
#
# a request read off the wire decodes only its request line up front. the
# header fields, query parameters, path segments and body text are read from
# `head` and `body` when a method asks for them, so headers_text,
# body_text_cache, query_map and path_parts_cache stay empty, and header_map
# holds only fields that replace the head's, such as the Host an absolute-form
# target names. a request built directly with these fields filled still works:
# each method prefers what the fields hold.
pub struct HttpRequestBytes:
    pub head: Bytes
    pub body: Bytes
    pub method_text: String
    pub path_text: String
    pub query_text: String
    pub version_text: String
    pub headers_text: String
    pub body_text_cache: String
    pub header_map: Map[String, String]
    pub query_map: Map[String, String]
    pub path_parts_cache: List[String]

# request metadata returned when a body is streamed into a writer.
pub struct StreamedHttpRequest:
    pub req: HttpRequestBytes
    pub body_size: Int

# structured response data used by the bytes-first server helpers.
pub struct HttpResponse:
    pub status: Int
    pub content_type: String
    pub headers: Map[String, String]
    pub body: Bytes
    pub set_cookie_headers: List[String]
    # http/2 response trailers (a header block sent after the body). empty for
    # ordinary responses; grpc carries its grpc-status/grpc-message here.
    pub trailers: Map[String, String]

# response metadata returned when a body is streamed into a writer.
pub struct StreamedHttpResponse:
    pub status: Int
    pub content_type: String
    pub headers: Map[String, String]
    pub set_cookie_headers: List[String]
    pub body_size: Int

# a small builder for outbound http client requests.
pub struct ClientRequest:
    pub method: String
    pub host: String
    pub port: Int
    pub path: String
    pub headers: Map[String, String]
    pub body: Bytes
    pub use_tls: Bool
    pub timeout_ms: Int
    pub redirect_limit: Int

# a reusable plain http client connection.
pub struct ClientConn:
    pub stream: TcpStream
    pub reader: BufferedBytesReader
    pub writer: BufferedBytesWriter

# a reusable tls http client connection.
pub struct TlsClientConn:
    pub conn: tls.Conn

# cookie builder used by request and response helpers.
pub struct Cookie:
    pub name: String
    pub value: String
    pub path_text: String
    pub domain_text: String
    pub expires_text: String
    pub max_age_seconds: Int
    pub secure_flag: Bool
    pub http_only_flag: Bool
    pub same_site_value: String

# one multipart/form-data part.
pub struct MultipartPart:
    pub name: String
    pub filename: String
    pub content_type: String
    pub headers: Map[String, String]
    pub body: Bytes

struct ResponseBodyPlan:
    kind: Int
    content_length: Int

fn str_eq(a: String, b: String) -> Bool:
    if a.len() != b.len():
        return false
    mut i := 0
    while i < a.len():
        if ord(a[i]) != ord(b[i]):
            return false
        i = i + 1
    return true
fn char_eq(s: String, idx: Int, ch: String) -> Bool:
    return ord(s[idx]) == ord(ch)

fn normalize_path(path: String) -> String:
    if path == "":
        return "/"
    return path

fn quoted_filename(name: String) -> String:
    return chr(34) + name + chr(34)

fn fallback_download_name(file_path: String) -> String:
    name := path_mod.base(file_path)
    if name == "":
        return "download"
    return name

fn content_type_for_extension(ext: String) -> String:
    if ext == ".html" or ext == ".htm":
        return MIME_HTML
    if ext == ".txt":
        return MIME_TEXT
    if ext == ".json":
        return MIME_JSON
    if ext == ".css":
        return MIME_CSS
    if ext == ".js" or ext == ".mjs":
        return MIME_JS
    if ext == ".svg":
        return MIME_SVG
    if ext == ".png":
        return MIME_PNG
    if ext == ".jpg" or ext == ".jpeg":
        return MIME_JPEG
    if ext == ".gif":
        return MIME_GIF
    if ext == ".webp":
        return MIME_WEBP
    if ext == ".wasm":
        return MIME_WASM
    return MIME_BINARY

# Return the response content type to use for a file path.
pub fn content_type_for_path(file_path: String) -> String:
    return content_type_for_extension(path_mod.ext(file_path).to_lower())

fn copy_headers_map(headers: Map[String, String]) -> Map[String, String]:
    mut copied: Map[String, String] := {}
    for key in headers:
        copied.insert(key, headers[key])
    return copied

fn copy_string_list(items: List[String]) -> List[String]:
    mut copied: List[String] := []
    for item in items:
        copied.push(item)
    return copied

fn parse_cookie_map(header_value: String) -> Map[String, String]:
    mut cookies: Map[String, String] := {}
    if header_value == "":
        return cookies
    for part in header_value.split(";"):
        entry := part.trim()
        if entry == "":
            continue
        eq := entry.index_of("=")
        if eq <= 0:
            continue
        name := entry.substring(0, eq).trim()
        value := entry.substring(eq + 1, entry.len()).trim()
        if name != "":
            cookies.insert(name, value)
    return cookies

fn append_cookie_header(existing: String, name: String, value: String) -> String:
    pair := name + "=" + value
    if existing == "":
        return pair
    return existing + "; " + pair

fn serialize_cookie(item: Cookie) -> String:
    mut out := item.name + "=" + item.value
    if item.path_text != "":
        out = out + "; Path=" + item.path_text
    if item.domain_text != "":
        out = out + "; Domain=" + item.domain_text
    if item.expires_text != "":
        out = out + "; Expires=" + item.expires_text
    if item.max_age_seconds >= 0:
        out = out + "; Max-Age=" + item.max_age_seconds.to_string()
    if item.secure_flag:
        out = out + "; Secure"
    if item.http_only_flag:
        out = out + "; HttpOnly"
    if item.same_site_value != "":
        out = out + "; SameSite=" + item.same_site_value
    return out

fn streamed_file_info(file_path: String) -> fs.Info!:
    meta := fs.info(file_path)!
    if meta.is_dir:
        fail "http file response path must be a file: " + file_path
    return meta

fn static_file_response(response: HttpResponse, file_path: String) -> HttpResponse:
    return response.content_type(content_type_for_path(file_path))

fn download_file_response(response: HttpResponse, file_path: String, download_name: String) -> HttpResponse:
    mut name := download_name
    if name == "":
        name = fallback_download_name(file_path)
    return static_file_response(response, file_path).header("Content-Disposition", "attachment; filename=" + quoted_filename(name))

fn output_file_writer(file: FileStream) -> BufferedBytesWriter:
    return file.buffered_bytes_writer_chunked(HTTP_FILE_STREAM_CHUNK_SIZE)

fn finish_output_file_writer(file: FileStream, writer: BufferedBytesWriter) -> Int!:
    writer.flush()!
    file.close()
    return 0

fn trim_quotes(value: String) -> String:
    if value.len() >= 2 and value[0] == chr(34) and value[value.len() - 1] == chr(34):
        return value.substring(1, value.len() - 1)
    return value

fn header_param_value(header_value: String, key: String) -> String:
    for part in header_value.split(";"):
        entry := part.trim()
        eq := entry.index_of("=")
        if eq <= 0:
            continue
        name := entry.substring(0, eq).trim()
        if name.to_lower() != key.to_lower():
            continue
        return trim_quotes(entry.substring(eq + 1, entry.len()).trim())
    return ""

fn multipart_boundary_from_content_type(content_type: String) -> String!:
    if not content_type.to_lower().starts_with(MIME_MULTIPART_FORM):
        fail "request is not multipart/form-data"
    boundary := header_param_value(content_type, "boundary")
    if boundary == "":
        fail "multipart boundary is missing"
    return boundary

fn bytes_starts_with_at(data: Bytes, start: Int, needle: Bytes) -> Bool:
    if start < 0 or start + needle.len() > data.len():
        return false
    mut i := 0
    while i < needle.len():
        if data[start + i] != needle[i]:
            return false
        i = i + 1
    return true

fn find_bytes(data: Bytes, start: Int, needle: Bytes) -> Int:
    if needle.len() == 0:
        return start
    mut pos := start
    while pos + needle.len() <= data.len():
        if bytes_starts_with_at(data, pos, needle):
            return pos
        pos = pos + 1
    return -1

fn multipart_header_bounds(data: Bytes, start: Int) -> List[Int]:
    crlf := bytes.from_string_utf8(chr(13) + chr(10) + chr(13) + chr(10))
    lf := bytes.from_string_utf8(chr(10) + chr(10))
    crlf_pos := find_bytes(data, start, crlf)
    lf_pos := find_bytes(data, start, lf)
    if crlf_pos >= 0 and (lf_pos < 0 or crlf_pos <= lf_pos):
        return [crlf_pos, 4]
    if lf_pos >= 0:
        return [lf_pos, 2]
    return []

fn parse_header_text_map(text: String) -> Map[String, String]:
    mut result: Map[String, String] := {}
    mut cur := scanner.new(text)
    while not scanner.done(cur):
        scanned := scanner.take_line(cur)
        cur = scanned.cursor
        line := scanned.slice.text.trim()
        if line == "":
            continue
        colon := line.index_of(":")
        if colon <= 0:
            continue
        name := line.substring(0, colon).trim()
        value := line.substring(colon + 1, line.len()).trim()
        result = header_with(result, name, value)
    return result

fn multipart_find_next_boundary(data: Bytes, start: Int, boundary: String) -> List[Int]:
    crlf_marker := bytes.from_string_utf8(chr(13) + chr(10) + "--" + boundary)
    lf_marker := bytes.from_string_utf8(chr(10) + "--" + boundary)
    crlf_pos := find_bytes(data, start, crlf_marker)
    lf_pos := find_bytes(data, start, lf_marker)
    if crlf_pos >= 0 and (lf_pos < 0 or crlf_pos <= lf_pos):
        return [crlf_pos, 2]
    if lf_pos >= 0:
        return [lf_pos, 1]
    return []

fn multipart_consume_newline(data: Bytes, start: Int) -> Int:
    if start + 1 < data.len() and data[start] == 13 and data[start + 1] == 10:
        return start + 2
    if start < data.len() and data[start] == 10:
        return start + 1
    return start

# parse multipart bodies without decoding the part payloads.
fn parse_multipart_parts(body: Bytes, boundary: String) -> List[MultipartPart]!:
    marker := bytes.from_string_utf8("--" + boundary)
    closing := bytes.from_string_utf8("--")
    first := find_bytes(body, 0, marker)
    if first < 0:
        fail "multipart boundary not found"
    mut pos := first + marker.len()
    if bytes_starts_with_at(body, pos, closing):
        return []
    pos = multipart_consume_newline(body, pos)
    mut parts: List[MultipartPart] := []
    while pos <= body.len():
        header_bounds := multipart_header_bounds(body, pos)
        if header_bounds.len() != 2:
            fail "multipart headers are incomplete"
        headers_raw := body.slice(pos, header_bounds[0])
        headers_text := headers_raw.to_string_utf8()!
        headers := parse_header_text_map(headers_text)
        disposition := header_lookup(headers, "Content-Disposition")
        if disposition == "":
            fail "multipart part is missing content-disposition"
        name := header_param_value(disposition, "name")
        if name == "":
            fail "multipart part is missing name"
        filename := header_param_value(disposition, "filename")
        content_type := header_lookup(headers, "Content-Type")
        body_start := header_bounds[0] + header_bounds[1]
        next_boundary := multipart_find_next_boundary(body, body_start, boundary)
        if next_boundary.len() != 2:
            fail "multipart closing boundary not found"
        part_body := body.slice(body_start, next_boundary[0])
        parts.push(MultipartPart(name, filename, content_type, headers, part_body))
        pos = next_boundary[0] + next_boundary[1] + marker.len()
        if bytes_starts_with_at(body, pos, closing):
            break
        pos = multipart_consume_newline(body, pos)
    return parts

fn multipart_content_disposition(part: MultipartPart) -> String:
    mut out := "form-data; name=" + chr(34) + part.name + chr(34)
    if part.filename != "":
        out = out + "; filename=" + chr(34) + part.filename + chr(34)
    return out

fn multipart_random_boundary() -> String!:
    id := uuid.v4()!
    return "pith-boundary-" + id.replace("-", "")

fn encode_multipart(parts: List[MultipartPart], boundary: String) -> Bytes!:
    crlf := chr(13) + chr(10)
    out := bytes.buffer()
    errdefer out.free()
    for part in parts:
        out.write_string_utf8("--" + boundary + crlf)!
        out.write_string_utf8("Content-Disposition: " + multipart_content_disposition(part) + crlf)!
        if part.content_type != "":
            out.write_string_utf8("Content-Type: " + part.content_type + crlf)!
        for key in part.headers:
            if header_key_matches(key, "Content-Disposition") or header_key_matches(key, "Content-Type"):
                continue
            out.write_string_utf8(key + ": " + part.headers[key] + crlf)!
        out.write_string_utf8(crlf)!
        out.write(part.body)!
        out.write_string_utf8(crlf)!
    out.write_string_utf8("--" + boundary + "--" + crlf)!
    return out.take_bytes()

# header names compare ascii case-insensitively (rfc 9110 5.1), without
# allocating a lowered copy of either.
fn header_key_matches(left: String, right: String) -> Bool:
    if left.len() != right.len():
        return false
    mut i := 0
    while i < left.len():
        if ascii_lower(ord(left[i])) != ascii_lower(ord(right[i])):
            return false
        i = i + 1
    return true

fn header_lookup(headers: Map[String, String], name: String) -> String:
    for key in headers:
        if header_key_matches(key, name):
            return headers[key]
    return ""

fn header_without(headers: Map[String, String], name: String) -> Map[String, String]:
    mut copied: Map[String, String] := {}
    for key in headers:
        if not header_key_matches(key, name):
            copied.insert(key, headers[key])
    return copied

fn header_with(headers: Map[String, String], name: String, value: String) -> Map[String, String]:
    copied := header_without(headers, name)
    copied.insert(name, value)
    return copied

fn append_query_param_to_path(path: String, name: String, value: String) -> String:
    encoded_name := url_mod.encode(name)
    encoded_value := url_mod.encode(value)
    mut separator := "?"
    if path.index_of("?") >= 0:
        separator = "&"
    return normalize_path(path) + separator + encoded_name + "=" + encoded_value

fn form_component_encode(input: String) -> String:
    return url_mod.encode(input).replace("%20", "+")

fn form_encode_fields(fields: Map[String, String]) -> String:
    mut pairs: List[String] := []
    for key in fields:
        pairs.push(form_component_encode(key) + "=" + form_component_encode(fields[key]))
    return pairs.join("&")

# Splits a request path into its non-empty segments, so "/a//b/" and "/a/b"
# both yield ["a", "b"]. Route matching and group-scope checks share this, so
# they agree on which routes a path reaches. the segments stay percent-encoded:
# splitting happens on the raw "/" only, so an encoded slash ("%2F") stays
# inside its segment, and segment_matches decodes a segment when it compares.
pub fn path_segments(path: String) -> List[String]:
    mut parts: List[String] := []
    for part in normalize_path(path).split("/"):
        if part != "":
            parts.push(part)
    return parts

# true when the raw path segment `segment` names `literal` once
# percent-decoded, so "caf%C3%A9" matches "café" and "%61pi" matches "api". a
# segment with no escape is compared as it is, without decoding.
pub fn segment_matches(segment: String, literal: String) -> Bool:
    if segment.index_of("%") < 0:
        return segment == literal
    return url_mod.decode_path(segment) == literal

# how many bytes of `path` from `at` spell one dot: 1 for ".", 3 for an
# encoded "%2e" or "%2E", 0 for anything else.
fn dot_width(path: String, at: Int, end: Int) -> Int:
    if at >= end:
        return 0
    if path[at] == ".":
        return 1
    if at + 3 <= end and path[at] == "%" and path[at + 1] == "2" and (path[at + 2] == "e" or path[at + 2] == "E"):
        return 3
    return 0

# how many dots the segment path[start:end] is made of, when it is a dot
# segment ("." or "..", either dot possibly percent-encoded), or 0 when it is
# not one. an encoded dot counts because a handler that decodes the segment
# sees "..", and the router must not let that through as a name.
fn dot_segment_dots(path: String, start: Int, end: Int) -> Int:
    first := dot_width(path, start, end)
    if first == 0:
        return 0
    if start + first == end:
        return 1
    second := dot_width(path, start + first, end)
    if second > 0 and start + first + second == end:
        return 2
    return 0

# true when clean_path would return `path` unchanged: it starts with "/", has
# no empty segment but a trailing slash, and no "." or ".." segment, encoded
# or not. it reads the path in place, so a clean path costs no allocation.
pub fn path_is_clean(path: String) -> Bool:
    n := path.len()
    if n == 0 or path[0] != "/":
        return false
    mut start := 1
    mut i := 1
    while i <= n:
        if i == n or path[i] == "/":
            if i == start and i < n:
                return false
            if dot_segment_dots(path, start, i) > 0:
                return false
            start = i + 1
        i = i + 1
    return true

# the canonical form of a request path, as net/http's ServeMux computes it: a
# leading "/", repeated slashes collapsed, "." segments dropped and ".."
# segments resolved against the segment before them. a ".." at the root stays
# at the root, so the result never climbs above "/". a trailing slash is kept.
# dot segments are recognized percent-encoded too ("%2e%2e"); every other
# segment is kept as it arrived, escapes and all.
pub fn clean_path(path: String) -> String:
    if path_is_clean(path):
        return path
    # `kept` is a stack whose live part is its first `depth` entries, so a
    # ".." pops by lowering depth and the next name overwrites the slot.
    mut kept: List[String] := []
    mut depth := 0
    for part in path.split("/"):
        if part == "":
            continue
        dots := dot_segment_dots(part, 0, part.len())
        if dots == 1:
            continue
        if dots == 2:
            if depth > 0:
                depth = depth - 1
            continue
        if depth < kept.len():
            kept[depth] = part
        else:
            kept.push(part)
        depth = depth + 1
    if depth == 0:
        return "/"
    mut out := ""
    mut i := 0
    while i < depth:
        out = out + "/" + kept[i]
        i = i + 1
    if path.ends_with("/"):
        out = out + "/"
    return out

# true when the segments of a request path match a route pattern's segments.
# a ":name" pattern segment matches any one segment. a final "*name" segment
# matches whatever is left, including nothing. every other pattern segment
# must equal the path segment once that is percent-decoded.
pub fn segments_match(path_parts: List[String], pattern_parts: List[String]) -> Bool:
    mut fixed := pattern_parts.len()
    if fixed > 0 and pattern_parts[fixed - 1].starts_with("*"):
        fixed = fixed - 1
        if path_parts.len() < fixed:
            return false
    elif path_parts.len() != fixed:
        return false
    mut i := 0
    while i < fixed:
        pat := pattern_parts[i]
        if not pat.starts_with(":") and not segment_matches(path_parts[i], pat):
            return false
        i = i + 1
    return true

# the value of the parameter `name` in a path that segments_match accepted,
# percent-decoded, or "" when the pattern has no such parameter. a "*name"
# parameter is the rest of the path, each segment decoded and joined by "/",
# so an encoded slash inside one segment reads as a "/" in the value.
pub fn segment_param(path_parts: List[String], pattern_parts: List[String], name: String) -> String:
    mut i := 0
    while i < pattern_parts.len():
        pat := pattern_parts[i]
        if pat.len() == name.len() + 1 and pat.substring(1, pat.len()) == name:
            if pat.starts_with(":") and i < path_parts.len():
                return url_mod.decode_path(path_parts[i])
            if pat.starts_with("*"):
                mut rest: List[String] := []
                mut j := i
                while j < path_parts.len():
                    rest.push(url_mod.decode_path(path_parts[j]))
                    j = j + 1
                return rest.join("/")
        i = i + 1
    return ""

fn route_match_path(path: String, pattern: String) -> Bool:
    return segments_match(path_segments(path), path_segments(pattern))

fn route_param_from_path(path: String, pattern: String, name: String) -> String:
    path_parts := path_segments(path)
    pattern_parts := path_segments(pattern)
    if not segments_match(path_parts, pattern_parts):
        return ""
    return segment_param(path_parts, pattern_parts, name)

# splits a query string into decoded (key, value) pairs, first occurrence
# winning, so every reader of a request's query agrees on one answer. keys and
# values are percent-decoded and "+" becomes a space, the same transform the
# encode side applies in reverse; a pair with no "=" is a present key with an
# empty value. splitting on the raw "&"/"=" before decoding is deliberate — a
# "%26" in a value must not read as a separator.
fn query_params_map_from_string(qs: String) -> Map[String, String]:
    mut result: Map[String, String] := {}
    if qs.len() == 0:
        return result
    for pair in qs.split("&"):
        if pair.len() == 0:
            continue
        eq := pair.index_of("=")
        if eq < 0:
            key := url_mod.decode(pair)
            if not result.contains_key(key):
                result.insert(key, "")
            continue
        key := url_mod.decode(pair.substring(0, eq))
        if not result.contains_key(key):
            result.insert(key, url_mod.decode(pair.substring(eq + 1, pair.len())))
    return result

# the values of an application/x-www-form-urlencoded text, a form body or a
# query string, as net/http's url.ParseQuery reads them: keys and values are
# percent-decoded, "+" is a space, and a repeated key keeps every value in the
# order it came. a pair with no "=" is a key with an empty value. splitting
# happens on the raw "&" and "=" before decoding, so an encoded "%26" stays
# inside its value.
pub fn parse_form(text: String) -> Map[String, List[String]]:
    mut values: Map[String, List[String]] := {}
    if text.len() == 0:
        return values
    for pair in text.split("&"):
        if pair.len() == 0:
            continue
        eq := pair.index_of("=")
        mut key := ""
        mut value := ""
        if eq < 0:
            key = url_mod.decode(pair)
        else:
            key = url_mod.decode(pair.substring(0, eq))
            value = url_mod.decode(pair.substring(eq + 1, pair.len()))
        add_form_value(values, key, value)
    return values

fn add_form_value(values: Map[String, List[String]], key: String, value: String):
    if values.contains_key(key):
        values[key].push(value)
    else:
        values.insert(key, [value])

# the media type of a Content-Type value, lowercased, without its parameters.
fn media_type(content_type: String) -> String:
    semi := content_type.index_of(";")
    if semi >= 0:
        return content_type.substring(0, semi).trim().to_lower()
    return content_type.trim().to_lower()

# the form values a request's body carries, as net/http's PostForm holds
# them: only for POST, PUT and PATCH, from an application/x-www-form-urlencoded
# body or from the fields of a multipart/form-data one. a multipart part that
# carries a file is not a value; read it with multipart_part.
fn body_form_values(req: HttpRequestBytes) -> Map[String, List[String]]:
    mut values: Map[String, List[String]] := {}
    method := req.method_text
    if method != "POST" and method != "PUT" and method != "PATCH":
        return values
    kind := media_type(req.header_or("Content-Type", ""))
    if kind == MIME_FORM:
        return parse_form(req.body_text() catch "")
    if kind == MIME_MULTIPART_FORM:
        parsed := req.multipart_parts()
        if parsed.is_err:
            return values
        for part in parsed.ok:
            if not part.is_file():
                add_form_value(values, part.name, part.text_or(""))
    return values

# a user and password from an `Authorization: Basic` header (rfc 7617).
pub struct BasicAuth:
    pub user: String
    pub password: String

# `value` as an http quoted-string, with any quote or backslash escaped.
fn quoted_string(value: String) -> String:
    return chr(34) + value.replace(chr(92), chr(92) + chr(92)).replace(chr(34), chr(92) + chr(34)) + chr(34)

# a 401 that asks for basic credentials for `realm` (rfc 7617), the answer a
# handler gives when basic_auth fails or the credentials are wrong.
pub fn basic_auth_challenge(realm: String) -> HttpResponse:
    return unauthorized_response().header("WWW-Authenticate", "Basic realm=" + quoted_string(realm) + ", charset=" + chr(34) + "UTF-8" + chr(34))

fn parse_json_or_fail(text: String) -> Int!:
    handle := json_mod.parse(text)
    if handle < 0:
        fail "invalid json"
    return handle

fn ctx_blocking_error(ctx: Context) -> BlockingError:
    if ctx.error_code() == 2:
        return blocking_deadline_exceeded()
    return blocking_cancelled()
fn byte_eq(data: Bytes, idx: Int, value: Int) -> Bool:
    return data[idx] == value
fn decode_utf8(data: Bytes) -> String!:
    return data.to_string_utf8()!
fn find_byte(data: Bytes, start: Int, value: Int) -> Int:
    mut i := start
    while i < data.len():
        if data[i] == value:
            return i
        i = i + 1
    return -1
fn trim_ascii_start(data: Bytes, start: Int, end: Int) -> Int:
    mut i := start
    while i < end and (data[i] == 32 or data[i] == 9):
        i = i + 1
    return i
fn trim_ascii_end(data: Bytes, start: Int, end: Int) -> Int:
    mut i := end
    while i > start and (data[i - 1] == 32 or data[i - 1] == 9):
        i = i - 1
    return i
fn trim_trailing_cr(data: Bytes, start: Int, end: Int) -> Int:
    if end > start and data[end - 1] == 13:
        return end - 1
    return end
fn header_name_matches(data: Bytes, start: Int, end: Int, name: String) -> Bool:
    if end - start != name.len():
        return false
    mut i := 0
    while i < name.len():
        if ascii_lower(data[start + i]) != ascii_lower(ord(name[i])):
            return false
        i = i + 1
    return true
# ===============================================================
# Request Parsing
# ===============================================================
# Parse a raw HTTP request. Returns a packed string (use accessors to read fields).
# Pack format: method \x1f route \x1f query \x1f version \x1f headers \x1f body
pub fn parse_request(raw: String) -> String:
    nl := chr(10)
    cr := chr(13)
    sep := chr(31)
    mut header_part := raw
    mut req_body := ""
    raw_len := raw.len()
    double_crlf := cr + nl + cr + nl
    double_lf := nl + nl
    mut sep_pos := raw.index_of(double_crlf)
    if sep_pos >= 0:
        header_part = raw.substring(0, sep_pos)
        req_body = raw.substring(sep_pos + double_crlf.len(), raw_len)
    else:
        sep_pos = raw.index_of(double_lf)
        if sep_pos >= 0:
            header_part = raw.substring(0, sep_pos)
            req_body = raw.substring(sep_pos + double_lf.len(), raw_len)
    mut meth := "GET"
    mut full_path := "/"
    mut ver := "HTTP/1.1"
    mut request_line := ""
    mut hdrs := ""
    if header_part.len() > 0:
        first_line := scanner.take_line(scanner.new(header_part))
        request_line = first_line.slice.text.trim()
        hdrs = scanner.remaining(first_line.cursor).trim()
    if request_line.len() > 0:
        mut sp1 := -1
        mut sp2 := -1
        mut ri := 0
        rl_len := request_line.len()
        while ri < rl_len:
            if char_eq(request_line, ri, " "):
                if sp1 < 0:
                    sp1 = ri
                elif sp2 < 0:
                    sp2 = ri
                    break
            ri = ri + 1
        if sp1 > 0:
            meth = request_line.substring(0, sp1)
        if sp1 >= 0 and sp2 > sp1:
            full_path = request_line.substring(sp1 + 1, sp2)
            ver = request_line.substring(sp2 + 1, rl_len).trim()
        elif sp1 >= 0:
            full_path = request_line.substring(sp1 + 1, rl_len).trim()
    # split path?query
    mut route := full_path
    mut req_query := ""
    mut qi := 0
    fp_len := full_path.len()
    while qi < fp_len:
        if char_eq(full_path, qi, "?"):
            route = full_path.substring(0, qi)
            if qi + 1 < fp_len:
                req_query = full_path.substring(qi + 1, fp_len)
            break
        qi = qi + 1
    # pack fields
    mut p := meth
    p = p + sep
    p = p + route
    p = p + sep
    p = p + req_query
    p = p + sep
    p = p + ver
    p = p + sep
    p = p + hdrs
    p = p + sep
    p = p + req_body
    return p
fn ascii_lower(value: Int) -> Int:
    if value >= 65 and value <= 90:
        return value + 32
    return value
fn request_line_end(raw_head: Bytes) -> Int:
    mut i := 0
    while i < raw_head.len():
        if byte_eq(raw_head, i, 10):
            if i > 0 and byte_eq(raw_head, i - 1, 13):
                return i - 1
            return i
        i = i + 1
    return raw_head.len()
fn headers_block_bounds(raw_head: Bytes) -> List[Int]:
    mut start := request_line_end(raw_head)
    if start < raw_head.len():
        start = start + 1
        if start < raw_head.len() and byte_eq(raw_head, start, 10):
            start = start + 1
    mut end := raw_head.len()
    if end >= 2 and byte_eq(raw_head, end - 2, 13) and byte_eq(raw_head, end - 1, 10):
        end = end - 2
    elif end >= 1 and byte_eq(raw_head, end - 1, 10):
        end = end - 1
    return [start, end]
fn request_line_field_bytes(raw_head: Bytes, field_index: Int) -> Bytes:
    line_end := request_line_end(raw_head)
    mut field_start := 0
    mut field := 0
    mut pos := 0
    while pos <= line_end:
        at_end := pos == line_end
        mut at_space := false
        if not at_end:
            at_space = byte_eq(raw_head, pos, 32)
        if at_end or at_space:
            if field == field_index:
                return raw_head.slice(field_start, pos)
            field = field + 1
            field_start = pos + 1
        pos = pos + 1
    return bytes.empty()
fn request_target_bytes(raw_head: Bytes) -> Bytes:
    return request_line_field_bytes(raw_head, 1)
fn request_target_path_bytes(raw_head: Bytes) -> Bytes:
    target := request_target_bytes(raw_head)
    query_pos := find_byte(target, 0, 63)
    if query_pos >= 0:
        return target.slice(0, query_pos)
    return target
fn request_target_query_bytes(raw_head: Bytes) -> Bytes:
    target := request_target_bytes(raw_head)
    query_pos := find_byte(target, 0, 63)
    if query_pos >= 0 and query_pos + 1 < target.len():
        return target.slice(query_pos + 1, target.len())
    return bytes.empty()
fn headers_bytes(raw_head: Bytes) -> Bytes:
    bounds := headers_block_bounds(raw_head)
    if bounds[0] >= bounds[1]:
        return bytes.empty()
    return raw_head.slice(bounds[0], bounds[1])
fn header_value_bounds(line: Bytes, line_start: Int, line_end: Int, name: String) -> List[Int]:
    colon := find_byte(line, line_start, 58)
    if colon <= line_start or colon >= line_end:
        return []
    if not header_name_matches(line, line_start, colon, name):
        return []
    value_start := trim_ascii_start(line, colon + 1, line_end)
    value_end := trim_ascii_end(line, value_start, line_end)
    return [value_start, value_end]
fn header_value_bytes(raw_head: Bytes, name: String) -> Bytes:
    hdrs := headers_bytes(raw_head)
    mut line_start := 0
    mut pos := 0
    while pos <= hdrs.len():
        at_end := pos == hdrs.len()
        mut at_nl := false
        if not at_end:
            at_nl = hdrs[pos] == 10
        if at_end or at_nl:
            line_end := trim_trailing_cr(hdrs, line_start, pos)
            if line_end > line_start:
                value_bounds := header_value_bounds(hdrs, line_start, line_end, name)
                if value_bounds.len() == 2:
                    return hdrs.slice(value_bounds[0], value_bounds[1])
            line_start = pos + 1
        pos = pos + 1
    return bytes.empty()

# the value of every `name` field in a request head, joined with ", " in the
# order they arrived (rfc 9110 5.3), or "" when there is none. Set-Cookie is
# never combined: the first value wins. Cookie fields are joined with "; ", the
# separator rfc 9113 8.2.3 uses when http/2 splits them. the head is scanned on
# each call instead of being decoded into a map up front, since most handlers
# read only a few fields.
fn head_header_value(raw_head: Bytes, name: String) -> String:
    hdrs := headers_bytes(raw_head)
    mut first_start := 0 - 1
    mut first_end := 0
    mut joined := ""
    mut combined := false
    mut line_start := 0
    while line_start < hdrs.len():
        mut nl := find_byte(hdrs, line_start, 10)
        if nl < 0:
            nl = hdrs.len()
        line_end := trim_trailing_cr(hdrs, line_start, nl)
        colon := line_start + name.len()
        if colon < line_end and hdrs[colon] == 58 and header_name_matches(hdrs, line_start, colon, name):
            value_start := trim_ascii_start(hdrs, colon + 1, line_end)
            value_end := trim_ascii_end(hdrs, value_start, line_end)
            if first_start < 0:
                first_start = value_start
                first_end = value_end
            elif not header_key_matches(name, "Set-Cookie"):
                if not combined:
                    joined = decode_utf8(hdrs.slice(first_start, first_end)) catch ""
                    combined = true
                mut separator := ", "
                if header_key_matches(name, "Cookie"):
                    separator = "; "
                joined = joined + separator + (decode_utf8(hdrs.slice(value_start, value_end)) catch "")
        line_start = nl + 1
    if combined:
        return joined
    if first_start < 0:
        return ""
    return decode_utf8(hdrs.slice(first_start, first_end)) catch ""

# every field in a request head as a map, with lowercase names and repeated
# fields combined as head_header_value does.
fn head_header_fields(raw_head: Bytes) -> Map[String, String]:
    mut result: Map[String, String] := {}
    hdrs := headers_bytes(raw_head)
    mut line_start := 0
    while line_start < hdrs.len():
        mut nl := find_byte(hdrs, line_start, 10)
        if nl < 0:
            nl = hdrs.len()
        line_end := trim_trailing_cr(hdrs, line_start, nl)
        colon := find_byte(hdrs, line_start, 58)
        if colon > line_start and colon < line_end:
            key := (decode_utf8(hdrs.slice(line_start, colon)) catch "").trim().to_lower()
            if key != "" and not result.contains_key(key):
                result.insert(key, head_header_value(raw_head, key))
        line_start = nl + 1
    return result

# lenient parse of a request head (the request line plus header lines) and body
# bytes into an HttpRequestBytes. the http/2 server synthesizes an http/1.1 head
# from the request pseudo-headers and builds its requests here, so both servers
# hand handlers the same type. nothing is validated: the wire readers run
# parse_request_head first. header fields, query parameters and path segments
# are read from the head when a handler asks for them.
pub fn build_http_request(head: Bytes, body: Bytes) -> HttpRequestBytes!:
    method_text := decode_utf8(request_line_field_bytes(head, 0))!
    path_text := decode_utf8(request_target_path_bytes(head))!
    query_text := decode_utf8(request_target_query_bytes(head))!
    version_text := decode_utf8(request_line_field_bytes(head, 2))!
    return HttpRequestBytes(head, body, method_text, path_text, query_text, version_text, "", "", {}, {}, [])

# the request a reader returns when the peer closed with nothing pending.
fn empty_request() -> HttpRequestBytes:
    return HttpRequestBytes(bytes.empty(), bytes.empty(), "", "", "", "", "", "", {}, {}, [])

# ===============================================================
# Request Validation
# ===============================================================
# the longest request-target the server accepts. a longer one gets 414
# (rfc 9112 3), well before the head as a whole reaches MAX_HEADER_BYTES.
pub MAX_REQUEST_TARGET_BYTES := 8192

# the bounds a decimal wire integer is checked against before each digit.
DECIMAL_INT_MAX_DIV10 := 922337203685477580
DECIMAL_INT_MAX_LAST_DIGIT := 7

# the failures parse_request_head and the body readers report. the serve loops
# turn each into its status with request_error_status. a failure without one of
# these shapes (eof in the middle of a request, a dropped socket) closes the
# connection without a response.
BAD_REQUEST_PREFIX := "http: bad request: "
NOT_IMPLEMENTED_PREFIX := "http: not implemented: "
TARGET_LIMIT_MESSAGE := "http: request target exceeds the maximum"
VERSION_MESSAGE := "http: http version not supported"
INCOMPLETE_HEAD_MESSAGE := "http: request head ended early"
EXPECTATION_MESSAGE := "http: expectation failed"

fn bad_request(reason: String) -> String:
    return BAD_REQUEST_PREFIX + reason

# the status the server answers a request-reading failure with, or 0 when it
# should close the connection without answering.
fn request_error_status(message: String) -> Int:
    if message.starts_with(BAD_REQUEST_PREFIX):
        return 400
    if message == HEADER_LIMIT_MESSAGE:
        return 431
    if message == BODY_LIMIT_MESSAGE:
        return 413
    if message == TARGET_LIMIT_MESSAGE:
        return 414
    if message.starts_with(NOT_IMPLEMENTED_PREFIX):
        return 501
    if message == VERSION_MESSAGE:
        return 505
    if message == EXPECTATION_MESSAGE:
        return 417
    return 0

# a request head checked by parse_request_head. `head` starts at the request
# line, and the offsets index it. the target's path is path_start..path_end
# and its query query_start..target_end (query_start is -1 without a "?").
# authority_start..authority_end is the authority of an absolute-form or
# authority-form target, which replaces the Host field (rfc 9112 3.2.2), or -1.
# `expect` is one of the EXPECT_ codes, and `wants_close` is whether the
# Connection field asks to close after this exchange (rfc 9112 9.3).
struct RequestHead:
    head: Bytes
    method_end: Int
    target_end: Int
    path_start: Int
    path_end: Int
    query_start: Int
    authority_start: Int
    authority_end: Int
    minor: Int
    content_length: Int
    chunked: Bool
    expect: Int
    wants_close: Bool

# what an Expect field asks for (rfc 9110 10.1.1): nothing, a 100 Continue
# before the body, or something this server does not do.
EXPECT_NONE := 0
EXPECT_CONTINUE := 1
EXPECT_OTHER := 2

# whether the comma-separated list in data[start..end] holds `token`, compared
# case-insensitively (rfc 9110 5.6.1). empty elements are skipped.
fn list_has_token(data: Bytes, start: Int, end: Int, token: String) -> Bool:
    mut item := start
    while item < end:
        mut item_end := item
        while item_end < end and data[item_end] != 44:
            item_end = item_end + 1
        token_start := trim_ascii_start(data, item, item_end)
        if header_name_matches(data, token_start, trim_ascii_end(data, token_start, item_end), token):
            return true
        item = item_end + 1
    return false

# whether a request's Connection options mean the connection closes after it
# (rfc 9112 9.3): http/1.0 closes unless it asks for keep-alive, and either
# version closes when it names close.
fn connection_closes(http10: Bool, has_close: Bool, has_keep_alive: Bool) -> Bool:
    return has_close or (http10 and not has_keep_alive)

# tchar (rfc 9110 5.6.2), the bytes of a method or a field name.
fn is_tchar(b: Int) -> Bool:
    if b >= 97 and b <= 122:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 48 and b <= 57:
        return true
    return b == 33 or (b >= 35 and b <= 39) or b == 42 or b == 43 or b == 45 or b == 46 or b == 94 or b == 95 or b == 96 or b == 124 or b == 126

fn is_digit(b: Int) -> Bool:
    return b >= 48 and b <= 57

# a control byte other than HTAB, which no field value or chunk extension may
# hold. obs-text (0x80 and up) is allowed.
fn is_ctl(b: Int) -> Bool:
    return (b < 32 and b != 9) or b == 127

# the bytes a Host value or an authority may hold: the reg-name, IP-literal
# and port characters of rfc 3986. userinfo ("@") is refused, as rfc 9110
# 4.2.4 asks, and so is anything that would end the authority.
fn is_host_byte(b: Int) -> Bool:
    if b >= 97 and b <= 122:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 48 and b <= 57:
        return true
    return b == 33 or (b >= 36 and b <= 46) or b == 58 or b == 59 or b == 61 or b == 91 or b == 93 or b == 95 or b == 126

fn valid_host(data: Bytes, start: Int, end: Int) -> Bool:
    mut i := start
    while i < end:
        if not is_host_byte(data[i]):
            return false
        i = i + 1
    return true

# data[start..end] equals `text`, byte for byte.
fn bytes_equal_text(data: Bytes, start: Int, end: Int, text: String) -> Bool:
    if end - start != text.len():
        return false
    mut i := 0
    while i < text.len():
        if data[start + i] != ord(text[i]):
            return false
        i = i + 1
    return true

# the offset past the empty lines at `start`, each one LF or CRLF.
fn skip_empty_lines(data: Bytes, start: Int) -> Int:
    mut pos := start
    while pos < data.len():
        if data[pos] == 10:
            pos = pos + 1
        elif data[pos] == 13 and pos + 1 < data.len() and data[pos + 1] == 10:
            pos = pos + 2
        else:
            return pos
    return pos

# true when `head` holds nothing but empty lines.
fn only_empty_lines(head: Bytes) -> Bool:
    return not head.is_empty() and skip_empty_lines(head, 0) == head.len()

# "HTTP/" DIGIT "." DIGIT at `pos` (rfc 9112 2.3).
fn is_http_version(data: Bytes, pos: Int) -> Bool:
    if pos + 8 > data.len():
        return false
    return data[pos] == 72 and data[pos + 1] == 84 and data[pos + 2] == 84 and data[pos + 3] == 80 and data[pos + 4] == 47 and is_digit(data[pos + 5]) and data[pos + 6] == 46 and is_digit(data[pos + 7])

# a Content-Length value: one or more digits and nothing else (rfc 9110 8.6).
fn parse_content_length(data: Bytes, start: Int, end: Int) -> Int!:
    if start >= end:
        fail bad_request("empty Content-Length")
    mut value := 0
    mut pos := start
    while pos < end:
        b := data[pos]
        if not is_digit(b):
            fail bad_request("invalid Content-Length")
        digit := b - 48
        if value > DECIMAL_INT_MAX_DIV10 or (value == DECIMAL_INT_MAX_DIV10 and digit > DECIMAL_INT_MAX_LAST_DIGIT):
            fail bad_request("Content-Length overflows")
        value = value * 10 + digit
        pos = pos + 1
    return value

# what the field lines of a head say about its framing and its connection,
# gathered in one pass by scan_field_lines. content_length is -1 without a
# Content-Length field. host_valid is false when a Host value holds a byte
# no authority may hold.
struct FieldScan:
    content_length: Int
    host_count: Int
    host_valid: Bool
    te_seen: Bool
    te_last_chunked: Bool
    te_chunked_count: Int
    te_other: Bool
    expect: Int
    has_close: Bool
    has_keep_alive: Bool

# check the field lines of a head (rfc 9112 5) from `pos` through the empty
# line that ends them, and gather the fields that frame the message. requests
# and responses share it; each applies its own framing rules to the result.
# a failure is a bad_request message, or INCOMPLETE_HEAD_MESSAGE when the head
# stops before its empty line.
fn scan_field_lines(head: Bytes, start: Int) -> FieldScan!:
    n := head.len()
    mut pos := start
    mut content_length := 0 - 1
    mut host_count := 0
    mut host_valid := true
    mut te_seen := false
    mut te_last_chunked := false
    mut te_chunked_count := 0
    mut te_other := false
    mut expect := EXPECT_NONE
    mut has_close := false
    mut has_keep_alive := false
    while true:
        if pos >= n:
            fail INCOMPLETE_HEAD_MESSAGE
        line_start := pos
        b := head[pos]
        if b == 10:
            break
        if b == 13:
            if pos + 1 < n and head[pos + 1] == 10:
                break
            fail bad_request("bare CR in the head")
        if b == 32 or b == 9:
            # obs-fold, or whitespace before the first field (rfc 9112 2.2, 5.2)
            fail bad_request("folded or indented header field")
        while pos < n and is_tchar(head[pos]):
            pos = pos + 1
        name_end := pos
        if name_end == line_start or pos >= n or head[pos] != 58:
            fail bad_request("malformed header field")
        pos = pos + 1
        while pos < n and (head[pos] == 32 or head[pos] == 9):
            pos = pos + 1
        value_start := pos
        mut value_end := pos
        while true:
            if pos >= n:
                fail INCOMPLETE_HEAD_MESSAGE
            c := head[pos]
            if c == 10:
                break
            if c == 13:
                if pos + 1 < n and head[pos + 1] == 10:
                    break
                fail bad_request("bare CR in a header field")
            if is_ctl(c):
                fail bad_request("control character in a header field")
            pos = pos + 1
            if c != 32 and c != 9:
                value_end = pos
        if head[pos] == 13:
            pos = pos + 1
        pos = pos + 1

        name_len := name_end - line_start
        if name_len == 4 and header_name_matches(head, line_start, name_end, "host"):
            host_count = host_count + 1
            if not valid_host(head, value_start, value_end):
                host_valid = false
        elif name_len == 14 and header_name_matches(head, line_start, name_end, "content-length"):
            length := parse_content_length(head, value_start, value_end)!
            if content_length >= 0 and length != content_length:
                fail bad_request("conflicting Content-Length")
            content_length = length
        elif name_len == 17 and header_name_matches(head, line_start, name_end, "transfer-encoding"):
            # a comma-separated list of codings (rfc 9112 6.1); empty elements
            # are allowed and skipped (rfc 9110 5.6.1)
            te_seen = true
            mut item := value_start
            while item <= value_end:
                mut item_end := item
                while item_end < value_end and head[item_end] != 44:
                    item_end = item_end + 1
                coding_start := trim_ascii_start(head, item, item_end)
                coding_end := trim_ascii_end(head, coding_start, item_end)
                if coding_end > coding_start:
                    if header_name_matches(head, coding_start, coding_end, "chunked"):
                        te_chunked_count = te_chunked_count + 1
                        te_last_chunked = true
                    else:
                        te_other = true
                        te_last_chunked = false
                item = item_end + 1
        elif name_len == 10 and header_name_matches(head, line_start, name_end, "connection"):
            has_close = has_close or list_has_token(head, value_start, value_end, "close")
            has_keep_alive = has_keep_alive or list_has_token(head, value_start, value_end, "keep-alive")
        elif name_len == 6 and header_name_matches(head, line_start, name_end, "expect") and value_end > value_start:
            if expect != EXPECT_OTHER and header_name_matches(head, value_start, value_end, "100-continue"):
                expect = EXPECT_CONTINUE
            else:
                expect = EXPECT_OTHER
    return FieldScan(content_length, host_count, host_valid, te_seen, te_last_chunked, te_chunked_count, te_other, expect, has_close, has_keep_alive)

# check a request head in one pass and record where its parts are, following
# rfc 9112 2-7 and rfc 9110 for the field checks. `raw` runs through the empty
# line that ends the head. `server` adds the Host checks an origin server
# makes (rfc 9112 3.2): a reader that only parses requests skips them, as
# go's http.ReadRequest does.
#
# a failure carries the status it should be answered with; see
# request_error_status.
fn parse_request_head(raw: Bytes, server: Bool) -> RequestHead!:
    # rfc 9112 2.2: empty lines before the request line are ignored
    skipped := skip_empty_lines(raw, 0)
    mut head := raw
    if skipped > 0:
        head = raw.slice(skipped, raw.len())
    n := head.len()

    # request-line = method SP request-target SP HTTP-version (rfc 9112 3)
    mut pos := 0
    while pos < n and is_tchar(head[pos]):
        pos = pos + 1
    method_end := pos
    if method_end == 0 or pos >= n or head[pos] != 32:
        fail bad_request("malformed request line")
    pos = pos + 1
    target_start := pos
    while pos < n and head[pos] > 32 and head[pos] != 127:
        pos = pos + 1
    target_end := pos
    if target_end - target_start > MAX_REQUEST_TARGET_BYTES:
        fail TARGET_LIMIT_MESSAGE
    if target_end == target_start or pos >= n or head[pos] != 32:
        fail bad_request("malformed request line")
    pos = pos + 1
    if not is_http_version(head, pos):
        fail bad_request("malformed http version")
    major := head[pos + 5] - 48
    minor := head[pos + 7] - 48
    pos = pos + 8
    if pos < n and head[pos] == 13:
        pos = pos + 1
    if pos >= n or head[pos] != 10:
        fail bad_request("malformed request line")
    pos = pos + 1
    if major != 1:
        fail VERSION_MESSAGE

    # request-target (rfc 9112 3.2)
    is_connect := bytes_equal_text(head, 0, method_end, "CONNECT")
    mut path_start := target_start
    mut path_end := target_end
    mut authority_start := 0 - 1
    mut authority_end := 0 - 1
    first := head[target_start]
    if is_connect:
        # authority-form, and only for CONNECT
        if first == 47 or not valid_host(head, target_start, target_end):
            fail bad_request("CONNECT needs an authority-form target")
        authority_start = target_start
        authority_end = target_end
        path_start = target_start
        path_end = target_start
    elif first == 42 and target_end == target_start + 1:
        # asterisk-form, and only for OPTIONS
        if not bytes_equal_text(head, 0, method_end, "OPTIONS"):
            fail bad_request("only OPTIONS may use the asterisk-form target")
    elif first != 47:
        # absolute-form: http or https, then the authority, which replaces Host
        mut i := target_start
        while i < target_end and head[i] != 58:
            i = i + 1
        scheme_matches := header_name_matches(head, target_start, i, "http") or header_name_matches(head, target_start, i, "https")
        if not scheme_matches or i + 3 > target_end or head[i + 1] != 47 or head[i + 2] != 47:
            fail bad_request("malformed request target")
        authority_start = i + 3
        mut j := authority_start
        while j < target_end and head[j] != 47 and head[j] != 63:
            j = j + 1
        authority_end = j
        if authority_end == authority_start or not valid_host(head, authority_start, authority_end):
            fail bad_request("malformed request target authority")
        path_start = authority_end
    mut query_start := 0 - 1
    if not is_connect:
        mut q := path_start
        while q < target_end and head[q] != 63:
            q = q + 1
        path_end = q
        if q < target_end:
            query_start = q + 1

    fields := scan_field_lines(head, pos)!
    if server:
        if not fields.host_valid:
            fail bad_request("malformed Host")
        if fields.host_count > 1:
            fail bad_request("more than one Host")
        if fields.host_count == 0 and minor >= 1 and not is_connect:
            fail bad_request("missing Host")
    # framing (rfc 9112 6.1, 6.3). a request carrying both lengths is how a
    # second request gets smuggled past a proxy that frames it the other way.
    mut content_length := fields.content_length
    if fields.te_seen:
        if minor == 0:
            fail bad_request("Transfer-Encoding on an http/1.0 request")
        if content_length >= 0:
            fail bad_request("both Transfer-Encoding and Content-Length")
        if not fields.te_last_chunked or fields.te_chunked_count > 1:
            fail bad_request("chunked must be the final transfer coding, applied once")
        if fields.te_other:
            fail NOT_IMPLEMENTED_PREFIX + "unsupported transfer coding"
    if content_length < 0:
        content_length = 0
    return RequestHead(head, method_end, target_end, path_start, path_end, query_start, authority_start, authority_end, minor, content_length, fields.te_seen, fields.expect, connection_closes(minor == 0, fields.has_close, fields.has_keep_alive))

# decode part of a checked head as text. the request line holds no CTLs, but
# it may hold bytes that are not utf-8, and that is a bad request.
fn head_text(head: Bytes, start: Int, end: Int) -> String!:
    if start >= end:
        return ""
    text := head.slice(start, end).to_string_utf8()
    if text.is_err:
        fail bad_request("request line is not utf-8")
    return text.ok

# the method as text, without allocating for the common ones.
fn method_text_of(head: Bytes, end: Int) -> String!:
    if bytes_equal_text(head, 0, end, "GET"):
        return "GET"
    if bytes_equal_text(head, 0, end, "POST"):
        return "POST"
    if bytes_equal_text(head, 0, end, "HEAD"):
        return "HEAD"
    if bytes_equal_text(head, 0, end, "PUT"):
        return "PUT"
    return head_text(head, 0, end)!

# build the request a checked head and its body describe. only the request-line
# parts are decoded here; header fields, query parameters and path segments are
# read from the head when a handler asks for them.
fn request_from_head(parsed: RequestHead, body: Bytes) -> HttpRequestBytes!:
    head := parsed.head
    method_text := method_text_of(head, parsed.method_end)!
    mut path_text := head_text(head, parsed.path_start, parsed.path_end)!
    # an absolute-form target with an empty path asks for "/" (rfc 9112 3.2.2)
    if path_text == "" and parsed.authority_start >= 0 and parsed.path_start == parsed.authority_end:
        path_text = "/"
    mut query_text := ""
    if parsed.query_start >= 0:
        query_text = head_text(head, parsed.query_start, parsed.target_end)!
    mut version_text := "HTTP/1.1"
    if parsed.minor == 0:
        version_text = "HTTP/1.0"
    elif parsed.minor != 1:
        version_text = "HTTP/1." + parsed.minor.to_string()
    mut overrides: Map[String, String] := {}
    if parsed.authority_start >= 0:
        overrides.insert("Host", head_text(head, parsed.authority_start, parsed.authority_end)!)
    return HttpRequestBytes(head, body, method_text, path_text, query_text, version_text, "", "", overrides, {}, [])

fn pack_request(req: HttpRequestBytes) -> String!:
    sep := chr(31)
    mut packed := req.method()!
    packed = packed + sep
    packed = packed + req.path()!
    packed = packed + sep
    packed = packed + req.query()!
    packed = packed + sep
    packed = packed + req.version()!
    packed = packed + sep
    packed = packed + req.headers()!
    packed = packed + sep
    packed = packed + req.body_text()!
    return packed
impl HttpRequestBytes:
    fn method_bytes() -> Bytes:
        return request_line_field_bytes(self.head, 0)
    fn path_bytes() -> Bytes:
        return bytes.from_string_utf8(self.path_text)
    fn query_bytes() -> Bytes:
        return bytes.from_string_utf8(self.query_text)
    fn version_bytes() -> Bytes:
        return request_line_field_bytes(self.head, 2)
    fn headers_bytes() -> Bytes:
        return headers_bytes(self.head)
    fn header_bytes(name: String) -> Bytes:
        return header_value_bytes(self.head, name)
    fn method() -> String!:
        return self.method_text
    fn path() -> String!:
        return self.path_text
    fn query() -> String!:
        return self.query_text
    fn version() -> String!:
        return self.version_text
    fn wants_keep_alive() -> Bool:
        return not request_prefers_close(self)
    fn wants_close() -> Bool:
        return request_prefers_close(self)
    fn headers() -> String!:
        if self.headers_text != "" or self.head.is_empty():
            return self.headers_text
        return decode_utf8(headers_bytes(self.head))!
    # header_map holds fields set when the request was built, such as the Host
    # an absolute-form target names; they win over the head.
    fn header(name: String) -> String!:
        if self.header_map.len() > 0:
            value := header_lookup(self.header_map, name)
            if value != "":
                return value
        return head_header_value(self.head, name)
    # every header field as a map with lowercase names, repeated fields
    # combined as header() combines them.
    fn header_fields() -> Map[String, String]:
        mut fields := head_header_fields(self.head)
        for key in self.header_map:
            fields.insert(key.to_lower(), self.header_map[key])
        return fields
    fn header_or(name: String, fallback: String) -> String:
        value := self.header(name) catch ""
        if value == "":
            return fallback
        return value
    fn body_bytes() -> Bytes:
        return self.body
    fn body_text() -> String!:
        if self.body_text_cache != "" or self.body.is_empty():
            return self.body_text_cache
        return self.body.to_string_utf8()!
    fn body_text_or(fallback: String) -> String:
        return self.body_text() catch fallback
    fn body_json() -> Int!:
        return parse_json_or_fail(self.body_text()!)
    fn body_json_or(fallback: Int) -> Int:
        return self.body_json() catch fallback
    # the token from an `Authorization: Bearer <token>` header. fails when the
    # header is missing or names another scheme, which is the shape an auth
    # guard wants: `token := req.bearer_token() catch: return unauthorized`.
    # every form value of the request, as net/http's Form holds them: the
    # body's values (see post_form) first, then the query string's.
    fn form() -> Map[String, List[String]]:
        values := body_form_values(self)
        query_values := parse_form(self.query_text)
        for key in query_values:
            for value in query_values[key]:
                add_form_value(values, key, value)
        return values
    # the form values of the request body only: an urlencoded or multipart
    # body of a POST, PUT or PATCH. empty for anything else.
    fn post_form() -> Map[String, List[String]]:
        return body_form_values(self)
    # the first value of the form field `name`, from the body and then the
    # query string, or "" when neither has one.
    fn form_value(name: String) -> String:
        values := self.form()
        if values.contains_key(name):
            return values[name][0]
        return ""
    # the first value of the body form field `name`, or "".
    fn post_form_value(name: String) -> String:
        values := body_form_values(self)
        if values.contains_key(name):
            return values[name][0]
        return ""
    # the user and password from an `Authorization: Basic` header. fails when
    # the header is missing, names another scheme, or is not base64 of
    # "user:password". the scheme name is matched without case.
    fn basic_auth() -> BasicAuth!:
        header := self.header_or("Authorization", "")
        if header.len() < 6 or not header_key_matches(header.substring(0, 6), "Basic "):
            fail "no basic credentials in the Authorization header"
        decoded := encoding.b64_decode(header.substring(6, header.len()).trim())!.to_string_utf8()!
        colon := decoded.index_of(":")
        if colon < 0:
            fail "basic credentials have no colon"
        return BasicAuth(decoded.substring(0, colon), decoded.substring(colon + 1, decoded.len()))
    fn bearer_token() -> String!:
        header := self.header_or("Authorization", "")
        if not header.starts_with("Bearer "):
            fail "no bearer token in the Authorization header"
        token := header.substring(7, header.len())
        if token.len() == 0:
            fail "empty bearer token"
        return token
    fn matches(method_name: String, path_name: String) -> Bool!:
        return self.method()! == method_name and self.path()! == path_name
    fn is_get(path_name: String) -> Bool!:
        return self.matches("GET", path_name)!
    fn is_post(path_name: String) -> Bool!:
        return self.matches("POST", path_name)!
    fn is_put(path_name: String) -> Bool!:
        return self.matches("PUT", path_name)!
    fn is_delete(path_name: String) -> Bool!:
        return self.matches("DELETE", path_name)!
    fn is_patch(path_name: String) -> Bool!:
        return self.matches("PATCH", path_name)!
    fn query_param(name: String) -> String!:
        if self.query_map.contains_key(name):
            return self.query_map[name]
        params := query_params_map_from_string(self.query_text)
        if params.contains_key(name):
            return params[name]
        return ""
    fn query_param_or(name: String, fallback: String) -> String:
        value := self.query_param(name) catch ""
        if value == "":
            return fallback
        return value
    fn has_query_param(name: String) -> Bool!:
        return self.query_map.contains_key(name) or query_params_map_from_string(self.query_text).contains_key(name)
    fn cookies() -> Map[String, String]!:
        return parse_cookie_map(self.header_or("Cookie", ""))
    fn cookie(name: String) -> String!:
        cookies := self.cookies()!
        if cookies.contains_key(name):
            return cookies[name]
        return ""
    fn cookie_or(name: String, fallback: String) -> String:
        value := self.cookie(name) catch ""
        if value == "":
            return fallback
        return value
    fn has_cookie(name: String) -> Bool!:
        return self.cookies()!.contains_key(name)
    fn is_multipart() -> Bool!:
        return self.header_or("Content-Type", "").to_lower().starts_with(MIME_MULTIPART_FORM)
    fn multipart_boundary() -> String!:
        return multipart_boundary_from_content_type(self.header("Content-Type")!)
    fn multipart_parts() -> List[MultipartPart]!:
        return parse_multipart_parts(self.body, self.multipart_boundary()!)
    fn has_multipart_part(name: String) -> Bool!:
        for part in self.multipart_parts()!:
            if part.name == name:
                return true
        return false
    fn multipart_part(name: String) -> MultipartPart!:
        for part in self.multipart_parts()!:
            if part.name == name:
                return part
        fail "multipart part not found: " + name
    fn multipart_text(name: String) -> String!:
        return self.multipart_part(name)!.text()
    fn multipart_text_or(name: String, fallback: String) -> String:
        return self.multipart_text(name) catch fallback
    fn path_parts() -> List[String]!:
        if self.path_parts_cache.len() > 0:
            return copy_string_list(self.path_parts_cache)
        return path_segments(self.path_text)
    fn matches_path(pattern: String) -> Bool!:
        return route_match_path(self.path_text, pattern)
    fn path_param(pattern: String, name: String) -> String!:
        return route_param_from_path(self.path_text, pattern, name)
    fn path_param_or(pattern: String, name: String, fallback: String) -> String:
        value := self.path_param(pattern, name) catch ""
        if value == "":
            return fallback
        return value

impl StreamedHttpRequest:
    fn method() -> String!:
        return self.req.method()

    fn path() -> String!:
        return self.req.path()

    fn query() -> String!:
        return self.req.query()

    fn version() -> String!:
        return self.req.version()

    fn header(name: String) -> String!:
        return self.req.header(name)

    fn header_or(name: String, fallback: String) -> String:
        return self.req.header_or(name, fallback)

    fn query_param(name: String) -> String!:
        return self.req.query_param(name)

    fn query_param_or(name: String, fallback: String) -> String:
        return self.req.query_param_or(name, fallback)

    fn matches_path(pattern: String) -> Bool!:
        return self.req.matches_path(pattern)

    fn path_param(pattern: String, name: String) -> String!:
        return self.req.path_param(pattern, name)

    fn path_param_or(pattern: String, name: String, fallback: String) -> String:
        return self.req.path_param_or(pattern, name, fallback)

impl MultipartPart:
    fn header(name: String) -> String:
        return header_lookup(self.headers, name)
    fn body_bytes() -> Bytes:
        return self.body
    fn text() -> String!:
        return self.body.to_string_utf8()!
    fn text_or(fallback: String) -> String:
        return self.text() catch fallback
    fn is_file() -> Bool:
        return self.filename != ""

# http wire integers here are decimal and non-negative.
fn parse_decimal_bytes(raw: Bytes) -> Int!:
    start := trim_ascii_start(raw, 0, raw.len())
    end := trim_ascii_end(raw, start, raw.len())
    if start >= end:
        fail "expected decimal digits"

    mut value := 0
    mut pos := start
    while pos < end:
        digit := raw[pos]
        if digit < 48 or digit > 57:
            fail "expected decimal digits"
        digit_value := digit - 48
        if value > DECIMAL_INT_MAX_DIV10 or (value == DECIMAL_INT_MAX_DIV10 and digit_value > DECIMAL_INT_MAX_LAST_DIGIT):
            fail "integer overflow"
        value = value * 10 + digit_value
        pos = pos + 1
    return value

# where a request or chunked body is read from: a buffered reader, or a tls
# conn's own byte i/o. the plaintext and tls paths share one head reader, one
# parser and one chunked decoder over it; only these few reads differ.
#
# `socket` is the tcp connection underneath, which a server sets its deadlines
# on, or 0 when there is none (an in-memory reader, or a client read).
struct ByteSource:
    reader: BufferedBytesReader
    conn: tls.Conn
    use_tls: Bool
    socket: Int

fn buffered_source(reader: BufferedBytesReader) -> ByteSource:
    return ByteSource(reader, tls.Conn(0), false, 0)

fn tls_source(conn: tls.Conn) -> ByteSource:
    return ByteSource(BufferedBytesReader(0), conn, true, 0)

# how many bytes of the next request are available, reading once when none
# are buffered yet, so it returns when the first byte arrives. 0 means end of
# stream.
fn source_wait_bytes(src: ByteSource) -> Int!:
    if src.use_tls:
        chunk := src.conn.read_bytes(TLS_READ_CHUNK)!
        src.conn.unread_bytes(chunk)
        return chunk.len()
    return src.reader.wait_bytes()

# the next line through its LF, at most `cap` bytes before it. at end of stream
# it is whatever arrived, which then has no LF.
fn source_read_line(src: ByteSource, cap: Int) -> Bytes!:
    nl := bytes.from_string_utf8(chr(10))
    if src.use_tls:
        return read_until_including_from_tls(src.conn, nl, cap)
    return src.reader.read_until_bytes_including_bounded(nl, cap)

fn source_read_exact(src: ByteSource, count: Int) -> Bytes!:
    if src.use_tls:
        return read_exact_from_tls(src.conn, count)
    return src.reader.read_exact_bytes(count)

fn source_stream_exact(src: ByteSource, writer: BufferedBytesWriter, count: Int) -> Int!:
    if src.use_tls:
        return stream_exact_bytes_from_tls(src.conn, writer, count)
    return stream_exact_bytes_from_reader(src.reader, writer, count)

# a request head through the empty line that ends it, ending in LF or CRLF
# (see io.head_end), or what arrived before end of stream.
fn source_read_head(src: ByteSource, cap: Int) -> Bytes!:
    if src.use_tls:
        return read_until_including_from_tls(src.conn, bytes.empty(), cap)
    return src.reader.read_head_bounded(cap)

# the end of the content on a chunked-body line, before its LF or CRLF. a line
# without an LF means the stream ended inside it.
fn chunk_line_content_end(line: Bytes) -> Int!:
    mut end := line.len()
    if end == 0 or line[end - 1] != 10:
        fail "http: chunked body ended early"
    end = end - 1
    if end > 0 and line[end - 1] == 13:
        end = end - 1
    return end

# the largest value a chunk size may hold before one more hex digit overflows.
CHUNK_SIZE_MAX_DIV16 := 576460752303423487

fn hex_digit_value(b: Int) -> Int:
    if b >= 48 and b <= 57:
        return b - 48
    if b >= 65 and b <= 70:
        return b - 55
    if b >= 97 and b <= 102:
        return b - 87
    return 0 - 1

# the size on a chunk-size line (rfc 9112 7.1): hex digits, then optional
# extensions after a ";", which are checked for control bytes and ignored.
fn chunk_size_from_line(line: Bytes) -> Int!:
    end := chunk_line_content_end(line)!
    mut value := 0
    mut pos := 0
    while pos < end:
        digit := hex_digit_value(line[pos])
        if digit < 0:
            break
        if value > CHUNK_SIZE_MAX_DIV16:
            fail bad_request("chunk size overflows")
        value = value * 16 + digit
        pos = pos + 1
    if pos == 0:
        fail bad_request("malformed chunk size")
    while pos < end and (line[pos] == 32 or line[pos] == 9):
        pos = pos + 1
    if pos < end and line[pos] != 59:
        fail bad_request("malformed chunk size")
    while pos < end:
        if is_ctl(line[pos]):
            fail bad_request("control character in a chunk extension")
        pos = pos + 1
    return value

# true at the empty line that ends a chunked body. a trailer field before it
# must be a well-formed field line, and it is added to `trailers`.
fn chunk_trailer_ends(line: Bytes, trailers: Map[String, String]) -> Bool!:
    end := chunk_line_content_end(line)!
    if end == 0:
        return true
    mut pos := 0
    while pos < end and is_tchar(line[pos]):
        pos = pos + 1
    name_end := pos
    if pos == 0 or pos >= end or line[pos] != 58:
        fail bad_request("malformed trailer field")
    while pos < end:
        if is_ctl(line[pos]):
            fail bad_request("control character in a trailer field")
        pos = pos + 1
    value_start := trim_ascii_start(line, name_end + 1, end)
    value_end := trim_ascii_end(line, value_start, end)
    name := decode_utf8(line.slice(0, name_end)) catch ""
    trailers[name] = decode_utf8(line.slice(value_start, value_end)) catch ""
    return false

# decode a chunked body (rfc 9112 7.1) from `src`, into `out`, or into `writer`
# when `streaming` is set. `limit` caps the decoded size, 0 for no cap: the
# request readers pass MAX_REQUEST_BODY so a chunked upload is bounded like a
# content-length one, and the client response readers pass 0. trailer fields
# go into `trailers`. returns the decoded size.
fn decode_chunked(src: ByteSource, out: ByteBuffer, writer: BufferedBytesWriter, streaming: Bool, limit: Int, trailers: Map[String, String]) -> Int!:
    mut total := 0
    while true:
        size := chunk_size_from_line(source_read_line(src, CHUNK_LINE_LIMIT)!)!
        if size == 0:
            mut done := false
            while not done:
                done = chunk_trailer_ends(source_read_line(src, CHUNK_LINE_LIMIT)!, trailers)!
            if streaming:
                writer.flush()!
            return total
        # check the declared size before reading it, so a bogus chunk-size line
        # (e.g. 7fffffff) cannot force a huge allocation ahead of the cap
        if limit > 0 and size > limit - total:
            fail BODY_LIMIT_MESSAGE
        if streaming:
            total = total + source_stream_exact(src, writer, size)!
        else:
            out.write(source_read_exact(src, size)!)!
            total = total + size
        if chunk_line_content_end(source_read_line(src, CHUNK_LINE_LIMIT)!)! != 0:
            fail bad_request("chunk data is not followed by a line ending")
    return total

fn read_chunked_from(src: ByteSource, limit: Int) -> Bytes!:
    out := bytes.buffer()
    errdefer out.free()
    decode_chunked(src, out, BufferedBytesWriter(0), false, limit, {})!
    return out.take_bytes()

fn read_chunked_body(reader: BufferedBytesReader, limit: Int) -> Bytes!:
    return read_chunked_from(buffered_source(reader), limit)

fn stream_chunked_from(src: ByteSource, writer: BufferedBytesWriter) -> Int!:
    out := bytes.buffer()
    defer out.free()
    return decode_chunked(src, out, writer, true, 0, {})

fn read_exact_from_tls(conn: tls.Conn, count: Int) -> Bytes!:
    if count <= 0:
        return bytes.empty()
    out := bytes.buffer_with_capacity(count)
    errdefer out.free()
    while out.len() < count:
        chunk := conn.read_bytes(count - out.len())!
        if chunk.is_empty():
            fail "unexpected eof"
        out.write(chunk)!
    return out.take_bytes()

# the end of the first `sep` at or after `start` in `data`, or -1. an empty `sep`
# stands for the empty line that ends a head, found with io.head_end.
fn sep_end_from(data: Bytes, start: Int, sep: Bytes) -> Int:
    if sep.is_empty():
        return io.head_end(data, start)
    at := bytes.index_of(data.slice(start, data.len()), sep)
    if at < 0:
        return 0 - 1
    return start + at + sep.len()

# `cap` bounds the bytes read before the separator, so a tls peer that
# never sends it cannot grow the buffer without bound; 0 or less means no limit.
# an empty `sep` reads through the end of a head (see sep_end_from).
#
# the read is chunked rather than one byte at a time. a tls conn already holds
# whatever it decrypted but was not asked for, and unread_bytes hands the tail
# past the separator straight back to it, so reading ahead never takes a byte
# out of what follows. the byte loop this replaces paid a lock, a record-loop
# entry and two buffer copies for every byte of every head, and the second copy
# made the cost quadratic in the size of the record the head arrived in.
fn read_until_including_from_tls(conn: tls.Conn, sep: Bytes, cap: Int) -> Bytes!:
    # how far back from the end of what arrived a separator can start
    mut overlap := sep.len() - 1
    if sep.is_empty():
        overlap = 2
    mut seen := bytes.empty()
    # bytes of `seen` already known to start no match, so each chunk is scanned
    # once rather than the whole buffer being rescanned.
    mut scanned := 0
    while true:
        end := sep_end_from(seen, scanned, sep)
        if end >= 0:
            conn.unread_bytes(seen.slice(end, seen.len()))
            return seen.slice(0, end)
        if seen.len() > overlap:
            scanned = seen.len() - overlap
        if cap > 0 and seen.len() > cap:
            fail "read_until exceeded {cap} bytes without the separator"
        chunk := conn.read_bytes(TLS_READ_CHUNK)!
        if chunk.is_empty():
            # the peer stopped before the separator; hand back what arrived, the
            # same value the byte loop produced.
            return seen
        seen = seen.concat(chunk)
    return seen

fn stream_exact_bytes_from_reader(reader: BufferedBytesReader, writer: BufferedBytesWriter, count: Int) -> Int!:
    mut remaining := count
    mut total := 0
    while remaining > 0:
        mut chunk_size := remaining
        if chunk_size > 4096:
            chunk_size = 4096
        chunk := reader.read_exact_bytes(chunk_size)!
        if chunk.is_empty():
            fail "unexpected eof"
        total = total + writer.write_all_bytes(chunk)!
        remaining = remaining - chunk.len()
    writer.flush()!
    return total

fn stream_exact_bytes_from_tls(conn: tls.Conn, writer: BufferedBytesWriter, count: Int) -> Int!:
    mut remaining := count
    mut total := 0
    while remaining > 0:
        mut chunk_size := remaining
        if chunk_size > 4096:
            chunk_size = 4096
        chunk := read_exact_from_tls(conn, chunk_size)!
        total = total + writer.write_all_bytes(chunk)!
        remaining = remaining - chunk.len()
    writer.flush()!
    return total

# everything left on `src` until the peer closes, into `writer`. returns the
# bytes written.
fn source_stream_all(src: ByteSource, writer: BufferedBytesWriter) -> Int!:
    mut total := 0
    while true:
        mut chunk := bytes.empty()
        if src.use_tls:
            chunk = src.conn.read_bytes(4096)!
        else:
            chunk = src.reader.read_bytes(4096)!
        if chunk.is_empty():
            writer.flush()!
            return total
        total = total + writer.write_all_bytes(chunk)!
    return total

fn source_read_all(src: ByteSource) -> Bytes!:
    if src.use_tls:
        return src.conn.read_all_bytes()
    return src.reader.read_all_bytes()

# ===============================================================
# Response Parsing
# ===============================================================
# the messages a client response read fails with. a response the parser
# refuses fails with RESPONSE_PREFIX and the reason.
RESPONSE_PREFIX := "http: malformed response: "
RESPONSE_INCOMPLETE_MESSAGE := "http: response head ended early"
RESPONSE_HEADER_LIMIT_MESSAGE := "http: response header fields exceed the maximum"
RESPONSE_VERSION_MESSAGE := "http: unsupported http version in response"
RESPONSE_CODING_MESSAGE := "http: unsupported transfer coding in response"
RESPONSE_BODY_EOF_MESSAGE := "http: response body ended early"
# the peer closed before a byte of the response arrived. on a reused
# connection this is the race of a server closing an idle connection just as
# a request goes out, which the client retries.
NO_RESPONSE_MESSAGE := "http: server closed the connection before responding"
# a client request ran out of its time in all, or of the time it had to
# wait for the response head.
CLIENT_TIMEOUT_MESSAGE := "http: client timeout exceeded"
HEADER_TIMEOUT_MESSAGE := "http: timeout awaiting response headers"

# the most a response head may hold before the client gives up on it, as
# net/http's default MaxResponseHeaderBytes allows.
MAX_RESPONSE_HEADER_BYTES := 1048576

# a response head checked by parse_response_head, with the framing of its body
# (rfc 9112 6.3): `kind` is one of the HTTP_RESPONSE_BODY_ codes and
# `content_length` the length an EXACT body has. `wants_close` is whether the
# connection cannot carry another exchange after this one: the response asks
# to close, it is http/1.0 without keep-alive, or its body runs to the close.
struct ResponseHead:
    head: Bytes
    status: Int
    minor: Int
    kind: Int
    content_length: Int
    wants_close: Bool

# the failure a response read reports for a failure of the shared head scan
# or body readers.
fn response_failure(message: String) -> String:
    if message == "unexpected eof" or message == "http: chunked body ended early":
        return RESPONSE_BODY_EOF_MESSAGE
    if message.starts_with(BAD_REQUEST_PREFIX):
        return RESPONSE_PREFIX + message.substring(BAD_REQUEST_PREFIX.len(), message.len())
    if message == INCOMPLETE_HEAD_MESSAGE:
        return RESPONSE_INCOMPLETE_MESSAGE
    if message == HEADER_LIMIT_MESSAGE:
        return RESPONSE_HEADER_LIMIT_MESSAGE
    return message

# check a response head (rfc 9112 4, 5) and work out how its body is framed
# (rfc 9112 6.3). `raw` runs through the empty line that ends the head, and
# `method` is the method of the request it answers, since the answer to HEAD
# never has a body.
#
# the status line is HTTP/1.x, a space, three digits, and an optional reason
# after another space. the field lines get the checks a request's get. a
# response that carries both Transfer-Encoding and Content-Length, or two
# different Content-Length values, is refused: either is how one response is
# made to read as two. a transfer coding other than chunked is refused as
# net/http refuses it.
fn parse_response_head(raw: Bytes, method: String) -> ResponseHead!:
    skipped := skip_empty_lines(raw, 0)
    mut head := raw
    if skipped > 0:
        head = raw.slice(skipped, raw.len())
    n := head.len()
    # a head always ends with its empty line; one that does not is what
    # arrived before the peer closed
    if n == 0 or head[n - 1] != 10:
        fail RESPONSE_INCOMPLETE_MESSAGE
    if not is_http_version(head, 0):
        fail RESPONSE_PREFIX + "malformed status line"
    if head[5] != 49:
        fail RESPONSE_VERSION_MESSAGE
    minor := head[7] - 48
    if n < 12 or head[8] != 32 or not is_digit(head[9]) or not is_digit(head[10]) or not is_digit(head[11]):
        fail RESPONSE_PREFIX + "malformed status line"
    status := (head[9] - 48) * 100 + (head[10] - 48) * 10 + (head[11] - 48)
    if status < 100:
        fail RESPONSE_PREFIX + "malformed status code"
    mut pos := 12
    if pos < n and head[pos] == 32:
        # the reason phrase: text, spaces and tabs (rfc 9112 4)
        pos = pos + 1
        while pos < n and head[pos] != 10 and head[pos] != 13:
            if is_ctl(head[pos]):
                fail RESPONSE_PREFIX + "control character in the reason phrase"
            pos = pos + 1
    if pos < n and head[pos] == 13:
        pos = pos + 1
    if pos >= n:
        fail RESPONSE_INCOMPLETE_MESSAGE
    if head[pos] != 10:
        fail RESPONSE_PREFIX + "malformed status line"
    scanned := scan_field_lines(head, pos + 1)
    if scanned.is_err:
        fail response_failure(scanned.err)
    fields := scanned.ok
    if fields.te_seen and fields.content_length >= 0:
        fail RESPONSE_PREFIX + "both Transfer-Encoding and Content-Length"
    mut kind := HTTP_RESPONSE_BODY_UNTIL_CLOSE
    mut length := 0
    mut closes := connection_closes(minor == 0, fields.has_close, fields.has_keep_alive)
    if method == "HEAD" or response_status_has_no_body(status):
        kind = HTTP_RESPONSE_BODY_NONE
    elif fields.te_seen:
        if not fields.te_last_chunked or fields.te_chunked_count > 1 or fields.te_other:
            fail RESPONSE_CODING_MESSAGE
        kind = HTTP_RESPONSE_BODY_CHUNKED
        # rfc 9112 6.1: chunked framing on an http/1.0 message is faulty, so
        # the connection is not trusted for another exchange
        if minor == 0:
            closes = true
    elif fields.content_length >= 0:
        kind = HTTP_RESPONSE_BODY_EXACT
        length = fields.content_length
    else:
        closes = true
    return ResponseHead(head, status, minor, kind, length, closes)

fn response_status_has_no_body(status: Int) -> Bool:
    return status == 204 or status == 304 or (status >= 100 and status < 200)

# the next final response head on `src`, checked by parse_response_head.
# interim 1xx responses before it are read and dropped (rfc 9110 15.2), except
# 101, which ends the exchange as http/1.1 knows it.
fn read_response_head_from(src: ByteSource, method: String) -> ResponseHead!:
    while true:
        got := read_request_head(src, MAX_RESPONSE_HEADER_BYTES)
        if got.is_err:
            fail response_failure(got.err)
        if got.ok.is_empty():
            fail NO_RESPONSE_MESSAGE
        parsed := parse_response_head(got.ok, method)!
        if parsed.status >= 200 or parsed.status == 101:
            return parsed
    fail NO_RESPONSE_MESSAGE

# the body a checked response head frames, read from `src`. trailer fields of
# a chunked body go into `trailers`.
fn read_response_body_from(src: ByteSource, parsed: ResponseHead, trailers: Map[String, String]) -> Bytes!:
    got := read_response_body_raw(src, parsed, trailers)
    if got.is_err:
        fail response_failure(got.err)
    return got.ok

fn read_response_body_raw(src: ByteSource, parsed: ResponseHead, trailers: Map[String, String]) -> Bytes!:
    if parsed.kind == HTTP_RESPONSE_BODY_CHUNKED:
        out := bytes.buffer()
        errdefer out.free()
        decode_chunked(src, out, BufferedBytesWriter(0), false, 0, trailers)!
        return out.take_bytes()
    if parsed.kind == HTTP_RESPONSE_BODY_EXACT:
        return source_read_exact(src, parsed.content_length)
    if parsed.kind == HTTP_RESPONSE_BODY_UNTIL_CLOSE:
        return source_read_all(src)
    return bytes.empty()

# like read_response_body_from, but the body goes to `writer`. returns its
# size.
fn stream_response_body_from(src: ByteSource, parsed: ResponseHead, writer: BufferedBytesWriter, trailers: Map[String, String]) -> Int!:
    got := stream_response_body_raw(src, parsed, writer, trailers)
    if got.is_err:
        fail response_failure(got.err)
    return got.ok

fn stream_response_body_raw(src: ByteSource, parsed: ResponseHead, writer: BufferedBytesWriter, trailers: Map[String, String]) -> Int!:
    if parsed.kind == HTTP_RESPONSE_BODY_CHUNKED:
        out := bytes.buffer()
        defer out.free()
        return decode_chunked(src, out, writer, true, 0, trailers)
    if parsed.kind == HTTP_RESPONSE_BODY_EXACT:
        return source_stream_exact(src, writer, parsed.content_length)
    if parsed.kind == HTTP_RESPONSE_BODY_UNTIL_CLOSE:
        return source_stream_all(src, writer)
    writer.flush()!
    return 0

fn response_from_parsed(parsed: ResponseHead, body: Bytes, trailers: Map[String, String]) -> HttpResponse:
    headers := response_headers_map(parsed.head)
    content_type := header_lookup(headers, "Content-Type")
    return HttpResponse(parsed.status, content_type, header_without(headers, "Content-Type"), body, response_set_cookie_headers(parsed.head), trailers)

fn streamed_response_from_parsed(parsed: ResponseHead, body_size: Int) -> StreamedHttpResponse:
    headers := response_headers_map(parsed.head)
    content_type := header_lookup(headers, "Content-Type")
    return StreamedHttpResponse(parsed.status, content_type, header_without(headers, "Content-Type"), response_set_cookie_headers(parsed.head), body_size)

# read one whole response from `src`: the head and the body it frames.
fn read_response_from(src: ByteSource, method: String) -> HttpResponse!:
    parsed := read_response_head_from(src, method)!
    trailers: Map[String, String] := {}
    body := read_response_body_from(src, parsed, trailers)!
    return response_from_parsed(parsed, body, trailers)

# read one response from `src` and stream its body into `writer`.
fn read_response_into_from(src: ByteSource, method: String, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    parsed := read_response_head_from(src, method)!
    body_size := stream_response_body_from(src, parsed, writer, {})!
    return streamed_response_from_parsed(parsed, body_size)

# ===============================================================
# Request Accessors
# ===============================================================
fn req_field(req: String, n: Int) -> String:
    sep := chr(31)
    mut start := 0
    mut field := 0
    mut pos := 0
    req_len := req.len()
    while pos < req_len:
        if char_eq(req, pos, sep):
            if field == n:
                return req.substring(start, pos)
            field = field + 1
            start = pos + 1
        pos = pos + 1
    if field == n:
        return req.substring(start, req_len)
    return ""
# returns the request method from a packed request string.
pub fn method(req: String) -> String:
    return req_field(req, 0)
# returns the request path from a packed request string.
pub fn path(req: String) -> String:
    return req_field(req, 1)
# returns the raw query string from a packed request string.
pub fn query(req: String) -> String:
    return req_field(req, 2)
# returns the http version from a packed request string.
pub fn version(req: String) -> String:
    return req_field(req, 3)
# returns the raw header block from a packed request string.
pub fn headers(req: String) -> String:
    return req_field(req, 4)
# returns the request body from a packed request string.
pub fn body(req: String) -> String:
    return req_field(req, 5)
# looks up one header in a packed request string.
pub fn get_header(req: String, name: String) -> String:
    target := name.to_lower()
    h := req_field(req, 4)
    if h.len() == 0:
        return ""
    mut cur := scanner.new(h)
    while not scanner.done(cur):
        scanned := scanner.take_line(cur)
        cur = scanned.cursor
        line := scanned.slice.text.trim()
        if line.len() > 0:
            mut colon := -1
            mut ci := 0
            line_len := line.len()
            while ci < line_len:
                if char_eq(line, ci, ":"):
                    colon = ci
                    break
                ci = ci + 1
            if colon > 0:
                hname := line.substring(0, colon).trim().to_lower()
                if str_eq(hname, target):
                    if colon + 1 < line_len:
                        return line.substring(colon + 1, line_len).trim()
                    return ""
    return ""
# looks up one query parameter in a packed request string.
pub fn get_query_param(req: String, name: String) -> String:
    params := query_params_map_from_string(req_field(req, 2))
    if params.contains_key(name):
        return params[name]
    return ""
# ===============================================================
# Response Building
# ===============================================================

# the reason phrase for a status code: the names rfc 9110 15 gives, plus 103
# (rfc 8297), 428, 429, 431 and 511 (rfc 6585) and 451 (rfc 7725). a code
# without one has an empty reason, which rfc 9112 4 allows.
pub fn reason_phrase(status: Int) -> String:
    if status == 200:
        return "OK"
    if status == 204:
        return "No Content"
    if status == 404:
        return "Not Found"
    if status == 304:
        return "Not Modified"
    if status == 201:
        return "Created"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 500:
        return "Internal Server Error"
    if status == 100:
        return "Continue"
    if status == 101:
        return "Switching Protocols"
    if status == 103:
        return "Early Hints"
    if status == 202:
        return "Accepted"
    if status == 203:
        return "Non-Authoritative Information"
    if status == 205:
        return "Reset Content"
    if status == 206:
        return "Partial Content"
    if status == 300:
        return "Multiple Choices"
    if status == 303:
        return "See Other"
    if status == 305:
        return "Use Proxy"
    if status == 307:
        return "Temporary Redirect"
    if status == 308:
        return "Permanent Redirect"
    if status == 402:
        return "Payment Required"
    if status == 405:
        return "Method Not Allowed"
    if status == 406:
        return "Not Acceptable"
    if status == 407:
        return "Proxy Authentication Required"
    if status == 408:
        return "Request Timeout"
    if status == 409:
        return "Conflict"
    if status == 410:
        return "Gone"
    if status == 411:
        return "Length Required"
    if status == 412:
        return "Precondition Failed"
    if status == 413:
        return "Content Too Large"
    if status == 414:
        return "URI Too Long"
    if status == 415:
        return "Unsupported Media Type"
    if status == 416:
        return "Range Not Satisfiable"
    if status == 417:
        return "Expectation Failed"
    if status == 421:
        return "Misdirected Request"
    if status == 422:
        return "Unprocessable Content"
    if status == 426:
        return "Upgrade Required"
    if status == 428:
        return "Precondition Required"
    if status == 429:
        return "Too Many Requests"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 451:
        return "Unavailable For Legal Reasons"
    if status == 501:
        return "Not Implemented"
    if status == 502:
        return "Bad Gateway"
    if status == 503:
        return "Service Unavailable"
    if status == 504:
        return "Gateway Timeout"
    if status == 505:
        return "HTTP Version Not Supported"
    if status == 511:
        return "Network Authentication Required"
    return ""

# the status line for a status code, through its CRLF.
fn status_line(status: Int) -> String:
    if status == 200:
        return "HTTP/1.1 200 OK\r\n"
    return "HTTP/1.1 " + status.to_string() + " " + reason_phrase(status) + "\r\n"

fn two_digits(value: Int) -> String:
    if value < 10:
        return "0" + value.to_string()
    return value.to_string()

# a unix time in seconds as an IMF-fixdate (rfc 9110 5.6.7), the form a Date,
# Last-Modified or Expires field takes: "Sun, 06 Nov 1994 08:49:37 GMT".
pub fn http_date(unix_seconds: Int) -> String:
    d := datetime.from_timestamp(unix_seconds * 1000)
    clock := unix_seconds % 86400
    mut out := datetime.weekday_name(d).substring(0, 3) + ", " + two_digits(datetime.day(d))
    out = out + " " + datetime.month_short(datetime.month(d)) + " " + datetime.year(d).to_string()
    out = out + " " + two_digits(clock / 3600) + ":" + two_digits(clock / 60 % 60) + ":" + two_digits(clock % 60) + " GMT"
    return out

# the Date field every server response carries (rfc 9110 6.6.1), through its
# CRLF. it is formatted at most once a second per task, so a busy connection
# reads the clock per request but formats the date once a second.
threadlocal mut date_cache_second: Int := 0 - 1
threadlocal mut date_cache_field: String := ""

fn current_date_field() -> String:
    now := time() / 1000
    if now != date_cache_second:
        date_cache_field = "Date: " + http_date(now) + "\r\n"
        date_cache_second = now
    return date_cache_field

fn ct_header(ct: String) -> String:
    crlf := chr(13) + chr(10)
    if ct == "text/html":
        return "Content-Type: text/html" + crlf
    if ct == "application/json":
        return "Content-Type: application/json" + crlf
    if ct == "text/plain":
        return "Content-Type: text/plain" + crlf
    mut h := "Content-Type: " + ct
    h = h + crlf
    return h

# starts building an http response.
pub fn response(status: Int) -> HttpResponse:
    mut headers: Map[String, String] := {}
    return HttpResponse(status, "", headers, bytes.empty(), [], {})

# builds a plain text response.
pub fn text(status: Int, body_text: String) -> HttpResponse:
    return response(status).with_body_text(body_text).header("Content-Type", MIME_TEXT)

# builds an html response.
pub fn html(status: Int, body_text: String) -> HttpResponse:
    return response(status).with_body_text(body_text).header("Content-Type", MIME_HTML)

# builds a json response from raw json text.
pub fn json(status: Int, body_text: String) -> HttpResponse:
    return response(status).with_body_text(body_text).header("Content-Type", MIME_JSON)

# builds a json response from a parsed json handle.
pub fn json_value(status: Int, handle: Int) -> HttpResponse:
    body_bytes := json_mod.encode_bytes(handle)
    if body_bytes.is_err:
        return json(status, json_mod.encode(handle))
    return response(status).with_body_bytes(body_bytes.ok).header("Content-Type", MIME_JSON)

# returns a standard 404 response.
pub fn not_found_response() -> HttpResponse:
    return html(404, "<h1>404 Not Found</h1>")

# returns a standard 400 response.
pub fn bad_request_response() -> HttpResponse:
    return text(400, "Bad Request")

# returns a standard 401 response.
pub fn unauthorized_response() -> HttpResponse:
    return text(401, "Unauthorized")

# returns a standard 403 response.
pub fn forbidden_response() -> HttpResponse:
    return text(403, "Forbidden")

# returns a standard 405 response.
pub fn method_not_allowed_response() -> HttpResponse:
    return text(405, "Method Not Allowed")

# returns a standard 500 response.
pub fn server_error_response() -> HttpResponse:
    return html(500, "<h1>500 Internal Server Error</h1>")

# returns a standard 204 response.
pub fn no_content() -> HttpResponse:
    return response(204)

# returns a redirect response with a location header.
pub fn redirect_response(url: String) -> HttpResponse:
    return response(301).header("Location", url)

# starts building a cookie value.
pub fn cookie(name: String, value: String) -> Cookie:
    return Cookie(name, value, "", "", "", -1, false, false, "")

# builds an expired cookie so callers can clear browser state without formatting headers by hand.
pub fn expired_cookie(name: String) -> Cookie:
    return cookie(name, "").path("/").expires("Thu, 01 Jan 1970 00:00:00 GMT").max_age(0)

impl Cookie:
    fn path(value: String) -> Cookie:
        return Cookie(self.name, self.value, value, self.domain_text, self.expires_text, self.max_age_seconds, self.secure_flag, self.http_only_flag, self.same_site_value)

    fn domain(value: String) -> Cookie:
        return Cookie(self.name, self.value, self.path_text, value, self.expires_text, self.max_age_seconds, self.secure_flag, self.http_only_flag, self.same_site_value)

    fn expires(value: String) -> Cookie:
        return Cookie(self.name, self.value, self.path_text, self.domain_text, value, self.max_age_seconds, self.secure_flag, self.http_only_flag, self.same_site_value)

    fn max_age(seconds: Int) -> Cookie:
        return Cookie(self.name, self.value, self.path_text, self.domain_text, self.expires_text, seconds, self.secure_flag, self.http_only_flag, self.same_site_value)

    fn secure_only() -> Cookie:
        return Cookie(self.name, self.value, self.path_text, self.domain_text, self.expires_text, self.max_age_seconds, true, self.http_only_flag, self.same_site_value)

    fn http_only() -> Cookie:
        return Cookie(self.name, self.value, self.path_text, self.domain_text, self.expires_text, self.max_age_seconds, self.secure_flag, true, self.same_site_value)

    fn same_site(value: String) -> Cookie:
        return Cookie(self.name, self.value, self.path_text, self.domain_text, self.expires_text, self.max_age_seconds, self.secure_flag, self.http_only_flag, value)

    fn to_header() -> String:
        return serialize_cookie(self)

impl HttpResponse:
    fn header(name: String, value: String) -> HttpResponse:
        if header_key_matches(name, "Content-Type"):
            return HttpResponse(self.status, value, header_without(self.headers, "Content-Type"), self.body, copy_string_list(self.set_cookie_headers), copy_headers_map(self.trailers))
        return HttpResponse(self.status, self.content_type, header_with(self.headers, name, value), self.body, copy_string_list(self.set_cookie_headers), copy_headers_map(self.trailers))

    fn with_body_text(text: String) -> HttpResponse:
        return HttpResponse(self.status, self.content_type, copy_headers_map(self.headers), bytes.from_string_utf8(text), copy_string_list(self.set_cookie_headers), copy_headers_map(self.trailers))

    fn with_body_bytes(data: Bytes) -> HttpResponse:
        return HttpResponse(self.status, self.content_type, copy_headers_map(self.headers), data, copy_string_list(self.set_cookie_headers), copy_headers_map(self.trailers))

    fn with_json(handle: Int) -> HttpResponse:
        body_bytes := json_mod.encode_bytes(handle)
        if body_bytes.is_err:
            return self.with_body_text(json_mod.encode(handle)).header("Content-Type", MIME_JSON)
        return self.with_body_bytes(body_bytes.ok).header("Content-Type", MIME_JSON)

    fn text_body(text: String) -> HttpResponse:
        return self.with_body_text(text)

    fn bytes_body(data: Bytes) -> HttpResponse:
        return self.with_body_bytes(data)

    fn json_body(handle: Int) -> HttpResponse:
        return self.with_json(handle)

    fn content_type(value: String) -> HttpResponse:
        return self.header("Content-Type", value)

    fn keep_alive() -> HttpResponse:
        return self.header("Connection", "keep-alive")

    fn close_connection() -> HttpResponse:
        return self.header("Connection", "close")

    fn set_cookie(item: Cookie) -> HttpResponse:
        mut next := copy_string_list(self.set_cookie_headers)
        next.push(serialize_cookie(item))
        return HttpResponse(self.status, self.content_type, copy_headers_map(self.headers), self.body, next, copy_headers_map(self.trailers))

    # sets the http/2 response trailers (replacing any existing). grpc uses this
    # to carry grpc-status/grpc-message after the body.
    fn with_trailers(t: Map[String, String]) -> HttpResponse:
        return HttpResponse(self.status, self.content_type, copy_headers_map(self.headers), self.body, copy_string_list(self.set_cookie_headers), copy_headers_map(t))

    fn clear_cookie(name: String) -> HttpResponse:
        return self.set_cookie(expired_cookie(name))

    fn cookies() -> List[String]:
        return copy_string_list(self.set_cookie_headers)

    fn status_code() -> Int:
        return self.status

    fn status_is_ok() -> Bool:
        return self.status == 200

    fn is_success() -> Bool:
        return self.status >= 200 and self.status < 300

    fn is_client_error() -> Bool:
        return self.status >= 400 and self.status < 500

    fn is_server_error() -> Bool:
        return self.status >= 500 and self.status < 600

    fn header_value(name: String) -> String:
        if header_key_matches(name, "Content-Type"):
            if self.content_type != "":
                return self.content_type
        return header_lookup(self.headers, name)

    fn body_bytes() -> Bytes:
        return self.body

    fn body_text() -> String!:
        return self.body.to_string_utf8()

    fn body_json() -> Int!:
        return parse_json_or_fail(self.body_text()!)

    fn body_json_or(fallback: Int) -> Int:
        return self.body_json() catch fallback

    fn to_bytes() -> Bytes!:
        return self.to_bytes_conn("")

    # serialize with an explicit Connection value written into the head, without
    # copying the response first. this is the keep-alive server path: it lets the
    # loop keep a connection open (or close it) per request while the handler's
    # `HttpResponse` is serialized exactly once and never rebuilt.
    fn to_bytes_conn(connection: String) -> Bytes!:
        return response_bytes(self, standalone_connection(self, connection), "", false)

    fn to_string() -> String!:
        return self.to_bytes()!.to_string_utf8()

# CR, LF, and NUL have no place in a header name or value; left in, a handler
# that reflects untrusted input (a redirect Location, an echoed id, a request
# header bounced back) could inject headers or split the response. strip them on
# the way out so a crafted value degrades to a harmless single-line header. the
# common case — no control bytes — returns the string untouched.
fn strip_header_controls(text: String) -> String:
    if text.index_of(chr(13)) < 0 and text.index_of(chr(10)) < 0 and text.index_of(chr(0)) < 0:
        return text
    out := bytes.buffer()
    mut i := 0
    while i < text.len():
        b := ord(text[i])
        if b != 13 and b != 10 and b != 0:
            out.write_byte(b) catch 0
        i = i + 1
    return out.take_bytes().to_string_utf8() catch ""

fn response_head_bytes(response: HttpResponse, content_length: Int, use_chunked: Bool) -> Bytes!:
    return response_head_bytes_conn(response, content_length, use_chunked, "")!

# serialize a response head with an explicit Connection value. `connection` is
# how a keep-alive server names the disposition of the connection *without*
# rebuilding the response to carry a Connection header — passing "keep-alive" or
# "close" here writes exactly that line and drops any Connection the response's
# own header map holds, so the caller decides keep-alive per request with no
# per-request `HttpResponse` copy. an empty `connection` keeps the standalone
# behavior: honor a Connection the handler set, else default to close.
fn response_head_bytes_conn(response: HttpResponse, content_length: Int, use_chunked: Bool, connection: String) -> Bytes!:
    return build_response_head(response, content_length, use_chunked, standalone_connection(response, connection), "", false)

# the Connection value a response written outside a keep-alive serve loop
# carries: the one asked for, else the handler's, else close.
fn standalone_connection(response: HttpResponse, connection: String) -> String:
    if connection != "":
        return connection
    existing := header_lookup(response.headers, "Connection")
    if existing != "":
        return existing
    return "close"

# true when `text` is one or more ascii digits.
fn is_decimal_text(text: String) -> Bool:
    if text.len() == 0:
        return false
    mut i := 0
    while i < text.len():
        b := ord(text[i])
        if b < 48 or b > 57:
            return false
        i = i + 1
    return true

# the field that frames a response body (rfc 9112 6.3), through its CRLF, or
# an empty string when the response carries none:
#   * 1xx and 204 never carry Content-Length or Transfer-Encoding (rfc 9110
#     15.2, 15.3.5).
#   * 304 carries the Content-Length the handler set, if any (rfc 9110 15.4.5).
#   * the answer to HEAD carries the length the body would have. a handler
#     that answers HEAD without a body can set Content-Length to say it.
#   * otherwise the body's real length is sent. a Content-Length the handler
#     set that disagrees is replaced, so the framing always matches the bytes
#     on the wire, and a Transfer-Encoding the handler set is dropped, so the
#     two are never sent together.
fn framing_field(status: Int, body_length: Int, use_chunked: Bool, explicit_length: String, head_request: Bool) -> String:
    if status < 200 or status == 204:
        return ""
    if status == 304 or (head_request and body_length == 0 and not use_chunked):
        if is_decimal_text(explicit_length):
            return "Content-Length: " + explicit_length + "\r\n"
        return ""
    if use_chunked:
        return "Transfer-Encoding: chunked\r\n"
    return "Content-Length: " + body_length.to_string() + "\r\n"

# serialize a response head. `body_length` is the length of the body that
# follows, `connection` the Connection value to write, or empty for none, and
# `date_field` the Date field to write through its CRLF, or empty for none; a
# Date the handler set wins over it. `head_request` marks the answer to a HEAD
# request. a Connection, Content-Length or Transfer-Encoding in the handler's
# header map is never copied: `connection` and framing_field decide those.
fn build_response_head(response: HttpResponse, body_length: Int, use_chunked: Bool, connection: String, date_field: String, head_request: Bool) -> Bytes!:
    crlf := "\r\n"
    mut head := status_line(response.status)
    if response.content_type != "":
        head = head + ct_header(strip_header_controls(response.content_type))
    mut explicit_length := ""
    mut has_date := false
    for key in response.headers:
        if header_key_matches(key, "Content-Length"):
            explicit_length = response.headers[key].trim()
            continue
        if header_key_matches(key, "Content-Type") or header_key_matches(key, "Set-Cookie") or header_key_matches(key, "Transfer-Encoding") or header_key_matches(key, "Connection"):
            continue
        if header_key_matches(key, "Date"):
            has_date = true
        head = head + strip_header_controls(key) + ": " + strip_header_controls(response.headers[key]) + crlf
    for line in response.set_cookie_headers:
        head = head + "Set-Cookie: " + strip_header_controls(line) + crlf
    head = head + framing_field(response.status, body_length, use_chunked, explicit_length, head_request)
    if not has_date:
        head = head + date_field
    if connection != "":
        head = head + "Connection: " + strip_header_controls(connection) + crlf
    return bytes.from_string_utf8(head + crlf)

# a whole response as the bytes to write: the head, then the body unless the
# status (rfc 9110 15.2, 15.3.5, 15.4.5) or a HEAD request (rfc 9110 9.3.2)
# rules one out. build_response_head has the other arguments.
fn response_bytes(response: HttpResponse, connection: String, date_field: String, head_request: Bool) -> Bytes!:
    head := build_response_head(response, response.body.len(), false, connection, date_field, head_request)!
    if head_request or response_status_has_no_body(response.status) or response.body.is_empty():
        return head
    buf := bytes.buffer_with_capacity(head.len() + response.body.len())
    errdefer buf.free()
    buf.write(head)!
    buf.write(response.body)!
    return buf.take_bytes()

impl StreamedHttpResponse:
    fn header_value(name: String) -> String:
        if header_key_matches(name, "Content-Type"):
            if self.content_type != "":
                return self.content_type
        return header_lookup(self.headers, name)

    fn cookies() -> List[String]:
        return copy_string_list(self.set_cookie_headers)

    fn is_success() -> Bool:
        return self.status >= 200 and self.status < 300

fn response_to_string_or_empty(resp: HttpResponse) -> String:
    text := resp.to_string()
    if text.is_err:
        return ""
    return text.ok

# builds a response string from status, content type, and text body.
pub fn respond(status: Int, content_type: String, body_text: String) -> String:
    return response_to_string_or_empty(response(status).header("Content-Type", content_type).with_body_text(body_text))

# builds a response payload from status, content type, and bytes body.
pub fn respond_bytes(status: Int, content_type: String, body_bytes: Bytes) -> Bytes!:
    return response(status).header("Content-Type", content_type).with_body_bytes(body_bytes).to_bytes()

# builds a plain text response string.
pub fn text_response(status: Int, body_text: String) -> String:
    return response_to_string_or_empty(text(status, body_text))

# builds an html response string.
pub fn html_response(status: Int, body_text: String) -> String:
    return response_to_string_or_empty(html(status, body_text))

# builds a json response string.
pub fn json_response(status: Int, body_text: String) -> String:
    return response_to_string_or_empty(json(status, body_text))

# returns a standard 404 response string.
pub fn not_found() -> String:
    return response_to_string_or_empty(not_found_response())

# returns a standard 405 response string.
pub fn method_not_allowed() -> String:
    return response_to_string_or_empty(method_not_allowed_response())

# returns a standard 500 response string.
pub fn server_error() -> String:
    return response_to_string_or_empty(server_error_response())

# returns a standard redirect response string.
pub fn redirect(url: String) -> String:
    return response_to_string_or_empty(redirect_response(url))
# ===============================================================
# Server Helpers
# ===============================================================

# how an http/1.1 server connection behaves, modeled on net/http's Server
# fields. a timeout of 0 means none. server_config() gives the defaults the
# plain entry points (serve_connection_fd, serve_connection_tls, ...) use:
# no timeouts, the MAX_HEADER_BYTES and MAX_REQUEST_BODY limits, keep-alive
# on, and no cap on requests per connection. std.web starts from
# web.server_config() instead, which keeps read timeouts on.
#
#   * read_header_timeout_ms: how long the request head may take. on the
#     first request it counts from when the connection was served, the wait
#     for the first byte included; on a later one, from its first byte. this
#     is what stops a slowloris client that sends a byte at a time. when it
#     is 0, read_timeout_ms applies.
#   * read_timeout_ms: how long the head and the body together may take,
#     counted from the same point.
#   * write_timeout_ms: how long the response may take, counted from when the
#     request head has been read, so it covers the handler as well.
#   * idle_timeout_ms: how long a keep-alive connection may wait for its next
#     request to start. when it is 0, read_timeout_ms applies.
#   * max_header_bytes, max_body_bytes: the request-size limits, answered with
#     431 and 413.
#   * keep_alives: false closes the connection after every response.
#   * max_requests_per_conn: close the connection after this many responses,
#     0 for no limit.
#
# a request that runs out of time once its first byte has arrived is answered
# with 408 and the connection closes. a connection that times out with
# nothing sent, or that runs out of write time, is closed with no answer.
pub struct ServerConfig:
    pub read_header_timeout_ms: Int
    pub read_timeout_ms: Int
    pub write_timeout_ms: Int
    pub idle_timeout_ms: Int
    pub max_header_bytes: Int
    pub max_body_bytes: Int
    pub keep_alives: Bool
    pub max_requests_per_conn: Int

# the default server configuration (see ServerConfig).
pub fn server_config() -> ServerConfig:
    return ServerConfig(0, 0, 0, 0, MAX_HEADER_BYTES, MAX_REQUEST_BODY, true, 0)

impl ServerConfig:
    fn with_read_header_timeout(ms: Int) -> ServerConfig:
        return ServerConfig(ms, self.read_timeout_ms, self.write_timeout_ms, self.idle_timeout_ms, self.max_header_bytes, self.max_body_bytes, self.keep_alives, self.max_requests_per_conn)

    fn with_read_timeout(ms: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, ms, self.write_timeout_ms, self.idle_timeout_ms, self.max_header_bytes, self.max_body_bytes, self.keep_alives, self.max_requests_per_conn)

    fn with_write_timeout(ms: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, ms, self.idle_timeout_ms, self.max_header_bytes, self.max_body_bytes, self.keep_alives, self.max_requests_per_conn)

    fn with_idle_timeout(ms: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, self.write_timeout_ms, ms, self.max_header_bytes, self.max_body_bytes, self.keep_alives, self.max_requests_per_conn)

    fn with_max_header_bytes(limit: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, self.write_timeout_ms, self.idle_timeout_ms, limit, self.max_body_bytes, self.keep_alives, self.max_requests_per_conn)

    fn with_max_body_bytes(limit: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, self.write_timeout_ms, self.idle_timeout_ms, self.max_header_bytes, limit, self.keep_alives, self.max_requests_per_conn)

    fn with_keep_alives(enabled: Bool) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, self.write_timeout_ms, self.idle_timeout_ms, self.max_header_bytes, self.max_body_bytes, enabled, self.max_requests_per_conn)

    fn with_max_requests_per_conn(limit: Int) -> ServerConfig:
        return ServerConfig(self.read_header_timeout_ms, self.read_timeout_ms, self.write_timeout_ms, self.idle_timeout_ms, self.max_header_bytes, self.max_body_bytes, self.keep_alives, limit)

    # the head's time limit after the read_timeout_ms fallback.
    fn header_timeout() -> Int:
        if self.read_header_timeout_ms > 0:
            return self.read_header_timeout_ms
        return self.read_timeout_ms

    # the idle wait's time limit after the read_timeout_ms fallback.
    fn idle_timeout() -> Int:
        if self.idle_timeout_ms > 0:
            return self.idle_timeout_ms
        return self.read_timeout_ms

    # whether any read on the connection has a time limit.
    fn times_reads() -> Bool:
        return self.read_header_timeout_ms > 0 or self.read_timeout_ms > 0 or self.idle_timeout_ms > 0

# one http/1.1 server connection: where it reads and writes, the handler, its
# config, and when it was first served on the mono_millis clock.
struct ServerConn:
    src: ByteSource
    writer: BufferedBytesWriter
    handler: fn(HttpRequestBytes) -> HttpResponse
    config: ServerConfig
    opened_ms: Int

fn server_conn(src: ByteSource, writer: BufferedBytesWriter, handler: fn(HttpRequestBytes) -> HttpResponse, config: ServerConfig) -> ServerConn:
    mut opened := 0
    if config.times_reads():
        opened = time_mod.mono_millis()
    return ServerConn(src, writer, handler, config, opened)

# set the read deadline of a server connection to `due` on the mono_millis
# clock, or clear it when `due` is 0. a due time already past still waits 1
# ms, since 0 would mean no deadline at all.
fn arm_read_deadline_at(src: ByteSource, due: Int):
    if due <= 0:
        tcp_set_read_deadline(src.socket, 0)
        return
    left := due - time_mod.mono_millis()
    if left < 1:
        tcp_set_read_deadline(src.socket, 1)
        return
    tcp_set_read_deadline(src.socket, left)

# the read deadline `ms` from now, or none for 0, and when it falls due on the
# mono_millis clock (0 for none). the clock is read first, so the runtime's
# deadline is never earlier than the returned time: a read that failed on it
# always finds mono_millis() at or past that time.
fn arm_read_deadline(src: ByteSource, ms: Int) -> Int:
    if ms <= 0:
        tcp_set_read_deadline(src.socket, 0)
        return 0
    due := time_mod.mono_millis() + ms
    tcp_set_read_deadline(src.socket, ms)
    return due

# the response to a request the server refused while reading it (see
# request_error_status): the status, its reason phrase as the body, and a
# closed connection, so nothing left unread is taken for the next request.
fn request_error_response(status: Int) -> HttpResponse:
    return text(status, reason_phrase(status)).close_connection()

# write bytes to a server connection: the tls conn when `src` reads one, else
# `writer`, which is flushed.
fn source_write(src: ByteSource, writer: BufferedBytesWriter, data: Bytes) -> Int!:
    if src.use_tls:
        return src.conn.write_all_bytes(data)
    written := writer.write_all_bytes(data)!
    writer.flush()!
    return written

# the bytes the server writes for one response: response_bytes with the cached
# Date (rfc 9110 6.6.1) every server response carries.
fn server_response_bytes(response: HttpResponse, connection: String, head_request: Bool) -> Bytes!:
    return response_bytes(response, connection, current_date_field(), head_request)

# answer a request-reading failure with `status`, when it is not 0, and return
# the bytes written. the write gets its own write deadline, since one armed for
# an earlier request may have run out.
fn send_request_error(src: ByteSource, writer: BufferedBytesWriter, status: Int, write_timeout_ms: Int) -> Int!:
    if status == 0:
        return 0
    if write_timeout_ms > 0:
        tcp_set_write_deadline(src.socket, write_timeout_ms)
    return source_write(src, writer, server_response_bytes(request_error_response(status), "close", false)!)

fn request_prefers_close(req: HttpRequestBytes) -> Bool:
    value := bytes.from_string_utf8(req.header_or("Connection", ""))
    return connection_closes(req.version_text == "HTTP/1.0", list_has_token(value, 0, value.len(), "close"), list_has_token(value, 0, value.len(), "keep-alive"))

# the Connection value a keep-alive serve loop writes for one exchange, as a
# string the serializer writes directly, so the loop never copies the
# handler's `HttpResponse`. "close" means the connection closes after this
# response: the request asked for it (`wants_close`, see connection_closes) or
# the handler's Connection names it. otherwise http/1.0 gets "keep-alive",
# since it closes by default (rfc 9112 9.3). http/1.1 is persistent by
# default, so it gets no Connection field, or the one the handler set if that
# says more than keep-alive.
fn connection_value(wants_close: Bool, http10: Bool, resp: HttpResponse) -> String:
    if wants_close:
        return "close"
    existing := header_lookup(resp.headers, "Connection")
    if existing != "":
        value := bytes.from_string_utf8(existing)
        if list_has_token(value, 0, value.len(), "close"):
            return "close"
    if http10:
        return "keep-alive"
    if existing == "" or header_key_matches(existing, "keep-alive"):
        return ""
    return existing

fn connection_value_for(req: HttpRequestBytes, resp: HttpResponse) -> String:
    return connection_value(request_prefers_close(req), req.version_text == "HTTP/1.0", resp)

fn find_request_head_end_from(raw: Bytes, start: Int) -> Int:
    mut i := start
    if i < 0:
        i = 0
    while i < raw.len() - 3:
        if raw[i] == 13 and raw[i + 1] == 10 and raw[i + 2] == 13 and raw[i + 3] == 10:
            return i + 4
        i = i + 1
    i = start
    if i < 0:
        i = 0
    while i < raw.len() - 1:
        if raw[i] == 10 and raw[i + 1] == 10:
            return i + 2
        i = i + 1
    return -1

# one read through the end of a request head, with the reader's cap failure
# reported as the head limit. the cap bounds an endless head (slowloris, memory
# exhaustion). a head whose end sits inside the chunk that crossed the cap is
# refused too.
fn read_head_once(src: ByteSource, cap: Int) -> Bytes!:
    head := source_read_head(src, cap)
    if head.is_err:
        # any other failure, a dropped socket or a deadline, passes through
        if io.is_read_until_limit_error(head.err):
            fail HEADER_LIMIT_MESSAGE
        fail head.err
    if head.ok.len() > cap:
        fail HEADER_LIMIT_MESSAGE
    return head.ok

# the next request head, at most `cap` bytes. empty lines before it are
# skipped (rfc 9112 2.2), up to the same cap; a head is read in one call
# either way, since the readers find its end in what they already hold and
# keep the rest for the body. an empty result means the peer closed with
# nothing pending.
fn read_request_head(src: ByteSource, cap: Int) -> Bytes!:
    mut head := read_head_once(src, cap)!
    mut skipped := 0
    while only_empty_lines(head):
        skipped = skipped + head.len()
        if skipped > cap:
            fail HEADER_LIMIT_MESSAGE
        head = read_head_once(src, cap)!
    return head

# read one request: the head, checked by parse_request_head, then the body it
# frames. the stream is left at the start of the next request, so a keep-alive
# loop never desyncs; on a failure the caller closes the connection.
fn read_request_from(src: ByteSource) -> HttpRequestBytes!:
    raw := read_request_head(src, MAX_HEADER_BYTES)!
    if raw.is_empty():
        return empty_request()
    parsed := parse_request_head(raw, false)!
    return request_from_head(parsed, read_request_body(src, parsed, MAX_REQUEST_BODY)!)

# refuse a declared length over `limit` before anything allocates for it, so
# a hostile "Content-Length: 10000000000" cannot force a giant allocation.
fn check_declared_length(parsed: RequestHead, limit: Int) -> Bool!:
    if parsed.content_length > limit:
        fail BODY_LIMIT_MESSAGE
    return true

# the body a checked head frames, at most `limit` bytes.
fn read_request_body(src: ByteSource, parsed: RequestHead, limit: Int) -> Bytes!:
    if parsed.chunked:
        return read_chunked_from(src, limit)
    check_declared_length(parsed, limit)!
    if parsed.content_length == 0:
        return bytes.empty()
    return source_read_exact(src, parsed.content_length)

# a request the server read, and whether its Connection field asks to close
# after it.
struct ServerRequest:
    req: HttpRequestBytes
    wants_close: Bool

CONTINUE_RESPONSE := "HTTP/1.1 100 Continue\r\n\r\n"

# read one request as the server does: the head, checked with the Host rules,
# then its body, within the connection's limits. `body_due` is when the body
# must have arrived on the mono_millis clock, or 0 for no deadline; the read
# deadline is moved to it once the head is in, when a body follows.
# `rearm` says whether a read deadline is armed at all, so a connection that
# has none skips the call. the write deadline starts once the head is in, as
# net/http's does, so it covers the 100 Continue, the handler and the
# response.
#
# an http/1.1 request that expects 100-continue (rfc 9110 10.1.1) is sent the
# interim response just before its body is read. the body is read before the
# handler runs, so that is as late as the server can send it; a handler that
# never looks at the body still has it read. any other expectation fails with
# 417 before the body is read, and the connection then closes, so the unread
# body is never taken for the next request. an http/1.0 request's
# expectations are ignored.
fn read_server_request(conn: ServerConn, body_due: Int, rearm: Bool) -> ServerRequest!:
    src := conn.src
    config := conn.config
    raw := read_request_head(src, config.max_header_bytes)!
    if raw.is_empty():
        return ServerRequest(empty_request(), true)
    parsed := parse_request_head(raw, true)!
    check_declared_length(parsed, config.max_body_bytes)!
    if config.write_timeout_ms > 0:
        tcp_set_write_deadline(src.socket, config.write_timeout_ms)
    has_body := parsed.chunked or parsed.content_length > 0
    if parsed.minor >= 1 and parsed.expect != EXPECT_NONE:
        if parsed.expect != EXPECT_CONTINUE:
            fail EXPECTATION_MESSAGE
        if has_body:
            source_write(src, conn.writer, bytes.from_string_utf8(CONTINUE_RESPONSE))!
    if rearm and has_body:
        arm_read_deadline_at(src, body_due)
    return ServerRequest(request_from_head(parsed, read_request_body(src, parsed, config.max_body_bytes)!)!, parsed.wants_close)

# like read_request_from, but the body goes to `writer` as it arrives, and the
# returned request has an empty body. a declared length is held to
# MAX_REQUEST_BODY; a chunked body has no cap.
fn read_request_into(src: ByteSource, writer: BufferedBytesWriter) -> StreamedHttpRequest!:
    raw := read_request_head(src, MAX_HEADER_BYTES)!
    if raw.is_empty():
        return StreamedHttpRequest(empty_request(), 0)
    parsed := parse_request_head(raw, false)!
    check_declared_length(parsed, MAX_REQUEST_BODY)!
    mut body_size := 0
    if parsed.chunked:
        body_size = stream_chunked_from(src, writer)!
    else:
        body_size = source_stream_exact(src, writer, parsed.content_length)!
    return StreamedHttpRequest(request_from_head(parsed, bytes.empty())!, body_size)

# reads one head line, refusing a line that alone exceeds `cap` bytes.
#
# `read_line` accumulates its pending line without limit until a newline
# arrives, so a single CRLF-less line could grow far past MAX_HEADER_BYTES
# before the caller's head-total check ever saw it. reading the line one
# character at a time keeps a running count, so the flood fails at the limit
# instead of buffering forever — and the buffered reader's cursor makes the
# per-character reads linear, not quadratic. end of stream returns what
# arrived, and a CR before the newline is dropped, exactly like `read_line`.
fn read_head_line_bounded(reader: BufferedStringReader, cap: Int) -> String!:
    mut parts: List[String] := []
    mut pending := 0
    while true:
        piece := reader.read(1)!
        if piece == "":
            return parts.join("")
        # `ord(piece[0])` reads the first byte in place; a multi-byte character
        # never starts with 10, so this is exactly a newline test.
        if ord(piece[0]) == 10:
            line := parts.join("")
            # test the last byte rather than slicing it off: a String is indexed
            # in bytes, and substring on the tail of a multi-byte character is a
            # hard error, while a line ending in "é" is ordinary text.
            if line.len() > 0 and ord(line[line.len() - 1]) == 13:
                return line.substring(0, line.len() - 1)
            return line
        parts.push(piece)
        pending = pending + piece.len()
        if pending > cap:
            fail HEADER_LIMIT_MESSAGE
    return ""

fn read_request_from_buffered_string(reader: BufferedStringReader) -> HttpRequestBytes!:
    crlf := chr(13) + chr(10)
    request_line := read_head_line_bounded(reader, MAX_HEADER_BYTES)!
    if request_line == "":
        return empty_request()
    raw := bytes.buffer_with_capacity(1024)
    defer raw.free()
    raw.write(bytes.from_string_utf8(request_line + crlf))!
    mut line := read_head_line_bounded(reader, MAX_HEADER_BYTES - raw.len())!
    while line.len() > 0:
        raw.write(bytes.from_string_utf8(line + crlf))!
        # bound the head here too, so this legacy path shares the same limit.
        if raw.len() > MAX_HEADER_BYTES:
            fail HEADER_LIMIT_MESSAGE
        line = read_head_line_bounded(reader, MAX_HEADER_BYTES - raw.len())!
    raw.write(bytes.from_string_utf8(crlf))!
    parsed := parse_request_head(raw.bytes(), false)!
    # this legacy path frames the body by Content-Length only. reject a
    # chunked body rather than silently mis-framing it.
    if parsed.chunked:
        fail "chunked request bodies are not supported on the string reader; use read_request_bytes"
    if parsed.content_length > MAX_REQUEST_BODY:
        fail BODY_LIMIT_MESSAGE
    mut body := bytes.empty()
    if parsed.content_length > 0:
        body = bytes.from_string_utf8(reader.read(parsed.content_length)!)
    return request_from_head(parsed, body)
# reads one request from a buffered string reader and packs it into the legacy
# string form. the head is bounded by MAX_HEADER_BYTES like every other request
# reader here — a head that exceeds it fails, even as one endless CRLF-less line.
pub fn read_request_buffered(reader: BufferedStringReader) -> String!:
    return pack_request(read_request_from_buffered_string(reader)!)
# reads one request from a file descriptor and packs it into the legacy string form.
pub fn read_request(fd: Int) -> String!:
    return pack_request(read_request_bytes(fd)!)
# reads one request from a buffered bytes reader. the request is checked like
# the server checks it, except that a missing or repeated Host is allowed.
pub fn read_request_buffered_bytes(reader: BufferedBytesReader) -> HttpRequestBytes!:
    return read_request_from(buffered_source(reader))

# reads one request and streams the body into a writer.
pub fn read_request_buffered_bytes_into(reader: BufferedBytesReader, writer: BufferedBytesWriter) -> StreamedHttpRequest!:
    return read_request_into(buffered_source(reader), writer)

# reads one request from a file descriptor using the bytes-first path.
pub fn read_request_bytes(fd: Int) -> HttpRequestBytes!:
    stream := io.from_fd(fd)
    reader := stream.buffered_bytes_reader_chunked(512)
    # the request fully materializes its head and body, so the reader's
    # registry entries can be dropped before returning
    req := read_request_from(buffered_source(reader))
    reader.free()
    return req

# reads one request from a file descriptor and streams the body into a writer.
pub fn read_request_bytes_into(fd: Int, writer: BufferedBytesWriter) -> StreamedHttpRequest!:
    stream := io.from_fd(fd)
    reader := stream.buffered_bytes_reader_chunked(512)
    return read_request_into(buffered_source(reader), writer)

# sends one structured response through a buffered writer.
pub fn send_buffered(writer: BufferedBytesWriter, response: HttpResponse) -> Int!:
    return send_buffered_conn(writer, response, "")

# sends a response through a buffered writer with an explicit Connection value.
# the keep-alive serve loops use this so they can keep or close a connection per
# request without rebuilding the handler's response — an empty `connection`
# reproduces `send_buffered` exactly.
pub fn send_buffered_conn(writer: BufferedBytesWriter, response: HttpResponse, connection: String) -> Int!:
    payload := response.to_bytes_conn(connection)!
    written := writer.write_all_bytes(payload)!
    writer.flush()!
    return written

# sends a response head with a fixed body size so callers can stream the body afterwards.
pub fn send_sized_response_head(writer: BufferedBytesWriter, response: HttpResponse, content_length: Int) -> Int!:
    if content_length < 0:
        fail "http response content length must be non-negative"
    if not response.body.is_empty():
        fail "streamed http responses must start with an empty buffered body"
    mut written := writer.write_all_bytes(response_head_bytes(response, content_length, false)!)!
    writer.flush()!
    return written

# writes body bytes for a streaming response and flushes them.
pub fn send_stream_bytes(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    mut written := writer.write_all_bytes(data)!
    writer.flush()!
    return written

# writes body text for a streaming response and flushes it.
pub fn send_stream_text(writer: BufferedBytesWriter, data: String) -> Int!:
    return send_stream_bytes(writer, bytes.from_string_utf8(data))

fn write_file_body(writer: BufferedBytesWriter, file: FileStream) -> Int!:
    reader := file.buffered_bytes_reader_chunked(HTTP_FILE_STREAM_CHUNK_SIZE)
    mut written := 0
    while true:
        chunk := reader.read_bytes(HTTP_FILE_STREAM_CHUNK_SIZE)!
        if chunk.is_empty():
            break
        written = written + writer.write_all_bytes(chunk)!
    writer.flush()!
    return written

# sends a fixed-size response head and then streams a file body.
pub fn send_file_stream(writer: BufferedBytesWriter, response: HttpResponse, file: FileStream, content_length: Int) -> Int!:
    head_written := send_sized_response_head(writer, response, content_length)!
    return head_written + write_file_body(writer, file)!

# opens a file, sends it as a fixed-size response body, and closes it afterwards.
pub fn send_file_path(writer: BufferedBytesWriter, response: HttpResponse, file_path: String) -> Int!:
    meta := streamed_file_info(file_path)!
    file := fs.open(file_path)!
    written := send_file_stream(writer, response, file, meta.size)!
    file.close()
    return written

# guesses a content type from the path and streams the file without buffering it.
pub fn send_static_path(writer: BufferedBytesWriter, response: HttpResponse, file_path: String) -> Int!:
    return send_file_path(writer, static_file_response(response, file_path), file_path)

# streams a file as an attachment download.
pub fn send_download_path(writer: BufferedBytesWriter, response: HttpResponse, file_path: String, download_name: String) -> Int!:
    return send_file_path(writer, download_file_response(response, file_path, download_name), file_path)

# ===============================================================
# Content sniffing
# ===============================================================

# how much of a body detect_content_type looks at, as net/http's does.
SNIFF_LEN := 512

# the html tags that mark a body as html when it starts with one, after any
# leading whitespace, followed by a space or ">". compared ignoring ascii case.
HTML_SNIFF_TAGS := ["<!DOCTYPE HTML", "<HTML", "<HEAD", "<SCRIPT", "<IFRAME", "<H1", "<DIV", "<FONT", "<TABLE", "<A", "<STYLE", "<TITLE", "<B", "<BODY", "<BR", "<P", "<!--"]

# true when `data` holds the ascii text `text` at `at`, comparing ascii
# letters without case when `fold` is set.
fn bytes_have_text(data: Bytes, at: Int, text: String, fold: Bool) -> Bool:
    if at + text.len() > data.len():
        return false
    mut i := 0
    while i < text.len():
        mut want := ord(text[i])
        mut got := data[at + i]
        if fold:
            want = ascii_lower(want)
            got = ascii_lower(got)
        if want != got:
            return false
        i = i + 1
    return true

# true when `data` starts with the byte values in `signature`.
fn bytes_have_prefix(data: Bytes, signature: List[Int]) -> Bool:
    if signature.len() > data.len():
        return false
    mut i := 0
    while i < signature.len():
        if data[i] != signature[i]:
            return false
        i = i + 1
    return true

fn is_sniff_space(b: Int) -> Bool:
    return b == 9 or b == 10 or b == 12 or b == 13 or b == 32

# net/http's definition of a byte that cannot appear in text.
fn is_binary_byte(b: Int) -> Bool:
    return b <= 8 or b == 11 or (b >= 14 and b <= 26) or (b >= 28 and b <= 31)

# true when the text from `at` opens like a json document: an object that
# starts with a key or ends at once, or an array whose first element starts
# like a json value. it is deliberately narrow, so prose that happens to
# begin with "[" stays text/plain.
fn looks_like_json(data: Bytes, at: Int, end: Int) -> Bool:
    first := data[at]
    if first != 123 and first != 91:
        return false
    mut i := at + 1
    while i < end and is_sniff_space(data[i]):
        i = i + 1
    if i >= end:
        return false
    next := data[i]
    if first == 123:
        return next == 34 or next == 125
    if bytes_have_text(data, i, "true", false) or bytes_have_text(data, i, "false", false) or bytes_have_text(data, i, "null", false):
        return true
    return next == 123 or next == 91 or next == 93 or next == 34 or next == 45 or (next >= 48 and next <= 57)

# the media type of `data` from its first bytes, in the spirit of net/http's
# DetectContentType: html, xml, json, pdf, png, jpeg, gif, webp, zip, gzip and
# wasm by their signatures, then "text/plain; charset=utf-8" when none of the
# first 512 bytes is binary, and "application/octet-stream" otherwise.
pub fn detect_content_type(data: Bytes) -> String:
    end := min(data.len(), SNIFF_LEN)
    if bytes_have_prefix(data, [254, 255]):
        return "text/plain; charset=utf-16be"
    if bytes_have_prefix(data, [255, 254]):
        return "text/plain; charset=utf-16le"
    if bytes_have_prefix(data, [239, 187, 191]):
        return "text/plain; charset=utf-8"
    mut at := 0
    while at < end and is_sniff_space(data[at]):
        at = at + 1
    for tag in HTML_SNIFF_TAGS:
        if bytes_have_text(data, at, tag, true) and at + tag.len() < end:
            after := data[at + tag.len()]
            if after == 32 or after == 62:
                return "text/html; charset=utf-8"
    if bytes_have_text(data, at, "<?xml", false):
        return "text/xml; charset=utf-8"
    if bytes_have_text(data, 0, "%PDF-", false):
        return "application/pdf"
    if bytes_have_prefix(data, [137, 80, 78, 71, 13, 10, 26, 10]):
        return MIME_PNG
    if bytes_have_prefix(data, [255, 216, 255]):
        return MIME_JPEG
    if bytes_have_text(data, 0, "GIF87a", false) or bytes_have_text(data, 0, "GIF89a", false):
        return MIME_GIF
    if bytes_have_text(data, 0, "RIFF", false) and bytes_have_text(data, 8, "WEBPVP", false):
        return MIME_WEBP
    if bytes_have_prefix(data, [80, 75, 3, 4]):
        return "application/zip"
    if bytes_have_prefix(data, [31, 139, 8]):
        return "application/x-gzip"
    if bytes_have_prefix(data, [0, 97, 115, 109]):
        return MIME_WASM
    mut i := 0
    while i < end:
        if is_binary_byte(data[i]):
            return MIME_BINARY
        i = i + 1
    if at < end and looks_like_json(data, at, end):
        return MIME_JSON
    return "text/plain; charset=utf-8"

# ===============================================================
# Serving files and content
# ===============================================================

# how much of a file is read at a time when its content is served.
FILE_READ_CHUNK := 65536

# a Range header asking for more parts than this is ignored and the whole
# content is sent, so a request cannot make the server assemble thousands of
# tiny parts. a request whose parts add up to more than the content is
# ignored the same way, as net/http does.
MAX_RANGES := 32

# what serve_content and serve_file send from: content held in memory, or a
# file read one range at a time.
struct ContentSource:
    file_path: String
    data: Bytes
    size: Int

# `length` bytes from `start` of a content source.
fn source_range(src: ContentSource, start: Int, length: Int) -> Bytes!:
    if src.file_path == "":
        return src.data.slice(start, start + length)
    return read_file_range(src.file_path, start, length)

# read `length` bytes from `start` of a file. there is no seek, so the bytes
# before `start` are read and dropped.
fn read_file_range(file_path: String, start: Int, length: Int) -> Bytes!:
    file := fs.open(file_path)!
    defer file.close()
    reader := file.buffered_bytes_reader_chunked(FILE_READ_CHUNK)
    mut skipped := 0
    while skipped < start:
        chunk := reader.read_bytes(min(FILE_READ_CHUNK, start - skipped))!
        if chunk.is_empty():
            fail "file ended before the requested range: " + file_path
        skipped = skipped + chunk.len()
    out := bytes.buffer_with_capacity(length)
    errdefer out.free()
    mut got := 0
    while got < length:
        chunk := reader.read_bytes(min(FILE_READ_CHUNK, length - got))!
        if chunk.is_empty():
            fail "file ended before the requested range: " + file_path
        out.write(chunk)!
        got = got + chunk.len()
    return out.take_bytes()

# the value of `text` when it is one or more ascii digits and fits an Int
# with room to spare, else -1.
fn small_decimal(text: String) -> Int:
    if text.len() == 0 or text.len() > 18 or not is_decimal_text(text):
        return -1
    return parse_int(text) catch -1

fn month_number(name: String) -> Int:
    months := ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    mut i := 0
    while i < months.len():
        if months[i] == name:
            return i + 1
        i = i + 1
    return -1

# unix seconds for a calendar date and an "hh:mm:ss" clock, or a failure when
# any field is out of range.
fn http_date_seconds(year: Int, month_name: String, day: Int, clock: String) -> Int!:
    month := month_number(month_name)
    if year < 1970 or month < 1 or day < 1 or day > datetime.days_in_month(year, month):
        fail "invalid http date"
    if clock.len() != 8 or clock[2] != ":" or clock[5] != ":":
        fail "invalid http date"
    hour := small_decimal(clock.substring(0, 2))
    minute := small_decimal(clock.substring(3, 5))
    second := small_decimal(clock.substring(6, 8))
    if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 60:
        fail "invalid http date"
    days := datetime.to_timestamp(datetime.date(year, month, day)) / 1000
    return days + hour * 3600 + minute * 60 + second

# parse an http date (rfc 9110 5.6.7) into unix seconds. all three forms a
# recipient must accept are read: IMF-fixdate ("Sun, 06 Nov 1994 08:49:37
# GMT"), the obsolete rfc 850 form ("Sunday, 06-Nov-94 08:49:37 GMT", a
# two-digit year from 69 meaning 19xx) and asctime ("Sun Nov  6 08:49:37
# 1994").
pub fn parse_http_date(text: String) -> Int!:
    value := text.trim()
    comma := value.index_of(",")
    if comma == 3 and value.len() == 29 and value.ends_with(" GMT") and value[4] == " " and value[7] == " " and value[11] == " " and value[16] == " ":
        return http_date_seconds(small_decimal(value.substring(12, 16)), value.substring(8, 11), small_decimal(value.substring(5, 7)), value.substring(17, 25))
    if comma > 3:
        rest := value.substring(comma + 1, value.len())
        if rest.len() == 23 and rest[0] == " " and rest[3] == "-" and rest[7] == "-" and rest[10] == " " and rest.ends_with(" GMT"):
            mut year := small_decimal(rest.substring(8, 10))
            if year >= 0 and year < 69:
                year = year + 2000
            elif year >= 69:
                year = year + 1900
            return http_date_seconds(year, rest.substring(4, 7), small_decimal(rest.substring(1, 3)), rest.substring(11, 19))
    if comma < 0 and value.len() == 24 and value[3] == " " and value[7] == " " and value[10] == " " and value[19] == " ":
        return http_date_seconds(small_decimal(value.substring(20, 24)), value.substring(4, 7), small_decimal(value.substring(8, 10).trim()), value.substring(11, 19))
    fail "invalid http date: " + value

# true when the entity-tag list in an If-Match or If-None-Match value names
# `etag`, or is "*". a weak tag ("W/...") matches only when `weak_ok`, which
# is the weak comparison If-None-Match uses (rfc 9110 8.8.3.2). the list is
# scanned rather than split on ",", since a quoted tag may hold a comma.
fn etag_list_matches(list: String, etag: String, weak_ok: Bool) -> Bool:
    if list.trim() == "*":
        return etag != ""
    mut i := 0
    while i < list.len():
        c := list[i]
        if c == " " or c == "\t" or c == ",":
            i = i + 1
            continue
        mut is_weak := false
        if list.substring(i, min(i + 2, list.len())) == "W/":
            is_weak = true
            i = i + 2
        if i >= list.len() or list[i] != "\"":
            return false
        close := list.substring(i + 1, list.len()).index_of("\"")
        if close < 0:
            return false
        tag := list.substring(i, i + close + 2)
        if tag == etag and (weak_ok or not is_weak):
            return true
        i = i + close + 2
    return false

# the outcome of a request's preconditions against a representation with the
# entity tag `etag` and modification time `modified` (0 when unknown), in the
# order rfc 9110 13.2.2 gives: 0 to go on, 412, or 304.
fn precondition_status(req: HttpRequestBytes, etag: String, modified: Int) -> Int:
    method := req.method_text
    safe := method == "GET" or method == "HEAD"
    if_match := req.header_or("If-Match", "")
    if if_match != "":
        if not etag_list_matches(if_match, etag, false):
            return 412
    elif modified > 0:
        unmodified_since := parse_http_date(req.header_or("If-Unmodified-Since", "")) catch -1
        if unmodified_since >= 0 and modified > unmodified_since:
            return 412
    if_none_match := req.header_or("If-None-Match", "")
    if if_none_match != "":
        if etag_list_matches(if_none_match, etag, true):
            if safe:
                return 304
            return 412
    elif safe and modified > 0:
        modified_since := parse_http_date(req.header_or("If-Modified-Since", "")) catch -1
        if modified_since >= 0 and modified <= modified_since:
            return 304
    return 0

# true when an If-Range value still describes the representation, so a range
# may be sent: a strong entity tag equal to `etag`, or a date equal to the
# modification time. anything else means the client's copy is stale and gets
# the whole content.
fn if_range_holds(value: String, etag: String, modified: Int) -> Bool:
    if value.starts_with("\"") or value.starts_with("W/"):
        return etag != "" and value.trim() == etag
    date := parse_http_date(value) catch -1
    return modified > 0 and date == modified

# the ranges a Range value asks for out of `size` bytes, as start, length
# pairs. `status` is 206 with at least one satisfiable range, 416 when the
# value is well formed and none of its ranges overlap the content, and 0 when
# the header should be ignored: another unit, a malformed range, too many
# ranges, or ranges that add up to more than the content.
struct RangePlan:
    status: Int
    starts: List[Int]
    lengths: List[Int]

fn ignore_ranges() -> RangePlan:
    return RangePlan(0, [], [])

fn plan_ranges(value: String, size: Int) -> RangePlan:
    eq := value.index_of("=")
    if eq < 0 or value.substring(0, eq).trim().to_lower() != "bytes":
        return ignore_ranges()
    specs := value.substring(eq + 1, value.len()).split(",")
    if specs.len() > MAX_RANGES:
        return ignore_ranges()
    mut starts: List[Int] := []
    mut lengths: List[Int] := []
    mut total := 0
    mut any_spec := false
    for raw in specs:
        spec := raw.trim()
        if spec == "":
            continue
        any_spec = true
        dash := spec.index_of("-")
        if dash < 0:
            return ignore_ranges()
        first := spec.substring(0, dash).trim()
        last := spec.substring(dash + 1, spec.len()).trim()
        if first == "":
            suffix := small_decimal(last)
            if suffix < 0:
                return ignore_ranges()
            if suffix == 0 or size == 0:
                continue
            length := min(suffix, size)
            starts.push(size - length)
            lengths.push(length)
            total = total + length
            continue
        start := small_decimal(first)
        if start < 0:
            return ignore_ranges()
        mut end := size - 1
        if last != "":
            end = small_decimal(last)
            if end < start:
                return ignore_ranges()
            end = min(end, size - 1)
        if start >= size:
            continue
        starts.push(start)
        lengths.push(end - start + 1)
        total = total + end - start + 1
    if not any_spec:
        return ignore_ranges()
    if starts.len() == 0:
        return RangePlan(416, [], [])
    if total > size:
        return ignore_ranges()
    return RangePlan(206, starts, lengths)

fn content_range(start: Int, length: Int, size: Int) -> String:
    return "bytes " + start.to_string() + "-" + (start + length - 1).to_string() + "/" + size.to_string()

# a multipart/byteranges body (rfc 9110 14.6) holding each planned range.
fn byteranges_body(src: ContentSource, plan: RangePlan, content_type: String, boundary: String) -> Bytes!:
    out := bytes.buffer()
    errdefer out.free()
    mut i := 0
    while i < plan.starts.len():
        out.write_string_utf8("--" + boundary + "\r\nContent-Type: " + content_type + "\r\nContent-Range: " + content_range(plan.starts[i], plan.lengths[i], src.size) + "\r\n\r\n")!
        out.write(source_range(src, plan.starts[i], plan.lengths[i])!)!
        out.write_string_utf8("\r\n")!
        i = i + 1
    out.write_string_utf8("--" + boundary + "--\r\n")!
    return out.take_bytes()

# the content type to send for `name`: from its extension, or sniffed from
# the first bytes when the extension says nothing.
fn served_content_type(name: String, src: ContentSource) -> String!:
    by_name := content_type_for_path(name)
    if by_name != MIME_BINARY:
        return by_name
    return detect_content_type(source_range(src, 0, min(src.size, SNIFF_LEN))!)

# the strong entity tag serve_file and serve_content send: the modification
# time and the size, in hex, as nginx and others derive one.
fn content_etag(modified: Int, size: Int) -> String:
    if modified <= 0:
        return ""
    return "\"" + lower_hex_int(modified) + "-" + lower_hex_int(size) + "\""

# `resp` with its status replaced.
fn with_status(resp: HttpResponse, status: Int) -> HttpResponse:
    return HttpResponse(status, resp.content_type, resp.headers, resp.body, resp.set_cookie_headers, resp.trailers)

# the answer to `req` for a representation: the validators, the
# preconditions, then a single range, several ranges or the whole content.
fn answer_content(req: HttpRequestBytes, name: String, modified: Int, src: ContentSource) -> HttpResponse!:
    etag := content_etag(modified, src.size)
    mut last_modified := ""
    if modified > 0:
        last_modified = http_date(modified)
    precondition := precondition_status(req, etag, modified)
    if precondition == 412:
        return text(412, reason_phrase(412))
    if precondition == 304:
        # a 304 carries the validator the client compares against, and
        # Last-Modified only when there is no ETag (rfc 9110 15.4.5).
        if etag != "":
            return response(304).header("ETag", etag)
        return response(304).header("Last-Modified", last_modified)
    mut base := response(200).header("Accept-Ranges", "bytes")
    if etag != "":
        base = base.header("ETag", etag).header("Last-Modified", last_modified)
    content_type := served_content_type(name, src)!
    method := req.method_text
    range_value := req.header_or("Range", "")
    mut plan := ignore_ranges()
    if method == "GET" and range_value != "":
        if_range := req.header_or("If-Range", "")
        if if_range == "" or if_range_holds(if_range, etag, modified):
            plan = plan_ranges(range_value, src.size)
    if plan.status == 416:
        return text(416, reason_phrase(416)).header("Content-Range", "bytes */" + src.size.to_string())
    if plan.status == 206 and plan.starts.len() == 1:
        start := plan.starts[0]
        length := plan.lengths[0]
        return with_status(base, 206).header("Content-Type", content_type).header("Content-Range", content_range(start, length, src.size)).with_body_bytes(source_range(src, start, length)!)
    if plan.status == 206:
        boundary := multipart_random_boundary()!
        return with_status(base, 206).header("Content-Type", "multipart/byteranges; boundary=" + boundary).with_body_bytes(byteranges_body(src, plan, content_type, boundary)!)
    full := base.header("Content-Type", content_type)
    if method == "HEAD":
        return full.header("Content-Length", src.size.to_string())
    return full.with_body_bytes(source_range(src, 0, src.size)!)

# answer `req` with `content`, as net/http's ServeContent does: the content
# type from `name`'s extension, or sniffed from the content when it has none
# the table knows; an ETag and a Last-Modified from `modified` (unix seconds,
# or 0 when unknown, which sends neither); 304 and 412 for the conditional
# headers (rfc 9110 13.2.2); and 206 for a Range request (rfc 9110 14), as
# multipart/byteranges when it asks for several ranges. a Range the server
# cannot honor sensibly is ignored and the whole content sent, and one that
# no part of the content satisfies gets 416. a HEAD request gets the headers
# with no body.
pub fn serve_content(req: HttpRequestBytes, name: String, modified: Int, content: Bytes) -> HttpResponse:
    return answer_content(req, name, modified, ContentSource("", content, content.len())) catch server_error_response()

# answer `req` with the file at `file_path`, as serve_content does, using the
# file's size and modification time. only the bytes a response carries are
# read, so a 304, a HEAD or a small range never reads the whole file. a path
# that does not name a regular file gets 404, and one holding a NUL byte 400.
pub fn serve_file(req: HttpRequestBytes, file_path: String) -> HttpResponse:
    if file_path.index_of(chr(0)) >= 0:
        return bad_request_response()
    meta := fs.info(file_path) catch:
        return not_found_response()
    if meta.is_dir:
        return not_found_response()
    modified := fs.modified(file_path) catch 0
    return answer_content(req, file_path, modified, ContentSource(file_path, bytes.empty(), meta.size)) catch server_error_response()

# answer `req` with the file `name` names under the directory `root`, as
# net/http's FileServer does. `name` is a "/"-separated path relative to
# root, already percent-decoded, such as a `*path` route parameter. a name
# with a ".." segment gets 404 and one holding a NUL byte 400, so nothing
# outside root is ever read. a directory is answered with its index.html, or
# 404 when it has none; directories are never listed.
pub fn serve_dir(req: HttpRequestBytes, root: String, name: String) -> HttpResponse:
    if name.index_of(chr(0)) >= 0:
        return bad_request_response()
    for segment in name.split("/"):
        if segment == "..":
            return not_found_response()
    mut target := root
    if name.trim() != "":
        target = path_mod.join(root, name)
    if fs.is_dir(target):
        target = path_mod.join(target, "index.html")
    return serve_file(req, target)

# sends a chunked response head so callers can stream chunks without buffering the whole body.
pub fn send_chunked_response_head(writer: BufferedBytesWriter, response: HttpResponse) -> Int!:
    if not response.body.is_empty():
        fail "chunked http responses must start with an empty buffered body"
    mut written := writer.write_all_bytes(response_head_bytes(response, 0, true)!)!
    writer.flush()!
    return written

# writes one chunked response body chunk and flushes it.
pub fn send_chunked_response_bytes(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    if data.is_empty():
        return 0
    crlf := bytes.from_string_utf8(chr(13) + chr(10))
    chunk_size := bytes.from_string_utf8(lower_hex_int(data.len()))
    mut written := 0
    written = written + writer.write_all_bytes(chunk_size.concat(crlf))!
    written = written + writer.write_all_bytes(data)!
    written = written + writer.write_all_bytes(crlf)!
    writer.flush()!
    return written

# writes one text chunk in a chunked response and flushes it.
pub fn send_chunked_response_text(writer: BufferedBytesWriter, data: String) -> Int!:
    return send_chunked_response_bytes(writer, bytes.from_string_utf8(data))

# finishes a chunked response body.
pub fn finish_chunked_response(writer: BufferedBytesWriter) -> Int!:
    tail := bytes.from_string_utf8("0" + chr(13) + chr(10) + chr(13) + chr(10))
    mut written := writer.write_all_bytes(tail)!
    writer.flush()!
    return written

# sends one structured response to a file descriptor.
pub fn send(fd: Int, response: HttpResponse) -> Int!:
    return send_response_bytes(fd, response.to_bytes()!)

# sends a raw response payload to a file descriptor.
pub fn send_response_bytes(fd: Int, response: Bytes) -> Int!:
    stream := io.from_fd(fd)
    writer := stream.buffered_bytes_writer()
    # close the fd and drop the writer's registry entry on every exit, so a failed
    # write or flush cannot leak them. last-in-first-out runs the free before the
    # close, matching the original order.
    defer tcp_close(fd)
    defer writer.free()
    written := writer.write_all_bytes(response)!
    writer.flush()!
    return written
# sends a raw response string to a file descriptor.
pub fn send_response(fd: Int, response: String) -> Int!:
    return send_response_bytes(fd, bytes.from_string_utf8(response))
fn response_headers_map(raw_head: Bytes) -> Map[String, String]:
    mut result: Map[String, String] := {}
    hdrs := headers_bytes(raw_head)
    mut line_start := 0
    mut pos := 0
    while pos <= hdrs.len():
        at_end := pos == hdrs.len()
        mut at_nl := false
        if not at_end:
            at_nl = hdrs[pos] == 10
        if at_end or at_nl:
            line_end := trim_trailing_cr(hdrs, line_start, pos)
            if line_end > line_start:
                line_text := decode_utf8(hdrs.slice(line_start, line_end)) catch ""
                colon := line_text.index_of(":")
                if colon > 0:
                    result = header_with(result, line_text.substring(0, colon).trim(), line_text.substring(colon + 1, line_text.len()).trim())
            line_start = pos + 1
        pos = pos + 1
    return result

fn response_set_cookie_headers(raw_head: Bytes) -> List[String]:
    mut result: List[String] := []
    hdrs := headers_bytes(raw_head)
    mut line_start := 0
    mut pos := 0
    while pos <= hdrs.len():
        at_end := pos == hdrs.len()
        mut at_nl := false
        if not at_end:
            at_nl = hdrs[pos] == 10
        if at_end or at_nl:
            line_end := trim_trailing_cr(hdrs, line_start, pos)
            if line_end > line_start:
                colon := find_byte(hdrs, line_start, 58)
                if colon > line_start and colon < line_end:
                    if header_name_matches(hdrs, line_start, colon, "Set-Cookie"):
                        value_start := trim_ascii_start(hdrs, colon + 1, line_end)
                        value_end := trim_ascii_end(hdrs, value_start, line_end)
                        result.push(decode_utf8(hdrs.slice(value_start, value_end)) catch "")
            line_start = pos + 1
        pos = pos + 1
    return result

# parses a raw http response payload into a structured response. the head is
# checked as read_response_buffered_bytes checks it, and the body is framed by
# it, so bytes past a declared length are ignored.
pub fn parse_response_bytes(raw: Bytes) -> HttpResponse!:
    if raw.len() == 0:
        fail "empty http response"
    # the cursor and reader give their registry entries back, or a client
    # accumulates two per response.
    cursor := io.bytes_reader(raw)
    defer cursor.close()
    reader := cursor.buffered_chunked(4096)
    defer reader.free()
    return read_response_from(buffered_source(reader), "GET")

# parses a raw http response string into a structured response.
pub fn parse_response(raw: String) -> HttpResponse!:
    return parse_response_bytes(bytes.from_string_utf8(raw))

# reads one http response from a buffered bytes reader without waiting for
# connection close. the head is checked (see parse_response_head), interim 1xx
# responses are skipped, and the body is read as the head frames it. a body
# that runs to the close of the connection is read to the end of the reader.
pub fn read_response_buffered_bytes(reader: BufferedBytesReader) -> HttpResponse!:
    return read_response_from(buffered_source(reader), "GET")

# reads one http response and streams the decoded body into a writer.
pub fn read_response_buffered_bytes_into(reader: BufferedBytesReader, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    return read_response_into_from(buffered_source(reader), "GET", writer)

# reads one http response from a tcp stream.
pub fn read_response_stream(stream: TcpStream) -> HttpResponse!:
    reader := stream.buffered_bytes_reader_chunked(4096)
    defer reader.free()
    return read_response_buffered_bytes(reader)

# reads one http response from a tcp stream and streams the decoded body into a writer.
pub fn read_response_stream_into(stream: TcpStream, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    reader := stream.buffered_bytes_reader_chunked(4096)
    defer reader.free()
    return read_response_buffered_bytes_into(reader, writer)

# reads one http response from a tls connection.
pub fn read_response_tls(conn: tls.Conn) -> HttpResponse!:
    return read_response_from(tls_source(conn), "GET")

# reads one http response from a tls connection and streams the decoded body into a writer.
pub fn read_response_tls_into(conn: tls.Conn, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    return read_response_into_from(tls_source(conn), "GET", writer)

# ===============================================================
# HTTP Client
# ===============================================================

# starts building an outbound request.
pub fn request(method: String, host: String, port: Int, url_path: String) -> ClientRequest:
    mut headers: Map[String, String] := {}
    return ClientRequest(method, host, port, normalize_path(url_path), headers, bytes.empty(), false, -1, 0)

# starts a get request builder.
pub fn get_request(host: String, port: Int, url_path: String) -> ClientRequest:
    return request("GET", host, port, url_path)

# starts a post request builder.
pub fn post_request(host: String, port: Int, url_path: String) -> ClientRequest:
    return request("POST", host, port, url_path)

# starts a put request builder.
pub fn put_request(host: String, port: Int, url_path: String) -> ClientRequest:
    return request("PUT", host, port, url_path)

# starts a delete request builder.
pub fn delete_request(host: String, port: Int, url_path: String) -> ClientRequest:
    return request("DELETE", host, port, url_path)

# starts building an outbound https request on port 443.
pub fn https_request(method: String, host: String, url_path: String) -> ClientRequest:
    return ClientRequest(method, host, 443, normalize_path(url_path), {}, bytes.empty(), true, -1, 0)

# starts building an outbound https request on an explicit port.
pub fn https_request_port(method: String, host: String, port: Int, url_path: String) -> ClientRequest:
    return ClientRequest(method, host, port, normalize_path(url_path), {}, bytes.empty(), true, -1, 0)

# starts a get https request builder.
pub fn get_https_request(host: String, url_path: String) -> ClientRequest:
    return https_request("GET", host, url_path)

# Open a plain HTTP client connection.
pub fn connect_client(host: String, port: Int) -> ClientConn!:
    stream := io.connect(host, port)!
    return client_conn_from_stream(stream)

# Open a plain HTTP client connection and set a socket timeout.
pub fn connect_client_with_timeout(host: String, port: Int, timeout_ms: Int) -> ClientConn!:
    conn := connect_client(host, port)!
    conn.stream.set_timeout(timeout_ms)
    return conn

# Open a TLS HTTP client connection using the default TLS config.
pub fn connect_tls_client(host: String, port: Int, server_name: String) -> TlsClientConn!:
    # this call built the config, so this call closes it. the returned
    # connection does not read it again: a tls config is consulted only while
    # the handshake runs, and that finished before this returned. see the
    # ownership note in docs/tls.md.
    config := tls.client_config()!
    defer config.close()
    return connect_tls_client_with_config(host, port, server_name, config)

# Open a TLS HTTP client connection with an explicit TLS config.
pub fn connect_tls_client_with_config(host: String, port: Int, server_name: String, config: tls.Config) -> TlsClientConn!:
    stream := io.connect(host, port)!
    return tls_client_conn_from_stream(stream, server_name, config)

# Open a TLS HTTP client connection and set a socket timeout.
pub fn connect_tls_client_with_timeout(host: String, port: Int, server_name: String, timeout_ms: Int) -> TlsClientConn!:
    config := tls.client_config()!
    defer config.close()
    return connect_tls_client_with_timeout_and_config(host, port, server_name, timeout_ms, config)

# Open a TLS HTTP client connection with explicit timeout and TLS config.
pub fn connect_tls_client_with_timeout_and_config(host: String, port: Int, server_name: String, timeout_ms: Int, config: tls.Config) -> TlsClientConn!:
    stream := io.connect(host, port)!
    stream.set_timeout(timeout_ms)
    return tls_client_conn_from_stream(stream, server_name, config)

# Build one multipart form field.
pub fn multipart_field(name: String, value: String) -> MultipartPart:
    return MultipartPart(name, "", "", {}, bytes.from_string_utf8(value))

# Build one multipart file part from raw bytes.
pub fn multipart_file(name: String, filename: String, content_type: String, body: Bytes) -> MultipartPart:
    return MultipartPart(name, filename, content_type, {}, body)

# Build one multipart file part from text.
pub fn multipart_file_text(name: String, filename: String, content_type: String, body_text: String) -> MultipartPart:
    return multipart_file(name, filename, content_type, bytes.from_string_utf8(body_text))

fn request_default_port(use_tls: Bool) -> Int:
    if use_tls:
        return 443
    return 80

fn lower_hex_digit(value: Int) -> String:
    digits := "0123456789abcdef"
    return digits[value]

fn lower_hex_int(value: Int) -> String:
    if value == 0:
        return "0"
    mut n := value
    mut out := ""
    while n > 0:
        out = lower_hex_digit(n % 16) + out
        n = n / 16
    return out

# the Host value for an origin: the host, bracketed when it is an ipv6
# literal, and the port when it is not the scheme's default (rfc 9110 7.2).
fn host_header_value(host: String, port: Int, use_tls: Bool) -> String:
    mut name := host
    if host.index_of(":") >= 0 and not host.starts_with("["):
        name = "[" + host + "]"
    if port > 0 and port != request_default_port(use_tls):
        return name + ":" + port.to_string()
    return name

# whether a request's body goes out chunked: it names a Transfer-Encoding of
# chunked. any other Transfer-Encoding a request names is dropped, and the
# body is sent with a Content-Length.
fn request_sends_chunked(req: ClientRequest) -> Bool:
    return header_lookup(req.headers, "Transfer-Encoding").trim().to_lower() == "chunked"

# whether a request with an empty body still says Content-Length: 0. as in
# net/http, only the methods that expect a body do.
fn method_expects_body(method: String) -> Bool:
    return method == "POST" or method == "PUT" or method == "PATCH"

# the head of `req` for the request-target `target`. the request's own fields
# are written with CR, LF and NUL stripped, then Host when the request names
# none, `connection` when it is not empty and the request names no
# Connection, Accept-Encoding: gzip when `accept_gzip` is set and the request
# names none, and the framing of the body. a Content-Length or
# Transfer-Encoding the request names is replaced by the framing that matches
# the body.
fn request_head_bytes(req: ClientRequest, target: String, connection: String, accept_gzip: Bool) -> Bytes:
    crlf := chr(13) + chr(10)
    out := bytes.buffer()
    mut line := strip_header_controls(req.method) + " " + strip_header_controls(target) + " HTTP/1.1" + crlf
    if header_lookup(req.headers, "Host") == "":
        line = line + "Host: " + strip_header_controls(host_header_value(req.host, req.port, req.use_tls)) + crlf
    out.write(bytes.from_string_utf8(line)) catch 0
    for key in req.headers:
        if header_key_matches(key, "Content-Length") or header_key_matches(key, "Transfer-Encoding"):
            continue
        # strip CR/LF/NUL so an untrusted value reflected into a header
        # (.bearer, .cookie, .header with attacker input) cannot inject a
        # second header or splice a whole request into the outbound
        # stream — the same guard the response path applies.
        out.write(bytes.from_string_utf8(strip_header_controls(key) + ": " + strip_header_controls(req.headers[key]) + crlf)) catch 0
    mut tail := ""
    if connection != "" and header_lookup(req.headers, "Connection") == "":
        tail = tail + "Connection: " + connection + crlf
    if accept_gzip and header_lookup(req.headers, "Accept-Encoding") == "":
        tail = tail + "Accept-Encoding: gzip" + crlf
    if request_sends_chunked(req):
        tail = tail + "Transfer-Encoding: chunked" + crlf
    elif not req.body.is_empty() or method_expects_body(req.method):
        tail = tail + "Content-Length: " + req.body.len().to_string() + crlf
    out.write(bytes.from_string_utf8(tail + crlf)) catch 0
    return out.take_bytes()

# the body of `req` as it goes on the wire: as it is, or as one chunk and the
# last chunk when it goes out chunked.
fn request_body_bytes(req: ClientRequest) -> Bytes:
    if not request_sends_chunked(req):
        return req.body
    crlf := chr(13) + chr(10)
    if req.body.is_empty():
        return bytes.from_string_utf8("0" + crlf + crlf)
    out := bytes.buffer_with_capacity(req.body.len() + 32)
    out.write(bytes.from_string_utf8(lower_hex_int(req.body.len()) + crlf)) catch 0
    out.write(req.body) catch 0
    out.write(bytes.from_string_utf8(crlf + "0" + crlf + crlf)) catch 0
    return out.take_bytes()

# the whole request, head and body.
fn request_wire_bytes(req: ClientRequest, target: String, connection: String, accept_gzip: Bool) -> Bytes!:
    head := request_head_bytes(req, target, connection, accept_gzip)
    body := request_body_bytes(req)
    if body.is_empty():
        return head
    return head.concat(body)

fn client_conn_from_stream(stream: TcpStream) -> ClientConn:
    return ClientConn(stream, stream.buffered_bytes_reader_chunked(512), stream.buffered_bytes_writer())

fn tls_client_conn_from_stream(stream: TcpStream, server_name: String, config: tls.Config) -> TlsClientConn!:
    return TlsClientConn(tls.client(stream, server_name, config)!)

fn request_origin_changed(req: ClientRequest, next_use_tls: Bool, next_host: String, next_port: Int) -> Bool:
    return req.use_tls != next_use_tls or req.host != next_host or req.port != next_port

fn redirect_status(status: Int) -> Bool:
    return status == 301 or status == 302 or status == 303 or status == 307 or status == 308

# whether a redirect keeps the request's method, as net/http decides: 307 and
# 308 always do, and 301, 302 and 303 do for GET and HEAD. any other method
# becomes GET.
fn redirect_preserves_method(status: Int, method: String) -> Bool:
    if status == 307 or status == 308:
        return true
    return method == "GET" or method == "HEAD"

# the target a relative Location names (rfc 3986 5.2), resolved against the
# current request's target. a fragment is dropped, and dot segments are
# removed as clean_path removes them.
fn redirect_target_path(current_path: String, location: String) -> String:
    mut loc := location
    hash := loc.index_of("#")
    if hash >= 0:
        loc = loc.substring(0, hash)
    if loc == "":
        return current_path
    current_query := current_path.index_of("?")
    mut base_path := current_path
    if current_query >= 0:
        base_path = current_path.substring(0, current_query)
    mut joined := loc
    if loc.starts_with("?"):
        joined = base_path + loc
    elif not loc.starts_with("/"):
        slash := base_path.last_index_of("/")
        if slash < 0:
            joined = "/" + loc
        else:
            joined = base_path.substring(0, slash + 1) + loc
    query_at := joined.index_of("?")
    mut joined_path := joined
    mut rest := ""
    if query_at >= 0:
        joined_path = joined.substring(0, query_at)
        rest = joined.substring(query_at, joined.len())
    if path_is_clean(joined_path):
        return joined
    return clean_path(joined_path) + rest

fn redirect_request(req: ClientRequest, resp: HttpResponse) -> ClientRequest!:
    mut location := resp.header_value("Location")
    if location == "":
        fail "redirect response is missing location"
    # a network-path reference keeps the current scheme (rfc 3986 4.2)
    if location.starts_with("//"):
        if req.use_tls:
            location = "https:" + location
        else:
            location = "http:" + location

    mut next_use_tls := req.use_tls
    mut next_host := req.host
    mut next_port := req.port
    mut next_path := req.path

    if location.starts_with("http://") or location.starts_with("https://"):
        parsed := url_mod.parse(location)
        scheme := url_mod.scheme(parsed)
        next_use_tls = scheme == "https"
        next_host = url_mod.host(parsed)
        if next_host == "":
            fail "redirect location is missing host"
        next_port = url_mod.port(parsed)
        if next_port < 0:
            next_port = request_default_port(next_use_tls)
        next_path = url_mod.path(parsed)
        if next_path == "":
            next_path = "/"
        query_text := url_mod.query(parsed)
        if query_text != "":
            next_path = next_path + "?" + query_text
    else:
        next_path = redirect_target_path(req.path, location)

    mut next_method := req.method
    mut next_body := req.body
    mut next_headers := copy_headers_map(req.headers)
    if not redirect_preserves_method(resp.status, req.method):
        next_method = "GET"
    # only 307 and 308 send the body again
    if resp.status != 307 and resp.status != 308:
        next_body = bytes.empty()
        next_headers = header_without(header_without(next_headers, "Content-Type"), "Transfer-Encoding")
    if request_origin_changed(req, next_use_tls, next_host, next_port):
        next_headers = header_without(next_headers, "Authorization")
        next_headers = header_without(next_headers, "Cookie")
    return ClientRequest(next_method, next_host, next_port, normalize_path(next_path), next_headers, next_body, next_use_tls, req.timeout_ms, req.redirect_limit)

# one http/1.1 client connection: a plain socket with its buffered reader and
# writer, or a tls session over the socket. `key` names the origin it was
# dialed for, `idle_since` is when it last went idle on the mono_millis clock,
# and `reused` is whether it has carried an exchange before the current one.
struct WireConn:
    stream: TcpStream
    reader: BufferedBytesReader
    writer: BufferedBytesWriter
    tls_conn: tls.Conn
    use_tls: Bool
    key: String
    mut idle_since: Int
    mut reused: Bool

# a tls config that names none. config handles start at 0 and a Config
# closes its handle when dropped, so a placeholder must use a handle that is
# never issued.
fn no_tls_config() -> tls.Config:
    return tls.Config(0 - 1)

fn plain_wire(stream: TcpStream, key: String) -> WireConn:
    return WireConn(stream, stream.buffered_bytes_reader_chunked(4096), stream.buffered_bytes_writer(), tls.Conn(0), false, key, 0, false)

# run the tls handshake over `stream`. the stream is closed when it fails.
fn tls_wire(stream: TcpStream, server_name: String, config: tls.Config, key: String) -> WireConn!:
    conn := tls.client(stream, server_name, config)
    if conn.is_err:
        stream.close()
        fail conn.err
    return WireConn(stream, BufferedBytesReader(0), BufferedBytesWriter(0), conn.ok, true, key, 0, false)

fn wire_source(c: WireConn) -> ByteSource:
    return ByteSource(c.reader, c.tls_conn, c.use_tls, c.stream.fd)

fn wire_write(c: WireConn, data: Bytes) -> Int!:
    if c.use_tls:
        return c.tls_conn.write_all_bytes(data)
    written := c.writer.write_all_bytes(data)!
    c.writer.flush()!
    return written

# close the connection and give back the reader's and writer's registry
# entries.
fn wire_close(c: WireConn):
    if c.use_tls:
        c.tls_conn.close()
        return
    c.reader.free()
    c.writer.free()
    c.stream.close()

# dial the request's origin for a single exchange. `with_timeout` on the
# request is a per-read socket timeout here.
fn open_wire(req: ClientRequest, server_name: String, config: tls.Config) -> WireConn!:
    stream := io.connect(req.host, req.port)!
    if req.timeout_ms >= 0:
        stream.set_timeout(req.timeout_ms)
    if req.use_tls:
        return tls_wire(stream, server_name, config, "")
    return plain_wire(stream, "")

# send `req` on a connection of its own and read the response the head frames.
fn send_request_wire(req: ClientRequest, server_name: String, config: tls.Config) -> HttpResponse!:
    c := open_wire(req, server_name, config)!
    defer wire_close(c)
    wire_write(c, req.to_bytes()!)!
    return read_response_from(wire_source(c), req.method)

# like send_request_wire, but the body goes to `writer`. when `follow` is set,
# the body of a redirect is read and dropped, since the caller follows it.
fn send_request_wire_into(req: ClientRequest, server_name: String, config: tls.Config, writer: BufferedBytesWriter, follow: Bool) -> StreamedHttpResponse!:
    c := open_wire(req, server_name, config)!
    defer wire_close(c)
    wire_write(c, req.to_bytes()!)!
    src := wire_source(c)
    parsed := read_response_head_from(src, req.method)!
    if follow and redirect_status(parsed.status):
        read_response_body_from(src, parsed, {})!
        return streamed_response_from_parsed(parsed, 0)
    return streamed_response_from_parsed(parsed, stream_response_body_from(src, parsed, writer, {})!)

fn send_request_once(req: ClientRequest) -> HttpResponse!:
    if req.use_tls:
        config := tls.client_config()!
        defer config.close()
        return send_request_wire(req, req.host, config)
    return send_request_wire(req, req.host, no_tls_config())

fn send_request_once_with_tls_config(req: ClientRequest, tls_config: tls.Config) -> HttpResponse!:
    if req.use_tls:
        return send_request_wire(req, req.host, tls_config)
    return send_request_wire(req, req.host, no_tls_config())

fn send_request_following_redirects(req: ClientRequest) -> HttpResponse!:
    mut current := req
    mut redirects_left := req.redirect_limit
    while true:
        resp := send_request_once(current)!
        if redirects_left <= 0 or not redirect_status(resp.status):
            return resp
        current = redirect_request(current, resp)!
        redirects_left = redirects_left - 1

fn send_request_following_redirects_with_tls_config(req: ClientRequest, tls_config: tls.Config) -> HttpResponse!:
    mut current := req
    mut redirects_left := req.redirect_limit
    while true:
        resp := send_request_once_with_tls_config(current, tls_config)!
        if redirects_left <= 0 or not redirect_status(resp.status):
            return resp
        current = redirect_request(current, resp)!
        redirects_left = redirects_left - 1

# the tls send path shared by send_tls_with_config and its traced wrapper: force
# tls on, then dispatch to the plain-host redirect path or a single sni request.
fn send_tls_request(req: ClientRequest, server_name: String, config: tls.Config) -> HttpResponse!:
    current := ClientRequest(req.method, req.host, req.port, req.path, copy_headers_map(req.headers), req.body, true, req.timeout_ms, req.redirect_limit)
    if server_name != req.host:
        return send_request_wire(current, server_name, config)
    return send_request_following_redirects_with_tls_config(current, config)

# --- client-side tracing ----------------------------------------------------
# these run only when tracing is active (the send methods gate on
# trace.is_active() first), so an uninstrumented program pays a single bool check.

# start a CLIENT span for an outbound request and tag it with the method and url.
fn start_http_client_span(method: String, host: String, path: String) -> trace.Span:
    span := trace.start_kind("HTTP " + method, trace.CLIENT)
    span.set_attr("http.request.method", method).set_attr("http.url", host + path)
    return span

# set a client span's status from the response (>= 400, or `status` < 0 for a
# transport error, is an error), end it, and record the RED metrics.
fn finish_http_client_span(span: trace.Span, method: String, status: Int, start_ns: Int):
    mut status_label := "error"
    if status < 0:
        span.set_status(trace.STATUS_ERROR, "transport error")
    else:
        status_label = status.to_string()
        span.set_attr("http.response.status_code", status_label)
        if status >= 400:
            span.set_status(trace.STATUS_ERROR, "http status " + status_label)
        else:
            span.set_status(trace.STATUS_OK, "")
    span.end()
    elapsed_ms := (time_mod.mono_nanos() - start_ns) / 1000000
    metrics.counter("http_client_requests_total").labels(["method", method, "status", status_label]).inc()
    metrics.histogram("http_client_duration_ms").labels(["method", method]).observe(elapsed_ms.to_float())

# --- server-side tracing ----------------------------------------------------

# begin a SERVER span for an inbound request. it extracts any W3C `traceparent`
# header so the span joins the caller's trace, then starts a span named
# "METHOD path". pair it with end_server_span once the response status is known;
# there is no server framework, so a handler wires the two calls in by hand:
#
#     span := http.begin_server_span(req)
#     resp := handle(req)
#     http.end_server_span(span, resp.status)
#
# a cheap no-op (a non-recording span) when tracing is inactive.
pub fn begin_server_span(req: HttpRequestBytes) -> trace.Span:
    if not trace.is_active():
        return trace.start_kind("", trace.SERVER)
    incoming := req.header("traceparent") catch ""
    if incoming != "":
        parsed := trace.parse_traceparent(incoming)
        if parsed != none:
            trace.with_context(parsed.value())
    span := trace.start_kind(req.method_text + " " + req.path_text, trace.SERVER)
    span.set_attr("http.request.method", req.method_text).set_attr("url.path", req.path_text)
    return span

# close a server span opened by begin_server_span: tag it with the response
# status, mark it an error on a 5xx, and end it. it records no metrics — a
# framework that keeps its own per-request metrics (std.web does) closes the span
# with this and counts separately, so the RED series are not recorded twice. a
# no-op when tracing is inactive.
pub fn finish_server_span(span: trace.Span, status: Int):
    if not trace.is_active():
        return
    status_label := status.to_string()
    span.set_attr("http.response.status_code", status_label)
    if status >= 500:
        span.set_status(trace.STATUS_ERROR, "http status " + status_label)
    else:
        span.set_status(trace.STATUS_OK, "")
    span.end()

# finish a server span from begin_server_span: close it (finish_server_span) and
# record the http_server RED metrics labeled by method, route, and status. a
# no-op when tracing is inactive. std.web keeps its own always-on metrics, so it
# closes spans with finish_server_span instead of this.
pub fn end_server_span(span: trace.Span, status: Int):
    if not trace.is_active():
        return
    # the span name is "METHOD path"; read it before finishing, then split it
    # back into the metric labels.
    name := span.name
    started_ns := span.start_unix_ns
    finish_server_span(span, status)
    status_label := status.to_string()
    space := name.index_of(" ")
    mut method := name
    mut route := ""
    if space >= 0:
        method = name.substring(0, space)
        route = name.substring(space + 1, name.len())
    elapsed_ms := time_mod.now() - (started_ns / 1000000)
    metrics.counter("http_server_requests_total").labels(["method", method, "route", route, "status", status_label]).inc()
    metrics.histogram("http_server_duration_ms").labels(["method", method, "route", route]).observe(elapsed_ms.to_float())

fn send_request_following_redirects_into(req: ClientRequest, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    mut current := req
    mut redirects_left := req.redirect_limit
    while true:
        mut resp := StreamedHttpResponse(0, "", {}, [], 0)
        if current.use_tls:
            # one config per hop, closed at the end of the hop: a redirect chain
            # would otherwise leave a registry slot behind for every hop.
            config := tls.client_config()!
            defer config.close()
            resp = send_request_wire_into(current, current.host, config, writer, current.redirect_limit > 0)!
        else:
            resp = send_request_wire_into(current, current.host, no_tls_config(), writer, current.redirect_limit > 0)!
        if redirects_left <= 0 or not redirect_status(resp.status):
            return resp
        current = redirect_request(current, HttpResponse(resp.status, resp.content_type, copy_headers_map(resp.headers), bytes.empty(), copy_string_list(resp.set_cookie_headers), {}))!
        redirects_left = redirects_left - 1
        current = ClientRequest(current.method, current.host, current.port, current.path, copy_headers_map(current.headers), current.body, current.use_tls, current.timeout_ms, redirects_left)

fn send_request_following_redirects_into_with_tls_config(req: ClientRequest, tls_config: tls.Config, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
    mut current := req
    mut redirects_left := req.redirect_limit
    while true:
        if current.use_tls:
            resp := send_request_wire_into(current, current.host, tls_config, writer, current.redirect_limit > 0)!
            if redirects_left <= 0 or not redirect_status(resp.status):
                return resp
            current = redirect_request(current, HttpResponse(resp.status, resp.content_type, copy_headers_map(resp.headers), bytes.empty(), copy_string_list(resp.set_cookie_headers), {}))!
            redirects_left = redirects_left - 1
            current = ClientRequest(current.method, current.host, current.port, current.path, copy_headers_map(current.headers), current.body, current.use_tls, current.timeout_ms, redirects_left)
            continue
        resp := send_request_wire_into(current, current.host, no_tls_config(), writer, current.redirect_limit > 0)!
        if redirects_left <= 0 or not redirect_status(resp.status):
            return resp
        current = redirect_request(current, HttpResponse(resp.status, resp.content_type, copy_headers_map(resp.headers), bytes.empty(), copy_string_list(resp.set_cookie_headers), {}))!
        redirects_left = redirects_left - 1
        current = ClientRequest(current.method, current.host, current.port, current.path, copy_headers_map(current.headers), current.body, current.use_tls, current.timeout_ms, redirects_left)

impl ClientRequest:
    fn header(name: String, value: String) -> ClientRequest:
        return ClientRequest(self.method, self.host, self.port, self.path, header_with(self.headers, name, value), self.body, self.use_tls, self.timeout_ms, self.redirect_limit)

    fn keep_alive() -> ClientRequest:
        return self.header("Connection", "keep-alive")

    fn close_connection() -> ClientRequest:
        return self.header("Connection", "close")

    fn with_timeout(ms: Int) -> ClientRequest:
        return ClientRequest(self.method, self.host, self.port, self.path, copy_headers_map(self.headers), self.body, self.use_tls, ms, self.redirect_limit)

    fn follow_redirects(limit: Int) -> ClientRequest:
        mut next_limit := limit
        if next_limit < 0:
            next_limit = 0
        return ClientRequest(self.method, self.host, self.port, self.path, copy_headers_map(self.headers), self.body, self.use_tls, self.timeout_ms, next_limit)

    fn no_redirects() -> ClientRequest:
        return self.follow_redirects(0)

    fn query_param(name: String, value: String) -> ClientRequest:
        return ClientRequest(self.method, self.host, self.port, append_query_param_to_path(self.path, name, value), copy_headers_map(self.headers), self.body, self.use_tls, self.timeout_ms, self.redirect_limit)

    fn query_params(values: Map[String, String]) -> ClientRequest:
        mut next := self
        for key in values:
            next = next.query_param(key, values[key])
        return next

    fn body_text(text: String) -> ClientRequest:
        return ClientRequest(self.method, self.host, self.port, self.path, copy_headers_map(self.headers), bytes.from_string_utf8(text), self.use_tls, self.timeout_ms, self.redirect_limit)

    fn body_bytes(data: Bytes) -> ClientRequest:
        return ClientRequest(self.method, self.host, self.port, self.path, copy_headers_map(self.headers), data, self.use_tls, self.timeout_ms, self.redirect_limit)

    fn text_body(text: String) -> ClientRequest:
        return self.body_text(text)

    fn bytes_body(data: Bytes) -> ClientRequest:
        return self.body_bytes(data)

    fn json_body(handle: Int) -> ClientRequest:
        return self.body_text(json_mod.encode(handle)).header("Content-Type", MIME_JSON)

    fn form_body(fields: Map[String, String]) -> ClientRequest:
        return self.body_text(form_encode_fields(fields)).header("Content-Type", "application/x-www-form-urlencoded")

    fn multipart_body(parts: List[MultipartPart]) -> ClientRequest!:
        return self.multipart_body_with_boundary(parts, multipart_random_boundary()!)

    fn multipart_body_with_boundary(parts: List[MultipartPart], boundary: String) -> ClientRequest!:
        body := encode_multipart(parts, boundary)!
        content_type := MIME_MULTIPART_FORM + "; boundary=" + boundary
        return self.body_bytes(body).header("Content-Type", content_type)

    fn accept(content_type: String) -> ClientRequest:
        return self.header("Accept", content_type)

    fn bearer(token: String) -> ClientRequest:
        return self.header("Authorization", "Bearer " + token)

    fn basic_auth(username: String, password: String) -> ClientRequest:
        creds := username + ":" + password
        return self.header("Authorization", "Basic " + encoding.b64_encode(bytes.from_string_utf8(creds)))

    fn cookie(name: String, value: String) -> ClientRequest:
        return self.header("Cookie", append_cookie_header(header_lookup(self.headers, "Cookie"), name, value))

    # ask the server to confirm with 100 Continue before the body is sent
    # (rfc 9110 10.1.1). http.Client waits for it up to its
    # expect_continue_timeout_ms; the single-connection send paths send the
    # body with the head.
    fn expect_continue() -> ClientRequest:
        return self.header("Expect", "100-continue")

    # the request as it goes on the wire on a connection of its own: the head,
    # with Connection: close unless the request names a Connection, then the
    # body (see request_wire_bytes).
    fn to_bytes() -> Bytes!:
        return request_wire_bytes(self, normalize_path(self.path), "close", false)

    fn send() -> HttpResponse!:
        if not trace.is_active():
            return send_request_following_redirects(self)
        span := start_http_client_span(self.method, self.host, self.path)
        traced := self.header("traceparent", trace.format_traceparent(span.context()))
        started := time_mod.mono_nanos()
        result := send_request_following_redirects(traced)
        if result.is_err:
            finish_http_client_span(span, self.method, -1, started)
        else:
            finish_http_client_span(span, self.method, result.ok.status, started)
        return result!

    fn send_tls() -> HttpResponse!:
        config := tls.client_config()!
        defer config.close()
        return self.send_tls_with_config(self.host, config)

    fn send_https() -> HttpResponse!:
        return self.send_tls()

    fn send_tls_with_config(server_name: String, config: tls.Config) -> HttpResponse!:
        if not trace.is_active():
            return send_tls_request(self, server_name, config)
        span := start_http_client_span(self.method, self.host, self.path)
        traced := self.header("traceparent", trace.format_traceparent(span.context()))
        started := time_mod.mono_nanos()
        result := send_tls_request(traced, server_name, config)
        if result.is_err:
            finish_http_client_span(span, self.method, -1, started)
        else:
            finish_http_client_span(span, self.method, result.ok.status, started)
        return result!

    fn send_into(writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        return send_request_following_redirects_into(self, writer)

    fn send_tls_into(writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        config := tls.client_config()!
        defer config.close()
        return self.send_tls_into_with_config(self.host, config, writer)

    fn send_tls_into_with_config(server_name: String, config: tls.Config, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        current := ClientRequest(self.method, self.host, self.port, self.path, copy_headers_map(self.headers), self.body, true, self.timeout_ms, self.redirect_limit)
        if server_name == self.host:
            return send_request_following_redirects_into_with_tls_config(current, config, writer)
        return send_request_wire_into(current, server_name, config, writer, false)

    fn send_to_file(output_path: String) -> StreamedHttpResponse!:
        file := fs.create(output_path)!
        writer := output_file_writer(file)
        streamed := self.send_into(writer)!
        finish_output_file_writer(file, writer)!
        return streamed

    fn send_tls_to_file(output_path: String) -> StreamedHttpResponse!:
        config := tls.client_config()!
        defer config.close()
        return self.send_tls_to_file_with_config(self.host, config, output_path)

    fn send_tls_to_file_with_config(server_name: String, config: tls.Config, output_path: String) -> StreamedHttpResponse!:
        file := fs.create(output_path)!
        writer := output_file_writer(file)
        streamed := self.send_tls_into_with_config(server_name, config, writer)!
        finish_output_file_writer(file, writer)!
        return streamed

    fn send_bytes() -> Bytes!:
        return self.send()!.body_bytes()

    fn send_tls_bytes() -> Bytes!:
        return self.send_tls()!.body_bytes()

impl ClientConn:
    fn send(req: ClientRequest) -> HttpResponse!:
        if req.timeout_ms >= 0:
            self.stream.set_timeout(req.timeout_ms)
        self.writer.write_all_bytes(req.to_bytes()!)!
        self.writer.flush()!
        return read_response_from(buffered_source(self.reader), req.method)

    fn close():
        self.reader.free()
        self.writer.free()
        self.stream.close()

    fn send_into(req: ClientRequest, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        if req.timeout_ms >= 0:
            self.stream.set_timeout(req.timeout_ms)
        self.writer.write_all_bytes(req.to_bytes()!)!
        self.writer.flush()!
        return read_response_into_from(buffered_source(self.reader), req.method, writer)

    fn send_to_file(req: ClientRequest, output_path: String) -> StreamedHttpResponse!:
        file := fs.create(output_path)!
        writer := output_file_writer(file)
        streamed := self.send_into(req, writer)!
        finish_output_file_writer(file, writer)!
        return streamed

impl TlsClientConn:
    fn send(req: ClientRequest) -> HttpResponse!:
        self.conn.write_all_bytes(req.to_bytes()!)!
        return read_response_from(tls_source(self.conn), req.method)

    fn close():
        self.conn.close()

    fn send_into(req: ClientRequest, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        self.conn.write_all_bytes(req.to_bytes()!)!
        return read_response_into_from(tls_source(self.conn), req.method, writer)

    fn send_to_file(req: ClientRequest, output_path: String) -> StreamedHttpResponse!:
        file := fs.create(output_path)!
        writer := output_file_writer(file)
        streamed := self.send_into(req, writer)!
        finish_output_file_writer(file, writer)!
        return streamed

# ===============================================================
# Client
# ===============================================================

# the idle connections of a client, by origin, and how many it has dialed.
struct ConnPool:
    mut idle: Map[String, List[WireConn]]
    mu: Mutex
    mut dialed: Int

# an http/1.1 client in the shape of net/http's Client and Transport: it keeps
# connections alive and reuses them per origin, follows redirects, and bounds
# a request in time. build one with client() and the with_* methods:
#
#   c := http.client().with_timeout(5000).with_max_idle_conns_per_host(4)
#   resp := c.get("http://127.0.0.1:8080/health")!
#
# the fields, all of which with_* sets:
#   * timeout_ms: how long a request may take in all, redirects included,
#     until its body has been read. 0 for no limit. a request's own
#     with_timeout replaces it for that request.
#   * dial_timeout_ms: how long a connect may take. 0 for no limit but
#     timeout_ms.
#   * response_header_timeout_ms: how long to wait for the response head once
#     the request has been written. 0 for no limit but timeout_ms.
#   * max_idle_conns_per_host: how many idle connections are kept per origin.
#   * idle_conn_timeout_ms: how long an idle connection is kept. 0 keeps it
#     until the server closes it.
#   * max_redirects: how many redirects a request follows before it fails. 0
#     returns the first redirect response as it is.
#   * keep_alives: false sends Connection: close and never reuses a
#     connection.
#   * compression: whether a request that names no Accept-Encoding asks for
#     gzip, and has a gzip body decoded before it is returned, as net/http's
#     transport does. the decoded response has no Content-Encoding or
#     Content-Length. a streamed body (send_into, send_to_file) is never
#     asked for compressed, and neither is a HEAD or a Range request.
#   * expect_continue_timeout_ms: for a request that names Expect:
#     100-continue (see ClientRequest.expect_continue), how long to wait for
#     the server's 100 Continue before the body is sent anyway. a final
#     response that arrives first is returned without the body being sent.
#     0 sends the body with the head, without waiting.
#   * proxy_url: an http proxy every request goes through, as
#     "http://host:port" or "host:port", or "" for none. a plain http request
#     is sent to the proxy with an absolute-form target; an https request
#     goes through a CONNECT tunnel, with tls to the origin inside it.
#   * env_proxy: when proxy_url is "", take the proxy from HTTP_PROXY,
#     HTTPS_PROXY and NO_PROXY (or their lowercase forms), as net/http's
#     ProxyFromEnvironment does (see proxy_from_env).
#   * tls_config: the tls config for https origins, set with
#     with_tls_config. the caller owns it and closes it after the client's
#     last request. without one, each new connection uses the default client
#     config.
#
# a Client is safe to share between tasks: the idle connections are guarded
# by a lock, and a connection is used by one request at a time.
pub struct Client:
    pub mut timeout_ms: Int
    pub mut dial_timeout_ms: Int
    pub mut response_header_timeout_ms: Int
    pub mut max_idle_conns_per_host: Int
    pub mut idle_conn_timeout_ms: Int
    pub mut max_redirects: Int
    pub mut keep_alives: Bool
    pub mut compression: Bool
    pub mut expect_continue_timeout_ms: Int
    pub mut proxy_url: String
    pub mut env_proxy: Bool
    pub mut tls_config: tls.Config
    pool: ConnPool

# net/http's DefaultMaxIdleConnsPerHost and the idle timeout of its
# DefaultTransport.
DEFAULT_MAX_IDLE_CONNS_PER_HOST := 2
DEFAULT_IDLE_CONN_TIMEOUT_MS := 90000
# net/http's limit on the redirects one request follows.
DEFAULT_MAX_REDIRECTS := 10
# the ExpectContinueTimeout of net/http's DefaultTransport.
DEFAULT_EXPECT_CONTINUE_TIMEOUT_MS := 1000

# a client with net/http's defaults: no time limit, two idle connections per
# origin kept for 90 seconds, up to 10 redirects, gzip asked for and decoded,
# and a 1 second wait for 100 Continue.
pub fn client() -> Client:
    return Client(0, 0, 0, DEFAULT_MAX_IDLE_CONNS_PER_HOST, DEFAULT_IDLE_CONN_TIMEOUT_MS, DEFAULT_MAX_REDIRECTS, true, true, DEFAULT_EXPECT_CONTINUE_TIMEOUT_MS, "", false, no_tls_config(), ConnPool({}, Mutex(), 0))

# a request for `method` and an absolute http or https url, as net/http's
# NewRequest builds one.
pub fn new_request(method: String, raw_url: String) -> ClientRequest!:
    parsed := url_mod.parse(raw_url)
    scheme := url_mod.scheme(parsed).to_lower()
    if scheme != "http" and scheme != "https":
        fail "http: unsupported url scheme: " + raw_url
    host := url_mod.host(parsed)
    if host == "":
        fail "http: url has no host: " + raw_url
    use_tls := scheme == "https"
    mut port := url_mod.port(parsed)
    if port < 0:
        port = request_default_port(use_tls)
    mut target := url_mod.path(parsed)
    if target == "":
        target = "/"
    query_text := url_mod.query(parsed)
    if query_text != "":
        target = target + "?" + query_text
    return ClientRequest(method, host, port, normalize_path(target), {}, bytes.empty(), use_tls, -1, 0)

# the pool key of an origin.
fn origin_key(use_tls: Bool, host: String, port: Int) -> String:
    if use_tls:
        return "https://" + host.to_lower() + ":" + port.to_string()
    return "http://" + host.to_lower() + ":" + port.to_string()

# whether an idle connection can carry another request: it has not been idle
# too long, and nothing is waiting to be read on it. an idle connection with
# bytes to read has been closed by the server, or sent something no request
# asked for, and is not used again.
fn idle_conn_usable(c: WireConn, idle_timeout_ms: Int) -> Bool:
    if idle_timeout_ms > 0 and time_mod.mono_millis() - c.idle_since >= idle_timeout_ms:
        return false
    return tcp_wait_readable(c.stream.fd, 0) == 0

# whether a request that failed on a reused connection before any of the
# response arrived may be sent again on a new one, as net/http decides: its
# method is idempotent and safe to replay, or it names an idempotency key.
fn request_replayable(req: ClientRequest) -> Bool:
    m := req.method
    if m == "GET" or m == "HEAD" or m == "OPTIONS" or m == "TRACE":
        return true
    return header_lookup(req.headers, "Idempotency-Key") != "" or header_lookup(req.headers, "X-Idempotency-Key") != ""

# where a client request goes. `key` names the idle connections it can use,
# and host:port is what is dialed: the origin, or a proxy. `absolute` sends
# the request-target in absolute form, as a plain request through a proxy
# needs (rfc 9112 3.2.2), and `tunnel` opens a CONNECT tunnel to the origin
# through the proxy before tls.
struct ClientRoute:
    key: String
    host: String
    port: Int
    absolute: Bool
    tunnel: Bool

# the host and port of a proxy url, "http://host:port" or "host:port". the
# port defaults to 80. a proxy that is not plain http is refused.
fn parse_proxy_address(proxy: String) -> (String, Int)!:
    mut text := proxy.trim()
    if text.index_of("://") < 0:
        text = "http://" + text
    parsed := url_mod.parse(text)
    if url_mod.scheme(parsed).to_lower() != "http":
        fail "http: unsupported proxy scheme: " + proxy
    host := url_mod.host(parsed)
    if host == "":
        fail "http: proxy url has no host: " + proxy
    mut port := url_mod.port(parsed)
    if port < 0:
        port = 80
    return (host, port)

# the first of two environment variables that is set and not empty.
fn env_either(upper: String, lower: String) -> String:
    value := env_opt(upper).unwrap_or("")
    if value != "":
        return value
    return env_opt(lower).unwrap_or("")

# the proxy the environment names for a request to host:port, or "" for
# none: HTTPS_PROXY for https and HTTP_PROXY for http, unless NO_PROXY
# excludes the host (see proxy_for).
fn proxy_from_env(use_tls: Bool, host: String, port: Int) -> String:
    mut proxy := env_either("HTTP_PROXY", "http_proxy")
    if use_tls:
        proxy = env_either("HTTPS_PROXY", "https_proxy")
    return proxy_for(proxy, env_either("NO_PROXY", "no_proxy"), host, port)

# whether `host` is localhost or a loopback address, which net/http never
# sends through a proxy from the environment.
fn is_loopback_host(host: String) -> Bool:
    name := host.to_lower()
    return name == "localhost" or name.ends_with(".localhost") or name.starts_with("127.") or name == "::1" or name == "[::1]"

# `proxy` for a request to host:port, or "" when the request goes direct, by
# net/http's rules for NO_PROXY: localhost and loopback addresses always go
# direct, and so does every host when NO_PROXY is "*". otherwise NO_PROXY is
# a comma-separated list of host names and addresses, each optionally with a
# port. "example.com" matches that host and its subdomains, ".example.com"
# only its subdomains, and an entry with a port matches only that port.
# cidr ranges are not supported.
fn proxy_for(proxy: String, no_proxy: String, host: String, port: Int) -> String:
    if proxy == "" or is_loopback_host(host):
        return ""
    name := host.to_lower()
    for raw in no_proxy.split(","):
        mut entry := raw.trim().to_lower()
        if entry == "":
            continue
        if entry == "*":
            return ""
        # a port follows a bracketed ipv6 address, or the one colon of a name
        mut entry_port := 0 - 1
        if entry.starts_with("["):
            close := entry.index_of("]")
            if close > 0:
                rest := entry.substring(close + 1, entry.len())
                if rest.starts_with(":"):
                    entry_port = parse_int(rest.substring(1, rest.len())) catch (0 - 1)
                entry = entry.substring(1, close)
        elif entry.index_of(":") >= 0 and entry.index_of(":") == entry.last_index_of(":"):
            colon := entry.index_of(":")
            entry_port = parse_int(entry.substring(colon + 1, entry.len())) catch (0 - 1)
            entry = entry.substring(0, colon)
        if entry_port >= 0 and entry_port != port:
            continue
        if entry.starts_with("."):
            if name.ends_with(entry):
                return ""
        elif name == entry or name.ends_with("." + entry):
            return ""
    return proxy

# ask the proxy on `stream` for a tunnel to the request's origin (rfc 9110
# 9.3.6) and read its answer. anything but a 2xx fails, with the status.
# the answer is read a byte at a time, so nothing past its head is taken off
# the stream before the tls handshake starts.
fn open_tunnel(stream: TcpStream, req: ClientRequest) -> Int!:
    authority := host_header_value(req.host, 0, false) + ":" + req.port.to_string()
    crlf := chr(13) + chr(10)
    stream.write_all_bytes(bytes.from_string_utf8("CONNECT " + strip_header_controls(authority) + " HTTP/1.1" + crlf + "Host: " + strip_header_controls(authority) + crlf + crlf))!
    mut head := bytes.empty()
    while io.head_end(head, 0) < 0:
        if head.len() > MAX_RESPONSE_HEADER_BYTES:
            fail RESPONSE_HEADER_LIMIT_MESSAGE
        b := stream.read_bytes(1)!
        if b.is_empty():
            fail NO_RESPONSE_MESSAGE
        head = head.concat(b)
    parsed := parse_response_head(head, "CONNECT")!
    if parsed.status < 200 or parsed.status >= 300:
        fail "http: proxy refused the tunnel with status {parsed.status}"
    return parsed.status

# the outcome of one exchange: the checked head, the body (empty when it was
# streamed to a writer), its trailers, the size of the body, whether the
# connection can carry another exchange, and whether the body was gzip
# decoded.
struct ClientResult:
    parsed: ResponseHead
    body: Bytes
    trailers: Map[String, String]
    body_size: Int
    reusable: Bool
    decoded: Bool

impl Client:
    fn with_timeout(ms: Int) -> Client:
        next := self.copy()
        next.timeout_ms = ms
        return next

    fn with_dial_timeout(ms: Int) -> Client:
        next := self.copy()
        next.dial_timeout_ms = ms
        return next

    fn with_response_header_timeout(ms: Int) -> Client:
        next := self.copy()
        next.response_header_timeout_ms = ms
        return next

    fn with_max_idle_conns_per_host(limit: Int) -> Client:
        next := self.copy()
        next.max_idle_conns_per_host = limit
        return next

    fn with_idle_conn_timeout(ms: Int) -> Client:
        next := self.copy()
        next.idle_conn_timeout_ms = ms
        return next

    fn with_max_redirects(limit: Int) -> Client:
        next := self.copy()
        next.max_redirects = limit
        return next

    fn with_keep_alives(enabled: Bool) -> Client:
        next := self.copy()
        next.keep_alives = enabled
        return next

    fn with_compression(enabled: Bool) -> Client:
        next := self.copy()
        next.compression = enabled
        return next

    fn with_expect_continue_timeout(ms: Int) -> Client:
        next := self.copy()
        next.expect_continue_timeout_ms = ms
        return next

    fn with_proxy(proxy: String) -> Client:
        next := self.copy()
        next.proxy_url = proxy
        return next

    fn with_env_proxy(enabled: Bool) -> Client:
        next := self.copy()
        next.env_proxy = enabled
        return next

    fn with_tls_config(config: tls.Config) -> Client:
        next := self.copy()
        next.tls_config = config
        return next

    # the same settings and the same idle connections.
    fn copy() -> Client:
        return Client(self.timeout_ms, self.dial_timeout_ms, self.response_header_timeout_ms, self.max_idle_conns_per_host, self.idle_conn_timeout_ms, self.max_redirects, self.keep_alives, self.compression, self.expect_continue_timeout_ms, self.proxy_url, self.env_proxy, self.tls_config, self.pool)

    # send `req` and read the whole response, following redirects.
    fn send(req: ClientRequest) -> HttpResponse!:
        if not trace.is_active():
            return self.send_untraced(req)
        span := start_http_client_span(req.method, req.host, req.path)
        traced := req.header("traceparent", trace.format_traceparent(span.context()))
        started := time_mod.mono_nanos()
        result := self.send_untraced(traced)
        if result.is_err:
            finish_http_client_span(span, req.method, -1, started)
        else:
            finish_http_client_span(span, req.method, result.ok.status, started)
        return result!

    # send `req` and stream the body of the final response into `writer`.
    fn send_into(req: ClientRequest, writer: BufferedBytesWriter) -> StreamedHttpResponse!:
        result := self.follow(req, writer, true)!
        return streamed_response_from_parsed(result.parsed, result.body_size)

    # send `req` and write the body of the final response to a file.
    fn send_to_file(req: ClientRequest, output_path: String) -> StreamedHttpResponse!:
        file := fs.create(output_path)!
        writer := output_file_writer(file)
        streamed := self.send_into(req, writer)!
        finish_output_file_writer(file, writer)!
        return streamed

    fn get(raw_url: String) -> HttpResponse!:
        return self.send(new_request("GET", raw_url)!)

    fn head(raw_url: String) -> HttpResponse!:
        return self.send(new_request("HEAD", raw_url)!)

    fn post(raw_url: String, content_type: String, body: Bytes) -> HttpResponse!:
        return self.send(new_request("POST", raw_url)!.body_bytes(body).header("Content-Type", content_type))

    # close every idle connection. connections in use are not touched.
    fn close_idle_connections():
        self.pool.mu.lock()
        idle := self.pool.idle
        self.pool.idle = {}
        self.pool.mu.unlock()
        for key in idle:
            for c in idle[key]:
                wire_close(c)

    # how many idle connections the client holds.
    fn idle_connections() -> Int:
        self.pool.mu.lock()
        mut total := 0
        for key in self.pool.idle:
            total = total + self.pool.idle[key].len()
        self.pool.mu.unlock()
        return total

    fn send_untraced(req: ClientRequest) -> HttpResponse!:
        result := self.follow(req, BufferedBytesWriter(0), false)!
        resp := response_from_parsed(result.parsed, result.body, result.trailers)
        if not result.decoded:
            return resp
        return HttpResponse(resp.status, resp.content_type, header_without(header_without(resp.headers, "Content-Encoding"), "Content-Length"), resp.body, resp.set_cookie_headers, resp.trailers)

    # send `req`, then each redirect it is answered with, up to max_redirects.
    # a redirect without a Location is the final response.
    fn follow(req: ClientRequest, writer: BufferedBytesWriter, streaming: Bool) -> ClientResult!:
        mut limit := self.timeout_ms
        if req.timeout_ms >= 0:
            limit = req.timeout_ms
        mut deadline := 0
        if limit > 0:
            deadline = time_mod.mono_millis() + limit
        mut current := req
        mut hops := 0
        while true:
            result := self.round_trip(current, writer, streaming, deadline)!
            status := result.parsed.status
            if self.max_redirects <= 0 or not redirect_status(status):
                return result
            resp := response_from_parsed(result.parsed, bytes.empty(), {})
            if resp.header_value("Location") == "":
                # exchange held the body back for the redirect, so it goes
                # to the writer now
                if streaming:
                    writer.write_all_bytes(result.body)!
                    writer.flush()!
                return result
            if hops >= self.max_redirects:
                fail "http: stopped after {self.max_redirects} redirects"
            current = redirect_request(current, resp)!
            hops = hops + 1
        fail "http: redirect loop ended"

    # one exchange for `req` on an idle connection to its origin, or a new
    # one. a request that fails on a reused connection before any of the
    # response arrives is sent once more on a new connection when it is
    # replayable (see request_replayable): the server may have closed the
    # connection just as the request went out.
    fn round_trip(req: ClientRequest, writer: BufferedBytesWriter, streaming: Bool, deadline: Int) -> ClientResult!:
        route := self.route_for(req)!
        mut retried := false
        while true:
            c := self.conn_for(req, route, deadline)!
            got := self.exchange(c, req, route, writer, streaming, deadline)
            if got.is_ok:
                if got.ok.reusable:
                    self.put_idle(c)
                else:
                    wire_close(c)
                return got.ok
            wire_close(c)
            if retried or not c.reused or got.err != NO_RESPONSE_MESSAGE or not request_replayable(req):
                fail got.err
            retried = true
        fail NO_RESPONSE_MESSAGE

    # where `req` goes: straight to its origin, or through the proxy that
    # proxy_url or the environment names.
    fn route_for(req: ClientRequest) -> ClientRoute!:
        mut proxy := self.proxy_url
        if proxy == "" and self.env_proxy:
            proxy = proxy_from_env(req.use_tls, req.host, req.port)
        if proxy == "":
            return ClientRoute(origin_key(req.use_tls, req.host, req.port), req.host, req.port, false, false)
        address := parse_proxy_address(proxy)!
        proxy_host := address.0
        proxy_port := address.1
        via := "proxy http://" + proxy_host.to_lower() + ":" + proxy_port.to_string()
        if req.use_tls:
            return ClientRoute(origin_key(true, req.host, req.port) + " via " + via, proxy_host, proxy_port, false, true)
        # every plain request through one proxy can share its connections
        return ClientRoute(via, proxy_host, proxy_port, true, false)

    # an idle connection for `route` that can carry a request, or a new one.
    fn conn_for(req: ClientRequest, route: ClientRoute, deadline: Int) -> WireConn!:
        key := route.key
        while true:
            self.pool.mu.lock()
            mut found := false
            mut c := WireConn(TcpStream(0), BufferedBytesReader(0), BufferedBytesWriter(0), tls.Conn(0), false, key, 0, false)
            if self.pool.idle.contains_key(key):
                list := self.pool.idle[key]
                n := list.len()
                if n > 0:
                    c = list[n - 1]
                    self.pool.idle[key] = list.slice(0, n - 1)
                    found = true
            self.pool.mu.unlock()
            if not found:
                return self.dial(req, route, deadline)
            if idle_conn_usable(c, self.idle_conn_timeout_ms):
                c.reused = true
                return c
            wire_close(c)
        fail "http: no connection"

    # dial a new connection for `route`, within dial_timeout_ms and the
    # request's deadline. the CONNECT and the tls handshake run within the
    # deadline too.
    fn dial(req: ClientRequest, route: ClientRoute, deadline: Int) -> WireConn!:
        key := route.key
        mut wait := self.dial_timeout_ms
        if deadline > 0:
            left := deadline - time_mod.mono_millis()
            if left <= 0:
                fail CLIENT_TIMEOUT_MESSAGE
            if wait <= 0 or left < wait:
                wait = left
        stream := dial_tcp(route.host, route.port, wait)
        if stream.is_err:
            fail client_timeout_failure(stream.err, deadline, 0)
        self.pool.mu.lock()
        self.pool.dialed = self.pool.dialed + 1
        self.pool.mu.unlock()
        if not req.use_tls:
            return plain_wire(stream.ok, key)
        arm_client_deadline(stream.ok.fd, deadline, true)
        arm_client_deadline(stream.ok.fd, deadline, false)
        if route.tunnel:
            opened := open_tunnel(stream.ok, req)
            if opened.is_err:
                stream.ok.close()
                fail client_timeout_failure(opened.err, deadline, 0)
        conn := self.handshake(stream.ok, req, key)
        if conn.is_err:
            fail client_timeout_failure(conn.err, deadline, 0)
        return conn.ok

    # run the tls handshake over a new connection, with tls_config or the
    # default config. the stream is closed when it fails.
    fn handshake(stream: TcpStream, req: ClientRequest, key: String) -> WireConn!:
        if self.tls_config.handle >= 0:
            return tls_wire(stream, req.host, self.tls_config, key)
        config := tls.client_config()
        if config.is_err:
            stream.close()
            fail config.err
        defer config.ok.close()
        return tls_wire(stream, req.host, config.ok, key)

    # keep `c` for another request, or close it when its origin already has
    # max_idle_conns_per_host idle connections.
    fn put_idle(c: WireConn):
        tcp_set_read_deadline(c.stream.fd, 0)
        tcp_set_write_deadline(c.stream.fd, 0)
        c.idle_since = time_mod.mono_millis()
        self.pool.mu.lock()
        mut list: List[WireConn] := []
        if self.pool.idle.contains_key(c.key):
            list = self.pool.idle[c.key]
        keep := list.len() < self.max_idle_conns_per_host
        if keep:
            list.push(c)
            self.pool.idle[c.key] = list
        self.pool.mu.unlock()
        if not keep:
            wire_close(c)

    # write `req` on `c` and read its response. the body is streamed into
    # `writer` when `streaming` is set, except a redirect's, which the caller
    # follows. a failure before any of the response arrived is
    # NO_RESPONSE_MESSAGE, and one because a time limit ran out is a timeout
    # message (see client_timeout_failure).
    #
    # the write gets the time left before `deadline`. the head gets that, or
    # response_header_timeout_ms from the end of the write when it is sooner,
    # and the body gets what is left before `deadline`.
    fn exchange(c: WireConn, req: ClientRequest, route: ClientRoute, writer: BufferedBytesWriter, streaming: Bool, deadline: Int) -> ClientResult!:
        fd := c.stream.fd
        mut connection := ""
        if not self.keep_alives:
            connection = "close"
        accept_gzip := self.compression and not streaming and req.method != "HEAD" and header_lookup(req.headers, "Range") == ""
        mut target := normalize_path(req.path)
        if route.absolute:
            target = "http://" + host_header_value(req.host, req.port, false) + target
        expect := self.expect_continue_timeout_ms > 0 and request_expects_continue(req) and not req.body.is_empty()
        mut wire := bytes.empty()
        if expect:
            wire = request_head_bytes(req, target, connection, accept_gzip)
        else:
            wire = request_wire_bytes(req, target, connection, accept_gzip)!
        arm_client_deadline(fd, deadline, false)
        client_write(c, wire, deadline)!
        src := wire_source(c)
        mut body_sent := true
        mut early := ResponseHead(bytes.empty(), 0, 1, HTTP_RESPONSE_BODY_NONE, 0, false)
        if expect:
            early = self.await_continue(src, req, deadline)!
            if early.status == 0:
                client_write(c, request_body_bytes(req), deadline)!
            else:
                body_sent = false
        mut parsed := early
        if body_sent:
            mut header_due := 0
            if self.response_header_timeout_ms > 0:
                header_due = time_mod.mono_millis() + self.response_header_timeout_ms
            arm_client_deadline(fd, earliest_due(deadline, header_due), true)
            arrived := source_wait_bytes(src)
            if arrived.is_err or arrived.ok <= 0:
                fail client_timeout_failure(NO_RESPONSE_MESSAGE, deadline, header_due)
            head := read_response_head_from(src, req.method)
            if head.is_err:
                fail client_timeout_failure(head.err, deadline, header_due)
            parsed = head.ok
        arm_client_deadline(fd, deadline, true)
        trailers: Map[String, String] := {}
        mut body := bytes.empty()
        mut body_size := 0
        mut decoded := false
        if streaming and not (self.max_redirects > 0 and redirect_status(parsed.status)):
            streamed := stream_response_body_from(src, parsed, writer, trailers)
            if streamed.is_err:
                fail client_timeout_failure(streamed.err, deadline, 0)
            body_size = streamed.ok
        else:
            got := read_response_body_from(src, parsed, trailers)
            if got.is_err:
                fail client_timeout_failure(got.err, deadline, 0)
            body = got.ok
            if accept_gzip and not body.is_empty() and response_content_encoding(parsed.head) == "gzip":
                unzipped := gzip.decompress(body)
                if unzipped.is_err:
                    fail "http: gzip response body: " + unzipped.err
                body = unzipped.ok
                decoded = true
            body_size = body.len()
        # a request whose body was never sent leaves the server expecting it,
        # so the connection is not used again
        reusable := body_sent and self.keep_alives and not parsed.wants_close and parsed.status != 101 and not request_prefers_close_header(req)
        return ClientResult(parsed, body, trailers, body_size, reusable, decoded)

    # wait for the server's answer to Expect: 100-continue, up to
    # expect_continue_timeout_ms and the request's deadline. a head with
    # status 0 means the body should be sent: a 100 Continue arrived, or the
    # wait ran out. any other head is the final response, which arrived before
    # the body was sent. other interim responses are read and dropped.
    fn await_continue(src: ByteSource, req: ClientRequest, deadline: Int) -> ResponseHead!:
        send_body := ResponseHead(bytes.empty(), 0, 1, HTTP_RESPONSE_BODY_NONE, 0, false)
        due := earliest_due(deadline, time_mod.mono_millis() + self.expect_continue_timeout_ms)
        arm_client_deadline(src.socket, due, true)
        arrived := source_wait_bytes(src)
        if arrived.is_err:
            if deadline_passed(deadline):
                fail CLIENT_TIMEOUT_MESSAGE
            if deadline_passed(due):
                return send_body
            fail NO_RESPONSE_MESSAGE
        if arrived.ok <= 0:
            fail NO_RESPONSE_MESSAGE
        arm_client_deadline(src.socket, deadline, true)
        while true:
            raw := read_request_head(src, MAX_RESPONSE_HEADER_BYTES)
            if raw.is_err:
                fail client_timeout_failure(response_failure(raw.err), deadline, 0)
            if raw.ok.is_empty():
                fail NO_RESPONSE_MESSAGE
            parsed := parse_response_head(raw.ok, req.method)!
            if parsed.status == 100:
                return send_body
            if parsed.status >= 200 or parsed.status == 101:
                return parsed
        return send_body

# write `data` on a client connection. a failure is the client timeout when
# `deadline` has passed, and NO_RESPONSE_MESSAGE otherwise: nothing of the
# response can have arrived while the request was still going out.
fn client_write(c: WireConn, data: Bytes, deadline: Int) -> Int!:
    if data.is_empty():
        return 0
    written := wire_write(c, data)
    if written.is_err:
        if deadline_passed(deadline):
            fail CLIENT_TIMEOUT_MESSAGE
        fail NO_RESPONSE_MESSAGE
    return written.ok

# whether `due`, a time on the mono_millis clock, has come. 0 never does. the
# runtime never fails a read before its deadline, so a read that failed on one
# finds the clock at or past it; the extra millisecond only absorbs rounding.
fn deadline_passed(due: Int) -> Bool:
    return due > 0 and time_mod.mono_millis() + 1 >= due

# the sooner of two due times, where 0 is none.
fn earliest_due(a: Int, b: Int) -> Int:
    if a <= 0:
        return b
    if b <= 0 or a < b:
        return a
    return b

# set the read (or write) deadline of `fd` to `due` on the mono_millis clock,
# or clear it when `due` is 0. a due time already past still waits 1 ms, since
# 0 would mean no deadline at all.
fn arm_client_deadline(fd: Int, due: Int, read: Bool):
    mut ms := 0
    if due > 0:
        ms = due - time_mod.mono_millis()
        if ms < 1:
            ms = 1
    if read:
        tcp_set_read_deadline(fd, ms)
    else:
        tcp_set_write_deadline(fd, ms)

# the failure to report for `err`: the header timeout when `header_due` came
# first and has passed, the client timeout when `deadline` has, else `err`.
fn client_timeout_failure(err: String, deadline: Int, header_due: Int) -> String:
    header_first := deadline <= 0 or (header_due > 0 and header_due < deadline)
    if header_first and deadline_passed(header_due):
        return HEADER_TIMEOUT_MESSAGE
    if deadline_passed(deadline):
        return CLIENT_TIMEOUT_MESSAGE
    return err

# the half of a dial with a timeout that runs as a task of its own: connect,
# then hand the handle over, or close it when the dial was given up on.
fn dial_worker(host: String, port: Int, out: Channel[Int]) -> Int:
    fd := tcp_connect(host, port) catch 0
    if not out.send(fd) and fd > 0:
        tcp_close(fd)
    return 0

# connect to host:port, giving up after `timeout_ms` when it is above 0. the
# runtime's connect takes no deadline, so the connect runs as a task of its
# own and this waits for it with a timeout. a connect that completes after
# the wait gave up is closed by its task: the channel is closed first, so
# either the task's send fails and it closes the handle, or the handle is
# already queued and is taken back here.
fn dial_tcp(host: String, port: Int, timeout_ms: Int) -> TcpStream!:
    if timeout_ms <= 0:
        return io.connect(host, port)
    out := Channel[Int](1)
    spawn dial_worker(host, port, out)
    picked := select:
        value := out.recv() => (1, value)
        timeout timeout_ms => (0, none)
    if picked.0 == 0:
        out.close()
        late := out.try_recv()
        if late != none:
            if late? > 0:
                tcp_close(late?)
        fail "http: dial tcp {host}:{port}: timed out after {timeout_ms} ms"
    mut fd := 0
    if picked.1 != none:
        fd = picked.1?
    if fd <= 0:
        fail "http: dial tcp {host}:{port}: connection failed"
    return io.from_fd(fd)

# whether a client request names Expect: 100-continue.
fn request_expects_continue(req: ClientRequest) -> Bool:
    return header_lookup(req.headers, "Expect").trim().to_lower() == "100-continue"

# the Content-Encoding a response head names, lowercased.
fn response_content_encoding(head: Bytes) -> String:
    return (decode_utf8(header_value_bytes(head, "Content-Encoding")) catch "").trim().to_lower()

# whether a client request's own Connection field asks to close.
fn request_prefers_close_header(req: ClientRequest) -> Bool:
    value := bytes.from_string_utf8(header_lookup(req.headers, "Connection"))
    return list_has_token(value, 0, value.len(), "close")

# extracts one route parameter from a matched path pattern.
pub fn route_param(req: HttpRequestBytes, pattern: String, name: String) -> String!:
    return req.path_param(pattern, name)

# alias for match_route() that reads a little closer to handler code.
pub fn is_route(req: HttpRequestBytes, method_name: String, pattern: String) -> Bool!:
    return match_route(req, method_name, pattern)

# checks whether a request matches a method and route pattern.
pub fn match_route(req: HttpRequestBytes, method_name: String, pattern: String) -> Bool!:
    return req.method()! == method_name and req.matches_path(pattern)!

# checks whether a request matches a get route.
pub fn get_route(req: HttpRequestBytes, pattern: String) -> Bool!:
    return match_route(req, "GET", pattern)

# checks whether a request matches a post route.
pub fn post_route(req: HttpRequestBytes, pattern: String) -> Bool!:
    return match_route(req, "POST", pattern)

# checks whether a request matches a put route.
pub fn put_route(req: HttpRequestBytes, pattern: String) -> Bool!:
    return match_route(req, "PUT", pattern)

# checks whether a request matches a delete route.
pub fn delete_route(req: HttpRequestBytes, pattern: String) -> Bool!:
    return match_route(req, "DELETE", pattern)

# checks whether a request matches a patch route.
pub fn patch_route(req: HttpRequestBytes, pattern: String) -> Bool!:
    return match_route(req, "PATCH", pattern)

fn instrumented_logger(base: log.Logger, req: HttpRequestBytes) -> log.Logger:
    child := base.target("http").child_span() catch base.target("http")
    return child.with([log.str("method", req.method_text), log.str("path", req.path_text)])

fn instrumentation_metric_name(prefix: String, suffix: String) -> String:
    return prefix + "_" + suffix

fn instrument_request(handler: fn(HttpRequestBytes) -> HttpResponse, logger: log.Logger, metric_prefix: String, req: HttpRequestBytes) -> HttpResponse:
    started := time_mod.now()
    metrics.counter(instrumentation_metric_name(metric_prefix, "requests_total")).inc()
    inflight := metrics.gauge(instrumentation_metric_name(metric_prefix, "in_flight"))
    inflight.add(1.0)

    resp := handler(req)

    inflight.add(0.0 - 1.0)
    elapsed := time_mod.now() - started
    metrics.counter(instrumentation_metric_name(metric_prefix, "responses_total_" + resp.status.to_string())).inc()
    metrics.histogram(instrumentation_metric_name(metric_prefix, "request_duration_ms")).observe(elapsed.to_float())
    instrumented_logger(logger, req).info().int("status", resp.status).duration_ms("elapsed_ms", elapsed).msg("request complete")
    return resp

# wraps a handler with request logging and in-memory metrics.
pub fn instrument(handler: fn(HttpRequestBytes) -> HttpResponse, logger: log.Logger, metric_prefix: String) -> fn(HttpRequestBytes) -> HttpResponse:
    return fn(req: HttpRequestBytes) => instrument_request(handler, logger, metric_prefix, req)

# wraps a handler with middleware and returns another handler.
pub fn wrap(handler: fn(HttpRequestBytes) -> HttpResponse, middleware: fn(fn(HttpRequestBytes) -> HttpResponse, HttpRequestBytes) -> HttpResponse) -> fn(HttpRequestBytes) -> HttpResponse:
    return fn(req: HttpRequestBytes) => middleware(handler, req)

# runs a handler with the json node pool scoped to this one request.
#
# json.parse() hands out handles into a per-task node pool that nothing frees
# on its own, so on a keep-alive connection every request a handler parses used
# to stay resident for the life of the connection. the scope closes as soon as
# the handler returns, which is safe because an HttpResponse carries bytes and
# strings — nothing that still points into the pool. a handler that stashes a
# handle somewhere and reads it on a later request will find it invalid, which
# was never a supported thing to do.
fn run_handler(handler: fn(HttpRequestBytes) -> HttpResponse, req: HttpRequestBytes) -> HttpResponse:
    scope := json_mod.open_scope()
    defer json_mod.close_scope(scope)
    return handler(req)

# the outcome of serving one request: the bytes written, whether the
# connection stays open for another, and the read failure that ended the
# exchange, or an empty string.
struct Exchange:
    written: Int
    keep_open: Bool
    error: String

# write the server's answer to `req` and return the bytes written. `connection`
# is the Connection value to send, and HEAD gets the head alone.
fn write_server_response(src: ByteSource, writer: BufferedBytesWriter, req: HttpRequestBytes, resp: HttpResponse, connection: String) -> Int!:
    return source_write(src, writer, server_response_bytes(resp, connection, req.method_text == "HEAD")!)

# wait for the next request on `conn` to start and arm its head deadline.
# returns when the head falls due on the mono_millis clock (0 for no
# deadline), or -1 when the connection should close without an answer: the
# peer closed, or the wait ran out with nothing sent.
#
# the first request's head is due read_header_timeout_ms after the connection
# was served, the wait for its first byte included. a later request first
# waits up to idle_timeout_ms for a byte, then gets read_header_timeout_ms from
# that byte, so a client that sends a byte at a time still runs out of time,
# and one that only sits idle is closed quietly, as net/http does.
fn await_request(conn: ServerConn, served: Int) -> Int:
    config := conn.config
    mut due := 0
    if served == 0:
        if config.header_timeout() > 0:
            due = conn.opened_ms + config.header_timeout()
            arm_read_deadline_at(conn.src, due)
    else:
        arm_read_deadline(conn.src, config.idle_timeout())
    arrived := source_wait_bytes(conn.src) catch 0
    if arrived <= 0:
        return -1
    if served > 0:
        due = arm_read_deadline(conn.src, config.header_timeout())
    return due

# serve one request on `conn`, answering through its writer or tls conn.
# `served` is how many requests the connection has answered before this one.
# a request the server refuses is answered with its status, and the
# connection closes. `persistent` is false for the entry points that serve
# one request: they send the Connection value the handler set, or close.
fn serve_exchange(conn: ServerConn, served: Int, persistent: Bool) -> Exchange!:
    config := conn.config
    src := conn.src
    timed := config.times_reads()
    mut head_due := 0
    mut body_due := 0
    if timed:
        head_due = await_request(conn, served)
        if head_due < 0:
            return Exchange(0, false, "")
        if config.read_timeout_ms > 0:
            # read_timeout_ms counts from where the head's time started
            mut start := time_mod.mono_millis()
            if served == 0:
                start = conn.opened_ms
            body_due = start + config.read_timeout_ms
    got := read_server_request(conn, body_due, timed)
    if got.is_err:
        # a refused request gets its status (see request_error_status). a
        # read that ran out of time gets 408, since its first byte is in by
        # now. any other read failure, a dropped socket or eof inside a
        # request, ends the connection without an answer. either way reading
        # stops, so nothing desyncs.
        mut status := request_error_status(got.err)
        if status == 0 and timed and read_ran_out(head_due, body_due):
            status = 408
        return Exchange(send_request_error(src, conn.writer, status, config.write_timeout_ms)!, false, got.err)
    req := got.ok.req
    if req.head.is_empty() and req.method_text == "":
        return Exchange(0, false, "")
    resp := run_handler(conn.handler, req)
    mut connection := ""
    if persistent:
        last := not config.keep_alives or (config.max_requests_per_conn > 0 and served + 1 >= config.max_requests_per_conn)
        connection = connection_value(got.ok.wants_close or last, req.version_text == "HTTP/1.0", resp)
    else:
        connection = standalone_connection(resp, "")
    written := write_server_response(src, conn.writer, req, resp, connection)!
    return Exchange(written, persistent and connection != "close", "")

# whether a read deadline that was armed has passed: the head's, or the
# body's when there is one. the runtime never gives up before a deadline (see
# arm_read_deadline), so a read that failed on one finds the clock at or past
# it; the extra millisecond only absorbs rounding.
fn read_ran_out(head_due: Int, body_due: Int) -> Bool:
    now := time_mod.mono_millis() + 1
    return (head_due > 0 and now >= head_due) or (body_due > 0 and now >= body_due)

# serve requests on `conn` until either side asks to close.
fn serve_requests(conn: ServerConn) -> Int!:
    mut total := 0
    mut served := 0
    while true:
        exchange := serve_exchange(conn, served, true)!
        total = total + exchange.written
        served = served + 1
        if not exchange.keep_open:
            return total
    return total

# serve a single request and fail with the read failure, if there was one.
fn serve_single(conn: ServerConn) -> Int!:
    exchange := serve_exchange(conn, 0, false)!
    if exchange.error != "":
        fail exchange.error
    return exchange.written

# serves one request using a bytes reader, writer, and handler. a request the
# server refuses is answered with its status before the failure is returned.
pub fn serve_one(reader: BufferedBytesReader, writer: BufferedBytesWriter, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_single(server_conn(buffered_source(reader), writer, handler, server_config()))

# serves requests on one connection until either side asks to close.
pub fn serve_connection(reader: BufferedBytesReader, writer: BufferedBytesWriter, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_connection_with(reader, writer, handler, server_config())

# serve_connection with a ServerConfig. the reader has no socket under it, so
# the config's timeouts do nothing here; its limits, keep_alives and
# max_requests_per_conn apply.
pub fn serve_connection_with(reader: BufferedBytesReader, writer: BufferedBytesWriter, handler: fn(HttpRequestBytes) -> HttpResponse, config: ServerConfig) -> Int!:
    return serve_requests(server_conn(buffered_source(reader), writer, handler, config))

# serves one request from a client fd and closes the connection after writing the response.
pub fn serve_fd(fd: Int, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    stream := io.from_fd(fd)
    reader := stream.buffered_bytes_reader_chunked(512)
    writer := stream.buffered_bytes_writer()
    # last-in-first-out: the registry entries go before the fd closes
    defer tcp_close(fd)
    defer writer.free()
    defer reader.free()
    return serve_single(server_conn(ByteSource(reader, tls.Conn(0), false, fd), writer, handler, server_config()))

# serves requests from one client fd until the connection closes.
pub fn serve_connection_fd(fd: Int, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_connection_fd_with(fd, handler, server_config())

# serve_connection_fd with a ServerConfig: its timeouts are deadlines on the
# socket, so they hold however the client spaces its bytes.
pub fn serve_connection_fd_with(fd: Int, handler: fn(HttpRequestBytes) -> HttpResponse, config: ServerConfig) -> Int!:
    stream := io.from_fd(fd)
    reader := stream.buffered_bytes_reader_chunked(512)
    writer := stream.buffered_bytes_writer()
    written := serve_requests(server_conn(ByteSource(reader, tls.Conn(0), false, fd), writer, handler, config)) catch 0
    # the registry entries die with the connection, not the process
    reader.free()
    writer.free()
    tcp_close(fd)
    return written

# serve http/1.1 requests over an already-handshaken tls conn until either side
# closes. this is the http/1.1 fallback for a tls listener that offers alpn "h2"
# and "http/1.1": a peer that negotiated "http/1.1" (or sent no alpn) is served
# here over the same tls session, by the same loop as serve_connection, reading
# and writing through the tls conn's own byte i/o. the caller closes the conn.
pub fn serve_connection_tls(conn: tls.Conn, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_connection_tls_with(conn, handler, server_config())

# serve_connection_tls with a ServerConfig. the deadlines go on the tcp
# connection under the session, so they bound the tls reads and writes too.
pub fn serve_connection_tls_with(conn: tls.Conn, handler: fn(HttpRequestBytes) -> HttpResponse, config: ServerConfig) -> Int!:
    src := ByteSource(BufferedBytesReader(0), conn, true, conn.socket())
    return serve_requests(server_conn(src, BufferedBytesWriter(0), handler, config))

# accepts one client from a listener fd and serves exactly one request.
pub fn serve_listener_once(listener_fd: Int, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_fd(tcp_accept(listener_fd)!, handler)

# accepts one client from a listener fd and serves that whole connection.
pub fn serve_listener_connection(listener_fd: Int, handler: fn(HttpRequestBytes) -> HttpResponse) -> Int!:
    return serve_connection_fd(tcp_accept(listener_fd)!, handler)

# serves one request like serve_one(), but respects cancellation and deadlines.
pub fn serve_one_ctx(reader: BufferedBytesReader, writer: BufferedBytesWriter, handler: fn(HttpRequestBytes) -> HttpResponse, ctx: Context) -> Int!BlockingError:
    if ctx.is_cancelled():
        fail ctx_blocking_error(ctx)
    conn := server_conn(buffered_source(reader), writer, handler, server_config())
    got := read_server_request(conn, 0, false)
    if got.is_err:
        send_request_error(conn.src, writer, request_error_status(got.err), 0) catch 0
        fail blocking_failed(got.err)
    req := got.ok.req
    if req.head.is_empty() and req.method_text == "":
        return 0
    if ctx.is_cancelled():
        fail ctx_blocking_error(ctx)
    resp := run_handler(handler, req)
    if ctx.is_cancelled():
        fail ctx_blocking_error(ctx)
    sent := write_server_response(conn.src, writer, req, resp, standalone_connection(resp, ""))
    if sent.is_err:
        fail blocking_failed(sent.err)
    return sent.ok

# issues a simple get request and returns the response body bytes.
pub fn get_bytes(host: String, port: Int, url_path: String) -> Bytes!:
    return request("GET", host, port, url_path).send_bytes()

# issues a simple get request and returns the response body text.
pub fn get(host: String, port: Int, url_path: String) -> String!:
    return request("GET", host, port, url_path).send()!.body_text()

# issues a simple https get request and returns the response body bytes.
pub fn get_https_bytes(host: String, url_path: String) -> Bytes!:
    return get_https_request(host, url_path).send_tls_bytes()

# issues a simple https get request and returns the response body text.
pub fn get_https(host: String, url_path: String) -> String!:
    return get_https_request(host, url_path).send_tls()!.body_text()

# issues a simple post request with a json body.
pub fn post_json(host: String, port: Int, url_path: String, handle: Int) -> HttpResponse!:
    return post_request(host, port, url_path).json_body(handle).send()

# issues a simple post request with a text body.
pub fn post_text(host: String, port: Int, url_path: String, text: String) -> HttpResponse!:
    return post_request(host, port, url_path).text_body(text).send()

test "http parses packed requests":
    crlf := chr(13) + chr(10)
    raw := "POST /items/42?draft=1 HTTP/1.1" + crlf + "Host: example.test" + crlf + "Content-Length: 5" + crlf + crlf + "hello"
    req := parse_request(raw)

    assert_eq(method(req), "POST")
    assert_eq(path(req), "/items/42")
    assert_eq(query(req), "draft=1")
    assert_eq(version(req), "HTTP/1.1")
    assert_eq(get_header(req, "host"), "example.test")
    assert_eq(get_query_param(req, "draft"), "1")
    assert_eq(body(req), "hello")

test "http parses bytes requests and route helpers":
    crlf := chr(13) + chr(10)
    raw := "GET /users/7?tab=profile HTTP/1.1" + crlf + "Host: example.test" + crlf + crlf
    reader := bytes.from_string_utf8(raw)
    req := read_request_buffered_bytes(io.bytes_reader(reader).buffered_chunked(4))!

    assert_eq(req.method()!, "GET")
    assert_eq(req.path()!, "/users/7")
    assert_eq(req.header("host")!, "example.test")
    assert_eq(req.query_param("tab")!, "profile")
    assert(get_route(req, "/users/:id")!)
    assert_eq(route_param(req, "/users/:id", "id")!, "7")

test "http builds and parses responses":
    resp := text(201, "created").header("X-Test", "yes")
    payload := resp.to_string()!
    parsed := parse_response(payload)!

    assert(payload.contains("HTTP/1.1 201 Created"))
    assert(payload.contains("Content-Type: text/plain"))
    assert(payload.contains("X-Test: yes"))
    assert(payload.contains("Content-Length: 7"))
    assert_eq(parsed.status_code(), 201)
    assert(parsed.is_success())
    assert_eq(parsed.header_value("content-type"), "text/plain")
    assert_eq(parsed.body_text()!, "created")

test "http strips control characters from outbound request headers":
    # a client that reflects untrusted input into a request header (a bearer
    # token, a cookie, a custom header) must not be able to inject a second
    # header or splice a second request into the outbound stream.
    crlf := chr(13) + chr(10)
    req := get_request("example.test", 80, "/").header("X-Echo", "value" + crlf + "Injected: evil")
    wire := req.to_bytes()!.to_string_utf8()!
    assert(not wire.contains(crlf + "Injected:"))
    assert(wire.contains("X-Echo: valueInjected: evil"))

test "http strips control characters from response headers":
    # a handler that reflects untrusted input into a header value must not be
    # able to inject a second header or split the response with CR/LF.
    crlf := chr(13) + chr(10)
    resp := text(200, "ok").header("X-Echo", "value" + crlf + "Injected: evil")
    payload := resp.to_string()!
    # no injected header line survives; the value collapses onto one line
    assert(not payload.contains(crlf + "Injected:"))
    assert(payload.contains("X-Echo: valueInjected: evil"))

test "http rejects a request that smuggles both transfer-encoding and content-length":
    crlf := chr(13) + chr(10)
    raw := "POST / HTTP/1.1" + crlf + "Host: x" + crlf + "Content-Length: 6" + crlf + "Transfer-Encoding: chunked" + crlf + crlf + "0" + crlf + crlf
    result := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(8))
    assert(result.is_err)

test "http frames the request body by the chunked transfer-encoding token, not a substring":
    crlf := chr(13) + chr(10)
    # a substring match on "chunked" would frame `xchunked` as a chunked body;
    # it must be treated as an unframable encoding and rejected, not read as CL.
    head := bytes.from_string_utf8("POST / HTTP/1.1" + crlf + "Host: x" + crlf + "Transfer-Encoding: xchunked" + crlf + crlf)
    refused := parse_request_head(head, true)
    assert(refused.is_err)
    assert_eq(request_error_status(refused.err), 400)
    # a genuine `chunked`, in any case, is chunked
    good := bytes.from_string_utf8("POST / HTTP/1.1" + crlf + "Host: x" + crlf + "Transfer-Encoding: Chunked" + crlf + crlf)
    assert(parse_request_head(good, true)!.chunked)
    # chunked after a coding this server cannot decode is not implemented
    gzip := bytes.from_string_utf8("POST / HTTP/1.1" + crlf + "Host: x" + crlf + "Transfer-Encoding: gzip, chunked" + crlf + crlf)
    assert_eq(request_error_status(parse_request_head(gzip, true).err), 501)
    # a plain length-delimited request is not chunked and does not fail
    plain := bytes.from_string_utf8("POST / HTTP/1.1" + crlf + "Host: x" + crlf + "Content-Length: 3" + crlf + crlf)
    parsed := parse_request_head(plain, true)!
    assert(not parsed.chunked)
    assert_eq(parsed.content_length, 3)

test "http accepts zero content length":
    crlf := chr(13) + chr(10)
    raw := "GET / HTTP/1.1" + crlf + "Host: example.test" + crlf + "Content-Length: 0" + crlf + crlf
    req := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4))!

    assert_eq(req.method()!, "GET")
    assert_eq(req.body_bytes().len(), 0)

test "http streams request bodies into writers":
    crlf := chr(13) + chr(10)
    raw := "POST /upload?draft=1 HTTP/1.1" + crlf + "Host: example.test" + crlf + "Content-Length: 11" + crlf + crlf + "hello world"
    output := bytes.buffer()

    streamed := read_request_buffered_bytes_into(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4), output.buffered_chunked(5))!

    assert_eq(streamed.method()!, "POST")
    assert_eq(streamed.path()!, "/upload")
    assert_eq(streamed.query_param("draft")!, "1")
    assert_eq(streamed.body_size, 11)
    assert_eq(output.bytes().to_string_utf8()!, "hello world")

test "http decodes chunked request and response bodies":
    crlf := chr(13) + chr(10)
    raw_req := "POST /chunked HTTP/1.1" + crlf + "Host: example.test" + crlf + "Transfer-Encoding: chunked" + crlf + crlf + "4" + crlf + "wiki" + crlf + "5" + crlf + "pedia" + crlf + "0" + crlf + crlf
    req := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw_req)).buffered_chunked(4))!
    assert_eq(req.body_text()!, "wikipedia")

    raw_resp := "HTTP/1.1 200 OK" + crlf + "Transfer-Encoding: chunked" + crlf + crlf + "4" + crlf + "pong" + crlf + "0" + crlf + crlf
    resp := parse_response(raw_resp)!
    assert_eq(resp.body_text()!, "pong")

test "read_chunked_body rejects an oversized chunk size before allocating":
    crlf := chr(13) + chr(10)
    # a tiny request body whose chunk-size line claims ~2 GiB. with a limit the guard
    # must reject it on the declared size, before read_exact_bytes pre-allocates.
    raw := "7fffffff" + crlf + "AAAA" + crlf + "0" + crlf + crlf
    reader := io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(8)
    result := read_chunked_body(reader, MAX_REQUEST_BODY)
    assert(result.is_err)
    assert_eq(result.err, BODY_LIMIT_MESSAGE)

test "http rejects a request head that exceeds the size limit":
    crlf := chr(13) + chr(10)
    # a single header value long enough to push the head past MAX_HEADER_BYTES.
    mut big := "x"
    while big.len() < MAX_HEADER_BYTES + 16:
        big = big + big
    raw := "GET / HTTP/1.1" + crlf + "X-Big: " + big + crlf + crlf
    result := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(64))
    assert(result.is_err)
    assert_eq(result.err, HEADER_LIMIT_MESSAGE)

test "http string path rejects a single head line that exceeds the size limit":
    # no CRLF ever arrives, so a per-line bound has to fire — a head-total check
    # alone would let the pending line grow without limit before it ran.
    mut big := "x"
    while big.len() < MAX_HEADER_BYTES + 16:
        big = big + big
    result := read_request_buffered(io.string_reader("GET " + big).buffered_chunked(64))
    assert(result.is_err)
    assert_eq(result.err, HEADER_LIMIT_MESSAGE)

test "http rejects an over-large content-length before allocating for it":
    crlf := chr(13) + chr(10)
    # the body never arrives; the declared length alone must be refused, so a
    # hostile "Content-Length: 10000000000" cannot force a giant allocation.
    raw := "POST / HTTP/1.1" + crlf + "Host: example.test" + crlf + "Content-Length: 10000000000" + crlf + crlf
    result := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(64))
    assert(result.is_err)
    assert_eq(result.err, BODY_LIMIT_MESSAGE)

test "http maps size-limit failures to 431 and 413 responses that close the connection":
    header_response := request_error_response(431)
    assert_eq(header_response.status_code(), 431)
    assert_eq(header_response.header_value("Connection").to_lower(), "close")
    body_response := request_error_response(413)
    assert_eq(body_response.status_code(), 413)
    assert_eq(body_response.header_value("Connection").to_lower(), "close")

test "http streams chunked request bodies into writers":
    crlf := chr(13) + chr(10)
    raw := "POST /chunked HTTP/1.1" + crlf + "Host: example.test" + crlf + "Transfer-Encoding: chunked" + crlf + crlf + "6" + crlf + "hello " + crlf + "5" + crlf + "world" + crlf + "0" + crlf + crlf
    output := bytes.buffer()

    streamed := read_request_buffered_bytes_into(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4), output.buffered_chunked(5))!

    assert_eq(streamed.path()!, "/chunked")
    assert_eq(streamed.body_size, 11)
    assert_eq(output.bytes().to_string_utf8()!, "hello world")

test "http cookies work across request and response helpers":
    req_bytes := get_request("example.test", 80, "/").cookie("session", "abc123").cookie("theme", "dark").to_bytes()!
    req := read_request_buffered_bytes(io.bytes_reader(req_bytes).buffered_chunked(4))!
    assert(req.has_cookie("session")!)
    assert_eq(req.cookie("session")!, "abc123")
    assert_eq(req.cookie_or("missing", "fallback"), "fallback")
    parsed_cookies := req.cookies()!
    assert_eq(parsed_cookies["theme"], "dark")

    resp := text(200, "ok").set_cookie(cookie("session", "abc123").path("/").http_only()).set_cookie(cookie("theme", "dark").same_site("Lax")).clear_cookie("flash")
    payload := resp.to_string()!
    parsed := parse_response(payload)!
    assert(payload.contains("Set-Cookie: session=abc123; Path=/; HttpOnly"))
    assert(payload.contains("Set-Cookie: theme=dark; SameSite=Lax"))
    assert(payload.contains("Set-Cookie: flash=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0"))
    assert_eq(parsed.cookies().len().to_string(), "3")

test "http client request builder renders headers and bodies":
    payload := post_request("example.test", 80, "/submit").query_param("q", "pith lang").body_text("hi").to_bytes()!.to_string_utf8()!

    assert(payload.starts_with("POST /submit?q=pith%20lang HTTP/1.1"))
    assert(payload.contains("Host: example.test"))
    assert(payload.contains("Connection: close"))
    assert(payload.contains("Content-Length: 2"))
    assert(payload.ends_with(chr(13) + chr(10) + chr(13) + chr(10) + "hi"))

test "http client requests carry transport options":
    req := https_request("GET", "example.test", "/").with_timeout(1500).follow_redirects(4)
    assert(req.use_tls)
    assert_eq(req.timeout_ms, 1500)
    assert_eq(req.redirect_limit, 4)
    assert_eq(req.no_redirects().redirect_limit, 0)

test "http redirect helper rewrites requests safely":
    req := post_request("example.test", 80, "/submit").header("Authorization", "Bearer x").cookie("session", "abc").json_body(json_mod.make_object()).follow_redirects(2)
    same_origin := redirect_request(req, response(302).header("Location", "/next"))!
    assert_eq(same_origin.method, "GET")
    assert_eq(same_origin.path, "/next")
    assert_eq(same_origin.body.len(), 0)
    assert_eq(header_lookup(same_origin.headers, "Authorization"), "Bearer x")
    assert_eq(header_lookup(same_origin.headers, "Cookie"), "session=abc")

    cross_origin := redirect_request(req, response(307).header("Location", "https://api.example.test/v2/items?draft=1"))!
    assert_eq(cross_origin.method, "POST")
    assert(cross_origin.use_tls)
    assert_eq(cross_origin.host, "api.example.test")
    assert_eq(cross_origin.port, 443)
    assert_eq(cross_origin.path, "/v2/items?draft=1")
    assert_eq(header_lookup(cross_origin.headers, "Authorization"), "")
    assert_eq(header_lookup(cross_origin.headers, "Cookie"), "")

fn echo_path(req: HttpRequestBytes) -> HttpResponse:
    return text(200, req.path_text)

test "http serves keep-alive connections":
    first := get_request("example.test", 80, "/one").keep_alive().to_bytes()!
    second := get_request("example.test", 80, "/two").close_connection().to_bytes()!
    input := bytes.buffer()
    input.write(first)!
    input.write(second)!
    output := bytes.buffer()
    reader := io.bytes_reader(input.bytes()).buffered_chunked(5)
    writer := output.buffered_chunked(6)

    written := serve_connection(reader, writer, echo_path)!
    payload := output.bytes().to_string_utf8()!

    assert_eq(written, output.bytes().len())
    # http/1.1 is persistent by default, so the first answer names nothing and
    # the second, to a request that asked to close, says so.
    assert(not payload.contains("Connection: keep-alive"))
    assert(payload.contains("Connection: close"))
    assert(payload.contains(chr(13) + chr(10) + chr(13) + chr(10) + "/one"))
    assert(payload.contains(chr(13) + chr(10) + chr(13) + chr(10) + "/two"))

test "http keep-alive serialization writes Connection without rebuilding the response":
    crlf := chr(13) + chr(10)
    # to_bytes_conn writes the disposition into the head directly, exactly once.
    ka := text(200, "hi").to_bytes_conn("keep-alive")!.to_string_utf8()!
    assert(ka.contains("Connection: keep-alive"))
    assert(not ka.contains("Connection: close"))
    cl := text(200, "hi").to_bytes_conn("close")!.to_string_utf8()!
    assert(cl.contains("Connection: close"))
    # a response that already carries a Connection header does not get a
    # duplicate: the caller's value is authoritative and the map's is dropped.
    forced := text(200, "hi").keep_alive().to_bytes_conn("close")!.to_string_utf8()!
    assert(forced.contains("Connection: close"))
    assert(not forced.contains("Connection: keep-alive"))

test "http connection_value_for decides keep-alive per request":
    crlf := chr(13) + chr(10)
    plain := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8("GET /a HTTP/1.1" + crlf + "Host: x" + crlf + crlf)).buffered_chunked(8))!
    assert_eq(connection_value_for(plain, text(200, "a")), "")
    asked_close := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8("GET /a HTTP/1.1" + crlf + "Connection: keep-alive, Close" + crlf + crlf)).buffered_chunked(8))!
    assert_eq(connection_value_for(asked_close, text(200, "a")), "close")
    old := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8("GET /a HTTP/1.0" + crlf + "Connection: Keep-Alive" + crlf + crlf)).buffered_chunked(8))!
    assert_eq(connection_value_for(old, text(200, "a")), "keep-alive")
    # a handler that set its own Connection is respected over the default.
    assert_eq(connection_value_for(plain, text(200, "a").close_connection()), "close")
    assert_eq(connection_value_for(plain, text(200, "a").keep_alive()), "")

test "http reads sequential responses from one reader":
    first := text(200, "one").keep_alive().to_bytes()!
    second := text(200, "two").close_connection().to_bytes()!
    input := bytes.buffer()
    input.write(first)!
    input.write(second)!
    reader := io.bytes_reader(input.bytes()).buffered_chunked(4)

    resp1 := read_response_buffered_bytes(reader)!
    resp2 := read_response_buffered_bytes(reader)!

    assert_eq(resp1.body_text()!, "one")
    assert_eq(resp1.header_value("Connection"), "keep-alive")
    assert_eq(resp2.body_text()!, "two")
    assert_eq(resp2.header_value("Connection"), "close")

test "http reads close-delimited responses from a reader":
    crlf := chr(13) + chr(10)
    raw := "HTTP/1.1 200 OK" + crlf + "Connection: close" + crlf + crlf + "legacy body"
    resp := read_response_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4))!
    assert_eq(resp.body_text()!, "legacy body")
    assert_eq(resp.header_value("Connection"), "close")

test "http streams sized responses over a buffered writer":
    output := bytes.buffer()
    writer := output.buffered_chunked(6)

    send_sized_response_head(writer, text(200, "").keep_alive(), 11)!
    send_stream_text(writer, "hello ")!
    send_stream_text(writer, "world")!

    resp := read_response_buffered_bytes(io.bytes_reader(output.bytes()).buffered_chunked(4))!
    assert_eq(resp.body_text()!, "hello world")
    assert_eq(resp.header_value("Connection"), "keep-alive")

test "http streams chunked responses over a buffered writer":
    output := bytes.buffer()
    writer := output.buffered_chunked(5)

    send_chunked_response_head(writer, text(200, "").keep_alive())!
    send_chunked_response_text(writer, "hello ")!
    send_chunked_response_bytes(writer, bytes.from_string_utf8("world"))!
    finish_chunked_response(writer)!

    resp := read_response_buffered_bytes(io.bytes_reader(output.bytes()).buffered_chunked(4))!
    assert_eq(resp.body_text()!, "hello world")
    assert_eq(resp.header_value("Transfer-Encoding"), "chunked")
    assert_eq(resp.header_value("Connection"), "keep-alive")

test "http streams decoded response bodies into writers":
    raw := text(200, "hello world").keep_alive().to_bytes()!
    output := bytes.buffer()

    streamed := read_response_buffered_bytes_into(io.bytes_reader(raw).buffered_chunked(4), output.buffered_chunked(5))!

    assert(streamed.is_success())
    assert_eq(streamed.body_size, 11)
    assert_eq(streamed.header_value("Connection"), "keep-alive")
    assert_eq(output.bytes().to_string_utf8()!, "hello world")

test "http streams file responses over buffered writers":
    file_path := "/tmp/pith-http-send-file-" + time_mod.now().to_string() + ".txt"
    fs.write(file_path, "hello file body")!
    output := bytes.buffer()

    send_file_path(output.buffered_chunked(5), text(200, "").keep_alive(), file_path)!

    resp := read_response_buffered_bytes(io.bytes_reader(output.bytes()).buffered_chunked(4))!
    assert_eq(resp.body_text()!, "hello file body")
    assert_eq(resp.header_value("Connection"), "keep-alive")
    fs.remove(file_path)

test "http static and download helpers set file headers":
    file_path := "/tmp/pith-http-static-" + time_mod.now().to_string() + ".html"
    fs.write(file_path, "<h1>ok</h1>")!
    static_out := bytes.buffer()
    download_out := bytes.buffer()

    send_static_path(static_out.buffered_chunked(5), response(200).keep_alive(), file_path)!
    send_download_path(download_out.buffered_chunked(5), response(200).keep_alive(), file_path, "index.html")!

    static_resp := read_response_buffered_bytes(io.bytes_reader(static_out.bytes()).buffered_chunked(4))!
    download_resp := read_response_buffered_bytes(io.bytes_reader(download_out.bytes()).buffered_chunked(4))!
    assert_eq(static_resp.header_value("Content-Type"), MIME_HTML)
    assert_eq(download_resp.header_value("Content-Type"), MIME_HTML)
    assert_eq(download_resp.header_value("Content-Disposition"), "attachment; filename=" + chr(34) + "index.html" + chr(34))
    assert_eq(download_resp.body_text()!, "<h1>ok</h1>")
    fs.remove(file_path)

test "http streams chunked response bodies into writers":
    crlf := chr(13) + chr(10)
    raw := "HTTP/1.1 200 OK" + crlf + "Transfer-Encoding: chunked" + crlf + "Connection: keep-alive" + crlf + crlf + "6" + crlf + "hello " + crlf + "5" + crlf + "world" + crlf + "0" + crlf + crlf
    output := bytes.buffer()

    streamed := read_response_buffered_bytes_into(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4), output.buffered_chunked(5))!

    assert_eq(streamed.body_size, 11)
    assert_eq(streamed.header_value("Transfer-Encoding"), "chunked")
    assert_eq(output.bytes().to_string_utf8()!, "hello world")

test "http client requests can stream responses into files":
    crlf := chr(13) + chr(10)
    raw := "HTTP/1.1 200 OK" + crlf + "Content-Length: 11" + crlf + "Connection: close" + crlf + crlf + "hello world"
    file_path := "/tmp/pith-http-download-" + time_mod.now().to_string() + ".txt"
    request_buf := bytes.buffer()
    conn := ClientConn(io.from_fd(1), io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4), request_buf.buffered_chunked(4))

    streamed := conn.send_to_file(get_request("example.test", 80, "/download"), file_path)!

    assert_eq(streamed.body_size, 11)
    assert_eq(fs.read(file_path)!, "hello world")
    fs.remove(file_path)

test "http multipart helpers keep binary bodies raw":
    file_buf := bytes.buffer()
    file_buf.write_string_utf8("FG")!
    file_buf.write_byte(255)!
    file_buf.write_byte(0)!
    mut parts: List[MultipartPart] := []
    parts.push(multipart_field("note", "hello multipart"))
    parts.push(multipart_file("blob", "blob.bin", "application/octet-stream", file_buf.bytes()))

    req_bytes := post_request("example.test", 80, "/upload").multipart_body_with_boundary(parts, "pith-boundary-test")!.to_bytes()!
    req := read_request_buffered_bytes(io.bytes_reader(req_bytes).buffered_chunked(5))!

    assert(req.is_multipart()!)
    assert_eq(req.multipart_boundary()!, "pith-boundary-test")
    assert_eq(req.body_text_or("binary"), "binary")
    assert_eq(req.multipart_text("note")!, "hello multipart")
    assert_eq(req.multipart_text_or("missing", "fallback"), "fallback")
    assert(req.has_multipart_part("blob")!)
    assert(not req.has_multipart_part("missing")!)

    parsed_parts := req.multipart_parts()!
    assert_eq(parsed_parts.len(), 2)
    blob := req.multipart_part("blob")!
    assert(blob.is_file())
    assert_eq(blob.filename, "blob.bin")
    assert_eq(blob.header("Content-Type"), "application/octet-stream")
    assert_eq(blob.body_bytes().len(), 4)
    assert_eq(blob.body_bytes()[0], 70)
    assert_eq(blob.body_bytes()[1], 71)
    assert_eq(blob.body_bytes()[2], 255)
    assert_eq(blob.body_bytes()[3], 0)
    assert_eq(blob.text_or("binary"), "binary")

test "http instrumentation logs requests and records metrics":
    metrics.reset()
    log_path := "/tmp/pith-http-observe-" + time_mod.now().to_string() + ".txt"
    logger := log.root().json().file(log_path).with([log.str("service", "api")])

    crlf := chr(13) + chr(10)
    raw := "GET /metrics HTTP/1.1" + crlf + "Host: example.test" + crlf + crlf
    req := read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(4))!
    started := time_mod.now()
    metrics.counter(instrumentation_metric_name("http_test", "requests_total")).inc()
    inflight := metrics.gauge(instrumentation_metric_name("http_test", "in_flight"))
    inflight.add(1.0)
    resp := text(201, req.method_text)
    inflight.add(0.0 - 1.0)
    elapsed := time_mod.now() - started
    metrics.counter(instrumentation_metric_name("http_test", "responses_total_" + resp.status.to_string())).inc()
    metrics.histogram(instrumentation_metric_name("http_test", "request_duration_ms")).observe(elapsed.to_float())
    instrumented_logger(logger, req).info().int("status", resp.status).duration_ms("elapsed_ms", elapsed).msg("request complete")

    snapshot := metrics.snapshot_text()
    log_text := io.read_file_text(log_path)!
    assert_eq(resp.status, 201)
    assert(snapshot.contains("http_test_requests_total 1"))
    assert(snapshot.contains("http_test_in_flight 0"))
    assert(snapshot.contains("http_test_responses_total_201 1"))
    assert(snapshot.contains("http_test_request_duration_ms_count 1"))
    assert(log_text.contains(chr(34) + "message" + chr(34) + ":" + chr(34) + "request complete" + chr(34)))
    assert(log_text.contains(chr(34) + "trace_id" + chr(34) + ":" + chr(34)))
    remove_file(log_path)

test "query values are percent-decoded and plus becomes space":
    req := build_http_request(bytes.from_string_utf8("GET /s?q=a+b%20c&city=S%C3%A3o HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.query_param("q")!, "a b c")
    assert_eq(req.query_param("city")!, "São")

test "duplicate query keys resolve first-wins across both readers":
    req := build_http_request(bytes.from_string_utf8("GET /s?x=1&x=2 HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.query_param("x")!, "1")
    packed := pack_request(req)!
    assert_eq(get_query_param(packed, "x"), "1")

test "a query key with no value is present and empty":
    req := build_http_request(bytes.from_string_utf8("GET /s?flag&y=2 HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.has_query_param("flag")!, true)
    assert_eq(req.query_param("flag")!, "")

test "an encoded separator in a query value is not split":
    req := build_http_request(bytes.from_string_utf8("GET /s?q=a%26b HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.query_param("q")!, "a&b")

test "a route parameter is percent-decoded":
    req := build_http_request(bytes.from_string_utf8("GET /users/a%20b HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.path_param("/users/:id", "id")!, "a b")

test "a route parameter keeps a plus and an encoded slash stays in its segment":
    req := build_http_request(bytes.from_string_utf8("GET /files/a+b%2Fc HTTP/1.1\r\n\r\n"), bytes.empty())!
    assert_eq(req.path_param("/files/:name", "name")!, "a+b/c")
    assert(not req.matches_path("/files/:dir/:name")!)

test "a literal route segment matches its percent-encoded spelling":
    assert(route_match_path("/caf%C3%A9/%61pi", "/café/api"))
    assert(not route_match_path("/caf%C3%A9", "/cafe"))

test "a trailing wildcard matches the rest of the path":
    pattern := path_segments("/static/*path")
    assert(segments_match(path_segments("/static"), pattern))
    assert(segments_match(path_segments("/static/a/b%20c.txt"), pattern))
    assert(not segments_match(path_segments("/other/a"), pattern))
    assert_eq(segment_param(path_segments("/static/a/b%20c.txt"), pattern, "path"), "a/b c.txt")
    assert_eq(segment_param(path_segments("/static"), pattern, "path"), "")

test "clean_path follows net/http and never climbs above the root":
    assert_eq(clean_path("/a/b"), "/a/b")
    assert_eq(clean_path("/a/b/"), "/a/b/")
    assert_eq(clean_path("/"), "/")
    assert_eq(clean_path(""), "/")
    assert_eq(clean_path("a/b"), "/a/b")
    assert_eq(clean_path("//a///b//"), "/a/b/")
    assert_eq(clean_path("/a/./b/."), "/a/b")
    assert_eq(clean_path("/a/b/../c"), "/a/c")
    assert_eq(clean_path("/a/b/../"), "/a/")
    assert_eq(clean_path("/.."), "/")
    assert_eq(clean_path("/../../etc/passwd"), "/etc/passwd")
    assert_eq(clean_path("/a/%2e%2E/%2e/b"), "/b")
    assert_eq(clean_path("/a/.%2e/b"), "/b")
    assert_eq(clean_path("//evil.example/x"), "/evil.example/x")
    # a name that only starts with dots, or an escape that is not a dot, stays.
    assert_eq(clean_path("/.well-known/..x/%2ex"), "/.well-known/..x/%2ex")
    assert_eq(clean_path("/a%2F..%2Fb"), "/a%2F..%2Fb")

test "path_is_clean agrees with clean_path":
    for p in ["/", "/a", "/a/", "/a/b.txt", "/..x", "//", "/a//b", "/./", "/a/..", "/%2e", "x", "", "/a%2Fb"]:
        assert_eq(path_is_clean(p), clean_path(p) == p)

fn form_request(method: String, target: String, content_type: String, body: String) -> HttpRequestBytes!:
    head := method + " " + target + " HTTP/1.1\r\nHost: h\r\nContent-Type: " + content_type + "\r\n\r\n"
    return build_http_request(bytes.from_string_utf8(head), bytes.from_string_utf8(body))!

test "parse_form decodes plus and escapes and keeps repeated keys":
    values := parse_form("a=1&b=x+y%21&a=2&flag&=v&c=%26")
    assert_eq(values["a"].len(), 2)
    assert_eq(values["a"][0], "1")
    assert_eq(values["a"][1], "2")
    assert_eq(values["b"][0], "x y!")
    assert_eq(values["flag"][0], "")
    assert_eq(values[""][0], "v")
    assert_eq(values["c"][0], "&")
    assert_eq(parse_form("").len(), 0)

test "form values merge the body before the query":
    req := form_request("POST", "/f?a=query&q=1", "application/x-www-form-urlencoded; charset=utf-8", "a=body&b=2")!
    assert_eq(req.form_value("a"), "body")
    assert_eq(req.form_value("q"), "1")
    assert_eq(req.form()["a"].len(), 2)
    assert_eq(req.form()["a"][1], "query")
    assert_eq(req.post_form_value("q"), "")
    assert_eq(req.post_form_value("b"), "2")
    assert_eq(req.form_value("missing"), "")

test "a GET body and a non-form body are not form values":
    get := form_request("GET", "/f?a=1", "application/x-www-form-urlencoded", "a=body")!
    assert_eq(get.form_value("a"), "1")
    assert_eq(get.post_form().len(), 0)
    json_post := form_request("POST", "/f", "application/json", "a=body")!
    assert_eq(json_post.form_value("a"), "")

test "multipart text fields are form values and files are not":
    parts := [multipart_field("title", "hello"), multipart_file_text("upload", "a.txt", "text/plain", "file body")]
    body := encode_multipart(parts, "XyZ")!.to_string_utf8()!
    req := form_request("POST", "/up", "multipart/form-data; boundary=XyZ", body)!
    assert_eq(req.form_value("title"), "hello")
    assert_eq(req.form_value("upload"), "")
    assert_eq(req.multipart_part("upload")!.filename, "a.txt")
    assert_eq(req.multipart_part("upload")!.text()!, "file body")

fn auth_request(value: String) -> HttpRequestBytes!:
    head := "GET / HTTP/1.1\r\nHost: h\r\nAuthorization: " + value + "\r\n\r\n"
    return build_http_request(bytes.from_string_utf8(head), bytes.empty())!

test "basic_auth reads the user and password":
    creds := auth_request("Basic " + encoding.b64_encode_string("ada:pa:ss"))!.basic_auth()!
    assert_eq(creds.user, "ada")
    assert_eq(creds.password, "pa:ss")
    lower := auth_request("basic " + encoding.b64_encode_string("u:"))!.basic_auth()!
    assert_eq(lower.user, "u")
    assert_eq(lower.password, "")
    assert(auth_request("Bearer abc")!.basic_auth().is_err)
    assert(auth_request("Basic !!!")!.basic_auth().is_err)
    assert(auth_request("Basic " + encoding.b64_encode_string("nocolon"))!.basic_auth().is_err)
    no_header := build_http_request(bytes.from_string_utf8("GET / HTTP/1.1\r\nHost: h\r\n\r\n"), bytes.empty())!
    assert(no_header.basic_auth().is_err)

test "basic_auth_challenge asks for credentials with a quoted realm":
    q := chr(34)
    bs := chr(92)
    resp := basic_auth_challenge("ops " + q + "x" + q)
    assert_eq(resp.status, 401)
    assert_eq(resp.header_value("WWW-Authenticate"), "Basic realm=" + q + "ops " + bs + q + "x" + bs + q + q + ", charset=" + q + "UTF-8" + q)

fn bytes_of(values: List[Int]) -> Bytes:
    buf := bytes.buffer()
    for value in values:
        buf.write_byte(value)
    return buf.take_bytes()

test "detect_content_type knows the common signatures":
    q := chr(34)
    assert_eq(detect_content_type(bytes.from_string_utf8("  <!doctype html><p>")), "text/html; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("<HTML>")), "text/html; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("<a href=x>")), "text/html; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("<?xml version=")), "text/xml; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("hello world")), "text/plain; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8(" " + chr(123) + q + "a" + q + ":1" + chr(125))), MIME_JSON)
    assert_eq(detect_content_type(bytes.from_string_utf8(chr(123) + " note" + chr(125))), "text/plain; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("[1, 2]")), MIME_JSON)
    assert_eq(detect_content_type(bytes.from_string_utf8("[note] not json")), "text/plain; charset=utf-8")
    assert_eq(detect_content_type(bytes.from_string_utf8("%PDF-1.7")), "application/pdf")
    assert_eq(detect_content_type(bytes_of([137, 80, 78, 71, 13, 10, 26, 10, 0])), MIME_PNG)
    assert_eq(detect_content_type(bytes_of([255, 216, 255, 224])), MIME_JPEG)
    assert_eq(detect_content_type(bytes.from_string_utf8("GIF89a....")), MIME_GIF)
    assert_eq(detect_content_type(bytes.from_string_utf8("RIFF0000WEBPVP8 ")), MIME_WEBP)
    assert_eq(detect_content_type(bytes_of([80, 75, 3, 4, 20])), "application/zip")
    assert_eq(detect_content_type(bytes_of([31, 139, 8, 0])), "application/x-gzip")
    assert_eq(detect_content_type(bytes_of([0, 97, 115, 109, 1, 0, 0, 0])), MIME_WASM)
    assert_eq(detect_content_type(bytes_of([1, 2, 3])), MIME_BINARY)
    assert_eq(detect_content_type(bytes.empty()), "text/plain; charset=utf-8")

test "parse_http_date reads all three date forms":
    assert_eq(parse_http_date("Sun, 06 Nov 1994 08:49:37 GMT")!, 784111777)
    assert_eq(parse_http_date("Sunday, 06-Nov-94 08:49:37 GMT")!, 784111777)
    assert_eq(parse_http_date("Sun Nov  6 08:49:37 1994")!, 784111777)
    assert_eq(parse_http_date(http_date(1700000000))!, 1700000000)
    assert(parse_http_date("yesterday").is_err)
    assert(parse_http_date("Sun, 32 Nov 1994 08:49:37 GMT").is_err)
    assert(parse_http_date("Sun, 06 Nov 1994 25:49:37 GMT").is_err)

test "plan_ranges follows rfc 9110 14":
    one := plan_ranges("bytes=0-4", 10)
    assert_eq(one.status, 206)
    assert_eq(one.starts[0], 0)
    assert_eq(one.lengths[0], 5)
    suffix := plan_ranges("bytes=-3", 10)
    assert_eq(suffix.starts[0], 7)
    assert_eq(suffix.lengths[0], 3)
    assert_eq(plan_ranges("bytes=8-", 10).lengths[0], 2)
    assert_eq(plan_ranges("bytes=5-100", 10).lengths[0], 5)
    assert_eq(plan_ranges("Bytes=0-1, 4-5", 10).starts.len(), 2)
    assert_eq(plan_ranges("bytes=20-30", 10).status, 416)
    assert_eq(plan_ranges("bytes=-0", 10).status, 416)
    assert_eq(plan_ranges("bytes=0-0", 0).status, 416)
    # ignored: another unit, bad syntax, more than the content in total.
    assert_eq(plan_ranges("items=0-1", 10).status, 0)
    assert_eq(plan_ranges("bytes=5-1", 10).status, 0)
    assert_eq(plan_ranges("bytes=a-b", 10).status, 0)
    assert_eq(plan_ranges("bytes=", 10).status, 0)
    assert_eq(plan_ranges("bytes=0-9,0-9", 10).status, 0)

test "etag lists are scanned with strong and weak comparison":
    tag := chr(34) + "a,b" + chr(34)
    assert(etag_list_matches(tag, tag, false))
    assert(etag_list_matches(chr(34) + "x" + chr(34) + ", " + tag, tag, false))
    assert(etag_list_matches("W/" + tag, tag, true))
    assert(not etag_list_matches("W/" + tag, tag, false))
    assert(etag_list_matches("*", tag, false))
    assert(not etag_list_matches(chr(34) + "a" + chr(34), tag, true))

fn response_head_of(text: String, method: String) -> ResponseHead!:
    return parse_response_head(bytes.from_string_utf8(text), method)

test "parse_response_head checks the status line":
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\n\r\n", "GET")!.status, 200)
    assert_eq(response_head_of("HTTP/1.1 204\r\n\r\n", "GET")!.status, 204)
    assert_eq(response_head_of("HTTP/1.1 404 \r\n\r\n", "GET")!.status, 404)
    assert_eq(response_head_of("HTTP/1.0 200 OK\n\n", "GET")!.minor, 0)
    assert(response_head_of("HTTP/1.1 20 OK\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert(response_head_of("HTTP/1.1 2000 OK\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert(response_head_of("HTTP/1.1  200 OK\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert(response_head_of("ICY 200 OK\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert(response_head_of("HTTP/1.1 099 Low\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert_eq(response_head_of("HTTP/2.0 200 OK\r\n\r\n", "GET").err, RESPONSE_VERSION_MESSAGE)
    assert(response_head_of("HTTP/1.1 200 O" + chr(1) + "K\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert(response_head_of("HTTP/1.1 200 OK\r\nBad Name: x\r\n\r\n", "GET").err.starts_with(RESPONSE_PREFIX))
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nA: b\r\n", "GET").err, RESPONSE_INCOMPLETE_MESSAGE)

test "parse_response_head frames the body as rfc 9112 6.3 says":
    exact := response_head_of("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n", "GET")!
    assert_eq(exact.kind, HTTP_RESPONSE_BODY_EXACT)
    assert_eq(exact.content_length, 5)
    assert(not exact.wants_close)
    chunked := response_head_of("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n", "GET")!
    assert_eq(chunked.kind, HTTP_RESPONSE_BODY_CHUNKED)
    until_close := response_head_of("HTTP/1.1 200 OK\r\n\r\n", "GET")!
    assert_eq(until_close.kind, HTTP_RESPONSE_BODY_UNTIL_CLOSE)
    assert(until_close.wants_close)
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n", "HEAD")!.kind, HTTP_RESPONSE_BODY_NONE)
    assert_eq(response_head_of("HTTP/1.1 204 No Content\r\n\r\n", "GET")!.kind, HTTP_RESPONSE_BODY_NONE)
    assert_eq(response_head_of("HTTP/1.1 304 Not Modified\r\nContent-Length: 9\r\n\r\n", "GET")!.kind, HTTP_RESPONSE_BODY_NONE)
    assert_eq(response_head_of("HTTP/1.1 100 Continue\r\n\r\n", "GET")!.kind, HTTP_RESPONSE_BODY_NONE)
    assert(response_head_of("HTTP/1.0 200 OK\r\nContent-Length: 1\r\n\r\n", "GET")!.wants_close)
    assert(not response_head_of("HTTP/1.0 200 OK\r\nConnection: keep-alive\r\nContent-Length: 1\r\n\r\n", "GET")!.wants_close)
    assert(response_head_of("HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 1\r\n\r\n", "GET")!.wants_close)

test "parse_response_head refuses ambiguous framing":
    both := response_head_of("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n", "GET")
    assert_eq(both.err, RESPONSE_PREFIX + "both Transfer-Encoding and Content-Length")
    conflicting := response_head_of("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\n", "GET")
    assert_eq(conflicting.err, RESPONSE_PREFIX + "conflicting Content-Length")
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\n", "GET")!.content_length, 5)
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nContent-Length: -1\r\n\r\n", "GET").err, RESPONSE_PREFIX + "invalid Content-Length")
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n", "GET").err, RESPONSE_CODING_MESSAGE)
    assert_eq(response_head_of("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked, chunked\r\n\r\n", "GET").err, RESPONSE_CODING_MESSAGE)

test "a response read skips interim responses and keeps trailers":
    wire := "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </a>\r\n\r\nHTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\nX-Sum: 42\r\n\r\n"
    resp := parse_response(wire)!
    assert_eq(resp.status, 200)
    assert_eq(resp.body_text()!, "abc")
    assert_eq(header_lookup(resp.trailers, "x-sum"), "42")

test "a client request head names the origin and frames the body":
    get := request_wire_bytes(get_request("example.test", 8080, "/a"), "/a", "", false)!.to_string_utf8()!
    assert_eq(get, "GET /a HTTP/1.1\r\nHost: example.test:8080\r\n\r\n")
    https := request_wire_bytes(https_request("GET", "example.test", "/"), "/", "close", true)!.to_string_utf8()!
    assert_eq(https, "GET / HTTP/1.1\r\nHost: example.test\r\nConnection: close\r\nAccept-Encoding: gzip\r\n\r\n")
    v6 := request_wire_bytes(get_request("::1", 80, "/"), "/", "", false)!.to_string_utf8()!
    assert_eq(v6, "GET / HTTP/1.1\r\nHost: [::1]\r\n\r\n")
    empty_post := request_wire_bytes(post_request("h", 80, "/p"), "/p", "", false)!.to_string_utf8()!
    assert_eq(empty_post, "POST /p HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\n\r\n")
    sized := request_wire_bytes(post_request("h", 80, "/p").body_text("hi").header("Content-Length", "9"), "/p", "", false)!.to_string_utf8()!
    assert_eq(sized, "POST /p HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n\r\nhi")
    chunked := request_wire_bytes(post_request("h", 80, "/p").body_text("hello").header("Transfer-Encoding", "chunked"), "/p", "", false)!.to_string_utf8()!
    assert_eq(chunked, "POST /p HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")

test "proxy_for follows net/http's NO_PROXY rules":
    p := "http://proxy.test:3128"
    assert_eq(proxy_for(p, "", "example.com", 80), p)
    assert_eq(proxy_for("", "", "example.com", 80), "")
    assert_eq(proxy_for(p, "", "localhost", 80), "")
    assert_eq(proxy_for(p, "", "127.0.0.1", 80), "")
    assert_eq(proxy_for(p, "", "::1", 80), "")
    assert_eq(proxy_for(p, "*", "example.com", 80), "")
    assert_eq(proxy_for(p, "example.com", "example.com", 80), "")
    assert_eq(proxy_for(p, "example.com", "api.example.com", 80), "")
    assert_eq(proxy_for(p, "example.com", "notexample.com", 80), p)
    assert_eq(proxy_for(p, ".example.com", "example.com", 80), p)
    assert_eq(proxy_for(p, ".example.com", "api.example.com", 80), "")
    assert_eq(proxy_for(p, "other.test, Example.COM:8080", "example.com", 8080), "")
    assert_eq(proxy_for(p, "example.com:8080", "example.com", 80), p)
    assert_eq(proxy_for(p, "[2001:db8::1]:443", "2001:db8::1", 443), "")
    assert_eq(proxy_for(p, "2001:db8::1", "2001:db8::1", 80), "")
    addr := parse_proxy_address("proxy.test:3128")!
    assert_eq(addr.0, "proxy.test")
    assert_eq(addr.1, 3128)
    assert_eq(parse_proxy_address("http://proxy.test")!.1, 80)
    assert(parse_proxy_address("socks5://proxy.test:1080").is_err)
