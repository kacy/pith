# letting a browser on another origin call your api, and only the ones you meant.
#
# a std.web app with a cors policy in front of it. the client plays the part
# of the browser: it sends an Origin header, and then the OPTIONS preflight a
# browser sends ahead of anything more than a plain form post, and prints the
# headers that come back.
#
# the part worth copying is which constructor to reach for.
# cors.any_origin() is the public read-only api; cors.origins(list) is a
# named allowlist; cors.credentialed_origins(list) is the one that lets the
# browser attach a session cookie. only the third turns credentials on, and
# it has no wildcard — so "reflect any origin and allow credentials", the
# mistake that switches the same-origin policy off entirely, is not a thing
# this api can be asked to do.

import std.net.http as http
import std.web as web
import std.web.cors as cors

PORT := 18101
APP_ORIGIN := "https://app.example.com"
OTHER_ORIGIN := "https://someone-else.example.com"

fn list_items(req: web.Request) -> http.HttpResponse:
    return http.json(200, "[1,2,3]").header("X-Request-Id", "req-7")

fn create_item(req: web.Request) -> http.HttpResponse:
    return http.json(201, "{{\"created\":true}}")

fn build_app() -> web.App:
    policy := cors.origins([APP_ORIGIN]).methods(["GET", "POST"]).headers(["Content-Type"]).expose(["X-Request-Id"]).max_age(600)
    mut app := web.new()
    # outermost, so even a response some later guard produced carries the
    # headers the browser needs in order to read it.
    app = app.use_mw(cors.middleware(policy))
    app = app.get("/api/items", list_items)
    app = app.post("/api/items", create_item)
    return app

fn serve_bg(port: Int) -> Int:
    return build_app().listen("127.0.0.1", port) catch 0

# one request with an Origin header, reported as the browser would read it:
# the status, and whether the answer said this origin may read it.
fn call(method: String, origin: String, preflight_for: String) -> String!:
    mut req := http.request(method, "127.0.0.1", PORT, "/api/items")
    if origin.len() > 0:
        req = req.header("Origin", origin)
    if preflight_for.len() > 0:
        req = req.header("Access-Control-Request-Method", preflight_for)
    resp := req.send()!
    allow := resp.header_value("Access-Control-Allow-Origin")
    if allow.len() > 0:
        return resp.status.to_string() + ", allow-origin " + allow
    if origin.len() == 0:
        return resp.status.to_string() + ", same origin, nothing to allow"
    return resp.status.to_string() + ", no allow-origin: the browser blocks the read"

fn main() -> Int!:
    port := PORT
    spawn serve_bg(port)
    sleep(200)   # give the listener a moment to bind

    print("=== a real request ===")
    print("from the app origin:  " + call("GET", APP_ORIGIN, "")!)
    print("from anywhere else:   " + call("GET", OTHER_ORIGIN, "")!)
    print("no Origin at all:     " + call("GET", "", "")!)

    print("")
    print("=== the preflight a browser sends first ===")
    print("from the app origin:  " + call("OPTIONS", APP_ORIGIN, "POST")!)
    print("from anywhere else:   " + call("OPTIONS", OTHER_ORIGIN, "POST")!)

    print("")
    print("=== what the preflight told the browser it may do ===")
    resp := http.request("OPTIONS", "127.0.0.1", port, "/api/items").header("Origin", APP_ORIGIN).header("Access-Control-Request-Method", "POST").send()!
    print("methods:  " + resp.header_value("Access-Control-Allow-Methods"))
    print("headers:  " + resp.header_value("Access-Control-Allow-Headers"))
    print("max-age:  " + resp.header_value("Access-Control-Max-Age"))
    print("vary:     " + resp.header_value("Vary"))

    print("")
    print("=== headers page javascript may read off the real response ===")
    real := http.get_request("127.0.0.1", port, "/api/items").header("Origin", APP_ORIGIN).send()!
    print("expose:   " + real.header_value("Access-Control-Expose-Headers"))
    # this policy is not a credentialed one, so the header is simply absent —
    # and the browser will not attach the user's cookies to the call.
    print("credentials header sent: " + (real.header_value("Access-Control-Allow-Credentials").len() > 0).to_string())

    print("")
    print("=== a plain OPTIONS, which is not a preflight ===")
    plain := http.request("OPTIONS", "127.0.0.1", port, "/api/items").send()!
    print("status:   " + plain.status.to_string())
    print("allow:    " + plain.header_value("Allow"))
    return 0
