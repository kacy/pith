import std.testing as testing

fn my_eq[T](a: T, b: T) -> Bool:
    return a == b

fn my_neq[T](a: T, b: T) -> Bool:
    return a != b

fn main() -> Int!:
    a: Int? := 5
    b: Int? := 5
    c: Int? := 6
    n1: Int? := none
    n2: Int? := none

    print("int_some_eq:" + my_eq(a, b).to_string())
    print("int_some_neq:" + my_eq(a, c).to_string())
    print("int_none_eq:" + my_eq(n1, n2).to_string())
    print("int_some_vs_none:" + my_eq(a, n1).to_string())
    print("int_some_neq_op:" + my_neq(a, c).to_string())
    print("int_none_neq_op:" + my_neq(n1, n2).to_string())

    sa: String? := "hi"
    sb: String? := "hi"
    sc: String? := "bye"
    print("str_eq:" + my_eq(sa, sb).to_string())
    print("str_neq:" + my_eq(sa, sc).to_string())

    z1: Int? := 0
    z2: Int? := 0
    print("zero_eq:" + my_eq(z1, z2).to_string())
    print("zero_vs_none:" + my_eq(z1, n1).to_string())

    testing.assert_eq(a, b)
    testing.assert_eq(n1, n2)
    testing.assert_ne(a, c)
    testing.assert_ne(a, n1)
    return 0
