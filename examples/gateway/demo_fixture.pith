# demo_fixture.pith: the identity provider bench/gateway_bench.sh runs. it prints
# a token for the load generator and publishes the key set that checks it.
#
#   ./demo_fixture <port>

import demo_identity as identity

fn main() -> Int!:
    port := parse_int(args()[1])!
    print(identity.token_for("bench-user", identity.AUDIENCE)!)
    return identity.serve(port)
