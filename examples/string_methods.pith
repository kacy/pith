# string_methods: the methods built into String.
#
# reads a few lines of an access log and reports on them. trim and split
# break a line apart, starts_with and is_empty skip comments and blanks,
# index_of, last_index_of and substring cut out a field, and to_upper and join
# tidy the result for printing.

struct Request:
    method: String
    path: String
    status: Int
    client: String

# a line looks like `10.0.0.7 - GET /api/users?page=2 200`
fn parse_line(line: String) -> Request!:
    fields := line.trim().split(" ")
    if fields.len() != 5 or fields[1] != "-":
        fail "expected 5 fields, found {fields.len()}"
    status := parse_int(fields[4])!
    return Request(method: fields[2].to_upper(), path: fields[3], status: status, client: fields[0])

# the path without its query string
fn route(path: String) -> String:
    query_start := path.index_of("?")
    if query_start < 0:
        return path
    return path.substring(0, query_start)

fn describe(request: Request) -> String:
    kind := if request.status >= 500: "server error" elif request.status >= 400: "client error" else: "ok"
    return "{request.method:<6} {route(request.path):<14} {request.status} {kind}"

fn main():
    log := [
        "10.0.0.7 - get /api/users?page=2 200",
        "  10.0.0.9 - POST /api/login 401",
        "# rotated at midnight",
        "10.0.0.7 - GET /static/app.js 200",
        "garbage line",
        "10.0.0.4 - DELETE /api/users/12 500",
]

    mut api_clients: List[String] := []
    mut skipped: List[String] := []
    for line in log:
        if line.starts_with("#") or line.trim().is_empty():
            continue
        request := parse_line(line) catch:
            skipped.push(line)
            continue
        print(describe(request))
        if request.path.starts_with("/api/") and not api_clients.contains(request.client):
            api_clients.push(request.client)

    print("")
    print("unparsed: {skipped.join(", ")}")
    print("api clients: {api_clients.join(", ")}")

    # a client address is masked before it goes into a shared report
    first := api_clients[0]
    masked := first.substring(0, first.last_index_of(".")) + ".x"
    print("first client, masked: {masked}")
