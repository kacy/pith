# a block lambda that calls a builtin returning nothing. the capture analysis took
# the name for a variable, and the build failed with `unknown load source`. a local
# of the same name is still captured.
fn main():
    say := fn(text: String) -> Int:
        print(text)
        sleep(0)
        return text.len()
    print(say("hello").to_string())
    sleep := 7
    read := fn() => sleep + 1
    print(read().to_string())
