# arguments bind by position, and a label used to be parsed and then ignored:
# `scaled(b: 1, a: 5)` bound 1 to a and printed 15, and a label naming no
# parameter compiled. a label must name the parameter in its position.
struct Counter:
    n: Int

impl Counter:
    fn add(by: Int, times: Int) -> Int:
        return self.n + by * times

fn scaled(a: Int, b: Int) -> Int:
    return a * 10 + b

fn first[T](a: T, b: T) -> T:
    return a

fn apply(f: fn(Int) -> Int) -> Int:
    return f(x: 1)

fn main():
    print("{scaled(b: 1, a: 5)}")
    print("{scaled(a: 5, c: 1)}")
    c := Counter(1)
    print("{c.add(times: 2, by: 3)}")
    print("{first(b: 1, a: 2)}")
