    g_name = heap("global")
    d := Defaults()
    d.s.add(src.name)
    d.s.add(table["k"])
    d.s.add(xs[0])
    d.s.add(g_name)
    d.s.add(p)
    for v in ys:
        d.s.add(v)
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("default_field_set_add")
    print(d.s.contains(heap("field")).to_string())
    print(d.s.contains(heap("map_index")).to_string())
    print(d.s.contains(heap("list_index")).to_string())
    print(d.s.contains(heap("global")).to_string())
    print(d.s.contains(heap("param")).to_string())
    print(d.s.contains(heap("for_var")).to_string())

