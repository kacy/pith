# stdlib_datetime: calendar arithmetic with std.datetime.
#
# plans the invoices for a monthly subscription that starts on january 31.
# add_months clamps to the end of a short month, invoices that fall on a
# weekend move to the next monday, and diff_days measures the gaps. a date is
# a plain Int, so dates compare and sort like numbers.

import std.datetime as datetime

# a weekend invoice would sit unread until monday anyway
fn next_business_day(date: Int) -> Int:
    return match datetime.weekday(date):
        0 => datetime.add_days(date, 1)
        6 => datetime.add_days(date, 2)
        _ => date

fn main():
    start := datetime.parse_date("2028-01-31")
    if not datetime.is_valid(start):
        print("bad start date")
        return
    trial_end := datetime.add_days(start, 14)
    print("signed up {datetime.format_long(start)}, trial ends {datetime.format_date(trial_end)}")
    print("2028 is a leap year: {datetime.is_leap_year(2028)}, february has {datetime.days_in_month(2028, 2)} days")
    print("")

    mut previous := start
    for month in 1..7:
        # counting from the start date, not the previous invoice, keeps a
        # clamped february from dragging every later month to the 29th
        due := datetime.add_months(start, month)
        sent := next_business_day(due)
        moved := if sent != due: " (moved from {datetime.weekday_name(due)})" else: ""
        gap := datetime.diff_days(previous, sent)
        print("invoice {month}: {datetime.format_date(sent)} {datetime.weekday_name(sent):<9} +{gap} days{moved}")
        previous = sent

    renewal := datetime.add_years(start, 1)
    print("")
    print("renews {datetime.format_long(renewal)}, day {datetime.day_of_year(renewal)} of {datetime.year(renewal)}")
    print("days in the first term: {datetime.diff_days(start, renewal)}")

    # input that does not parse comes back as 0, which is_valid rejects
    for text in ["2028-02-30", "next tuesday"]:
        print("{text}: valid date {datetime.is_valid(datetime.parse_date(text))}")
