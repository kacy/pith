# interpolating an optional renders its payload, or `none`. a struct, list or
# map payload was handed back as the string itself, so the interpolation
# printed garbage and released the payload as a string.
struct Node:
    value: Int

fn main() -> Int:
    xs := [Node(value: 1)]
    ls := [[1, 2]]
    mut ms: List[Map[String, Int]] := []
    ms.push({"a": 1})
    ns := [7]
    ss := ["s"]
    print("struct: {xs.get(0)}")
    print("list: {ls.get(0)}")
    print("map: {ms.get(0)}")
    print("int: {ns.get(0)}")
    print("string: {ss.get(0)}")
    print("none: {xs.get(3)}")
    return 0
