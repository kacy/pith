## hash bytes with fnv-1a (the 32-bit variant: offset basis 2166136261,
## prime 16777619).
pub fn fnv1a(input: Bytes) -> Int:
    mut h := 2166136261
    n := input.len()
    full := n - n % 8
    mut i := 0
    # eight bytes per read, the eight steps spelled out. the byte-at-a-time
    # form cost about 56 instructions per byte: a runtime call for the
    # length and one for the indexed byte on every iteration, a call into
    # the mask32 wrapper, and the loop's own overhead. bytes_read_word
    # lowers to one inlined load, and bits.band/bits.xor on two arguments
    # lower to single instructions, so a step is an xor, a multiply and a
    # mask. the multiply cannot overflow: h stays under 2^32 and the prime
    # is under 2^24. the tail of fewer than eight bytes goes one at a time.
    # fnv1a_reference below is the byte-at-a-time definition, kept as the
    # oracle the randomized test compares against.
    while i < full:
        word := bytes_read_word(input, i, 8)
        h = bits.band(bits.xor(h, bits.band(word, 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 8), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 16), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 24), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 32), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 40), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.band(bits.shr(word, 48), 255)) * 16777619, 4294967295)
        h = bits.band(bits.xor(h, bits.shr(word, 56)) * 16777619, 4294967295)
        i = i + 8
    while i < n:
        h = bits.band(bits.xor(h, input[i]) * 16777619, 4294967295)
        i = i + 1
    return h

# the byte-at-a-time fnv-1a this module shipped before the word loop, kept
# verbatim so the randomized test has an independent definition to agree
# with. not part of the module's surface.
fn fnv1a_reference(input: Bytes) -> Int:
    mut h := 2166136261
    mut i := 0
    while i < input.len():
        h = bits.xor(h, input[i])
        h = bits.mask32(h * 16777619)
        i = i + 1
    return h

fn hash_fnv1a(input: Bytes) -> Int:
    return fnv1a(input)

# hash a utf-8 string with fnv-1a.
pub fn fnv1a_string(input: String) -> Int:
    return fnv1a(bytes.from_string_utf8(input))

fn hash_fnv1a_string(input: String) -> Int:
    return fnv1a_string(input)

K0 := 1518500249
K1 := 1859775393
K2 := 2400959708
K3 := 3395469782

fn rotl32(x: Int, n: Int) -> Int:
    return bits.rotl32(x, n)

fn add32(a: Int, b: Int) -> Int:
    return bits.mask32(a + b)

## hash bytes with sha-1.
pub fn sha1(input: Bytes) -> String:
    mut h0 := 1732584193
    mut h1 := 4023233417
    mut h2 := 2562383102
    mut h3 := 271733878
    mut h4 := 3285377520

    # whole blocks are hashed straight out of the input and only the
    # padded tail goes through a list, as in sha2_32. sha1_reference below
    # is the definition this replaced, kept as the randomized test's oracle.
    n := input.len()
    full := n - n % 64
    tail := sha_padded_tail(input, full, 64)
    total := full + tail.len()
    w := zero_words(80)

    mut block := 0
    while block < total:
        if block < full:
            sha_load_words32(w, input, block)
        else:
            sha_load_words32_tail(w, tail, block - full)

        # a 32-bit rotate left by k is spelled band(bor(shl(x, k), shr(x,
        # 32 - k)), 2^32 - 1), for the reason given in sha2_32.
        mut i := 16
        while i < 80:
            x := bits.xor(bits.xor(bits.xor(w[i - 3], w[i - 8]), w[i - 14]), w[i - 16])
            w[i] = bits.band(bits.bor(bits.shl(x, 1), bits.shr(x, 31)), 4294967295)
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4

        i = 0
        while i < 80:
            mut f := 0
            mut k := 0

            if i < 20:
                f = bits.bor(bits.band(b, c), bits.band(bits.xor(b, 4294967295), d))
                k = K0
            elif i < 40:
                f = bits.xor(bits.xor(b, c), d)
                k = K1
            elif i < 60:
                f = bits.bor(bits.bor(bits.band(b, c), bits.band(b, d)), bits.band(c, d))
                k = K2
            else:
                f = bits.xor(bits.xor(b, c), d)
                k = K3

            temp := bits.band(bits.band(bits.bor(bits.shl(a, 5), bits.shr(a, 27)), 4294967295) + f + e + k + w[i], 4294967295)
            e = d
            d = c
            c = bits.band(bits.bor(bits.shl(b, 30), bits.shr(b, 2)), 4294967295)
            b = a
            a = temp
            i = i + 1

        h0 = bits.band(h0 + a, 4294967295)
        h1 = bits.band(h1 + b, 4294967295)
        h2 = bits.band(h2 + c, 4294967295)
        h3 = bits.band(h3 + d, 4294967295)
        h4 = bits.band(h4 + e, 4294967295)
        block = block + 64

    return word32_to_hex(h0) + word32_to_hex(h1) + word32_to_hex(h2) + word32_to_hex(h3) + word32_to_hex(h4)

# the copy-everything-into-a-list sha-1 this module shipped before the
# kernel read the input directly, kept verbatim as the randomized test's
# oracle. not part of the module's surface.
fn sha1_reference(input: Bytes) -> String:
    mut h0 := 1732584193
    mut h1 := 4023233417
    mut h2 := 2562383102
    mut h3 := 271733878
    mut h4 := 3285377520

    mut msg: List[Int] := []
    mut i := 0
    while i < input.len():
        msg.push(input[i])
        i = i + 1

    msg.push(128)
    while msg.len() % 64 != 56:
        msg.push(0)

    bit_len := input.len() * 8
    msg.push(bits.mask8(bits.shr(bit_len, 56)))
    msg.push(bits.mask8(bits.shr(bit_len, 48)))
    msg.push(bits.mask8(bits.shr(bit_len, 40)))
    msg.push(bits.mask8(bits.shr(bit_len, 32)))
    msg.push(bits.mask8(bits.shr(bit_len, 24)))
    msg.push(bits.mask8(bits.shr(bit_len, 16)))
    msg.push(bits.mask8(bits.shr(bit_len, 8)))
    msg.push(bits.mask8(bit_len))

    mut block := 0
    while block < msg.len():
        mut w: List[Int] := []
        i = 0
        while i < 16:
            word := msg[block + i * 4] * 16777216 + msg[block + i * 4 + 1] * 65536 + msg[block + i * 4 + 2] * 256 + msg[block + i * 4 + 3]
            w.push(word)
            i = i + 1

        i = 16
        while i < 80:
            w.push(rotl32(bits.xor(bits.xor(bits.xor(w[i - 3], w[i - 8]), w[i - 14]), w[i - 16]), 1))
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4

        i = 0
        while i < 80:
            mut f := 0
            mut k := 0

            if i < 20:
                f = bits.bor(bits.band(b, c), bits.band(bits.invert(b), d))
                k = K0
            elif i < 40:
                f = bits.xor(bits.xor(b, c), d)
                k = K1
            elif i < 60:
                f = bits.bor(bits.bor(bits.band(b, c), bits.band(b, d)), bits.band(c, d))
                k = K2
            else:
                f = bits.xor(bits.xor(b, c), d)
                k = K3

            temp := add32(add32(add32(add32(rotl32(a, 5), f), e), k), w[i])
            e = d
            d = c
            c = rotl32(b, 30)
            b = a
            a = temp
            i = i + 1

        h0 = add32(h0, a)
        h1 = add32(h1, b)
        h2 = add32(h2, c)
        h3 = add32(h3, d)
        h4 = add32(h4, e)
        block = block + 64

    return word32_to_hex(h0) + word32_to_hex(h1) + word32_to_hex(h2) + word32_to_hex(h3) + word32_to_hex(h4)

fn hash_sha1(input: Bytes) -> String:
    return sha1(input)

# compute a sha-1 digest and return raw bytes.
pub fn sha1_bytes(input: Bytes) -> Bytes:
    return encoding.from_hex(sha1(input)) catch bytes.empty()

# compute a sha-1 digest and return lowercase hex.
pub fn sha1_hex(input: Bytes) -> String:
    return sha1(input)

## hash a utf-8 string with sha-1.
pub fn sha1_string(input: String) -> String:
    return sha1(bytes.from_string_utf8(input))

fn hash_sha1_string(input: String) -> String:
    return sha1_string(input)

test "sha256 hashes bytes and strings":
    data := bytes.from_string_utf8("hello")
    digest := "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"

    assert_eq(sha256(data), digest)
    assert_eq(sha256_hex(data), digest)
    assert_eq(encoding.to_hex(sha256_bytes(data)), digest)
    assert_eq(sha256_string("hello"), digest)

test "sha224 hashes bytes and strings":
    data := bytes.from_string_utf8("hello")
    digest := "ea09ae9cc6768c50fcee903ed054556e5bfc8347907f12598aa24193"

    assert_eq(sha224(data), digest)
    assert_eq(encoding.to_hex(sha224_bytes(data)), digest)
    assert_eq(sha224_string("hello"), digest)

test "sha512 hashes bytes and strings":
    data := bytes.from_string_utf8("abc")
    digest := "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"

    assert_eq(sha512(data), digest)
    assert_eq(sha512_hex(data), digest)
    assert_eq(encoding.to_hex(sha512_bytes(data)), digest)
    assert_eq(sha512_string("abc"), digest)

test "sha384 hashes bytes and strings":
    data := bytes.from_string_utf8("abc")
    digest := "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"

    assert_eq(sha384(data), digest)
    assert_eq(sha384_hex(data), digest)
    assert_eq(encoding.to_hex(sha384_bytes(data)), digest)
    assert_eq(sha384_string("abc"), digest)

test "sha1 hashes bytes and strings":
    data := bytes.from_string_utf8("hello")
    digest := "aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d"

    assert_eq(sha1(data), digest)
    assert_eq(sha1_hex(data), digest)
    assert_eq(encoding.to_hex(sha1_bytes(data)), digest)
    assert_eq(sha1_string("hello"), digest)

test "fnv1a hashes bytes and strings":
    data := bytes.from_string_utf8("hello")

    assert_eq(fnv1a(data), 1335831723)
    assert_eq(fnv1a_string("hello"), 1335831723)
    assert_eq(fnv1a(bytes.empty()), 2166136261)
    assert_eq(fnv1a_string(""), 2166136261)
    # the fnv test vectors: "a" and "foobar" from the reference implementation
    assert_eq(fnv1a_string("a"), 3826002220)
    assert_eq(fnv1a_string("foobar"), 3214735720)

# random content at random lengths, checked against the byte-at-a-time
# definition. every length from 0 to 40 is covered several times so the
# word loop's boundary (a multiple of eight, then the tail) is hit at every
# offset, and a spread of longer inputs covers many full words.
test "fnv1a word loop agrees with the byte-at-a-time definition":
    mut state := 88172645463325252
    mut trial := 0
    while trial < 3000:
        buf := bytes.buffer()
        mut want := trial % 41
        if trial % 10 == 9:
            want = 41 + trial % 1000
        mut filled := 0
        while filled < want:
            # xorshift64: the low byte of each step is the next content byte
            state = bits.xor(state, bits.shl(state, 13))
            state = bits.xor(state, bits.shr(state, 7))
            state = bits.xor(state, bits.shl(state, 17))
            buf.write_byte(bits.band(state, 255))!
            filled = filled + 1
        data := buf.take_bytes()
        assert_eq(data.len(), want)
        assert_eq(fnv1a(data), fnv1a_reference(data))
        trial = trial + 1

# `want` bytes of xorshift64 content seeded from `seed`, for the randomized
# kernel cross-checks below: the low byte of each step is the next byte.
fn sha_test_content(seed: Int, want: Int) -> Bytes:
    buf := bytes.buffer()
    mut state := bits.xor(88172645463325252, seed * 2654435761)
    mut filled := 0
    while filled < want:
        state = bits.xor(state, bits.shl(state, 13))
        state = bits.xor(state, bits.shr(state, 7))
        state = bits.xor(state, bits.shl(state, 17))
        buf.write_byte(bits.band(state, 255)) catch 0
        filled = filled + 1
    return buf.take_bytes()

# the length of the randomized trial `trial`: every length from 0 to 200
# comes up about fifteen times in 3,000 trials, which covers every
# padding case (a tail of 55, 56, 63, 64, 111, 112, 127 and 128 bytes both
# fits and spills into a second block) and every word offset, and one
# trial in ten runs to 1,200 bytes for many whole blocks.
fn sha_test_length(trial: Int) -> Int:
    if trial % 10 == 9:
        return 201 + trial % 1000
    return trial % 201

# one million 'a' bytes, the long fips 180-4 vector.
fn million_a() -> Bytes:
    buf := bytes.buffer()
    mut i := 0
    while i < 125000:
        buf.write_word(7016996765293437281, 8)
        i = i + 1
    return buf.take_bytes()

test "sha256 and sha224 match the fips 180-4 vectors":
    two_blocks := bytes.from_string_utf8("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    assert_eq(sha256(bytes.empty()), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(sha256_string("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(sha256(two_blocks), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    assert_eq(sha256(million_a()), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    assert_eq(sha224(bytes.empty()), "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f")
    assert_eq(sha224_string("abc"), "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
    assert_eq(sha224(two_blocks), "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525")

test "sha512 and sha384 match the fips 180-4 vectors":
    two_blocks := bytes.from_string_utf8("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")
    assert_eq(sha512(bytes.empty()), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    assert_eq(sha512(two_blocks), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")
    assert_eq(sha512(million_a()), "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b")
    assert_eq(sha384(bytes.empty()), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
    assert_eq(sha384(two_blocks), "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")

test "sha1 matches the fips 180-4 vectors":
    assert_eq(sha1(bytes.empty()), "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    assert_eq(sha1_string("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
    assert_eq(sha1_string("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
    assert_eq(sha1(million_a()), "34aa973cd4c4daa4f61eeb2bdbad27316534016f")

# random content at the lengths sha_test_length describes, checked against
# the copy-into-a-list definition with both the sha-256 and the sha-224
# initial values (the same literals sha256 and sha224 pass).
test "sha2_32 agrees with the copy-into-a-list definition":
    mut trial := 0
    while trial < 3000:
        want := sha_test_length(trial)
        data := sha_test_content(trial, want)
        assert_eq(data.len(), want)
        assert_eq(sha256(data), sha2_32_reference(data, 1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225, 8))
        assert_eq(sha224(data), sha2_32_reference(data, 3238371032, 914150663, 812702999, 4144912697, 4290775857, 1750603025, 1694076839, 3204075428, 7))
        trial = trial + 1

test "sha2_64 agrees with the copy-into-a-list definition":
    mut trial := 0
    while trial < 3000:
        want := sha_test_length(trial)
        data := sha_test_content(trial, want)
        assert_eq(data.len(), want)
        assert_eq(sha512(data), sha2_64_reference(data, 7640891576956012808, -4942790177534073029, 4354685564936845355, -6534734903238641935, 5840696475078001361, -7276294671716946913, 2270897969802886507, 6620516959819538809, 8))
        assert_eq(sha384(data), sha2_64_reference(data, -3766243637369397544, 7105036623409894663, -7973340178411365097, 1526699215303891257, 7436329637833083697, -8163818279084223215, -2662702644619276377, 5167115440072839076, 6))
        trial = trial + 1

test "sha1 agrees with the copy-into-a-list definition":
    mut trial := 0
    while trial < 3000:
        want := sha_test_length(trial)
        data := sha_test_content(trial, want)
        assert_eq(data.len(), want)
        assert_eq(sha1(data), sha1_reference(data))
        trial = trial + 1
