# collection_methods: lists, maps and sets through their built-in methods.
#
# runs the front desk of a small conference. a set holds who registered, a
# list holds the waitlist in arrival order, and a map gives each guest a badge.
# collection literals build all three, and the methods do the rest.

fn print_sorted(label: String, names: List[String]):
    print("{label}: {names.sort().join(", ")}")

fn main():
    mut registered := {"ada", "grace", "linus", "barbara", "ken"}
    mut waitlist := ["dennis", "margaret", "alan"]
    mut badges := {"ada": "speaker", "grace": "speaker", "linus": "staff"}

    # a cancellation frees a seat, and the first person waiting takes it
    registered.remove("barbara")
    if let promoted = waitlist.first():
        waitlist.remove(0)
        registered.add(promoted)
        badges[promoted] = "attendee"
        print("{promoted} moves off the waitlist, {waitlist.len()} still waiting")

    arrivals := ["grace", "mallory", "ada", "ken", "grace", "dennis"]
    mut inside: List[String] := []
    for name in arrivals:
        if not registered.contains(name):
            print("  {name:<8} turned away, not registered")
            continue
        if inside.contains(name):
            print("  {name:<8} already inside")
            continue
        inside.push(name)
        print("  {name:<8} checked in as {badges.get(name).unwrap_or("attendee")}")

    print("")
    print_sorted("inside", inside)

    mut no_shows: List[String] := []
    for name in registered:
        if not inside.contains(name):
            no_shows.push(name)
    print_sorted("no-shows", no_shows)

    # the last arrival is the first to hear about the evening session
    inside.reverse()
    print("callback order: {inside.join(", ")}")

    speakers := badges.keys().filter(fn(name: String) => badges[name] == "speaker")
    print_sorted("speakers", speakers)
    print("badges printed: {badges.len()}, staff on site: {badges.values().contains("staff")}")

    # at close of day the desk hands everything back
    waitlist.clear()
    badges.clear()
    registered.clear()
    print("desk closed: {waitlist.is_empty() and badges.is_empty() and registered.is_empty()}")
