from ir_metadata import ir_is_known_returning_func
from ir_state import ir_borrow_param_exported, ir_borrow_param_local, ir_boxed_enums, ir_cas_return_fns_exported, ir_cas_return_fns_local, ir_counter_steps, ir_current_impl_type, ir_current_module_path, ir_func_result_ok_kinds, ir_global_slot_names, ir_import_mutable_global_symbols, ir_import_renames, ir_index_offset_targets, ir_index_offsets_scanned, ir_keeper_pass_cas, ir_loop_var_slot, ir_loop_var_slots, ir_module_count, ir_mutable_global_names, ir_optional_tuple_dtor_needed, ir_result_reg_blocked, ir_result_reg_funcs, ir_storage_keepers_exported, ir_storage_keepers_local, ir_struct_names, ir_tuple_borrow_walk_active, ir_tuple_walk_pair_callee, ir_tuple_walk_pair_returns, ir_tuple_walk_root, ir_var_regs, ir_var_types
