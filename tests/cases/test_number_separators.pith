# underscore digit separators are stripped from a numeric literal's value, so
# 1_000_000 is one million (not 0). covers decimal, hex, binary, and a float.

fn main():
    print((1_000_000).to_string())
    print((0xFF_FF).to_string())
    print((0b1010_0001).to_string())
    print((12_345.678).to_string())
