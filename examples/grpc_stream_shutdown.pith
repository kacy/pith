# a rolling deploy against a grpc server whose streams never end.
#
# a drain waits for work to finish. a server-streaming or bidi rpc that loops
# forever never finishes, so it would outlast any grace period and be cut off
# when the process exits. its peer would read a truncated body with no
# grpc-status, which looks the same as a crash.
#
# so the grace period is split in two. the first half belongs to the handlers:
# GrpcStream.closing() turns true when a drain starts, and a handler that checks
# it ends its stream with its own status. the second half belongs to the
# server: whatever is still open is finished with UNAVAILABLE, the connections
# are wound down, and the drain completes.
#
# this runs both kinds of handler over one connection, then sends itself a
# SIGTERM the way an orchestrator would:
#
#   /demo.Feed/Polite  checks closing() and finishes itself  -> ends OK
#   /demo.Feed/Naive   never checks                          -> ends UNAVAILABLE
#
# the naive handler is the shape people write by accident. it still ends
# cleanly, with a status its peer can read.

import std.bytes as bytes
import std.net.grpc as grpc
import std.shutdown as shutdown
import std.signal as signal
import std.time as time

PORT := 20263

# short enough to keep the example quick. a real deployment splits its grace
# period the same way.
GRACE_MS := 1200

TICK_MS := 25

fn tick(call: grpc.GrpcStream):
    call.send_message(bytes.from_string_utf8("tick"))
    time.delay(TICK_MS)

fn feed(path: String, call: grpc.GrpcStream) -> Int!grpc.GrpcError:
    match path:
        "/demo.Feed/Polite" =>
            # the pattern a long-lived handler should follow: check one flag
            # between messages and end the stream on its own terms.
            while not call.closing():
                tick(call)
            call.finish_ok()
            return 0
        "/demo.Feed/Naive" =>
            while true:
                tick(call)
            return 0
        _ =>
            fail grpc.GrpcError(grpc.GRPC_UNIMPLEMENTED, "no method {path}")

# serve until the drain completes. the result is how much work was left
# unfinished when it did.
fn run_server() -> Int:
    return grpc.serve_stream("127.0.0.1", PORT, feed) catch -1

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

# read a stream to its end and say how it ended. a deploy closing the stream and
# a dead socket are both UNAVAILABLE, so the message tells them apart.
fn how_it_ended(stream: grpc.ServerStream) -> String:
    while true:
        step := stream.recv()
        if step.is_err:
            return "{grpc.status_name(step.err.status)}, {step.err.message}"
        if step.ok.done:
            return "ended OK"
    return "ended OK"

fn open_feed(conn: grpc.Conn, path: String) -> grpc.ServerStream!:
    stream := conn.server_stream(path, bytes.empty()) catch:
        fail "could not open {path}"
    # read one tick, so neither stream ends merely because it never began
    stream.recv() catch:
        fail "{path} never started"
    return stream

fn main() -> Int!:
    shutdown.set_drain_deadline(GRACE_MS)
    shutdown.on_signals()!
    server := spawn run_server()
    conn := connect()!
    defer conn.close()

    polite := open_feed(conn, "/demo.Feed/Polite")!
    naive := open_feed(conn, "/demo.Feed/Naive")!
    print("both streams flowing")

    print("orchestrator: sending SIGTERM")
    signal.raise_self(signal.SIGTERM)
    print("polite: " + how_it_ended(polite))
    print("naive:  " + how_it_ended(naive))
    print("rpcs the server had to close: {grpc.streams_closed_by_shutdown()}")
    # 0 means every connection finished inside the grace period, even with the
    # naive handler still looping.
    print("unfinished work at the deadline: {await server}")
    return 0
