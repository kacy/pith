# ir_type_helpers.pith — translating between the two type vocabularies
#
# the checker names types with integer tids; emission picks runtime
# calls and ownership behavior from kind strings ("int", "string",
# "map_str_val", ...). the functions here answer one question in many
# forms: given a node, a tid, or a name, what kind is it?

from ast import get_node, Node
from checker import c_get_expr_type
from types import get_type_info, lookup_declared_type_id
from ir_metadata import ir_is_float_returning_func, ir_is_bool_returning_func, ir_is_int_returning_func, ir_is_string_returning_func, ir_is_bytes_returning_func, ir_is_list_returning_func, ir_is_list_string_returning_func, ir_is_string_returning_method

# turn a type name as it was written into an emission kind, taking the
# alias and struct tables explicitly so it works before global emitter
# state is populated (ir_resolve_type_hint is the wrapper that reads
# the globals). one alias hop is applied, not a transitive chain, and
# an "opaque:" tag is stripped first. a name that is neither builtin
# nor a known struct comes back unchanged, so this never returns "" —
# an unrecognised annotation is passed through, not reported.
# matching on the containers is by substring of the written text, so
# for a nested annotation the innermost match can win: prefer the
# node-based resolvers when you have the type node.
pub fn ir_resolve_type_hint_with_state(type_name: String, type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    mut resolved := type_name
    if type_aliases.contains_key(resolved):
        resolved = type_aliases[resolved]
    if resolved.starts_with("opaque:"):
        resolved = resolved.substring(7, resolved.len())
    if resolved == "String":
        return "string"
    if resolved == "Bytes":
        return "bytes"
    if resolved == "Bool":
        return "bool"
    if resolved == "Int":
        return "int"
    if resolved == "Float":
        return "float"
    if resolved.contains("List[String]"):
        return "list_string"
    if resolved.contains("List[") or resolved == "List":
        return "list"
    if resolved.contains("Map[Int,") or resolved.contains("Map[Int, "):
        return "map_int"
    if resolved.contains("Map[") or resolved == "Map":
        return "map"
    if resolved.contains("Set[Int]") or resolved.contains("Set[UInt]") or resolved.contains("Set[Int8]") or resolved.contains("Set[Int16]") or resolved.contains("Set[Int32]") or resolved.contains("Set[Int64]") or resolved.contains("Set[UInt8]") or resolved.contains("Set[UInt16]") or resolved.contains("Set[UInt32]") or resolved.contains("Set[UInt64]"):
        return "set_int"
    if resolved.contains("Set[") or resolved == "Set":
        return "set"
    if resolved.contains("Channel[") or resolved == "Channel":
        return "channel"
    if resolved.contains("Task[") or resolved == "Task":
        return "task"
    mut base := resolved
    if base.contains("["):
        base = base.substring(0, base.index_of("["))
    if struct_names.contains_key(base):
        return base
    return resolved

# the kind string to write into emitted IR for a declared return or
# field type. this is ir_resolve_type_hint_with_state plus the tagging
# the IR text wants: a struct becomes "struct:Name", the four sync
# primitives become "opaque:Name", and everything builtin stays as its
# bare kind. an empty type_name — a function declared with no return
# type — gives "unknown", never "". takes the tables explicitly;
# ir_retkind is the wrapper over global emitter state.
pub fn ir_retkind_with_state(type_name: String, type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    if type_name.len() == 0:
        return "unknown"
    resolved := ir_resolve_type_hint_with_state(type_name, type_aliases, struct_names)
    if resolved == "int":
        return "int"
    if resolved == "float":
        return "float"
    if resolved == "bool":
        return "bool"
    if resolved == "string":
        return "string"
    if resolved == "list":
        return "list"
    if resolved == "list_string":
        return "list_string"
    if resolved == "map":
        return "map"
    if resolved == "map_int":
        return "map_int"
    if resolved == "set_int":
        return "set_int"
    if resolved == "set":
        return "set"
    if resolved == "void":
        return "void"
    if resolved == "Mutex" or resolved == "WaitGroup" or resolved == "Semaphore" or resolved == "AtomicInt":
        return "opaque:" + resolved
    if struct_names.contains_key(resolved):
        return "struct:" + resolved
    # a struct reached only through another module's return type, one this
    # module never imports, is absent from the module's own map, which fills
    # in emission order. the checker's type table knows every struct. without
    # this the call line spelled the name bare, the contract check refused it,
    # and ir_rc_kind saw nothing to release: every such returned struct leaked
    # (#1057).
    tid := lookup_declared_type_id(resolved)
    if tid >= 0 and get_type_info(tid).kind == "struct":
        return "struct:" + resolved
    return resolved

# the kind of a `generic_type` annotation node, distinguishing the
# variants emission treats differently: List[String] from any other
# list, and an integer-keyed map or set from a boxed one. only the
# first type argument is inspected. returns "" for any other generic
# head — Channel, Task, a user generic — so callers fall back to
# resolving the head name as a plain type hint.
pub fn ir_resolve_generic_type_node(tn: Node) -> String:
    if tn.value == "List":
        if tn.children.len() > 0:
            first := get_node(tn.children[0])
            if first.kind == "type" and first.value == "String":
                return "list_string"
        return "list"
    if tn.value == "Map":
        if tn.children.len() > 0:
            first := get_node(tn.children[0])
            if first.kind == "type" and first.value == "Int":
                return "map_int"
        return "map"
    if tn.value == "Set":
        if tn.children.len() > 0:
            first := get_node(tn.children[0])
            if first.kind == "type" and first.value == "Int":
                return "set_int"
        return "set"
    return ""

# every `T!` lowers to the same tuple representation whatever its ok
# type is, so this always answers "tuple" and inner_type is ignored.
# it exists so the call sites that resolve a result annotation read as
# one shape, and so a representation that did vary by ok kind would
# have a single place to change.
pub fn ir_resolve_result_type_kind(inner_type: String) -> String:
    return "tuple"

# the bridge from the checker's type ids to emission kinds, and the
# authoritative one: unlike the name-based resolvers it sees through
# aliases and generic substitution because the checker already did.
# optionals and results both collapse to "tuple"; a function type is
# "closure"; a struct is its bare name. returns "" for a negative tid
# — the checker's "untyped" answer — and for a type it has no kind
# for, so a caller that needs a kind must have a fallback ready.
pub fn ir_type_from_tid(tid: Int) -> String:
    if tid < 0:
        return ""
    mut info := get_type_info(tid)
    if info.kind == "result":
        return "tuple"
    if info.kind == "optional":
        return "tuple"
    if info.kind == "primitive":
        if info.name == "Int" or info.name == "UInt" or info.name == "Int8" or info.name == "Int16" or info.name == "Int32" or info.name == "Int64" or info.name == "UInt8" or info.name == "UInt16" or info.name == "UInt32" or info.name == "UInt64":
            return "int"
        if info.name == "Float":
            return "float"
        if info.name == "Bool":
            return "bool"
        if info.name == "String":
            return "string"
        if info.name == "Bytes":
            return "bytes"
        return ""
    if info.kind == "list":
        elem_info := get_type_info(info.inner)
        if elem_info.kind == "primitive" and elem_info.name == "String":
            return "list_string"
        return "list"
    if info.kind == "map":
        key_info := get_type_info(info.key_type)
        if key_info.kind == "primitive" and (key_info.name == "Int" or key_info.name == "UInt" or key_info.name == "Int8" or key_info.name == "Int16" or key_info.name == "Int32" or key_info.name == "Int64" or key_info.name == "UInt8" or key_info.name == "UInt16" or key_info.name == "UInt32" or key_info.name == "UInt64"):
            return "map_int"
        return "map"
    if info.kind == "set":
        elem_info := get_type_info(info.inner)
        if elem_info.kind == "primitive" and (elem_info.name == "Int" or elem_info.name == "UInt" or elem_info.name == "Int8" or elem_info.name == "Int16" or elem_info.name == "Int32" or elem_info.name == "Int64" or elem_info.name == "UInt8" or elem_info.name == "UInt16" or elem_info.name == "UInt32" or elem_info.name == "UInt64"):
            return "set_int"
        return "set"
    if info.kind == "tuple":
        return "tuple"
    if info.kind == "enum":
        # a boxed enum (some variant carries a payload) is a heap allocation
        # that must be rc-tracked and released like a struct; a tag-only enum
        # is just an integer.
        mut vi := 0
        while vi < info.variant_types.len():
            if info.variant_types[vi].len() > 0:
                return info.name
            vi = vi + 1
        return "int"
    if info.kind == "struct":
        return info.name
    if info.kind == "channel":
        return "channel"
    if info.kind == "task":
        return "task"
    if info.kind == "function":
        return "closure"
    return ""

# the bytes-keyed flavor of a set or map expression: "set_bytes" for a
# `Set[Bytes]`, "map_bytes" for a `Map[Bytes, V]`, and obj_type unchanged
# for everything else. the flavor is a call-selection detail, not a kind:
# a bytes-keyed container is still tracked, retained and released as a
# "set" or a "map", exactly as an int-keyed one is. it is read off the
# checker's type at each operation that names a runtime entry point — a
# method call, an index, a literal, a `for` — because those are the only
# places where the string and bytes entry points differ, and the checked
# type is the one source that survives generic substitution. a receiver the
# checker left untyped keeps the string flavor, and the runtime refuses the
# mismatch loudly rather than reading a bytes handle as a c-string.
pub fn ir_bytes_keyed_type(expr_idx: Int, obj_type: String) -> String:
    if obj_type != "set" and obj_type != "map":
        return obj_type
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return obj_type
    info := get_type_info(tid)
    mut key_tid := 0 - 1
    if info.kind == "set":
        key_tid = info.inner
    elif info.kind == "map":
        key_tid = info.key_type
    if key_tid < 0:
        return obj_type
    key_info := get_type_info(key_tid)
    if key_info.kind == "primitive" and key_info.name == "Bytes":
        return obj_type + "_bytes"
    return obj_type

# the kind of the elements of the list expression at expr_idx. this is
# what picks the right list constructor and decides whether elements
# are rc-tracked, so a wrong answer here leaks or over-releases.
# returns "unknown" — not "" — when the checker did not type the
# expression or typed it as something other than a list.
pub fn ir_list_element_kind(expr_idx: Int) -> String:
    tid := c_get_expr_type(expr_idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "list":
            kind := ir_type_from_tid(info.inner)
            if kind.len() > 0:
                return kind
    return "unknown"

# the element type id of the list expression at expr_idx, or -1 when the
# checker did not type it as a list — which is what happens inside a
# generic body, where the checked types are suppressed. the emission kind
# above answers what an element IS; this answers which type it is, which is
# what an element comparison needs to compare it the way `==` would.
pub fn ir_list_element_tid(expr_idx: Int) -> Int:
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return 0 - 1
    info := get_type_info(tid)
    if info.kind != "list":
        return 0 - 1
    return info.inner

# the return kind of the function *value* at expr_idx — a lambda, a
# closure variable, an element of a list of functions. use it for a
# callee that is an expression rather than a name, where there is no
# declaration to look the return type up in. returns "unknown" when
# the checker did not type the expression as a function value; call
# sites substitute their own default ("int" for an indirect call).
pub fn ir_function_return_kind(expr_idx: Int) -> String:
    tid := c_get_expr_type(expr_idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "function":
            kind := ir_type_from_tid(info.return_type)
            if kind.len() > 0:
                return kind
    return "unknown"

# the emission kind the checker assigned to the expression at idx, or
# "" when it left it untyped. this is the first thing the emitter's
# type inference asks; the syntactic guesses below it only run when
# this comes back empty.
pub fn ir_checked_type(idx: Int) -> String:
    return ir_type_from_tid(c_get_expr_type(idx))

# "tuple" when the checker typed the expression at idx as a `T!`, and
# "" otherwise. the "" is the useful half: it is how a call site asks
# "is this actually a result?" before deciding to unpack it, so an
# untyped expression is treated as not-a-result rather than guessed at.
pub fn ir_checked_result_kind(idx: Int) -> String:
    tid := c_get_expr_type(idx)
    if tid < 0:
        return ""
    info := get_type_info(tid)
    if info.kind != "result":
        return ""
    return "tuple"

# the kind an index expression `coll[k]` yields, derived from the
# collection's own type rather than from the type recorded on the
# index node — the collection is typed even where the result of the
# indexing is not, so this answers in more cases. one optional or
# result wrapper on the collection is unwrapped first, so `maybe[k]`
# still finds the map underneath. falls back to the node's checked
# type when idx is not an index node or the collection is untyped, so
# a "" answer still means "no idea", as everywhere else here.
pub fn ir_checked_index_type(idx: Int) -> String:
    node := get_node(idx)
    if node.kind != "index" or node.children.len() == 0:
        return ir_checked_type(idx)
    coll_tid := c_get_expr_type(node.children[0])
    if coll_tid < 0:
        return ir_checked_type(idx)
    mut coll_info := get_type_info(coll_tid)
    if coll_info.kind == "optional" or coll_info.kind == "result":
        if coll_info.inner < 0:
            return ir_checked_type(idx)
        coll_info = get_type_info(coll_info.inner)
    if coll_info.kind == "map" and coll_info.value_type >= 0:
        return ir_type_from_tid(coll_info.value_type)
    if coll_info.kind == "list" and coll_info.inner >= 0:
        return ir_type_from_tid(coll_info.inner)
    return ir_checked_type(idx)

# the kind of a bare identifier, from the emitter's own bookkeeping
# rather than the checker: the current function's tracked locals
# first, then the per-kind lists of module globals. a local shadows a
# global of the same name, matching normal scoping. returns "" for a
# name that is tracked nowhere — a function name, a struct name, or an
# identifier the emitter never recorded a kind for. every table is
# passed in; ir_lookup_name_type is the wrapper over emitter globals.
pub fn ir_lookup_name_type_with_state(name: String, var_types: Map[String, String], global_int_names: List[String], global_string_names: List[String], global_list_string_names: List[String], global_list_names: List[String], global_map_int_names: List[String], global_map_names: List[String], global_set_int_names: List[String], global_set_names: List[String], global_bool_names: List[String]) -> String:
    if var_types.contains_key(name):
        return var_types[name]
    if global_int_names.contains(name):
        return "int"
    if global_string_names.contains(name):
        return "string"
    if global_list_string_names.contains(name):
        return "list_string"
    if global_list_names.contains(name):
        return "list"
    if global_map_int_names.contains(name):
        return "map_int"
    if global_map_names.contains(name):
        return "map"
    if global_set_int_names.contains(name):
        return "set_int"
    if global_set_names.contains(name):
        return "set"
    if global_bool_names.contains(name):
        return "bool"
    return ""

# the scalar kind a builtin or runtime function returns, from the
# static tables in ir_metadata. these functions have no pith
# declaration to read a return type off, so the tables are the only
# source. returns "" for anything not listed, including every
# user-declared function — the caller then falls through to the
# declared-callable lookup.
pub fn ir_known_scalar_return_type(fname: String) -> String:
    if ir_is_float_returning_func(fname):
        return "float"
    if ir_is_bool_returning_func(fname):
        return "bool"
    if ir_is_int_returning_func(fname):
        return "int"
    if ir_is_string_returning_func(fname):
        return "string"
    if ir_is_bytes_returning_func(fname):
        return "bytes"
    return ""

# the list kind a builtin or runtime function returns, separated from
# the scalar table because emission distinguishes a list of strings
# from any other list. returns "" for anything not listed, so callers
# ask this after ir_known_scalar_return_type and before falling back
# to a user declaration.
pub fn ir_known_collection_return_type(fname: String) -> String:
    if ir_is_list_returning_func(fname):
        return "list"
    if ir_is_list_string_returning_func(fname):
        return "list_string"
    return ""

# the return kind of a builtin method identified by its name alone,
# with no receiver type needed because these names mean the same thing
# on every receiver. despite the name it also covers the methods that
# yield a list of strings — keys, values, split, chars — since those
# are decided by the method name too. returns "" when the name is not
# one of them, which is the signal to consult the receiver's type.
pub fn ir_known_string_method_return_type(meth: String) -> String:
    if ir_is_string_returning_method(meth) or meth == "to_string_utf8":
        return "string"
    if meth == "keys" or meth == "values" or meth == "split" or meth == "chars":
        return "list_string"
    return ""

# the return kind of the builtin methods whose answer depends on what
# they are called on: channel and task operations, and the list
# methods that keep or lose the element kind (`slice` and `sort` of a
# list_string stay list_string). obj_type is an emission kind and may
# carry an element suffix, so both "list" and "list:Foo" are accepted.
# returns "" when the pair is not one of these, leaving the caller to
# keep looking.
pub fn ir_known_collection_method_return_type(obj_type: String, meth: String) -> String:
    if obj_type == "channel" or obj_type.starts_with("channel:"):
        if meth == "recv":
            return "tuple"
        if meth == "try_recv":
            return "tuple"
        if meth == "len" or meth == "cap":
            return "int"
        if meth == "send" or meth == "try_send" or meth == "close" or meth == "is_closed":
            return "bool"
    if (obj_type == "task" or obj_type.starts_with("task:")) and meth == "is_done":
        return "bool"
    if meth == "index_of" and (obj_type == "list" or obj_type == "list_string" or obj_type.starts_with("list:")):
        return "int"
    if meth == "slice" or meth == "sort":
        if obj_type == "list_string":
            return "list_string"
        if obj_type == "list" or obj_type.starts_with("list:"):
            return "list"
    return ""

# the kind of a literal, from its node kind. `kind` is passed
# separately from `node` because callers sometimes assert the shape
# themselves — a set literal is emitted through this with kind "set"
# regardless of how the node was tagged. a collection literal's
# element kind is taken from its *first* element only, so a list whose
# head is a string is list_string; an empty one falls back to the
# untyped container kind. returns "" when the node is not a literal.
pub fn ir_literal_expr_type(node: Node, kind: String) -> String:
    if kind == "int_lit" or kind == "int" or kind == "integer":
        return "int"
    if kind == "float_lit" or kind == "float":
        return "float"
    if kind == "bool_lit" or kind == "bool":
        return "bool"
    if kind == "string_lit" or kind == "string" or kind == "str_lit" or kind == "string_interp":
        return "string"
    if kind == "list":
        if node.children.len() > 0:
            first := get_node(node.children[0])
            if first.kind == "string_lit" or first.kind == "string":
                return "list_string"
        return "list"
    if kind == "map":
        return "map"
    if kind == "set":
        if node.children.len() > 0:
            first := get_node(node.children[0])
            if first.kind == "int_lit" or first.kind == "int" or first.kind == "integer":
                return "set_int"
        return "set"
    if kind == "tuple":
        return "tuple"
    return ""

# the kind of a unary expression: "bool" for a logical not, "int" for
# everything else. it does not look at the operand, so a negated float
# is answered "int" — this is a last-resort guess that only runs after
# the checker has already declined to type the expression, and it
# never returns "" the way the other helpers here do.
pub fn ir_unary_expr_type(node: Node) -> String:
    if node.value == "not" or node.value == "!" or node.value == "not_op":
        return "bool"
    return "int"
