fn main() -> Int!:
    strk: Map[String, Int] := {"zero": 0, "five": 5}
    print("zero_present:" + (strk.get("zero") != none).to_string())
    print("zero_value:" + strk.get("zero").unwrap_or(-1).to_string())
    print("five_value:" + strk.get("five").unwrap_or(-1).to_string())
    print("missing_none:" + (strk.get("nope") == none).to_string())
    print("missing_default:" + strk.get("nope").unwrap_or(-1).to_string())

    intk: Map[Int, Int] := {10: 0, 20: 42}
    print("int_zero_present:" + (intk.get(10) != none).to_string())
    print("int_zero_value:" + intk.get(10).unwrap_or(-1).to_string())
    print("int_42_value:" + intk.get(20).unwrap_or(-1).to_string())
    print("int_missing_none:" + (intk.get(99) == none).to_string())
    return 0
