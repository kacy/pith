# wildcard imports: `from module import *` brings in every public name.
#
# checks which ladder reaches which window. the formulas use a handful of
# math functions, and a wildcard import keeps them as short as they are on
# paper. a wildcard hides where each name comes from, so keep it for a
# module whose names are familiar and few, and name the imports elsewhere.

from std.math import *

struct Ladder:
    name: String
    length_m: Float

# the height a ladder reaches with its foot this far from the wall
fn reach(ladder: Ladder, foot_m: Float) -> Float:
    return sqrt(pow(ladder.length_m, 2.0) - pow(foot_m, 2.0))

fn main():
    ladders := [Ladder(name: "step", length_m: 2.5), Ladder(name: "extension", length_m: 6.0)]
    windows := [2.1, 4.8, 5.9]

    # a safe ladder stands about a quarter of its length out from the wall
    for ladder in ladders:
        foot := ladder.length_m / 4.0
        height := reach(ladder, foot)
        mut reachable: List[String] := []
        for window in windows:
            if height >= window:
                reachable.push("{window:.1} m")
        print("{ladder.name:<9} reaches {height:.2} m, windows: {reachable.len()} ({reachable.join(", ")})")

    # standing it steeper gains height, at some cost in safety
    steep := reach(ladders[1], 1.0)
    print("extension with its foot at 1.0 m reaches {steep:.2} m, top window: {steep >= windows[2]}")
