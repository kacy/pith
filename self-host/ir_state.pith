# ===========================================================================
# Tier 3 — Per-function & transient expression state
# ===========================================================================

## current function variable name -> last emitted IR register.
pub mut ir_var_regs: Map[String, Int] := {}
## current function variable name -> emission kind string.
pub mut ir_var_types: Map[String, String] := {}
## current function's emitted return kind.
pub mut ir_current_func_return_kind := ""
## inner kind of the current function's `T?` return type, or "".
pub mut ir_current_func_optional_inner_kind := ""
## true when the current function returns a Result (`T!` or `T!E`).
pub mut ir_current_func_returns_result := false
## true when index/key/.value() misses propagate as String errors.
pub mut ir_current_func_miss_fails := false
## true when the current function uses the two-register result ABI (ret2).
pub mut ir_result_abi_pair_return := false
## true when the last emitted instruction terminated the current block with ret.
pub mut ir_last_was_ret := false
## true while emitting the user `main` function body.
pub mut ir_emitting_main_body := false
## name of the function currently being emitted (for ARC diagnostics/tracing).
pub mut ir_current_arc_func := ""

## current function map variable name -> value emission kind.
pub mut ir_map_value_types: Map[String, String] := {}
## current function closure parameter name -> declared return kind.
pub mut ir_closure_return_kinds: Map[String, String] := {}
## non-mut locals bound once to a lambda -> lambda symbol (devirtualization).
pub mut ir_local_lambda_targets: Map[String, String] := {}
## symbol of the most recently emitted lambda literal.
pub mut ir_last_lambda_symbol := ""

## RC-tracked locals owned by the current function, in prologue order.
pub mut ir_rc_locals: List[String] := []
## RC kinds parallel to ir_rc_locals.
pub mut ir_rc_local_kinds: List[String] := []
## names the RC prologue could not track under a single kind.
pub mut ir_untracked_rc_binds: List[String] := []
## subset of ir_untracked_rc_binds tracked dynamically via a tag side slot.
pub mut ir_kinded_rc_binds: List[String] := []
## locals that own a spawned task handle detached on rebind/exit.
pub mut ir_task_owner_locals: List[String] := []
## lambda capture names while the lambda's RC prologue runs.
pub mut ir_rc_prologue_captures: List[String] := []
## closure locals eligible for stack allocation.
pub mut ir_stack_closure_names: List[String] := []
## transient request from bind/call to allocate the next lambda on the stack.
pub mut ir_lambda_on_stack := false
## transient companion to ir_lambda_on_stack when captures are borrowed across a call.
pub mut ir_lambda_borrows_captures := false
## closure parameter bindings active in the current generic specialization.
pub mut ir_active_fn_bindings: Map[String, String] := {}
## lambda argument register -> lambda symbol for generic specialization binding.
pub mut ir_fn_arg_lambda_symbols: Map[Int, String] := {}
## registers holding stack-allocated closures (must not be released).
pub mut ir_stack_closure_regs: List[Int] := []

## tuple/result local name -> producing expression tid.
pub mut ir_tuple_local_tid: Map[String, Int] := {}
## tuple/result locals safe to cascade-release at scope exit.
pub mut ir_tuple_cascade_names: List[String] := []
## cascade-eligible result locals allocated in stack slots.
pub mut ir_stack_tuple_names: List[String] := []
## call node index whose pair result should materialize into a stack box.
pub mut ir_stack_box_call_idx := 0 - 1
## set true when the stack-box call actually built a stack box.
pub mut ir_stack_box_built := false
## every local name bound inside the current function body.
pub mut ir_func_local_names: Set[String] := {}
## captured weak binding names inside the current lambda body.
pub mut ir_weak_capture_names: List[String] := []
## getter call node whose owned receiver was already released by the getter.
pub mut ir_getter_consumed_idx := 0 - 1

## in-flight owned registers held across sub-expressions (released on early exit).
pub mut ir_inflight_regs: List[Int] := []
## RC kinds (or "result:TID") parallel to ir_inflight_regs.
pub mut ir_inflight_kinds: List[String] := []

## enclosing loop break target labels, innermost last.
pub mut ir_break_stack: List[String] := []
## enclosing loop continue target labels, innermost last.
pub mut ir_continue_stack: List[String] := []
## active `for` loop variable name -> private loop slot name (or "").
pub mut ir_loop_var_slots: Map[String, String] := {}
## active `for` loop owned iterable variable names.
pub mut ir_loop_iter_vars: List[String] := []
## RC kinds parallel to ir_loop_iter_vars.
pub mut ir_loop_iter_kinds: List[String] := []

## flat stack of deferred statement AST node indices in scope.
pub mut ir_defer_nodes: List[Int] := []
## parallel stack marking each defer as errdefer (1) or plain defer (0).
pub mut ir_defer_is_err: List[Int] := []
## loop-variable slot snapshot in force where each defer was registered.
pub mut ir_defer_loop_slots: List[Map[String, String]] := []
## block-scope start offsets into ir_defer_nodes.
pub mut ir_defer_scope_starts: List[Int] := []
## loop-entry base offsets into ir_defer_nodes.
pub mut ir_defer_loop_base_stack: List[Int] := []
## upper bound on defer indices while emitting a defer body (-1 = uncapped).
pub mut ir_defer_emit_limit := 0 - 1

## loop counter step nodes proven not to overflow.
pub mut ir_counter_steps: Map[Int, Bool] := {}
## true while emitting unchecked integer arithmetic.
pub mut ir_plain_int_arith := false
## true while emitting exact non-wrapping counter arithmetic (`addnsw`).
pub mut ir_exact_int_arith := false
## register holding the caught error inside a `catch err:` block.
pub mut ir_caught_error_reg := 0
## true when the active `select` expression lands owned arm values.
pub mut ir_select_takes_counts := false

## register-pair rcall handshake state.
pub mut ir_rcall_defer_idx := 0 - 1
## current call node index in rcall evaluation.
pub mut ir_rcall_current_idx := 0 - 1
## true when the deferred rcall delivered a live (flag, val) pair.
pub mut ir_rcall_pair_ready := false
## flag register from the deferred rcall.
pub mut ir_rcall_flag_reg := 0
## value register from the deferred rcall.
pub mut ir_rcall_val_reg := 0

## checked tid of the active match subject (-1 outside match).
pub mut ir_match_subject_tid := 0 - 1
## pending match subject pin slot name (consumed when match starts).
pub mut ir_match_pin_slot := ""
## RC kind parallel to ir_match_pin_slot.
pub mut ir_match_pin_slot_kind := ""
## AST node index of the current function's implicit tail match, or -1.
pub mut ir_tail_match_node := 0 - 1

## global kinds seeded at function entry, used to filter `mark kind` lines.
pub mut ir_count_marks_seeded: Map[String, String] := {}
## registers collected for the most recent decode call's arguments.
pub mut ir_decode_last_args: List[Int] := []
## held decoded field registers released on a subsequent field failure.
pub mut ir_decode_partial_regs: List[Int] := []
## RC kinds parallel to ir_decode_partial_regs.
pub mut ir_decode_partial_kinds: List[String] := []
## floor index in ir_decode_partial_regs for the active struct decode.
pub mut ir_decode_partial_floor := 0

# ===========================================================================
# Atomic nested-function frame snapshot (lambdas, spawn wrappers, fn-values)
# ===========================================================================

## complete snapshot of every per-function and transient expression variable,
## captured by ir_enter_nested_func and restored by ir_leave_nested_func.
pub struct IrFuncFrame:
    pub builder: IrBuilderSnapshot
    pub var_regs: Map[String, Int]
    pub var_types: Map[String, String]
    pub current_func_return_kind: String
    pub current_func_optional_inner_kind: String
    pub current_func_returns_result: Bool
    pub current_func_miss_fails: Bool
    pub result_abi_pair_return: Bool
    pub last_was_ret: Bool
    pub emitting_main_body: Bool
    pub current_arc_func: String
    pub map_value_types: Map[String, String]
    pub closure_return_kinds: Map[String, String]
    pub local_lambda_targets: Map[String, String]
    pub rc_locals: List[String]
    pub rc_local_kinds: List[String]
    pub untracked_rc_binds: List[String]
    pub kinded_rc_binds: List[String]
    pub task_owner_locals: List[String]
    pub rc_prologue_captures: List[String]
    pub stack_closure_names: List[String]
    pub active_fn_bindings: Map[String, String]
    pub fn_arg_lambda_symbols: Map[Int, String]
    pub stack_closure_regs: List[Int]
    pub tuple_local_tid: Map[String, Int]
    pub tuple_cascade_names: List[String]
    pub stack_tuple_names: List[String]
    pub stack_box_call_idx: Int
    pub stack_box_built: Bool
    pub func_local_names: Set[String]
    pub weak_capture_names: List[String]
    pub getter_consumed_idx: Int
    pub inflight_regs: List[Int]
    pub inflight_kinds: List[String]
    pub break_stack: List[String]
    pub continue_stack: List[String]
    pub loop_var_slots: Map[String, String]
    pub loop_iter_vars: List[String]
    pub loop_iter_kinds: List[String]
    pub defer_nodes: List[Int]
    pub defer_is_err: List[Int]
    pub defer_loop_slots: List[Map[String, String]]
    pub defer_scope_starts: List[Int]
    pub defer_loop_base_stack: List[Int]
    pub defer_emit_limit: Int
    pub counter_steps: Map[Int, Bool]
    pub plain_int_arith: Bool
    pub exact_int_arith: Bool
    pub caught_error_reg: Int
    pub select_takes_counts: Bool
    pub rcall_defer_idx: Int
    pub rcall_current_idx: Int
    pub rcall_pair_ready: Bool
    pub rcall_flag_reg: Int
    pub rcall_val_reg: Int
    pub match_subject_tid: Int
    pub match_pin_slot: String
    pub match_pin_slot_kind: String
    pub tail_match_node: Int
    pub count_marks_seeded: Map[String, String]
    pub decode_partial_regs: List[Int]
    pub decode_partial_kinds: List[String]
    pub decode_partial_floor: Int

## save the entire active function frame and initialize a clean nested frame
## (for a lambda body, spawn wrapper, or named function-value wrapper).
pub fn ir_enter_nested_func() -> IrFuncFrame:
    saved := IrFuncFrame(
        ir_builder_snapshot(),
        ir_var_regs,
        ir_var_types,
        ir_current_func_return_kind,
        ir_current_func_optional_inner_kind,
        ir_current_func_returns_result,
        ir_current_func_miss_fails,
        ir_result_abi_pair_return,
        ir_last_was_ret,
        ir_emitting_main_body,
        ir_current_arc_func,
        ir_map_value_types,
        ir_closure_return_kinds,
        ir_local_lambda_targets,
        ir_rc_locals,
        ir_rc_local_kinds,
        ir_untracked_rc_binds,
        ir_kinded_rc_binds,
        ir_task_owner_locals,
        ir_rc_prologue_captures,
        ir_stack_closure_names,
        ir_active_fn_bindings,
        ir_fn_arg_lambda_symbols,
        ir_stack_closure_regs,
        ir_tuple_local_tid,
        ir_tuple_cascade_names,
        ir_stack_tuple_names,
        ir_stack_box_call_idx,
        ir_stack_box_built,
        ir_func_local_names,
        ir_weak_capture_names,
        ir_getter_consumed_idx,
        ir_inflight_regs,
        ir_inflight_kinds,
        ir_break_stack,
        ir_continue_stack,
        ir_loop_var_slots,
        ir_loop_iter_vars,
        ir_loop_iter_kinds,
        ir_defer_nodes,
        ir_defer_is_err,
        ir_defer_loop_slots,
        ir_defer_scope_starts,
        ir_defer_loop_base_stack,
        ir_defer_emit_limit,
        ir_counter_steps,
        ir_plain_int_arith,
        ir_exact_int_arith,
        ir_caught_error_reg,
        ir_select_takes_counts,
        ir_rcall_defer_idx,
        ir_rcall_current_idx,
        ir_rcall_pair_ready,
        ir_rcall_flag_reg,
        ir_rcall_val_reg,
        ir_match_subject_tid,
        ir_match_pin_slot,
        ir_match_pin_slot_kind,
        ir_tail_match_node,
        ir_count_marks_seeded,
        ir_decode_partial_regs,
        ir_decode_partial_kinds,
        ir_decode_partial_floor
    )
    ir_builder_reset_function()
    ir_var_regs = {}
    ir_var_types = {}
    ir_current_func_return_kind = ""
    ir_current_func_optional_inner_kind = ""
    ir_current_func_returns_result = false
    ir_current_func_miss_fails = false
    ir_result_abi_pair_return = false
    ir_last_was_ret = false
    ir_emitting_main_body = false
    ir_current_arc_func = ""
    ir_map_value_types = {}
    ir_closure_return_kinds = {}
    ir_local_lambda_targets = {}
    ir_rc_locals = []
    ir_rc_local_kinds = []
    ir_untracked_rc_binds = []
    ir_kinded_rc_binds = []
    ir_task_owner_locals = []
    ir_rc_prologue_captures = []
    ir_stack_closure_names = []
    ir_active_fn_bindings = {}
    ir_fn_arg_lambda_symbols = {}
    ir_stack_closure_regs = []
    ir_tuple_local_tid = {}
    ir_tuple_cascade_names = []
    ir_stack_tuple_names = []
    ir_stack_box_call_idx = 0 - 1
    ir_stack_box_built = false
    ir_func_local_names = {}
    ir_weak_capture_names = []
    ir_getter_consumed_idx = 0 - 1
    ir_inflight_regs = []
    ir_inflight_kinds = []
    ir_break_stack = []
    ir_continue_stack = []
    ir_loop_var_slots = {}
    ir_loop_iter_vars = []
    ir_loop_iter_kinds = []
    ir_defer_nodes = []
    ir_defer_is_err = []
    ir_defer_loop_slots = []
    ir_defer_scope_starts = []
    ir_defer_loop_base_stack = []
    ir_defer_emit_limit = 0 - 1
    ir_counter_steps = {}
    ir_plain_int_arith = false
    ir_exact_int_arith = false
    ir_caught_error_reg = 0
    ir_select_takes_counts = false
    ir_rcall_defer_idx = 0 - 1
    ir_rcall_current_idx = 0 - 1
    ir_rcall_pair_ready = false
    ir_rcall_flag_reg = 0
    ir_rcall_val_reg = 0
    ir_match_subject_tid = 0 - 1
    ir_match_pin_slot = ""
    ir_match_pin_slot_kind = ""
    ir_tail_match_node = 0 - 1
    ir_count_marks_seeded = {}
    ir_decode_partial_regs = []
    ir_decode_partial_kinds = []
    ir_decode_partial_floor = 0
    return saved

## flush the nested function's emitted lines into ir_lambda_bodies and restore
## the enclosing function's complete IrFuncFrame.
pub fn ir_leave_nested_func(saved: IrFuncFrame):
    ir_append_deferred_lambda_body()
    ir_builder_restore(saved.builder)
    ir_var_regs = saved.var_regs
    ir_var_types = saved.var_types
    ir_current_func_return_kind = saved.current_func_return_kind
    ir_current_func_optional_inner_kind = saved.current_func_optional_inner_kind
    ir_current_func_returns_result = saved.current_func_returns_result
    ir_current_func_miss_fails = saved.current_func_miss_fails
    ir_result_abi_pair_return = saved.result_abi_pair_return
    ir_last_was_ret = saved.last_was_ret
    ir_emitting_main_body = saved.emitting_main_body
    ir_current_arc_func = saved.current_arc_func
    ir_map_value_types = saved.map_value_types
    ir_closure_return_kinds = saved.closure_return_kinds
    ir_local_lambda_targets = saved.local_lambda_targets
    ir_rc_locals = saved.rc_locals
    ir_rc_local_kinds = saved.rc_local_kinds
    ir_untracked_rc_binds = saved.untracked_rc_binds
    ir_kinded_rc_binds = saved.kinded_rc_binds
    ir_task_owner_locals = saved.task_owner_locals
    ir_rc_prologue_captures = saved.rc_prologue_captures
    ir_stack_closure_names = saved.stack_closure_names
    ir_active_fn_bindings = saved.active_fn_bindings
    ir_fn_arg_lambda_symbols = saved.fn_arg_lambda_symbols
    ir_stack_closure_regs = saved.stack_closure_regs
    ir_tuple_local_tid = saved.tuple_local_tid
    ir_tuple_cascade_names = saved.tuple_cascade_names
    ir_stack_tuple_names = saved.stack_tuple_names
    ir_stack_box_call_idx = saved.stack_box_call_idx
    ir_stack_box_built = saved.stack_box_built
    ir_func_local_names = saved.func_local_names
    ir_weak_capture_names = saved.weak_capture_names
    ir_getter_consumed_idx = saved.getter_consumed_idx
    ir_inflight_regs = saved.inflight_regs
    ir_inflight_kinds = saved.inflight_kinds
    ir_break_stack = saved.break_stack
    ir_continue_stack = saved.continue_stack
    ir_loop_var_slots = saved.loop_var_slots
    ir_loop_iter_vars = saved.loop_iter_vars
    ir_loop_iter_kinds = saved.loop_iter_kinds
    ir_defer_nodes = saved.defer_nodes
    ir_defer_is_err = saved.defer_is_err
    ir_defer_loop_slots = saved.defer_loop_slots
    ir_defer_scope_starts = saved.defer_scope_starts
    ir_defer_loop_base_stack = saved.defer_loop_base_stack
    ir_defer_emit_limit = saved.defer_emit_limit
    ir_counter_steps = saved.counter_steps
    ir_plain_int_arith = saved.plain_int_arith
    ir_exact_int_arith = saved.exact_int_arith
    ir_caught_error_reg = saved.caught_error_reg
    ir_select_takes_counts = saved.select_takes_counts
    ir_rcall_defer_idx = saved.rcall_defer_idx
    ir_rcall_current_idx = saved.rcall_current_idx
    ir_rcall_pair_ready = saved.rcall_pair_ready
    ir_rcall_flag_reg = saved.rcall_flag_reg
    ir_rcall_val_reg = saved.rcall_val_reg
    ir_match_subject_tid = saved.match_subject_tid
    ir_match_pin_slot = saved.match_pin_slot
    ir_match_pin_slot_kind = saved.match_pin_slot_kind
    ir_tail_match_node = saved.tail_match_node
    ir_count_marks_seeded = saved.count_marks_seeded
    ir_decode_partial_regs = saved.decode_partial_regs
    ir_decode_partial_kinds = saved.decode_partial_kinds
    ir_decode_partial_floor = saved.decode_partial_floor

# ===========================================================================
# Module & function lifecycle helpers
# ===========================================================================

## append the current builder buffer into ir_lambda_bodies.
pub fn ir_append_deferred_lambda_body():
    lines := ir_builder_lines()
    mut bodies: List[String] := ir_lambda_bodies
    for line in lines:
        bodies.push(line)
    ir_lambda_bodies = bodies

## file a global under its name regardless of type so assignments recognize it.
pub fn ir_record_global_slot(name: String):
    ir_global_slot_names = ir_push_string(ir_global_slot_names, name)

## file a global under its emission kind for per-function type seeding and O(1) lookup.
pub fn ir_record_global_type(name: String, global_type: String):
    if global_type == "int" or global_type == "string" or global_type == "list_string" or global_type == "list" or global_type == "map_int" or global_type == "map" or global_type == "set" or global_type == "set_int" or global_type == "bool":
        ir_global_kinds.insert(name, global_type)

## seed the current function's variable and map-value type maps from module globals.
pub fn ir_seed_global_types():
    for name in ir_global_kinds.keys():
        ir_var_types.insert(name, ir_global_kinds[name])
    for name in ir_global_map_value_types.keys():
        ir_map_value_types.insert(name, ir_global_map_value_types[name])

## clear cached ir_struct_needs_dtor answers when the struct registry resets.
pub fn ir_reset_dtor_memo():
    ir_dtor_memo = {}

## declare whether the current function returns the two-register result pair.
pub fn ir_set_pair_return(active: Bool):
    ir_result_abi_pair_return = active

## reset all per-module state at emit_ir entry, preserving Tier 1 build config.
pub fn ir_reset_module_state():
    ir_builder_reset()
    ir_builder_set_string_module_count(ir_module_count)
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds = {}
    ir_local_lambda_targets = {}
    ir_map_value_types = {}
    ir_global_kinds = {}
    ir_global_map_value_types = {}
    ir_global_slot_names = []
    ir_mutable_global_names = {}
    ir_local_struct_names = []
    ir_reset_dtor_memo()
    ir_tracer_memo = {}
    ir_tuple_dtor_sigs = []
    ir_interface_coercion_bypass = {}
    ir_optional_tuple_dtor_needed = false
    ir_tuple_cascade_sigs = []
    ir_tuple_stack_cascade_sigs = []
    ir_kinded_release_used = false
    ir_result_arg_release_sigs = []
    ir_result_unshare_sigs = []
    ir_struct_names = {}
    ir_struct_field_lookup = {}
    ir_struct_field_index_lookup = {}
    ir_struct_decl_nodes = {}
    ir_struct_drop_symbols = {}
    ir_struct_field_default_nodes = {}
    ir_impl_methods = {}
    ir_impl_method_owner = {}
    ir_import_renames = {}
    ir_func_returns = {}
    ir_func_result_ok_kinds = {}
    ir_result_reg_funcs = {}
    ir_result_reg_blocked = {}
    ir_interface_adapters = {}
    ir_rcall_defer_idx = 0 - 1
    ir_rcall_current_idx = 0 - 1
    ir_rcall_pair_ready = false
    ir_named_fn_value_wrappers = {}
    ir_module_aliases = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    ir_import_mutable_global_symbols = {}
    ir_current_func_return_kind = ""
    ir_current_func_optional_inner_kind = ""
    ir_current_func_returns_result = false
    ir_current_func_miss_fails = false
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}
    ir_generic_method_owners = {}
    ir_generic_method_owner_param_counts = {}
    ir_generic_specialization_keys = []
    ir_generic_specialization_names = {}
    ir_generic_specialization_type_lists = {}
    ir_generic_emitted_specializations = {}
    ir_generic_specialization_subst_tids = {}
    ir_generic_specialization_by_symbol = {}
    ir_active_generic_params = []
    ir_active_generic_concrete_types = []
    ir_active_generic_module_path = ""
    ir_break_stack = []
    ir_continue_stack = []

## reset per-function state at the start of emitting a top-level function or method.
pub fn ir_reset_func_frame(ret_type: String):
    ir_builder_reset_registers()
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds = {}
    ir_local_lambda_targets = {}
    ir_map_value_types = {}
    ir_rc_locals = []
    ir_rc_local_kinds = []
    ir_untracked_rc_binds = []
    ir_kinded_rc_binds = []
    ir_task_owner_locals = []
    ir_tuple_local_tid = {}
    ir_tuple_cascade_names = []
    ir_stack_tuple_names = []
    ir_func_local_names = {}
    ir_defer_nodes = []
    ir_defer_is_err = []
    ir_defer_loop_slots = []
    ir_defer_scope_starts = []
    ir_defer_loop_base_stack = []
    ir_defer_emit_limit = 0 - 1
    ir_loop_iter_vars = []
    ir_loop_iter_kinds = []
    ir_loop_var_slots = {}
    ir_seed_global_types()
    if ir_count_marks:
        ir_count_marks_seeded = {}
        for name in ir_var_types.keys():
            ir_count_marks_seeded.insert(name, ir_var_types[name])
    ir_current_func_return_kind = ret_type
    ir_set_pair_return(ret_type == "result_reg")
    ir_current_func_optional_inner_kind = ""

## reset import metadata maps before collecting preloaded roots.
pub fn ir_reset_import_metadata():
    ir_import_renames = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    ir_import_mutable_global_symbols = {}

## reset phase-one callable, alias, and generic declaration registries.
pub fn ir_reset_phase_one_metadata():
    ir_func_returns = {}
    ir_type_aliases = {}
    ir_type_alias_nodes = {}
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}
    ir_generic_method_owners = {}
    ir_generic_method_owner_param_counts = {}

## reset phase-two struct, impl, interface, and drop registries.
pub fn ir_reset_phase_two_metadata():
    ir_local_struct_names = []
    ir_reset_dtor_memo()
    ir_tracer_memo = {}
    ir_struct_names = {}
    ir_struct_field_lookup = {}
    ir_struct_field_index_lookup = {}
    ir_struct_decl_nodes = {}
    ir_struct_drop_symbols = {}
    ir_impl_methods = {}
    ir_impl_method_owner = {}
    ir_interface_decl_index = {}
    ir_assoc_bindings = {}
    ir_type_assoc_names = {}

## reset per-module generic instance destructor maps before emitting bodies.
pub fn ir_reset_generic_dtor_maps():
    ir_generic_enum_dtor_base = {}
    ir_generic_enum_dtor_kinds = {}
    ir_generic_struct_dtor_base = {}
    ir_generic_struct_dtor_kinds = {}
    ir_generic_struct_dtor_drop = {}

## advance module ordinal and consume per-module driver flags at emit_ir exit.
pub fn ir_finish_module_emit():
    ir_module_count = ir_module_count + 1
    ir_preloaded_import_roots = []
    ir_preloaded_import_paths = []
    ir_emit_tests = false
    ir_emitting_test_func = false

# ===========================================================================
# Small scoped-state helpers (in-flight pins, loop slots, defers, decode, match)
# ===========================================================================

## push an owned in-flight register onto the early-exit release stack.
pub fn ir_inflight_push(r: Int, kind: String):
    ir_inflight_regs.push(r)
    ir_inflight_kinds.push(kind)

## remove register `r` from the in-flight release stack.
pub fn ir_inflight_drop(r: Int):
    mut i := ir_inflight_regs.len() - 1
    while i >= 0:
        if ir_inflight_regs[i] == r:
            ir_inflight_regs.remove(i)
            ir_inflight_kinds.remove(i)
            return
        i = i - 1

## pop the top entry from the in-flight release stack.
pub fn ir_inflight_pop():
    ir_inflight_regs.remove(ir_inflight_regs.len() - 1)
    ir_inflight_kinds.remove(ir_inflight_kinds.len() - 1)

## return the private `for`-loop slot for `name`, or "" if not shadowed by a loop.
pub fn ir_loop_var_slot(name: String) -> String:
    if ir_loop_var_slots.contains_key(name):
        return ir_loop_var_slots[name]
    return ""

## bind `name` to a loop variable slot and return the previous mapping.
pub fn ir_loop_var_push(name: String, slot: String) -> String:
    if name.len() == 0:
        return ""
    previous := ir_loop_var_slot(name)
    ir_loop_var_slots.insert(name, slot)
    return previous

## restore `name`'s previous loop variable slot mapping.
pub fn ir_loop_var_pop(name: String, previous: String):
    if name.len() > 0:
        ir_loop_var_slots.insert(name, previous)

## the local name a return/fail expression transfers ownership from, or "".
pub fn ir_returned_local_name(node: Node) -> String:
    if node.kind != "ident" or ir_loop_var_slot(node.value).len() > 0:
        return ""
    return node.value

## the private slot name allocated for one `for` loop variable.
pub fn ir_loop_var_slot_name(fid: Int, name: String) -> String:
    return "__loopvar_" + fid.to_string() + "_" + name

## record a block-scope start on the defer stack.
pub fn ir_defer_push_scope():
    ir_defer_scope_starts.push(ir_defer_nodes.len())

## register one `defer` (is_err=0) or `errdefer` (is_err=1) statement on the active scope stack.
pub fn ir_defer_register(stmt_idx: Int, is_err: Int):
    ir_defer_nodes.push(stmt_idx)
    ir_defer_is_err.push(is_err)
    mut snap: Map[String, String] := {}
    for k in ir_loop_var_slots.keys():
        snap.insert(k, ir_loop_var_slots[k])
    ir_defer_loop_slots.push(snap)

## record loop-entry defer depth so break/continue only emit loop-local defers.
pub fn ir_defer_loop_enter():
    ir_defer_loop_base_stack.push(ir_defer_nodes.len())

## pop the loop-entry defer depth mark at loop exit.
pub fn ir_defer_loop_exit():
    n := ir_defer_loop_base_stack.len()
    if n > 0:
        ir_defer_loop_base_stack.remove(n - 1)

## hold a decoded field register until its owning struct is allocated.
pub fn ir_decode_partial_push(r: Int, kind: String):
    if kind.len() == 0:
        return
    ir_decode_partial_regs.push(r)
    ir_decode_partial_kinds.push(kind)

## begin holding decoded field values for one struct decode; return previous floor.
pub fn ir_decode_partial_begin() -> Int:
    saved := ir_decode_partial_floor
    ir_decode_partial_floor = ir_decode_partial_regs.len()
    return saved

## commit held decoded values into their struct and restore the outer floor.
pub fn ir_decode_partial_end(saved: Int):
    while ir_decode_partial_regs.len() > ir_decode_partial_floor:
        ir_decode_partial_regs.remove(ir_decode_partial_regs.len() - 1)
        ir_decode_partial_kinds.remove(ir_decode_partial_kinds.len() - 1)
    ir_decode_partial_floor = saved

## ask the next match expression to pin its subject in `slot` under RC `kind`.
pub fn ir_set_match_pin(slot: String, kind: String):
    ir_match_pin_slot = slot
    ir_match_pin_slot_kind = kind

## enter a nested match scope with `subject_tid`, returning the saved outer tid.
pub fn ir_match_enter(subject_tid: Int) -> Int:
    saved := ir_match_subject_tid
    ir_match_subject_tid = subject_tid
    return saved

## restore the outer match subject tid when leaving a match expression/return.
pub fn ir_match_leave(saved_tid: Int):
    ir_match_subject_tid = saved_tid
