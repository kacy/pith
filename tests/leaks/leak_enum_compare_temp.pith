# comparing an enum value with a variant written in place builds a box for
# the comparison, and the structural equality never released it.
import leakprobe as probe

enum Wrap:
    Plain
    Tagged(String, Int)

fn check(w: Wrap) -> Int:
    mut n := 0
    if w == Wrap.Plain:
        n = n + 1
    if w != Wrap.Tagged("k", 9):
        n = n + 2
    return n

fn main():
    n := probe.rounds()
    a := Wrap.Tagged("k", 9)
    mut i := 0
    mut c := 0
    while i < n:
        c = c + check(a) + check(Wrap.Plain)
        i = i + 1
    if c == 0 - 1:
        print("impossible")
    kb := probe.peak_kb()
    print("{kb}")
