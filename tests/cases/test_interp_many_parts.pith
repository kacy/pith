# a string join of 256 or more parts must not read its part count as Int
# flags: `"{a}x"` repeated 128 times printed a heap address for the first
# part of every runtime call. the cases cross 127/128/255/256 parts with
# Int, String, Float and format spec parts, plain `+` chains, self appends
# and an interpolation passed straight to a call.

# the expected join, one part at a time: parts alternate a piece from
# `pieces` and a literal "x"
fn expected(n: Int, pieces: List[String]) -> String:
    mut out := ""
    mut i := 0
    mut k := 0
    while i < n:
        if i % 2 == 0:
            out = out + pieces[k % pieces.len()]
            k = k + 1
        else:
            out = out + "x"
        i = i + 1
    return out

fn check(name: String, got: String, want: String):
    if got == want:
        print(name + " ok " + got.len().to_string() + " " + got.substring(0, 12))
    else:
        print(name + " MISMATCH " + got.substring(0, 40))

fn passthrough(s: String) -> String:
    return s

fn main():
    a := 1
    s := "s"
    f := 2.5
    ai := "{a}"
    fi := "{f}"
    spec_a := "{a:>5}"
    spec_s := "{s:<3}"
    spec_f := "{f:.2}"
    print("spec pieces [" + spec_a + "] [" + spec_s + "] [" + spec_f + "]")
    check("int 127", "{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}", expected(127, [ai]))
    check("str 127", "{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}", expected(127, [s]))
    check("float 127", "{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}", expected(127, [fi]))
    check("spec 127", "{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}", expected(127, [spec_a, spec_s, spec_f]))
    check("mixed 127", "{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}", expected(127, [ai, s, fi, "2", ai]))
    check("int 128", "{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x", expected(128, [ai]))
    check("str 128", "{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x{s}x", expected(128, [s]))
    check("float 128", "{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x{f}x", expected(128, [fi]))
    check("spec 128", "{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x{s:<3}x{f:.2}x{a:>5}x", expected(128, [spec_a, spec_s, spec_f]))
    check("mixed 128", "{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x{[a, a][1]}x{a}x{s}x{f}x{a + 1}x", expected(128, [ai, s, fi, "2", ai]))
    check("int 255", "{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}x{a}", expected(255, [ai]))
