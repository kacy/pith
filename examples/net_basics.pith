# a port checker: name resolution and connection attempts with std.net.
#
# it resolves a host name, then tries to connect to a few ports and reports
# which accept a connection. a refused connection is an ordinary result here,
# so each attempt is caught and reported rather than ending the program.
#
# the address localhost resolves to depends on the machine (127.0.0.1 or ::1),
# so the Makefile does not compare this example's output.

import std.net.dns as dns
import std.net.tcp as tcp

OPEN_PORT := 18438
CLOSED_PORT := 18439

fn probe(host: String, port: Int) -> String:
    fd := tcp.connect(host, port) catch:
        return "closed"
    tcp.close(fd)
    return "open"

fn main() -> Int!:
    address := dns.resolve("localhost") catch "unresolved"
    print("localhost resolves to {address}")

    # something to find: a listener on one port and nothing on the next.
    listener := tcp.listen("127.0.0.1", OPEN_PORT)!
    defer tcp.close(listener)
    for port in [OPEN_PORT, CLOSED_PORT]:
        print("127.0.0.1:{port} is {probe("127.0.0.1", port)}")
    return 0
