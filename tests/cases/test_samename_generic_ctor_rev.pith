# the same shape as test_samename_generic_ctor with the imports reversed:
# which module registered the base name Box last must not matter, so both
# orders print the same golden output.
import clash_gbox_b as b
import clash_gbox_a as a

fn main():
    ai := a.Box(5, 7)
    bi := b.Box("lbl", 5, 7)
    print(ai.tag().to_string())
    print(bi.tag().to_string())
    print(ai.only_a())
    print(bi.only_b())
    print(ai.get().to_string())
    print(bi.get().to_string())
    astr := a.Box(6, "seven")
    bstr := b.Box("tag", 6, "eight")
    print(astr.tag().to_string())
    print(bstr.tag().to_string())
    print(astr.get())
    print(bstr.get())
