# exercise the generated encode/decode in a loop so protogen-check can run it
# under valgrind. it should allocate and free cleanly, like std.protobuf.
from sample_gen import Point, Shape, encode_Shape, decode_Shape
from sample_gen import Sticker, encode_Sticker, decode_Sticker, Sticker_anchor, Sticker_stock
import std.bytes as bytes

fn main():
    mut i := 0
    while i < 200:
        s := Shape(name: "square", id: 42, filled: true, color: 1, center: Point(x: 1, y: 2), vertices: [Point(x: 3, y: 4), Point(x: 5, y: 6)], tags: [10, 20, 30], labels: ["a", "b"], blob: bytes.from_string_utf8("xy"), area: 2.5, offset: 0 - 3)
        back := decode_Shape(encode_Shape(s)) catch s
        st := Sticker(name: "dot", design: Sticker_anchor(Point(x: 7, y: 8)), backing: Sticker_stock(3))
        stback := decode_Sticker(encode_Sticker(st)) catch st
        i = i + back.id - 41 + stback.name.len() - 3
    print("ran encode/decode 200 times")
