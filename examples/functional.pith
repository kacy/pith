# functional list methods: map, filter and reduce, chained.
#
# answers a few questions about a day of orders. each answer is one chain
# that reads top to bottom: pick the orders that matter, turn each into the
# number wanted, and fold the numbers into a result. none of the chains
# changes the order list.

import std.fmt as fmt

struct Order:
    customer: String
    cents: Int
    paid: Bool

fn main():
    orders := [
        Order(customer: "ada", cents: 4200, paid: true),
        Order(customer: "grace", cents: 1500, paid: false),
        Order(customer: "ada", cents: 800, paid: true),
        Order(customer: "linus", cents: 12000, paid: true),
        Order(customer: "grace", cents: 3300, paid: true),
    ]

    paid := orders.filter(fn(order: Order) => order.paid)
    revenue := paid.map(fn(order: Order) => order.cents).reduce(0, fn(sum: Int, cents: Int) => sum + cents)
    print("paid orders: {paid.len()} of {orders.len()}, revenue {revenue}")

    large := orders.filter(fn(order: Order) => order.cents >= 3000).map(fn(order: Order) => order.customer)
    print("large orders from: {fmt.join_strings(large, ", ")}")

    unpaid := orders.filter(fn(order: Order) => not order.paid).reduce(0, fn(sum: Int, order: Order) => sum + order.cents)
    print("still owed: {unpaid}")

    # reduce can build any value, here a map of totals per customer
    by_customer := paid.reduce({}, fn(totals: Map[String, Int], order: Order) -> Map[String, Int]:
        totals[order.customer] = totals.get(order.customer).unwrap_or(0) + order.cents
        return totals
    )
    for customer in ["ada", "grace", "linus"]:
        print("{customer:<6} {by_customer.get(customer).unwrap_or(0):>6}")

    sizes := orders.map(fn(order: Order) => order.cents / 100)
    print("order sizes in whole units: {fmt.ints(sizes)}")
