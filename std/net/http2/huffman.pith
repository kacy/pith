# std.net.http2.huffman — the canonical HPACK Huffman coding (RFC 7541 App B).
#
# hpack may compress a header string with a fixed Huffman code. the code is a
# complete prefix code over the 256 byte values plus a 30-bit end-of-string
# symbol (256). encoding packs each symbol's bits most-significant-first and
# pads the final byte with the EOS prefix (all ones). decoding walks the bit
# stream, emitting a symbol as soon as the accumulated bits match a codeword.

import std.bytes as bytes
import std.bits as bits
import std.encoding as encoding

# one code table entry: the codeword value and its length in bits.
struct HuffEntry:
    code: Int
    length: Int

# the largest codeword length in the table (the EOS symbol).
MAX_CODE_LENGTH := 30
# the end-of-string symbol; it must never appear whole in valid input.
EOS_SYMBOL := 256

# the fixed RFC 7541 Appendix B table, indexed by symbol (0..255, EOS at 256).
fn huff_table() -> List[HuffEntry]:
    return [
        HuffEntry(0x1ff8, 13),
        HuffEntry(0x7fffd8, 23),
