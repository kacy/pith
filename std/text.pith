# std.text - unicode-correct text handling over utf-8 strings
#
# a pith String is a sequence of utf-8 bytes. `s.len()` and `s[i]` are byte
# operations, and `s.substring(a, b)` slices bytes. that is the right default
# for a server language -- it keeps indexing O(1) and avoids paying for
# grapheme bookkeeping on every string -- but it means byte offsets and
# character offsets stop agreeing as soon as the text leaves ascii.
#
# this module is the character-aware layer over those bytes. it does not
# change how a String is stored; it adds the operations byte offsets cannot
# express: counting characters, slicing on character boundaries, validating
# utf-8, and truncating without cutting a character in half.
#
# there is no locale here, on purpose. anything that depends on the reader's
# language -- message catalogs, plural rules, number and date formatting --
# belongs in std.intl, which builds on this module. std.text never depends on
# std.intl.
#
# ## what "character" means here
#
# these functions count unicode scalar values, the same unit Go's `for range`
# and Rust's `chars()` use. that is not always what a reader would call a
# character: "e" followed by a combining acute accent is two scalar values but
# one mark on screen. for text a person will read -- a display name, a chat
# message -- prefer the grapheme functions, which group those together.
#
# ## limitation: a String cannot hold U+0000
#
# pith Strings are null-terminated, so the null character has no
# representation. `encode(0)` fails rather than handing back a string that
# would silently measure as empty.
#
# ## which parts of unicode are implemented
#
# unicode is large, and most of it does not earn its weight in a server
# runtime. this module implements the parts that text handling is wrong
# without:
#
# - simple case folding, for caseless comparison
# - NFC normalization, so text that looks identical compares identical
#
# and deliberately does not implement:
#
# - full and special case mapping. "ß" does not become "SS", and the turkish
#   dotted/dotless i keeps its unicode-default behaviour rather than a
#   locale-specific one. both are locale decisions; see std.intl.
# - NFD, NFKC and NFKD. NFC is the form to store and compare. the compatibility
#   forms discard information -- they flatten a fullwidth letter and its ascii
#   form into the same string -- which is the wrong default for text you keep.
# - word and sentence segmentation, and bidirectional text.
#
# the unicode version the tables were built from is recorded in
# `unicode_version()` and in the header of every generated table.

import std.text.tables as tables
import std.text.case_tables as case_tables
import std.text.norm_tables as norm_tables

# the unicode release the generated tables were built from.
pub fn unicode_version() -> String:
    return "15.1.0"

# a decoded character and the number of bytes it occupied.
pub struct Decoded:
    pub code_point: Int
    pub size: Int

# the largest valid unicode scalar value, U+10FFFF.
pub fn max_code_point() -> Int:
    return 1114111

# the replacement character, U+FFFD, which stands in for undecodable bytes.
pub fn replacement_char() -> String:
    return "�"

# the code point reported for a byte that no valid utf-8 sequence explains.
# it is negative so it can never collide with a real scalar value.
pub fn invalid_code_point() -> Int:
    return -1

# ---------------------------------------------------------------------------
# byte classification
# ---------------------------------------------------------------------------

# read one byte as an unsigned 0-255 value. `ord(s[i])` compiles to a direct
# byte read; the mask keeps the result unsigned no matter how a bare `ord` on
# a signed char would widen it.
fn raw_byte(s: String, i: Int) -> Int:
    return bit_and(ord(s[i]), 255)

# return true when a byte is a utf-8 continuation byte (10xxxxxx). a
# continuation byte can never start a character, so an index pointing at one
# is inside a character rather than at its edge.
pub fn is_continuation_byte(b: Int) -> Bool:
    return b >= 128 and b < 192

# return how many bytes the character starting with this byte occupies, or 0
# when the byte cannot start a character at all.
pub fn sequence_length(b: Int) -> Int:
    if b < 128:
        return 1
    if b < 194:
        # 0x80-0xBF are continuations, and 0xC0/0xC1 could only ever encode an
        # overlong form of an ascii character.
        return 0
    if b < 224:
        return 2
    if b < 240:
        return 3
    if b < 245:
        return 4
    return 0

# ---------------------------------------------------------------------------
# decoding
# ---------------------------------------------------------------------------

# decode the character starting at a byte offset. returns none when the offset
# is out of range or the bytes there are not well-formed utf-8. overlong
# encodings, surrogates and values above U+10FFFF are all rejected: those are
# the shapes that let two decoders disagree about what a string says, which is
# how a validation check gets bypassed.
pub fn decode_at(s: String, byte_index: Int) -> Decoded?:
    if byte_index < 0 or byte_index >= s.len():
        return none

    lead := raw_byte(s, byte_index)
    size := sequence_length(lead)
    if size == 0:
        return none
    if byte_index + size > s.len():
        return none
    if size == 1:
        return Decoded(lead, 1)

    mut code_point := 0
    if size == 2:
        code_point = bit_and(lead, 31)
    elif size == 3:
        code_point = bit_and(lead, 15)
    else:
        code_point = bit_and(lead, 7)

    mut offset := 1
    while offset < size:
        continuation := raw_byte(s, byte_index + offset)
        if not is_continuation_byte(continuation):
            return none
        code_point = (code_point * 64) + bit_and(continuation, 63)
        offset = offset + 1

    # reject sequences that are structurally well-formed but say something no
    # conforming encoder would have written.
    if size == 3 and code_point < 2048:
        return none
    if size == 4 and code_point < 65536:
        return none
    if code_point >= 55296 and code_point <= 57343:
        return none
    if code_point > 1114111:
        return none

    return Decoded(code_point, size)

# decode at an offset, or report a one-byte step with a negative code point
# when the bytes are undecodable. every walk in this module goes through this,
# so a malformed string still advances one byte at a time instead of stalling.
fn decode_step(s: String, byte_index: Int) -> Decoded:
    return decode_at(s, byte_index).unwrap_or(Decoded(-1, 1))

# encode one unicode scalar value as utf-8. fails on surrogates, on values
# above U+10FFFF, and on U+0000, which a null-terminated String cannot carry.
pub fn encode(code_point: Int) -> String!:
    if code_point == 0:
        fail "cannot encode U+0000: a pith String is null-terminated"
    if code_point < 0 or code_point > 1114111:
        fail "code point out of range: {code_point}"
    if code_point >= 55296 and code_point <= 57343:
        fail "cannot encode a surrogate code point: {code_point}"

    if code_point < 128:
        return chr(code_point)
    if code_point < 2048:
        return chr(192 + (code_point / 64)) + chr(128 + (code_point % 64))
    if code_point < 65536:
        return chr(224 + (code_point / 4096)) + chr(128 + ((code_point / 64) % 64)) + chr(128 + (code_point % 64))
    return chr(240 + (code_point / 262144)) + chr(128 + ((code_point / 4096) % 64)) + chr(128 + ((code_point / 64) % 64)) + chr(128 + (code_point % 64))

# ---------------------------------------------------------------------------
# validation
# ---------------------------------------------------------------------------

# return the byte offset of the first byte that is not part of a well-formed
# utf-8 sequence, or -1 when the whole string is valid.
pub fn find_invalid(s: String) -> Int:
    mut position := 0
    while position < s.len():
        step := decode_step(s, position)
        if step.code_point < 0:
            return position
        position = position + step.size
    return -1

# return true when the string is well-formed utf-8.
pub fn is_valid(s: String) -> Bool:
    return find_invalid(s) == -1

# ---------------------------------------------------------------------------
# boundaries
# ---------------------------------------------------------------------------

# return true when a byte offset sits on the edge of a character. both ends of
# the string count as boundaries.
pub fn is_boundary(s: String, byte_index: Int) -> Bool:
    if byte_index < 0 or byte_index > s.len():
        return false
    if byte_index == 0 or byte_index == s.len():
        return true
    return not is_continuation_byte(raw_byte(s, byte_index))

# round a byte offset down to the start of the character containing it.
pub fn floor_boundary(s: String, byte_index: Int) -> Int:
    if byte_index <= 0:
        return 0
    mut position := byte_index
    if position > s.len():
        position = s.len()
    mut scanning := true
    while scanning:
        if position <= 0:
            scanning = false
        elif is_continuation_byte(raw_byte(s, position)):
            position = position - 1
        else:
            scanning = false
    return position

# round a byte offset up to the start of the next character, or to the end of
# the string.
pub fn ceil_boundary(s: String, byte_index: Int) -> Int:
    if byte_index >= s.len():
        return s.len()
    mut position := byte_index
    if position < 0:
        position = 0
    mut scanning := true
    while scanning:
        if position >= s.len():
            scanning = false
        elif is_continuation_byte(raw_byte(s, position)):
            position = position + 1
        else:
            scanning = false
    return position

# ---------------------------------------------------------------------------
# counting and iteration
# ---------------------------------------------------------------------------

# count the characters in a string. an undecodable byte counts as one, so this
# never disagrees with `chars()` about how many pieces the string has.
pub fn char_count(s: String) -> Int:
    mut total := 0
    mut position := 0
    while position < s.len():
        position = position + decode_step(s, position).size
        total = total + 1
    return total

# split a string into its characters. an undecodable byte becomes a one-byte
# piece of its own rather than being dropped or folded into its neighbour.
pub fn chars(s: String) -> List[String]:
    mut out: List[String] := []
    mut position := 0
    while position < s.len():
        size := decode_step(s, position).size
        out.push(s.substring(position, position + size))
        position = position + size
    return out

# the code points of a string, in order. an undecodable byte yields -1, so the
# result stays index-aligned with `chars()`.
pub fn code_points(s: String) -> List[Int]:
    mut out: List[Int] := []
    mut position := 0
    while position < s.len():
        step := decode_step(s, position)
        out.push(step.code_point)
        position = position + step.size
    return out

# the byte offset at which each character starts.
pub fn char_offsets(s: String) -> List[Int]:
    mut out: List[Int] := []
    mut position := 0
    while position < s.len():
        out.push(position)
        position = position + decode_step(s, position).size
    return out

# join characters back into one string.
pub fn from_chars(parts: List[String]) -> String:
    # join in one pass: appending each character to the result string
    # recopied everything accumulated so far, which made rebuilding a string
    # from its characters quadratic in the input.
    mut collected: List[String] := []
    for part in parts:
        collected.push(part)
    return collected.join("")

# build a string from code points. fails on any value `encode` rejects.
pub fn from_code_points(points: List[Int]) -> String!:
    # collect the encoded characters and join once at the end: appending each
    # one to the result string recopied everything accumulated so far, which
    # made building from code points quadratic in the input.
    mut parts: List[String] := []
    for point in points:
        parts.push(encode(point)!)
    return parts.join("")

# ---------------------------------------------------------------------------
# character-indexed access
# ---------------------------------------------------------------------------

# the byte offset where a character index begins. an index at or past the end
# returns the string length, so the result is always usable as a slice bound.
pub fn byte_offset_of(s: String, char_index: Int) -> Int:
    if char_index <= 0:
        return 0
    mut position := 0
    mut seen := 0
    while position < s.len() and seen < char_index:
        position = position + decode_step(s, position).size
        seen = seen + 1
    return position

# the character at a character index, or none when the index is out of range.
# this walks the string, so it costs O(n) in the index. that is the honest
# price of character indexing over utf-8, and the reason byte indexing stays
# the default -- reach for `chars()` when you need every character anyway.
pub fn char_at(s: String, char_index: Int) -> String?:
    if char_index < 0:
        return none
    start := byte_offset_of(s, char_index)
    if start >= s.len():
        return none
    return s.substring(start, start + decode_step(s, start).size)

# slice by character index rather than byte index. out-of-range bounds clamp,
# matching how `substring` treats byte bounds.
pub fn slice(s: String, start_char: Int, end_char: Int) -> String:
    if end_char <= start_char:
        return ""
    start_byte := byte_offset_of(s, start_char)
    end_byte := byte_offset_of(s, end_char)
    if end_byte <= start_byte:
        return ""
    return s.substring(start_byte, end_byte)

# ---------------------------------------------------------------------------
# truncation
# ---------------------------------------------------------------------------

# keep at most `max_chars` characters. this is the safe replacement for
# `s.substring(0, n)` wherever n was meant as a count of characters.
pub fn truncate(s: String, max_chars: Int) -> String:
    if max_chars <= 0:
        return ""
    return slice(s, 0, max_chars)

# keep at most `max_bytes` bytes, backing off to a character boundary rather
# than splitting a character. reach for this when the limit comes from storage
# -- a database column, a header size, a log field.
pub fn truncate_bytes(s: String, max_bytes: Int) -> String:
    if max_bytes <= 0:
        return ""
    if max_bytes >= s.len():
        return s
    return s.substring(0, floor_boundary(s, max_bytes))

# truncate to `max_chars` characters and mark the cut, so a reader can tell
# the text was shortened. the suffix counts against the limit.
pub fn truncate_with(s: String, max_chars: Int, suffix: String) -> String:
    if char_count(s) <= max_chars:
        return s
    suffix_chars := char_count(suffix)
    if max_chars <= suffix_chars:
        return truncate(suffix, max_chars)
    return truncate(s, max_chars - suffix_chars) + suffix

# ---------------------------------------------------------------------------
# repair
# ---------------------------------------------------------------------------

# replace every undecodable byte with U+FFFD so the result is always valid
# utf-8. use this at the edge where bytes you did not produce become text you
# are going to store, log or render. one bad byte becomes one replacement
# character; this does not implement the standard's "maximal subpart"
# grouping, which would collapse a truncated multi-byte sequence into a single
# replacement instead of one per byte.
pub fn sanitize(s: String) -> String:
    if is_valid(s):
        return s
    # collect the pieces and join once at the end: appending each character
    # to the result string recopied everything accumulated so far, which
    # made repair quadratic in the input.
    mut parts: List[String] := []
    mut position := 0
    while position < s.len():
        step := decode_step(s, position)
        if step.code_point < 0:
            parts.push(replacement_char())
        else:
            parts.push(s.substring(position, position + step.size))
        position = position + step.size
    return parts.join("")

# ---------------------------------------------------------------------------
# case folding
# ---------------------------------------------------------------------------

# fold one code point for caseless comparison.
#
# folding is not lowercasing. lowercasing produces text for a reader; folding
# produces a key for comparison, and the two genuinely differ. greek final
# sigma is the clearest case: "ς" lowercases to itself but folds to "σ", so
# "ΣΣ" and "σς" compare equal folded and unequal lowercased.
pub fn fold_code_point(code_point: Int) -> Int:
    if code_point < 128:
        if code_point >= 65 and code_point <= 90:
            return code_point + 32
        return code_point

    run := tables.find_containing(case_tables.FOLD_RUNS, 4, case_tables.fold_runs_count(), code_point)
    if run < 0:
        return code_point

    start := tables.field(case_tables.FOLD_RUNS, run, 0, 4)
    count := tables.field(case_tables.FOLD_RUNS, run, 1, 4)
    stride := tables.field(case_tables.FOLD_RUNS, run, 2, 4)
    offset := code_point - start
    if offset > ((count - 1) * stride):
        return code_point
    if (offset % stride) != 0:
        return code_point
    return code_point + (tables.field(case_tables.FOLD_RUNS, run, 3, 4) - 2097152)

# fold a string for caseless comparison.
#
# this is the function to reach for when you are comparing rather than
# displaying: usernames, email local parts, header names, routing keys, tags.
# `to_lower` is ascii-only and does nothing to "Ä" or "Σ", so a caseless
# comparison written with it silently stops working on the first non-english
# input. use `fold` there and keep `to_lower` for text a person will read.
#
# this is simple folding: every character folds to exactly one character, and
# the result has the same character count as the input. "ß" therefore folds to
# itself rather than to "ss", so `fold("straße") != fold("STRASSE")`. full
# folding would close that gap, at the cost of a mapping that changes length;
# see the module header.
pub fn fold(s: String) -> String:
    # collect the folded characters and join once at the end: appending each
    # one to the result string recopied everything accumulated so far, which
    # made folding quadratic in the input.
    mut parts: List[String] := []
    mut position := 0
    while position < s.len():
        step := decode_step(s, position)
        if step.code_point < 0:
            parts.push(replacement_char())
        else:
            folded := fold_code_point(step.code_point)
            if folded == step.code_point:
                parts.push(s.substring(position, position + step.size))
            else:
                parts.push(encode(folded).unwrap_or(replacement_char()))
        position = position + step.size
    return parts.join("")

# compare two strings ignoring case, the whole way up unicode rather than just
# through ascii.
pub fn eq_fold(a: String, b: String) -> Bool:
    return fold(a) == fold(b)

# compare two strings ignoring both case and composition differences. this is
# the strictest sameness test here, and the right one for an identifier a user
# typed: it treats "é" and "e" plus a combining acute as the same, and "Ä" and
# "ä" as the same.
pub fn eq_fold_normalized(a: String, b: String) -> Bool:
    return fold(normalize(a)) == fold(normalize(b))

# ---------------------------------------------------------------------------
# normalization (NFC)
# ---------------------------------------------------------------------------
#
# the same text can be spelled more than one way: "é" is either one code point
# or an "e" followed by a combining acute accent. they render identically and
# a user cannot tell them apart, but they are different bytes, so they hash
# differently, compare unequal, and land in a database as two distinct rows.
#
# NFC picks one spelling -- the composed one -- so equal-looking text is equal
# bytes. normalize at the edge, when text arrives, and store the result.

fn hangul_syllable_base() -> Int:
    return 44032

fn hangul_lead_base() -> Int:
    return 4352

fn hangul_vowel_base() -> Int:
    return 4449

fn hangul_trail_base() -> Int:
    return 4519

# hangul syllables decompose and recompose by arithmetic rather than by table
# lookup: there are 11172 of them and the standard defines the mapping as a
# formula, so none of them appear in the generated tables.
fn decompose_hangul(code_point: Int, out: List[Int]) -> Bool:
    index := code_point - hangul_syllable_base()
    if index < 0 or index >= 11172:
        return false
    out.push(hangul_lead_base() + (index / 588))
    out.push(hangul_vowel_base() + ((index % 588) / 28))
    trail := index % 28
    if trail != 0:
        out.push(hangul_trail_base() + trail)
    return true

fn compose_hangul(first: Int, second: Int) -> Int:
    lead := first - hangul_lead_base()
    if lead >= 0 and lead < 19:
        vowel := second - hangul_vowel_base()
        if vowel >= 0 and vowel < 21:
            return hangul_syllable_base() + (((lead * 21) + vowel) * 28)

    syllable := first - hangul_syllable_base()
    if syllable >= 0 and syllable < 11172 and (syllable % 28) == 0:
        trail := second - hangul_trail_base()
        if trail > 0 and trail < 28:
            return first + trail
    return -1

# the canonical combining class of a code point. 0 means a starter, which is
# any character that a following mark attaches to.
pub fn combining_class(code_point: Int) -> Int:
    run := tables.find_containing(norm_tables.CCC_RUNS, 3, norm_tables.ccc_runs_count(), code_point)
    if run < 0:
        return 0
    start := tables.field(norm_tables.CCC_RUNS, run, 0, 3)
    count := tables.field(norm_tables.CCC_RUNS, run, 1, 3)
    if (code_point - start) >= count:
        return 0
    return tables.field(norm_tables.CCC_RUNS, run, 2, 3)

# expand a code point to its full canonical decomposition. decompositions
# nest -- a character can decompose to another that decomposes further -- so
# this recurses until it reaches characters that do not decompose.
fn decompose_into(code_point: Int, out: List[Int]):
    if decompose_hangul(code_point, out):
        return

    record := tables.find(norm_tables.DECOMPOSITIONS, 3, norm_tables.decompositions_count(), code_point)
    if record < 0:
        out.push(code_point)
        return

    decompose_into(tables.field(norm_tables.DECOMPOSITIONS, record, 1, 3), out)
    second := tables.field(norm_tables.DECOMPOSITIONS, record, 2, 3)
    if second != 0:
        decompose_into(second, out)

# put combining marks into canonical order.
#
# marks that attach to the same base in different ways have different
# combining classes, and the standard fixes an order for them so that two
# spellings of the same text agree. only adjacent marks with different
# non-zero classes may swap, which makes this a stable sort -- and since runs
# of marks are almost always one or two long, an insertion pass is the right
# shape.
fn canonical_order(points: List[Int]):
    mut index := 1
    while index < points.len():
        current := points[index]
        current_class := combining_class(current)
        if current_class != 0:
            mut at := index
            mut moving := true
            while moving:
                if at <= 0:
                    moving = false
                else:
                    previous_class := combining_class(points[at - 1])
                    if previous_class == 0 or previous_class <= current_class:
                        moving = false
                    else:
                        points[at] = points[at - 1]
                        at = at - 1
            points[at] = current
        index = index + 1

# the code point that this pair composes to, or -1 when the pair does not
# compose.
fn compose_pair(first: Int, second: Int) -> Int:
    hangul := compose_hangul(first, second)
    if hangul >= 0:
        return hangul
    record := tables.find_pair(norm_tables.COMPOSITIONS, 3, norm_tables.compositions_count(), first, second)
    if record < 0:
        return -1
    return tables.field(norm_tables.COMPOSITIONS, record, 2, 3)

# recombine a decomposed, canonically ordered sequence.
#
# a mark composes onto the last starter before it unless something blocks it:
# an intervening mark of the same or higher combining class means the mark
# belongs to that one, not to the starter.
fn compose_all(points: List[Int]) -> List[Int]:
    mut out: List[Int] := []
    if points.len() == 0:
        return out

    out.push(points[0])
    mut starter := -1
    if combining_class(points[0]) == 0:
        starter = 0
    mut previous_class := combining_class(points[0])

    mut index := 1
    while index < points.len():
        current := points[index]
        current_class := combining_class(current)

        mut composed := -1
        if starter >= 0 and (previous_class == 0 or previous_class < current_class):
            composed = compose_pair(out[starter], current)

        if composed >= 0:
            out[starter] = composed
        else:
            out.push(current)
            if current_class == 0:
                starter = out.len() - 1
            previous_class = current_class
        index = index + 1
    return out

# return true when every byte is ascii. ascii is already normalized and folds
# without a table, so both paths can skip their work entirely.
fn is_ascii(s: String) -> Bool:
    mut position := 0
    while position < s.len():
        if raw_byte(s, position) >= 128:
            return false
        position = position + 1
    return true

# normalize to NFC, the composed form.
#
# this is what to apply to text as it arrives -- a form field, a header, a
# message -- so that everything downstream compares, hashes and stores
# consistently. undecodable bytes become U+FFFD, since normalizing something
# that is not text has no meaning.
pub fn normalize(s: String) -> String:
    if is_ascii(s):
        return s

    mut expanded: List[Int] := []
    mut position := 0
    while position < s.len():
        step := decode_step(s, position)
        if step.code_point < 0:
            expanded.push(65533)
        else:
            decompose_into(step.code_point, expanded)
        position = position + step.size

    canonical_order(expanded)
    return from_code_points(compose_all(expanded)).unwrap_or(s)

# return true when the string is already in NFC, without building the
# normalized form to find out.
pub fn is_normalized(s: String) -> Bool:
    return normalize(s) == s

# ---------------------------------------------------------------------------
# tests
# ---------------------------------------------------------------------------

fn cp_at(s: String, i: Int) -> Int:
    return decode_at(s, i).unwrap_or(Decoded(-1, 0)).code_point

fn size_at(s: String, i: Int) -> Int:
    return decode_at(s, i).unwrap_or(Decoded(-1, 0)).size

test "an indexed byte reads back unsigned":
    # the emitter turns `ord(s[i])` into a direct byte read. this pins that it
    # yields 0-255 rather than a sign-extended value, which every decode here
    # depends on.
    s := "Ä"
    assert_eq(raw_byte(s, 0), 195)
    assert_eq(raw_byte(s, 1), 132)

test "decodes each utf-8 sequence length":
    assert_eq(cp_at("A", 0), 65)
    assert_eq(size_at("A", 0), 1)
    assert_eq(cp_at("Ä", 0), 196)
    assert_eq(size_at("Ä", 0), 2)
    assert_eq(cp_at("€", 0), 8364)
    assert_eq(size_at("€", 0), 3)
    assert_eq(cp_at("𝄞", 0), 119070)
    assert_eq(size_at("𝄞", 0), 4)

test "rejects every malformed utf-8 shape":
    # lone continuation byte
    assert(decode_at(chr(128), 0) == none)
    # truncated two-byte sequence
    assert(decode_at(chr(195), 0) == none)
    # truncated three-byte sequence
    assert(decode_at(chr(226) + chr(130), 0) == none)
    # second byte is not a continuation
    assert(decode_at(chr(195) + "A", 0) == none)
    # overlong two-byte encoding of "/"
    assert(decode_at(chr(192) + chr(175), 0) == none)
    # overlong three-byte encoding of "/"
    assert(decode_at(chr(224) + chr(128) + chr(175), 0) == none)
    # surrogate U+D800
    assert(decode_at(chr(237) + chr(160) + chr(128), 0) == none)
    # above U+10FFFF
    assert(decode_at(chr(244) + chr(144) + chr(128) + chr(128), 0) == none)
    # 0xFE never appears in utf-8
    assert(decode_at(chr(254), 0) == none)
    # out of range
    assert(decode_at("abc", 3) == none)
    assert(decode_at("abc", -1) == none)
    assert(decode_at("", 0) == none)

test "validates and locates the first bad byte":
    assert_eq(is_valid(""), true)
    assert_eq(is_valid("hello"), true)
    assert_eq(is_valid("Ärger"), true)
    assert_eq(is_valid("𝄞€Ä a"), true)
    assert_eq(find_invalid("Ärger"), -1)
    assert_eq(is_valid("ab" + chr(255) + "cd"), false)
    assert_eq(find_invalid("ab" + chr(255) + "cd"), 2)

test "encodes and round trips code points":
    assert_eq(encode(65)!, "A")
    assert_eq(encode(196)!, "Ä")
    assert_eq(encode(8364)!, "€")
    assert_eq(encode(119070)!, "𝄞")
    assert_eq(encode(1114111)!, "􏿿")
    assert_eq(from_code_points([72, 196, 8364])!, "HÄ€")
    assert_eq(from_code_points([])!, "")

test "encode refuses what a String cannot carry":
    assert(encode(0).is_err)
    assert(encode(-1).is_err)
    assert(encode(1114112).is_err)
    assert(encode(55296).is_err)
    assert(encode(57343).is_err)

test "counts characters, not bytes":
    assert_eq("Ärger".len(), 6)
    assert_eq(char_count("Ärger"), 5)
    assert_eq(char_count(""), 0)
    assert_eq(char_count("hello"), 5)
    assert_eq(char_count("𝄞€Ä"), 3)
    # an undecodable byte still counts as one piece
    assert_eq(char_count(chr(255) + "a"), 2)

test "splits into characters":
    parts := chars("Ärger")
    assert_eq(parts.len(), 5)
    assert_eq(parts.get(0).unwrap_or(""), "Ä")
    assert_eq(parts.get(1).unwrap_or(""), "r")
    assert_eq(parts.get(4).unwrap_or(""), "r")
    assert_eq(from_chars(parts), "Ärger")
    assert_eq(chars("").len(), 0)

test "reports code points and offsets":
    points := code_points("A€")
    assert_eq(points.len(), 2)
    assert_eq(points.get(0).unwrap_or(0), 65)
    assert_eq(points.get(1).unwrap_or(0), 8364)

    offsets := char_offsets("A€b")
    assert_eq(offsets.len(), 3)
    assert_eq(offsets.get(0).unwrap_or(-1), 0)
    assert_eq(offsets.get(1).unwrap_or(-1), 1)
    assert_eq(offsets.get(2).unwrap_or(-1), 4)

test "answers boundary questions":
    s := "Ärger"
    assert_eq(is_boundary(s, 0), true)
    assert_eq(is_boundary(s, 1), false)
    assert_eq(is_boundary(s, 2), true)
    assert_eq(is_boundary(s, 6), true)
    assert_eq(is_boundary(s, 7), false)
    assert_eq(floor_boundary(s, 1), 0)
    assert_eq(floor_boundary(s, 2), 2)
    assert_eq(ceil_boundary(s, 1), 2)
    assert_eq(ceil_boundary(s, 2), 2)

test "indexes and slices by character":
    s := "Ärger"
    assert_eq(char_at(s, 0).unwrap_or(""), "Ä")
    assert_eq(char_at(s, 1).unwrap_or(""), "r")
    assert_eq(char_at(s, 4).unwrap_or(""), "r")
    assert(char_at(s, 5) == none)
    assert(char_at(s, -1) == none)
    assert_eq(slice(s, 0, 1), "Ä")
    assert_eq(slice(s, 0, 2), "Är")
    assert_eq(slice(s, 1, 5), "rger")
    assert_eq(slice(s, 0, 99), "Ärger")
    assert_eq(slice(s, 3, 1), "")
    assert_eq(byte_offset_of(s, 1), 2)
    assert_eq(byte_offset_of(s, 99), 6)

test "truncates without splitting a character":
    s := "Ärger"
    assert_eq(truncate(s, 1), "Ä")
    assert_eq(truncate(s, 0), "")
    assert_eq(truncate(s, 99), "Ärger")
    assert_eq(is_valid(truncate(s, 1)), true)

    # a byte budget backs off to the last whole character
    assert_eq(truncate_bytes(s, 1), "")
    assert_eq(truncate_bytes(s, 2), "Ä")
    assert_eq(truncate_bytes(s, 3), "Är")
    assert_eq(truncate_bytes(s, 99), "Ärger")
    assert_eq(is_valid(truncate_bytes(s, 1)), true)

test "marks text it had to cut":
    assert_eq(truncate_with("Ärger", 10, "..."), "Ärger")
    assert_eq(truncate_with("Ärger", 4, "..."), "Ä...")
    assert_eq(truncate_with("hello world", 8, "..."), "hello...")

test "folds across the scripts, not just ascii":
    assert_eq(fold("ABC"), "abc")
    assert_eq(fold("abc"), "abc")
    assert_eq(fold(""), "")
    # latin-1: to_lower leaves this untouched, which is the bug fold exists for
    assert_eq(fold("Ä"), "ä")
    assert_eq(fold("Ärger"), "ärger")
    assert_eq("Ärger".to_lower(), "Ärger")
    # cyrillic
    assert_eq(fold("А"), "а")
    assert_eq(fold("ПРИВЕТ"), "привет")
    # greek
    assert_eq(fold("Σ"), "σ")
    assert_eq(fold("σ"), "σ")

test "folding and lowercasing genuinely differ":
    # greek final sigma lowercases to itself but folds to a plain sigma, so
    # these two strings are the same word and only folding says so.
    assert_eq(fold("ς"), "σ")
    assert_eq(fold("ΣΣ"), "σσ")
    assert_eq(fold("σς"), "σσ")
    assert_eq(eq_fold("ΣΣ", "σς"), true)
    assert_eq(eq_fold("Ärger", "ärger"), true)
    assert_eq(eq_fold("Ärger", "arger"), false)

test "simple folding leaves the length-changing cases alone":
    # these need full folding, which this module does not implement. the point
    # of the test is that the behaviour is pinned rather than accidental.
    assert_eq(fold("ß"), "ß")
    assert_eq(eq_fold("straße", "STRASSE"), false)
    # turkish dotted capital i folds to itself under the default rules; a
    # turkish-locale fold would map it to "i", and that belongs in std.intl.
    assert_eq(fold("İ"), "İ")
    assert_eq(fold("ı"), "ı")
    # the title-case form of a digraph folds to the lowercase digraph
    assert_eq(fold("ǅ"), "ǆ")

test "composes decomposed text":
    # "e" followed by a combining acute accent is three bytes; NFC turns it
    # into the two-byte precomposed "é"
    decomposed := "e" + chr(204) + chr(129)
    assert_eq(decomposed.len(), 3)
    assert_eq(char_count(decomposed), 2)
    assert_eq(normalize(decomposed), "é")
    assert_eq(normalize(decomposed).len(), 2)
    assert_eq(char_count(normalize(decomposed)), 1)

test "leaves already-composed text alone":
    assert_eq(normalize("é"), "é")
    assert_eq(normalize("hello"), "hello")
    assert_eq(normalize(""), "")
    assert_eq(normalize("Ärger"), "Ärger")
    assert_eq(is_normalized("é"), true)
    assert_eq(is_normalized("e" + chr(204) + chr(129)), false)

test "composes hangul by formula":
    # hangul syllables are not in the decomposition table; they are built and
    # taken apart arithmetically
    jamo := "ᄀ" + "ᅡ"
    assert_eq(char_count(jamo), 2)
    assert_eq(normalize(jamo), "가")
    assert_eq(char_count(normalize(jamo)), 1)
    # with a trailing consonant
    assert_eq(normalize("ᄒ" + "ᅡ" + "ᆫ"), "한")
    assert_eq(normalize("한"), "한")

test "reorders combining marks into canonical order":
    # a base with two marks written in the wrong order normalizes to the same
    # string as the right order. U+0323 (below, class 220) must precede
    # U+0301 (above, class 230) whichever way they were typed.
    below_first := "a" + chr(204) + chr(163) + chr(204) + chr(129)
    above_first := "a" + chr(204) + chr(129) + chr(204) + chr(163)
    assert_eq(normalize(above_first), normalize(below_first))
    assert_eq(normalize(above_first).len(), normalize(below_first).len())
    # and it composes what it can: a-with-dot-below plus the acute
    assert_eq(char_count(normalize(below_first)), 2)

test "reports combining classes":
    assert_eq(combining_class(97), 0)
    assert_eq(combining_class(769), 230)
    assert_eq(combining_class(803), 220)
    assert_eq(combining_class(8364), 0)

test "folds and normalizes together for identifier comparison":
    typed := "E" + chr(204) + chr(129)
    stored := "é"
    assert_eq(eq_fold(typed, stored), false)
    assert_eq(eq_fold_normalized(typed, stored), true)

test "records the unicode version it was built from":
    assert_eq(unicode_version(), "15.1.0")

test "repairs undecodable bytes":
    assert_eq(sanitize("Ärger"), "Ärger")
    assert_eq(sanitize(""), "")
    assert_eq(sanitize("a" + chr(255) + "b"), "a�b")
    assert_eq(is_valid(sanitize("a" + chr(255) + "b")), true)
    # a lead byte whose continuation was cut away
    assert_eq(sanitize(chr(195)), "�")
