# bytes keys — a set and a map keyed by raw bytes, compared by content

import std.bytes as bytes

# frames as a protocol layer hands them over: raw bytes, some repeated
fn frames() -> List[Bytes]:
    out: List[Bytes] := []
    out.push(bytes.from_string_utf8("PING"))
    out.push(bytes.from_string_utf8("DATA"))
    out.push(bytes.from_string_utf8("PING"))
    out.push(bytes.from_string_utf8("PONG"))
    return out

fn main() -> String!:
    # a name for each opcode, keyed by the opcode's bytes
    names: Map[Bytes, String] := {}
    names[bytes.from_string_utf8("PING")] = "ping"
    names[bytes.from_string_utf8("PONG")] = "pong"

    mut seen: Set[Bytes] := {}
    mut counts: Map[Bytes, Int] := {}
    for frame in frames():
        # the key the map holds and the frame read off the wire are different
        # objects; the lookup goes by content
        counts[frame] = counts.get_default(frame, 0) + 1
        if seen.contains(frame):
            print("repeat: {names.get_default(frame, "?")}")
        else:
            seen.add(frame)
            print("first: {names.get_default(frame, "?")}")

    print("distinct: {seen.len()}")
    # a key assembled byte by byte still finds the entry
    buf := bytes.buffer()
    buf.write_string_utf8("PI")!
    buf.write_string_utf8("NG")!
    print("ping count: {counts[buf.take_bytes()]}")
    print("data count: {counts[bytes.from_string_utf8("DATA")]}")
    return ""
