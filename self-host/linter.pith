# linter.pith — convention enforcement for pith source code
#
# runs after type checking, walking the AST to check naming
# conventions and structural rules.
#
# lint rules:
#   E300 — snake_case for functions and variables
#   E301 — PascalCase for types (structs, enums, interfaces, aliases)
#   E302 — unused variable
#   E304 — public function missing doc comment
#   E305 — indentation depth exceeds 4 levels
#   E306 — a strong reference cycle between structs
#   E307 — a resource built locally and never closed
#   E308 — a binding shadows a module global

from ast import Node, get_node
from ir_ast_helpers import ir_is_binding_kind
from errors import Diagnostic
from std.strings import lines_keep_empty

# ---------------------------------------------------------------
# diagnostics
# ---------------------------------------------------------------

mut l_diagnostics: List[Diagnostic] := []
mut l_file := ""

# the module's struct declarations and the cycles already reported, for
# the strong-cycle pass at the end of lint_module (E306, below).
mut l_struct_decls: Map[String, Int] := {}
mut l_reported_cycles: List[String] := []

# the module's import aliases (alias -> dotted module path) and the two
# answers the use scan produces, for the unclosed-resource pass (E307,
# below). the scan writes its answers here because it recurses.
mut l_import_aliases: Map[String, String] := {}
mut l_resource_escaped := false
mut l_resource_closed := false

# the module's own globals, name -> declaration line, for the shadowing
# pass (E308, below). filled before any function is walked, so a global
# written below the function that shadows it still counts.
mut l_module_globals: Map[String, Int] := {}

fn report_linter_warning(code: String, message: String, line: Int, col: Int):
    l_diagnostics.push(Diagnostic("warning", code, message, l_file, line, col, ""))

# ---------------------------------------------------------------
# generated files
# ---------------------------------------------------------------

# true when the file declares itself machine-generated in its LEADING
# comment block.
#
# generated code mirrors the naming of whatever it was generated from,
# and that mapping is the point: protogen output carries proto's
# PascalCase rpc names, so `Search` and `GetProduct` are correct there
# and renaming them to satisfy E300 would break the correspondence with
# the .proto file. so these files are skipped rather than exempted rule
# by rule.
#
# only the comment lines that OPEN the file count, and the reason is
# concrete: tools/protogen writes this very marker into the files it
# generates, so the same string sits in a string literal a thousand
# lines inside the generator's own source. a whole-file search would
# quietly exempt the generator from being linted.
pub fn source_is_generated(source: String) -> Bool:
    for line, i in lines_keep_empty(source):
        trimmed := line.trim()
        if trimmed.len() == 0:
            continue
        if not trimmed.starts_with("#"):
            return false
        if trimmed.contains("do not edit"):
            return true
    return false

# ---------------------------------------------------------------
# public entry point
# ---------------------------------------------------------------

# run all lint rules on a checked module AST.
# source is needed for doc comment detection; file is stamped onto
# every diagnostic so tools can attribute the warning.
pub fn lint_module(root_idx: Int, source: String, file: String) -> List[Diagnostic]:
    l_diagnostics = []
    l_file = file
    l_struct_decls = {}
    l_reported_cycles = []
    l_import_aliases = {}
    root := get_node(root_idx)
    # imports are read first: the unclosed-resource rule resolves a call's
    # module from the alias it was imported under, and a rule that ran in
    # declaration order would miss an import written below a function.
    l_module_globals = {}
    for child in root.children:
        l_record_import_alias(child)
        l_record_module_global(child)
    for child in root.children:
        lint_top_level(child, source)
    lint_strong_cycles()
    return l_diagnostics

fn lint_top_level(node_idx: Int, source: String):
    node := get_node(node_idx)
    mut is_pub := false
    mut inner_idx := node_idx

    if node.kind == "pub":
        is_pub = true
        if node.children.len() > 0:
            inner_idx = node.children[0]

    inner := get_node(inner_idx)

    if inner.kind == "fn_decl":
        lint_fn_decl(inner, inner_idx, is_pub, source)
    elif inner.kind == "struct_decl":
        check_pascal_case(inner.value, "struct", inner.line, inner.col)
        l_struct_decls.insert(inner.value, inner_idx)
    elif inner.kind == "enum_decl":
        check_pascal_case(inner.value, "enum", inner.line, inner.col)
    elif inner.kind == "interface_decl":
        check_pascal_case(inner.value, "interface", inner.line, inner.col)
    elif inner.kind == "type_alias":
        check_pascal_case(inner.value, "type alias", inner.line, inner.col)
    elif inner.kind == "impl_decl":
        lint_impl_decl(inner, source)
    elif inner.kind == "binding":
        # a binding at module level is a CONSTANT, and SCREAMING_SNAKE_CASE is
        # how this tree spells one — std, self-host, tools and bench all do.
        # flagging those as non-snake_case was the rule misreading a constant
        # as a variable, and it is why std/ could never be brought under lint.
        name := l_extract_binding_name(inner.value)
        if not is_screaming_snake_case(name):
            check_snake_case(name, "constant", inner.line, inner.col)
    elif inner.kind == "test_decl":
        lint_block_depth(inner, 1)
        lint_shadowed_globals(inner_idx)

fn lint_fn_decl(node: Node, node_idx: Int, is_pub: Bool, source: String):
    name := node.value
    # skip generic declarations
    if name.contains("["):
        return

    # E300: function name must be snake_case (skip main)
    if name != "main":
        check_snake_case(name, "function", node.line, node.col)

    # E304: public function missing doc comment
    if is_pub:
        check_doc_comment(name, node_idx, source, false)

    # check body for nesting depth
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "body":
            lint_block_depth(cn, 1)
            lint_unclosed_resources(child)
    lint_shadowed_globals(node_idx)

fn lint_impl_decl(node: Node, source: String):
    # iterate methods
    for method_idx, i in node.children:
        if i == 0:
            continue
        method := get_node(method_idx)
        mut is_pub := false
        mut actual_idx := method_idx

        if method.kind == "pub":
            is_pub = true
            if method.children.len() > 0:
                actual_idx = method.children[0]

        actual := get_node(actual_idx)
        if actual.kind == "fn_decl":
            name := actual.value
            # E300: method name must be snake_case
            check_snake_case(name, "method", actual.line, actual.col)
            # E304: public method missing doc comment
            if is_pub:
                check_doc_comment(name, actual_idx, source, true)
            # check body nesting depth
            for child in actual.children:
                cn := get_node(child)
                if cn.kind == "body":
                    lint_block_depth(cn, 1)
                    lint_unclosed_resources(child)
            lint_shadowed_globals(actual_idx)

# ---------------------------------------------------------------
# E300: snake_case for functions and variables
# ---------------------------------------------------------------

fn check_snake_case(name: String, kind: String, line: Int, col: Int):
    if name == "" or name == "_":
        return
    if is_snake_case(name):
        return
    # a constant that has to be computed is still a constant, and it is
    # spelled like one: std.math exposes PI(), E() and TAU() as calls
    # because a float constant cannot be evaluated at module level. the
    # uppercase name is the point — `math.PI()` is what a caller expects
    # to write, and every language spells these in caps. this matches the
    # SCREAMING_SNAKE_CASE the tree already uses for module constants.
    if is_screaming_snake_case(name):
        return
    report_linter_warning("E300", kind + " '" + name + "' should be snake_case", line, col)

# SCREAMING_SNAKE_CASE — the spelling this tree uses for a module constant.
# deliberately strict: it must be uppercase, digits and underscores only, so a
# mixed-case name like `Color_UNKNOWN` still fails and gets reported. accepting
# "has an uppercase letter somewhere" would have made the rule vacuous.
fn is_screaming_snake_case(name: String) -> Bool:
    if name.len() == 0:
        return false
    c := ord(name[0])
    if not is_uppercase_char(c):
        return false
    mut has_upper := false
    for ch, i in name:
        code := ord(ch)
        if is_uppercase_char(code):
            has_upper = true
            continue
        if not is_digit_char(code) and ch != "_":
            return false
    return has_upper

fn is_snake_case(name: String) -> Bool:
    if name.len() == 0:
        return true
    # must start with lowercase letter or underscore
    c := ord(name[0])
    if not is_lowercase_char(c) and name[0] != "_":
        return false
    for ch, i in name:
        if i == 0:
            continue
        code := ord(ch)
        if not is_lowercase_char(code) and not is_digit_char(code) and ch != "_":
            return false
    return true

# ---------------------------------------------------------------
# E301: PascalCase for types
# ---------------------------------------------------------------

fn check_pascal_case(name: String, kind: String, line: Int, col: Int):
    if name == "":
        return
    if not is_pascal_case(name):
        report_linter_warning("E301", kind + " '" + name + "' should be PascalCase", line, col)

fn is_pascal_case(name: String) -> Bool:
    if name.len() == 0:
        return true
    # must start with uppercase letter
    c := ord(name[0])
    if not is_uppercase_char(c):
        return false
    # letters and digits only, so no underscores
    for ch in name:
        if not is_alphanumeric_char(ord(ch)):
            return false
    # an all-caps name is an acronym, and renaming it is the wrong repair:
    # `URL` is how the type is spelled everywhere it is documented, and
    # `Url` would be a public API break made to satisfy a naming rule.
    # what this rule is really for is catching a type written `my_thing`
    # or `myThing`, and neither reaches here — both start lowercase and
    # were rejected above.
    return true

# ---------------------------------------------------------------
# E304: public function missing doc comment
# ---------------------------------------------------------------

# is_method says which declaration we are looking for, and it is load
# bearing rather than cosmetic. a top-level function and an impl method
# routinely share a name — std/fs.pith has both `pub fn read(path)` and
# `FileStream.read(max_bytes)` — and searching the whole file for the
# name found BOTH, kept the last, and judged the top-level function by
# the line above the METHOD. every such pair reported the documented
# function as undocumented. indentation separates them: a top-level
# declaration starts at column 0, a method never does.
fn check_doc_comment(name: String, node_idx: Int, source: String, is_method: Bool):
    # the doc comment lives on the line above the declaration, so the
    # declaration is found by text search — the node's own position is the
    # LAST token that formed it, which for a function is somewhere in its
    # body, not the signature. the blank-preserving split keeps indices
    # equal to real line numbers; plain split drops empty lines and shifts
    # everything above a gap.
    lines := lines_keep_empty(source)
    search := "fn " + name + "("
    mut found_line := 0 - 1
    for line, i in lines:
        if not line.contains(search):
            continue
        if found_line >= 0:
            continue
        # a bare `contains` also matches a call site and any comment or
        # string that happens to name the function, so require the line to
        # OPEN with this exact declaration.
        trimmed := line.trim()
        if not trimmed.starts_with(search) and not trimmed.starts_with("pub " + search):
            continue
        if is_line_indented(line, trimmed) != is_method:
            continue
        found_line = i
    if found_line <= 0:
        # can't find or first line — skip
        return
    # check line before the declaration for a comment
    prev := lines[found_line - 1].trim()
    if prev.len() == 0 or prev[0] != "#":
        report_linter_warning("E304", "public function '" + name + "' is missing a doc comment", found_line + 1, 0)

# ---------------------------------------------------------------
# E305: indentation depth exceeds 4 levels
# ---------------------------------------------------------------

fn lint_block_depth(node: Node, depth: Int):
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "block":
            for stmt in cn.children:
                lint_stmt_depth(stmt, depth)
        elif cn.kind == "if" or cn.kind == "while" or cn.kind == "for" or cn.kind == "match":
            if depth >= 5:
                report_linter_warning("E305", "nesting depth " + depth.to_string() + " exceeds 4 levels -- consider refactoring", cn.line, cn.col)
            lint_block_depth(cn, depth + 1)
        else:
            lint_stmt_depth(child, depth)

fn lint_stmt_depth(node_idx: Int, depth: Int):
    node := get_node(node_idx)
    if node.kind == "if" or node.kind == "while" or node.kind == "for_in" or node.kind == "match":
        if depth >= 5:
            report_linter_warning("E305", "nesting depth " + depth.to_string() + " exceeds 4 levels -- consider refactoring", node.line, node.col)
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "body" or cn.kind == "block" or cn.kind == "else" or cn.kind == "elif":
                lint_block_depth(cn, depth + 1)
            else:
                lint_stmt_depth(child, depth)

# ---------------------------------------------------------------
# helpers
# ---------------------------------------------------------------

# a line is indented when trimming it removed something. comparing
# lengths is enough here and avoids caring which whitespace was used.
fn is_line_indented(line: String, trimmed: String) -> Bool:
    return line.len() > trimmed.len()

# extract the plain binding name from a value like "mut x" or "x"
fn l_extract_binding_name(value: String) -> String:
    if value.starts_with("mut "):
        return value.substring(4, value.len())
    # a `mut` binding stores its marker AFTER the name, so the leading strip
    # above never fired for one and the name came out as "app_name mut" —
    # which then failed the snake_case test on the space, reporting a casing
    # problem that was really a parsing one. every `mut` module binding in the
    # tree was flagged this way.
    if value.ends_with(" mut"):
        return value.substring(0, value.len() - 4)
    return value

fn is_lowercase_char(c: Int) -> Bool:
    return c >= 97 and c <= 122

fn is_uppercase_char(c: Int) -> Bool:
    return c >= 65 and c <= 90

fn is_digit_char(c: Int) -> Bool:
    return c >= 48 and c <= 57

fn is_alphanumeric_char(c: Int) -> Bool:
    return is_lowercase_char(c) or is_uppercase_char(c) or is_digit_char(c)

# ---------------------------------------------------------------
# E306: a strong reference cycle between structs
# ---------------------------------------------------------------
#
# a struct graph that closes a loop of strong references keeps its own count
# above zero, so reference counting alone never reclaims it (the model is in
# docs/ownership.md). the first-class fix is marking the back edge `weak`,
# and a new user rarely knows that until a leak is measured. so the linter
# names the cycle at a field that could break it: a field whose type names
# the struct itself, or one that starts a chain through other structs in the
# same module that leads back. a `weak` field is not an edge, and neither is
# a function type — a closure value may capture a cycle, but a field's fn
# type holds nothing by itself. a cycle through another module's structs is
# not visible here and passes.

fn l_field_name(value: String) -> String:
    return value.split(" ")[0]

# append the module-local structs a type mentions, skipping function types.
fn l_type_struct_refs(type_idx: Int, out: List[String]):
    node := get_node(type_idx)
    if node.kind == "fn_type":
        return
    if node.kind == "type" or node.kind == "generic_type":
        if l_struct_decls.contains_key(node.value) and not out.contains(node.value):
            out.push(node.value)
    for child in node.children:
        l_type_struct_refs(child, out)

# the strong edges out of a struct, one "field:target" entry per reference.
fn l_strong_edges(sname: String) -> List[String]:
    mut edges: List[String] := []
    decl := get_node(l_struct_decls[sname])
    for child in decl.children:
        field := get_node(child)
        if field.kind != "field" or field.value.contains(" weak") or field.children.len() == 0:
            continue
        mut refs: List[String] := []
        l_type_struct_refs(field.children[0], refs)
        for target in refs:
            edges.push(l_field_name(field.value) + ":" + target)
    return edges

# true when a strong path from `cur` reaches `origin`. `seen` holds every
# struct already visited, so a loop that never passes through origin ends.
fn l_reaches(cur: String, origin: String, seen: List[String]) -> Bool:
    for edge in l_strong_edges(cur):
        target := edge.split(":")[1]
        if target == origin:
            return true
        if not seen.contains(target):
            seen.push(target)
            if l_reaches(target, origin, seen):
                return true
    return false

fn lint_strong_cycles():
    for sname in l_struct_decls.keys():
        for edge in l_strong_edges(sname):
            parts := edge.split(":")
            fname := parts[0]
            target := parts[1]
            mut seen: List[String] := [sname, target]
            mut closes := target == sname
            if not closes:
                closes = l_reaches(target, sname, seen)
            if not closes:
                continue
            # a mutual pair closes from both sides; report it once
            key := sname + "|" + target
            if l_reported_cycles.contains(key):
                continue
            l_reported_cycles.push(key)
            l_reported_cycles.push(target + "|" + sname)
            decl := get_node(l_struct_decls[sname])
            mut line := decl.line
            mut col := decl.col
            for child in decl.children:
                field := get_node(child)
                if field.kind == "field" and l_field_name(field.value) == fname:
                    line = field.line
                    col = field.col
            mut message := ""
            if target == sname:
                message = "struct '" + sname + "' holds a strong reference to itself through field '" + fname + "'; a cycle of strong references is never reclaimed"
            else:
                message = "struct '" + sname + "' reaches itself through a strong reference cycle starting at field '" + fname + "' (" + target + "); a cycle of strong references is never reclaimed"
            l_diagnostics.push(Diagnostic("warning", "E306", message, l_file, line, col, "mark the back edge with `weak` (`weak " + fname + ": ...`), see docs/ownership.md"))

# ---------------------------------------------------------------
# E308: a binding shadows a module global
# ---------------------------------------------------------------
#
# a local, a parameter or a `match` / `if let` payload spelled like one of
# this module's globals reads its own storage, and the global is then
# unreachable for the rest of that function: every mention of the name inside
# is the binding. a `for` variable is exempt — its storage lasts the loop and
# the global is still reachable on either side of it. that is legal, and it is almost never what
# the author meant — a function that means to read the global and a function
# that means to hold its own value are spelled the same, and only the
# declaration order tells them apart.
#
# it used to be worse than a readability problem. the ir namespace is flat
# and the consumer resolved a bare name to a global's data slot whenever one
# existed, so the binding wrote the GLOBAL's storage: `items.len()` on the
# global came back as whatever the shadowing binding had left there. globals
# now carry a storage symbol of their own and the two cannot meet, which is
# what makes this a warning rather than a miscompile.

# record a module-level binding under its name, so the shadowing pass can
# point at the declaration it hides. threadlocal globals count: they have
# per-thread storage rather than a data slot, but the name is the same.
fn l_record_module_global(node_idx: Int):
    node := get_node(node_idx)
    mut inner := node
    if node.kind == "pub" and node.children.len() > 0:
        inner = get_node(node.children[0])
    if inner.kind == "threadlocal" and inner.children.len() > 0:
        inner = get_node(inner.children[0])
    if not ir_is_binding_kind(inner.kind):
        return
    name := l_extract_binding_name(inner.value)
    if name.len() > 0 and not l_module_globals.contains_key(name):
        l_module_globals.insert(name, inner.line)

fn l_report_shadowed_global(name: String, kind: String, line: Int, col: Int):
    if name.len() == 0 or name == "_":
        return
    if not l_module_globals.contains_key(name):
        return
    declared := l_module_globals[name]
    message := kind + " '" + name + "' shadows the module global declared on line " + declared.to_string() + "; the global is unreachable for the rest of this function"
    l_diagnostics.push(Diagnostic("warning", "E308", message, l_file, line, col, "rename the binding, or drop the global if the binding is what you meant"))

# walk one function declaration for names it binds function-wide that a
# module global already claims. a `for` variable is left out: it has storage
# of its own for the length of the loop and the global is still reachable on
# either side of it, so it hides nothing.
fn lint_shadowed_globals(idx: Int):
    node := get_node(idx)
    if node.kind == "param":
        l_report_shadowed_global(l_extract_binding_name(node.value), "parameter", node.line, node.col)
    elif ir_is_binding_kind(node.kind):
        l_report_shadowed_global(l_extract_binding_name(node.value), "binding", node.line, node.col)
    elif node.kind == "pat_binding":
        l_report_shadowed_global(node.value, "pattern binding", node.line, node.col)
    for child in node.children:
        lint_shadowed_globals(child)

# ---------------------------------------------------------------
# E307: a resource built locally and never closed
# ---------------------------------------------------------------
#
# reference counting reclaims a value's memory; it gives back the registry
# slot, socket or fd behind a handle only for a type that implements Drop.
# for the rest std's rule is that whoever builds a resource closes it, and
# until this rule nothing said so when a caller forgot
# (docs/destructors_roadmap.md has the survey and the plan).
#
# the rule is deliberately narrow, because a false positive on a resource
# that is closed somewhere the linter cannot see is worse than no rule at
# all. it reports only when BOTH hold:
#
#   - the binding's initializer is a call to a constructor on the short
#     list below, reached through `!`/`?` and any chain of builder methods
#   - every later mention of the name is the receiver of a method that is
#     not a closer
#
# any other use silences it: passed as an argument, returned, assigned,
# stored, read as a field, captured by a lambda. each of those can hand
# the resource to something that closes it, and none of them is visible
# from one module.
#
# the constructor list stays short on purpose. an entry has to be a call
# whose result the caller owns, on a type with no method that consumes the
# receiver instead of closing it. `bytes.ByteBuffer` is the counterexample
# that sets the bar: `take_bytes()` frees the buffer as it takes its
# contents, so a buffer that never sees `free()` can still be correct, and
# listing it would report working code.

# the label to name in the diagnostic, or "" when this call does not build
# a resource the caller has to close.
#
# the list is empty for now. it held the three std.net.tls config builders,
# and a tls config implements Drop: a config built and never closed gives
# its registry slot back when the last value naming it goes away
# (docs/ownership.md, "destructors"), so the shape this rule reported is no
# longer a leak. the rule stays for the std types that still close by hand
# (docs/destructors_roadmap.md); each is added here as it is audited onto
# the list rather than the destructor, under the bar set above.
fn l_resource_ctor_label(module_path: String, fn_name: String) -> String:
    if module_path.len() == 0 or fn_name.len() == 0:
        return ""
    # no constructor qualifies today; see the note above.
    return ""

# the closers std spells. a receiver use of any of these is enough to
# silence the rule for that binding, whatever the module.
fn l_is_closing_method(name: String) -> Bool:
    if name == "close" or name == "free" or name == "release":
        return true
    return name == "shutdown" or name == "stop" or name == "destroy" or name == "cancel"

# record `import a.b.c as alias` so a call's module can be resolved from
# the name it was written under. an import with no alias is referred to by
# the last segment of its path.
fn l_record_import_alias(node_idx: Int):
    node := get_node(node_idx)
    if node.kind != "import":
        return
    parts := node.value.split(" ")
    if parts.len() == 0:
        return
    path := parts[0]
    segments := path.split(".")
    mut alias := segments[segments.len() - 1]
    if parts.len() >= 3 and parts[1] == "as":
        alias = parts[2]
    l_import_aliases.insert(alias, path)

# the resource constructor a binding's initializer ultimately calls, seen
# through `!`, `?` and a chain of builder methods — `tls.client_config()!`
# and `tls.client_config()!.with_alpn(["h2"])` name the same constructor.
fn l_init_resource_label(idx: Int) -> String:
    node := get_node(idx)
    if node.children.len() == 0:
        return ""
    if node.kind == "try" or node.kind == "unwrap":
        return l_init_resource_label(node.children[0])
    if node.kind != "method_call":
        return ""
    receiver := get_node(node.children[0])
    if receiver.kind != "ident":
        return l_init_resource_label(node.children[0])
    if not l_import_aliases.contains_key(receiver.value):
        return ""
    return l_resource_ctor_label(l_import_aliases[receiver.value], node.value)

# walk a function body recording how `name` is used. a bare mention is an
# escape — the value reached somewhere this rule cannot follow — and only a
# method call whose receiver is the name itself is read as a use in place.
fn l_scan_resource_uses(node_idx: Int, name: String):
    node := get_node(node_idx)
    if node.kind == "ident":
        if node.value == name:
            l_resource_escaped = true
        return
    if node.kind == "method_call" and node.children.len() > 0:
        receiver := get_node(node.children[0])
        if receiver.kind == "ident" and receiver.value == name:
            if l_is_closing_method(node.value):
                l_resource_closed = true
            # the receiver is accounted for; the arguments are not
            for child, i in node.children:
                if i > 0:
                    l_scan_resource_uses(child, name)
            return
    for child in node.children:
        l_scan_resource_uses(child, name)

fn l_check_resource_binding(name: String, label: String, line: Int, col: Int, body_idx: Int):
    if name.len() == 0 or name == "_":
        return
    l_resource_escaped = false
    l_resource_closed = false
    l_scan_resource_uses(body_idx, name)
    if l_resource_escaped or l_resource_closed:
        return
    message := "'" + name + "' is built by " + label + " and never closed; the resource behind the handle is not reclaimed when the binding goes out of scope"
    fix := "close it on every exit -- `defer " + name + ".close()` next to the build; see docs/destructors_roadmap.md"
    l_diagnostics.push(Diagnostic("warning", "E307", message, l_file, line, col, fix))

fn l_collect_resource_bindings(node_idx: Int, body_idx: Int):
    node := get_node(node_idx)
    if node.kind == "binding" and node.children.len() > 0:
        label := l_init_resource_label(node.children[node.children.len() - 1])
        if label.len() > 0:
            l_check_resource_binding(l_extract_binding_name(node.value), label, node.line, node.col, body_idx)
    for child in node.children:
        l_collect_resource_bindings(child, body_idx)

fn lint_unclosed_resources(body_idx: Int):
    l_collect_resource_bindings(body_idx, body_idx)
