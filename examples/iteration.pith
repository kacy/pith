# iteration: for loops over lists, ranges, strings, maps and sets.
#
# reports on a short access log: which lines mention an error, how often
# each path was hit, and which clients were seen. maps and sets iterate in
# no fixed order, so the report sorts their keys before printing them.

fn main():
    log := [
        "10.0.0.4 GET /index.html 200",
        "10.0.0.7 GET /api/users 500",
        "10.0.0.4 POST /api/users 201",
        "10.0.0.9 GET /index.html 200",
        "10.0.0.7 GET /api/users 503",
    ]

    # the second name in a for loop is the position
    for line, index in log:
        status := line.split(" ")[3]
        if status.starts_with("5"):
            print("line {index + 1}: server error {status}")

    mut hits: Map[String, Int] := {}
    mut clients: Set[String] := {}
    for line in log:
        fields := line.split(" ")
        clients.add(fields[0])
        hits[fields[2]] = hits.get(fields[2]).unwrap_or(0) + 1

    # a for loop over a map visits its keys
    mut paths: List[String] := []
    for path in hits:
        paths.push(path)
    for path in paths.sort():
        print("{path:<12} {hits[path]} hits")

    mut addresses: List[String] := []
    for client in clients:
        addresses.push(client)
    print("clients: {addresses.sort().join(", ")}")

    # a range counts without building a list; the upper bound is excluded
    mut bar := ""
    for i in 0..hits["/api/users"]:
        bar = bar + "#"
    print("/api/users {bar}")

    # a string iterates character by character
    mut digits := 0
    for character in log[0]:
        if character >= "0" and character <= "9":
            digits += 1
    print("digits in the first line: {digits}")
