# std declares Client and Config more than once. a chain over either has to stay
# on the type it started with, whatever else this program imports.
import std.net.http as http
import std.net.http2.connection as connection
import std.redis as redis
import std.net.tls as tls
import std.config as config

fn main():
    client := http.client().with_keep_alives(false).with_max_redirects(0).with_compression(false)
    print(client.max_redirects.to_string())
    print(client.keep_alives.to_string())
