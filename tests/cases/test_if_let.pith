enum Shape:
    Circle(Float)
    Point

fn find_even(xs: List[Int], start: Int) -> Int?:
    mut i := start
    while i < xs.len():
        if xs[i] % 2 == 0:
            return xs[i]
        i = i + 1
    return none

fn next_item(xs: List[Int], i: Int) -> Int?:
    if i < xs.len():
        return xs[i]
    return none

fn main():
    s := Shape.Circle(3.0)
    if let Shape.Circle(r) = s:
        print("circle r = {r}")
    else:
        print("not a circle")
    p := Shape.Point
    if let Shape.Circle(r) = p:
        print("circle r = {r}")
    else:
        print("not a circle")
    xs := [1, 4, 7, 8]
    if let v = find_even(xs, 0):
        print("first even = {v}")
    if let v = find_even(xs, 2):
        print("next even = {v}")
    mut cursor := 0
    ys := [3, 6, 9]
    while let n = next_item(ys, cursor):
        print("item {n}")
        cursor = cursor + 1
