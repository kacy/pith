# testing an std.net.http handler in memory, with no socket.
#
# a handler is a plain function from HttpRequestBytes to HttpResponse, so a
# test can build a request with the client builder, serve it with
# http.serve_one over in-memory buffers, and parse the bytes that come back.
# the wire format is the real one; only the transport is missing.
#
# the handler is a small item service: POST /items/:id takes a json body and
# sets a cookie, GET /files/:name serves a file, and two middleware wrap it,
# one refusing requests without a session cookie and one echoing a trace id.

import std.bytes as bytes
import std.fs as fs
import std.io as io
import std.json as json
import std.net.http as http
from std.net.http import ClientRequest, HttpRequestBytes, HttpResponse

FILES_ROOT := fs.make_temp_dir("pith-http-apps-") catch "/tmp"

fn create_item(req: HttpRequestBytes) -> HttpResponse:
    payload := req.body_json() catch:
        return http.bad_request_response()
    kind := json.object_get_string(payload, "kind")
    if kind.len() == 0:
        return http.response(422).json_body(json.of("error", "kind is required"))
    out := json.make_object()
    json.object_set(out, "id", json.make_string(req.path_param_or("/items/:id", "id", "")))
    json.object_set(out, "kind", json.make_string(kind))
    json.object_set(out, "draft", json.make_bool(req.has_query_param("draft") catch false))
    return http.response(201).json_body(out).set_cookie(http.cookie("last_item", kind).path("/").http_only())

fn serve_named_file(req: HttpRequestBytes) -> HttpResponse:
    name := req.path_param_or("/files/:name", "name", "")
    # serve_dir refuses a name that climbs out of the root.
    return http.serve_dir(req, FILES_ROOT, name)

fn app(req: HttpRequestBytes) -> HttpResponse:
    if http.post_route(req, "/items/:id") catch false:
        return create_item(req)
    if http.get_route(req, "/files/:name") catch false:
        return serve_named_file(req)
    return http.not_found_response()

fn require_session(next: fn(HttpRequestBytes) -> HttpResponse, req: HttpRequestBytes) -> HttpResponse:
    if not (req.has_cookie("session") catch false):
        return http.unauthorized_response()
    return next(req)

fn echo_trace(next: fn(HttpRequestBytes) -> HttpResponse, req: HttpRequestBytes) -> HttpResponse:
    return next(req).header("X-Trace", req.header_or("X-Trace", "untraced"))

# serve one request through `handler` entirely in memory.
fn exchange(handler: fn(HttpRequestBytes) -> HttpResponse, req: ClientRequest) -> HttpResponse!:
    request_reader := io.bytes_reader(req.to_bytes()!).buffered_chunked(64)
    response_buffer := bytes.buffer()
    http.serve_one(request_reader, response_buffer.buffered_chunked(64), handler)!
    return http.parse_response_bytes(response_buffer.bytes())!

fn show(label: String, resp: HttpResponse):
    print("{label} -> {resp.status} {resp.body_text() catch ""}")

# a request as the browser would send it, signed in with `session` unless
# that is empty.
fn signed_in(req: ClientRequest, session: String) -> ClientRequest:
    if session.len() == 0:
        return req
    return req.cookie("session", session)

fn main() -> Int!:
    defer fs.remove_tree(FILES_ROOT)
    fs.write("{FILES_ROOT}/notes.txt", "steep for three minutes\n")!

    # the trace middleware is outermost, so even a 401 carries the trace id.
    handler := http.wrap(http.wrap(app, require_session), echo_trace)

    teapot := http.post_request("example.com", 80, "/items/42").query_param("draft", "").header("X-Trace", "t-100").json_body(json.of("kind", "teapot"))
    created := exchange(handler, signed_in(teapot, "s-1"))!
    show("create item", created)
    print("  trace: {created.header_value("X-Trace")}")
    print("  cookie: {created.cookies()[0]}")

    refused := exchange(handler, signed_in(teapot, ""))!
    show("no session", refused)
    print("  trace: {refused.header_value("X-Trace")}")

    show("empty kind", exchange(handler, signed_in(http.post_request("example.com", 80, "/items/7").json_body(json.of("kind", "")), "s-1"))!)
    show("not json", exchange(handler, signed_in(http.post_request("example.com", 80, "/items/7").text_body("teapot"), "s-1"))!)

    file := exchange(handler, signed_in(http.get_request("example.com", 80, "/files/notes.txt"), "s-1"))!
    print("get file -> {file.status} {file.header_value("Content-Type")}: {file.body_text()!.trim()}")
    show("missing file", exchange(handler, signed_in(http.get_request("example.com", 80, "/files/recipes.txt"), "s-1"))!)
    return 0
