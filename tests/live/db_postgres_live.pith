# live integration tests for std.postgres. they need a postgres server on
# 127.0.0.1:5432 with the pithtest fixtures; when none is reachable each test
# skips rather than fails, so `pith test` stays green on a machine without one.
#
# run with: pith test tests/live/db_postgres_live.pith

import std.postgres as postgres
import std.sql as sql
import std.decimal as decimal

fn open_or_skip() -> postgres.Conn:
    attempt := postgres.connect("127.0.0.1", 5432, "pith", "pith_pw", "pithtest")
    if attempt.is_err:
        skip_test("no postgres server at 127.0.0.1:5432")
    return attempt.ok

test "a simple query returns the seeded rows":
    conn := open_or_skip()
    mut ids: List[Int] := []
    for row in postgres.query(conn, "select id, name from users order by id")!:
        ids.push(row.as_int(0))
    conn.close()
    assert(ids.len() >= 3)
    assert_eq(ids[0], 1)

test "a parameterized query binds its argument":
    conn := open_or_skip()
    mut names: List[String] := []
    for row in postgres.query_params(conn, "select name from users where id = $1", ["2"])!:
        names.push(row.as_text(0))
    conn.close()
    assert_eq(names, ["grace"])

test "a prepared statement runs more than once":
    conn := open_or_skip()
    postgres.prepare(conn, "by_id", "select id from users where id = $1")!
    mut first: List[Int] := []
    for row in postgres.query_prepared(conn, "by_id", ["1"])!:
        first.push(row.as_int(0))
    mut second: List[Int] := []
    for row in postgres.query_prepared(conn, "by_id", ["3"])!:
        second.push(row.as_int(0))
    conn.close()
    assert_eq(first, [1])
    assert_eq(second, [3])

test "a null column reads back as null":
    conn := open_or_skip()
    mut saw_null := false
    for row in postgres.query(conn, "select id, score from users order by id")!:
        if row.is_null(1):
            saw_null = true
    conn.close()
    assert(saw_null)

test "a query against a missing relation surfaces the server error":
    conn := open_or_skip()
    result := postgres.query(conn, "select 1 from no_such_table_pith_xyz")
    conn.close()
    assert(result.is_err)

test "a syntax error is reported, not crashed on":
    conn := open_or_skip()
    result := postgres.exec(conn, "not valid sql at all")
    conn.close()
    assert(result.is_err)

test "a numeric column round-trips through the wire without losing a digit":
    conn := open_or_skip()
    # the value from the report that started this: as a float8 it comes back
    # 12345678901234568, cents and all.
    mut got: List[String] := []
    for row in postgres.query(conn, "select '12345678901234567.89'::numeric as balance, '1.10'::numeric as price, '-0.05'::numeric as delta")!:
        got.push(decimal.to_string(row.decimal("balance")))
        got.push(decimal.to_string(row.decimal("price")))
        got.push(decimal.to_string(row.decimal("delta")))
    conn.close()
    assert_eq(got, ["12345678901234567.89", "1.10", "-0.05"])

test "a numeric survives a write and a read back":
    conn := open_or_skip()
    postgres.exec(conn, "drop table if exists pith_numeric_probe")!
    postgres.exec(conn, "create table pith_numeric_probe (id int primary key, amount numeric(30,10))")!
    postgres.exec_params(conn, "insert into pith_numeric_probe values (1, $1)", ["12345678901234567.8900000000"])!
    postgres.exec_params(conn, "insert into pith_numeric_probe values (2, $1)", ["-0.0000000001"])!
    mut stored: List[String] := []
    for row in postgres.query(conn, "select amount from pith_numeric_probe order by id")!:
        stored.push(decimal.to_string(row.decimal("amount")))
    postgres.exec(conn, "drop table pith_numeric_probe")!
    conn.close()
    assert_eq(stored, ["12345678901234567.8900000000", "-0.0000000001"])

test "a summed ledger agrees with what postgres computed":
    conn := open_or_skip()
    postgres.exec(conn, "drop table if exists pith_ledger_probe")!
    postgres.exec(conn, "create table pith_ledger_probe (amount numeric(20,2))")!
    mut n := 0
    while n < 100:
        postgres.exec_params(conn, "insert into pith_ledger_probe values ($1)", ["0.10"])!
        n = n + 1
    mut here := decimal.zero()
    for row in postgres.query(conn, "select amount from pith_ledger_probe")!:
        here = decimal.add(here, row.decimal("amount"))
    mut there := ""
    for row in postgres.query(conn, "select sum(amount) as total from pith_ledger_probe")!:
        there = decimal.to_string(row.decimal("total"))
    postgres.exec(conn, "drop table pith_ledger_probe")!
    conn.close()
    assert_eq(decimal.to_string(here), "10.00")
    assert_eq(there, "10.00")

test "a numeric NaN keeps its text rather than turning into a zero":
    conn := open_or_skip()
    mut got := ""
    for row in postgres.query(conn, "select 'NaN'::numeric as odd")!:
        got = row.text("odd")
    conn.close()
    assert_eq(got, "NaN")
