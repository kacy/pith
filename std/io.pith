fn buffered_bytes_reader_cache_get(handle: Int) -> Bytes:
    io_registry_mu.lock()
    mut result := bytes.empty()
    if buffered_bytes_reader_cache.contains_key(handle):
        # the bind takes its count while the lock is held, so a
        # concurrent take on another thread cannot free the value
        # between here and the caller
        result = buffered_bytes_reader_cache[handle]
    io_registry_mu.unlock()
    return result

fn buffered_bytes_reader_consume(handle: Int, consumed: Int):
    io_registry_mu.lock()
    cached := buffered_bytes_reader_cache.take(handle)
    buffered_bytes_reader_cache.insert(handle, cached.slice(consumed, cached.len()))
    io_registry_mu.unlock()

fn buffered_string_writer_cache_get(handle: Int) -> String:
    if buffered_string_writer_cache.contains_key(handle):
        return buffered_string_writer_cache[handle]
    return ""

fn buffered_bytes_writer_cache_get(handle: Int) -> Bytes:
    if buffered_bytes_writer_cache.contains_key(handle):
        return buffered_bytes_writer_cache[handle]
    return bytes.empty()

fn buffered_bytes_writer_should_flush(handle: Int) -> Bool:
    cached := buffered_bytes_writer_cache_get(handle)
    mut chunk_size := DEFAULT_CHUNK_SIZE
    if buffered_bytes_writer_chunk_sizes.contains_key(handle):
        chunk_size = buffered_bytes_writer_chunk_sizes[handle]
    return cached.len() >= chunk_size

fn buffered_string_writer_should_flush(handle: Int) -> Bool:
