fn decode_utf8(data: Bytes) -> String!:
    return data.to_string_utf8()!

fn encode_utf8(data: String) -> Bytes:
    return bytes.from_string_utf8(data)

fn tcp_stream_connect(host: String, port: Int) -> TcpStream!:
    return TcpStream(tcp_connect(host, port)!)

fn tcp_stream_from_fd(fd: Int) -> TcpStream:
    return TcpStream(fd)

fn tcp_stream_read(stream: TcpStream, max_bytes: Int) -> String!:
    return decode_utf8(tcp_stream_read_bytes(stream, max_bytes)!)

fn tcp_stream_read_bytes(stream: TcpStream, max_bytes: Int) -> Bytes!:
    return tcp_read_bytes(stream.fd, max_bytes)

fn tcp_stream_wait_readable(stream: TcpStream, timeout_ms: Int) -> Int:
    return tcp_wait_readable(stream.fd, timeout_ms)

fn tcp_stream_write(stream: TcpStream, data: String) -> Int!:
    return tcp_stream_write_bytes(stream, encode_utf8(data))

fn tcp_stream_write_bytes(stream: TcpStream, data: Bytes) -> Int!:
    return tcp_write_bytes(stream.fd, data)

fn tcp_stream_wait_writable(stream: TcpStream, timeout_ms: Int) -> Int:
    return tcp_wait_writable(stream.fd, timeout_ms)

fn tcp_stream_set_timeout(stream: TcpStream, ms: Int):
    tcp_set_timeout(stream.fd, ms)

fn tcp_stream_close(stream: TcpStream):
    tcp_close(stream.fd)

fn file_stream_open_read(path: String) -> FileStream!:
    return FileStream(file_open_read(path)!)

fn file_stream_open_write(path: String) -> FileStream!:
    return FileStream(file_open_write(path)!)

fn file_stream_open_append(path: String) -> FileStream!:
    return FileStream(file_open_append(path)!)

fn file_stream_read(stream: FileStream, max_bytes: Int) -> String!:
    return decode_utf8(file_stream_read_bytes(stream, max_bytes)!)

fn file_stream_read_bytes(stream: FileStream, max_bytes: Int) -> Bytes!:
    return file_read_bytes(stream.handle, max_bytes)

fn file_stream_write(stream: FileStream, data: String) -> Int!:
    return file_stream_write_bytes(stream, encode_utf8(data))

fn file_stream_write_bytes(stream: FileStream, data: Bytes) -> Int!:
    return file_write_bytes(stream.handle, data)

fn file_stream_close(stream: FileStream):
    file_close(stream.handle)

# spawn a shell command and return a process handle.
pub fn spawn_process(command: String) -> Process!:
    return Process(process_spawn(command)!)

fn process_stdin(process: Process) -> ProcessStdin:
    return ProcessStdin(process.handle)

fn process_stdout(process: Process) -> ProcessStdout:
    return ProcessStdout(process.handle)

fn process_stderr(process: Process) -> ProcessStderr:
    return ProcessStderr(process.handle)

fn process_stdin_write_bytes(writer: ProcessStdin, data: Bytes) -> Int!:
    return process_write_bytes(writer.handle, data)

fn process_stdout_read_bytes(reader: ProcessStdout, max_bytes: Int) -> Bytes!:
    return process_read_bytes(reader.handle, max_bytes)

fn process_stderr_read_bytes(reader: ProcessStderr, max_bytes: Int) -> Bytes!:
    return process_read_err_bytes(reader.handle, max_bytes)

fn process_stdin_write_worker(writer: ProcessStdin, data: String) -> Int!:
    return process_stdin_write(writer, data)

fn process_stdin_write_bytes_worker(writer: ProcessStdin, data: Bytes) -> Int!:
    return process_stdin_write_bytes(writer, data)

fn process_stdout_read_worker(reader: ProcessStdout, max_bytes: Int) -> String!:
    return process_stdout_read(reader, max_bytes)

fn process_stdout_read_bytes_worker(reader: ProcessStdout, max_bytes: Int) -> Bytes!:
    return process_stdout_read_bytes(reader, max_bytes)

fn process_stderr_read_worker(reader: ProcessStderr, max_bytes: Int) -> String!:
    return process_stderr_read(reader, max_bytes)

fn process_stderr_read_bytes_worker(reader: ProcessStderr, max_bytes: Int) -> Bytes!:
    return process_stderr_read_bytes(reader, max_bytes)

fn wait_process(process: Process) -> Int:
    return process_wait(process.handle)

fn kill_process(process: Process) -> Bool:
    return process_kill(process.handle)

fn close_process(process: Process):
    process_close(process.handle)

fn empty_string_parts() -> List[String]:
    return []

fn string_buffer_chunks(buf: StringBuffer) -> List[String]:
    if string_buffer_parts.contains_key(buf.handle):
        return string_buffer_parts[buf.handle]
    return empty_string_parts()

fn string_buffer_len(buf: StringBuffer) -> Int:
    if string_buffer_lengths.contains_key(buf.handle):
        return string_buffer_lengths[buf.handle]
    return 0

fn string_buffer_string(buf: StringBuffer) -> String:
    parts := string_buffer_chunks(buf)
    if parts.len() == 0:
        return ""
    if parts.len() == 1:
        return parts[0]
    return parts.join("")

fn string_buffer_write_line(buf: StringBuffer, data: String) -> Int!:
    wrote := string_buffer_write_internal(buf, data)
    if wrote.is_err:
        return wrote
    wrote_nl := string_buffer_write_internal(buf, chr(10))
    if wrote_nl.is_err:
        return wrote_nl
    return wrote.ok + wrote_nl.ok

fn string_buffer_reset(buf: StringBuffer):
    # see string_buffer_write_internal: clearing a closed buffer must not
    # re-register it.
    if not string_buffer_parts.contains_key(buf.handle):
        return
    string_buffer_parts.insert(buf.handle, empty_string_parts())
    string_buffer_lengths.insert(buf.handle, 0)

fn string_buffer_append_chunk(buf: StringBuffer, data: String):
    parts := string_buffer_chunks(buf)
    parts.push(data)
    string_buffer_parts.insert(buf.handle, parts)
    string_buffer_lengths.insert(buf.handle, string_buffer_len(buf) + data.len())

fn string_buffer_compact(buf: StringBuffer):
    parts := string_buffer_chunks(buf)
    if parts.len() <= 1:
        return
    joined := parts.join("")
    string_buffer_parts.insert(buf.handle, [joined])
    string_buffer_lengths.insert(buf.handle, joined.len())

fn string_buffer_maybe_compact(buf: StringBuffer):
    if string_buffer_chunks(buf).len() >= 32:
        string_buffer_compact(buf)

fn string_buffer_clear(buf: StringBuffer):
    string_buffer_reset(buf)

fn string_reader_read(reader: StringReader, max_bytes: Int) -> String!:
    return string_reader_read_internal(reader, max_bytes)

fn string_buffer_write(buf: StringBuffer, data: String) -> Int!:
    return string_buffer_write_internal(buf, data)

fn bytes_cursor_read(reader: BytesCursor, max_bytes: Int) -> Bytes!:
    return bytes_cursor_read_internal(reader, max_bytes)

fn buffered_bytes_reader_read(reader: BufferedBytesReader, max_bytes: Int) -> Bytes!:
    return buffered_bytes_reader_read_internal(reader, max_bytes)

fn buffered_bytes_writer_write(writer: BufferedBytesWriter, data: Bytes) -> Int!:
    return buffered_bytes_writer_write_internal(writer, data)

fn buffered_bytes_writer_flush(writer: BufferedBytesWriter) -> Int!:
    return buffered_bytes_writer_flush_internal(writer)

# read the rest of a string reader with the default chunk size.
pub fn read_all(reader: StringReader) -> String!:
    return read_all_string(reader)

# read the rest of a string reader with an explicit chunk size.
pub fn read_all_chunked(reader: StringReader, chunk_size: Int) -> String!:
    return read_all_string_chunked(reader, chunk_size)

# keep writing until the full string is written.
pub fn write_all(writer: StringBuffer, data: String) -> Int!:
    return write_all_string(writer, data)

# copy all text from a reader into a writer.
pub fn copy(reader: StringReader, writer: StringBuffer) -> Int!:
    return copy_string(reader, writer)

# copy all text from a reader into a writer with an explicit chunk size.
pub fn copy_chunked(reader: StringReader, writer: StringBuffer, chunk_size: Int) -> Int!:
    return copy_string_chunked(reader, writer, chunk_size)

# read the rest of a bytes reader with the default chunk size.
pub fn read_all_bytes(reader: BytesCursor) -> Bytes!:
    return read_all_bytes_cursor(reader)

# read exactly count bytes or fail with unexpected eof.
pub fn read_exact_bytes(reader: BytesCursor, count: Int) -> Bytes!:
    return read_exact_bytes_cursor(reader, count)

# read exactly count bytes from a buffered bytes reader.
pub fn read_exact_buffered_bytes(reader: BufferedBytesReader, count: Int) -> Bytes!:
    return read_exact_buffered_bytes_reader(reader, count)

# read the rest of a bytes reader with an explicit chunk size.
pub fn read_all_bytes_chunked(reader: BytesCursor, chunk_size: Int) -> Bytes!:
    return read_all_bytes_cursor_chunked(reader, chunk_size)

# keep writing until the full byte slice is written.
pub fn write_all_bytes(writer: ByteBuffer, data: Bytes) -> Int!:
    return write_all_byte_buffer(writer, data)

# copy all bytes from a reader into a byte buffer.
pub fn copy_bytes(reader: BytesCursor, writer: ByteBuffer) -> Int!:
    return copy_bytes_cursor(reader, writer)

# copy all bytes from a reader into a byte buffer with an explicit chunk size.
pub fn copy_bytes_chunked(reader: BytesCursor, writer: ByteBuffer, chunk_size: Int) -> Int!:
    return copy_bytes_cursor_chunked(reader, writer, chunk_size)

# copy exactly count characters from a string reader into a string buffer.
pub fn copy_n(reader: StringReader, writer: StringBuffer, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut total := 0
    mut remaining := count
    while remaining > 0:
        mut take := remaining
        if take > DEFAULT_CHUNK_SIZE:
            take = DEFAULT_CHUNK_SIZE
        chunk := reader.read(take)!
        if chunk.len() == 0:
            fail "unexpected eof"
        total = total + write_all_string(writer, chunk)!
        remaining = remaining - chunk.len()
    return total

# copy exactly count bytes from a bytes reader into a byte buffer.
pub fn copy_n_bytes(reader: BytesCursor, writer: ByteBuffer, count: Int) -> Int!:
    if count <= 0:
        return 0
    data := read_exact_bytes_cursor(reader, count)!
    return write_all_byte_buffer(writer, data)

# write at most count bytes from the input string.
#
# the count is in bytes, as every count in this module is, and it can land
# inside a multi-byte character. a character is never written in halves, so a
# count that falls inside one stops before it and the write is that much
# shorter — which is what "at most" already promised.
pub fn write_n(writer: StringBuffer, data: String, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut end := count
    if end > data.len():
        end = data.len()
    end = boundary_at_or_before(data, end, 0)
    return write_all_string(writer, data.substring(0, end))

# write at most count bytes from the input bytes.
pub fn write_n_bytes(writer: ByteBuffer, data: Bytes, count: Int) -> Int!:
    if count <= 0:
        return 0
    mut end := count
    if end > data.len():
        end = data.len()
    return write_all_byte_buffer(writer, data.slice(0, end))

# open a tcp client connection.
pub fn connect(host: String, port: Int) -> TcpStream!:
    return tcp_stream_connect(host, port)

# wrap an existing file descriptor as a tcp stream.
pub fn from_fd(fd: Int) -> TcpStream:
    return tcp_stream_from_fd(fd)

# set how long a read on this socket may wait, in milliseconds. a read that
# reaches the deadline with nothing to show for it fails; zero or less clears
# the deadline and puts the socket back to waiting indefinitely, which is what
# a socket that was never given one does.
#
# the deadline holds on both concurrency backends. see std.net.tcp.set_timeout.
pub fn set_timeout(stream: TcpStream, ms: Int):
    tcp_stream_set_timeout(stream, ms)

# get the writable stdin handle for a spawned process.
pub fn stdin(process: Process) -> ProcessStdin:
    return process_stdin(process)

# get the readable stdout handle for a spawned process.
pub fn stdout(process: Process) -> ProcessStdout:
    return process_stdout(process)

# get the readable stderr handle for a spawned process.
pub fn stderr(process: Process) -> ProcessStderr:
    return process_stderr(process)

# wait for a process to exit and return its exit code.
pub fn wait(process: Process) -> Int:
    return wait_process(process)

# request that a process be terminated.
pub fn kill(process: Process) -> Bool:
    return kill_process(process)

# write a full string to process stdin.
pub fn write_stdin(process: Process, data: String) -> Int!:
    return write_all_process_stdin(stdin(process), data)

# write raw bytes to process stdin.
pub fn write_stdin_bytes(process: Process, data: Bytes) -> Int!:
    return write_all_process_stdin_bytes(stdin(process), data)

# read all text from process stdout.
pub fn read_stdout(process: Process) -> String!:
    return read_all_process_stdout(stdout(process))

# read all text from process stdout with an explicit chunk size.
pub fn read_stdout_chunked(process: Process, chunk_size: Int) -> String!:
    return read_all_process_stdout_chunked(stdout(process), chunk_size)

# read all bytes from process stdout.
pub fn read_stdout_bytes(process: Process) -> Bytes!:
    return read_all_process_stdout_bytes(stdout(process))

# read all bytes from process stdout with an explicit chunk size.
pub fn read_stdout_bytes_chunked(process: Process, chunk_size: Int) -> Bytes!:
    return read_all_process_stdout_bytes_chunked(stdout(process), chunk_size)

# read all text from process stderr.
pub fn read_stderr(process: Process) -> String!:
    return read_all_process_stderr(stderr(process))

# read all bytes from process stderr.
pub fn read_stderr_bytes(process: Process) -> Bytes!:
    return read_all_process_stderr_bytes(stderr(process))

# read all bytes from process stderr with an explicit chunk size.
pub fn read_stderr_bytes_chunked(process: Process, chunk_size: Int) -> Bytes!:
    return read_all_process_stderr_bytes_chunked(stderr(process), chunk_size)

# read all text from process stderr with an explicit chunk size.
pub fn read_stderr_chunked(process: Process, chunk_size: Int) -> String!:
    return read_all_process_stderr_chunked(stderr(process), chunk_size)

# read the rest of a file stream as text.
pub fn read_text(stream: FileStream) -> String!:
    return read_all_file_stream(stream)

# read the rest of a file stream as text with an explicit chunk size.
pub fn read_text_chunked(stream: FileStream, chunk_size: Int) -> String!:
    return read_all_file_stream_chunked(stream, chunk_size)

# write a full string to a file stream.
pub fn write_text(stream: FileStream, data: String) -> Int!:
    return write_all_file_stream(stream, data)

# close a file stream handle.
pub fn close_file(stream: FileStream):
    file_stream_close(stream)

fn buffered_string_reader_read(reader: BufferedStringReader, max_bytes: Int) -> String!:
    return buffered_string_reader_read_internal(reader, max_bytes)

fn buffered_string_reader_read_line(reader: BufferedStringReader) -> String!:
    return buffered_string_reader_read_line_internal(reader)

fn buffered_string_writer_write(writer: BufferedStringWriter, data: String) -> Int!:
    return buffered_string_writer_write_internal(writer, data)

fn buffered_string_writer_flush(writer: BufferedStringWriter) -> Int!:
    return buffered_string_writer_flush_internal(writer)

fn buffered_tcp_stream_read(reader: BufferedTcpStream, max_bytes: Int) -> String!:
    return buffered_tcp_stream_read_internal(reader, max_bytes)

fn buffered_tcp_stream_read_line(reader: BufferedTcpStream) -> String!:
    return buffered_tcp_stream_read_line_internal(reader)

fn buffered_tcp_writer_write(writer: BufferedTcpWriter, data: String) -> Int!:
    return buffered_tcp_writer_write_internal(writer, data)

fn buffered_tcp_writer_flush(writer: BufferedTcpWriter) -> Int!:
    return buffered_tcp_writer_flush_internal(writer)

fn buffered_file_reader_read(reader: BufferedFileReader, max_bytes: Int) -> String!:
    return buffered_file_reader_read_internal(reader, max_bytes)

fn buffered_file_reader_read_line(reader: BufferedFileReader) -> String!:
    return buffered_file_reader_read_line_internal(reader)

fn buffered_file_writer_write(writer: BufferedFileWriter, data: String) -> Int!:
    return buffered_file_writer_write_internal(writer, data)

fn buffered_file_writer_flush(writer: BufferedFileWriter) -> Int!:
    return buffered_file_writer_flush_internal(writer)

fn buffered_process_stdout_read(reader: BufferedProcessStdout, max_bytes: Int) -> String!:
    return buffered_process_stdout_read_internal(reader, max_bytes)

fn buffered_process_stdout_read_line(reader: BufferedProcessStdout) -> String!:
    return buffered_process_stdout_read_line_internal(reader)

fn buffered_process_stderr_read(reader: BufferedProcessStderr, max_bytes: Int) -> String!:
    return buffered_process_stderr_read_internal(reader, max_bytes)

fn buffered_process_stderr_read_line(reader: BufferedProcessStderr) -> String!:
    return buffered_process_stderr_read_line_internal(reader)

fn process_stdin_write(writer: ProcessStdin, data: String) -> Int!:
    return process_stdin_write_bytes(writer, encode_utf8(data))

fn process_stdout_read(reader: ProcessStdout, max_bytes: Int) -> String!:
    return decode_utf8(process_stdout_read_bytes(reader, max_bytes)!)

fn process_stderr_read(reader: ProcessStderr, max_bytes: Int) -> String!:
    return decode_utf8(process_stderr_read_bytes(reader, max_bytes)!)

fn normalized_chunk_size(chunk_size: Int) -> Int:
    if chunk_size <= 0:
        return DEFAULT_CHUNK_SIZE
    return chunk_size

fn context_blocking_error(ctx: Context) -> BlockingError:
    if ctx.error_code() == 2:
        return blocking_deadline_exceeded()
    return blocking_cancelled()

fn context_wait_slice_ms(ctx: Context) -> Int:
    deadline := ctx.deadline_ms
    if deadline < 0:
        return 10
    remaining := deadline - time.now()
    if remaining <= 0:
        return 0
    if remaining < 10:
        return remaining
    return 10

fn tcp_stream_read_bytes_ctx(stream: TcpStream, ctx: Context, max_bytes: Int) -> Bytes!BlockingError:
    while true:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        waited := tcp_stream_wait_readable(stream, context_wait_slice_ms(ctx))
        if waited > 0:
            chunk := tcp_stream_read_bytes(stream, max_bytes)
            if chunk.is_err:
                fail blocking_failed(chunk.err)
            return chunk.ok
        if waited < 0:
            fail blocking_failed("tcp read wait failed")

fn tcp_stream_read_ctx(stream: TcpStream, ctx: Context, max_bytes: Int) -> String!BlockingError:
    bytes_result := tcp_stream_read_bytes_ctx(stream, ctx, max_bytes)
    if bytes_result.is_err:
        fail bytes_result.err
    text := decode_utf8(bytes_result.ok)
    if text.is_err:
        fail blocking_failed(text.err)
    return text.ok

fn tcp_stream_write_bytes_ctx(stream: TcpStream, ctx: Context, data: Bytes) -> Int!BlockingError:
    while true:
        if ctx.is_cancelled():
            fail context_blocking_error(ctx)
        waited := tcp_stream_wait_writable(stream, context_wait_slice_ms(ctx))
        if waited > 0:
            wrote := tcp_stream_write_bytes(stream, data)
            if wrote.is_err:
                fail blocking_failed(wrote.err)
            return wrote.ok
        if waited < 0:
            fail blocking_failed("tcp write wait failed")

fn tcp_stream_write_ctx(stream: TcpStream, ctx: Context, data: String) -> Int!BlockingError:
    return tcp_stream_write_bytes_ctx(stream, ctx, encode_utf8(data))

fn allocate_string_reader_handle(data: String) -> Int:
    handle := next_string_reader_handle
    next_string_reader_handle = next_string_reader_handle + 1
    string_reader_data.insert(handle, data)
    string_reader_offsets.insert(handle, 0)
    return handle

fn allocate_string_buffer_handle() -> Int:
    handle := next_string_buffer_handle
    next_string_buffer_handle = next_string_buffer_handle + 1
    string_buffer_parts.insert(handle, empty_string_parts())
    string_buffer_lengths.insert(handle, 0)
    return handle

fn allocate_bytes_reader_handle(data: Bytes) -> Int:
    handle := next_bytes_reader_handle
    next_bytes_reader_handle = next_bytes_reader_handle + 1
    bytes_reader_data.insert(handle, data)
    bytes_reader_offsets.insert(handle, 0)
    return handle

fn allocate_buffered_bytes_reader_handle(source_kind: Int, source_handle: Int, chunk_size: Int) -> Int:
    io_registry_mu.lock()
    handle := next_buffered_bytes_reader_handle
    next_buffered_bytes_reader_handle = next_buffered_bytes_reader_handle + 1
    buffered_bytes_reader_source_kinds.insert(handle, source_kind)
    buffered_bytes_reader_source_handles.insert(handle, source_handle)
    buffered_bytes_reader_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_bytes_reader_cache.insert(handle, bytes.empty())
    io_registry_mu.unlock()
    return handle

fn make_buffered_bytes_reader(source_kind: Int, source_handle: Int, chunk_size: Int) -> BufferedBytesReader:
    return BufferedBytesReader(allocate_buffered_bytes_reader_handle(source_kind, source_handle, chunk_size))

## drop a buffered reader's registry entries. a long-running process
## must free readers when the stream is done, or every request's
## buffers stay reachable forever.
pub fn free_buffered_bytes_reader(reader: BufferedBytesReader):
    io_registry_mu.lock()
    buffered_bytes_reader_cache.remove(reader.handle)
    buffered_bytes_reader_source_kinds.remove(reader.handle)
    buffered_bytes_reader_source_handles.remove(reader.handle)
    buffered_bytes_reader_chunk_sizes.remove(reader.handle)
    io_registry_mu.unlock()

## drop a buffered writer's registry entries; the counterpart of
## free_buffered_bytes_reader for the write side.
pub fn free_buffered_bytes_writer(writer: BufferedBytesWriter):
    io_registry_mu.lock()
    buffered_bytes_writer_cache.remove(writer.handle)
    buffered_bytes_writer_target_kinds.remove(writer.handle)
    buffered_bytes_writer_target_handles.remove(writer.handle)
    buffered_bytes_writer_chunk_sizes.remove(writer.handle)
    io_registry_mu.unlock()

fn allocate_buffered_bytes_writer_handle(target_kind: Int, target_handle: Int, chunk_size: Int) -> Int:
    io_registry_mu.lock()
    handle := next_buffered_bytes_writer_handle
    next_buffered_bytes_writer_handle = next_buffered_bytes_writer_handle + 1
    buffered_bytes_writer_target_kinds.insert(handle, target_kind)
    buffered_bytes_writer_target_handles.insert(handle, target_handle)
    buffered_bytes_writer_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_bytes_writer_cache.insert(handle, bytes.empty())
    io_registry_mu.unlock()
    return handle

fn make_buffered_bytes_writer(target_kind: Int, target_handle: Int, chunk_size: Int) -> BufferedBytesWriter:
    return BufferedBytesWriter(allocate_buffered_bytes_writer_handle(target_kind, target_handle, chunk_size))

# register a buffered text reader over `source` and hand back its handle.
#
# one allocator, and so one handle space, for all five reader kinds — the
# wrapper structs stay distinct types, but underneath they are the same reader.
fn allocate_buffered_text_reader_handle(kind: Int, source: Int, chunk_size: Int) -> Int:
    handle := next_buffered_text_reader_handle
    next_buffered_text_reader_handle = next_buffered_text_reader_handle + 1
    buffered_text_reader_kinds.insert(handle, kind)
    buffered_text_reader_sources.insert(handle, source)
    buffered_text_reader_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_text_reader_cache.insert(handle, "")
    buffered_text_reader_cursors.insert(handle, 0)
    buffered_text_reader_partials.insert(handle, bytes.empty())
    return handle

fn allocate_buffered_string_reader_handle(source_handle: Int, chunk_size: Int) -> Int:
    return allocate_buffered_text_reader_handle(TEXT_SOURCE_STRING, source_handle, chunk_size)

fn allocate_buffered_string_writer_handle(target_handle: Int, chunk_size: Int) -> Int:
    handle := next_buffered_string_writer_handle
    next_buffered_string_writer_handle = next_buffered_string_writer_handle + 1
    buffered_string_writer_targets.insert(handle, target_handle)
    buffered_string_writer_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_string_writer_cache.insert(handle, "")
    return handle

fn allocate_buffered_tcp_stream_handle(fd: Int, chunk_size: Int) -> Int:
    return allocate_buffered_text_reader_handle(TEXT_SOURCE_TCP, fd, chunk_size)

fn allocate_buffered_tcp_writer_handle(fd: Int, chunk_size: Int) -> Int:
    handle := next_buffered_tcp_writer_handle
    next_buffered_tcp_writer_handle = next_buffered_tcp_writer_handle + 1
    buffered_tcp_writer_fds.insert(handle, fd)
    buffered_tcp_writer_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_tcp_writer_cache.insert(handle, "")
    return handle

fn allocate_buffered_file_reader_handle(file_handle: Int, chunk_size: Int) -> Int:
    return allocate_buffered_text_reader_handle(TEXT_SOURCE_FILE, file_handle, chunk_size)

fn allocate_buffered_file_writer_handle(file_handle: Int, chunk_size: Int) -> Int:
    handle := next_buffered_file_writer_handle
    next_buffered_file_writer_handle = next_buffered_file_writer_handle + 1
    buffered_file_writer_handles.insert(handle, file_handle)
    buffered_file_writer_chunk_sizes.insert(handle, normalized_chunk_size(chunk_size))
    buffered_file_writer_cache.insert(handle, "")
    return handle

fn allocate_buffered_process_stdout_handle(process_handle: Int, chunk_size: Int) -> Int:
    return allocate_buffered_text_reader_handle(TEXT_SOURCE_PROCESS_STDOUT, process_handle, chunk_size)

fn allocate_buffered_process_stderr_handle(process_handle: Int, chunk_size: Int) -> Int:
    return allocate_buffered_text_reader_handle(TEXT_SOURCE_PROCESS_STDERR, process_handle, chunk_size)

# --- deregistration ---------------------------------------------------------
#
# every reader, buffer and cursor above is a handle into threadlocal maps, and
# a handle is never reissued, so an entry that is not removed lives for the
# rest of the thread. close() on each type removes its entries; a second close
# finds nothing and is a no-op. closing a buffered reader or writer releases
# its registry state only — the stream, buffer or process underneath is closed
# by whoever built it.

fn close_string_reader_state(handle: Int):
    string_reader_data.remove(handle)
    string_reader_offsets.remove(handle)

fn close_string_buffer_state(handle: Int):
    string_buffer_parts.remove(handle)
    string_buffer_lengths.remove(handle)

fn close_bytes_cursor_state(handle: Int):
    bytes_reader_data.remove(handle)
    bytes_reader_offsets.remove(handle)

# one remover for all five text-reader kinds, matching their one allocator.
fn close_buffered_text_reader_state(handle: Int):
    buffered_text_reader_partials.remove(handle)
    buffered_text_reader_cache.remove(handle)
    buffered_text_reader_kinds.remove(handle)
    buffered_text_reader_sources.remove(handle)
    buffered_text_reader_chunk_sizes.remove(handle)
    buffered_text_reader_cursors.remove(handle)

fn close_buffered_string_writer_state(handle: Int):
    buffered_string_writer_cache.remove(handle)
    buffered_string_writer_targets.remove(handle)
    buffered_string_writer_chunk_sizes.remove(handle)

fn close_buffered_tcp_writer_state(handle: Int):
    buffered_tcp_writer_cache.remove(handle)
    buffered_tcp_writer_fds.remove(handle)
    buffered_tcp_writer_chunk_sizes.remove(handle)

fn close_buffered_file_writer_state(handle: Int):
    buffered_file_writer_cache.remove(handle)
    buffered_file_writer_handles.remove(handle)
    buffered_file_writer_chunk_sizes.remove(handle)

fn remaining_after_write(data: String, wrote: Int) -> String:
    if wrote >= data.len():
        return ""
    return data.substring(wrote, data.len())

# drop the CR of a CRLF line ending.
#
# the test reads the last byte rather than slicing it off: a String is indexed
# in bytes, and `substring(len - 1, len)` on a line ending in any non-ascii
# character asks for the tail of a multi-byte character, which is a hard error.
# a line ending in "é" is ordinary text, so it must not stop the process.
fn trim_trailing_cr(line: String) -> String:
    if line.len() == 0:
        return ""
    end := line.len()
    if ord(line[end - 1]) == 13:
        return line.substring(0, end - 1)
    return line

# --- character boundaries ---------------------------------------------------
#
# every read and every write here is counted in bytes, and a String is indexed
# in bytes, so the byte a transfer stops at is whatever byte the count landed
# on — which can be inside a multi-byte character. slicing a String there is a
# runtime trap that no catch can intercept, so nothing below stops at a byte
# count without first moving to the character boundary beside it.
#
# the walk is over raw bytes and needs no unicode tables: in utf-8 a byte in
# 0x80..0xBF continues a character and every other byte starts one, so the
# boundary next to any offset is at most three bytes away.

# true when the byte at `at` continues a character rather than starting one.
fn continues_character(data: String, at: Int) -> Bool:
    code := ord(data[at])
    return code >= 128 and code < 192

# the character boundary at or before `at`, and never before `floor`.
#
# `at` may be `data.len()`, which is a boundary and is not read.
fn boundary_at_or_before(data: String, at: Int, floor: Int) -> Int:
    mut back := at
    while back > floor and back < data.len() and continues_character(data, back):
        back = back - 1
    return back

# the character boundary at or after `at`.
fn boundary_at_or_after(data: String, at: Int) -> Int:
    mut ahead := at
    while ahead < data.len() and continues_character(data, ahead):
        ahead = ahead + 1
    return ahead

# where a read that asked to stop at byte `at` stops instead.
#
# the boundary before `at` keeps the read inside what was asked for. when that
# boundary is the read's own start the read would come back empty, and an empty
# read is how every caller here recognises end of stream, so a read that would
# make no progress takes the whole character instead of none of it.
fn read_stop(data: String, start: Int, at: Int) -> Int:
    stop := boundary_at_or_before(data, at, start)
    if stop > start:
        return stop
    return boundary_at_or_after(data, at)

# byte offset of the first newline at or after `start`, or -1.
#
# `ord(data[i])` reads the byte in place. comparing `data[i]` against a
# one-character string instead would allocate a fresh string per byte scanned,
# which on a 4 KiB buffer is 4096 allocations to find one newline.
fn find_newline_from(data: String, start: Int) -> Int:
    mut i := start
    while i < data.len():
        if ord(data[i]) == 10:
            return i
        i = i + 1
    return 0 - 1

# byte offset of the first occurrence of `sep` at or after `start`, or -1.
#
# `index_of` searches a String from the beginning, so scanning a buffer from a
# cursor with it would need the tail sliced out first — the copy the cursor
# exists to avoid.
fn find_sep_from(data: String, sep: String, start: Int) -> Int:
    if sep.len() == 0:
        return 0 - 1
    first := ord(sep[0])
    mut i := start
    limit := data.len() - sep.len()
    while i <= limit:
        if ord(data[i]) == first:
            mut j := 1
            while j < sep.len():
                if ord(data[i + j]) != ord(sep[j]):
                    break
                j = j + 1
            if j == sep.len():
                return i
        i = i + 1
    return 0 - 1

fn find_bytes_sep(data: Bytes, sep: Bytes) -> Int:
    return bytes.index_of(data, sep)

# read one chunk from whichever source `kind` names, as raw bytes.
#
# the five sources are the only thing that ever differed between the `read_all`
# loops and between the buffered readers' fills, so naming the source with a tag
# leaves one copy of each loop instead of one per source.
#
# the chunk comes back as bytes and not as text. four of these sources are byte
# streams that only become text because something decoded them, and `size` bytes
# off a stream end wherever the count lands — including halfway through a
# character, which is not a decodable chunk on its own. so the decode belongs to
# the caller, which knows where it wants its boundaries.
#
# a string reader is the exception: its data is already text, so it slices on a
# boundary itself and what comes back is always whole.
fn text_source_read_bytes(kind: Int, source: Int, size: Int) -> Bytes!:
    if kind == TEXT_SOURCE_STRING:
        return encode_utf8(string_reader_read(StringReader(source), size)!)
    elif kind == TEXT_SOURCE_TCP:
        return tcp_stream_read_bytes(TcpStream(source), size)
    elif kind == TEXT_SOURCE_FILE:
        return file_stream_read_bytes(FileStream(source), size)
    elif kind == TEXT_SOURCE_PROCESS_STDOUT:
        return process_stdout_read_bytes(ProcessStdout(source), size)
    elif kind == TEXT_SOURCE_PROCESS_STDERR:
        return process_stderr_read_bytes(ProcessStderr(source), size)
    return bytes.empty()

# the deadline-aware twin of `text_source_read_bytes`.
#
# this cannot be folded into the function above: the error type is part of the
# signature, and the context has to reach the read itself so a blocked source
# gives up when the deadline passes rather than when the peer eventually speaks.
# a string reader and a file never block, so neither takes a context.
fn text_source_read_bytes_ctx(kind: Int, source: Int, ctx: Context, size: Int) -> Bytes!BlockingError:
    if kind == TEXT_SOURCE_TCP:
        return tcp_stream_read_bytes_ctx(TcpStream(source), ctx, size)
    elif kind == TEXT_SOURCE_PROCESS_STDOUT:
        return process_stdout_read_bytes_ctx(ProcessStdout(source), ctx, size)
    elif kind == TEXT_SOURCE_PROCESS_STDERR:
        return process_stderr_read_bytes_ctx(ProcessStderr(source), ctx, size)
    return bytes.empty()

# drain a source to end-of-stream.
#
# the bytes are gathered and decoded once at the end. decoding each chunk as it
# arrived would reject the whole read whenever a chunk boundary fell inside a
# character, which is an ordinary thing for a 4 KiB read of ordinary text to do:
# a utf-8 file with one accent in it was unreadable through this path whenever
# the accent straddled the boundary. a character split across two chunks is not
# a decode error, it is two chunks.
fn read_all_text_source(kind: Int, source: Int, chunk_size: Int) -> String!:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    mut chunk := text_source_read_bytes(kind, source, size)!
    while not chunk.is_empty():
        buf.write(chunk)!
        chunk = text_source_read_bytes(kind, source, size)!
    return buf.bytes().to_string_utf8()!

# the deadline-aware twin of `read_all_text_source`.
fn read_all_text_source_ctx(kind: Int, source: Int, ctx: Context, chunk_size: Int) -> String!BlockingError:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    mut chunk := text_source_read_bytes_ctx(kind, source, ctx, size)!
    while not chunk.is_empty():
        written := buf.write(chunk)
        if written.is_err:
            fail blocking_failed(written.err)
        chunk = text_source_read_bytes_ctx(kind, source, ctx, size)!
    decoded := buf.bytes().to_string_utf8()
    if decoded.is_err:
        fail blocking_failed(decoded.err)
    return decoded.ok

fn read_all_string(reader: StringReader) -> String!:
    return read_all_string_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_string_chunked(reader: StringReader, chunk_size: Int) -> String!:
    return read_all_text_source(TEXT_SOURCE_STRING, reader.handle, chunk_size)

fn write_all_string(writer: StringBuffer, data: String) -> Int!:
    mut total := 0
    mut remaining := data
    while remaining.len() > 0:
        wrote := writer.write(remaining)!
        if wrote <= 0:
            fail "write returned 0"
        total = total + wrote
        remaining = remaining_after_write(remaining, wrote)
    return total

# the text write_all loops all resume through their bytes counterpart rather
# than re-slicing the String. a write stops at whatever byte offset the send
# buffer or the pipe ran out at, and that offset can be in the middle of a
# multi-byte character — which a String cannot be cut at, so resuming as text
# would stop the process on the first non-ascii payload big enough to be split.
fn write_all_tcp_stream(writer: TcpStream, data: String) -> Int!:
    return write_all_tcp_stream_bytes(writer, encode_utf8(data))

fn write_all_tcp_stream_ctx(writer: TcpStream, ctx: Context, data: String) -> Int!BlockingError:
    return write_all_tcp_stream_bytes_ctx(writer, ctx, encode_utf8(data))

fn write_all_file_stream(writer: FileStream, data: String) -> Int!:
    return write_all_file_stream_bytes(writer, encode_utf8(data))

fn copy_string(reader: StringReader, writer: StringBuffer) -> Int!:
    return copy_string_chunked(reader, writer, DEFAULT_CHUNK_SIZE)

fn copy_string_chunked(reader: StringReader, writer: StringBuffer, chunk_size: Int) -> Int!:
    size := normalized_chunk_size(chunk_size)
    mut total := 0
    mut chunk := reader.read(size)!
    while chunk.len() > 0:
        total = total + write_all_string(writer, chunk)!
        chunk = reader.read(size)!
    return total

fn read_all_tcp_stream(stream: TcpStream) -> String!:
    return read_all_tcp_stream_chunked(stream, DEFAULT_CHUNK_SIZE)

fn read_all_tcp_stream_chunked(stream: TcpStream, chunk_size: Int) -> String!:
    return read_all_text_source(TEXT_SOURCE_TCP, stream.fd, chunk_size)

fn read_all_tcp_stream_ctx(stream: TcpStream, ctx: Context) -> String!BlockingError:
    return read_all_tcp_stream_chunked_ctx(stream, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_tcp_stream_chunked_ctx(stream: TcpStream, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(TEXT_SOURCE_TCP, stream.fd, ctx, chunk_size)

fn read_all_file_stream(stream: FileStream) -> String!:
    return read_all_file_stream_chunked(stream, DEFAULT_CHUNK_SIZE)

fn read_all_file_stream_chunked(stream: FileStream, chunk_size: Int) -> String!:
    return read_all_text_source(TEXT_SOURCE_FILE, stream.handle, chunk_size)

# read a whole file as text.
#
# one call, not a stream: the whole file is coming into memory either way, and
# under the green backend every open and every chunk read is a separate handoff
# to the runtime's file thread pool. use the chunked variant when the file is
# big enough that reading it in pieces is the point.
#
# fails on a file that is not valid utf-8, the same as `fs.read`. reading bytes
# that are not text is what `read_file_bytes` is for.
pub fn read_file_text(path: String) -> String!:
    return read_file(path)

# read a whole file as text with an explicit chunk size.
pub fn read_file_text_chunked(path: String, chunk_size: Int) -> String!:
    stream := file_stream_open_read(path)!
    defer stream.close()
    return read_all_file_stream_chunked(stream, chunk_size)

# write text to a file, replacing existing contents. returns the bytes written.
#
# one call for the same reason `read_file_text` is one call. the write either
# lands whole or fails, so on success the count is the length of what was
# handed in.
pub fn write_file_text(path: String, data: String) -> Int!:
    write_file(path, data)!
    return data.len()

# write text to a file with an explicit chunk size.
pub fn write_file_text_chunked(path: String, data: String, chunk_size: Int) -> Int!:
    stream := file_stream_open_write(path)!
    defer stream.close()
    writer := stream.buffered_writer_chunked(chunk_size)
    # `write` already counts everything it accepted, whether it went to the file
    # or into the buffer. flush moves the buffered part along and reports it a
    # second time, so adding the two counts a small payload twice — the flush is
    # here to write and to surface its error, not for its number.
    total := writer.write(data)!
    writer.flush()!
    return total

# append text to a file. returns the bytes written.
pub fn append_file_text(path: String, data: String) -> Int!:
    append_file(path, data)!
    return data.len()

# append text to a file with an explicit chunk size.
pub fn append_file_text_chunked(path: String, data: String, chunk_size: Int) -> Int!:
    stream := file_stream_open_append(path)!
    defer stream.close()
    writer := stream.buffered_writer_chunked(chunk_size)
    # see `write_file_text_chunked`: the flush is for its effect, not its count.
    total := writer.write(data)!
    writer.flush()!
    return total

fn write_all_process_stdin(writer: ProcessStdin, data: String) -> Int!:
    return write_all_process_stdin_bytes(writer, encode_utf8(data))

fn read_all_process_stdout(reader: ProcessStdout) -> String!:
    return read_all_process_stdout_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_process_stdout_chunked(reader: ProcessStdout, chunk_size: Int) -> String!:
    return read_all_text_source(TEXT_SOURCE_PROCESS_STDOUT, reader.handle, chunk_size)

fn read_all_process_stderr(reader: ProcessStderr) -> String!:
    return read_all_process_stderr_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_process_stderr_chunked(reader: ProcessStderr, chunk_size: Int) -> String!:
    return read_all_text_source(TEXT_SOURCE_PROCESS_STDERR, reader.handle, chunk_size)

fn process_stdin_write_ctx(writer: ProcessStdin, ctx: Context, data: String) -> Int!BlockingError:
    task := spawn process_stdin_write_worker(writer, data)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    wrote := await task
    if wrote.is_err:
        fail blocking_failed(wrote.err)
    return wrote.ok

fn write_all_process_stdin_ctx(writer: ProcessStdin, ctx: Context, data: String) -> Int!BlockingError:
    return write_all_process_stdin_bytes_ctx(writer, ctx, encode_utf8(data))

fn process_stdout_read_ctx(reader: ProcessStdout, ctx: Context, max_bytes: Int) -> String!BlockingError:
    task := spawn process_stdout_read_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stdout_ctx(reader: ProcessStdout, ctx: Context) -> String!BlockingError:
    return read_all_process_stdout_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stdout_chunked_ctx(reader: ProcessStdout, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(TEXT_SOURCE_PROCESS_STDOUT, reader.handle, ctx, chunk_size)

fn process_stderr_read_ctx(reader: ProcessStderr, ctx: Context, max_bytes: Int) -> String!BlockingError:
    task := spawn process_stderr_read_worker(reader, max_bytes)
    while not task.is_done():
        if ctx.is_cancelled():
            task.detach()
            fail context_blocking_error(ctx)
        time.delay(1)
    read := await task
    # the worker can finish the same instant the deadline fires: `is_done()`
    # then wins the poll before the cancel is seen, so a read that came back
    # empty only because it would have blocked is about to be mistaken for a
    # clean end-of-stream. when the context is cancelled and nothing was read,
    # it is the deadline, not eof.
    if ctx.is_cancelled() and (read.is_err or read.ok.len() == 0):
        fail context_blocking_error(ctx)
    if read.is_err:
        fail blocking_failed(read.err)
    return read.ok

fn read_all_process_stderr_ctx(reader: ProcessStderr, ctx: Context) -> String!BlockingError:
    return read_all_process_stderr_chunked_ctx(reader, ctx, DEFAULT_CHUNK_SIZE)

fn read_all_process_stderr_chunked_ctx(reader: ProcessStderr, ctx: Context, chunk_size: Int) -> String!BlockingError:
    return read_all_text_source_ctx(TEXT_SOURCE_PROCESS_STDERR, reader.handle, ctx, chunk_size)

fn string_reader_read_internal(reader: StringReader, max_bytes: Int) -> String!:
    if max_bytes <= 0:
        return ""
    if not string_reader_data.contains_key(reader.handle):
        return ""

    data := string_reader_data[reader.handle]
    mut offset := 0
    if string_reader_offsets.contains_key(reader.handle):
        offset = string_reader_offsets[reader.handle]
    if offset >= data.len():
        return ""

    mut end := offset + max_bytes
    if end > data.len():
        end = data.len()
    # the count can land inside a character; the read stops beside it. this is
    # the one text source that slices rather than decoding, so it is the one
    # that has to do this for itself — the others come back as bytes and are
    # decoded a whole character at a time.
    end = read_stop(data, offset, end)
    chunk := data.substring(offset, end)
    string_reader_offsets.insert(reader.handle, end)
    return chunk

fn string_buffer_write_internal(buf: StringBuffer, data: String) -> Int!:
    if data.len() == 0:
        return 0
    # a closed buffer stays closed: writing must not re-create the registry
    # entries close() removed, so it reports nothing written instead.
    if not string_buffer_parts.contains_key(buf.handle):
        return 0
    string_buffer_append_chunk(buf, data)
    string_buffer_maybe_compact(buf)
    return data.len()

fn bytes_after_write(data: Bytes, wrote: Int) -> Bytes:
    if wrote >= data.len():
        return bytes.empty()
    return data.slice(wrote, data.len())

fn bytes_cursor_read_internal(reader: BytesCursor, max_bytes: Int) -> Bytes!:
    if max_bytes <= 0:
        return bytes.empty()
    if not bytes_reader_data.contains_key(reader.handle):
        return bytes.empty()

    data := bytes_reader_data[reader.handle]
    mut offset := 0
    if bytes_reader_offsets.contains_key(reader.handle):
        offset = bytes_reader_offsets[reader.handle]
    if offset >= data.len():
        return bytes.empty()

    mut end := offset + max_bytes
    if end > data.len():
        end = data.len()
    chunk := data.slice(offset, end)
    bytes_reader_offsets.insert(reader.handle, end)
    return chunk

fn write_all_byte_buffer(writer: ByteBuffer, data: Bytes) -> Int!:
    mut total := 0
    mut remaining := data
    while remaining.len() > 0:
        wrote := writer.write_bytes(remaining)!
        if wrote <= 0:
            fail "write returned 0"
        total = total + wrote
        remaining = bytes_after_write(remaining, wrote)
    return total

fn copy_bytes_cursor(reader: BytesCursor, writer: ByteBuffer) -> Int!:
    return copy_bytes_cursor_chunked(reader, writer, DEFAULT_CHUNK_SIZE)

fn copy_bytes_cursor_chunked(reader: BytesCursor, writer: ByteBuffer, chunk_size: Int) -> Int!:
    size := normalized_chunk_size(chunk_size)
    mut total := 0
    mut chunk := reader.read_bytes(size)!
    while not chunk.is_empty():
        total = total + writer.write_bytes(chunk)!
        chunk = reader.read_bytes(size)!
    return total

fn read_all_bytes_cursor(reader: BytesCursor) -> Bytes!:
    return read_all_bytes_cursor_chunked(reader, DEFAULT_CHUNK_SIZE)

fn read_all_bytes_cursor_chunked(reader: BytesCursor, chunk_size: Int) -> Bytes!:
    size := normalized_chunk_size(chunk_size)
    buf := bytes.buffer_with_capacity(size)
    mut chunk := reader.read_bytes(size)!
    while not chunk.is_empty():
        buf.write(chunk)!
        chunk = reader.read_bytes(size)!
    return buf.take_bytes()

