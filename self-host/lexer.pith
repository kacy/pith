# lexer.pith — pith lexer written in pith
#
# the first self-hosted component. reads a .pith source file and prints
# the token stream in the same format as `pith lex`.
#
# usage: pith run self-host/lexer.pith <file.pith>
# import: from lexer import Token, init_lexer, lex_all

# ---------------------------------------------------------------
# token type
# ---------------------------------------------------------------

pub struct Token:
    pub kind: String
    pub value: String
    pub current_line: Int
    pub current_column: Int
    # byte offset of the first character and byte length of the lexeme;
    # zero-length for synthesized and end-of-input tokens
    pub offset: Int
    pub len: Int

mut LBRACE := ""
mut RBRACE := ""

# ---------------------------------------------------------------
# helpers
# ---------------------------------------------------------------

fn is_alpha(character: String) -> Bool:
    if character.len() == 0:
        return false
    code := ord(character)
    if code >= 97:
        if code <= 122:
            return true
    if code >= 65:
        if code <= 90:
            return true
    if character == "_":
        return true
    return false

fn is_digit(character: String) -> Bool:
    if character.len() == 0:
        return false
    code := ord(character)
    if code >= 48:
        if code <= 57:
            return true
    return false

fn is_alnum(character: String) -> Bool:
    return is_alpha(character) or is_digit(character)

fn is_hex_digit(character: String) -> Bool:
    if is_digit(character):
        return true
    if character.len() == 0:
        return false
    code := ord(character)
    if code >= 97:
        if code <= 102:
            return true
    if code >= 65:
        if code <= 70:
            return true
    return false

fn is_octal_char(c: String) -> Bool:
    if c == "_":
        return true
    if c.len() == 0:
        return false
    code := ord(c)
    if code >= 48:
        if code <= 55:
            return true
    return false

fn is_lbrace(character: String) -> Bool:
    if character.len() == 0:
        return false
    if LBRACE.len() == 0:
        return false
    return ord(character) == ord(LBRACE)

fn is_rbrace(character: String) -> Bool:
    if character.len() == 0:
        return false
    if RBRACE.len() == 0:
        return false
    return ord(character) == ord(RBRACE)

fn is_quote(character: String) -> Bool:
    if character.len() == 0:
        return false
    return ord(character) == 34

fn is_backslash(character: String) -> Bool:
    if character.len() == 0:
        return false
    return ord(character) == 92

fn is_newline_char(character: String) -> Bool:
    if character.len() == 0:
        return false
    return ord(character) == 10

KEYWORDS := ",fn,if,elif,else,for,in,while,match,select,default,timeout,return,fail,break,continue,spawn,await,struct,enum,interface,impl,type,pub,mut,ref,weak,import,from,as,self,true,false,none,and,or,not,catch,test,let,threadlocal,defer,errdefer,"

fn keyword_token_kind(word: String) -> String:
    if KEYWORDS.contains("," + word + ","):
        return "kw_" + word
    return "identifier"

# global mutable state — the lexer modifies these as it scans
mut source := ""
mut current_position := 0
mut current_line := 1
mut current_column := 0
mut at_line_start := true
mut done := false

# indent stack — tracks indentation levels
mut indent_stack: List[Int] := [0]
# depth of open (, [, { groups: newlines and indentation inside a
# group don't produce layout tokens, so call arguments and literals
# can span lines
mut group_depth := 0
mut pending_dedents := 0

# pending tokens from string interpolation
mut pending_token_kinds: List[String] := []
mut pending_token_values: List[String] := []
mut pending_token_lines: List[Int] := []
mut pending_token_columns: List[Int] := []

# ---------------------------------------------------------------
# lexer core
# ---------------------------------------------------------------

fn peek() -> String:
    if current_position >= source.len():
        return ""
    return source_char(current_position)

fn source_char(pos: Int) -> String:
    if pos < 0:
        return ""
    if pos >= source.len():
        return ""
    return source[pos]

fn advance() -> String:
    character := source_char(current_position)
    current_position = current_position + 1
    # one character, one column — this used to also increment
    # unconditionally above the branch, so every character consumed
    # through advance() moved the column by two
    if is_newline_char(character):
        current_line = current_line + 1
        current_column = 0
    else:
        current_column = current_column + 1
    return character

fn is_blank_line() -> Bool:
    mut i := current_position
    while i < source.len():
        character := source_char(i)
        if is_newline_char(character):
            return true
        if character == "#":
            return true
        if character != " ":
            if character != chr(9):
                return false
        i = i + 1
    return true

fn skip_to_next_line():
    while current_position < source.len():
        character := source_char(current_position)
        current_position = current_position + 1
        if is_newline_char(character):
            current_line = current_line + 1
            current_column = 0
            return
        else:
            current_column = current_column + 1

fn measure_indent() -> Int:
    mut level := 0
    mut i := current_position
    while i < source.len():
        character := source_char(i)
        if character == " ":
            level = level + 1
            i = i + 1
        elif character == chr(9):
            level = level + 1
            i = i + 1
        else:
            return level
    return level

fn skip_spaces():
    while current_position < source.len():
        if source_char(current_position) == " ":
            current_position = current_position + 1
            current_column = current_column + 1
        else:
            return

# the main lexer function. returns (kind, value) by setting globals.
# callers should read current_token_kind, current_token_value, current_token_line, current_token_column after calling.
mut current_token_kind := ""
mut current_token_value := ""
mut current_token_line := 0
mut current_token_column := 0
mut current_token_offset := 0
mut current_token_len := 0

# where the token being scanned starts. captured before the scan consumes
# anything, so emit() reports the position a reader would point at — the
# token's first character — rather than wherever the scan finished, which
# used to put every column off by roughly the token's own width.
mut token_start_line := 1
mut token_start_column := 1
mut token_start_offset := 0

fn mark_token_start():
    token_start_line = current_line
    # current_column counts consumed characters, so the next character —
    # the token's first — sits at the 1-based column one past it. a
    # 1-based column is also what the caret renderer needs to point at
    # the token rather than beside it.
    token_start_column = current_column + 1
    token_start_offset = current_position

fn emit(kind: String, value: String):
    current_token_kind = kind
    current_token_value = value
    current_token_line = token_start_line
    current_token_column = token_start_column
    current_token_offset = token_start_offset
    mut length := current_position - token_start_offset
    if length < 0:
        length = 0
    current_token_len = length

fn next_token():
    # synthetic tokens — dedents, queued interpolation pieces, indent,
    # newline, eof — take the position the lexer is sitting at when they
    # are produced
    mark_token_start()

    # step 1: drain pending dedents
    if pending_dedents > 0:
        pending_dedents = pending_dedents - 1
        emit("dedent", "")
        return

    # step 2: drain pending interpolation tokens
    if pending_token_kinds.len() > 0:
        kind := pending_token_kinds[0]
        value := pending_token_values[0]
        pending_token_kinds.remove(0)
        pending_token_values.remove(0)
        emit(kind, value)
        return

    # step 3: handle EOF
    if current_position >= source.len():
        if not done:
            if indent_stack.len() > 1:
                remaining := indent_stack.len() - 1
                # pop all but first level
                while indent_stack.len() > 1:
                    indent_stack.remove(indent_stack.len() - 1)
                if remaining > 1:
                    pending_dedents = remaining - 1
                emit("dedent", "")
                return
            done = true
        emit("eof", "")
        return

    # step 4: handle indentation at start of current_line
    if at_line_start:
        at_line_start = false

        # inside a bracketed group the line break is cosmetic: no
        # indent or dedent bookkeeping applies
        if group_depth > 0:
            skip_spaces()
            next_token()
            return

        if is_blank_line():
            skip_to_next_line()
            at_line_start = true
            next_token()
            return

        level := measure_indent()
        current_indent := indent_stack[indent_stack.len() - 1]

        if level > current_indent:
            indent_stack.push(level)
            emit("indent", "")
            return
        elif level < current_indent:
            mut dedents := 0
            while indent_stack.len() > 1:
                if indent_stack[indent_stack.len() - 1] > level:
                    indent_stack.remove(indent_stack.len() - 1)
                    dedents = dedents + 1
                else:
                    break
            # verify the target indentation level exists in the stack
            if indent_stack[indent_stack.len() - 1] != level:
                emit("err", "invalid dedent: indentation level does not match any outer block")
                return
            if dedents > 0:
                pending_dedents = dedents - 1
                emit("dedent", "")
                return

    # step 5: skip spaces
    skip_spaces()

    # step 6: re-check EOF after skipping spaces
    if current_position >= source.len():
        next_token()
        return

    # the real token starts here, after any leading spaces
    mark_token_start()
    character := peek()

    # step 7: dispatch on character

    # newline
    if is_newline_char(character):
        current_position = current_position + 1
        current_line = current_line + 1
        current_column = 0
        at_line_start = true
        if group_depth > 0:
            next_token()
            return
        emit("newline", "")
        return

    # comment
    if character == "#":
        start := current_position
        while current_position < source.len():
            if is_newline_char(source_char(current_position)):
                break
            current_position = current_position + 1
            current_column = current_column + 1
        emit("comment", source.substring(start, current_position))
        return

    # string
    if is_quote(character):
        scan_string()
        return

    # number
    if is_digit(character):
        scan_number()
        return

    # identifier or keyword
    if is_alpha(character):
        scan_identifier()
        return

    # operators and punctuation
    scan_operator()

fn scan_identifier():
    start := current_position
    while current_position < source.len():
        if not is_alnum(source_char(current_position)):
            break
        current_position = current_position + 1
        current_column = current_column + 1
    word := source.substring(start, current_position)

    # check for lone underscore
    if word == "_":
        emit("underscore", "_")
        return

    # check if it's a keyword
    if KEYWORDS.contains("," + word + ","):
        emit(keyword_token_kind(word), word)
    else:
        emit("identifier", word)

# drop `_` digit separators from a numeric literal's text. the scanner consumes
# them so `1_000_000` reads as one token, but the token VALUE must be the clean
# number — otherwise downstream int/float parsing chokes on the underscores and
# yields 0.
fn strip_digit_separators(text: String) -> String:
    if not text.contains("_"):
        return text
    mut out := ""
    mut i := 0
    while i < text.len():
        c := text[i]
        if c != "_":
            out = out + c
        i = i + 1
    return out

fn scan_number():
    start := current_position

    # check for hex, binary, octal prefixes
    if source_char(current_position) == "0":
        if current_position + 1 < source.len():
            next_char := source_char(current_position + 1)
            if next_char == "x":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    scan_char := source_char(current_position)
                    if is_hex_digit(scan_char):
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "_":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    else:
                        break
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return
            if next_char == "X":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    scan_char := source_char(current_position)
                    if is_hex_digit(scan_char):
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "_":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    else:
                        break
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return
            if next_char == "b":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    scan_char := source_char(current_position)
                    if scan_char == "0":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "1":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "_":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    else:
                        break
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return
            if next_char == "B":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    scan_char := source_char(current_position)
                    if scan_char == "0":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "1":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    elif scan_char == "_":
                        current_position = current_position + 1
                        current_column = current_column + 1
                    else:
                        break
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return
            if next_char == "o":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    if not is_octal_char(source_char(current_position)):
                        break
                    current_position = current_position + 1
                    current_column = current_column + 1
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return
            if next_char == "O":
                current_position = current_position + 2
                current_column = current_column + 2
                while current_position < source.len():
                    if not is_octal_char(source_char(current_position)):
                        break
                    current_position = current_position + 1
                    current_column = current_column + 1
                emit("int_lit", strip_digit_separators(source.substring(start, current_position)))
                return

    # decimal digits
    while current_position < source.len():
        scan_char := source_char(current_position)
        if is_digit(scan_char):
            current_position = current_position + 1
            current_column = current_column + 1
        elif scan_char == "_":
            current_position = current_position + 1
            current_column = current_column + 1
        else:
            break

    # check for decimal point (must be followed by a digit)
    mut is_float := false
    if current_position < source.len():
        if source_char(current_position) == ".":
            if current_position + 1 < source.len():
                if is_digit(source_char(current_position + 1)):
                    is_float = true
                    current_position = current_position + 1
                    current_column = current_column + 1
                    while current_position < source.len():
                        scan_char := source_char(current_position)
                        if is_digit(scan_char):
                            current_position = current_position + 1
                            current_column = current_column + 1
                        elif scan_char == "_":
                            current_position = current_position + 1
                            current_column = current_column + 1
                        else:
                            break

    # check for exponent
    if current_position < source.len():
        exp_char := source_char(current_position)
        if exp_char == "e":
            is_float = true
            current_position = current_position + 1
            current_column = current_column + 1
            if current_position < source.len():
                scan_char := source_char(current_position)
                if scan_char == "+":
                    current_position = current_position + 1
                    current_column = current_column + 1
                elif scan_char == "-":
                    current_position = current_position + 1
                    current_column = current_column + 1
            while current_position < source.len():
                scan_char := source_char(current_position)
                if is_digit(scan_char):
                    current_position = current_position + 1
                    current_column = current_column + 1
                elif scan_char == "_":
                    current_position = current_position + 1
                    current_column = current_column + 1
                else:
                    break
        elif exp_char == "E":
            is_float = true
            current_position = current_position + 1
            current_column = current_column + 1
            if current_position < source.len():
                scan_char := source_char(current_position)
                if scan_char == "+":
                    current_position = current_position + 1
                    current_column = current_column + 1
                elif scan_char == "-":
                    current_position = current_position + 1
                    current_column = current_column + 1
            while current_position < source.len():
                scan_char := source_char(current_position)
                if is_digit(scan_char):
                    current_position = current_position + 1
                    current_column = current_column + 1
                elif scan_char == "_":
                    current_position = current_position + 1
                    current_column = current_column + 1
                else:
                    break

    if is_float:
        emit("float_lit", strip_digit_separators(source.substring(start, current_position)))
    else:
        emit("int_lit", strip_digit_separators(source.substring(start, current_position)))

fn scan_string():
    start := current_position
    current_position = current_position + 1
    current_column = current_column + 1

    # check for interpolation by peeking ahead
    mut has_interpolation := false
    mut i := current_position
    mut found_string_boundary := false
    while i < source.len():
        if found_string_boundary:
            break
        scan_char := source_char(i)
        if is_backslash(scan_char):
            if i + 1 >= source.len():
                found_string_boundary = true
            else:
                i = i + 2
        elif is_lbrace(scan_char):
            if i + 1 < source.len() and is_lbrace(source_char(i + 1)):
                # `{{` is an escaped literal brace, not interpolation
                i = i + 2
            else:
                has_interpolation = true
                found_string_boundary = true
        elif is_quote(scan_char):
            found_string_boundary = true
        elif is_newline_char(scan_char):
            found_string_boundary = true
        else:
            i = i + 1

    if not has_interpolation:
        # simple string
        while current_position < source.len():
            scan_char := source_char(current_position)
            if is_backslash(scan_char):
                if current_position + 1 >= source.len():
                    emit("err", "unterminated escape sequence")
                    return
                current_position = current_position + 2
                current_column = current_column + 2
            elif is_quote(scan_char):
                current_position = current_position + 1
                current_column = current_column + 1
                emit("string_lit", source.substring(start, current_position))
                return
            elif is_newline_char(scan_char):
                emit("err", "newline in string literal")
                return
            else:
                current_position = current_position + 1
                current_column = current_column + 1
        emit("err", "unterminated string literal")
        return

    # interpolated string — scan to first {
    mut found_interp_start := false
    while current_position < source.len():
        if found_interp_start:
            break
        scan_char := source_char(current_position)
        if is_backslash(scan_char):
            if current_position + 1 >= source.len():
                emit("err", "unterminated escape sequence in string interpolation")
                return
            current_position = current_position + 2
            current_column = current_column + 2
        elif is_lbrace(scan_char):
            if current_position + 1 < source.len() and is_lbrace(source_char(current_position + 1)):
                # `{{` is an escaped literal brace; keep scanning for a real `{`
                current_position = current_position + 2
                current_column = current_column + 2
            else:
                found_interp_start = true
        elif is_quote(scan_char):
            found_interp_start = true
        elif is_newline_char(scan_char):
            found_interp_start = true
        else:
            current_position = current_position + 1
            current_column = current_column + 1

    # emit string_start (from opening " to the {)
    string_start_value := source.substring(start, current_position)

    # now scan interpolation parts into pending tokens
    scan_interpolation_parts()

    emit("string_start", string_start_value)

# the raw text between {} keeps the backslash-escapes it needed to sit
# inside the surrounding string literal: `\"` for a string argument's
# quotes and `\\` for a literal backslash. undo those so the expression
# re-lexes as real code — without this, `f(\"x\", 1)` re-lexes as a
# single string argument and the call looks like it has one argument.
fn unescape_interp_expr(text: String) -> String:
    mut out := ""
    mut i := 0
    while i < text.len():
        ch := text[i]
        if ord(ch) == 92 and i + 1 < text.len():
            nxt := text[i + 1]
            if ord(nxt) == 34 or ord(nxt) == 92:
                out = out + nxt
                i = i + 2
            else:
                out = out + ch
                i = i + 1
        else:
            out = out + ch
            i = i + 1
    return out

fn scan_interpolation_parts():
    while current_position < source.len():
        if not is_lbrace(source_char(current_position)):
            return

        # skip the {
        current_position = current_position + 1
        current_column = current_column + 1

        # scan expression inside {}
        mut brace_depth := 1
        expression_start := current_position
        mut found_expr_end := false
        while current_position < source.len():
            if found_expr_end:
                break
            input_char := source_char(current_position)
            if is_backslash(input_char) and current_position + 1 < source.len():
                # skip an escaped char so a `\"` or `\}` inside the
                # expression (e.g. a string argument's quotes) doesn't
                # throw off the brace matching
                current_position = current_position + 2
                current_column = current_column + 2
            elif is_lbrace(input_char):
                brace_depth = brace_depth + 1
                current_position = current_position + 1
                current_column = current_column + 1
            elif is_rbrace(input_char):
                brace_depth = brace_depth - 1
                if brace_depth == 0:
                    found_expr_end = true
                else:
                    current_position = current_position + 1
                    current_column = current_column + 1
            else:
                current_position = current_position + 1
                current_column = current_column + 1

        expr_text := unescape_interp_expr(source.substring(expression_start, current_position))
        if expr_text.len() > 0:
            pending_token_kinds.push("interpolation_expr")
            pending_token_values.push(expr_text)

        if current_position >= source.len():
            return

        # skip the }
        current_position = current_position + 1
        current_column = current_column + 1

        # scan string content after the }
        middle_start := current_position
        mut found_middle_end := false
        while current_position < source.len():
            if found_middle_end:
                break
            scan_char := source_char(current_position)
            if is_backslash(scan_char):
                if current_position + 1 >= source.len():
                    return
                current_position = current_position + 2
                current_column = current_column + 2
            elif is_lbrace(scan_char):
                if current_position + 1 < source.len() and is_lbrace(source_char(current_position + 1)):
                    # `{{` is an escaped literal brace inside the trailing segment
                    current_position = current_position + 2
                    current_column = current_column + 2
                else:
                    found_middle_end = true
            elif is_quote(scan_char):
                found_middle_end = true
            elif is_newline_char(scan_char):
                found_middle_end = true
            else:
                current_position = current_position + 1
                current_column = current_column + 1

        if current_position >= source.len():
            return

        if is_quote(source_char(current_position)):
            end_text := source.substring(middle_start, current_position)
            current_position = current_position + 1
            current_column = current_column + 1
            pending_token_kinds.push("string_end")
            pending_token_values.push(end_text)
            return

        if is_newline_char(source_char(current_position)):
            return

        # another { — emit string_mid and continue
        pending_token_kinds.push("string_mid")
        pending_token_values.push(source.substring(middle_start, current_position))

fn scan_operator():
    character := advance()

    if character == "+":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("plus_eq", "+=")
                return
        emit("plus", "+")
        return

    if character == "-":
        if current_position < source.len():
            if source_char(current_position) == ">":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("arrow", "->")
                return
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("minus_eq", "-=")
                return
        emit("minus", "-")
        return

    if character == "*":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("star_eq", "*=")
                return
        emit("star", "*")
        return

    if character == "/":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("slash_eq", "/=")
                return
        emit("slash", "/")
        return

    if character == "%":
        emit("percent", "%")
        return

    if character == "=":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("eq_eq", "==")
                return
            if source_char(current_position) == ">":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("fat_arrow", "=>")
                return
        emit("eq", "=")
        return

    if character == "!":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("bang_eq", "!=")
                return
        emit("bang", "!")
        return

    if character == "<":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("less_eq", "<=")
                return
        emit("less", "<")
        return

    if character == ">":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("greater_eq", ">=")
                return
        emit("greater", ">")
        return

    if character == ":":
        if current_position < source.len():
            if source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("colon_eq", ":=")
                return
        emit("colon", ":")
        return

    if character == "?":
        emit("question", "?")
        return

    if character == ".":
        if current_position < source.len() and source_char(current_position) == ".":
            current_position = current_position + 1
            current_column = current_column + 1
            if current_position < source.len() and source_char(current_position) == "=":
                current_position = current_position + 1
                current_column = current_column + 1
                emit("dotdoteq", "..=")
                return
            emit("dotdot", "..")
            return
        emit("dot", ".")
        return

    if character == ",":
        emit("comma", ",")
        return

    if character == "(":
        group_depth = group_depth + 1
        emit("lparen", "(")
        return

    if character == ")":
        if group_depth > 0:
            group_depth = group_depth - 1
        emit("rparen", ")")
        return

    if character == "[":
        group_depth = group_depth + 1
        emit("lbracket", "[")
        return

    if character == "]":
        if group_depth > 0:
            group_depth = group_depth - 1
        emit("rbracket", "]")
        return

    if is_lbrace(character):
        group_depth = group_depth + 1
        emit("lbrace", LBRACE)
        return

    if is_rbrace(character):
        if group_depth > 0:
            group_depth = group_depth - 1
        emit("rbrace", RBRACE)
        return

    if character == "|":
        emit("pipe", "|")
        return

    emit("err", character)

# ---------------------------------------------------------------
# public api for module use
# ---------------------------------------------------------------

# point the scanner at `src` and reset every piece of scan state — the
# position, the indent stack, the group depth, the queued interpolation
# tokens. lex_all() does this for you; call it directly only if you are
# driving the scanner one token at a time. it does not clear the loaded
# token table that tok_kind() and friends read.
pub fn init_lexer(src: String):
    # init brace characters via chr() since we can't write them as literals
    LBRACE = chr(123)
    RBRACE = chr(125)
    source = src
    current_position = 0
    current_line = 1
    current_column = 0
    at_line_start = true
    done = false
    indent_stack = [0]
    group_depth = 0
    pending_token_kinds = []
    pending_token_values = []
    pending_token_lines = []
    pending_token_columns = []
    pending_dedents = 0
    token_start_line = 1
    token_start_column = 1
    token_start_offset = 0

mut _tok_kinds: List[String] := []
mut _tok_values: List[String] := []
mut _tok_lines: List[Int] := []
mut _tok_cols: List[Int] := []
mut _tok_offsets: List[Int] := []
mut _tok_lens: List[Int] := []

# kind of token `i` in the loaded token table. the table is the
# parallel-array copy of a token stream that lex_all() and load_tokens()
# install, and it — not the List[Token] lex_all() returns — is what the
# parser reads, so the parser walks the stream by index without copying
# tokens. there is no bounds check: an index at or past tok_count() is a
# runtime trap, so gate on tok_count() first.
pub fn tok_kind(i: Int) -> String:
    return _tok_kinds[i]
# source text of token `i`. empty for the kinds that carry no text —
# newline, indent, dedent, eof. for an "err" token this is either a
# message the lexer wrote (an unterminated string, a bad dedent) or the
# single offending character.
pub fn tok_value(i: Int) -> String:
    return _tok_values[i]
# 1-based source line of token `i`'s first character. synthesized tokens
# (indent, dedent, eof) report wherever the scanner was sitting when
# they were produced.
pub fn tok_line(i: Int) -> Int:
    return _tok_lines[i]
# 1-based column of token `i`'s first character, which is what a caret
# renderer needs to point at the token rather than beside it. columns
# count bytes, not codepoints.
pub fn tok_col(i: Int) -> Int:
    return _tok_cols[i]
# byte offset of token `i`'s first character within the source that was
# lexed. use with tok_len() to slice the original text back out.
pub fn tok_offset(i: Int) -> Int:
    return _tok_offsets[i]
# byte length of token `i`'s lexeme. zero for synthesized and
# end-of-input tokens, which consume no source.
pub fn tok_len(i: Int) -> Int:
    return _tok_lens[i]
# number of tokens in the loaded table, counting the trailing eof. the
# upper bound for every tok_* index.
pub fn tok_count() -> Int:
    return _tok_kinds.len()

# install `token_list` as the token table the tok_* accessors read,
# discarding whatever was loaded before. this is how the parser hands a
# stream over to itself: parse_with_file() loads the file's tokens, and
# interpolation parsing swaps in a sub-lexed fragment here and puts the
# outer stream back with load_token_snapshot().
pub fn load_tokens(token_list: List[Token]):
    _tok_kinds = []
    _tok_values = []
    _tok_lines = []
    _tok_cols = []
    _tok_offsets = []
    _tok_lens = []
    for tok in token_list:
        _tok_kinds.push(tok.kind)
        _tok_values.push(tok.value)
        _tok_lines.push(tok.current_line)
        _tok_cols.push(tok.current_column)
        _tok_offsets.push(tok.offset)
        _tok_lens.push(tok.len)

# restore the token table from six parallel lists — the shape you get by
# reading tok_kind()/tok_value()/… across a whole stream. the parser uses
# this to put the outer token stream back after sub-parsing a string
# interpolation. the six lists are copied column by column and their
# lengths are never compared, so passing lists of unequal length leaves a
# ragged table that traps only when an accessor reaches past a short one.
pub fn load_token_snapshot(kinds: List[String], values: List[String], lines: List[Int], cols: List[Int], offsets: List[Int], lens: List[Int]):
    _tok_kinds = []
    _tok_values = []
    _tok_lines = []
    _tok_cols = []
    _tok_offsets = []
    _tok_lens = []
    for kind in kinds:
        _tok_kinds.push(kind)
    for value in values:
        _tok_values.push(value)
    for line in lines:
        _tok_lines.push(line)
    for col in cols:
        _tok_cols.push(col)
    for off in offsets:
        _tok_offsets.push(off)
    for ln in lens:
        _tok_lens.push(ln)

# tokenize a whole source string, from a clean scanner, up to and
# including the trailing eof token. the same stream is also installed as
# the loaded token table, so a caller can go straight to parsing without
# calling load_tokens() itself.
#
# lexing never fails: a stray character, an unterminated string or an
# indentation level that matches no open block becomes an "err" token in
# the stream and scanning carries on. a caller that cares has to scan the
# result for kind "err" — and note a multi-byte character produces one
# "err" token per byte, so errors arrive in runs.
pub fn lex_all(src: String) -> List[Token]:
    init_lexer(src)
    _tok_kinds = []
    _tok_values = []
    _tok_lines = []
    _tok_cols = []
    _tok_offsets = []
    _tok_lens = []
    mut tokens: List[Token] := []
    mut keep_going := true
    while keep_going:
        next_token()
        tokens.push(Token(current_token_kind, current_token_value, current_token_line, current_token_column, current_token_offset, current_token_len))
        _tok_kinds.push(current_token_kind)
        _tok_values.push(current_token_value)
        _tok_lines.push(current_token_line)
        _tok_cols.push(current_token_column)
        _tok_offsets.push(current_token_offset)
        _tok_lens.push(current_token_len)
        if current_token_kind == "eof":
            keep_going = false
    return tokens

# ---------------------------------------------------------------
# main
# ---------------------------------------------------------------
