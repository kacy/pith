# PENDING — issues #1051 and #1052. not registered in tooling/leak_check.sh;
# shapes 1 and 3 fail it and shape 4 prints a wrong sum.
#
# a function returning an optional over a tuple-shaped payload builds the
# borrowing wrap on its return path (no `__opt_dtor_` on the shell), because
# the emitter's inner-kind string is "tuple" for a tuple payload and for a
# `T??` alike and the return path keeps the borrowing wrap for the latter.
# two symptoms follow:
#
#  - #1052: `if let p = fresh(i)` straight over the call releases the shell
#    only, so the tuple and its string are stranded every round. the same
#    call bound to a local first is flat: a local is released through the
#    tuple cascade, which walks the payload.
#  - #1051: `return inner` where `inner: (Int, String)?` and the declared
#    return is `((Int, String)?)?` forwards the single shell without the
#    second wrap (the checker accepts the inner type but records no
#    widening, and the emitter guesses "already optional" from the kind). the
#    caller's first `if let` then hands the bare tuple to the second, which
#    reads the tuple's first field as the tag; `p.0` is garbage and `p.1`
#    segfaults.
#
# measured at PITH_LEAK_ROUNDS 200000 vs 800000, peak kb, sums checked:
#   shape 1, if let over the call, tuple payload         21496 -> 77676
#   shape 2, call bound to a local, then if let           2556 ->  2640
#   shape 3, tuple bound to a local before the return    21456 -> 77656
#   shape 4, optional local returned as a double optional: WRONG sum
#
# the locals of shapes 2 and 4 have different names on purpose. with one
# name bound at both optional depths, shape 2 leaked too (21332 -> 77528):
# a name rebound across payload kinds takes one release lowering for both
# (issue #1053).
#
# both fixes are one convention: the return path builds an owned shell for
# a tuple or optional payload, and callers release such locals like any owned
# optional instead of cascading. register shapes 1, 3 and 4 in
# tooling/leak_check.sh once fixed, and shape 4's sum belongs in a golden.
import pendingprobe as probe
import std.env as env

fn fresh(i: Int) -> (Int, String)?:
    return (i, "m{i}")

fn via_local(i: Int) -> (Int, String)?:
    t := (i, "m{i}")
    return t

fn doubled(i: Int) -> ((Int, String)?)?:
    inner: (Int, String)? := (i, "m{i}")
    return inner

fn shape(s: Int, i: Int) -> Int:
    mut seen := 0
    if s == 1:
        if let p = fresh(i):
            seen = seen + p.0
        return seen
    if s == 2:
        got := fresh(i)
        if let p = got:
            seen = seen + p.0
        return seen
    if s == 3:
        if let p = via_local(i):
            seen = seen + p.0
        return seen
    if s == 4:
        both := doubled(i)
        if let inner = both:
            if let p = inner:
                seen = seen + p.0
        return seen
    return 0

fn main():
    s := env.int_or("SHAPE", 1)
    mut i := 0
    mut acc := 0
    while i < probe.rounds():
        acc = acc + shape(s, i)
        i = i + 1
    want := probe.rounds() * (probe.rounds() - 1) / 2
    if acc != want:
        print("WRONG shape {s}: got {acc} want {want}")
    print("{probe.peak_kb()}")
