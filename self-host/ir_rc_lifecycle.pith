# release an in-flight register by the kind it went in with. `result:TID` is a
# result box this frame owns: it has no destructor, so its payload is dropped
# with it (ir_emit_result_box_release).
pub fn ir_release_inflight_kind(r: Int, kind: String):
    if kind.starts_with("result:"):
        ir_emit_result_box_release(r, parse_int(kind.substring(7, kind.len())) catch 0 - 1)
        return
    ir_rc_release_reg(r, kind)

# the kind a match releases an owned fresh subject with after the taken arm,
# when the release before the arm can't apply: the subject is a result (whose
# bindings take no count) or an arm binds it bare, an alias of it. every arm
# that binds it bare has to read only through the alias, the way a result
# local's cascade requires (ir_tuple_uses_all_safe); then the subject is dead
# once the arm's value is built. a result subject is released with its
# payload (`result:TID`). "" when this does not apply.
# `match parse_int(s): r if r.is_ok => ...; r => ...` leaked the box and its
# error string every call.
pub fn ir_match_alias_release(node: Node, subj_owned: Bool) -> String:
    if not subj_owned or node.children.len() == 0:
        return ""
    tid := c_get_expr_type(node.children[0])
    if tid < 0:
        return ""
    kind := ir_rc_kind(ir_checked_type(node.children[0]))
    if kind.len() == 0:
        return ""
    info := get_type_info(tid)
    if info.kind == "optional":
        return ""
    is_result := info.kind == "result"
    mut has_bare := false
    mut i := 1
    while i < node.children.len():
        arm := get_node(node.children[i])
        if arm.children.len() > 0:
            pat := get_node(arm.children[0])
            if pat.kind == "pat_binding":
                has_bare = true
                mut j := 1
                while j < arm.children.len():
                    if not ir_tuple_uses_all_safe(arm.children[j], pat.value, is_result):
                        return ""
                    j = j + 1
            elif not ir_match_pattern_keeps_subject_free(arm.children[0], false):
                return ""
        i = i + 1
    if not is_result and not has_bare:
        return ""
    if is_result:
        return "result:" + tid.to_string()
    return kind

## match alias track.
pub fn ir_match_alias_track(r: Int, kind: String, entering: Bool):
    if entering:
        ir_inflight_push(r, kind)
    else:
        ir_inflight_drop(r)

## rc local kind.
pub fn ir_rc_local_kind(name: String) -> String:
    mut i := 0
    while i < ir_rc_locals.len():
        if ir_rc_locals[i] == name and i < ir_rc_local_kinds.len():
            return ir_rc_local_kinds[i]
        i = i + 1
    return ""

fn ir_rc_track_local(name: String, kind: String):
    if not ir_rc_locals.contains(name):
        ir_rc_locals.push(name)
        ir_rc_local_kinds.push(kind)

# weak locals captured from an enclosing function, live only while a lambda
# body emits (saved and restored around it, so nesting composes). reads of
# these wrap in the weak liveness resolution exactly like a weak local's,
# but the names are NOT tracked in ir_rc_locals: the closure environment
# owns the single weak reference (dropped by its tag-8 slot when the

# true when reading `name` must resolve liveness through
# pith_struct_weak_load: a weak local of the emitting function, or a weak
# binding captured from the enclosing one. a loop variable shadowing the
# name reads its own slot (a strong element) and stays plain.
pub fn ir_name_is_weak_read(name: String) -> Bool:
    if ir_loop_var_slot(name).len() > 0:
        return false
    if ir_rc_local_kind(name) == "weak":
        return true
    return ir_weak_capture_names.contains(name)

# the emitter's load-bearing ownership question, and the one the rest of the
# rc machinery is built on: does this expression hand back a count some other
# owner already holds, so the consumer has to take one of its own (borrowed,
# true), or a count the expression minted or was handed, which the consumer
# inherits and must not retain again (owned, false)?
#
# borrowed is the answer for a read of storage another owner keeps alive: a
# variable, a container element, a struct field, `self`. owned is the answer
# for everything that mints a fresh value or carries a count out of somewhere:
# a fresh string (a literal, a concatenation, an interpolation, a builtin
# known to build one), a call or method-call result of an rc kind, an await, a
# catch, a lambda, a named function value, a list/map/set/tuple literal, a
# struct init, a bare payload-free variant, and a field read off an owned
# temporary receiver. that list grew one clause at a time, and most of the
# clauses below name the shape they settle together with the leak that taught
# us the shape and how much it cost.
#
# the two ways of being wrong are not symmetric. calling an owned value
# borrowed makes the consumer take a second count nobody releases: a leak.
# calling a borrowed value owned skips the retain and lets the consumer
# release a count it never took: a dangling pointer. so wherever the answer
# cannot be proved (a receiver that will not resolve, a call whose type the
# checker did not record) the clause falls through to borrowed on purpose.
#
# the sequence of early returns below is the classification. they are ordered
# so a specific shape answers before the general rule it would otherwise fall
# into (a bare variant ahead of the field-access rule, a module-qualified
# call ahead of the builtin fresh-string list), and reordering them changes
# what the emitter emits.
pub fn ir_expr_is_borrowed(idx: Int) -> Bool:
    # a conversion builds a fresh interface value
    if ir_interface_coercion(idx) >= 0:
        return false
    node := get_node(idx)
    # a string literal is its own buffer, and the runtime makes retain on one
    # a no-op anyway.
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return false
    # a weak read (a weak field, a weak local, a weak capture) mints a fresh
    # shell that owns the count its upgrade took (ir_emit_weak_read), so the
    # consumer inherits it the way it inherits a call result's. classified as
    # a borrow, a bind or an argument retained the shell and never released
    # it, and with it the target's count.
    if ir_node_is_weak_field_read(idx):
        return false
    if node.kind == "index" and node.children.len() > 0:
        # s[i] on a string mints a fresh char (char_at); container indexing
        # borrows the element. mirrors ir_emit_index_expr's dispatch.
        if ir_expr_is_fresh_string_index(idx):
            return false
        # a read off a temporary container (`s.split(",")[0]`) retains its
        # element before the container goes (ir_emit_index_expr), so the
        # element arrives owned
        if ir_index_reads_owned_element(idx):
            return false
        return true
    if node.kind == "binary" or node.kind == "interp" or node.kind == "string_interp":
        return false
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_expr_is_borrowed(node.children[0])
    # a try (!) unwraps its inner result: ownership classification follows
    # the wrapped expression (a transferred call result stays owned)
    if (node.kind == "try" or node.kind == "try_expr") and node.children.len() > 0:
        inner := get_node(node.children[0])
        if inner.kind == "call" or inner.kind == "method_call":
            # the unwrapped ok value is a transfer: result returns route
            # through the same retain-borrowed-returns convention
            return false
        # `?` on a weak read frees the shell, and the count it owns, once the
        # payload is out (ir_emit_optional_unwrap), so the payload is a borrow
        if ir_node_is_weak_field_read(node.children[0]):
            return true
        return ir_expr_is_borrowed(node.children[0])
    # a catch normalizes both arms to owned (the ok arm transfers the result
    # payload out of the shell; the fallback arm retains a borrow; see
    # ir_emit_catch_expr), so the result arrives owned. treating it as borrowed
    # makes the binding retain again and leaks the payload.
    if node.kind == "catch_expr" or node.kind == "catch_block":
        return false
    # the error a `catch err:` block binds arrives owned (ir_emit_catch_block)
    if node.kind == "caught_error":
        return false
    # awaiting a task transfers the result's count out to the single awaiter:
    # the task's thread produced the value with count 1 and stored it raw in the
    # result slot (no retain), and pith_await hands that count back. so the
    # awaited value arrives owned, exactly like a fresh call result. treating it
    # as borrowed would add a compensating retain and leak the payload by one.
    # (scalar returns carry no count, so this classification is a no-op for them.)
    if node.kind == "await":
        return false
    # collection literals mint fresh containers, and collection-typed call
    # results arrive with a transferred count (user returns exclude the
    # local, runtime producers build new containers). variable, element,
    # and field reads stay borrows.
    if node.kind == "list" or node.kind == "map" or node.kind == "set":
        return false
    if node.kind == "struct_init":
        return false
    # a tuple literal mints a fresh struct:tuple allocation with its own
    # count, the same as a struct_init.
    if node.kind == "tuple":
        return false
    # a lambda mints a fresh closure with its own count; returning or
    # binding it transfers that count rather than borrowing one.
    if node.kind == "lambda":
        return false
    # naming a function as a value does the same thing: `shout` and
    # `hash.sha256_bytes` both lower to `closure_ref`, which allocates a
    # closure with a count of one. that count is the expression's to hand
    # on. classifying it as a borrow made the binding retain a second one
    # and left the closure alive after its single release.
    if ir_expr_is_named_function_value(idx):
        return false
    if node.kind == "call" and ir_infer_type(idx) == "string":
        return false
    if node.kind == "call" or node.kind == "method_call":
        expr_kind := ir_rc_kind(ir_infer_type(idx))
        # a channel is on this list for the same reason a list is: the
        # constructor mints one whose count is the expression's to hand on,
        # and a function returning a channel retains a borrowed one on the
        # way out. classified as a borrow, the bind retained a second count
        # and every channel outlived its single release.
        if expr_kind == "list" or expr_kind == "map" or expr_kind == "set" or expr_kind == "bytes" or expr_kind == "struct" or expr_kind == "closure" or expr_kind == "tuple" or expr_kind == "channel" or expr_kind == "sync":
            return false
    if node.kind == "method_call":
        # a module-qualified call (`mod.helper(...)`) parses as a method call
        # but is a user function call, and its result routes through the same
        # return convention as any call: the callee retains a returned borrow
        # and transfers a fresh value, so the result arrives owned. without
        # this check the string case fell through to the builtin fresh-name
        # list below, classified the result as borrowed, and the call site
        # retained a count nobody released: one leaked string per
        # `mod.fn(...) -> String` call, which url.decode turned into ~64
        # bytes per http request once #839 put it on the request path.
        if ir_resolve_module_alias_method_call_name(idx).len() > 0:
            return false
        # a call on an interface value reaches a user method, under the same
        # return convention
        if node.children.len() > 0 and c_is_interface_value_type(c_get_expr_type(node.children[0])):
            return false
        # a user-defined method already settled its result's ownership on the
        # way out: it retains a returned borrow and transfers a fresh value, so
        # the result arrives owned. the caller must not retain it again (that
        # over-retain is a leak when the method returns a fresh string). only
        # builtin string methods, which don't route through that return path,
        # fall back to the known-fresh list.
        mname := ir_plain_method_name(node.value)
        recv_type := ir_method_receiver_type(node)
        if ir_lookup_impl_method_for(node.children[0], recv_type, mname).len() > 0:
            return false
        # a closure stored in a field returns under the same convention as
        # any closure call, so its result arrives owned too. classified as a
        # borrow, `self.f(x)` returning a fresh String was retained again and
        # leaked once per call, which every map_iter producing strings hit.
        if ir_method_call_is_closure_field(node, mname, recv_type):
            return false
        # a builtin that takes the count on its own result hands back an owned
        # value whichever branch it ran (ir_method_result_retains_over_args).
        # keyed on the resolved builtin rather than the spelling, so a
        # same-named method on another receiver keeps its own classification,
        # and on the same rc kind the call site retains through, so "owned"
        # here can never outrun the count that backs it. where the kind is
        # unknown no retain is emitted, so the answer stays "borrowed" and the
        # consumer adds its own count: a leak rather than a value released
        # twice.
        if ir_rc_kind(ir_infer_type(idx)).len() > 0:
            resolved := ir_method_emit_name(mname, recv_type)
            if ir_method_result_retains_over_args(resolved):
                return false
            # a builtin whose receiver relinquishes its own count into the
            # result hands back an owned value the same way: the entry is
            # gone from the container and nobody else will release what it
            # held. the heap-container result kinds already answered owned
            # through the rc-kind check above, so this clause is what the
            # String flavor rides on. without it a taken string fell to the
            # builtin fresh-name list below, classified borrowed, and the
            # bind retained a count nobody released: one stranded string per
            # `m.take(k)` on a string-valued map, whichever key flavor.
            if ir_method_result_transfers_count(resolved):
                return false
        # the optional extractions, `unwrap_or` and `.value()`, hand out an
        # owned count for every heap payload kind: either the freshly
        # retained one ir_extraction_retains asks for, or (for a shell-only
        # subject) the count the shell's cleanup never releases. the
        # struct/list/... kinds already answered owned through the rc-kind
        # check above; this covers the string payload, which would otherwise
        # fall to the builtin fresh-name list below and classify borrowed,
        # making the escape site retain a second count on top of the one the
        # extraction carries. a RESULT unwrap_or on a value nobody else holds
        # (a call's result, under either result abi) is owned the same way:
        # the ok arm hands out the payload's count as the box or pair dies,
        # and the fallback arm retains a borrowed fallback. on a named result
        # its string payload keeps the retain-at-escape convention.
        if mname == "unwrap_or" and node.children.len() > 0 and ir_extraction_operand_class(node.children[0]) == "owned":
            result_tid := c_get_expr_type(node.children[0])
            if result_tid >= 0 and get_type_info(result_tid).kind == "result":
                return false
        if (mname == "unwrap_or" or mname == "value") and node.children.len() > 0:
            extract_recv_tid := c_get_expr_type(node.children[0])
            if extract_recv_tid >= 0 and get_type_info(extract_recv_tid).kind == "optional":
                if ir_rc_kind(ir_type_from_tid(get_type_info(extract_recv_tid).inner)).len() > 0:
                    return false
        # `to_string` on a String lowers to the receiver itself, with no
        # fresh buffer, so it is borrowed exactly when the receiver is. as a
        # fresh name it classified owned, and `take(s.to_string())` released
        # a String parameter its caller still held: a use after free.
        if ir_is_string_to_string(idx):
            return ir_expr_is_borrowed(node.children[0])
        # a reduce hands back its accumulator, which holds a count of its own
        # (ir_emit_list_reduce_lowering)
        if mname == "reduce":
            return false
        return not ir_string_method_returns_fresh(mname)
    # a payload-free variant written bare (`Holder.Empty`, or the alias-
    # qualified `mod.Holder.Empty`) parses as a field access but mints a
    # fresh box (the field-access emitters route it to ir_emit_variant_alloc).
    # a field read is a borrow; this is not, and classifying it as one made
    # every return, bind and argument of a bare variant retain a count the
    # box already held. `return Holder.Empty` leaked one box per call, on
    # every boxed enum in the language.
    if node.kind == "field_access" and ir_field_access_is_bare_variant(idx):
        return false
    # a field read off an owned temporary receiver hands back a retained value
    # (ir_release_owned_field_receiver), so it is owned, but only when the
    # field has a kind to retain; a plain-value field is not rc either way.
    if node.kind == "field_access" and node.children.len() > 0 and ir_field_receiver_is_owned_temp(node.children[0]):
        return false
    if node.kind == "match_expr" or node.kind == "if_expr" or node.kind == "select_expr":
        return not ir_branch_values_are_owned(idx)
    # `?` on a fresh optional takes a count on a counted payload before it
    # frees the shell (ir_emit_optional_unwrap)
    if node.kind == "unwrap" and node.children.len() > 0 and ir_unwrap_frees_shell(node.children[0]):
        return false
    return true

# a match or if expression stores each branch's value into one temp, and the
# consumer reads that temp. a branch value lands as is, except that where the
# whole has a kind in ir_branch_retain_kind a borrowed branch is retained on
# the way in (ir_emit_owned_branch_value), so every path leaves the temp
# holding a count of its own. the expression is owned when every branch hands
# over an owned value or is retained that way. otherwise it is a borrow, which
# the consumer retains: a leak on the owned branches rather than a value
# released twice on a borrowed one.
#
# a block arm stores nothing: one that always leaves the function never
# reaches the consumer and is skipped, and one that can fall through makes the
# whole a borrow. so does a branch of another type than the whole (a void call
# beside a String, which the checker accepts), since a retain under the
# whole's kind would be the wrong one for it. a branch widened to an optional
# is built into a fresh Some that owns its payload
# (ir_emit_optional_for_target), so it is owned.
fn ir_branch_values_are_owned(idx: Int) -> Bool:
    values := ir_branch_value_nodes(idx)
    if values.contains(0 - 1):
        return false
    want := ir_infer_type(idx)
    retains := ir_branch_retain_kind(idx).len() > 0
    for v in values:
        # a bare `none` branch lands a null, which holds no count to lend
        if not c_argument_widens_to_optional(v) and node_kind(v) != "none_lit":
            # the same counted kind is the same release: an empty `[]` infers
            # `list` beside a `List[String]` whole, and refusing it made the
            # whole a borrow whose retain stranded the fresh list
            v_type := ir_infer_type(v)
            if v_type != want and ir_rc_kind(v_type) != ir_rc_kind(want):
                return false
            if not retains and ir_expr_is_borrowed(v) and not ir_select_value_is_binding(idx, v):
                return false
    return true

# whether value v of the select at idx is a receive arm's own binding, whose
# count the arm hands over (ir_select_arm_returns_binding) rather than lends
fn ir_select_value_is_binding(idx: Int, v: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "select_expr":
        return false
    for arm_idx in node.children:
        arm := get_node(arm_idx)
        if arm.kind == "select_recv_arm" and arm.children.len() >= 2 and ir_select_arm_returns_binding(arm.children[1], arm.value):
            body := get_node(arm.children[1])
            if arm.children[1] == v or (body.kind == "body" and body.children.len() > 0 and body.children[0] == v):
                return true
    return false

# the rc kind a borrowed branch of the match or if expression at idx is
# retained under as it lands in the temp, or "" where branches land as is. the
# kinds are the ones every consumer retains a borrow of and releases an owned
# value of the same way, so a branch retained here reads like a call result.
# an optional or tuple whole is left out: its shells follow their own rules.
fn ir_branch_retain_kind(idx: Int) -> String:
    kind := ir_rc_kind(ir_infer_type(idx))
    if kind == "string" or kind == "list" or kind == "map" or kind == "set" or kind == "bytes":
        return kind
    if kind == "struct" or kind == "closure" or kind == "channel" or kind == "sync":
        return kind
    return ""

# the value nodes of a match or if expression's branches, skipping block arms
# that always leave the function. -1 stands for a branch whose value cannot be
# named (a block arm that can fall through, or a malformed node).
fn ir_branch_value_nodes(idx: Int) -> List[Int]:
    node := get_node(idx)
    mut values: List[Int] := []
    if node.kind == "if_expr":
        if node.children.len() < 3:
            return [0 - 1]
        values.push(node.children[1])
        mut i := 2
        while i < node.children.len() - 1:
            branch := get_node(node.children[i])
            if branch.children.len() < 2:
                return [0 - 1]
            values.push(branch.children[1])
            i = i + 1
        values.push(node.children[node.children.len() - 1])
        return values
    # a match arm starts with its pattern after the subject; a select has no
    # subject, and an arm's value is its last part (after the receive, send
    # or timeout, or alone in a default arm)
    mut first := 1
    if node.kind == "select_expr":
        first = 0
    elif node.children.len() < 2:
        return [0 - 1]
    mut i := first
    while i < node.children.len():
        arm := get_node(node.children[i])
        mut body_idx := 0 - 1
        mut j := first
        while j < arm.children.len():
            if node_kind(arm.children[j]) != "guard":
                body_idx = arm.children[j]
            j = j + 1
        if body_idx < 0:
            return [0 - 1]
        body := get_node(body_idx)
        if body.kind == "block":
            if not statement_always_leaves(body_idx):
                return [0 - 1]
        elif body.kind == "body":
            if body.children.len() == 0:
                return [0 - 1]
            values.push(body.children[0])
        else:
            values.push(body_idx)
        i = i + 1
    return values

# whether the branches of the match or if expression at idx are emitted
# through ir_emit_owned_branch_value. this and ir_expr_is_borrowed's answer
# for the expression come from the same two checks, so a retain is emitted
# exactly where the consumer is told the value is owned.
pub fn ir_branches_take_counts(idx: Int) -> Bool:
    return ir_branch_retain_kind(idx).len() > 0 and ir_branch_values_are_owned(idx)

# whether the identifier at `idx` names a module the file imports. a local
# spelled like the alias is a value there instead (the checker records which,
# see c_ident_is_shadowed_alias).
pub fn ir_ident_names_module(idx: Int) -> Bool:
    node := get_node(idx)
    return node.kind == "ident" and ir_module_aliases.contains_key(node.value) and not c_ident_is_shadowed_alias(idx)

# true when a field-access node is really a payload-free variant
# construction: the receiver names a boxed enum (directly, or through a
# module alias) and the member is one of its variants. mirrors the two
# dispatch paths in ir_emit_field_access_expr and ir_emit_field_access.
pub fn ir_field_access_is_bare_variant(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "field_access" or node.children.len() == 0:
        return false
    recv := get_node(node.children[0])
    mut ename := ""
    if recv.kind == "ident":
        ename = recv.value
    elif recv.kind == "field_access" and recv.children.len() > 0:
        if ir_ident_names_module(recv.children[0]):
            ename = ir_qualified_enum_name(node.children[0])
    if ename.len() == 0 or not ir_boxed_enums.contains_key(ename):
        return false
    key := ename + "." + node.value
    if not ir_struct_field_index_lookup.contains_key(key):
        return false
    return ir_struct_field_lookup.contains_key(key) and ir_struct_field_lookup[key] == ename

# true when the checker typed the expression as a String
fn ir_expr_is_string_receiver(idx: Int) -> Bool:
    tid := c_get_expr_type(idx)
    if tid < 0:
        return false
    info := get_type_info(tid)
    return info.kind == "primitive" and info.name == "String"

# whether idx is `s.to_string()` on a String, which lowers to `s` itself
fn ir_is_string_to_string(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "method_call" or node.children.len() == 0 or ir_plain_method_name(node.value) != "to_string":
        return false
    return ir_expr_is_string_receiver(node.children[0])

# every method STRING_RETURNING_METHODS names builds a new string (each one's
# row in runtime_ownership.txt says `own`), plus the few that list leaves out.
# this used to be a second, hand-kept list, and pad_left and pad_right were
# missing from it: `return s.pad_left(w, "0")` retained the fresh string as if
# it were borrowed and leaked one per call.
fn ir_string_method_returns_fresh(mname: String) -> Bool:
    if ir_is_string_returning_method(mname):
        return true
    return mname == "to_string" or mname == "trim_left" or mname == "trim_right" or mname == "pop"

# --- defer scope machinery ---
#
# the delicate invariant lives here: at every exit edge the deferred user
# statements run (innermost scope first) BEFORE ir_emit_rc_cleanup, so a
# deferred `conn.close()` still sees the locals ARC is about to release.
# emitting one deferred entry is just ir_stmt on its stored node: fresh
# registers every time, so re-emitting at several exits is safe.

# release every still-open loop's owned iterable at a function exit edge. the
# loop's own end label releases it on the normal path, but return/fail/`!` leave
# the function before that label, so release here (innermost loop first) to
# free what the end label would have. break/continue reach the end label and are
# not function exits, so they never call this.
pub fn ir_loop_iter_emit_releases():
    mut i := ir_loop_iter_vars.len() - 1
    while i >= 0:
        r := ir_reg()
        ir_emit("load " + r.to_string() + " " + ir_loop_iter_vars[i])
        ir_rc_release_reg(r, ir_loop_iter_kinds[i])
        i = i - 1

# record the producing result/optional type id for a tuple local. a rebind to a
# tuple of a different type (tid) can't pick one payload shape, so it is marked
# conflicting (-1) and never becomes cascade-eligible, a safe under-fix.
#
# a BORROWED producer is marked the same way. `v := xs[0]`, `v := s.field` and
# `v := other` hand over a shell somebody else still owns: the bind retains the
# shell and nothing at all takes a count on the payload behind it, so cascading
# that payload frees a value the container or the struct is still holding. that
# was a use-after-free wherever the container outlived the borrow (a callee
# that binds `xs[0]` and returns left its caller's list pointing at a freed
# string), and it becomes a double free the moment the shell owns its payload
# through a destructor. only a producer that transfers (a call, an await, a
# match) leaves this local the payload's sole owner, and a borrowing runtime
# getter (`v := m.get(k)`, `v := xs.first()`) does not, even though the shell
# it hands back is fresh enough that nothing else about the bind looks
# borrowed. cascading one of those releases the container's own count on an
# element it is still holding.
fn ir_tuple_record_tid(name: String, val_idx: Int):
    mut tid := c_result_widening_target(val_idx)
    widened_res := tid >= 0
    if not widened_res:
        tid = c_get_expr_type(val_idx)
    if tid < 0:
        return
    mut recorded := tid
    if not widened_res and (ir_expr_is_borrowed(val_idx) or not ir_shell_producer_transfers(val_idx)):
        recorded = 0 - 1
    if ir_tuple_local_tid.contains_key(name):
        if not ir_tuple_tids_same_shape(ir_tuple_local_tid[name], recorded):
            ir_tuple_local_tid.insert(name, 0 - 1)
        return
    ir_tuple_local_tid.insert(name, recorded)

# the runtime getters that build an optional shell around a payload they do
# NOT own a count on: the map's stored value, the list's element. the shell is
# fresh and the caller frees it, but the payload's count stays with the
# container, so a local bound to one is never the payload's last owner. the
# other optional-returning builtins are the opposite (`env_opt` and
# `char_at` mint a fresh string, a channel receive hands the sent value's
# count over), and those shells do transfer.
fn ir_runtime_getter_borrows_payload(emit_name: String) -> Bool:
    if emit_name == "map_get_opt" or emit_name == "map_get_ikey_opt" or emit_name == "map_get_bkey_opt":
        return true
    if emit_name == "pith_list_get_opt":
        return true
    return emit_name == "pith_list_first_opt" or emit_name == "pith_list_last_opt"

# the payload kind that a borrowing getter's shell must own, or "" when the
# shell can keep borrowing. a receiver that is an owned temporary
# (`make_list().get(0)`, `load_map().get(k)`) is released right after the
# call, and when that release frees the container it frees the element too,
# before anything reads it. a shell that is kept is no safer: bound, stored,
# returned or passed on (`first := xs.first()`), it outlives the expression,
# and a later `xs.clear()` freed the element under it. in either case the
# call site retains the payload and attaches the destructor, so the shell
# owns the payload the same way a transferring getter's shell does. a
# borrowed receiver whose shell an extraction consumes on the spot (an
# `if let`, a `while let` or a match subject, `.value()`, `unwrap_or`, a test
# against `none`) keeps borrowing, which is what keeps a loop of
# `if let x = xs.get(i)` free of counts; that consumer marks the subject in
# ir_getter_consumed_idx. a `T??` element is skipped: its inner shell goes
# through the extraction rules in ir_shell_producer_transfers.
pub fn ir_owned_receiver_getter_payload_kind(idx: Int, emit_name: String) -> String:
    if not ir_runtime_getter_borrows_payload(emit_name):
        return ""
    node := get_node(idx)
    if node.children.len() == 0:
        return ""
    recv_idx := node.children[0]
    if ir_rc_kind(ir_infer_type(recv_idx)).len() == 0:
        return ""
    if idx == ir_getter_consumed_idx and ir_expr_is_borrowed(recv_idx):
        return ""
    opt_tid := c_get_expr_type(idx)
    if opt_tid < 0 or get_type_info(opt_tid).kind != "optional":
        return ""
    inner_tid := get_type_info(opt_tid).inner
    if inner_tid < 0:
        return ""
    inner_kind := get_type_info(inner_tid).kind
    if inner_kind == "optional" or inner_kind == "result":
        return ""
    return ir_rc_kind(ir_type_from_tid(inner_tid))

# the rc payload kind of the optional shell a TRANSFERRING runtime getter
# hands back, or "" for every other callee. `env_opt` and the string `get`
# mint a fresh one-off string, and a channel receive hands the sent value's
# count over, but the runtime builds each shell without a destructor,
# because it cannot name this module's `__opt_dtor_<kind>` functions. so the
# call site attaches the matching one the moment the shell lands, and the
# shell owns its payload on the same terms a user function's returned Some
# does: the extraction gate's retain balances against the shell's own
# release instead of stranding one payload count per extraction. the
# borrowing getters (ir_runtime_getter_borrows_payload) must never appear
# here: their payload count stays with the container, and a destructor
# there frees an element the container still holds. a channel whose element
# is a tuple, an optional or a result is no exception: the shell the receive
# hands back owns that element like any other, and releasing the shell
# through `__opt_dtor_tuple` drops the element's count exactly as the
# channel's own drain does for the elements nobody received. this used to
# leave such an element out, and every received pair, `Int?` or result
# leaked with everything it carried.
pub fn ir_runtime_opt_producer_payload_kind(emit_name: String, obj_type: String) -> String:
    if emit_name == "env_opt" or emit_name == "pith_env_opt":
        return "string"
    if emit_name == "pith_cstring_char_at_opt":
        return "string"
    if emit_name == "pith_channel_recv" or emit_name == "pith_channel_try_recv":
        if obj_type.starts_with("channel:"):
            return ir_rc_kind(ir_resolve_type_hint(obj_type.substring(8, obj_type.len())))
        return ""
    return ""

# true when the expression that produced a result/optional shell handed its
# own count on the payload over with it. a user-declared callable does: its
# return path transfers a fresh value and retains a borrowed one, so the
# shell arrives holding the only count. so do `await`, `catch` and a match,
# which normalize to a transfer the same way.
#
# two producers do not. a borrowing runtime getter (above) leaves the count
# with the container. and an extraction out of a doubly-wrapped optional
# (`inner := outer.value()`, `inner := outer.unwrap_or(none)`, where the
# payload is itself a `T?`) hands back a RETAINED count on a shell its owner
# still holds. that shell keeps its own count on what it wraps, and releases
# it through the `__opt_dtor_<kind>` it carries. so the local is one owner of
# the shell and never the last owner of what is inside it.
fn ir_shell_producer_transfers(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "method_call" or node.children.len() == 0:
        return true
    mname := ir_plain_method_name(node.value)
    if mname == "value" or mname == "unwrap_or":
        extract_recv_tid := c_get_expr_type(node.children[0])
        if extract_recv_tid >= 0 and get_type_info(extract_recv_tid).kind == "optional":
            return false
    if ir_resolve_module_alias_method_call_name(idx).len() > 0:
        return true
    recv_type := ir_method_receiver_type(node)
    if ir_lookup_impl_method_for(node.children[0], recv_type, mname).len() > 0:
        return true
    emit_name := ir_method_emit_name(mname, recv_type)
    if ir_owned_receiver_getter_payload_kind(idx, emit_name).len() > 0:
        return true
    return not ir_runtime_getter_borrows_payload(emit_name)

# after prologue tracking is finalized, decide which tuple locals may cascade:
# a known result/optional type with an rc payload to release, and every use in
# the body provably safe. anything unknown keeps the plain shell release,
# which frees what the shell owns through its destructor and nothing more
# (leak, never UAF).
fn ir_tuple_cascade_scan(body_idx: Int):
    ir_tuple_cascade_names = []
    if body_idx < 0:
        return
    mut i := 0
    while i < ir_rc_locals.len():
        name := ir_rc_locals[i]
        mut kind := "string"
        if i < ir_rc_local_kinds.len():
            kind = ir_rc_local_kinds[i]
        # a param is a borrow: the caller owns the payload and the prologue only
        # retains the shell, so cascading one would over-release. skip anything
        # already in ir_var_regs, which at this point holds exactly the params.
        # a rejected local keeps the plain shell release. that used to make
        # it "shell-only": a name whose extraction transferred rather than
        # retained, because a retained count would have had no release. but
        # a returned Some owns its payload now, so the shell's release is
        # the balance and the extraction gate retains everywhere
        # (ir_extraction_retains).
        if kind == "tuple" and not ir_var_regs.contains_key(name):
            if ir_tuple_local_tid.contains_key(name):
                tid := ir_tuple_local_tid[name]
                if tid >= 0 and ir_tuple_local_has_rc_payload(tid):
                    is_result := get_type_info(tid).kind == "result"
                    if ir_tuple_uses_all_safe(body_idx, name, is_result):
                        ir_tuple_cascade_names.push(name)
        i = i + 1

# release a tracked local at cleanup / reassignment. a cascade-eligible tuple
# local additionally drops its owned payload before the shell is freed; every
# other local keeps the plain shell/handle release.
#
# the cascade is a CALL to a generated helper rather than inline branches on
# purpose: an inline brif would split the caller's basic block, and registers
# defined before the release (the freshly built value in a rebind, the return
# value at an exit edge) are still read after it. a single call keeps the
# surrounding block intact.
pub fn ir_rc_release_local(r: Int, kind: String, name: String):
    if kind == "tuple" and ir_tuple_cascade_names.contains(name):
        tid := ir_tuple_local_tid[name]
        info := get_type_info(tid)
        if info.kind == "result" or info.kind == "optional":
            sig := ir_tuple_cascade_signature(tid)
            if ir_stack_tuple_names.contains(name):
                if not ir_tuple_stack_cascade_sigs.contains(sig):
                    ir_tuple_stack_cascade_sigs.push(sig)
                ir_emit_call1(ir_reg(), ir_tuple_stack_cascade_helper_name(sig), "void", r)
                return
            if not ir_tuple_cascade_sigs.contains(sig):
                ir_tuple_cascade_sigs.push(sig)
            ir_emit_call1(ir_reg(), ir_tuple_cascade_helper_name(sig), "void", r)
            return
    ir_rc_release_reg(r, kind)

# a result local that owns its payload (ir_tuple_record_tid kept its type) but
# failed the cascade walk, because some use may share the box. at the
# function's exit it drops its count the way a fresh argument does: the
# payload goes with the box when this count is the last, and stays with the
# other holder otherwise. a plain release freed the shell alone and leaked
# the payload whenever nothing had given the box a destructor (a box handed
# to a closure). a rebind keeps the plain release: an alias of the old
# payload may still be read after it.
pub fn ir_result_local_releases_by_count(kind: String, name: String) -> Bool:
    if kind != "tuple" or ir_tuple_cascade_names.contains(name) or ir_stack_tuple_names.contains(name):
        return false
    if not ir_tuple_local_tid.contains_key(name):
        return false
    tid := ir_tuple_local_tid[name]
    return tid >= 0 and get_type_info(tid).kind == "result" and ir_tuple_local_has_rc_payload(tid)

# a result box handed back whole by a function that returns the box (the box
# abi, which generic functions and most interface impl methods use) has to be
# one the caller owns alone. every caller that opens a call's box takes the
# payload's count over and frees the shell, which is right only when nothing
# else holds the box. a box that also sits in a holder carries the payload
# destructor (ir_attach_result_box_dtor), and the holder would release that
# payload a second time. a forwarded parameter, field, element or shared local
# is such a box, so where the count says it is shared this returns a fresh box
# with its own count on the live payload and drops the count it was given on
# the shared one. the register abi does the same when it returns a borrowed
# box as the pair (ir_emit_return_box_as_pair).
pub fn ir_emit_result_box_unshare(box_r: Int, tid: Int) -> Int:
    sig := ir_tuple_cascade_signature(tid)
    if sig == "00":
        return box_r
    if not ir_result_unshare_sigs.contains(sig):
        ir_result_unshare_sigs.push(sig)
    if not ir_tuple_stack_cascade_sigs.contains(sig):
        ir_tuple_stack_cascade_sigs.push(sig)
    r := ir_reg()
    ir_emit_call1(r, ir_result_unshare_helper_name(sig), "tuple", box_r)
    return r

# a box handed to a caller as its sole owner must not carry the payload
# destructor an earlier share gave it (the unshare above, or a holder's
# ir_attach_result_box_dtor): the caller takes the payload's count over and
# frees the shell, and the destructor would release the payload under it.
pub fn ir_emit_clear_result_box_dtor(box_r: Int):
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit_call2(ir_reg(), "pith_struct_set_dtor", "void", box_r, zero_r)

# release every rc local the function owns before a return, minus `exclude`,
# the one being returned (its count transfers to the caller). the prologue
# zero-stores each tracked name, so the loads are valid on every path.
pub fn ir_emit_rc_cleanup(exclude: String):
    for r, ri in ir_inflight_regs:
        ir_release_inflight_kind(r, ir_inflight_kinds[ri])
    mut i := 0
    while i < ir_rc_locals.len():
        name := ir_rc_locals[i]
        mut kind := "string"
        if i < ir_rc_local_kinds.len():
            kind = ir_rc_local_kinds[i]
        if name != exclude and ir_rc_release_enabled(kind):
            r := ir_reg()
            ir_emit_local_slot_load(r, name)
            if ir_result_local_releases_by_count(kind, name):
                ir_emit_result_box_release(r, ir_tuple_local_tid[name])
            else:
                ir_rc_release_local(r, kind, name)
        i = i + 1
    # a kinded local releases what the last binding on the path taken left in
    # its slot, under the kind that binding recorded. a return never
    # transfers one (ir_rc_local_kind does not report it, so the return
    # retains its value like any borrow), so no exclusion applies.
    for kname in ir_kinded_rc_binds:
        ir_kinded_release_slot(kname)
    for tname in ir_task_owner_locals:
        tr := ir_reg()
        ir_emit_local_slot_load(tr, tname)
        ir_emit_task_owner_detach(tr)

# the type a binding gives its name for the owned-local pre-pass: the
# annotation when there is one, otherwise what the checker or inference says
# the value is, corrected for the shapes listed below.
pub fn ir_prepass_bind_type(parts: IrBindParts, names: List[String]) -> String:
    # a binding declared with a bare `none` and no annotation has the none type,
    # which is not an rc kind, so the name was poisoned and its shell released
    # nowhere. the bind allocates the same two-slot tuple an annotated optional
    # does, so it is tracked the same way: `b := none` and `b: T? := none` now
    # differ in what the checker knows, not in what the emitter frees.
    if parts.type_idx < 0 and parts.val_idx >= 0:
        if get_node(parts.val_idx).kind == "none_lit":
            return "tuple"
    mut bind_type := ""
    if parts.type_idx >= 0:
        bind_type = ir_resolve_type_node(parts.type_idx)
    if bind_type.len() == 0 and parts.val_idx >= 0:
        # the collected names double as a type environment: a bind from an
        # already-collected name chains its tracking (and kind), so a later
        # rebind of the source cannot release a value this variable shares.
        val_node := get_node(parts.val_idx)
        if val_node.kind == "ident" and names.contains(val_node.value):
            bind_type = ir_rc_local_kind(val_node.value)
            # the chained kind is the kind of the source's first binding.
            # when another site binds the source under a different kind,
            # this read can see that binding, so the checker's type for the
            # read takes precedence. the caller runs the result through
            # ir_rc_kind, which reads a type hint: the chained kind `struct`
            # is not one and came back empty, so `mut b := a` with a struct
            # `a` went untracked and a later `b = f()` leaked the fresh value.
            # the checked type carries the same kind as a valid hint.
            read_type := ir_checked_type(parts.val_idx)
            if ir_rc_kind(read_type).len() > 0:
                bind_type = read_type
        else:
            # the checker's recorded type resolves module-qualified calls
            # (bytes.from_string_utf8 and friends) that local inference
            # cannot; inference stays as the fallback
            bind_type = ir_checked_type(parts.val_idx)
            if bind_type.len() == 0:
                bind_type = ir_infer_type(parts.val_idx)
            # a call whose checked type carries no rc kind while the emitter's
            # own result kind does. generic bodies are typed before emission,
            # so this no longer fires for them; the one corpus case is a
            # concrete body binding a no-payload enum, which lowers as an int
            # and which ir_expr_result_kind still reports as a struct (#1038).
            # kept until that classifier agrees with the lowering.
            if (ir_rc_kind(bind_type).len() == 0 or ir_generic_name_unresolved(bind_type)) and (val_node.kind == "method_call" or val_node.kind == "call"):
                bind_type = ir_expr_result_kind(parts.val_idx)
            # a catch binds the guarded result's OK value. the checker leaves
            # the catch node's type empty for collections (and inference reports
            # the underlying result tuple), so a list/map/set binding would be
            # released with the wrong struct-shaped kind and leak its backing.
            # take the ok kind the emitter itself uses for the ok field.
            if (val_node.kind == "catch_expr" or val_node.kind == "catch_block") and val_node.children.len() > 0:
                catch_ok := ir_result_ok_kind_for_expr(val_node.children[0])
                if ir_rc_kind(catch_ok).len() > 0:
                    bind_type = catch_ok
    return bind_type

# the prepass policy for one owned-local candidate: track the name under its
# rc kind, or poison it. a name is poisoned when two sites bind it under
# different rc kinds, or when any site binds it under a non-rc or unknown
# type, because one exit release cannot be right for every path. the
# prologue removes poisoned names from the single-kind tracking. a poisoned
# name that some site bound under an rc kind (and that was therefore tracked
# at some point) becomes a kinded local (ir_kinded_rc_binds): each binding
# site records the kind of the count it took in a side slot, a rebind
# releases the outgoing value under the recorded kind, and the exit cleanup
# releases the value the last binding on the path taken stored. a poisoned
# name that no site binds under an rc kind never holds a count and is not
# tracked. `names` is the live tracking list (ir_rc_locals, which
# ir_rc_track_local appends to), so contains() here means "already tracked
# by an earlier binding".
fn ir_prepass_track_or_poison(name: String, kind: String, names: List[String], poisoned: List[String]):
    if kind.len() > 0:
        if names.contains(name):
            if ir_rc_local_kind(name) != kind and not poisoned.contains(name):
                poisoned.push(name)
        else:
            ir_rc_track_local(name, kind)
    elif not poisoned.contains(name):
        poisoned.push(name)

# a tuple nested in a variant payload binds its elements with counts of their
# own (ir_emit_pattern_bindings in ir_match_emit), so its bindings are tracked
# like the payload bindings around them. a variant nested further down has its
# own bindings tracked when the walk reaches it.
fn ir_prepass_track_payload_tuple_binds(pat_idx: Int, names: List[String], poisoned: List[String]):
    pat := get_node(pat_idx)
    if pat.kind == "pat_or":
        for alt in pat.children:
            ir_prepass_track_payload_tuple_binds(alt, names, poisoned)
        return
    if pat.kind != "pat_tuple":
        return
    elems := ir_match_tuple_element_kinds(pat_idx, pat.children.len())
    for sub_idx, i in pat.children:
        sub := get_node(sub_idx)
        if sub.kind == "pat_binding":
            ir_prepass_track_or_poison(sub.value, ir_rc_kind(elems[i]), names, poisoned)
        else:
            ir_prepass_track_payload_tuple_binds(sub_idx, names, poisoned)

# a top-level match pattern on a non-optional subject binds uncounted views
# (pat_binding, pat_tuple, or alternatives under pat_or). poison each such
# binding name so a sibling arm or earlier local binding the same name with
# an owned rc value becomes a kinded local instead of releasing an integer or
# view under the other binding's rc kind at function exit. stops at
# pat_variant because variant payload bindings own their own counts and are
# handled by the pat_variant branch below.
fn ir_prepass_poison_uncounted_pat_binds(pat_idx: Int, names: List[String], poisoned: List[String]):
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        ir_prepass_track_or_poison(pat.value, "", names, poisoned)
    elif pat.kind == "pat_tuple" or pat.kind == "pat_or":
        for child in pat.children:
            ir_prepass_poison_uncounted_pat_binds(child, names, poisoned)

# pre-pass: names of rc-typed binds anywhere in the body. an
# under-approximation is safe (a missed name is never released, a leak),
# while emission-time classification only widens, never narrows, so every
# collected name really does hold owned counts.
fn ir_collect_rc_bind_names(idx: Int, names: List[String], poisoned: List[String]):
    node := get_node(idx)
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if parts.name.len() > 0:
            # a `weak` binding is tracked under its own kind: its slot holds a
            # bare target pointer counted on the header's WEAK count, so the
            # cleanup must weak_release it. the type-derived kind ("struct")
            # would strong-release a count the binding never took. the checker
            # rejects any reuse of a weak name in the same function, so the
            # kind-conflict poisoning below cannot silently untrack one.
            mut kind := ""
            if node.value.contains(" weak"):
                kind = "weak"
            else:
                # substitute struct params (C -> the concrete type) so a bind of a
                # generic element (c := list[i] in a generic impl) is tracked and
                # retained; otherwise the element frees when the list is mutated and
                # the returned value dangles. no-op outside a specialized body.
                kind = ir_rc_kind(ir_substitute_type_name(ir_prepass_bind_type(parts, names)))
            ir_prepass_track_or_poison(parts.name, kind, names, poisoned)
            # remember the producing result/optional type so the cleanup path
            # can cascade-release the payload (only for cascade-eligible locals)
            if kind == "tuple" and parts.val_idx >= 0:
                ir_tuple_record_tid(parts.name, parts.val_idx)
    # a match on an OPTIONAL subject binds the unwrapped payload, and
    # ir_match_emit retains an rc payload so the binding owns its own count
    # (the subject's shell or cascade can die at scope exit while the
    # binding lives on). track each such binding for the exit cleanup,
    # under the same name-conflict poisoning as every other owned local.
    # unlike the pat_variant hook below, this one keys on the match itself
    # (it needs the subject's tid) and so sees only each arm's top-level
    # pattern; a binding nested under pat_or is not tracked here.
    if node.kind == "match_expr" and node.children.len() > 1:
        subj_tid := c_get_expr_type(node.children[0])
        if subj_tid >= 0 and get_type_info(subj_tid).kind == "optional":
            payload_kind := ir_rc_kind(ir_type_from_tid(get_type_info(subj_tid).inner))
            mut ai := 1
            while ai < node.children.len():
                arm := get_node(node.children[ai])
                if arm.children.len() > 0:
                    pn := get_node(arm.children[0])
                    if pn.kind == "pat_binding":
                        ir_prepass_track_or_poison(pn.value, payload_kind, names, poisoned)
                    else:
                        ir_prepass_poison_uncounted_pat_binds(arm.children[0], names, poisoned)
                ai = ai + 1
        else:
            mut ai := 1
            while ai < node.children.len():
                arm := get_node(node.children[ai])
                if arm.children.len() > 0:
                    ir_prepass_poison_uncounted_pat_binds(arm.children[0], names, poisoned)
                ai = ai + 1
    # a select receive arm manages its received binding's own lifetime (released
    # at the end of the arm or moved as the select value), so poison its name if
    # another site in the function tracks the same name as an rc local.
    if node.kind == "select_recv_arm" and node.value.len() > 0:
        ir_prepass_track_or_poison(node.value, "", names, poisoned)
    # an `if let` / `while let` bare binding on an optional subject binds the
    # unwrapped payload the way a match arm does, and ir_emit_let_bindings
    # gives an rc payload its own count on the terms of the shared
    # counted-extraction gate (ir_extraction_retains). track the name so the
    # prologue zero-stores it and the exit cleanup releases it (or a return
    # transfers it), under the same name-conflict poisoning as every other
    # owned local.
    if (node.kind == "if_let" or node.kind == "while_let") and node.children.len() > 1:
        let_pat := get_node(node.children[0])
        if let_pat.kind == "pat_binding":
            let_tid := c_get_expr_type(node.children[1])
            if let_tid >= 0 and get_type_info(let_tid).kind == "optional":
                let_kind := ir_rc_kind(ir_type_from_tid(get_type_info(let_tid).inner))
                # a tuple payload is an inner optional shell whose count stays
                # with its owner (a container element, an outer shell).
                # tracking it would enroll the name in the tuple shell-only
                # machinery and flip the downstream extraction gate to
                # transfer semantics, stripping a count the owner still holds:
                # a use-after-free on `if let v = m.get(k)` over optional
                # map values. poison the name instead: no exit release of any
                # kind, and the binding stays the uncounted view it was.
                if let_kind == "tuple":
                    if not poisoned.contains(let_pat.value):
                        poisoned.push(let_pat.value)
                else:
                    ir_prepass_track_or_poison(let_pat.value, let_kind, names, poisoned)
    # a match arm's payload bindings are owned locals too: ir_match_emit
    # retains each rc payload, so track them here for the exit cleanup to
    # release (or transfer on escape), same as any other owned local.
    if node.kind == "pat_variant" and node.children.len() > 0:
        # a generic enum's declaration records parameter names as payload
        # kinds; the instance the pattern matches (the checker records it on
        # the pattern, falling back to the enclosing match's subject) has the
        # concrete kinds that decide whether a binding is tracked.
        # ir_emit_match_bindings retains by those resolved kinds, so tracking
        # by the declared ones left every generic rc payload binding retained
        # and never released. a pattern nested in a payload resolves against
        # its own slot's enum, not the subject's.
        mut fallback_tid := 0 - 1
        if ir_prepass_subject_tids.len() > 0:
            fallback_tid = ir_prepass_subject_tids[ir_prepass_subject_tids.len() - 1]
        variant_kinds := ir_variant_pattern_kinds_for(idx, fallback_tid)
        for sub_idx, pi in node.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                mut payload_kind := ""
                if pi < variant_kinds.len():
                    payload_kind = ir_rc_kind(variant_kinds[pi])
                # a plain-value slot (empty kind) poisons the name: a sibling
                # arm may bind it with an rc payload (Zed(Pack, _) versus
                # Beta(Int, _) sharing x0), and releasing the rc kind at exit
                # would dereference whatever integer the last-run arm stored.
                ir_prepass_track_or_poison(sub.value, payload_kind, names, poisoned)
            else:
                ir_prepass_track_payload_tuple_binds(sub_idx, names, poisoned)
    # a match whose arms bind uncounted views of a borrowed subject owns a
    # hidden slot that pins the subject (ir_match_pin_kind)
    if node.kind == "match_expr" and node.children.len() > 1:
        pin_kind := ir_match_pin_kind(idx)
        if pin_kind.len() > 0:
            ir_prepass_track_or_poison(ir_match_pin_name(idx), pin_kind, names, poisoned)
    # remember the subject under a match so nested variant patterns can
    # resolve a generic enum's payload kinds against the instance (above)
    if node.kind == "match_expr" and node.children.len() > 1:
        ir_prepass_subject_tids.push(c_get_expr_type(node.children[0]))
        for child in node.children:
            ir_collect_rc_bind_names(child, names, poisoned)
        ir_prepass_subject_tids.remove(ir_prepass_subject_tids.len() - 1)
        return
    for child in node.children:
        ir_collect_rc_bind_names(child, names, poisoned)

# a catch-all binding (`x => ...`) and a tuple pattern's elements are views
# of the match subject that take no count of their own. that is safe while
# the subject outlives the arm, but a borrowed subject (a field, an element,
# a local) can be dropped by the arm itself: `match h.c: x => h.c = other`
# freed `x` under the arm still reading it. such a match pins the subject in
# a hidden local for the length of the match, tracked like any owned local so
# a return or an error exit releases it too. the rc kind to pin under, or ""
# when no arm can drop the subject: an optional subject binds counted
# payloads, an owned subject is the match's own, `self` outlives the call,
# and an arm that keeps storage (ir_subtree_keeps_storage) and does not
# rebind a local subject cannot drop it.
fn ir_match_pin_kind(match_idx: Int) -> String:
    node := get_node(match_idx)
    subj_idx := node.children[0]
    tid := c_get_expr_type(subj_idx)
    if tid < 0 or get_type_info(tid).kind == "optional":
        return ""
    kind := ir_rc_kind(ir_type_from_tid(tid))
    if kind.len() == 0 or node_kind(subj_idx) == "self" or not ir_expr_is_borrowed(subj_idx):
        return ""
    mut i := 1
    while i < node.children.len():
        arm := get_node(node.children[i])
        if arm.children.len() > 0 and ir_pattern_binds_view(arm.children[0]):
            mut j := 1
            while j < arm.children.len():
                if ir_match_arm_part_may_drop(arm.children[j], subj_idx):
                    return kind
                j = j + 1
        i = i + 1
    return ""

## match pin name.
pub fn ir_match_pin_name(match_idx: Int) -> String:
    return "__match_pin_" + match_idx.to_string()

# true for a pattern that binds a name to the subject itself or to a tuple
# element, which ir_emit_match_bindings binds without a count. everything
# below a variant payload binds with a count, so the walk stops there.
fn ir_pattern_binds_view(pat_idx: Int) -> Bool:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        return true
    if pat.kind == "pat_tuple" or pat.kind == "pat_or":
        for child in pat.children:
            if ir_pattern_binds_view(child):
                return true
    return false

fn ir_match_arm_part_may_drop(part_idx: Int, subj_idx: Int) -> Bool:
    subj := get_node(subj_idx)
    if subj.kind == "ident":
        return ir_subtree_assigns_name(part_idx, subj.value) or ir_subtree_binds_name(part_idx, subj.value)
    return not ir_subtree_keeps_storage(part_idx, 0 - 1, 0 - 1)

# params are borrows: the caller keeps its count alive for the whole call,
# so an unmodified string param needs no rc traffic at all. a param the
# body reassigns becomes an owned local, retained in the prologue so
# release-on-reassign and exit cleanup stay balanced with the caller.
fn ir_collect_reassigned_string_params(idx: Int, names: List[String]):
    node := get_node(idx)
    mut target := ""
    if node.kind == "assign":
        target = node.value
    elif node.kind == "assignment" and node.children.len() > 0:
        tn := get_node(node.children[0])
        if tn.kind == "ident":
            target = tn.value
    if target.len() > 0 and not names.contains(target):
        if ir_var_regs.contains_key(target):
            kind := ir_rc_kind(ir_lookup_name_type(target))
            if kind.len() > 0:
                ir_rc_track_local(target, kind)
    for child in node.children:
        ir_collect_reassigned_string_params(child, names)

# drop names from this frame's owned-local tracking. used for a lambda's
# captures, which the closure environment owns.
pub fn ir_untrack_rc_locals(names: List[String]):
    if names.len() == 0:
        return
    mut kept: List[String] := []
    mut kept_kinds: List[String] := []
    mut i := 0
    while i < ir_rc_locals.len():
        if not names.contains(ir_rc_locals[i]):
            kept.push(ir_rc_locals[i])
            if i < ir_rc_local_kinds.len():
                kept_kinds.push(ir_rc_local_kinds[i])
            else:
                kept_kinds.push("string")
        i = i + 1
    ir_rc_locals = kept
    ir_rc_local_kinds = kept_kinds

# string bindings that can borrow a list element instead of counting it.
# `k := keys[i]` normally retains the element and releases the previous k
# on every pass. that pair is pure overhead when nothing can drop the
# element while k is in use, so a binding qualifies, and leaves this frame's
# tracking the way an unmodified string param does, when all of these hold:
#
#   - k is a string, bound only here, never assigned, and not mut
#   - the value is xs[...] where xs is a list param or an owned list local
#   - k is used only in the statements after the binding in its own block
#   - those statements pass ir_borrow_range_is_safe: no user code, no loop
#     (a back edge can yield to another task), no closure, and no write
#     that could reach a list
#
# a binding of a threadlocal string global, `input := parser_input`, also
# qualifies under the same rules, except that loops are allowed: the value
# lives in this task's own slot, which nothing outside the range can reach.
fn ir_borrowed_element_binds(body_idx: Int) -> List[String]:
    mut names: List[String] := []
    if body_idx >= 0:
        ir_collect_borrowed_element_binds(body_idx, body_idx, names)
    return names

fn ir_collect_borrowed_element_binds(idx: Int, body_idx: Int, names: List[String]):
    node := get_node(idx)
    mut i := 0
    while i < node.children.len():
        child := node.children[i]
        if ir_bind_can_borrow_element(node, i, body_idx):
            names.push(ir_collect_bind_parts(get_node(child)).name)
        ir_collect_borrowed_element_binds(child, body_idx, names)
        i = i + 1

# true when the binding at `block.children[pos]` qualifies under the rules
# listed at ir_borrowed_element_binds. the closing count is what proves the
# name is used only in its own block's later statements: every mention of it
# in the body is either the binding itself or inside that range.
fn ir_bind_can_borrow_element(block: Node, pos: Int, body_idx: Int) -> Bool:
    bind := get_node(block.children[pos])
    if not ir_is_binding_kind(bind.kind) or bind.value.contains(" "):
        return false
    parts := ir_collect_bind_parts(bind)
    name := parts.name
    if parts.val_idx < 0 or ir_rc_local_kind(name) != "string":
        return false
    val := get_node(parts.val_idx)
    mut src := ""
    mut loops_ok := false
    if val.kind == "ident" and ir_name_is_threadlocal(val.value) and ir_threadlocal_kinds[ir_tls_key(val.value)] == "string":
        # a threadlocal string: no other thread or task can reach this task's
        # slot, so only code in the range below could replace the value, and
        # a loop's back edge is safe as well
        src = val.value
        loops_ok = true
    else:
        if val.kind != "index" or val.children.len() < 2 or ir_expr_is_fresh_string_index(parts.val_idx):
            return false
        base := get_node(val.children[0])
        if base.kind != "ident" or not ir_infer_type(val.children[0]).starts_with("list"):
            return false
        src = base.value
        if ir_loop_var_slot(src).len() > 0:
            return false
        if ir_rc_local_kind(src).len() == 0 and not ir_var_regs.contains_key(src):
            return false
    if ir_count_name_nodes(parts.val_idx, name) > 0:
        return false
    if ir_subtree_assigns_name(body_idx, name):
        return false
    mut in_range := 0
    mut j := pos + 1
    while j < block.children.len():
        if not ir_borrow_range_is_safe(block.children[j], src, loops_ok):
            return false
        in_range = in_range + ir_count_name_nodes(block.children[j], name)
        j = j + 1
    return ir_count_name_nodes(body_idx, name) == ir_count_name_nodes(block.children[pos], name) + in_range

fn ir_borrow_range_is_safe(idx: Int, src: String, loops_ok: Bool) -> Bool:
    node := get_node(idx)
    kind := node.kind
    if node.children.len() == 0:
        return true
    if kind == "method_call":
        if not ir_borrow_method_is_safe(idx):
            return false
    elif kind == "call":
        callee := get_node(node.children[0])
        if callee.kind != "ident" or ir_is_declared_callable(callee.value):
            return false
        if not ["print", "ord", "chr"].contains(callee.value):
            return false
    elif kind == "assignment":
        target := get_node(node.children[0])
        if target.kind == "ident" and target.value == src:
            return false
        if target.kind == "index" and target.children.len() > 0 and ir_infer_type(target.children[0]).starts_with("list"):
            return false
    elif kind == "assign":
        if node.value == src or node.children.len() >= 2:
            return false
    elif not ["binary", "unary", "grouped", "index", "field_access", "arg", "if_stmt", "then", "elif", "else", "block", "binding", "bind", "return", "if_expr", "elif_branch"].contains(kind):
        if not loops_ok or not ["while", "while_stmt", "break", "continue"].contains(kind):
            return false
    for child in node.children:
        if not ir_borrow_range_is_safe(child, src, loops_ok):
            return false
    return true

# a builtin method that cannot drop a list element: any method on a map, a
# set or a string, and the read-only ones on a list.
fn ir_borrow_method_is_safe(idx: Int) -> Bool:
    node := get_node(idx)
    if node.children.len() == 0 or ir_resolve_module_alias_method_call_name(idx).len() > 0:
        return false
    recv_type := ir_infer_type(node.children[0])
    if recv_type.starts_with("map") or recv_type.starts_with("set") or recv_type == "string":
        return ["contains_key", "contains", "insert", "get", "remove", "len", "add", "starts_with", "ends_with", "index_of", "is_empty"].contains(node.value)
    if recv_type.starts_with("list"):
        return ["len", "contains", "is_empty"].contains(node.value)
    return false

# closure bindings that can be built in a stack slot instead of on the heap.
# `f := fn(x: Int) => base + x` allocates a closure, and a loop that rebinds
# it allocates and frees one per pass, though all it ever does is call f. a
# binding qualifies, and leaves this frame's tracking, when:
#
#   - f is bound only here, never assigned, and not mut
#   - every other mention of f is the callee of a call outside any lambda, so
#     f is never stored, passed, returned or captured
#   - nothing the lambda reads carries a count (ir_lambda_reads_uncounted), so
#     the closure owns nothing it would have to release
fn ir_stack_closure_binds(body_idx: Int) -> List[String]:
    mut names: List[String] := []
    if body_idx >= 0:
        ir_collect_stack_closure_binds(body_idx, body_idx, names)
    return names

fn ir_collect_stack_closure_binds(idx: Int, body_idx: Int, names: List[String]):
    node := get_node(idx)
    if ir_is_binding_kind(node.kind) and not node.value.contains(" "):
        parts := ir_collect_bind_parts(node)
        if parts.val_idx >= 0 and node_kind(parts.val_idx) == "lambda" and ir_rc_local_kind(parts.name) == "closure":
            name := parts.name
            if not ir_subtree_assigns_name(body_idx, name) and ir_count_name_nodes(body_idx, name) == 1 + ir_count_direct_calls(body_idx, name) and ir_lambda_reads_uncounted(parts.val_idx):
                names.push(name)
    for child in node.children:
        ir_collect_stack_closure_binds(child, body_idx, names)

# the owned-local prologue: collect the body's rc locals, zero-store each one
# and retain reassigned params (params are locals under the same rule, so the
# exit cleanup releasing them stays balanced with the caller's count).
pub fn ir_emit_rc_prologue(body_idx: Int):
    # before anything resolves a name: everything this body binds is this
    # function's own storage, whatever a module global is spelled.
    ir_begin_func_local_names(body_idx)
    mut poisoned: List[String] := []
    if body_idx >= 0:
        ir_collect_reassigned_string_params(body_idx, ir_rc_locals)
        ir_collect_rc_bind_names(body_idx, ir_rc_locals, poisoned)
    ir_kinded_rc_binds = []
    ir_kinded_release_symbol = "__kinded_release_m" + ir_module_count.to_string()
    if poisoned.len() > 0:
        mut kept: List[String] := []
        mut kept_kinds: List[String] := []
        mut pi := 0
        while pi < ir_rc_locals.len():
            pname := ir_rc_locals[pi]
            if not poisoned.contains(pname):
                kept.push(pname)
                if pi < ir_rc_local_kinds.len():
                    kept_kinds.push(ir_rc_local_kinds[pi])
                else:
                    kept_kinds.push("string")
            elif not ir_rc_prologue_captures.contains(pname):
                # a poisoned name some site binds under an rc kind: it
                # leaves the single-kind tracking for the kinded form, whose
                # side slot records the kind of what the slot owns.
                ir_kinded_rc_binds.push(pname)
            pi = pi + 1
        ir_rc_locals = kept
        ir_rc_local_kinds = kept_kinds
        # publish the poisoned names. the kinded ones are zero-stored below
        # with their side slots; the rest never hold a count, get no
        # zero-store, and the match emitter skips the release-of-previous
        # value for them, which would load a name the ir has not declared.
        ir_untracked_rc_binds = poisoned
    # with the final tracked set known, decide which tuple locals may cascade
    # their payload at cleanup (all uses provably safe); the rest stay shell-only
    ir_untrack_rc_locals(ir_borrowed_element_binds(body_idx))
    ir_stack_closure_names = ir_stack_closure_binds(body_idx)
    ir_untrack_rc_locals(ir_stack_closure_names)
    ir_stack_closure_regs = []
    ir_fn_arg_lambda_symbols = {}
    ir_tuple_cascade_scan(body_idx)
    ir_stack_tuple_names = ir_stack_tuple_binds(body_idx)
    mut i := 0
    while i < ir_rc_locals.len():
        name := ir_rc_locals[i]
        if ir_var_regs.contains_key(name):
            # param: retain the caller's value, no zero-store
            r := ir_reg()
            ir_emit_name_load(r, name)
            ir_rc_retain_reg(r, ir_rc_local_kind(name))
        else:
            z := ir_reg()
            ir_emit("iconst " + z.to_string() + " 0")
            ir_emit_name_store(name, z)
        i = i + 1
    for kname in ir_kinded_rc_binds:
        mut code := 0
        if ir_var_regs.contains_key(kname):
            # a parameter rebound under another kind: it starts out owning a
            # count of its own on the caller's value, the way a tracked
            # reassigned parameter does, so the first rebind can drop it.
            pkind := ir_rc_kind(ir_lookup_name_type(kname))
            code = ir_kinded_code(pkind)
            if code > 0:
                pr := ir_reg()
                ir_emit("load " + pr.to_string() + " " + kname)
                ir_rc_retain_reg(pr, pkind)
        else:
            z := ir_reg()
            ir_emit("iconst " + z.to_string() + " 0")
            ir_emit("store " + kname + " " + z.to_string())
        code_r := ir_reg()
        ir_emit("iconst " + code_r.to_string() + " " + code.to_string())
        ir_emit("store " + ir_kinded_tag_slot(kname) + " " + code_r.to_string())
    ir_task_owner_locals = ir_collect_task_owners(body_idx)
    for tname in ir_task_owner_locals:
        z := ir_reg()
        ir_emit("iconst " + z.to_string() + " 0")
        ir_emit_name_store(tname, z)

# the locals of a function body that own their task: each is bound to a
# `spawn` at every site that binds it, and otherwise only awaited, polled
# with is_done or detached. an exit edge or a rebind detaches whatever handle
# the slot still holds, so a task nobody awaits gives back its slot (and on
# the os-thread backend its thread) once it ends. detaching a handle an await already retired
# is a no-op, so no path has to know whether it awaited. any other use (an
# argument, a return, a store, a capture, another variable of the same
# name) lets the handle out of the function, which then leaves it alone.
fn ir_collect_task_owners(body_idx: Int) -> List[String]:
    mut owners: List[String] := []
    if body_idx < 0:
        return owners
    mut candidates: List[String] := []
    ir_task_owner_candidates(body_idx, candidates)
    if candidates.len() == 0:
        return owners
    mut escaped: List[String] := []
    ir_task_owner_escapes(body_idx, 0 - 1, candidates, escaped, false)
    for name in candidates:
        if not escaped.contains(name) and not ir_var_regs.contains_key(name) and not ir_rc_locals.contains(name) and not ir_kinded_rc_binds.contains(name):
            owners.push(name)
    return owners

# every name a binding outside any lambda gives a `spawn`.
fn ir_task_owner_candidates(idx: Int, names: List[String]):
    node := get_node(idx)
    if node.kind == "lambda":
        return
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if parts.val_idx >= 0 and node_kind(parts.val_idx) == "spawn" and not names.contains(parts.name):
            names.push(parts.name)
    for child in node.children:
        ir_task_owner_candidates(child, names)

# the candidates some node uses in a way that lets the handle escape.
fn ir_task_owner_escapes(idx: Int, parent_idx: Int, names: List[String], escaped: List[String], in_lambda: Bool):
    node := get_node(idx)
    if node.kind == "ident":
        if names.contains(node.value) and (in_lambda or not ir_task_owner_use_is_safe(idx, parent_idx)):
            escaped.push(node.value)
        return
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if names.contains(parts.name) and (in_lambda or parts.val_idx < 0 or node_kind(parts.val_idx) != "spawn"):
            escaped.push(parts.name)
    elif node.kind == "assign":
        if names.contains(node.value) and (in_lambda or node.children.len() != 1 or node_kind(node.children[0]) != "spawn"):
            escaped.push(node.value)
    elif node.kind == "assignment" and node.children.len() == 2 and node_kind(node.children[0]) == "ident" and names.contains(node_value(node.children[0])):
        # `t = spawn f()` keeps the handle in its local, which the rebind
        # detaches the old one for. any other assignment to it lets it out.
        if in_lambda or node.value != "=" or node_kind(node.children[1]) != "spawn":
            escaped.push(node_value(node.children[0]))
        ir_task_owner_escapes(node.children[1], idx, names, escaped, in_lambda)
        return
    elif node.kind != "method_call" and node.kind != "field_access" and node.value.len() > 0:
        # a loop, pattern or parameter binding of the same name is another
        # variable, and the slot cannot tell the two apart.
        for name in names:
            if ir_value_mentions_name(node.value, name):
                escaped.push(name)
    for child in node.children:
        ir_task_owner_escapes(child, idx, names, escaped, in_lambda or node.kind == "lambda")

# true for the uses that keep a task handle in its local: the operand of an
# await, and the receiver of is_done or detach.
fn ir_task_owner_use_is_safe(idx: Int, parent_idx: Int) -> Bool:
    if parent_idx < 0:
        return false
    parent := get_node(parent_idx)
    if parent.kind == "await":
        return true
    if parent.kind == "method_call" and parent.children.len() > 0 and parent.children[0] == idx:
        return parent.value == "is_done" or parent.value == "detach"
    return false

# detach the task a task-owning local holds, read into `r`.
pub fn ir_emit_task_owner_detach(r: Int):
    ir_emit_call1(ir_reg(), "pith_task_detach", "void", r)

# a widened argument's register is the optional wrapper, not the value the
# release walkers were written against. releasing it as a string or an rc
# payload would drop a count on the wrong object. the wrapper owns whatever it
# holds (ir_emit_value_for_target attaches the destructor), so skipping the
# caller-side release leaks the wrapper rather than freeing something twice.
fn ir_arg_release_is_skipped(expr_idx: Int) -> Bool:
    return expr_idx >= 0 and c_argument_widens_to_optional(expr_idx)

# a struct field, a container element or a `mut` global read as an argument
# hands the callee the owner's count and none of its own. that is enough for a
# builtin, but a callee that runs user code can overwrite that field, evict
# that element or reassign that global, directly or through another task it
# lets run, and the value then dies under the parameter that still names it.
# so an argument like that is pinned for the call: retained as soon as it is
# evaluated, and released once the call returns. a local or a parameter needs
# no pin, since only this frame can rebind it, and neither does a global that
# is not `mut`.
#
# the rc kind to pin the argument at expr_idx as, or "" for none.
pub fn ir_arg_pin_kind(expr_idx: Int) -> String:
    if c_argument_widens_to_optional(expr_idx) or not ir_expr_is_borrowed(expr_idx):
        return ""
    mut read_idx := expr_idx
    # `s.to_string()` on a String is the receiver itself (see
    # ir_expr_is_borrowed), so it needs a pin exactly when the receiver does.
    # `f(o.name.to_string(), rename(o))` freed the name under the argument.
    while ir_is_string_to_string(read_idx) or (node_kind(read_idx) == "grouped" and get_node(read_idx).children.len() > 0):
        read_idx = get_node(read_idx).children[0]
    read_kind := node_kind(read_idx)
    # any other borrowed method result is a builtin's view into storage this
    # frame does not own, so it is pinned like a field or element read
    if read_kind == "ident":
        if not ir_reads_mutable_global(get_node(read_idx).value):
            return ""
    elif read_kind != "field_access" and read_kind != "index" and read_kind != "method_call":
        return ""
    kind := ir_rc_kind(ir_infer_type(read_idx))
    if kind == "weak":
        return ""
    return kind

# pin one operand when a later one can drop it; the kind to unpin, or ""
pub fn ir_pin_operand(expr_idx: Int, reg: Int, later_drops: Bool) -> String:
    if not later_drops:
        return ""
    kind := ir_arg_pin_kind(expr_idx)
    if kind.len() > 0:
        ir_rc_retain_reg(reg, kind)
    return kind

## unpin operand.
pub fn ir_unpin_operand(reg: Int, kind: String):
    if kind.len() > 0:
        ir_rc_release_reg(reg, kind)

# pin the operand just evaluated into `reg` when `pin` is set and it needs it,
# record the kind (or "") in `pins` for ir_unpin_args, and put the operand in
# flight (ir_inflight_operand). 1 when it went in flight, for
# ir_inflight_pop_n.
pub fn ir_pin_arg_inflight(expr_idx: Int, reg: Int, pins: List[String], pin: Bool) -> Int:
    kind := ir_pin_operand(expr_idx, reg, pin)
    pins.push(kind)
    if ir_inflight_operand(expr_idx, reg, kind):
        return 1
    return 0

# the same pin, kept in flight until ir_unpin_inflight: the expression it
# guards can leave the function (an index miss, a `!`), and the early exit
# releases the pin with the locals. `self.conns[self.choose()]` leaked the
# pinned list on a miss.
pub fn ir_pin_inflight(expr_idx: Int, reg: Int, later_drops: Bool) -> String:
    kind := ir_pin_operand(expr_idx, reg, later_drops)
    if kind.len() > 0:
        ir_inflight_push(reg, kind)
    return kind

## unpin inflight.
pub fn ir_unpin_inflight(reg: Int, kind: String):
    if kind.len() > 0:
        ir_inflight_drop(reg)
    ir_unpin_operand(reg, kind)

# the argument expressions of a call or method node from start_idx on, in the
# order the collectors below evaluate them
pub fn ir_call_operand_exprs(node: Node, start_idx: Int) -> List[Int]:
    mut exprs: List[Int] := []
    for child, i in node.children:
        if i < start_idx:
            continue
        mut expr_idx := child
        if node_kind(child) == "arg":
            cn := get_node(child)
            if cn.children.len() == 0:
                continue
            expr_idx = cn.children[0]
        exprs.push(expr_idx)
    return exprs

# release what ir_pin_operand retained. pins is aligned with regs.
pub fn ir_unpin_args(regs: List[Int], pins: List[String]):
    for kind, i in pins:
        ir_unpin_operand(regs[i], kind)

# owned string arguments (fresh chars from s[i], concat results, fresh
# method results) die once the call they fed returns: callees borrow their
# params, and storing callees add their own count. pairs registers with the
# same child walk ir_collect_call_arg_regs used.
# method variant: pairs registers with ir_method_call_arg_expr so the pairing
# can never drift from the collector's. skip_pos marks a container-store
# argument: ownership transfers to the container there, and the store
# itself completes the transfer by taking the caller's count rather than
# adding one (see ir_owned_container_store_name).
pub fn ir_release_owned_method_args(node: Node, arg_regs: List[Int], skip_pos: Int):
    for reg, i in arg_regs:
        if i == skip_pos:
            continue
        expr_idx := ir_method_call_arg_expr(node, i)
        if expr_idx < 0:
            continue
        if not ir_arg_release_is_skipped(expr_idx):
            ir_release_owned_operand(expr_idx, reg, ir_infer_type(expr_idx))
        # a fresh optional shell handed to a method dies with the call the
        # same way it does for a plain function. `obj.take(maybe(i))` leaked
        # its shell per call. a fresh result box is released on the same terms.
        ir_release_fresh_optional_arg(expr_idx, reg)
        ir_release_fresh_result_arg(expr_idx, reg)

# true for a builtin whose result may BE one of its arguments rather than a
# value the receiver keeps a count for. `get_default` is the only one: it
# returns its fallback unchanged when the key is missing, and the map's own
# value when the key is present, adding no count on either branch.
#
# neither branch hands back a count, so the caller has to take one, and one
# retain of the result settles both. on a miss it lands on the fallback, which
# the ordinary owned-argument release then drops back to the single count the
# caller now holds; on a hit it lands on the map's value, which is the count
# that keeps a container result alive past the map entry that lent it.
# without it, `v := m.get_default(k, [])` released the map's own list at scope
# exit and the next read of that entry was a use-after-free.
#
# the order is load-bearing: retain first. on the miss branch the register the
# release drops is the very one the retain just counted, so releasing first
# would free the value in between. that is the shape that made the first
# attempt at this hand back a recycled handle.
pub fn ir_method_result_retains_over_args(emit_name: String) -> Bool:
    return emit_name == "map_get_default" or emit_name == "map_get_default_ikey" or emit_name == "map_get_default_bkey"

# true for a builtin whose receiver relinquishes its own count into the
# result: the value leaves the container and the container's count leaves
# with it, so the caller owns what it gets for every value kind. `take` is
# the only one; `remove` releases that count inside the runtime instead.
# keyed on the resolved emit name, like the retains-over-args list, so a
# same-named method on another receiver keeps its own classification.
fn ir_method_result_transfers_count(emit_name: String) -> Bool:
    return emit_name == "map_take" or emit_name == "map_take_ikey" or emit_name == "map_take_bkey"

## release owned args.
pub fn ir_release_owned_args(node: Node, start_idx: Int, arg_regs: List[Int]):
    mut reg_i := 0
    for child, i in node.children:
        if i < start_idx:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                continue
            expr_idx = cn.children[0]
        if ir_stack_closure_regs.contains(arg_regs[reg_i]):
            reg_i = reg_i + 1
            continue
        if ir_arg_release_is_skipped(expr_idx) == false:
            ir_release_owned_operand(expr_idx, arg_regs[reg_i], ir_infer_type(expr_idx))
        # a widened argument's register is a wrapper the operand release must
        # not touch (above), but the wrapper itself is a fresh shell this
        # caller built, and the fresh-optional release knows how to drop it.
        ir_release_fresh_optional_arg(expr_idx, arg_regs[reg_i])
        ir_release_fresh_result_arg(expr_idx, arg_regs[reg_i])
        reg_i = reg_i + 1

# a result box owns its payload but has no destructor, which is fine while a
# local's cleanup releases the payload with it. a box that lands in a holder
# is released by the holder's own walk, which frees the box and stranded the
# payload (#1167). such a box takes the stack cascade's body as its
# destructor: it releases the live payload and zeroes its slot, and leaves the
# box to the runtime. a cascade or a fresh argument release that runs first
# zeroes the slot as well, so the payload is released once either way. a
# value widened to an optional is a fresh shell, not the box, and is left
# alone.
pub fn ir_attach_result_box_dtor(box_r: Int, val_idx: Int):
    if val_idx < 0 or c_argument_widens_to_optional(val_idx):
        return
    tid := c_get_expr_type(val_idx)
    if tid < 0 or get_type_info(tid).kind != "result":
        return
    sig := ir_tuple_cascade_signature(tid)
    if sig == "00":
        return
    if not ir_tuple_stack_cascade_sigs.contains(sig):
        ir_tuple_stack_cascade_sigs.push(sig)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " " + ir_tuple_stack_cascade_helper_name(sig))
    ir_emit_call2(ir_reg(), "pith_struct_set_dtor", "void", box_r, fr)

# a read of a `weak` field or a `weak` local synthesizes a FRESH borrowing
# optional shell each time (ir_emit_weak_read), unlike a normal optional,
# which reads the stored value in place. that shell has no destructor and
# holds a borrowed pointer, so releasing it just frees the shell. this
# predicate lets the optional consumers (`.value()`, `!= none`, `?`, and an
# `if let` / `while let` subject) free the throwaway shell instead of
# leaking one per read.
pub fn ir_node_is_weak_field_read(idx: Int) -> Bool:
    node := get_node(idx)
    # parentheses change nothing about the read: `(h.w).value()` mints the
    # same shell, and its consumer must free it the same way
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_node_is_weak_field_read(node.children[0])
    # a weak LOCAL read, or a read of a weak binding captured into the
    # emitting lambda, mints the same throwaway shell as a weak field read
    # (see ir_emit_ident_load); a loop variable shadowing the name reads its
    # own slot plainly and must not have a shell freed out from under it.
    if node.kind == "ident":
        return ir_name_is_weak_read(node.value)
    if node.kind != "field_access":
        return false
    if node.children.len() == 0:
        return false
    recv_tid := c_get_expr_type(node.children[0])
    if recv_tid < 0:
        return false
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "struct":
        return false
    return ir_struct_field_is_weak(recv_info.name, node_value(idx))

# free the shell of an optional operand a comparison is the sole owner of.
# `xs.index_of(v) != none` mints one shell to answer one flag read and nothing
# else ever names it, so without this every search-against-none stranded it,
# on any list and any element type, since no optional has to be involved for
# the search to build one. the same holds for every other fresh optional in
# comparison position; a borrowed operand answers false here and is released
# by whoever owns it. what the shell owns through its destructor goes with it,
# exactly as it does at an if-let merge.
pub fn ir_release_owned_optional_operand(operand_idx: Int, shell_r: Int):
    if ir_optional_subject_is_owned(operand_idx):
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", shell_r)

# whether `?` on the optional at idx releases its shell once the payload is
# out: a fresh one nothing else names (ir_optional_subject_is_owned). a weak
# read has its own release above.
pub fn ir_unwrap_frees_shell(idx: Int) -> Bool:
    return ir_optional_subject_is_owned(idx) and not ir_node_is_weak_field_read(idx)

# true only for s[i] with a string receiver: that lowers to char_at,
# which always mints a fresh one-char string. everything else keeps the
# general borrowed-by-default classification.
pub fn ir_expr_is_fresh_string_index(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "index" or node.children.len() == 0:
        return false
    # replicate ir_emit_index_expr's dispatch exactly: checked type first,
    # inference as fallback (ir_infer_type asks the checker first).
    return ir_infer_type(node.children[0]) == "string"

# an owned operand (a fresh char from s[i], a concat result, a fresh
# method result, an owned container argument) dies once the operation that
# consumed it emits. this is the loop-condition reclaim: `while s[i] == ":"` builds a fresh
# char every iteration, and the release lands in the same block as the
# compare, so dominance is never in question.
# the kind ir_release_owned_operand releases the operand at expr_idx under
# when the value operator is done with it, or "" when it releases nothing
pub fn ir_owned_operand_kind(expr_idx: Int, expr_type: String) -> String:
    if (expr_type == "string" or expr_type == "bytes") and not ir_expr_is_borrowed(expr_idx):
        return expr_type
    if ir_expr_is_fresh_string_index(expr_idx) or ir_expr_is_transferred_call_temp(expr_idx):
        return "string"
    kind := ir_rc_kind(expr_type)
    if ir_owned_arg_kind_releases(kind) and not ir_expr_is_borrowed(expr_idx):
        return kind
    return ""

# put the operand just emitted for a call in flight while the operands after
# it are built, so a `!` among them that leaves the function releases it with
# the locals: its own count when it is owned, or the pin's (`pin_kind`). the
# answer is whether it went in, for ir_inflight_pop_n.
# `token.sign(key()!)` leaked the receiver when key() failed.
pub fn ir_inflight_operand(expr_idx: Int, r: Int, pin_kind: String) -> Bool:
    mut kind := pin_kind
    if kind.len() == 0:
        kind = ir_owned_operand_kind(expr_idx, ir_infer_type(expr_idx))
    if kind.len() == 0:
        return false
    ir_inflight_push(r, kind)
    return true

# a struct field's value holds a count once it is built (its own, or the
# retain a borrowed one took), so it is in flight until the struct is
# allocated: `Keys(derive(a)!, derive(b)!)` leaked the first key when the
# second failed. an optional field is left out, as in the operand release.
# the answer is 1 when it went in.
pub fn ir_inflight_field_value(r: Int, kind: String) -> Int:
    if kind.len() == 0 or kind == "tuple":
        return 0
    ir_inflight_push(r, kind)
    return 1

## inflight pop n.
pub fn ir_inflight_pop_n(n: Int):
    mut left := n
    while left > 0:
        ir_inflight_pop()
        left = left - 1

## release owned operand.
pub fn ir_release_owned_operand(expr_idx: Int, reg: Int, expr_type: String):
    if expr_type == "string" and not ir_expr_is_borrowed(expr_idx):
        ir_string_release_reg(reg)
    elif expr_type == "bytes" and not ir_expr_is_borrowed(expr_idx):
        ir_rc_release_reg(reg, "bytes")
    elif ir_expr_is_fresh_string_index(expr_idx):
        # loop-condition reclaim: `while s[i] == ":"` mints a fresh char
        # per iteration; it dies with the compare, in the same block
        ir_string_release_reg(reg)
    elif ir_expr_is_transferred_call_temp(expr_idx):
        # a call result in comparison position is a transferred count
        # nothing else references: `c == chr(9)` leaked one string per
        # iteration. user returns transfer, and runtime string builders
        # (chr, conversions) mint fresh buffers.
        ir_string_release_reg(reg)
    else:
        # an owned struct/closure/collection argument dies when the call it
        # fed returns, exactly like an owned string (docs/ownership.md): the
        # callee borrowed it and a storing callee took its own count, so the
        # caller releases the count it still holds. a borrowed arg (a
        # variable/field/element the caller keeps) is not released; a fresh
        # literal (a list, a map, a struct init, a lambda) or a transferred
        # result is.
        arg_node := get_node(expr_idx)
        mut arg_kind := ir_rc_kind(expr_type)
        # a fn type has no rc kind of its own, but the value in the register
        # is a closure handle either way: a lambda literal, or a named
        # function the ident load wrapped into one.
        if arg_kind.len() == 0 and (arg_node.kind == "lambda" or ir_expr_is_named_function_value(expr_idx)):
            arg_kind = "closure"
        # "tuple" stays off the general release list: an optional and a
        # result lower to the same shell, so the rc KIND cannot tell a real
        # tuple from a wrapper whose count an extraction still hands on. the
        # one unambiguous case is a SYNTACTIC tuple literal, judged by the
        # AST node kind (not the rc kind, which is also spelled "tuple"):
        # the node is `(a, b)` in the source, the register is a box only
        # this call ever saw, and a storing callee took its own count, so
        # `f((a, b))` no longer strands one box per call. any other
        # tuple-typed register keeps the old bounded leak rather than
        # risking a double free.
        is_tuple_literal := arg_kind == "tuple" and arg_node.kind == "tuple"
        if (ir_owned_arg_kind_releases(arg_kind) or is_tuple_literal) and not ir_expr_is_borrowed(expr_idx):
            ir_rc_release_reg(reg, arg_kind)

# the rc kinds an owned call argument hands back once the call returns.
#
# containers belong here for the same reason structs and closures do: a
# `[1, 2]`, a `{"k": v}` or an `xs.map(f)` written straight into a call is an
# allocation nothing else names, and a callee that keeps it adds a count of its
# own: a parameter is a borrow, so a store retains and a returned parameter is
# retained on the way out. leaving the container kinds off this list is what
# made every such call strand its handle for the life of the process, about 165
# bytes per list argument and 400 per map.
#
# "tuple" is deliberately absent and has to stay off. an optional and a result
# both lower to a tuple shell, so the kind does not say whether the register
# holds a real tuple literal or a wrapper whose ownership the result and
# optional extraction paths settle instead; ir_emit_struct_positional_init
# excludes tuple from its field retain for the same reason. releasing one here
# would drop a count those paths still hand on. the syntactic tuple-literal
# case is handled by the caller, ir_release_owned_operand, which can
# see the AST node where this kind list cannot.
#
# "string" and "bytes" never reach here: the branches above claim them first,
# because a fresh string has shapes (an s[i] char, a concat) that no rc kind
# describes.
fn ir_owned_arg_kind_releases(arg_kind: String) -> Bool:
    if arg_kind == "struct" or arg_kind == "closure" or arg_kind == "channel" or arg_kind == "sync":
        return true
    return arg_kind == "list" or arg_kind == "map" or arg_kind == "set"

# a fresh optional written straight into a call argument dies with the call
# it fed. three shapes produce one: a call returning an optional
# (`take(mk(i))`), a bare `none`, and a plain value the checker widened into
# a `T?` parameter (`take(3)`, `take(point)`). the general release above must
# keep "tuple" excluded because the rc kind alone cannot tell a wrapper from a
# tuple literal, but each of these three is judged by its node and the
# checker's record, and each is a shell nothing but this call ever saw.
#
# the release is the plain shell release, and it does not read the callee's
# body. an optional parameter is a borrow of the shell: everything a callee
# can do to keep it or its payload takes a count of its own. a struct
# construction, a field assignment, a container store and a channel send
# retain the shell, a lambda capture and a returned parameter retain it on
# the way out, a bind retains it, and `unwrap_or`, `.value()`, `if let` and
# `match` retain the payload they hand out. so once the call returns this
# frame's count is the only one it has to drop, and dropping it is right
# whatever the callee did: a shell the callee kept survives on the callee's
# count, and a shell nobody kept dies here, taking with it whatever it owns
# through its destructor (a wrap-built Some, a widened value, a transferring
# runtime getter's shell). a shell that borrows its payload (a `xs.get(i)`
# forwarded out of a callee) owns nothing and frees only its box.
#
# this used to walk the callee's body and, when the walk proved the caller
# stayed the shell's sole owner, release through the cascade helper, which
# drops the payload explicitly and nulls the slot before freeing the shell.
# the walk left every callee it could not read on the leak side (one in
# another module, a method on a generic receiver, a closure), and the cascade
# was wrong in two places the walk could not see: a callee that returned its
# parameter retained the shell and handed it back, so `show(forward(v))`
# nulled the payload `v` still owned, and a shell produced by a borrowing
# getter (`show(xs.get(0))`) had the container's own element count dropped
# out from under it. the plain release has neither problem, because it never
# touches the payload directly.
fn ir_release_fresh_optional_arg(expr_idx: Int, reg: Int):
    if not ir_expr_is_fresh_optional_shell(expr_idx) and not ir_expr_is_fresh_tuple(expr_idx):
        return
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", reg)

# a tuple a call returns (`show(pair(i))`) is fresh on the same terms as an
# optional shell: the callee's parameter borrows it and every way to keep it
# takes a count, so this frame's count is the last one to drop. the release
# goes through the tuple's destructor, which drops its members. without it,
# each such call stranded the tuple.
fn ir_expr_is_fresh_tuple(expr_idx: Int) -> Bool:
    if expr_idx < 0:
        return false
    en := get_node(expr_idx)
    if en.kind != "call" and en.kind != "method_call" and en.kind != "await":
        return false
    if ir_value_extraction_is_uncounted(expr_idx):
        return false
    tid := c_get_expr_type(expr_idx)
    return tid >= 0 and get_type_info(tid).kind == "tuple"

# a fresh result box written straight into a call argument (`take(r())`
# against `fn take(x: Int!)`) dies with the call it fed on the same terms as
# the optional above: a result parameter is a borrow of the box, and every way
# a callee can keep it or take its payload takes a count of its own. a struct
# construction, a field assignment, a container store, a lambda capture, a
# bind and a returned parameter retain the box (a channel cannot carry a
# result, so a send is not a spelling); `!` hands
# out a borrow the escape site retains, `catch` and `unwrap_or` retain the
# payload they hand out (a string payload stays a borrow that the escape site
# retains), a `.ok`/`.err` read is a borrow, and a match binding on a result
# is an uncounted alias of the box whose escape retains the box. so once the
# call returns the caller's count is the only one it has to drop, whatever the
# callee is, and no callee body is read.
#
# what differs from the optional is that a result box carries no destructor
# (see ir_emit_result_tuple and the take-ok convention in ir_emit_try_expr):
# its payload count is owned by the box and dropped by whoever frees the box.
# a plain shell release would therefore reclaim the three slots and strand a
# heap payload the callee only read, while the cascade helper (which drops
# the payload unconditionally and nulls the slot) would empty a box the
# callee kept (`store(h, r())`, `show(forward(r()))`), the wrong answer the
# optional release already had to give up. so an rc-payload signature goes
# through ir_emit_result_arg_release_helpers: the helper drops the live
# payload only when this frame's count is the box's last, and releases the
# box either way. a scalar signature has nothing to drop and takes the plain
# release. the count read is exact in the one direction that matters: a
# caller holding one count that reads 1 is the sole owner, and nothing can
# retain a box it has no reference to; a stale reading above 1 (another
# thread releasing a kept box concurrently) falls back to the plain release
# and leaves the payload with the box, which is the pre-existing bounded leak
# of a kept destructor-less result, never a dangling pointer.
pub fn ir_release_fresh_result_arg(expr_idx: Int, reg: Int):
    if not ir_expr_is_fresh_result_box(expr_idx):
        return
    ir_emit_result_box_release(reg, c_get_expr_type(expr_idx))

# drop this frame's count on a result box, taking its payload with it only
# when the count is the box's last. both places a frame holds a box it did not
# bind (the argument release above and the statement-position discard) ask
# the same question and cannot answer it from the callee's body, so they share
# the emission: a signature with a heap slot goes through the per-signature
# helper that reads the strong count, and an all-scalar signature has nothing
# to drop and takes the plain shell release.
# drop the payload of a result that arrived as a (flag, payload) pair: the ok
# value when the flag is set, the error otherwise
pub fn ir_emit_pair_payload_release(flag_r: Int, val_r: Int, tid: Int):
    ok_kind := ir_rc_kind(ir_result_field_kind(tid, "ok"))
    err_kind := ir_rc_kind(ir_result_field_kind(tid, "err"))
    if ok_kind.len() == 0 and err_kind.len() == 0:
        return
    ok_l := ir_label()
    err_l := ir_label()
    done_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    if ok_kind.len() > 0:
        ir_rc_release_reg(val_r, ok_kind)
    ir_emit("jmp " + done_l)
    ir_emit_label(err_l)
    if err_kind.len() > 0:
        ir_rc_release_reg(val_r, err_kind)
    ir_emit("jmp " + done_l)
    ir_emit_label(done_l)

## emit result box release.
pub fn ir_emit_result_box_release(reg: Int, tid: Int):
    sig := ir_tuple_cascade_signature(tid)
    if sig == "00":
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", reg)
        return
    if not ir_result_arg_release_sigs.contains(sig):
        ir_result_arg_release_sigs.push(sig)
    ir_emit_call1(ir_reg(), ir_result_arg_release_helper_name(sig), "void", reg)

# true when an expression's register is a result box nothing but this frame
# names: a call, method call or await whose checked type is a result. the
# callee (or task) transferred its one count on the box with the return, the
# same shape ir_extraction_operand_class reads as owned. a `.value()` the
# emitter could not count hands back an inner box it took no count on and
# stays out, exactly as it does for the optional predicate.
fn ir_expr_is_fresh_result_box(expr_idx: Int) -> Bool:
    if expr_idx < 0:
        return false
    en := get_node(expr_idx)
    if en.kind != "call" and en.kind != "method_call" and en.kind != "await":
        return false
    if ir_value_extraction_is_uncounted(expr_idx):
        return false
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return false
    return get_type_info(tid).kind == "result"

# --- the four "is this a fresh temporary?" predicates -----------------------
#
# ir_expr_is_transferred_call_temp, ir_field_receiver_is_owned_temp,
# ir_extraction_operand_class and ir_optional_subject_is_owned all ask some
# version of "did this expression just produce the value, so whoever consumes
# it here is its only owner?", and they all answer it by looking at the node
# kind. they are deliberately four functions, not one: each serves a different
# consumer, and they differ on axes that are not accidental.
#
#   which node kinds count as a producer. a call and a method call count for
#   all four. `await` counts for the two shell classifiers (an awaited task
#   hands its count to the single awaiter) and not for the two payload ones,
#   which ask about a string or a struct header rather than a shell.
#   `struct_init` counts only for the field receiver, which is the one
#   consumer that can be handed a construction directly.
#
#   what they consult. three of them consult a type (an inferred string, an
#   rc kind, a checked tid) and answer the same inside a generic body as in a
#   concrete one, since the body is typed before it is emitted.
#   ir_extraction_operand_class is purely syntactic and reads the node kind
#   and nothing else.
#
#   whether `.value()` is excluded. the three that can end up releasing their
#   receiver exclude it, because `opt.value()` spells like a call and is a
#   field read that hands back an uncounted view. the extraction class is the
#   one that does not: it classifies the operand of `!`, `catch` and the
#   result-flavoured `unwrap_or`, and a result operand is never spelled
#   `.value()` in the first place.
#
#   which rc kinds are in scope. the transferred-call test is strings only,
#   the field receiver is struct-header kinds only, and the two shell
#   classifiers are about the shell rather than its payload.
#
# so: read them together, keep them consistent where they agree, and do not
# merge them. a single predicate would have to carry all four filter sets, and
# every consumer would then be asking a question slightly wider or narrower
# than the one it means.

# true for call and method-call results whose checked or inferred type is
# string. one of the four fresh-temporary predicates; see the block above.
# these predicates used to answer false inside a generic body, where the
# checked types were the error type and a wrong answer freed a register that
# was not what it seemed; a specialization is type-checked against its
# concrete types before it is emitted now, so the answer is the concrete
# body's.
fn ir_expr_is_transferred_call_temp(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "call" and node.kind != "method_call":
        return false
    # a `.value()` the emitter could not count spells like a call and is a
    # field read: it hands back an uncounted view of the shell's payload (see
    # ir_value_extraction_is_uncounted). counting it as a transfer released a
    # string the shell still owns: `xs[0].value() == "a"` freed the element's
    # string mid-comparison. a counted extraction is a transfer like any
    # other, and reaches the borrowed-classification branch above this one.
    if ir_value_extraction_is_uncounted(idx):
        return false
    # a call the borrow classifier calls borrowed hands back a value its
    # owner still holds, such as `s.to_string()` on a String, which is `s`
    # itself. releasing it freed the caller's string.
    if ir_expr_is_borrowed(idx):
        return false
    expr_type := ir_infer_type(idx)
    return expr_type == "string"

# `s[i] == ":"` compares one byte against one byte: read both sides as
# integers and skip the two string allocations plus their rc traffic.
# at least one side must be an index: the scanner-loop shape this
# exists for.
pub fn ir_is_byte_operand(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "index" and node.children.len() >= 2:
        return ir_expr_is_fresh_string_index(idx)
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return ir_string_lit_single_byte(node.value) >= 0
    if node.kind == "call" and node.children.len() >= 2:
        callee := get_node(node.children[0])
        arg := get_node(node.children[1])
        return callee.kind == "ident" and callee.value == "chr" and arg.kind == "int_lit"
    return false

# map, filter and reduce open-code their loop instead of going through the
# general method call, so the release that ordinarily reclaims an owned
# argument never runs for the function they were handed. an owned one (a
# lambda literal, a named function, a call that built a closure) is ours to
# drop once the loop is done. a borrowed one (a local or a struct field
# holding the closure) belongs to that owner and must be left alone.
fn ir_release_higher_order_fn_arg(fn_idx: Int, fn_r: Int):
    if not ir_expr_is_borrowed(fn_idx) and not ir_stack_closure_regs.contains(fn_r):
        ir_rc_release_reg(fn_r, "closure")

# the open-coded loops call their function once per element while holding
# only borrows: of the list, of each element and, for a function read out of a
# field, of the function too. a function that can drop any of them
# (`o.items.map(f)` where f replaces o.items) freed the list mid-walk. such a
# loop walks a copy of the list instead, which holds a count on every element
# for the length of the walk, and pins the function. a lambda whose body keeps
# storage (ir_subtree_keeps_storage) and a named function recorded as a
# storage keeper cannot drop anything, and their loops stay as they were.
pub fn ir_higher_order_fn_may_drop(fn_idx: Int) -> Bool:
    fn_node := get_node(fn_idx)
    if fn_node.kind == "lambda":
        parts := ir_collect_lambda_parts(fn_idx)
        return parts.body_idx < 0 or not ir_subtree_keeps_storage(parts.body_idx, fn_idx, parts.body_idx)
    if fn_node.kind == "ident" and not ir_name_is_func_local(fn_node.value) and ir_expr_is_named_function_value(fn_idx):
        return not ir_is_storage_keeper(ir_resolve_static_callee(fn_idx).name)
    return true

# the list an open-coded loop walks: the list itself, or a copy when the
# function may drop it (above). a list nothing else holds (`xs.map(f)` as the
# receiver of `.filter(g)`) can't be dropped by anyone, so it is walked as it
# is and released once the walk is done (ir_higher_order_walk_done).
pub fn ir_higher_order_walk_list(list_idx: Int, list_r: Int, may_drop: Bool) -> Int:
    if not ir_higher_order_walks_copy(list_idx, may_drop):
        return list_r
    len_r := ir_reg()
    ir_emit_call1(len_r, "pith_list_len", "int", list_r)
    copy_r := ir_reg()
    ir_emit_call3(copy_r, "list_slice_copy", "list", list_r, ir_zero_reg(), len_r)
    return copy_r

fn ir_higher_order_walks_copy(list_idx: Int, may_drop: Bool) -> Bool:
    return may_drop and ir_expr_is_borrowed(list_idx)

# release the walked copy or the owned list, the function argument's pin and
# the function argument itself once the loop is done. the owned list was
# never released, so `xs.map(f).filter(g)` leaked the mapped list.
pub fn ir_higher_order_walk_done(list_idx: Int, walk_r: Int, may_drop: Bool, fn_idx: Int, fn_r: Int, fn_pin: String):
    if ir_higher_order_walks_copy(list_idx, may_drop):
        ir_rc_release_reg(walk_r, "list")
    else:
        ir_release_owned_operand(list_idx, walk_r, ir_infer_type(list_idx))
    ir_unpin_operand(fn_r, fn_pin)
    ir_release_higher_order_fn_arg(fn_idx, fn_r)

# what each argument in a closure position is known to be, for a call to a
# generic function: "<pos>:lambda:<symbol>" for a lambda literal,
# "<pos>:fn:<symbol>" for a named function, and a parameter already bound in
# this specialization passes its binding on. empty when nothing is known.
pub fn ir_fn_arg_bindings(node: Node, positions: List[Int], arg_regs: List[Int]) -> String:
    mut parts: List[String] := []
    for pos in positions:
        if pos + 1 >= node.children.len() or pos >= arg_regs.len():
            continue
        expr_idx := ir_call_arg_expr_index(node.children[pos + 1])
        en := get_node(expr_idx)
        mut bound := ""
        if en.kind == "lambda" and ir_fn_arg_lambda_symbols.contains_key(arg_regs[pos]):
            bound = "lambda:" + ir_fn_arg_lambda_symbols[arg_regs[pos]]
        elif en.kind == "ident" and ir_active_fn_bindings.contains_key(en.value) and ir_name_is_func_local(en.value):
            bound = ir_active_fn_bindings[en.value]
        elif en.kind == "ident" and not ir_name_is_func_local(en.value) and ir_expr_is_named_function_value(expr_idx):
            target := ir_resolve_static_callee(expr_idx).name
            if target.len() > 0 and not ir_is_generic_function_name(target) and not ir_call_returns_pair(target) and not ir_callee_uses_result_abi(ResolvedCallee(target, false), expr_idx):
                bound = "fn:" + target
        if bound.len() > 0:
            parts.push(pos.to_string() + ":" + bound)
    return parts.join(",")

# a copy of the specialization spec_name whose closure parameters call the
# functions `bindings` names directly (ir_bind_fn_specialization's format).
# the closure value is still passed, so nothing but the calls changes.
pub fn ir_bind_fn_specialization(spec_name: String, bindings: String) -> String:
    if bindings.len() == 0 or not ir_generic_specialization_by_symbol.contains_key(spec_name):
        return spec_name
    key := ir_generic_specialization_by_symbol[spec_name]
    bound_key := key + chr(9) + "fnb" + chr(9) + bindings
    if ir_generic_specialization_names.contains_key(bound_key):
        return ir_generic_specialization_names[bound_key]
    bound_name := spec_name + "__fb" + ir_generic_spec_fn_bindings.len().to_string()
    ir_generic_specialization_by_symbol.insert(bound_name, bound_key)
    ir_generic_specialization_keys = ir_push_string(ir_generic_specialization_keys, bound_key)
    ir_generic_specialization_names.insert(bound_key, bound_name)
    ir_generic_specialization_type_lists.insert(bound_key, ir_generic_specialization_type_lists[key])
    if ir_generic_specialization_subst_tids.contains_key(key):
        ir_generic_specialization_subst_tids.insert(bound_key, ir_generic_specialization_subst_tids[key])
    if ir_func_returns.contains_key(spec_name):
        ir_func_returns.insert(bound_name, ir_func_returns[spec_name])
    ir_generic_spec_fn_bindings.insert(bound_key, bindings)
    return bound_name

# the bindings of a keyed specialization, by the parameter names of its
# declaration
pub fn ir_fn_bindings_by_param(key: String, decl_idx: Int) -> Map[String, String]:
    mut out: Map[String, String] := {}
    if not ir_generic_spec_fn_bindings.contains_key(key):
        return out
    mut names: List[String] := []
    for child in get_node(decl_idx).children:
        cn := get_node(child)
        if cn.kind == "param":
            names.push(cn.value)
    for part in ir_generic_spec_fn_bindings[key].split(","):
        colon := part.index_of(":")
        pos := parse_int(part.substring(0, colon)) catch -1
        if pos >= 0 and pos < names.len():
            out.insert(names[pos], part.substring(colon + 1, part.len()))
    return out

# true when an expression's register is an optional shell nothing but this
# frame names: a bare `none`, a plain value the checker widened into the
# target's optional type, or a call, method call or await whose checked type
# is an optional. ir_emit_call_arg builds the first two, so the caller is
# trivially the shell's only owner; the third arrives from a callee (or a
# task) that transferred its one count on the shell with the return, the
# same shape ir_optional_subject_is_owned reads. the consumers act on that in
# the ways available to them: a call argument and a search read the shell
# and keep nothing, so they release it once the call or scan is done rather
# than stranding it once per call; a container store takes the caller's
# count instead of adding one. a bare `none` written straight into a store
# (`xs.push(none)`, `m[k] = none`) otherwise stranded its shell, because a
# none literal falls through to the borrowed classification and sent the
# store down the retaining path.
#
# what the shell holds is not this predicate's concern. a wrap-built or
# widened shell owns its payload through its destructor and a borrowing
# getter's shell owns nothing, so a plain shell release is the whole of it
# either way (see ir_release_fresh_optional_arg). a `.value()` the emitter
# could not count has no checked type and stays out.
pub fn ir_expr_is_fresh_optional_shell(expr_idx: Int) -> Bool:
    if expr_idx < 0:
        return false
    if c_argument_widens_to_optional(expr_idx):
        return true
    en := get_node(expr_idx)
    if en.kind == "none_lit":
        return true
    # a weak read builds its shell right here too, and the shell owns the
    # count the upgrade took (ir_emit_weak_read)
    if ir_node_is_weak_field_read(expr_idx):
        return true
    if en.kind != "call" and en.kind != "method_call" and en.kind != "await":
        return false
    if ir_value_extraction_is_uncounted(expr_idx):
        return false
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return false
    return get_type_info(tid).kind == "optional"

# a field read off an owned temporary (`make_pt(i).x`, `p.unwrap_or(Pt(0, "z")).x`)
# used to strand the temporary: the method-call path releases an owned
# receiver once the call returns, but the field path never did, and every
# struct built only to have one field read leaked whole. now the field value
# takes its own count first when it has a kind (so it outlives the receiver),
# then the receiver's count is dropped. ir_expr_is_borrowed classifies such a
# read as owned to match, so a bind transfers the count, an argument position
# releases it after the call, and a comparison drops it. a field whose kind
# the emitter cannot name on an rc-bearing receiver keeps the old leak rather
# than risk freeing what the field still points at.
pub fn ir_release_owned_field_receiver(recv_idx: Int, obj_r: Int, field_r: Int, field_kind: String):
    if not ir_field_receiver_is_owned_temp(recv_idx):
        return
    recv_kind := ir_rc_kind(ir_infer_type(recv_idx))
    if field_kind.len() > 0:
        ir_rc_retain_reg(field_r, field_kind)
    ir_rc_release_reg(obj_r, recv_kind)

# true for a `.value()` whose extraction the emitter could not count. a
# provable optional receiver routes through the value arm of
# ir_emit_typed_receiver_method, which hands the payload out with a count of
# its own (ir_extraction_retains), so those are ordinary owned temporaries and
# an owned-receiver release balances the count the extract took. where the
# receiver's type is unprovable that arm never fires, no retain is emitted, and
# the value is still the uncounted view it always was: releasing it would drop
# a count the read never took, which is what dropped a weak referent's count
# and took test_weak_read_loop from 7000 to 7. refuse there: a refusal can
# only leak, never dangle.
fn ir_value_extraction_is_uncounted(recv_idx: Int) -> Bool:
    recv := get_node(recv_idx)
    if recv.kind != "method_call" or recv.children.len() == 0:
        return false
    if ir_plain_method_name(recv.value) != "value":
        return false
    return c_get_expr_type(recv.children[0]) < 0

# the node kinds that can produce an owned struct for a field read to consume.
# the rest of the test is ir_expr_is_borrowed's answer and the rc kind.
fn ir_field_receiver_kind_can_own(kind: String) -> Bool:
    if kind == "call" or kind == "method_call" or kind == "struct_init":
        return true
    if kind == "match_expr" or kind == "if_expr":
        return true
    if kind == "catch_expr" or kind == "catch_block" or kind == "field_access":
        return true
    # an element read off a temporary container arrives owned
    # (ir_index_reads_owned_element), so `make().items[0].name` releases the
    # element once its field is read. a plain `xs[i]` is a borrow and stays out
    # through the ownership check that follows.
    if kind == "index":
        return true
    return kind == "try" or kind == "try_expr"

# true when a field access's receiver is a fresh value nothing else names: a
# call or method result, a struct construction, or an unwrap that built its
# answer: anything ir_expr_is_borrowed says is owned, of a struct or tuple
# kind.
#
# parens are transparent. a catch, a try (`f()!`) and a field read that is
# itself off an owned temporary (`outer().inner`) all hand back a value with a
# count of its own (see ir_expr_is_borrowed), so a field read off one of them
# has to drop that count the same way.
pub fn ir_field_receiver_is_owned_temp(recv_idx: Int) -> Bool:
    recv := get_node(recv_idx)
    if recv.kind == "grouped" and recv.children.len() > 0:
        return ir_field_receiver_is_owned_temp(recv.children[0])
    if not ir_field_receiver_kind_can_own(recv.kind):
        return false
    if ir_value_extraction_is_uncounted(recv_idx):
        return false
    if ir_expr_is_borrowed(recv_idx):
        return false
    recv_kind := ir_rc_kind(ir_infer_type(recv_idx))
    return recv_kind == "struct" or recv_kind == "tuple"

# result locals whose box can be a stack slot of the frame instead of a heap
# block: `r := f(...)` where f returns its result in registers, so the box is
# built right here, and the local
#
#   - may cascade its payload at cleanup (ir_tuple_cascade_names), which
#     already means every use only reads the box or borrows it
#   - is bound once, from a call, and never assigned, so its slot is never
#     rebuilt over a value still waiting for release
#   - is not bound inside a loop, where one slot would be rebuilt every pass
fn ir_stack_tuple_binds(body_idx: Int) -> List[String]:
    mut names: List[String] := []
    if body_idx < 0:
        return names
    for name in ir_tuple_cascade_names:
        if ir_count_call_binds(body_idx, name, false) == 1 and not ir_subtree_assigns_name(body_idx, name):
            names.push(name)
    return names

# the binds of `name` in this body: 1 for each call-valued bind outside any
# loop, and 2 for any other (in a loop, or from something else), so a single
# qualifying bind is exactly a count of one
fn ir_count_call_binds(idx: Int, name: String, inside_loop: Bool) -> Int:
    node := get_node(idx)
    if node.kind == "lambda" or node.kind == "spawn":
        return 0
    in_loop := inside_loop or node.kind == "while_stmt" or node.kind == "while_let" or node.kind == "for_stmt"
    mut n := 0
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if parts.name == name:
            if not in_loop and parts.val_idx >= 0 and (node_kind(parts.val_idx) == "call" or node_kind(parts.val_idx) == "method_call"):
                n = 1
            else:
                n = 2
    for child in node.children:
        n = n + ir_count_call_binds(child, name, in_loop)
    return n

# a slot read off a result box nothing else names (`f().ok`, `f().is_ok`)
# used to strand the box and whatever the other slot held. the slot value
# takes its own count first, so it outlives the box, then the box goes the way
# a discarded result does, payload and all. reading `.ok` off a fresh box is
# already classified owned (ir_field_receiver_is_owned_temp), so the count
# taken here is the one the consumer releases.
pub fn ir_release_fresh_result_receiver(recv_idx: Int, obj_r: Int, value_r: Int, fname: String):
    if not ir_expr_is_fresh_result_box(recv_idx):
        return
    recv_tid := c_get_expr_type(recv_idx)
    if fname == "ok" or fname == "err":
        value_kind := ir_rc_kind(ir_result_field_kind(recv_tid, fname))
        if value_kind.len() > 0:
            ir_rc_retain_reg(value_r, value_kind)
    ir_emit_result_box_release(obj_r, recv_tid)

# how `!`, `catch`, and `unwrap_or` should treat the shell of their result
# or optional operand:
#   "owned":     a fresh shell this extraction is the sole owner of: a call
#                or method-call result (results and optionals always arrive
#                owned from a call; user returns retain borrowed payloads on
#                the way out, runtime producers mint new tuples), or an
#                awaited task's value.
#   "borrowed":  a shell some other owner will release: a parameter or a
#                named local (an ident), a struct field, a container
#                element. the extraction must not free the shell, and must
#                not hand out the shell's payload count as if it owned it;
#                the owner releases the shell at its own scope exit, so
#                either mistake is a double-free.
#   "opaque":    anything else (a match or if expression value, ...): kept
#                on the historical owned-style treatment, which can leak a
#                shell but predates this classification.
# parens are transparent. mirrors ir_optional_subject_is_owned, which makes
# the same call-vs-borrow split for optional subjects. one of the four
# fresh-temporary predicates; see the block above
# ir_expr_is_transferred_call_temp. this is the one with no generic-body
# guard, because it is purely syntactic and consults no types.
pub fn ir_extraction_operand_class(idx: Int) -> String:
    node := get_node(idx)
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_extraction_operand_class(node.children[0])
    if node.kind == "call" or node.kind == "method_call" or node.kind == "await":
        return "owned"
    if node.kind == "ident" or node.kind == "field_access" or node.kind == "index":
        return "borrowed"
    return "opaque"

## string interp part owned.
pub fn ir_string_interp_part_owned(child: Int) -> Bool:
    cn := get_node(child)
    if cn.kind == "interp_spec":
        # spec parts allocate fresh output in every shape
        return true
    if cn.kind == "lit":
        # literal strrefs are static; releasing one is a no-op, so treating
        # them as owned keeps the fold logic uniform
        return true
    # a string-typed expression part passes through as a borrow; any other
    # part type goes through a to-string conversion and arrives fresh
    return ir_infer_type(child) != "string" or not ir_expr_is_borrowed(child)

# a global could be reassigned by the callee while a borrowing closure holds
# its old value, so only this frame's own names qualify.
pub fn ir_captures_are_frame_locals(captures: List[String]) -> Bool:
    for cap in captures:
        if not ir_name_is_func_local(cap):
            return false
    return true

## captures uncounted.
pub fn ir_captures_uncounted(captures: List[String]) -> Bool:
    for cap in captures:
        if ir_rc_kind(ir_lookup_name_type(cap)).len() > 0:
            return false
    return true

# true when the expression names a function instead of reading a value.
# there are two spellings, and both mint a closure: a bare `shout`
# (ir_emit_ident_load) and a module member `hash.sha256_bytes`
# (ir_emit_field_access_expr). the conditions below mirror those two emit
# paths, because the ownership answer has to agree with what was emitted:
# if this says "owned" where no closure was allocated, the caller releases
# a count nobody took.
fn ir_expr_is_named_function_value(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "ident":
        return ir_ident_is_function_value(idx, node.value)
    if node.kind == "field_access" and node.children.len() > 0:
        if not ir_ident_names_module(node.children[0]):
            return false
        expr_tid := c_get_expr_type(idx)
        if expr_tid < 0 or get_type_info(expr_tid).kind != "function":
            return false
        return ir_resolve_static_callee(idx).name.len() > 0
    return false

# whether any deferred statement in scope will execute at this exit edge.
pub fn ir_has_active_defers(is_error_exit: Bool) -> Bool:
    mut i := 0
    while i < ir_defer_nodes.len():
        if is_error_exit or ir_defer_is_err[i] == 0:
            return true
        i = i + 1
    return false

# true when the container an index reads is a temporary nothing else holds,
# such as a call result or a literal, so the read has to release it
pub fn ir_index_container_is_owned_temp(container_idx: Int) -> Bool:
    if ir_expr_is_borrowed(container_idx):
        return false
    kind := ir_rc_kind(ir_infer_type(container_idx))
    return kind == "list" or kind == "map" or kind == "string" or kind == "bytes"

# true when an index read hands out an element with a count of its own: the
# container is a temporary and the element is counted. a string's char is
# already fresh and needs no retain.
pub fn ir_index_reads_owned_element(idx: Int) -> Bool:
    node := get_node(idx)
    if node.children.len() == 0 or ir_expr_is_fresh_string_index(idx):
        return false
    if not ir_index_container_is_owned_temp(node.children[0]) and not ir_index_read_is_pinned(idx):
        return false
    return ir_rc_kind(ir_infer_type(idx)).len() > 0

# true when an index read pins its container around a key that could drop it
# (`o.items[shrink(o)]`, ir_emit_index_expr). the element then takes a count
# of its own before the pin goes, so it arrives owned too; called borrowed, a
# consumer that only read it left that count behind. the two checks are the
# ones the emitter makes when it pins.
fn ir_index_read_is_pinned(idx: Int) -> Bool:
    node := get_node(idx)
    if node.children.len() < 2:
        return false
    if ir_subtree_keeps_storage(node.children[1], 0 - 1, 0 - 1):
        return false
    return ir_arg_pin_kind(node.children[0]).len() > 0

# an index key computed in place (`m[a.to_string() + ":" + b.to_string()]`)
# arrives owned and nothing keeps it. a lookup reads the key and stores
# nothing, and a store copies the key bytes into the map's own storage rather
# than keeping the caller's string, so either way the count the caller holds
# has to die here. binding the key to a local first was always correct,
# because the local's scope cleanup released it; the inline form leaked one
# string per operation. the object operand is deliberately left alone:
# container indexing borrows the element out of the container, so releasing a
# temporary container here would free the value we are about to return.
pub fn ir_release_owned_index_key(key_idx: Int, key_r: Int):
    ir_release_owned_operand(key_idx, key_r, ir_infer_type(key_idx))

# a container an index store wrote through that nothing else holds a count
# for, such as `h.items()[0] = v` or `o.value()[k] = v`, is released once the
# store is done. the method-call stores drop such a receiver at the statement;
# the index store kept it, and leaked the container with everything in it.
pub fn ir_release_owned_store_receiver(recv_idx: Int, obj_r: Int):
    recv_kind := ir_rc_kind(ir_infer_type(recv_idx))
    if recv_kind.len() > 0 and not ir_expr_is_borrowed(recv_idx):
        ir_rc_release_reg(obj_r, recv_kind)

# release a result's error value when it is being discarded. the result
# tuple is a shell with no destructor, so releasing the tuple frees only
# its three slots: a heap error value (a string message, a struct error)
# would leak unless dropped here first.
pub fn ir_emit_release_result_error(result_r: Int, result_tid: Int):
    err_kind := ir_rc_kind(ir_result_field_kind(result_tid, "err"))
    if err_kind.len() > 0:
        err_r := ir_emit_result_value_field(result_r, result_tid, "err")
        ir_rc_release_reg(err_r, err_kind)

# true when emitting `fn main() -> Int!`: main settles its result locally and
# forwards an ok Int as the process exit status instead of forcing 0.
pub fn ir_main_returns_exit_code() -> Bool:
    if not ir_emitting_main_body or not ir_current_func_returns_result:
        return false
    if ir_func_result_ok_kinds.contains_key("main"):
        return ir_func_result_ok_kinds["main"] == "int"
    return false

# whether a value returned from a function declared `-> T!` is already the
# result (forward it) or its ok payload (wrap it). the ir result kind cannot
# answer alone: an optional and a tuple lower to the same "tuple" kind as a
# result, so `return maybe()` with `maybe() -> String?` in a `(String?)!`
# function read as a result and handed the caller the optional shell as the
# box, whose ok slot then held the bare payload (#1076). the checker's type
# decides whenever it names one of the three; a type parameter or an
# unrecorded expression keeps the kind test.
pub fn ir_return_forwards_result(expr_kind: String, result_kind: String) -> Bool:
    if expr_kind == "result":
        return true
    if expr_kind == "optional" or expr_kind == "tuple":
        return false
    return result_kind == "tuple"

# whether `name` is a kinded local of the emitting function at this point. a
# `for` variable shadowing it writes its own slot, so a binding of the loop
# variable's name inside that loop is not a binding of the kinded slot.
pub fn ir_name_is_kinded(name: String) -> Bool:
    if not ir_kinded_rc_binds.contains(name):
        return false
    return ir_loop_var_slot(name).len() == 0

# the kind a kinded binding site takes its count under: the site's rc kind
# when the dispatch helper can release it, "" (no count taken, none released)
# otherwise.
pub fn ir_kinded_site_kind(rc_kind: String) -> String:
    if ir_kinded_code(rc_kind) == 0:
        return ""
    return rc_kind

# true when a discarded method result register is really the receiver handed
# back: a void builtin method (`xs.reverse()`, `m.clear()`) forces its
# retkind to void and returns the receiver register so chains work (see
# ir_emit_method_call). that register carries the receiver's count, not a
# fresh one, and a discard release would strip a count its owner still
# holds. resolution mirrors ir_expr_is_borrowed's method_call branch: a
# module-qualified call and a user impl method both transfer and answer
# false; only a resolved builtin's emit name is asked.
fn ir_discard_value_is_receiver(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "method_call" or node.children.len() == 0:
        return false
    if ir_resolve_module_alias_method_call_name(idx).len() > 0:
        return false
    mname := ir_plain_method_name(node.value)
    recv_type := ir_method_receiver_type(node)
    if ir_lookup_impl_method_for(node.children[0], recv_type, mname).len() > 0:
        return false
    return ir_is_void_method(ir_method_emit_name(mname, recv_type))

# the expression that really produced a discarded statement's register. a void
# builtin method hands its receiver straight back, so `mk(i).reverse()` and
# `mk(i)` leave the same register behind and have the same one count to drop.
# walking down through the void links stops at the first expression that
# minted or was handed the value, and that is the one every ownership
# predicate here is asked about. a loop rather than one step because the walk
# reads the tree, not the checker: a second link does not type today (a void
# call's value is Void), and if that ever changes the register still comes
# from the root. each step descends to a child, so the walk terminates.
pub fn ir_discard_chain_root(idx: Int) -> Int:
    mut cur := idx
    while ir_discard_value_is_receiver(cur):
        cur = get_node(cur).children[0]
    return cur

# the statement-expression kinds whose value arrives owned when the ownership
# classification says so, and so has to be released here. a call and a method
# call transfer their result out. a `!` frees the box it opened and hands the
# payload on with the box's count, and an `await` hands over the count the
# task's thread produced. both are the transfer ir_expr_is_borrowed already
# reads them as, and both reached this discard without a release before.
# a `match` and a `select` are absent because their value is owned only when
# every arm hands one over, which ir_discarded_branch_value_is_owned asks.
pub fn ir_stmt_discards_owned_value(kind: String) -> Bool:
    if kind == "call" or kind == "method_call":
        return true
    # a catch hands back an owned value on both arms (ir_expr_is_borrowed),
    # so `compile(src) catch: return true` threw away a Template every time
    # the compile succeeded
    if kind == "catch_expr" or kind == "catch_block":
        return true
    return kind == "try" or kind == "try_expr" or kind == "await"

# whether a `match` or `select` thrown away at statement position left an
# owned value in its temp. each arm stores its value there, and where every
# arm is owned, or is retained on the way in, the temp holds a count nobody
# else will release. a form with a borrowed arm left as is stays alone, since
# releasing it would take a count its owner still holds.
pub fn ir_discarded_branch_value_is_owned(idx: Int) -> Bool:
    k := node_kind(idx)
    if k != "match_expr" and k != "select_expr":
        return false
    return not ir_expr_is_borrowed(idx)

# the rc kinds a discarded statement value is the statement's to release. the
# containers, `bytes` and a struct or tuple header were the first set; a
# closure and a channel are here on the same terms, because the only way
# either reaches a discarded statement is a call that transferred its count
# out (a returned lambda, a returned fn-value, a constructed channel), and
# nothing else names what it left behind. a string has its own release, which
# runs for statement kinds this set does not cover.
pub fn ir_kind_discards_at_statement(kind: String) -> Bool:
    if kind == "list" or kind == "map" or kind == "set":
        return true
    if kind == "bytes" or kind == "closure" or kind == "channel" or kind == "sync":
        return true
    return ir_kind_is_struct_header(kind)

# a variant pattern whose subject is an optional: the pattern applies to the
# payload (see check_let_pattern)
pub fn ir_let_unwraps_variant(pat_idx: Int, subj_idx: Int) -> Bool:
    if get_node(pat_idx).kind != "pat_variant":
        return false
    tid := c_get_expr_type(subj_idx)
    return tid >= 0 and get_type_info(tid).kind == "optional"

# true when an optional subject is a fresh shell the consumer owns and must
# release after use. a call or method-call result mints one (map.get(k), f()),
# and so does an await: the task built the shell with a count of one and
# pith_await hands that count to the single awaiter, the same transfer
# ir_expr_is_borrowed and ir_extraction_operand_class already read it as.
# borrowed subjects (a variable, field, element, self) are owned at their own
# scope and released there, so releasing here would double-free. this used to
# answer false inside a generic body, where the shape could not be trusted
# before the body was typed; with each specialization type-checked before it
# is emitted the answer is the concrete body's, and the twin comparison
# (tooling/spec_twin_diff.sh) is what showed the refusal leaking one shell per
# `if let w = f()` in a specialization. parens are transparent, as they are
# for ir_extraction_operand_class: `(await t).unwrap_or(d)` is the only way to
# spell an extraction off an await, and reading the paren node as an unknown
# shape left that shell behind. one of the four fresh-temporary predicates;
# see the block above ir_expr_is_transferred_call_temp.
pub fn ir_optional_subject_is_owned(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_optional_subject_is_owned(node.children[0])
    # tag-only enums (and scalars) are unboxed integers, never heap shells:
    # passing an unboxed enum tag to `pith_struct_release` would dereference it.
    subj_tid := c_get_expr_type(idx)
    if subj_tid >= 0 and ir_rc_kind(ir_type_from_tid(subj_tid)).len() == 0:
        return false
    kind := node.kind
    # a weak read's shell owns the count its upgrade took (ir_emit_weak_read),
    # and a catch hands out an owned value on both arms (ir_emit_catch_expr):
    # `(f() catch none).unwrap_or(d)` left that shell behind.
    if kind == "await" or kind == "catch_expr" or kind == "catch_block" or ir_node_is_weak_field_read(idx):
        return true
    # a `!` over a fresh result box (call, method_call, await) releases the
    # result box and hands out its optional payload owned; a `!` over a
    # borrowed local/field keeps the box and payload with its owner.
    if (kind == "try" or kind == "try_expr") and node.children.len() > 0:
        return ir_extraction_operand_class(node.children[0]) != "borrowed"
    if kind != "call" and kind != "method_call":
        return false
    # an uncounted `.value()` spells like a method call and is a field read:
    # on a doubly-wrapped optional it hands back the inner shell without
    # taking a count, so releasing it here would strip the count the outer
    # shell still holds: the over-release shape this predicate's siblings
    # already carve out.
    return not ir_value_extraction_is_uncounted(idx)

# whether an extraction out of the optional `subject_idx` must take its own
# count on the payload it hands out. every extraction spelling (`.value()`,
# `unwrap_or`, and an `if let` / `while let` binding) answers through here,
# so a consumer that treats a heap-kind extraction as owned never strips a
# count the subject still claims. a fresh subject's shell is freed right after the extract, so the
# payload must outlive it; a parameter, field or element subject keeps its
# count with its owner (the caller, the shell's destructor, the container);
# a widened or returned shell releases the payload through its
# `__opt_dtor_<kind>`; and a cascade-eligible local's count is released by
# its cascade.
#
# a cascade-rejected local used to be the one subject that transferred: its
# cleanup released the shell alone, so a retained count had no release. that
# ended when a returned Some took ownership of its payload. the shell's own
# release now drops what it holds, so the retain balances there too, and the
# transfer's two failure modes went with it (the double-extraction
# unsoundness, and a rebind reading a Some-flagged shell whose payload the
# transfer had walked off with). the residue is a shell a runtime call built
# around a transferred count with no destructor bound to a rejected name:
# its inner count now leaks: bounded, and in the safe direction.
pub fn ir_extraction_retains(subject_idx: Int, inner_kind: String, owns_subject: Bool) -> Bool:
    return inner_kind.len() > 0

# whether an owned `if let` subject can be released as soon as the binding
# takes its count. a tuple payload (an inner optional shell) is an uncounted
# view whose count stays with the subject, so that subject must live until
# the merge.
pub fn ir_let_subject_releases_early(subj_idx: Int) -> Bool:
    tid := c_get_expr_type(subj_idx)
    if tid < 0 or get_type_info(tid).kind != "optional":
        return false
    inner_tid := get_type_info(tid).inner
    if inner_tid < 0:
        return false
    return ir_rc_kind(ir_type_from_tid(inner_tid)) != "tuple"

# `for x in list` and other index-addressable iterables (the fallback when the
# element is neither a range nor an iterator-protocol struct). Converts to a
# fresh container when the type needs it, then runs a counted loop over the
# length using get-by-index. an owned iterable is released when the loop ends,
# or at the function's exit edges if the body returns / fails early.
# whether a loop over a borrowed iterable must hold its own count. a local
# that the body never assigns keeps its count for the whole loop, so the
# loop can skip the atomic retain and release. a field, a global, a loop
# variable (its list can be replaced) or any other expression keeps the
# count, since the body can drop it through another path.
pub fn ir_for_iterable_needs_count(node: Node) -> Bool:
    iter_node := get_node(node.children[0])
    if iter_node.kind != "ident":
        return true
    name := iter_node.value
    if not ir_name_is_func_local(name) or ir_loop_var_slot(name).len() > 0:
        return true
    return ir_subtree_assigns_name(node.children[1], name)

# release the count a loop variable's slot holds; a null slot (before the
# first iteration, or after the step label cleared it) releases as a no-op.
pub fn ir_emit_for_value_release(value_slot: String, kind: String):
    held_r := ir_reg()
    ir_emit("load " + held_r.to_string() + " " + value_slot)
    ir_rc_release_reg(held_r, kind)
