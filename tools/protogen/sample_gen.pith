    # client-streaming rpc Assemble.
    pub fn Assemble() -> GeometryAssembleCall!grpc.GrpcError:
        inner := self.conn.client_stream("/sample.Geometry/Assemble")!
        return GeometryAssembleCall(inner: inner)
    # bidirectional-streaming rpc Reflect.
    pub fn Reflect() -> GeometryReflectCall!grpc.GrpcError:
        inner := self.conn.bidi_stream("/sample.Geometry/Reflect")!
        return GeometryReflectCall(inner: inner)
    # unary rpc Ping.
    pub fn Ping(req: Empty) -> Empty!grpc.GrpcError:
        raw := self.conn.unary("/sample.Geometry/Ping", encode_Empty(req))!
        decoded := decode_Empty(raw)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INTERNAL, message: "grpc: decode Empty failed")
        return decoded.ok

# a server for the Geometry service. implement one handler per rpc and
# hand them to serve_Geometry; the router deframes and decodes each
# request, dispatches by method path, and frames the reply. a streamed
# request arrives as a List, and a streamed reply is returned as one:
# buffered end to end, so bounded streams only.
fn _Geometry_route(path: String, body: Bytes, handle_Describe: fn(Point) -> Shape!grpc.GrpcError, handle_Corners: fn(Shape) -> List[Point]!grpc.GrpcError, handle_Assemble: fn(List[Point]) -> Shape!grpc.GrpcError, handle_Reflect: fn(List[Point]) -> List[Point]!grpc.GrpcError, handle_Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Bytes!grpc.GrpcError:
    if path == "/sample.Geometry/Describe":
        msgs := grpc.unframe_messages(body)!
        if msgs.len() > 1:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        mut request := bytes.empty()
        if msgs.len() == 1:
            request = msgs[0]
        decoded := decode_Point(request)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Point failed")
        return grpc.frame_one(encode_Shape(handle_Describe(decoded.ok)!))
    if path == "/sample.Geometry/Corners":
        msgs := grpc.unframe_messages(body)!
        if msgs.len() > 1:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        mut request := bytes.empty()
        if msgs.len() == 1:
            request = msgs[0]
        decoded := decode_Shape(request)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Shape failed")
        replies := handle_Corners(decoded.ok)!
        mut framed: List[Bytes] := []
        for reply in replies:
            framed.push(encode_Point(reply))
        return grpc.frame_messages(framed)
    if path == "/sample.Geometry/Assemble":
        msgs := grpc.unframe_messages(body)!
        mut requests: List[Point] := []
        for msg in msgs:
            decoded := decode_Point(msg)
            if decoded.is_err:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Point failed")
            requests.push(decoded.ok)
        return grpc.frame_one(encode_Shape(handle_Assemble(requests)!))
    if path == "/sample.Geometry/Reflect":
        msgs := grpc.unframe_messages(body)!
        mut requests: List[Point] := []
        for msg in msgs:
            decoded := decode_Point(msg)
            if decoded.is_err:
                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Point failed")
            requests.push(decoded.ok)
        replies := handle_Reflect(requests)!
        mut framed: List[Bytes] := []
        for reply in replies:
            framed.push(encode_Point(reply))
        return grpc.frame_messages(framed)
    if path == "/sample.Geometry/Ping":
        msgs := grpc.unframe_messages(body)!
        if msgs.len() > 1:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "expected one request message")
        mut request := bytes.empty()
        if msgs.len() == 1:
            request = msgs[0]
        decoded := decode_Empty(request)
        if decoded.is_err:
            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: "grpc: decode Empty failed")
        return grpc.frame_one(encode_Empty(handle_Ping(decoded.ok)!))
    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: "no method " + path)

# the body-level dispatch routing to these handlers.
fn _Geometry_dispatch(Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape) -> List[Point]!grpc.GrpcError, Assemble: fn(List[Point]) -> Shape!grpc.GrpcError, Reflect: fn(List[Point]) -> List[Point]!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> fn(String, Bytes) -> Bytes!grpc.GrpcError:
    return fn(path: String, body: Bytes) -> Bytes!grpc.GrpcError => _Geometry_route(path, body, Describe, Corners, Assemble, Reflect, Ping)

# serve Geometry over plaintext http/2 (h2c). pass one handler per rpc.
pub fn serve_Geometry(host: String, port: Int, Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape) -> List[Point]!grpc.GrpcError, Assemble: fn(List[Point]) -> Shape!grpc.GrpcError, Reflect: fn(List[Point]) -> List[Point]!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Int!:
    return grpc.serve_body(host, port, _Geometry_dispatch(Describe, Corners, Assemble, Reflect, Ping))!

# serve Geometry over http/2 with tls (alpn h2).
pub fn serve_Geometry_tls(host: String, port: Int, cert: String, key: String, Describe: fn(Point) -> Shape!grpc.GrpcError, Corners: fn(Shape) -> List[Point]!grpc.GrpcError, Assemble: fn(List[Point]) -> Shape!grpc.GrpcError, Reflect: fn(List[Point]) -> List[Point]!grpc.GrpcError, Ping: fn(Empty) -> Empty!grpc.GrpcError) -> Int!:
    return grpc.serve_body_tls(host, port, cert, key, _Geometry_dispatch(Describe, Corners, Assemble, Reflect, Ping))!

# a typed handle for one live Geometry.Corners rpc on the server.
pub struct GeometryCornersServerCall:
    pub inner: grpc.GrpcStream

impl GeometryCornersServerCall:
    # frame and send one Point reply immediately.
    pub fn send(reply: Point) -> Int:
        return self.inner.send_message(encode_Point(reply))
    # end the rpc with a status; returning from the handler without
    # finishing ends it with OK.
    pub fn finish(status: Int, message: String):
        self.inner.finish(status, message)
    # end the rpc with grpc-status 0 (OK).
    pub fn finish_ok():
        self.inner.finish_ok()
    # this rpc's caller metadata, lowercase-keyed.
    pub fn metadata() -> Map[String, String]:
        return self.inner.metadata()
    # the absolute deadline (a time.mono_millis() timestamp), 0 when none.
    pub fn deadline_ms() -> Int:
        return self.inner.deadline_ms()
    # whether a graceful shutdown has begun. a handler that streams
    # indefinitely polls this and ends its own stream; one that does
    # not is closed with UNAVAILABLE partway through the grace period.
    pub fn closing() -> Bool:
        return self.inner.closing()

