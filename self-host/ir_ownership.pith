# low-level rc retain/release helpers, split out so both the core emitter
# and the match emitter can reach them without forming a module cycle
# (ir_emitter_core imports ir_match_emit, so the helpers can't live there).
# these are stateless: they emit a retain or release for a register holding
# a value of a given rc kind. the owned-locals tracking state and the exit
# cleanup stay in ir_emitter_core.

from ir_builder import ir_reg, ir_emit, ir_kinded_release_symbol, ir_kinded_release_used
from ir_call_emit import ir_emit_call1, ir_emit_call2

# take one count on the string in `r`. safe on any string register: the
# runtime makes retain a no-op for literals and null, so emitted code
# never has to know where the string came from.
pub fn ir_string_retain_reg(r: Int):
    ir_emit_call1(ir_reg(), "__cstring_retain", "void", r)

# drop one count on the string in `r`, freeing it at the last one. the
# mirror of ir_string_retain_reg and just as safe on a literal or null.
pub fn ir_string_release_reg(r: Int):
    ir_emit_call1(ir_reg(), "__cstring_release", "void", r)

# true when values of `kind` live behind a struct header: the allocation
# pith_struct_alloc hands out, carrying its own count and destructor slot.
#
# "tuple" is what the emitter calls the shells it builds structurally — an
# optional (flag, value), a result (flag, ok, err), a tuple literal. it is a
# separate kind from "struct" because the type system keeps the two apart,
# but at the allocation level they are one thing: the same header, the same
# pith_struct_retain/release pair, the same element tag, the same destructor
# hookup, the same collector visit code. so every question of the form "does
# this kind live behind a struct header?" has to answer yes for both
# spellings, and this is where that question is asked.
#
# four separate leak fixes each rediscovered it and each left its own
# paragraph at its own site. forgetting the tuple half is what stranded ~176
# bytes per `[1, none, 3]` literal typed List[Int?] and ~62 bytes per
# `xs.push(maybe(i))`.
pub fn ir_kind_is_struct_header(kind: String) -> Bool:
    return kind == "struct" or kind == "tuple"

# whether `kind` names something reference counted at all. ir_rc_kind
# returns "" for a value that carries no count (an int, a bool, a
# result shell), so the empty string is the "nothing to release"
# answer. scope cleanup uses this to skip locals that own no count.
# it only asks whether the kind is non-empty — a kind ir_rc_release_reg
# does not recognise still passes here and then emits nothing.
pub fn ir_rc_release_enabled(kind: String) -> Bool:
    return kind.len() > 0

# take one count on `r`, dispatching to the runtime retain that matches
# the rc kind ("string", "list", "map", "set", "bytes", "struct",
# "tuple", "closure", "weak"). this is what a borrow becomes an owned
# count through: binding, assigning or storing a value read out of a
# variable, a collection or a struct field goes through here first.
# an unrecognised kind — including the "" ir_rc_kind returns for a
# non-counted value — emits nothing at all, so a wrong kind string is a
# silent missing retain rather than an error.
pub fn ir_rc_retain_reg(r: Int, kind: String):
    if kind == "string":
        ir_string_retain_reg(r)
    elif kind == "list":
        ir_emit_call1(ir_reg(), "pith_list_retain_handle", "void", r)
    elif kind == "map":
        ir_emit_call1(ir_reg(), "pith_map_retain_handle", "void", r)
    elif kind == "set":
        ir_emit_call1(ir_reg(), "pith_set_retain_handle", "void", r)
    elif kind == "bytes":
        ir_emit_call1(ir_reg(), "pith_bytes_retain", "void", r)
    elif ir_kind_is_struct_header(kind):
        ir_emit_call1(ir_reg(), "pith_struct_retain", "void", r)
    elif kind == "closure":
        ir_emit_call1(ir_reg(), "pith_closure_retain", "void", r)
    elif kind == "channel":
        ir_emit_call1(ir_reg(), "pith_channel_retain", "void", r)
    elif kind == "weak":
        # a weak local's slot holds the bare target pointer and counts only
        # against the header's weak count — never the strong one, or the
        # binding would keep its target alive and the cycle it exists to
        # break would never reclaim. 0 (no target) is a no-op in the runtime.
        ir_emit_call1(ir_reg(), "pith_struct_weak_retain", "void", r)

# the runtime kind code pith_cc_visit expects for an rc child, mirroring
# the closure env tag table (CLOSURE_TAG_* in runtime_core.rs). the
# collector reaches a struct-header child's elements through the box's own
# destructor-keyed tracer. 0 means the kind is not a visitable child.
pub fn ir_cc_visit_code(kind: String) -> Int:
    if kind == "string":
        return 1
    if kind == "list":
        return 2
    if kind == "map":
        return 3
    if kind == "set":
        return 4
    if kind == "bytes":
        return 5
    if ir_kind_is_struct_header(kind):
        return 6
    if kind == "closure":
        return 7
    return 0

# report an rc child to the cycle collector's visit callback without
# touching its count. the generated tracer bodies are built from this the
# way destructor bodies are built from ir_rc_release_reg.
pub fn ir_rc_visit_reg(r: Int, kind: String):
    code := ir_cc_visit_code(kind)
    if code == 0:
        return
    code_r := ir_reg()
    ir_emit("iconst " + code_r.to_string() + " " + code.to_string())
    ir_emit_call2(ir_reg(), "pith_cc_visit", "void", r, code_r)

# drop one count on `r` for the given rc kind, freeing the value at the
# last one. the exact mirror of ir_rc_retain_reg, kind for kind, and the
# two must stay that way — every emitted retain is matched by a release
# with the same kind string. scope cleanup, rebinds, owned-argument
# releases and generated destructor bodies all end up here. an
# unrecognised kind emits nothing, which shows up as a leak, not a
# crash.
pub fn ir_rc_release_reg(r: Int, kind: String):
    if kind == "string":
        ir_string_release_reg(r)
    elif kind == "list":
        ir_emit_call1(ir_reg(), "pith_list_release_handle", "void", r)
    elif kind == "map":
        ir_emit_call1(ir_reg(), "pith_map_release_handle", "void", r)
    elif kind == "set":
        ir_emit_call1(ir_reg(), "pith_set_release_handle", "void", r)
    elif kind == "bytes":
        ir_emit_call1(ir_reg(), "pith_bytes_release", "void", r)
    elif ir_kind_is_struct_header(kind):
        ir_emit_call1(ir_reg(), "pith_struct_release", "void", r)
    elif kind == "closure":
        ir_emit_call1(ir_reg(), "pith_closure_release", "void", r)
    elif kind == "channel":
        ir_emit_call1(ir_reg(), "pith_channel_release", "void", r)
    elif kind == "weak":
        ir_emit_call1(ir_reg(), "pith_struct_weak_release", "void", r)

# the code a kinded local's side slot holds for the rc kind of the value in
# its slot. 0 means the slot owns nothing: a plain value, a view that took no
# count, or a slot no binding has reached. a kind outside this table also
# gets 0. a binding site checks the code before it retains, so such a site
# takes no count and releases none: it can leak, but it never releases under
# the wrong kind.
pub fn ir_kinded_code(kind: String) -> Int:
    if kind == "string":
        return 1
    if kind == "list":
        return 2
    if kind == "map":
        return 3
    if kind == "set":
        return 4
    if kind == "bytes":
        return 5
    if ir_kind_is_struct_header(kind):
        return 6
    if kind == "closure":
        return 7
    if kind == "channel":
        return 8
    return 0

# the rc kind the release helper dispatches `code` to, "" for 0 or an
# unknown code.
pub fn ir_kinded_code_kind(code: Int) -> String:
    kinds := ["", "string", "list", "map", "set", "bytes", "struct", "closure", "channel"]
    if code < 0 or code >= kinds.len():
        return ""
    return kinds[code]

# one past the highest code ir_kinded_code hands out.
pub fn ir_kinded_code_count() -> Int:
    return 9

# the side slot holding the kind code of what a kinded local's slot owns.
pub fn ir_kinded_tag_slot(name: String) -> String:
    return "__rck_" + name

# release whatever a kinded local's slot owns: the value under the kind its
# side slot names, through the module's dispatch helper. a zero value or a
# zero code releases nothing.
pub fn ir_kinded_release_slot(name: String):
    val_r := ir_reg()
    ir_emit("load " + val_r.to_string() + " " + name)
    code_r := ir_reg()
    ir_emit("load " + code_r.to_string() + " " + ir_kinded_tag_slot(name))
    ir_kinded_release_used = true
    ir_emit_call2(ir_reg(), ir_kinded_release_symbol, "void", val_r, code_r)

# a binding site of a kinded local, called after the incoming value is built
# (and retained, when the site takes a count) and before it is stored: drop
# the outgoing value under the kind it was bound with, then record the
# incoming value's kind. `kind` is the rc kind the site's count was taken
# under, or "" for a site that took none. loading the outgoing value here,
# after the right-hand side, rather than before it is what keeps a binding
# of the same name inside that right-hand side (a match arm in the value
# expression) from being released twice.
pub fn ir_kinded_rebind(name: String, kind: String):
    ir_kinded_release_slot(name)
    code_r := ir_reg()
    ir_emit("iconst " + code_r.to_string() + " " + ir_kinded_code(kind).to_string())
    ir_emit("store " + ir_kinded_tag_slot(name) + " " + code_r.to_string())
