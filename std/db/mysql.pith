# std.db.mysql — the pooled, opinionated mysql entry point.
#
# open a pool from a url and run explicit sql; every query and exec borrows a
# connection from the pool and returns it, so many green tasks can share one
# `Db`:
#
#   import std.db.mysql as db
#   import std.sql as sql
#
#   handle := db.open("mysql://me:pw@127.0.0.1:3306/app")!
#   rows := handle.query("select id, name from users where id = ?", ["7"])!
#   for row in rows:
#       print("{row.int(\"id\")} {row.text(\"name\")}")
#   handle.close()
#
# parameters bind mysql-style with `?` placeholders. both query and exec run
# through a server-side prepared statement (the binary protocol), which carries
# the parameters and reports the affected-row count and auto-increment id. use
# `query` for selects and `exec` for writes.
#
# for a group of statements that must succeed or fail together, open a
# transaction with `begin` and finish it with `commit` or `rollback`; for a hot
# query run many times, prepare it once with `prepare`. both pin a single
# connection for their lifetime — see the sections below.
#
# query and exec are observable in the box: each records a RED metric (a
# db_queries_total counter and a db_query_duration_ms histogram, labeled by
# driver and op) and opens a client trace span, the same story as the http and
# grpc clients.

import std.db as db
import std.mysql as mysql
import std.sql as sql
import std.metrics as metrics
import std.trace as trace
import std.time as time

# the open pools, indexed by the handle a Db carries, and a mutex guarding both
# the list and each pool's idle set. the pool lives here rather than inside Db
# for two reasons: a Db then carries only a plain handle, which sidesteps a
# cross-module retain bug when a caller holds the handle; and one lock covers
# every pool, so concurrent tasks borrow and return connections safely.
mut pools: List[mysql.Pool] := []
mut registry_mu := Mutex()

# a pooled handle to a mysql database. it is just an index into the pool
# registry, so it is cheap to copy and safe to share across tasks.
pub struct Db:
    handle: Int

# open a pooled mysql database from a url. the url sets the host, port,
# credentials, database, and optional `?pool=N` cap on open connections; see
# std.db.parse_url for the full shape. connections open lazily, on first use, and
# past the cap an acquirer waits for one to free rather than opening more.
pub fn open(url: String) -> Db!:
    dsn := db.parse_url(url)!
    if dsn.driver != "mysql":
        fail "db.mysql: url is not a mysql url: {url}"
    pool := mysql.pool(dsn.host, dsn.port, dsn.user, dsn.password, dsn.dbname, dsn.pool_size)
    registry_mu.lock()
    pools.push(pool)
    handle := pools.len() - 1
    registry_mu.unlock()
    return Db(handle: handle)

# take a connection from pool `pool_handle`. the registry lock only covers
# looking the pool up; the pool then caps and dials on its own, so a slow
# connect never blocks other tasks' lookups (the pool is self-synchronizing).
fn acquire_from_pool(pool_handle: Int) -> mysql.Conn!:
    registry_mu.lock()
    pool := pools[pool_handle]
    registry_mu.unlock()
    return pool.acquire()!

# return a connection to pool `pool_handle`. as with acquire, the lock only
# covers the lookup; any close network i/o happens in the pool, off the lock.
fn release_to_pool(pool_handle: Int, conn: mysql.Conn):
    registry_mu.lock()
    pool := pools[pool_handle]
    registry_mu.unlock()
    pool.release(conn)

# discard a poisoned connection back to pool `pool_handle`: it is closed rather
# than reused, but its slot still returns so the cap does not leak. use this on
# every error path instead of closing the connection directly.
fn discard_to_pool(pool_handle: Int, conn: mysql.Conn):
    registry_mu.lock()
    pool := pools[pool_handle]
    registry_mu.unlock()
    pool.discard(conn)

# --- pinned connections (transactions and prepared statements) ---
#
# a transaction runs every statement on one connection, and a prepared statement
# is parsed once on one connection and reused; both therefore pin a connection
# out of the pool for their lifetime and return it when they finish. the pinned
# connection lives here in a module-global registry, exactly like the pools
# above, so the Tx or Stmt a caller holds carries only a plain Int handle.
#
# a finished pin keeps its slot rather than freeing it — a `finished` handle held
# past its end reads as such and errors, instead of silently landing on a reused
# connection. the registry therefore only grows; reclaiming spent slots safely is
# a later refinement.

# a connection pinned out of a pool. `pool` is the handle of the pool it came
# from, so it can be returned there. `broken` turns true when a statement on it
# fails: a failed statement leaves the connection out of protocol sync, so it is
# discarded rather than returned to the pool. `finished` guards against use after
# the transaction or statement has ended.
# `conn` is optional and cleared to none the moment the pin finishes, so a spent
# slot (the registry never frees slots) stops retaining a live connection that
# has meanwhile returned to the pool or closed. it is always set while the pin is
# in use; every reader guards with `pin_finished` first.
struct Pin:
    mut conn: mysql.Conn?
    pool: Int
    mut broken: Bool
    mut finished: Bool

mut pins: List[Pin] := []
mut pins_mu := Mutex()

# the server-side prepared statement behind each Stmt, indexed by the slot the
# Stmt carries. it lives beside the pin registry (not inside Pin) so a Tx, which
# prepares nothing lasting, needs no placeholder statement.
mut prepared: List[mysql.Stmt] := []

# pin a fresh connection from pool `pool_handle` and register it, returning the
# pin handle. the caller then runs BEGIN or PREPARE on the pinned connection.
fn pin_connection(pool_handle: Int) -> Int!:
    conn := acquire_from_pool(pool_handle)!
    pins_mu.lock()
    pins.push(Pin(conn: conn, pool: pool_handle, broken: false, finished: false))
    handle := pins.len() - 1
    pins_mu.unlock()
    return handle

# the pinned connection for a handle. only call it while the pin is live (its
# callers all guard with pin_finished first); a finished pin has cleared it.
fn pin_conn(handle: Int) -> mysql.Conn:
    pins_mu.lock()
    conn := pins[handle].conn
    pins_mu.unlock()
    return conn.value()

# whether the pinned connection has ended (committed, closed, or discarded).
fn pin_finished(handle: Int) -> Bool:
    pins_mu.lock()
    done := pins[handle].finished
    pins_mu.unlock()
    return done

# whether a statement on the pinned connection has failed.
fn pin_broken(handle: Int) -> Bool:
    pins_mu.lock()
    broken := pins[handle].broken
    pins_mu.unlock()
    return broken

# mark the pinned connection out of sync after a failed statement.
fn pin_mark_broken(handle: Int):
    pins_mu.lock()
    pins[handle].broken = true
    pins_mu.unlock()

# finish the pin and return its connection to the pool for reuse. the slot drops
# its reference to the connection so a spent pin retains nothing.
fn pin_release(handle: Int):
    pins_mu.lock()
    conn := pins[handle].conn
    pool := pins[handle].pool
    pins[handle].conn = none
    pins[handle].finished = true
    pins_mu.unlock()
    release_to_pool(pool, conn.value())

# finish the pin and close its connection instead of reusing it, for when it is
# out of protocol sync. the slot drops its reference the same way, and the
# connection is discarded back to the pool so its cap slot returns.
fn pin_discard(handle: Int):
    pins_mu.lock()
    conn := pins[handle].conn
    pool := pins[handle].pool
    pins[handle].conn = none
    pins[handle].finished = true
    pins_mu.unlock()
    discard_to_pool(pool, conn.value())

# register a prepared statement and return its slot.
fn register_prepared(stmt: mysql.Stmt) -> Int:
    pins_mu.lock()
    prepared.push(stmt)
    slot := prepared.len() - 1
    pins_mu.unlock()
    return slot

# the prepared statement in a slot.
fn prepared_stmt(slot: Int) -> mysql.Stmt:
    pins_mu.lock()
    stmt := prepared[slot]
    pins_mu.unlock()
    return stmt

# a transaction: a connection pinned out of the pool with BEGIN already sent. it
# carries only the pin handle, so it crosses module boundaries cleanly.
pub struct Tx:
    handle: Int

impl Tx:
    # run a query inside the transaction, on its pinned connection. the rows read
    # the same as Db.query's.
    pub fn query(text: String, params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(text, params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run a write inside the transaction, on its pinned connection.
    pub fn exec(text: String, params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(text, params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    fn run_query(text: String, params: List[String]) -> List[sql.Row]!:
        if pin_finished(self.handle):
            fail "db.mysql: transaction already finished"
        attempt := gather(pin_conn(self.handle), text, params)
        if attempt.is_err:
            pin_mark_broken(self.handle)
            fail attempt.err
        return attempt.ok

    fn run_exec(text: String, params: List[String]) -> db.ExecResult!:
        if pin_finished(self.handle):
            fail "db.mysql: transaction already finished"
        attempt := apply(pin_conn(self.handle), text, params)
        if attempt.is_err:
            pin_mark_broken(self.handle)
            fail attempt.err
        return attempt.ok

    # commit the transaction and return the connection to the pool. a
    # transaction with a failed statement cannot commit — it is rolled back (its
    # connection discarded) and this fails.
    pub fn commit() -> Bool!:
        if pin_finished(self.handle):
            fail "db.mysql: transaction already finished"
        if pin_broken(self.handle):
            pin_discard(self.handle)
            fail "db.mysql: transaction has a failed statement; rolled back"
        committed := mysql.query(pin_conn(self.handle), "commit")
        if committed.is_err:
            pin_discard(self.handle)
            fail committed.err
        pin_release(self.handle)
        return true

    # roll back the transaction, discarding its changes, and return the
    # connection to the pool. it is always safe to call — on a failed statement
    # it discards the out-of-sync connection — so it fits an error path directly
    # without itself failing.
    pub fn rollback():
        if pin_finished(self.handle):
            return
        if pin_broken(self.handle):
            pin_discard(self.handle)
            return
        rolled := mysql.query(pin_conn(self.handle), "rollback")
        if rolled.is_err:
            pin_discard(self.handle)
            return
        pin_release(self.handle)

# a prepared statement: a connection pinned out of the pool with the statement
# parsed on it. it carries the pin handle plus the slot of its prepared
# statement.
pub struct Stmt:
    handle: Int
    slot: Int

impl Stmt:
    # run the prepared statement as a query, binding `params`.
    pub fn query(params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run the prepared statement as a write, binding `params`.
    pub fn exec(params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    fn run_query(params: List[String]) -> List[sql.Row]!:
        if pin_finished(self.handle):
            fail "db.mysql: prepared statement already closed"
        attempt := mysql.query_prepared(pin_conn(self.handle), prepared_stmt(self.slot), params)
        if attempt.is_err:
            pin_mark_broken(self.handle)
            fail attempt.err
        mut rows: List[sql.Row] := []
        for row in attempt.ok:
            rows.push(row)
        return rows

    fn run_exec(params: List[String]) -> db.ExecResult!:
        if pin_finished(self.handle):
            fail "db.mysql: prepared statement already closed"
        attempt := mysql.exec_prepared_info(pin_conn(self.handle), prepared_stmt(self.slot), params)
        if attempt.is_err:
            pin_mark_broken(self.handle)
            fail attempt.err
        info := attempt.ok
        return db.exec_result(info.affected, info.last_insert_id)

    # free the statement on the server and return its connection to the pool.
    # always safe to call; a broken or already-closed statement simply drops its
    # connection.
    pub fn close():
        if pin_finished(self.handle):
            return
        if pin_broken(self.handle):
            pin_discard(self.handle)
            return
        freed := mysql.close_stmt(pin_conn(self.handle), prepared_stmt(self.slot))
        if freed.is_err:
            pin_discard(self.handle)
            return
        pin_release(self.handle)

impl Db:
    # run a parameterized query and buffer its rows. `?` placeholders bind to
    # `params` (in text form), keeping values off the sql string. the result is a
    # list of std.sql.Row — iterate it, index it, or pass it to std.db.first; each
    # row carries the typed accessors (row.int("id"), row.opt_text("email"), ...).
    pub fn query(text: String, params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(text, params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run a write (insert/update/delete/ddl) and report the rows it affected and,
    # for an auto_increment insert, the id the server assigned.
    pub fn exec(text: String, params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(text, params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # borrow a connection, prepare and run the select, free the statement, and
    # return the connection to the pool. a failed query leaves the connection out
    # of protocol sync, so it is closed rather than reused.
    fn run_query(text: String, params: List[String]) -> List[sql.Row]!:
        conn := self.borrow()!
        gathered := gather(conn, text, params)
        if gathered.is_err:
            self.discard(conn)
            fail gathered.err
        self.giveback(conn)
        return gathered.ok

    # borrow a connection, prepare and run the write, free the statement, and
    # return the connection to the pool.
    fn run_exec(text: String, params: List[String]) -> db.ExecResult!:
        conn := self.borrow()!
        info := apply(conn, text, params)
        if info.is_err:
            self.discard(conn)
            fail info.err
        self.giveback(conn)
        return info.ok

    # take a connection from this handle's pool.
    fn borrow() -> mysql.Conn!:
        return acquire_from_pool(self.handle)!

    # return a connection to this handle's pool for reuse.
    fn giveback(conn: mysql.Conn):
        release_to_pool(self.handle, conn)

    # discard a poisoned connection back to this handle's pool: closed, not
    # reused, but its cap slot still returns.
    fn discard(conn: mysql.Conn):
        discard_to_pool(self.handle, conn)

    # begin a transaction on a single pinned connection. every statement you run
    # on the returned Tx uses that same connection; finish with commit() to keep
    # the changes or rollback() to discard them, and either way the connection
    # returns to the pool. see the Tx methods above.
    pub fn begin() -> Tx!:
        handle := pin_connection(self.handle)!
        started := mysql.query(pin_conn(handle), "begin")
        if started.is_err:
            pin_discard(handle)
            fail started.err
        return Tx(handle: handle)

    # prepare `text` once on a pinned connection so a hot query can run many
    # times without re-parsing. run it with Stmt.query / Stmt.exec and free it
    # with Stmt.close(), which returns the connection to the pool.
    pub fn prepare(text: String) -> Stmt!:
        handle := pin_connection(self.handle)!
        attempt := mysql.prepare(pin_conn(handle), text)
        if attempt.is_err:
            pin_discard(handle)
            fail attempt.err
        slot := register_prepared(attempt.ok)
        return Stmt(handle: handle, slot: slot)

    # drain the pool, closing every idle connection. the lock only covers the
    # lookup; the connection close network i/o happens in the pool, off the lock.
    pub fn close():
        registry_mu.lock()
        pool := pools[self.handle]
        registry_mu.unlock()
        pool.close()

# prepare, run, and free a select on `conn`, collecting the rows into a list.
fn gather(conn: mysql.Conn, text: String, params: List[String]) -> List[sql.Row]!:
    stmt := mysql.prepare(conn, text)!
    mut rows: List[sql.Row] := []
    for row in mysql.query_prepared(conn, stmt, params)!:
        rows.push(row)
    mysql.close_stmt(conn, stmt)!
    return rows

# prepare, run, and free a write on `conn`, returning the affected count and the
# auto-increment id.
fn apply(conn: mysql.Conn, text: String, params: List[String]) -> db.ExecResult!:
    stmt := mysql.prepare(conn, text)!
    info := mysql.exec_prepared_info(conn, stmt, params)!
    mysql.close_stmt(conn, stmt)!
    return db.exec_result(info.affected, info.last_insert_id)

# record the RED metrics for one operation: a count labeled ok/err and the
# duration in the shared histogram.
fn record(op: String, failed: Bool, elapsed_ms: Int):
    mut status := "ok"
    if failed:
        status = "err"
    metrics.counter("db_queries_total").labels(["driver", "mysql", "op", op, "status", status]).inc()
    metrics.histogram("db_query_duration_ms").labels(["driver", "mysql", "op", op]).observe(elapsed_ms.to_float())
