# ir_capture.pith - lambda capture analysis

from ast import get_node
from ir_ast_helpers import ir_list_contains, ir_is_binding_kind, ir_binding_name
from ir_metadata import ir_is_known_returning_func

fn ir_copy_names(names: List[String]) -> List[String]:
    mut copy: List[String] := []
    for name in names:
        copy.push(name)
    return copy

fn ir_should_capture_name(name: String, bound: List[String], free: List[String], blocked_names: Map[String, Bool], locals: Map[String, Int]) -> Bool:
    if ir_list_contains(bound, name) or ir_list_contains(free, name):
        return false
    # a real variable in the enclosing scope must be captured even if a global
    # function or type shares its name — the local shadows the global (e.g. a
    # parameter named `host` alongside std.net.url.host).
    if locals.contains_key(name):
        return true
    if blocked_names.contains_key(name):
        return false
    return not ir_is_known_returning_func(name)

fn ir_find_free_vars_walk(idx: Int, bound: List[String], free: List[String], blocked_names: Map[String, Bool], locals: Map[String, Int]) -> List[String]:
    node := get_node(idx)
    if node.kind == "ident":
        name := node.value
        if ir_should_capture_name(name, bound, free, blocked_names, locals):
            mut updated := ir_copy_names(free)
            updated.push(name)
            return updated
        return free
    # the receiver of an impl method is its own node kind rather than an ident,
    # so it used to fall through to the generic child walk and never be
    # captured. a spawn or lambda body that read it then emitted a bare
    # `load self` into a thunk that has no such local, and the ir consumer
    # rejected it with "unknown load source 'self'".
    if node.kind == "self":
        if ir_should_capture_name("self", bound, free, blocked_names, locals):
            mut updated := ir_copy_names(free)
            updated.push("self")
            return updated
        return free
    if node.kind == "lambda":
        inner_bound := ir_copy_names(bound)
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "param":
                inner_bound.push(cn.value)
        mut updated_free := ir_copy_names(free)
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "body" or cn.kind == "block":
                updated_free = ir_find_free_vars_walk(child, inner_bound, updated_free, blocked_names, locals)
        return updated_free
    if node.kind == "body" or node.kind == "block":
        mut scoped_bound := ir_copy_names(bound)
        mut updated_free := ir_copy_names(free)
        for child in node.children:
            updated_free = ir_find_free_vars_walk(child, scoped_bound, updated_free, blocked_names, locals)
            child_node := get_node(child)
            if ir_is_binding_kind(child_node.kind):
                bind_name := ir_binding_name(child_node)
                if bind_name.len() > 0 and not ir_list_contains(scoped_bound, bind_name):
                    scoped_bound.push(bind_name)
        return updated_free
    mut updated_free := ir_copy_names(free)
    for child in node.children:
        updated_free = ir_find_free_vars_walk(child, bound, updated_free, blocked_names, locals)
    return updated_free

# the names a lambda body has to capture from the scope around it: every
# identifier under `idx` that nothing inside it declares. the emitter
# calls this with the lambda's parameters as `bound` and uses the result
# in order as the closure's environment layout, so slot i belongs to
# name i on both the capture side and the load side.
#
# `blocked_names` are names that are not variables at all — module
# aliases, import renames, struct names, known functions — and are
# skipped. `locals` is the enclosing scope's live variables, and it wins:
# a name that is a real local is captured even when a global of the same
# name is blocked, so a parameter named `host` shadows std.net.url.host.
# an unknown name that is not blocked and is not a known function is
# captured on the assumption that it is a local.
#
# only `bind` statements and lambda parameters add to the bound set as
# the walk descends, and a bind counts only after its own initializer is
# walked (`x := x` captures the outer x). names introduced any other way
# are NOT bound: a `for` loop variable and an `if let` payload are seen
# as free and captured, which emits a load of a name the enclosing frame
# does not have and the ir consumer rejects with "unknown load source".
# `self` is captured under that name like an ordinary variable.
pub fn ir_capture_find_free_vars(idx: Int, bound: List[String], blocked_names: Map[String, Bool], locals: Map[String, Int]) -> List[String]:
    return ir_find_free_vars_walk(idx, bound, [], blocked_names, locals)
