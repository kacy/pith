{
  "name": "pith",
  "displayName": "Pith Language",
  "description": "Language support for pith: syntax highlighting plus diagnostics, hover, symbols, and formatting via the pith language server.",
  "publisher": "pith-lang",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:pith"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pith",
        "aliases": [
          "Pith",
          "pith"
        ],
        "extensions": [
          ".pith"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pith",
        "scopeName": "source.pith",
        "path": "./syntaxes/pith.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Pith",
      "properties": {
        "pith.serverPath": {
          "type": "string",
          "default": "pith",
          "description": "Path to the pith executable used to start the language server (`pith lsp`)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
