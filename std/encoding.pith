# std.encoding - base64, base32, base58, hex, varint, and pem helpers
#
# this module is bytes-first. text helpers cross the utf-8 boundary
# explicitly when that's what you want.

import std.bits as bits
import std.bytes as bytes

# the ascii code of "=", so the base64 paths can compare and emit padding
# by byte instead of allocating a one-character string per group.
PAD_BYTE := 61

# a decoded pem block.
pub struct PemBlock:
    pub kind: String
    pub headers: Map[String, String]
    pub body: Bytes

# a decoded unsigned varint and the number of bytes consumed.
pub struct VarintResult:
    pub value: Int
    pub read: Int

fn b64_standard_table() -> String:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn b64_url_table() -> String:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn b32_standard_table() -> String:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

fn b32_hex_table() -> String:
    return "0123456789ABCDEFGHIJKLMNOPQRSTUV"

fn b58_table() -> String:
    return "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

fn is_ws_byte(code: Int) -> Bool:
    return code == 32 or code == 9 or code == 10 or code == 13

fn pow2(exp: Int) -> Int:
    mut out := 1
    mut i := 0
    while i < exp:
        out = out * 2
        i = i + 1
    return out

fn table_char_val(c: String, table: String) -> Int:
    mut i := 0
    while i < table.len():
        if c == table[i]:
            return i
        i = i + 1
    return - 1

# the value of one base64 character, or -1 when it is not in the alphabet.
# positions 0..61 are the same in both rfc 4648 alphabets, so they resolve
# arithmetically; 62 and 63 are read from the caller's table so the two
# alphabets cannot drift apart. the "base64 alphabets agree with a table
# scan" test pins the arithmetic against the tables themselves.
fn b64_char_val(code: Int, char62: Int, char63: Int) -> Int:
    if code >= 65 and code <= 90:
        return code - 65
    if code >= 97 and code <= 122:
        return code - 97 + 26
    if code >= 48 and code <= 57:
        return code - 48 + 52
    if code == char62:
        return 62
    if code == char63:
        return 63
    return - 1

fn clean_encoded(input: String, ignore_ws: Bool) -> String!:
    # keeping the input when there is nothing to strip matters: this used to
    # rebuild the whole string one character at a time on every decode.
    if not ignore_ws:
        return input
    out := bytes.buffer_with_capacity(input.len())
    defer out.free()
    mut i := 0
    while i < input.len():
        code := ord(input[i])
        if not is_ws_byte(code):
            out.write_byte(code)!
        i = i + 1
    return out.bytes().to_string_utf8()!

fn append_padding(input: String, group_size: Int) -> String:
    mut out := input
    while out.len() % group_size != 0:
        out = out + "="
    return out

# pack four alphabet lookups into one little-endian word so a whole output
# group costs a single buffer append. callers that emit fewer than four
# characters pass 0 for the unused slots and write that many bytes.
fn b64_quad(table: Bytes, v0: Int, v1: Int, v2: Int, v3: Int) -> Int:
    return table[v0] + table[v1] * 256 + table[v2] * 65536 + table[v3] * 16777216

fn b64_encode_with(input: Bytes, table: String, padded: Bool) -> String:
    alphabet := bytes.from_string_utf8(table)
    count := input.len()
    out := bytes.buffer_with_capacity((count + 2) / 3 * 4)
    defer out.free()
    mut i := 0
    while i + 2 < count:
        a := input[i]
        b := input[i + 1]
        c := input[i + 2]
        out.write_word(b64_quad(alphabet, a / 4, (a % 4) * 16 + b / 16, (b % 16) * 4 + c / 64, c % 64), 4)
        i = i + 3
    if i < count:
        a := input[i]
        if i + 1 < count:
            b := input[i + 1]
            out.write_word(b64_quad(alphabet, a / 4, (a % 4) * 16 + b / 16, (b % 16) * 4, 0), 3)
            if padded:
                out.write_word(PAD_BYTE, 1)
        else:
            out.write_word(b64_quad(alphabet, a / 4, (a % 4) * 16, 0, 0), 2)
            if padded:
                out.write_word(PAD_BYTE + PAD_BYTE * 256, 2)
    # every byte written above came from an ascii alphabet or is "=", so the
    # decode cannot fail; an empty result would be a visible total failure
    # rather than a silently wrong encoding.
    return out.bytes().to_string_utf8() catch ""

fn b64_decode_with(input: String, table: String, padded: Bool, ignore_ws: Bool) -> Bytes!:
    cleaned := clean_encoded(input, ignore_ws)!
    mut text := cleaned
    if padded:
        if text.len() % 4 != 0:
            fail "invalid base64: length not multiple of 4"
    else:
        if text.contains("="):
            fail "invalid base64 padding"
        if text.len() % 4 == 1:
            fail "invalid base64: invalid length"
        text = append_padding(text, 4)

    char62 := ord(table[62])
    char63 := ord(table[63])
    buf := bytes.buffer_with_capacity(text.len())
    defer buf.free()
    mut i := 0
    while i < text.len():
        a := b64_char_val(ord(text[i]), char62, char63)
        b := b64_char_val(ord(text[i + 1]), char62, char63)
        if a < 0 or b < 0:
            fail "invalid base64 character"

        c_pad := ord(text[i + 2]) == PAD_BYTE
        d_pad := ord(text[i + 3]) == PAD_BYTE
        if c_pad and not d_pad:
            fail "invalid base64 padding"
        if (c_pad or d_pad) and i + 4 != text.len():
            fail "invalid base64 padding"

        mut c := 0
        if not c_pad:
            c = b64_char_val(ord(text[i + 2]), char62, char63)
            if c < 0:
                fail "invalid base64 character"
        mut d := 0
        if not d_pad:
            d = b64_char_val(ord(text[i + 3]), char62, char63)
            if d < 0:
                fail "invalid base64 character"

        buf.write_byte(a * 4 + b / 16)!
        if not c_pad:
            buf.write_byte((b % 16) * 16 + c / 4)!
        if not d_pad:
            buf.write_byte((c % 4) * 64 + d)!
        i = i + 4
    return buf.bytes()

# encode bytes as padded standard base64.
pub fn b64_encode(input: Bytes) -> String:
    return b64_encode_with(input, b64_standard_table(), true)

fn encoding_b64_encode(input: Bytes) -> String:
    return b64_encode(input)

# encode a utf-8 string as padded standard base64.
pub fn b64_encode_string(input: String) -> String:
    return b64_encode(bytes.from_string_utf8(input))

fn encoding_b64_encode_string(input: String) -> String:
    return b64_encode_string(input)

# encode bytes as url-safe padded base64.
pub fn b64_url_encode(input: Bytes) -> String:
    return b64_encode_with(input, b64_url_table(), true)

# encode bytes as unpadded standard base64.
pub fn b64_raw_encode(input: Bytes) -> String:
    return b64_encode_with(input, b64_standard_table(), false)

# encode bytes as unpadded url-safe base64.
pub fn b64_url_raw_encode(input: Bytes) -> String:
    return b64_encode_with(input, b64_url_table(), false)

# decode padded standard base64 into bytes.
pub fn b64_decode(input: String) -> Bytes!:
    return b64_decode_with(input, b64_standard_table(), true, false)

fn encoding_b64_decode(input: String) -> Bytes!:
    return b64_decode(input)

# decode standard base64 while ignoring ascii whitespace.
pub fn b64_decode_ignore_ws(input: String) -> Bytes!:
    return b64_decode_with(input, b64_standard_table(), true, true)

# decode padded url-safe base64 into bytes.
pub fn b64_url_decode(input: String) -> Bytes!:
    return b64_decode_with(input, b64_url_table(), true, false)

# decode unpadded standard base64 into bytes.
pub fn b64_raw_decode(input: String) -> Bytes!:
    return b64_decode_with(input, b64_standard_table(), false, false)

# decode unpadded url-safe base64 into bytes.
pub fn b64_url_raw_decode(input: String) -> Bytes!:
    return b64_decode_with(input, b64_url_table(), false, false)

# decode a base64 string and interpret the result as utf-8 text.
pub fn b64_decode_utf8(input: String) -> String!:
    return b64_decode(input)!.to_string_utf8()!

fn encoding_b64_decode_utf8(input: String) -> String!:
    return b64_decode_utf8(input)

fn b32_encode_with(input: Bytes, table: String, padded: Bool) -> String:
    # appending one alphabet character at a time to the result string
    # recopied the whole accumulated string, which made base32 encoding
    # quadratic in the input; a byte buffer keeps each append constant.
    alphabet := bytes.from_string_utf8(table)
    out := bytes.buffer_with_capacity((input.len() + 4) / 5 * 8)
    defer out.free()
    mut buffer := 0
    mut bits_left := 0
    mut i := 0
    while i < input.len():
        buffer = buffer * 256 + input[i]
        bits_left = bits_left + 8
        while bits_left >= 5:
            index := buffer / pow2(bits_left - 5)
            out.write_byte(alphabet[index % 32])
            bits_left = bits_left - 5
            buffer = buffer % pow2(bits_left)
        i = i + 1
    if bits_left > 0:
        index := buffer * pow2(5 - bits_left)
        out.write_byte(alphabet[index % 32])
    if padded:
        while out.len() % 8 != 0:
            out.write_word(PAD_BYTE, 1)
    # every byte written above came from an ascii alphabet or is "=", so the
    # decode cannot fail; an empty result would be a visible total failure
    # rather than a silently wrong encoding.
    return out.bytes().to_string_utf8() catch ""

fn b32_decode_with(input: String, table: String, padded: Bool, ignore_ws: Bool) -> Bytes!:
    cleaned := clean_encoded(input, ignore_ws)!
    mut text := cleaned
    if padded:
        if text.len() % 8 != 0:
            fail "invalid base32: length not multiple of 8"
    else:
        if text.contains("="):
            fail "invalid base32 padding"

    buf := bytes.buffer_with_capacity(text.len())
    defer buf.free()
    mut buffer := 0
    mut bits_left := 0
    mut seen_pad := false
    mut i := 0
    while i < text.len():
        c := text[i]
        if c == "=":
            seen_pad = true
        else:
            if seen_pad:
                fail "invalid base32 padding"
            v := table_char_val(c.to_upper(), table)
            if v < 0:
                fail "invalid base32 character"
            buffer = buffer * 32 + v
            bits_left = bits_left + 5
            while bits_left >= 8:
                byte_value := buffer / pow2(bits_left - 8)
                buf.write_byte(byte_value % 256)!
                bits_left = bits_left - 8
                buffer = buffer % pow2(bits_left)
        i = i + 1
    return buf.bytes()

# encode bytes as padded RFC 4648 base32.
pub fn base32_encode(input: Bytes) -> String:
    return b32_encode_with(input, b32_standard_table(), true)

# decode padded RFC 4648 base32.
pub fn base32_decode(input: String) -> Bytes!:
    return b32_decode_with(input, b32_standard_table(), true, false)

# encode bytes as unpadded RFC 4648 base32.
pub fn base32_raw_encode(input: Bytes) -> String:
    return b32_encode_with(input, b32_standard_table(), false)

# decode unpadded RFC 4648 base32.
pub fn base32_raw_decode(input: String) -> Bytes!:
    return b32_decode_with(input, b32_standard_table(), false, false)

# encode bytes with the RFC 4648 base32hex alphabet.
pub fn base32_hex_encode(input: Bytes) -> String:
    return b32_encode_with(input, b32_hex_table(), true)

# decode bytes with the RFC 4648 base32hex alphabet.
pub fn base32_hex_decode(input: String) -> Bytes!:
    return b32_decode_with(input, b32_hex_table(), true, false)

fn b58_value(c: String) -> Int:
    return table_char_val(c, b58_table())

# encode bytes with the bitcoin base58 alphabet.
pub fn base58_encode(input: Bytes) -> String:
    if input.len() == 0:
        return ""

    alphabet := b58_table()
    mut zeroes := 0
    while zeroes < input.len() and input[zeroes] == 0:
        zeroes = zeroes + 1

    digits := bytes.array()
    digits.push(0)
    mut i := zeroes
    while i < input.len():
        mut carry := input[i]
        mut j := 0
        while j < digits.len():
            carry = carry + digits.get(j) * 256
            digits.set(j, carry % 58)
            carry = carry / 58
            j = j + 1
        while carry > 0:
            digits.push(carry % 58)
            carry = carry / 58
        i = i + 1

    # appending one alphabet character at a time to the result string
    # recopied the whole accumulated string, which made base58 encoding
    # quadratic in the output; a byte buffer keeps each append constant.
    table := bytes.from_string_utf8(alphabet)
    out := bytes.buffer_with_capacity(zeroes + digits.len())
    defer out.free()
    i = 0
    while i < zeroes:
        out.write_byte(table[0])
        i = i + 1

    mut j := digits.len() - 1
    while j >= 0 and digits.get(j) == 0:
        j = j - 1
    while j >= 0:
        out.write_byte(table[digits.get(j)])
        j = j - 1
    # every byte written above came from an ascii alphabet, so the decode
    # cannot fail; an empty result would be a visible total failure rather
    # than a silently wrong encoding.
    return out.bytes().to_string_utf8() catch ""

# decode bitcoin base58 into bytes.
pub fn base58_decode(input: String) -> Bytes!:
    if input.len() == 0:
        return bytes.empty()

    alphabet := b58_table()
    mut zeroes := 0
    while zeroes < input.len() and input[zeroes] == alphabet[0]:
        zeroes = zeroes + 1

    digits := bytes.array()
    digits.push(0)
    mut i := zeroes
    while i < input.len():
        value := b58_value(input[i])
        if value < 0:
            fail "invalid base58 character"
        mut carry := value
        mut j := 0
        while j < digits.len():
            carry = carry + digits.get(j) * 58
            digits.set(j, carry % 256)
            carry = carry / 256
            j = j + 1
        while carry > 0:
            digits.push(carry % 256)
            carry = carry / 256
        i = i + 1

    out := bytes.buffer_with_capacity(zeroes + digits.len())
    defer out.free()
    i = 0
    while i < zeroes:
        out.write_byte(0)
        i = i + 1

    mut j := digits.len() - 1
    while j >= 0 and digits.get(j) == 0:
        j = j - 1
    while j >= 0:
        out.write_byte(digits.get(j))
        j = j - 1
    return out.bytes()

fn hex_nibble(c: String) -> Int:
    if c >= "0" and c <= "9":
        return ord(c) - 48
    if c >= "a" and c <= "f":
        return ord(c) - 97 + 10
    if c >= "A" and c <= "F":
        return ord(c) - 65 + 10
    return - 1

fn hex_with(input: Bytes, digits: String) -> String:
    # appending each digit pair to the result string recopied the whole
    # accumulated string, which made hex encoding quadratic in the input.
    # both digits of a byte pack into one two-byte buffer append.
    table := bytes.from_string_utf8(digits)
    out := bytes.buffer_with_capacity(input.len() * 2)
    defer out.free()
    mut position := 0
    while position < input.len():
        byte_value := input[position]
        out.write_word(table[byte_value / 16] + table[byte_value % 16] * 256, 2)
        position = position + 1
    # every byte written above came from an ascii digit table, so the decode
    # cannot fail; an empty result would be a visible total failure rather
    # than a silently wrong encoding.
    return out.bytes().to_string_utf8() catch ""

# encode bytes as lowercase hexadecimal.
pub fn to_hex(input: Bytes) -> String:
    return hex_with(input, "0123456789abcdef")

fn encoding_to_hex(input: Bytes) -> String:
    return to_hex(input)

# encode bytes as uppercase hexadecimal.
pub fn to_hex_upper(input: Bytes) -> String:
    return hex_with(input, "0123456789ABCDEF")

# encode a utf-8 string as lowercase hexadecimal.
pub fn to_hex_string(input: String) -> String:
    return to_hex(bytes.from_string_utf8(input))

fn encoding_to_hex_string(input: String) -> String:
    return to_hex_string(input)

# decode lowercase or uppercase hexadecimal into bytes.
pub fn from_hex(input: String) -> Bytes!:
    if input.len() % 2 != 0:
        fail "invalid hex: odd length"

    buf := bytes.buffer_with_capacity(input.len() / 2)
    defer buf.free()
    mut position := 0
    while position < input.len():
        high_nibble := hex_nibble(input[position])
        low_nibble := hex_nibble(input[position + 1])
        if high_nibble < 0 or low_nibble < 0:
            fail "invalid hex character"
        buf.write_byte(high_nibble * 16 + low_nibble)!
        position = position + 2
    return buf.bytes()

fn encoding_from_hex(input: String) -> Bytes!:
    return from_hex(input)

# decode hexadecimal and interpret the result as utf-8 text.
pub fn from_hex_utf8(input: String) -> String!:
    return from_hex(input)!.to_string_utf8()!

fn encoding_from_hex_utf8(input: String) -> String!:
    return from_hex_utf8(input)

# encode a non-negative integer as unsigned LEB128.
pub fn varint_encode(value: Int) -> Bytes!:
    if value < 0:
        fail "varint value must be non-negative"
    out := bytes.buffer()
    defer out.free()
    mut remaining := value
    while true:
        mut byte_value := bits.band(remaining, 127)
        remaining = bits.shr(remaining, 7)
        if remaining != 0:
            byte_value = bits.bor(byte_value, 128)
        out.write_byte(byte_value)!
        if remaining == 0:
            return out.bytes()

# decode an unsigned LEB128 varint from the start of a byte slice.
pub fn varint_decode(input: Bytes) -> VarintResult!:
    mut result := 0
    mut shift := 0
    mut i := 0
    while i < input.len():
        byte_value := input[i]
        result = result + bits.shl(bits.band(byte_value, 127), shift)
        if bits.band(byte_value, 128) == 0:
            return VarintResult(result, i + 1)
        shift = shift + 7
        if shift >= 63:
            fail "varint too large"
        i = i + 1
    fail "truncated varint"

fn pem_line_wrap(text: String) -> String:
    mut lines: List[String] := []
    mut i := 0
    while i < text.len():
        mut end := i + 64
        if end > text.len():
            end = text.len()
        lines.push(text.substring(i, end))
        i = end
    return lines.join(chr(10))

# encode bytes as a pem block with no headers.
pub fn pem_encode(kind: String, body: Bytes) -> String:
    return pem_encode_block(PemBlock(kind, {}, body))

# encode a pem block.
pub fn pem_encode_block(block: PemBlock) -> String:
    mut out := "-----BEGIN " + block.kind + "-----" + chr(10)
    for key in block.headers:
        out = out + key + ": " + block.headers[key] + chr(10)
    if block.headers.len() > 0:
        out = out + chr(10)
    out = out + pem_line_wrap(b64_encode(block.body)) + chr(10)
    out = out + "-----END " + block.kind + "-----" + chr(10)
    return out

fn parse_pem_begin(line: String) -> String:
    prefix := "-----BEGIN "
    suffix := "-----"
    if not line.starts_with(prefix) or not line.ends_with(suffix):
        return ""
    return line.substring(prefix.len(), line.len() - suffix.len())

fn parse_pem_end(line: String) -> String:
    prefix := "-----END "
    suffix := "-----"
    if not line.starts_with(prefix) or not line.ends_with(suffix):
        return ""
    return line.substring(prefix.len(), line.len() - suffix.len())

# decode the first pem block in text.
pub fn pem_decode(text: String) -> PemBlock!:
    lines := text.split(chr(10))
    mut index := 0
    mut kind := ""
    while index < lines.len():
        kind = parse_pem_begin(lines[index].trim())
        if kind != "":
            break
        index = index + 1
    if kind == "":
        fail "pem begin marker not found"
    index = index + 1

    mut headers: Map[String, String] := {}
    mut saw_body := false
    mut body_lines: List[String] := []
    while index < lines.len():
        line := lines[index].trim()
        end_kind := parse_pem_end(line)
        if end_kind != "":
            if end_kind != kind:
                fail "pem end marker mismatch"
            body := b64_decode_ignore_ws(body_lines.join(""))!
            return PemBlock(kind, headers, body)
        if line == "":
            saw_body = true
        elif not saw_body and line.contains(":"):
            parts := line.split(":")
            headers.insert(parts[0].trim(), parts.slice(1, parts.len()).join(":").trim())
        else:
            saw_body = true
            body_lines.push(line)
        index = index + 1
    fail "pem end marker not found"

# decode every pem block in text.
pub fn pem_decode_all(text: String) -> List[PemBlock]!:
    lines := text.split(chr(10))
    mut blocks: List[PemBlock] := []
    mut index := 0
    while index < lines.len():
        kind := parse_pem_begin(lines[index].trim())
        if kind == "":
            index = index + 1
            continue
        index = index + 1
        mut headers: Map[String, String] := {}
        mut saw_body := false
        mut body_lines: List[String] := []
        mut found_end := false
        while index < lines.len():
            line := lines[index].trim()
            end_kind := parse_pem_end(line)
            if end_kind != "":
                if end_kind != kind:
                    fail "pem end marker mismatch"
                blocks.push(PemBlock(kind, headers, b64_decode_ignore_ws(body_lines.join(""))!))
                found_end = true
                break
            if line == "":
                saw_body = true
            elif not saw_body and line.contains(":"):
                parts := line.split(":")
                headers.insert(parts[0].trim(), parts.slice(1, parts.len()).join(":").trim())
            else:
                saw_body = true
                body_lines.push(line)
            index = index + 1
        if not found_end:
            fail "pem end marker not found"
        index = index + 1
    if blocks.len() == 0:
        fail "pem begin marker not found"
    return blocks

test "base64 round trips bytes and text":
    data := bytes.from_string_utf8("hello")
    encoded := b64_encode(data)

    assert_eq(encoded, "aGVsbG8=")
    assert_eq(b64_decode(encoded)!.to_string_utf8()!, "hello")
    assert_eq(b64_encode_string("pith"), "cGl0aA==")
    assert_eq(b64_decode_utf8("cGl0aA==")!, "pith")
    assert_eq(b64_url_encode(bytes.from_string_utf8("?")), "Pw==")
    assert_eq(b64_raw_encode(bytes.from_string_utf8("foo")), "Zm9v")
    assert_eq(b64_url_raw_encode(bytes.from_string_utf8("??")), "Pz8")
    assert_eq(b64_url_decode("Pw==")!.to_string_utf8()!, "?")
    assert_eq(b64_raw_decode("Zm9v")!.to_string_utf8()!, "foo")
    assert_eq(b64_url_raw_decode("Pz8")!.to_string_utf8()!, "??")
    assert_eq(b64_decode_ignore_ws("Z m9v" + chr(10))!.to_string_utf8()!, "foo")

test "base64 covers every tail length and both alphabets":
    zero := bytes.from_string_utf8("abcdef")
    one := bytes.from_string_utf8("abcdefg")
    two := bytes.from_string_utf8("abcdefgh")
    high := from_hex("fbffbf")!
    high_tail := from_hex("fbff")!

    assert_eq(b64_encode(bytes.empty()), "")
    assert_eq(b64_raw_encode(bytes.empty()), "")
    assert_eq(b64_decode("")!.len(), 0)
    assert_eq(b64_raw_decode("")!.len(), 0)
    assert_eq(b64_encode(zero), "YWJjZGVm")
    assert_eq(b64_encode(one), "YWJjZGVmZw==")
    assert_eq(b64_encode(two), "YWJjZGVmZ2g=")
    assert_eq(b64_raw_encode(one), "YWJjZGVmZw")
    assert_eq(b64_raw_encode(two), "YWJjZGVmZ2g")
    assert_eq(b64_encode(high), "+/+/")
    assert_eq(b64_url_encode(high), "-_-_")
    assert_eq(b64_encode(high_tail), "+/8=")
    assert_eq(b64_url_encode(high_tail), "-_8=")
    assert_eq(to_hex(b64_decode("+/+/")!), "fbffbf")
    assert_eq(to_hex(b64_url_decode("-_-_")!), "fbffbf")
    assert_eq(b64_decode(b64_encode(one))!.to_string_utf8()!, "abcdefg")
    assert_eq(b64_url_decode(b64_url_encode(one))!.to_string_utf8()!, "abcdefg")
    assert_eq(b64_raw_decode(b64_raw_encode(two))!.to_string_utf8()!, "abcdefgh")
    assert_eq(b64_url_raw_decode(b64_url_raw_encode(two))!.to_string_utf8()!, "abcdefgh")

test "base64 round trips a multi-group buffer through both encoders":
    src := bytes.array_with_capacity(3000)
    mut i := 0
    while i < 3000:
        src.push((i * 37) % 256)!
        i = i + 1
    data := src.bytes()
    wrapped := pem_line_wrap(b64_encode(data))

    assert(bytes.eq(b64_decode(b64_encode(data))!, data))
    assert(bytes.eq(b64_url_decode(b64_url_encode(data))!, data))
    assert(bytes.eq(b64_raw_decode(b64_raw_encode(data))!, data))
    assert(bytes.eq(b64_url_raw_decode(b64_url_raw_encode(data))!, data))
    assert(bytes.eq(b64_decode_ignore_ws(wrapped)!, data))

test "the base64 value arithmetic agrees with a table scan":
    std_table := b64_standard_table()
    url_table := b64_url_table()
    std62 := ord(std_table[62])
    std63 := ord(std_table[63])
    url62 := ord(url_table[62])
    url63 := ord(url_table[63])

    mut code := 1
    while code < 128:
        character := chr(code)
        assert_eq(b64_char_val(code, std62, std63), table_char_val(character, std_table))
        assert_eq(b64_char_val(code, url62, url63), table_char_val(character, url_table))
        code = code + 1

    # no byte above ascii is in either alphabet
    mut high := 128
    while high < 256:
        assert_eq(b64_char_val(high, std62, std63), - 1)
        assert_eq(b64_char_val(high, url62, url63), - 1)
        high = high + 1

test "base32 round trips rfc vectors":
    assert_eq(base32_encode(bytes.from_string_utf8("")), "")
    assert_eq(base32_encode(bytes.from_string_utf8("f")), "MY======")
    assert_eq(base32_encode(bytes.from_string_utf8("fo")), "MZXQ====")
    assert_eq(base32_encode(bytes.from_string_utf8("foo")), "MZXW6===")
    assert_eq(base32_encode(bytes.from_string_utf8("foob")), "MZXW6YQ=")
    assert_eq(base32_encode(bytes.from_string_utf8("fooba")), "MZXW6YTB")
    assert_eq(base32_encode(bytes.from_string_utf8("foobar")), "MZXW6YTBOI======")
    assert_eq(base32_decode("MZXW6YTBOI======")!.to_string_utf8()!, "foobar")
    assert_eq(base32_raw_encode(bytes.from_string_utf8("foobar")), "MZXW6YTBOI")
    assert_eq(base32_raw_decode("MZXW6YTBOI")!.to_string_utf8()!, "foobar")
    assert_eq(base32_hex_encode(bytes.from_string_utf8("foobar")), "CPNMUOJ1E8======")
    assert_eq(base32_hex_decode("CPNMUOJ1E8======")!.to_string_utf8()!, "foobar")

test "base58 round trips common vectors":
    zeroes := from_hex("00000000000000000000")!
    hello := bytes.from_string_utf8("Hello World!")

    assert_eq(base58_encode(bytes.empty()), "")
    assert_eq(base58_encode(bytes.from_string_utf8(" ")), "Z")
    assert_eq(base58_encode(bytes.from_string_utf8("-")), "n")
    assert_eq(base58_encode(bytes.from_string_utf8("0")), "q")
    assert_eq(base58_encode(bytes.from_string_utf8("1")), "r")
    assert_eq(base58_encode(hello), "2NEpo7TZRRrLZSi2U")
    assert_eq(base58_encode(zeroes), "1111111111")
    assert_eq(base58_decode("2NEpo7TZRRrLZSi2U")!.to_string_utf8()!, "Hello World!")
    assert_eq(base58_decode("1111111111")!.len(), 10)

test "hex round trips bytes and text":
    data := bytes.from_string_utf8("hello")
    hexed := to_hex(data)

    assert_eq(hexed, "68656c6c6f")
    assert_eq(to_hex_upper(data), "68656C6C6F")
    assert_eq(from_hex(hexed)!.to_string_utf8()!, "hello")
    assert_eq(to_hex_string("pith"), "70697468")
    assert_eq(from_hex_utf8("70697468")!, "pith")

test "varints encode and decode unsigned integers":
    one := varint_decode(varint_encode(1)!)!
    multi := varint_decode(varint_encode(300)!)!
    maxish := varint_decode(varint_encode(4294967295)!)!

    assert_eq(to_hex(varint_encode(0)!), "00")
    assert_eq(to_hex(varint_encode(300)!), "ac02")
    assert_eq(one.value, 1)
    assert_eq(one.read, 1)
    assert_eq(multi.value, 300)
    assert_eq(multi.read, 2)
    assert_eq(maxish.value, 4294967295)

test "pem round trips simple blocks":
    block := PemBlock("PITH DATA", {"Version": "1"}, bytes.from_string_utf8("hello"))
    encoded := pem_encode_block(block)
    decoded := pem_decode(encoded)!
    decoded_all := pem_decode_all(encoded + encoded)!

    assert_eq(decoded.kind, "PITH DATA")
    assert_eq(decoded.headers["Version"], "1")
    assert_eq(decoded.body.to_string_utf8()!, "hello")
    assert_eq(decoded_all.len(), 2)
    assert_eq(decoded_all[1].body.to_string_utf8()!, "hello")

test "decoders reject malformed input":
    odd_hex := from_hex("abc")
    bad_hex := from_hex("zz")
    bad_b64_len := b64_decode("abc")
    bad_b64_char := b64_decode("!!!!")
    bad_b64_pad := b64_decode("AA=A")
    bad_b64_lone_pad := b64_decode("A===")
    bad_b64_lead_pad := b64_decode("=AAA")
    bad_b64_early_pad := b64_decode("AA==AAAA")
    bad_b64_over_pad := b64_decode("AAAA====")
    bad_b64_ws := b64_decode("Zm 9v")
    bad_b64_url_char := b64_decode("Zm9-")
    bad_b64_std_char := b64_url_decode("Zm9+")
    bad_b64_raw_pad := b64_raw_decode("Zm9v=")
    bad_b64_raw_len := b64_raw_decode("Z")
    bad_b64_ws_len := b64_decode_ignore_ws("Zm9")
    bad_b32_len := base32_decode("ABC")
    bad_b58_char := base58_decode("0")
    bad_varint_neg := varint_encode(-1)
    bad_varint_truncated := varint_decode(from_hex("80")!)
    bad_pem := pem_decode("-----BEGIN A-----" + chr(10) + "AA==" + chr(10) + "-----END B-----")
    bad_pem_all := pem_decode_all("-----BEGIN A-----" + chr(10) + "AA==" + chr(10) + "-----END B-----")

    assert(odd_hex.is_err)
    assert(bad_hex.is_err)
    assert(bad_b64_len.is_err)
    assert(bad_b64_char.is_err)
    assert(bad_b64_pad.is_err)
    assert(bad_b64_lone_pad.is_err)
    assert(bad_b64_lead_pad.is_err)
    assert(bad_b64_early_pad.is_err)
    assert(bad_b64_over_pad.is_err)
    assert(bad_b64_ws.is_err)
    assert(bad_b64_url_char.is_err)
    assert(bad_b64_std_char.is_err)
    assert(bad_b64_raw_pad.is_err)
    assert(bad_b64_raw_len.is_err)
    assert(bad_b64_ws_len.is_err)
    assert(bad_b32_len.is_err)
    assert(bad_b58_char.is_err)
    assert(bad_varint_neg.is_err)
    assert(bad_varint_truncated.is_err)
    assert(bad_pem.is_err)
    assert(bad_pem_all.is_err)
