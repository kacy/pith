# a body that is right at one type and wrong at another: `t + 1` holds for
# `Int` and fails for `String`. the report names the specialization it was
# found at (`in add_one[String]`), and is made once even though the body is
# walked at both types.

fn add_one[T](t: T) -> T:
    return t + 1

fn main():
    print("{add_one(4)}")
    print(add_one("x"))
