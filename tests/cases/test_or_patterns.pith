# or-patterns: an arm matches when any of its `|`-separated alternatives match.
# alternatives work for literals and qualified enum variants.

fn band(n: Int) -> String:
    match n:
        1 | 2 | 3 => "low"
        4 | 5 | 6 => "mid"
        _ => "high"

fn vowel(s: String) -> String:
    match s:
        "a" | "e" | "i" | "o" | "u" => "vowel"
        _ => "consonant"

enum Color:
    Red
    Green
    Blue

fn warm(c: Color) -> String:
    match c:
        Color.Red | Color.Green => "warmish"
        Color.Blue => "cool"

fn main():
    print(band(2))
    print(band(5))
    print(band(9))
    print(vowel("e"))
    print(vowel("z"))
    print(warm(Color.Red))
    print(warm(Color.Green))
    print(warm(Color.Blue))
