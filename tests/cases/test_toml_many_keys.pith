# a toml document with many keys or many tables parses in linear time.
#
# table lookups used to scan the table's keys, and parsing looks a key up for
# every assignment and every header segment, so parse time grew with the
# square of the key count: 100k keys took over a minute. the regression
# runner's 60 s timeout catches a return of that.

import std.bytes as bytes
import std.toml as toml

fn main() -> Int!:
    keys := bytes.buffer()
    defer keys.free()
    mut i := 0
    while i < 100000:
        keys.write_string_utf8("k" + i.to_string() + " = " + i.to_string() + "\n")!
        i = i + 1
    doc := toml.parse(keys.bytes().to_string_utf8()!)
    print(toml.keys(doc).len().to_string())
    print(toml.get_int(doc, "k0").to_string())
    print(toml.get_int(doc, "k99999").to_string())
    print(toml.has(doc, "k100000").to_string())

    tables := bytes.buffer()
    defer tables.free()
    i = 0
    while i < 150000:
        tables.write_string_utf8("[t" + i.to_string() + ".inner]\nv = " + i.to_string() + "\n")!
        i = i + 1
    nested := toml.parse(tables.bytes().to_string_utf8()!)
    print(toml.keys(nested).len().to_string())
    print(toml.get_int(toml.get_table(toml.get_table(nested, "t149999"), "inner"), "v").to_string())

    # the first of two duplicate keys still wins a lookup
    dup := toml.parse("a = 1\na = 2\n")
    print(toml.get_int(dup, "a").to_string())
    return 0
