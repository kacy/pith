impl Reader for BufferedStringReader:
    fn read(max_bytes: Int) -> String!:
        return buffered_string_reader_read(self, max_bytes)

impl Closer for BufferedStringReader:
    # drop the reader's registry entries, including any buffered text; the
    # source reader is closed by whoever built it. a closed reader reads as
    # end of input; a second close is a no-op.
    fn close():
        close_buffered_text_reader_state(self.handle)

impl BufferedStringWriter:
    fn write(data: String) -> Int!:
        return buffered_string_writer_write(self, data)

    fn write_all(data: String) -> Int!:
        return self.write(data)

    fn flush() -> Int!:
        return buffered_string_writer_flush(self)

