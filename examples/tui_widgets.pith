# the std.term.ui widget gallery: every widget renders to a plain string,
# so a whole dashboard prints deterministically — the same property that
# makes each widget a snapshot test. this file grows as widget layers land.
import std.term.app as app
import std.term.input as input
import std.term.style as style
import std.term.ui as ui

fn main():
    print(ui.block().with_title("wrap").render(ui.wrap("the quick brown fox jumps over the lazy dog", 16)))
    print("")
    bar := ui.progress(20)
    print(ui.block().with_title("sync").render(bar.view(0.4)))
    print("")
    s := ui.spinner()
    s.advance()
    print("working {s.view()}")
    print("")
    print(ui.tabs(["files", "search", "help"], 1, 40))
    bindings := [app.binding(["q"], "q", "quit"), app.binding(["tab"], "tab", "next pane"), app.binding(["/"], "/", "filter")]
    print(ui.help_short(bindings, 60))
    print("")
    print(ui.help_full(bindings, 40))
    print("")
    l := ui.list_view(["alpha", "beta", "gamma", "delta"], 3)
    l.key(input.Key(code: input.KeyCode.Char("j"), mods: 0))
    print(ui.block().with_title("items").render(l.view(12)))
    print("")
    t := ui.table(["name", "qty"], [["apples", "3"], ["日本", "12"], ["pears", "7"]], 3)
    t.key(input.Key(code: input.KeyCode.Char("j"), mods: 0))
    print(t.view())
    print("")
    v := ui.viewport(14, 2)
    v.set_content("line one\nline two\nline three")
    v.scroll_by(1)
    print(ui.block().with_title("scroll {v.percent()}%").render(v.view()))
    print("")
    f := ui.text_input(16)
    for c in "hello":
        f.key(input.Key(code: input.KeyCode.Char(c), mods: 0))
    print(ui.block().with_title("name").render(f.view()))
    print("")
    ta := ui.textarea(16, 3)
    ta.paste("dear reader,\nthe demo types\nitself.")
    print(ui.block().with_title("note").render(ta.view()))
