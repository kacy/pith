# tuples: return a few values together without declaring a struct.
#
# summarizes the durations of a batch of jobs. one helper splits seconds into
# minutes and seconds, another returns the fastest and slowest job at once,
# and a fallible one returns a tuple inside a result.

fn split_minutes(seconds: Int) -> (Int, Int):
    return (seconds / 60, seconds % 60)

fn format_duration(seconds: Int) -> String:
    parts := split_minutes(seconds)
    return "{parts.0}m{parts.1:02}s"

# the fastest and slowest job, as (name, seconds) pairs
fn extremes(jobs: List[(String, Int)]) -> ((String, Int), (String, Int)):
    mut fastest := jobs[0]
    mut slowest := jobs[0]
    for job in jobs:
        if job.1 < fastest.1:
            fastest = job
        if job.1 > slowest.1:
            slowest = job
    return (fastest, slowest)

# the average and the remainder; an empty batch has no average
fn average(jobs: List[(String, Int)]) -> (Int, Int)!:
    if jobs.len() == 0:
        fail "no jobs to average"
    mut total := 0
    for job in jobs:
        total += job.1
    return (total / jobs.len(), total % jobs.len())

fn main():
    jobs := [("backup", 754), ("reindex", 1290), ("thumbnails", 95), ("report", 412)]
    for job in jobs:
        print("{job.0:<11} {format_duration(job.1):>7}")

    ends := extremes(jobs)
    print("fastest: {ends.0.0}, slowest: {ends.1.0}")

    mean := average(jobs) catch (0, 0)
    print("average: {format_duration(mean.0)} (remainder {mean.1})")

    empty := average([]) catch (-1, 0)
    print("average of an empty batch: {empty.0}")
