fn main() -> Int!:
    a: Int? := 5
    b: Int? := 5
    c: Int? := 6
    n1: Int? := none
    n2: Int? := none
    print("int_same:" + (a == b).to_string())
    print("int_diff:" + (a == c).to_string())
    print("both_none:" + (n1 == n2).to_string())
    print("some_vs_none:" + (a == n1).to_string())
    print("int_neq_diff:" + (a != c).to_string())
    print("none_neq_none:" + (n1 != n2).to_string())

    sa: String? := "hi"
    sb: String? := "hi"
    sc: String? := "bye"
    print("str_same:" + (sa == sb).to_string())
    print("str_diff:" + (sa == sc).to_string())

    z1: Int? := 0
    z2: Int? := 0
    print("zero_same:" + (z1 == z2).to_string())
    print("zero_vs_none:" + (z1 == n1).to_string())

    empty_a: String? := ""
    empty_b: String? := ""
    print("empty_same:" + (empty_a == empty_b).to_string())
    print("empty_vs_none:" + (empty_a == none).to_string())
    return 0
