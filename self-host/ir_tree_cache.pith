# ir_tree_cache.pith - cached AST traversals for IR lowering

from ast import get_node
from ir_ast_helpers import ir_is_string_literal_kind, ir_unwrap_pub_child
from ir_utils import ir_encode_int_list, ir_decode_int_list

mut ir_root_items_cache: Map[Int, List[Int]] := {}
mut ir_string_node_cache_roots: List[Int] := []
mut ir_string_node_cache_values: List[String] := []

fn ir_collect_string_nodes(idx: Int) -> List[Int]:
    mut string_nodes: List[Int] := []
    mut stack: List[Int] := [idx]
    while stack.len() > 0:
        current := stack[stack.len() - 1]
        stack.remove(stack.len() - 1)
        node := get_node(current)
        if ir_is_string_literal_kind(node.kind):
            string_nodes.push(current)
        kids := node.children
        for kid in kids:
            stack.push(kid)
    return string_nodes

# every string-literal node under root_idx, so the string table can be
# interned before any function body is emitted. the whole subtree is walked
# on the first ask and the answer kept for later ones — every module being
# emitted re-walks the same preloaded import roots, so the repeat is the
# common case. the walk is stack-based rather than recursive (a deep tree
# used to blow the stack), which means children are visited last-to-first:
# the indices come back in traversal order, not source order.
pub fn ir_cached_string_nodes(root_idx: Int) -> List[Int]:
    for cached_root, i in ir_string_node_cache_roots:
        if cached_root == root_idx:
            return ir_decode_int_list(ir_string_node_cache_values[i])
    nodes := ir_collect_string_nodes(root_idx)
    ir_string_node_cache_roots.push(root_idx)
    ir_string_node_cache_values.push(ir_encode_int_list(nodes))
    return nodes

# the top-level declarations of a module, with any `pub` wrapper stripped
# so a public and a private declaration look alike to the caller. this is
# the standard way to sweep a module — the emitter walks it a dozen times
# over per compile for structs, impls, functions and so on, which is why
# the unwrapped list is cached. the cached list is returned as-is, so treat
# it as read-only.
pub fn ir_root_items(root_idx: Int) -> List[Int]:
    if ir_root_items_cache.contains_key(root_idx):
        return ir_root_items_cache[root_idx]
    root := get_node(root_idx)
    mut items: List[Int] := []
    for child in root.children:
        items.push(ir_unwrap_pub_child(child))
    ir_root_items_cache.insert(root_idx, items)
    return items
