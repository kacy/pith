# qualified variant patterns pick the variant, payload patterns bind their
# fields, a lowercase binding still catches everything, and a guarded arm
# falls through to the arms below it.
enum Color:
    Red
    Green
    Blue

enum Shape:
    Circle(Int)
    Rect(Int, Int)
    Dot

fn code(c: Color) -> Int:
    return match c:
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3

fn area(s: Shape) -> Int:
    return match s:
        Shape.Circle(r) => 3 * r * r
        Shape.Rect(w, h) => w * h
        Shape.Dot => 0

fn first_or_rest(c: Color) -> String:
    return match c:
        Color.Red => "red"
        other => "not red: {code(other)}"

fn bucket(n: Int) -> String:
    return match n:
        _ if n < 0 => "negative"
        m if m > 100 => "big"
        0 => "zero"
        _ => "small"

fn unwrap_or_zero(x: Int?) -> Int:
    return match x:
        v => v
        none => 0

fn main():
    print("{code(Color.Red)} {code(Color.Green)} {code(Color.Blue)}")
    print("{area(Shape.Circle(2))} {area(Shape.Rect(3, 4))} {area(Shape.Dot)}")
    print(first_or_rest(Color.Red))
    print(first_or_rest(Color.Blue))
    print("{bucket(-3)} {bucket(500)} {bucket(0)} {bucket(7)}")
    print("{unwrap_or_zero(9)} {unwrap_or_zero(none)}")
