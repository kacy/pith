# spaces just inside an interpolation's braces are layout, not indentation:
# `{ a + b }` reads as `{a + b}`, around a format spec too. multi-byte
# characters before, between and after interpolations stay whole, and the
# brace escapes \{ and \} write a brace.

fn show(s: String) -> String:
    return "[" + s + "]"

fn main():
    a := 3
    b := 4
    name := "zoë"
    price := 2.5
    m: Map[String, Int] := {"k": 7}
    print("{ a + b }")
    print("{  a  } and { b }")
    print("{ a + b:5}|")
    print("{ price:08.2 }|")
    print("{ m["k"] }")
    print("{ show("x y") }")
    print("{ show("{ a }") }")
    print("{{ a }} { a }")
    print("é{a}↩{b}😀")
    print("{a}é")
    print("{name}é{name}↩")
    print("{a:5}é|{price:08.2}😀")
    print("café { name:>6 }↩ done")
    print("\{literal\} {a} \{ and \}")
    print("tab\there {a}")
