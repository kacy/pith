# std.crypto.ecdh - key agreement helpers
#
# x25519 private keys are runtime handles and are single-use after derive.

import std.bytes as bytes

# an ephemeral x25519 keypair for one key agreement.
pub struct X25519KeyPair:
    pub handle: Int
    pub public_key: Bytes

# generate a fresh x25519 ephemeral key pair.
pub fn x25519_keypair() -> X25519KeyPair!:
    handle := crypto_x25519_keygen()!
    public_key := crypto_x25519_public_key(handle)!
    return X25519KeyPair(handle, public_key)

# generate a fresh p-256 (secp256r1) ephemeral key pair. its public key is the
# 65-byte uncompressed point. the private key remembers its curve, so the same
# shared_secret and close calls serve both curves.
pub fn p256_keypair() -> X25519KeyPair!:
    handle := crypto_p256_keygen()!
    public_key := crypto_x25519_public_key(handle)!
    return X25519KeyPair(handle, public_key)

# generate a fresh p-384 (secp384r1) ephemeral key pair. its public key is the
# 97-byte uncompressed point; the shared secret it derives is 48 bytes.
pub fn p384_keypair() -> X25519KeyPair!:
    handle := crypto_p384_keygen()!
    public_key := crypto_x25519_public_key(handle)!
    return X25519KeyPair(handle, public_key)

# derive a shared secret with a peer public key. this consumes the private key.
# an x25519 peer key is 32 bytes; a p-256 peer key a 65-byte and a p-384 peer
# key a 97-byte uncompressed point. the runtime rejects a peer key that does
# not match the private key's curve.
pub fn x25519_shared_secret(key: X25519KeyPair, peer_public_key: Bytes) -> Bytes!:
    if peer_public_key.len() != 32 and peer_public_key.len() != 65 and peer_public_key.len() != 97:
        fail "ecdh peer public key must be 32, 65, or 97 bytes"
    return crypto_x25519_shared_secret(key.handle, peer_public_key)!

impl X25519KeyPair:
    fn shared_secret(peer_public_key: Bytes) -> Bytes!:
        return x25519_shared_secret(self, peer_public_key)

    fn close():
        crypto_x25519_close(self.handle)

test "p-384 key agreement derives the same 48-byte secret on both ends":
    alice := p384_keypair()!
    bob := p384_keypair()!
    alice_secret := alice.shared_secret(bob.public_key)!
    bob_secret := bob.shared_secret(alice.public_key)!

    assert_eq(alice.public_key.len(), 97)
    assert_eq(alice.public_key[0], 4)
    assert_eq(alice_secret.len(), 48)
    assert(bytes.eq(alice_secret, bob_secret))

test "x25519 derives matching shared secrets":
    alice := x25519_keypair()!
    bob := x25519_keypair()!
    alice_secret := alice.shared_secret(bob.public_key)!
    bob_secret := bob.shared_secret(alice.public_key)!

    assert_eq(alice.public_key.len(), 32)
    assert_eq(bob.public_key.len(), 32)
    assert_eq(alice_secret.len(), 32)
    assert_eq(bob_secret.len(), 32)
    assert(bytes.eq(alice_secret, bob_secret))

test "x25519 rejects malformed peer keys":
    key := x25519_keypair()!
    assert(key.shared_secret(bytes.from_string_utf8("bad")).is_err)
    key.close()

test "p256 derives matching shared secrets":
    alice := p256_keypair()!
    bob := p256_keypair()!
    alice_secret := alice.shared_secret(bob.public_key)!
    bob_secret := bob.shared_secret(alice.public_key)!

    assert_eq(alice.public_key.len(), 65)
    assert_eq(alice.public_key[0], 4)
    assert_eq(alice_secret.len(), 32)
    assert(bytes.eq(alice_secret, bob_secret))
    alice.close()
    bob.close()

test "p256 rejects a peer key from the wrong curve":
    p := p256_keypair()!
    x := x25519_keypair()!
    assert(p.shared_secret(x.public_key).is_err)
    p.close()
    x.close()
