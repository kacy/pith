# std.term.ui — the widget set for terminal applications
#
# widgets render application state as blocks of text: an App's view()
# composes them with std.term.style and hands the result to the runtime.
# display widgets are plain functions from state to string; the module
# grows in layers, and this one carries text, boxes, and indicators —
# wrapped paragraphs with styled spans, titled blocks, progress bars,
# spinners, tab rows, and the help line built from an App's keybindings.
#
#   bar := ui.progress(20)
#   frame := ui.block().with_title("sync").render(bar.view(0.4))
#
# every widget measures in display columns via std.text.width, so cjk text
# and emoji lay out correctly, and every widget renders to a plain string —
# which is why each one is a snapshot test away.
import std.term.app as app
import std.term.input as input
from std.term.input import KeyCode
import std.term.ansi as ansi
import std.term.style as style
import std.text as text
import std.text.width as width

# ---------------------------------------------------------------
# text: spans, wrapping, paragraphs
# ---------------------------------------------------------------

# one styled run of text inside a paragraph.
pub struct Span:
    pub text: String
    pub st: style.Style

# a span with the neutral style.
pub fn span(text: String) -> Span:
    return Span(text: text, st: style.new())

# a span with an explicit style.
pub fn styled(text: String, st: style.Style) -> Span:
    return Span(text: text, st: st)

# word-wrap plain text to `cols` columns: words fill greedily, a word wider
# than the whole line breaks at a character boundary rather than
# overflowing, and width 0 or less gives "". whitespace collapses to
# single spaces — this is paragraph text, not preformatted text.
pub fn wrap(text: String, cols: Int) -> String:
    return paragraph([span(text)], cols)

# word-wrap styled spans to `cols` columns, each word keeping its span's
# style across line breaks. the seams between spans are break
# opportunities like any space; whitespace collapses to single spaces.
pub fn paragraph(spans: List[Span], cols: Int) -> String:
    if cols <= 0:
        return ""
    # flatten to (word, style) pairs, splitting overlong words to fit
    mut words: List[String] := []
    mut word_spans: List[Int] := []
    mut span_index := 0
    for s in spans:
        flat := s.text.replace("\n", " ").replace("\t", " ")
        for w in flat.split(" "):
            if w == "":
                continue
            for piece in split_to_fit(w, cols):
                words.push(piece)
                word_spans.push(span_index)
        span_index = span_index + 1
    # greedy fill
    mut lines: List[String] := []
    mut line: List[String] := []
    mut used := 0
    mut i := 0
    while i < words.len():
        w := words[i]
        wcols := width.of(w)
        mut needed := wcols
        if used > 0:
            needed = wcols + 1
        if used > 0 and used + needed > cols:
            lines.push(line.join(""))
            line = []
            used = 0
            needed = wcols
        if used > 0:
            line.push(" ")
        line.push(render_word(spans, word_spans[i], w))
        used = used + needed
        i = i + 1
    if line.len() > 0:
        lines.push(line.join(""))
    return lines.join("\n")

fn render_word(spans: List[Span], index: Int, w: String) -> String:
    return spans[index].st.render(w)

# split one word into pieces no wider than `cols`, never inside a cluster.
fn split_to_fit(w: String, cols: Int) -> List[String]:
    if width.of(w) <= cols:
        return [w]
    mut pieces: List[String] := []
    mut rest := w
    while width.of(rest) > cols:
        head := width.truncate_to(rest, cols)
        if head.len() == 0:
            # a single cluster wider than the line: emit it anyway rather
            # than looping forever; the terminal will clip it.
            pieces.push(rest)
            return pieces
        pieces.push(head)
        rest = rest.substring(head.len(), rest.len())
    if rest.len() > 0:
        pieces.push(rest)
    return pieces

# ---------------------------------------------------------------
# block: a titled border around content
# ---------------------------------------------------------------

# a bordered box with an optional title on the top edge. sizes to its
# content; use style.place first for a fixed-size box.
pub struct Block:
    pub border_kind: Int
    pub title: String
    pub st: style.Style

# a block with a normal border and no title.
pub fn block() -> Block:
    return Block(border_kind: style.BORDER_NORMAL, title: "", st: style.new())

impl Block:
    # set the title shown on the top edge, truncated to fit.
    fn with_title(t: String) -> Block:
        return Block(border_kind: self.border_kind, title: t, st: self.st)

    # choose the border character set (a style.BORDER_ kind).
    fn with_border(kind: Int) -> Block:
        return Block(border_kind: kind, title: self.title, st: self.st)

    # style applied to the content (the border stays plain).
    fn with_style(s: style.Style) -> Block:
        return Block(border_kind: self.border_kind, title: self.title, st: s)

    # draw the box around content. the title becomes part of the top edge,
    # and the box widens to fit it — a title is part of the box's identity,
    # so it is never cut; constrain the whole block with style.place or a
    # min_width when a fixed size matters.
    fn render(content: String) -> String:
        if self.title == "":
            return self.st.border(self.border_kind).render(content)
        title_w := width.of(self.title)
        boxed := self.st.min_width(title_w + 1).border(self.border_kind).render(content)
        lines := boxed.split("\n")
        top := lines[0]
        inner := width.of(top) - 2
        b := style.border_of(self.border_kind)
        remaining := inner - title_w - 1
        lines[0] = b.tl + b.h + self.title + repeat_edge(b.h, remaining) + b.tr
        return lines.join("\n")

fn repeat_edge(edge: String, count: Int) -> String:
    mut parts: List[String] := []
    mut i := 0
    while i < count:
        parts.push(edge)
        i = i + 1
    return parts.join("")

# ---------------------------------------------------------------
# indicators: progress and spinner
# ---------------------------------------------------------------

# a horizontal progress bar. view(ratio) clamps to 0..1 and fills
# proportionally; show_percent appends the number.
pub struct Progress:
    pub bar_cols: Int
    pub full: String
    pub empty: String
    pub show_percent: Bool

# a progress bar `cols` columns wide with the block-character fill.
pub fn progress(cols: Int) -> Progress:
    return Progress(bar_cols: cols, full: "█", empty: "░", show_percent: true)

impl Progress:
    # the bar at `ratio` full, clamped to 0..1.
    fn view(ratio: Float) -> String:
        mut r := ratio
        if r < 0.0:
            r = 0.0
        if r > 1.0:
            r = 1.0
        filled := ((r * self.bar_cols.to_float()) + 0.5).to_int()
        mut parts: List[String] := []
        mut i := 0
        while i < self.bar_cols:
            if i < filled:
                parts.push(self.full)
            else:
                parts.push(self.empty)
            i = i + 1
        bar := parts.join("")
        if not self.show_percent:
            return bar
        pct := (r * 100.0 + 0.5).to_int()
        return bar + " {pct}%"

# an animated activity marker: hold one in the model, advance() it from an
# every() timer, and render view() into the frame.
pub struct Spinner:
    pub frames: List[String]
    mut frame: Int

# the braille-dot spinner.
pub fn spinner() -> Spinner:
    return Spinner(frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"], frame: 0)

# a spinner with custom frames.
pub fn spinner_with(frames: List[String]) -> Spinner:
    return Spinner(frames: frames, frame: 0)

impl Spinner:
    # step to the next frame, wrapping.
    fn advance():
        if self.frames.len() > 0:
            self.frame = (self.frame + 1) % self.frames.len()

    # the current frame.
    fn view() -> String:
        if self.frames.len() == 0:
            return ""
        return self.frames[self.frame]

# ---------------------------------------------------------------
# tabs and help
# ---------------------------------------------------------------

# one row of tab titles with the active one marked, truncated to `cols`
# with an ellipsis when the row overflows. the active index is state the
# application owns; out-of-range clamps.
pub fn tabs(titles: List[String], active: Int, cols: Int) -> String:
    if titles.len() == 0:
        return ""
    mut idx := active
    if idx < 0:
        idx = 0
    if idx >= titles.len():
        idx = titles.len() - 1
    mut parts: List[String] := []
    mut i := 0
    while i < titles.len():
        if i == idx:
            parts.push("[" + titles[i] + "]")
        else:
            parts.push(" " + titles[i] + " ")
        i = i + 1
    return width.truncate_to_with(parts.join(" "), cols, "…")

# the one-line key help a status bar shows: "q quit • / filter", built
# from an application's bindings and truncated to `cols`.
pub fn help_short(bindings: List[app.Binding], cols: Int) -> String:
    mut parts: List[String] := []
    for b in bindings:
        parts.push(b.help_key + " " + b.help_desc)
    return width.truncate_to_with(parts.join(" • "), cols, "…")

# the full help view: one line per binding, keys right-padded to align the
# descriptions into a column.
pub fn help_full(bindings: List[app.Binding], cols: Int) -> String:
    mut widest := 0
    for b in bindings:
        w := width.of(b.help_key)
        if w > widest:
            widest = w
    mut lines: List[String] := []
    for b in bindings:
        line := width.pad_right(b.help_key, widest) + "  " + b.help_desc
        lines.push(width.truncate_to_with(line, cols, "…"))
    return lines.join("\n")

# -- tests --------------------------------------------------------------

test "wrap fills greedily and breaks overlong words at clusters":
    assert_eq(wrap("the quick brown fox", 10), "the quick\nbrown fox")
    assert_eq(wrap("hi", 10), "hi")
    assert_eq(wrap("", 10), "")
    assert_eq(wrap("abc", 0), "")
    # an overlong word splits at a character boundary
    assert_eq(wrap("abcdefgh", 3), "abc\ndef\ngh")
    # a cjk word splits between characters, never mid-cell
    assert_eq(wrap("日本語です", 4), "日本\n語で\nす")

test "paragraph keeps span styles across line breaks":
    e := chr(27)
    red := style.new().fg(1)
    out := paragraph([styled("alpha beta", red), span("plain")], 5)
    lines := out.split("\n")
    assert_eq(lines.len(), 3)
    # both styled words carry the style, on their own lines
    assert_eq(lines[0], e + "[0;38;5;1malpha" + e + "[0m")
    assert_eq(lines[1], e + "[0;38;5;1mbeta" + e + "[0m")
    assert_eq(lines[2], "plain")

test "block draws a titled border and widens to fit the title":
    b := block().with_title("log")
    out := b.render("hi")
    assert_eq(out, "┌─log┐\n│hi  │\n└────┘")
    # a title wider than the content widens the whole box
    wide := block().with_title("very long title").render("abc")
    parts := wide.split("\n")
    assert_eq(parts[0], "┌─very long title┐")
    assert_eq(width.of(parts[1]), width.of(parts[0]))
    # no title renders the plain border
    assert_eq(block().render("x"), "┌─┐\n│x│\n└─┘")

test "progress clamps fills proportionally and shows percent":
    p := progress(4)
    assert_eq(p.view(0.5), "██░░ 50%")
    assert_eq(p.view(0.0), "░░░░ 0%")
    assert_eq(p.view(1.0), "████ 100%")
    assert_eq(p.view(2.0), "████ 100%")
    assert_eq(p.view(0.0 - 1.0), "░░░░ 0%")
    quiet := Progress(bar_cols: 2, full: "#", empty: "-", show_percent: false)
    assert_eq(quiet.view(0.5), "#-")

test "spinner advances and wraps":
    s := spinner_with(["a", "b", "c"])
    assert_eq(s.view(), "a")
    s.advance()
    assert_eq(s.view(), "b")
    s.advance()
    s.advance()
    assert_eq(s.view(), "a")
    empty := spinner_with([])
    empty.advance()
    assert_eq(empty.view(), "")

test "tabs mark the active title clamp and truncate":
    assert_eq(tabs(["one", "two"], 0, 40), "[one]  two ")
    assert_eq(tabs(["one", "two"], 1, 40), " one  [two]")
    # out-of-range active clamps
    assert_eq(tabs(["one", "two"], 9, 40), " one  [two]")
    empty: List[String] := []
    assert_eq(tabs(empty, 0, 40), "")
    narrow := tabs(["alpha", "beta", "gamma"], 0, 10)
    assert(width.of(narrow) <= 10)
    assert(narrow.contains("…"))

test "help renders the short line and the aligned column":
    bindings := [app.binding(["q"], "q", "quit"), app.binding(["up", "k"], "↑/k", "move up")]
    assert_eq(help_short(bindings, 40), "q quit • ↑/k move up")
    assert(help_short(bindings, 10).contains("…"))
    full := help_full(bindings, 40)
    assert_eq(full, "q    quit\n↑/k  move up")

# ---------------------------------------------------------------
# scrolling components: viewport, list, table
#
# these hold cursor and scroll state, so they are structs the application
# embeds in its model: forward key events with key(), which reports whether
# it consumed the event, and read selection state back after. components
# mutate in place and never produce commands — what a selection means is
# the application's business.
# ---------------------------------------------------------------

# a scrollable window over multi-line content. lines wider than the
# viewport are truncated (no horizontal scroll in this version).
pub struct Viewport:
    pub cols: Int
    pub rows: Int
    pub offset: Int
    mut lines: List[String]

# a viewport of the given size with no content yet.
pub fn viewport(cols: Int, rows: Int) -> Viewport:
    return Viewport(cols: cols, rows: rows, offset: 0, lines: [])

impl Viewport:
    # replace the content, clamping the scroll position into the new bounds.
    fn set_content(s: String):
        self.lines = s.split("\n")
        self.scroll_to(self.offset)

    # scroll so `line` is the top row, clamped into range.
    fn scroll_to(line: Int):
        mut top := line
        limit := self.lines.len() - self.rows
        if top > limit:
            top = limit
        if top < 0:
            top = 0
        self.offset = top

    # scroll by a delta, clamped.
    fn scroll_by(delta: Int):
        self.scroll_to(self.offset + delta)

    fn to_top():
        self.scroll_to(0)

    fn to_bottom():
        self.scroll_to(self.lines.len())

    # is the last content line visible?
    fn at_bottom() -> Bool:
        return self.offset + self.rows >= self.lines.len()

    # scroll position as 0..100, for a status line.
    fn percent() -> Int:
        limit := self.lines.len() - self.rows
        if limit <= 0:
            return 100
        return (self.offset * 100) / limit

    # standard scrolling keys: arrows and j/k by one, pgup/pgdn by a page,
    # home/end to the ends. returns whether the key was consumed.
    fn key(k: input.Key) -> Bool:
        name := input.key_name(k)
        if name == "down" or name == "j":
            self.scroll_by(1)
            return true
        if name == "up" or name == "k":
            self.scroll_by(0 - 1)
            return true
        if name == "pgdn":
            self.scroll_by(self.rows)
            return true
        if name == "pgup":
            self.scroll_by(0 - self.rows)
            return true
        if name == "home":
            self.to_top()
            return true
        if name == "end":
            self.to_bottom()
            return true
        return false

    # exactly `rows` lines, truncated to `cols`, short content padded with
    # blank lines so the block has a stable shape.
    fn view() -> String:
        mut out: List[String] := []
        mut r := 0
        while r < self.rows:
            i := self.offset + r
            mut line := ""
            if i < self.lines.len():
                line = width.truncate_to(self.lines[i], self.cols)
            out.push(line)
            r = r + 1
        return out.join("\n")

# a scrollable, selectable list of items. the cursor line is marked with a
# prefix, and the scroll window follows the cursor.
pub struct ListView:
    mut items: List[String]
    pub cursor: Int
    pub offset: Int
    pub rows: Int
    pub focused: Bool
    pub prefix: String

# a list showing `rows` items at a time, cursor on the first.
pub fn list_view(items: List[String], rows: Int) -> ListView:
    return ListView(items: items, cursor: 0, offset: 0, rows: rows, focused: true, prefix: "> ")

impl ListView:
    # replace the items, clamping cursor and scroll into the new bounds.
    fn set_items(items: List[String]):
        self.items = items
        if self.cursor >= items.len():
            self.cursor = items.len() - 1
        if self.cursor < 0:
            self.cursor = 0
        self.follow()

    # the selected item, or none when the list is empty.
    fn selected() -> String?:
        if self.items.len() == 0:
            return none
        return self.items[self.cursor]

    # the selected index, or none when the list is empty.
    fn selected_index() -> Int?:
        if self.items.len() == 0:
            return none
        return self.cursor

    fn focus():
        self.focused = true

    fn blur():
        self.focused = false

    # cursor movement: arrows and j/k, pgup/pgdn, home/end. returns whether
    # the key was consumed.
    fn key(k: input.Key) -> Bool:
        if self.items.len() == 0:
            return false
        name := input.key_name(k)
        mut target := self.cursor
        if name == "down" or name == "j":
            target = self.cursor + 1
        elif name == "up" or name == "k":
            target = self.cursor - 1
        elif name == "pgdn":
            target = self.cursor + self.rows
        elif name == "pgup":
            target = self.cursor - self.rows
        elif name == "home":
            target = 0
        elif name == "end":
            target = self.items.len() - 1
        else:
            return false
        if target < 0:
            target = 0
        if target >= self.items.len():
            target = self.items.len() - 1
        self.cursor = target
        self.follow()
        return true

    # keep the invariant offset <= cursor < offset + rows.
    fn follow():
        if self.cursor < self.offset:
            self.offset = self.cursor
        if self.cursor >= self.offset + self.rows:
            self.offset = self.cursor - self.rows + 1

    # `rows` lines, the cursor line prefixed (and only when focused), each
    # truncated to `cols`. an empty list renders blank lines.
    fn view(cols: Int) -> String:
        pad := width.of(self.prefix)
        mut out: List[String] := []
        mut r := 0
        while r < self.rows:
            i := self.offset + r
            mut line := ""
            if i < self.items.len():
                if self.focused and i == self.cursor:
                    line = self.prefix + self.items[i]
                else:
                    line = width.pad_left("", pad) + self.items[i]
                line = width.truncate_to(line, cols)
            out.push(line)
            r = r + 1
        return out.join("\n")

# a table with a header row and a selectable body. column widths come from
# the widest cell (display columns, so cjk data aligns), or from
# with_widths; ragged rows render empty cells.
pub struct TableView:
    pub headers: List[String]
    mut rows_data: List[List[String]]
    pub fixed: List[Int]
    pub cursor: Int
    pub offset: Int
    pub body_rows: Int
    pub focused: Bool

# a table showing `body_rows` rows at a time.
pub fn table(headers: List[String], rows_data: List[List[String]], body_rows: Int) -> TableView:
    return TableView(headers: headers, rows_data: rows_data, fixed: [], cursor: 0, offset: 0, body_rows: body_rows, focused: true)

impl TableView:
    # fix column widths instead of sizing to content; 0 keeps auto for that
    # column.
    fn with_widths(w: List[Int]) -> TableView:
        return TableView(headers: self.headers, rows_data: self.rows_data, fixed: w, cursor: self.cursor, offset: self.offset, body_rows: self.body_rows, focused: self.focused)

    # the selected row, or none when the table is empty.
    fn selected_row() -> List[String]?:
        if self.rows_data.len() == 0:
            return none
        return self.rows_data[self.cursor]

    # same cursor keys as a list. returns whether the key was consumed.
    fn key(k: input.Key) -> Bool:
        if self.rows_data.len() == 0:
            return false
        name := input.key_name(k)
        mut target := self.cursor
        if name == "down" or name == "j":
            target = self.cursor + 1
        elif name == "up" or name == "k":
            target = self.cursor - 1
        elif name == "home":
            target = 0
        elif name == "end":
            target = self.rows_data.len() - 1
        else:
            return false
        if target < 0:
            target = 0
        if target >= self.rows_data.len():
            target = self.rows_data.len() - 1
        self.cursor = target
        if self.cursor < self.offset:
            self.offset = self.cursor
        if self.cursor >= self.offset + self.body_rows:
            self.offset = self.cursor - self.body_rows + 1
        return true

    # one cell, padded to its column width; a ragged row reads as empty.
    fn cell(row: List[String], col: Int) -> String:
        if col < row.len():
            return row[col]
        return ""

    # the width of column `col`: fixed if set, else the widest cell.
    fn col_width(col: Int) -> Int:
        if col < self.fixed.len() and self.fixed[col] > 0:
            return self.fixed[col]
        mut widest := width.of(self.cell(self.headers, col))
        for row in self.rows_data:
            w := width.of(self.cell(row, col))
            if w > widest:
                widest = w
        return widest

    # header, then `body_rows` rows with the cursor row marked "> ".
    fn view() -> String:
        cols := self.headers.len()
        mut widths: List[Int] := []
        mut c := 0
        while c < cols:
            widths.push(self.col_width(c))
            c = c + 1
        mut out: List[String] := []
        out.push("  " + render_row(self.headers, widths))
        mut r := 0
        while r < self.body_rows:
            i := self.offset + r
            if i < self.rows_data.len():
                mut mark := "  "
                if self.focused and i == self.cursor:
                    mark = "> "
                out.push(mark + render_row(self.rows_data[i], widths))
            else:
                out.push("")
            r = r + 1
        return out.join("\n")

fn render_row(row: List[String], widths: List[Int]) -> String:
    mut cells: List[String] := []
    mut c := 0
    while c < widths.len():
        mut text := ""
        if c < row.len():
            text = row[c]
        cells.push(width.pad_right(width.truncate_to(text, widths[c]), widths[c]))
        c = c + 1
    return cells.join("  ")

# ---------------------------------------------------------------
# focus
# ---------------------------------------------------------------

# which of n interactive widgets owns the keyboard. the application matches
# on `active` in on_event and forwards keys to exactly one widget; wire
# tab/shift+tab to next()/prev().
pub struct FocusRing:
    pub count: Int
    pub active: Int

# a ring over `count` widgets, the first active.
pub fn focus_ring(count: Int) -> FocusRing:
    return FocusRing(count: count, active: 0)

impl FocusRing:
    fn next():
        if self.count > 0:
            self.active = (self.active + 1) % self.count

    fn prev():
        if self.count > 0:
            self.active = (self.active + self.count - 1) % self.count

fn press_key(name: String) -> input.Key:
    return input.Key(code: input.KeyCode.Char(name), mods: 0)

fn named_key(code: KeyCode) -> input.Key:
    return input.Key(code: code, mods: 0)

test "viewport scrolls clamps and pads to its shape":
    v := viewport(4, 2)
    v.set_content("one\ntwo\nthree\nfour")
    assert_eq(v.view(), "one\ntwo")
    assert(v.key(press_key("j")))
    assert_eq(v.view(), "two\nthre")
    v.to_bottom()
    assert_eq(v.offset, 2)
    assert(v.at_bottom())
    assert_eq(v.percent(), 100)
    v.to_top()
    assert_eq(v.percent(), 0)
    # scrolling past the ends clamps
    v.scroll_by(0 - 5)
    assert_eq(v.offset, 0)
    # short content pads with blank lines
    short := viewport(8, 3)
    short.set_content("only")
    assert_eq(short.view(), "only\n\n")

test "list follows the cursor and reports selection":
    l := list_view(["a", "b", "c", "d"], 2)
    assert_eq(l.selected().unwrap_or(""), "a")
    assert_eq(l.view(10), "> a\n  b")
    assert(l.key(press_key("j")))
    assert(l.key(press_key("j")))
    # the window followed: offset <= cursor < offset + rows
    assert_eq(l.cursor, 2)
    assert_eq(l.offset, 1)
    assert_eq(l.view(10), "  b\n> c")
    l.key(named_key(KeyCode.End))
    assert_eq(l.selected().unwrap_or(""), "d")
    l.key(named_key(KeyCode.Home))
    assert_eq(l.cursor, 0)
    # blurred, the cursor mark disappears
    l.blur()
    assert_eq(l.view(10), "  a\n  b")

test "an empty list selects none and consumes nothing":
    empty: List[String] := []
    l := list_view(empty, 2)
    assert(l.selected() == none)
    assert(l.selected_index() == none)
    assert_eq(l.key(press_key("j")), false)
    assert_eq(l.view(10), "\n")
    # set_items rescues the cursor into the new bounds
    l.set_items(["x"])
    assert_eq(l.selected().unwrap_or(""), "x")

test "table sizes columns by display width and marks the cursor":
    t := table(["name", "qty"], [["apples", "3"], ["日本", "12"], ["z", "1"]], 3)
    out := t.view()
    lines := out.split("\n")
    assert_eq(lines[0], "  name    qty")
    assert_eq(lines[1], "> apples  3  ")
    assert_eq(lines[2], "  日本    12 ")
    # every row is the same visible width — cjk cells pad to equal columns
    assert_eq(width.of(lines[1]), width.of(lines[2]))
    t.key(press_key("j"))
    picked := t.selected_row()
    if let row = picked:
        assert_eq(row[0], "日本")
    else:
        assert(false)

test "table handles ragged rows and fixed widths":
    t := table(["a", "b"], [["one"], ["two", "2"]], 2).with_widths([5, 0])
    lines := t.view().split("\n")
    # the ragged first row renders an empty second cell
    assert_eq(lines[1], "> one     ")
    assert_eq(width.of(lines[1]), width.of(lines[2]))
    empty_rows: List[List[String]] := []
    bare := table(["h"], empty_rows, 1)
    assert(bare.selected_row() == none)
    assert_eq(bare.key(press_key("j")), false)

test "focus ring cycles both directions":
    f := focus_ring(3)
    assert_eq(f.active, 0)
    f.next()
    f.next()
    assert_eq(f.active, 2)
    f.next()
    assert_eq(f.active, 0)
    f.prev()
    assert_eq(f.active, 2)

# ---------------------------------------------------------------
# editors: single-line input and multi-line textarea
#
# both track their cursor in characters and render it in columns, drawn as
# a reverse-video cell — the session hides the hardware cursor. neither
# implements undo, selection, clipboard integration, soft wrap, or word
# motions in this version; each is additive later.
# ---------------------------------------------------------------

# the reverse-video cell that stands in for the cursor.
fn cursor_cell(ch: String) -> String:
    mut shown := ch
    if shown == "":
        shown = " "
    return ansi.sgr(ansi.COLOR_DEFAULT, ansi.COLOR_DEFAULT, ansi.ATTR_REVERSE) + shown + ansi.reset()

# insert `piece` into `s` at character index `at`.
fn insert_at(s: String, at: Int, piece: String) -> String:
    n := text.char_count(s)
    return text.slice(s, 0, at) + piece + text.slice(s, at, n)

# remove one character at index `at`.
fn remove_at(s: String, at: Int) -> String:
    n := text.char_count(s)
    return text.slice(s, 0, at) + text.slice(s, at + 1, n)

# a single-line text field. hold one in the model, forward keys and pastes
# while it is focused, and read value back.
pub struct Input:
    mut value: String
    pub cursor: Int
    pub cols: Int
    pub placeholder: String
    pub focused: Bool
    pub masked: Bool

# an empty input rendered `cols` columns wide.
pub fn text_input(cols: Int) -> Input:
    return Input(value: "", cursor: 0, cols: cols, placeholder: "", focused: true, masked: false)

impl Input:
    # replace the contents, cursor to the end.
    fn set_value(s: String):
        self.value = s
        self.cursor = text.char_count(s)

    fn focus():
        self.focused = true

    fn blur():
        self.focused = false

    # editing keys: printable characters insert at the cursor, backspace
    # and delete remove around it, left/right/home/end move it. returns
    # whether the key was consumed.
    fn key(k: input.Key) -> Bool:
        if k.mods != 0:
            return false
        match k.code:
            KeyCode.Char(c) =>
                self.value = insert_at(self.value, self.cursor, c)
                self.cursor = self.cursor + 1
                return true
            KeyCode.Backspace =>
                if self.cursor > 0:
                    self.value = remove_at(self.value, self.cursor - 1)
                    self.cursor = self.cursor - 1
                return true
            KeyCode.Delete =>
                if self.cursor < text.char_count(self.value):
                    self.value = remove_at(self.value, self.cursor)
                return true
            KeyCode.Left =>
                if self.cursor > 0:
                    self.cursor = self.cursor - 1
                return true
            KeyCode.Right =>
                if self.cursor < text.char_count(self.value):
                    self.cursor = self.cursor + 1
                return true
            KeyCode.Home =>
                self.cursor = 0
                return true
            KeyCode.End =>
                self.cursor = text.char_count(self.value)
                return true
            _ =>
                return false
        return false

    # insert pasted text at the cursor as one edit.
    fn paste(s: String):
        self.value = insert_at(self.value, self.cursor, s)
        self.cursor = self.cursor + text.char_count(s)

    # the field, one line: masked if asked, the placeholder dimly when
    # empty and blurred, the cursor cell drawn only while focused, and a
    # window that keeps the cursor visible when the value overflows.
    fn view() -> String:
        if self.value == "" and not self.focused and self.placeholder != "":
            return width.truncate_to(ansi.sgr(ansi.COLOR_DEFAULT, ansi.COLOR_DEFAULT, ansi.ATTR_DIM) + self.placeholder + ansi.reset(), self.cols + 16)
        mut shown := self.value
        if self.masked:
            shown = strings_repeat_mask(text.char_count(self.value))
        n := text.char_count(shown)
        # window in characters: keep the cursor inside the visible span.
        # character windows approximate column windows well enough for a
        # single line; wide characters shrink the visible span, never hide
        # the cursor.
        mut start := 0
        if self.cursor >= self.cols:
            start = self.cursor - self.cols + 1
        visible := text.slice(shown, start, n)
        cut := width.truncate_to(visible, self.cols)
        if not self.focused:
            return cut
        cur := self.cursor - start
        shown_n := text.char_count(cut)
        before := text.slice(cut, 0, cur)
        at := text.slice(cut, cur, min_int(cur + 1, shown_n))
        after := text.slice(cut, min_int(cur + 1, shown_n), shown_n)
        return before + cursor_cell(at) + after

fn strings_repeat_mask(n: Int) -> String:
    mut parts: List[String] := []
    mut i := 0
    while i < n:
        parts.push("•")
        i = i + 1
    return parts.join("")

fn min_int(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

# a multi-line editor. printable characters insert, enter splits the line,
# backspace at column zero joins with the line above, delete at line end
# joins with the line below, arrows remember the column they want across
# short lines, and the view scrolls to follow the cursor.
pub struct TextArea:
    mut lines: List[String]
    pub row: Int
    pub col: Int
    pub cols: Int
    pub rows: Int
    pub focused: Bool
    mut top: Int
    mut want_col: Int

# an empty textarea of the given size.
pub fn textarea(cols: Int, rows: Int) -> TextArea:
    return TextArea(lines: [""], row: 0, col: 0, cols: cols, rows: rows, focused: true, top: 0, want_col: 0)

impl TextArea:
    # the whole buffer, lines joined with newlines.
    fn value() -> String:
        return self.lines.join("\n")

    # replace the buffer, cursor to the start.
    fn set_value(s: String):
        self.lines = s.split("\n")
        self.row = 0
        self.col = 0
        self.top = 0
        self.want_col = 0

    fn focus():
        self.focused = true

    fn blur():
        self.focused = false

    fn current_line() -> String:
        return self.lines[self.row]

    # editing and movement keys; returns whether the key was consumed.
    fn key(k: input.Key) -> Bool:
        if k.mods != 0:
            return false
        match k.code:
            KeyCode.Char(c) =>
                self.lines[self.row] = insert_at(self.current_line(), self.col, c)
                self.col = self.col + 1
                self.want_col = self.col
            KeyCode.Enter =>
                line := self.current_line()
                n := text.char_count(line)
                self.lines[self.row] = text.slice(line, 0, self.col)
                self.lines.insert(self.row + 1, text.slice(line, self.col, n))
                self.row = self.row + 1
                self.col = 0
                self.want_col = 0
            KeyCode.Backspace =>
                if self.col > 0:
                    self.lines[self.row] = remove_at(self.current_line(), self.col - 1)
                    self.col = self.col - 1
                elif self.row > 0:
                    above := self.lines[self.row - 1]
                    joined := above + self.current_line()
                    self.col = text.char_count(above)
                    self.lines[self.row - 1] = joined
                    self.lines.remove(self.row)
                    self.row = self.row - 1
                self.want_col = self.col
            KeyCode.Delete =>
                line := self.current_line()
                if self.col < text.char_count(line):
                    self.lines[self.row] = remove_at(line, self.col)
                elif self.row + 1 < self.lines.len():
                    self.lines[self.row] = line + self.lines[self.row + 1]
                    self.lines.remove(self.row + 1)
            KeyCode.Left =>
                if self.col > 0:
                    self.col = self.col - 1
                elif self.row > 0:
                    self.row = self.row - 1
                    self.col = text.char_count(self.current_line())
                self.want_col = self.col
            KeyCode.Right =>
                if self.col < text.char_count(self.current_line()):
                    self.col = self.col + 1
                elif self.row + 1 < self.lines.len():
                    self.row = self.row + 1
                    self.col = 0
                self.want_col = self.col
            KeyCode.Up =>
                if self.row > 0:
                    self.row = self.row - 1
                    self.clamp_col()
            KeyCode.Down =>
                if self.row + 1 < self.lines.len():
                    self.row = self.row + 1
                    self.clamp_col()
            KeyCode.PageUp =>
                self.row = max_int(0, self.row - self.rows)
                self.clamp_col()
            KeyCode.PageDown =>
                self.row = min_int(self.lines.len() - 1, self.row + self.rows)
                self.clamp_col()
            KeyCode.Home =>
                self.col = 0
                self.want_col = 0
            KeyCode.End =>
                self.col = text.char_count(self.current_line())
                self.want_col = self.col
            _ =>
                return false
        self.follow_cursor()
        return true

    # after a vertical move, land on the remembered column, clamped to the
    # new line's length.
    fn clamp_col():
        self.col = min_int(self.want_col, text.char_count(self.current_line()))

    # keep the cursor row inside the visible window.
    fn follow_cursor():
        if self.row < self.top:
            self.top = self.row
        if self.row >= self.top + self.rows:
            self.top = self.row - self.rows + 1

    # insert pasted text at the cursor, splitting on its newlines.
    fn paste(s: String):
        pieces := s.split("\n")
        mut i := 0
        while i < pieces.len():
            piece := pieces[i]
            self.lines[self.row] = insert_at(self.current_line(), self.col, piece)
            self.col = self.col + text.char_count(piece)
            if i + 1 < pieces.len():
                line := self.current_line()
                n := text.char_count(line)
                self.lines[self.row] = text.slice(line, 0, self.col)
                self.lines.insert(self.row + 1, text.slice(line, self.col, n))
                self.row = self.row + 1
                self.col = 0
            i = i + 1
        self.want_col = self.col
        self.follow_cursor()

    # `rows` lines with the cursor drawn on its line while focused; each
    # line truncated to `cols`, the cursor line windowed so the cursor
    # stays visible.
    fn view() -> String:
        mut out: List[String] := []
        mut r := 0
        while r < self.rows:
            i := self.top + r
            mut line := ""
            if i < self.lines.len():
                if self.focused and i == self.row:
                    line = self.render_cursor_line()
                else:
                    line = width.truncate_to(self.lines[i], self.cols)
            out.push(line)
            r = r + 1
        return out.join("\n")

    fn render_cursor_line() -> String:
        line := self.current_line()
        n := text.char_count(line)
        mut start := 0
        if self.col >= self.cols:
            start = self.col - self.cols + 1
        visible := text.slice(line, start, n)
        cut := width.truncate_to(visible, self.cols)
        shown_n := text.char_count(cut)
        cur := self.col - start
        before := text.slice(cut, 0, cur)
        at := text.slice(cut, cur, min_int(cur + 1, shown_n))
        after := text.slice(cut, min_int(cur + 1, shown_n), shown_n)
        return before + cursor_cell(at) + after

fn max_int(a: Int, b: Int) -> Int:
    if a > b:
        return a
    return b

fn type_text(field: Input, s: String):
    for c in s:
        field.key(input.Key(code: KeyCode.Char(c), mods: 0))

test "input edits at the cursor and reports its value":
    f := text_input(20)
    type_text(f, "hello")
    assert_eq(f.value, "hello")
    f.key(named_key(KeyCode.Left))
    f.key(named_key(KeyCode.Left))
    f.key(input.Key(code: KeyCode.Char("X"), mods: 0))
    assert_eq(f.value, "helXlo")
    f.key(named_key(KeyCode.Backspace))
    assert_eq(f.value, "hello")
    f.key(named_key(KeyCode.Delete))
    assert_eq(f.value, "helo")
    f.key(named_key(KeyCode.Home))
    f.key(named_key(KeyCode.Delete))
    assert_eq(f.value, "elo")
    f.paste("yy")
    assert_eq(f.value, "yyelo")
    assert_eq(f.cursor, 2)

test "input renders a cursor cell and masks when asked":
    e := chr(27)
    f := text_input(10)
    type_text(f, "ab")
    # the cursor sits after the text, drawn over a space
    assert_eq(f.view(), "ab" + e + "[0;7m " + e + "[0m")
    f.key(named_key(KeyCode.Left))
    assert_eq(f.view(), "a" + e + "[0;7mb" + e + "[0m")
    f.blur()
    assert_eq(f.view(), "ab")
    f.masked = true
    assert_eq(f.view(), "••")

test "input windows long values around the cursor":
    f := text_input(4)
    type_text(f, "abcdefgh")
    # cursor at 8, window starts at 5: shows fgh + cursor space
    shown := f.view()
    plain := strip_test(shown)
    assert_eq(plain, "fgh ")

fn strip_test(s: String) -> String:
    return ansi.strip(s)

test "textarea edits split join and remember the column":
    t := textarea(20, 3)
    type_area(t, "one")
    t.key(named_key(KeyCode.Enter))
    type_area(t, "second")
    assert_eq(t.value(), "one\nsecond")
    # backspace at column zero joins with the line above
    t.key(named_key(KeyCode.Home))
    t.key(named_key(KeyCode.Backspace))
    assert_eq(t.value(), "onesecond")
    assert_eq(t.col, 3)
    # split it again and walk up with a remembered column
    t.key(named_key(KeyCode.Enter))
    assert_eq(t.value(), "one\nsecond")
    t.key(named_key(KeyCode.End))
    t.key(named_key(KeyCode.Up))
    # want_col 6 clamps to "one" length 3
    assert_eq(t.col, 3)
    t.key(named_key(KeyCode.Down))
    assert_eq(t.col, 6)
    # delete at line end joins with the line below
    t.key(named_key(KeyCode.Up))
    t.key(named_key(KeyCode.Delete))
    assert_eq(t.value(), "onesecond")

fn type_area(t: TextArea, s: String):
    for c in s:
        t.key(input.Key(code: KeyCode.Char(c), mods: 0))

test "textarea paste splits lines and the view follows the cursor":
    t := textarea(10, 2)
    t.paste("a\nb\nc\nd")
    assert_eq(t.value(), "a\nb\nc\nd")
    assert_eq(t.row, 3)
    # the window followed to keep row 3 visible in 2 rows
    assert_eq(t.top, 2)
    view := ansi.strip(t.view())
    # the cursor cell renders as a space after the final character
    assert_eq(view, "c\nd ")
    # page up moves by a window and clamps
    t.key(named_key(KeyCode.PageUp))
    t.key(named_key(KeyCode.PageUp))
    assert_eq(t.row, 0)
