# all four grpc call shapes from generated stubs, on one streaming listener.
#
# tools/protogen generated geometry_gen.pith from this proto:
#
#   syntax = "proto3";
#   package geo;
#
#   message Point { int32 x = 1; int32 y = 2; }
#   message Shape { string name = 1; repeated Point vertices = 2; }
#
#   service Geometry {
#     rpc Describe(Point) returns (Shape);
#     rpc Corners(Shape) returns (stream Point);
#     rpc Assemble(stream Point) returns (Shape);
#     rpc Reflect(stream Point) returns (stream Point);
#   }
#
# serve_Geometry_streaming takes a plain (Req) -> Resp handler for the unary
# rpc, and a typed ServerCall for each streaming one: recv() decodes request
# messages as they arrive and send() frames a reply at once. that is what lets
# the Reflect client below read each answer before it sends the next point.
# examples/grpc_chat.pith does the same by hand against grpc.serve_stream.

import geometry_gen as geo
import std.net.grpc as grpc
import std.time as time

PORT := 20529

# unary: a point as a one-vertex shape.
fn describe(req: geo.Point) -> geo.Shape!grpc.GrpcError:
    return geo.Shape(name: "point {show(req)}", vertices: [req])

# server streaming: each vertex goes back as its own message.
fn corners(req: geo.Shape, call: geo.GeometryCornersServerCall) -> Int!grpc.GrpcError:
    for vertex in req.vertices:
        call.send(vertex)
    return 0

# client streaming: gather points until the client half-closes, then reply once.
fn assemble(call: geo.GeometryAssembleServerCall) -> Int!grpc.GrpcError:
    mut points: List[geo.Point] := []
    while true:
        got := call.recv()!
        if got.done:
            break
        points.push(got.message)
    call.send(geo.Shape(name: "polygon", vertices: points))
    return 0

# bidirectional: mirror each point across the diagonal as soon as it arrives.
fn reflect(call: geo.GeometryReflectServerCall) -> Int!grpc.GrpcError:
    while true:
        got := call.recv()!
        if got.done:
            break
        call.send(geo.Point(x: got.message.y, y: got.message.x))
    return 0

fn run_server() -> Int:
    return geo.serve_Geometry_streaming("127.0.0.1", PORT, describe, corners, assemble, reflect) catch 1

fn show(p: geo.Point) -> String:
    return "({p.x}, {p.y})"

fn show_all(points: List[geo.Point]) -> String:
    return points.map(show).join(" ")

# send one point and read its reflection before the next is composed. the
# generated client has no typed per-message recv for a bidi call, so this reads
# through .inner (a grpc.BidiStream); collect() would wait for the whole stream.
fn reflect_one(call: geo.GeometryReflectCall, point: geo.Point) -> geo.Point!grpc.GrpcError:
    call.send(point)
    step := call.inner.recv()!
    if step.done:
        fail grpc.GrpcError(grpc.GRPC_UNAVAILABLE, "stream ended early")
    return geo.decode_Point(step.message) catch:
        fail grpc.GrpcError(grpc.GRPC_INTERNAL, "unreadable Point")

fn run_client(client: geo.GeometryClient) -> Int!grpc.GrpcError:
    print("describe -> " + client.Describe(geo.Point(x: 2, y: 3))!.name)

    triangle := geo.Shape(name: "triangle", vertices: [geo.Point(x: 0, y: 0), geo.Point(x: 4, y: 0), geo.Point(x: 4, y: 3)])
    print("corners  -> " + show_all(client.Corners(triangle)!.collect()!))

    upload := client.Assemble()!
    for i in 1..4:
        upload.send(geo.Point(x: i, y: i * i))
    upload.close_send()
    shape := upload.recv_response()!
    print("assemble -> {shape.name}: " + show_all(shape.vertices))

    mirror := client.Reflect()!
    for point in [geo.Point(x: 1, y: 2), geo.Point(x: 30, y: 40)]:
        print("reflect  -> {show(point)} becomes {show(reflect_one(mirror, point)!)}")
    mirror.close_send()
    if mirror.inner.recv()!.done:
        print("reflect  -> stream closed")
    return 0

# the server starts on its own task, so dial until it is listening.
fn connect() -> grpc.Conn!:
    for attempt in 0..200:
        conn := grpc.dial_h2c("127.0.0.1", PORT) catch:
            time.delay(10)
            continue
        return conn
    fail "no server on port {PORT}"

fn main() -> Int!:
    spawn run_server()
    conn := connect()!
    defer conn.close()
    run_client(geo.new_GeometryClient(conn)) catch:
        fail "geometry calls failed"
    return 0
