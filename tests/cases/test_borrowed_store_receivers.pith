    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: Set[String] := {}
    r.add(src.name)
    r.add(table["k"])
    r.add(xs[0])
    r.add(g_name)
    r.add(p)
    for v in ys:
        r.add(v)
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_set_add")
    print(r.contains(heap("field")).to_string())
    print(r.contains(heap("map_index")).to_string())
    print(r.contains(heap("list_index")).to_string())
    print(r.contains(heap("global")).to_string())
    print(r.contains(heap("param")).to_string())
    print(r.contains(heap("for_var")).to_string())

