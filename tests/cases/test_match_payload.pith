# variant payload destructuring: construction, binding extraction, literal
# sub-patterns, guards, wildcards, and bare variants of a boxed enum.

enum Shape:
    Circle(Float)
    Rectangle(Float, Float)
    Point

enum Event:
    Message(String)
    Code(Int)
    Ping

fn area(s: Shape) -> Float:
    match s:
        Shape.Circle(r) => 3.14 * r * r
        Shape.Rectangle(w, h) => w * h
        Shape.Point => 0.0

fn describe(e: Event) -> String:
    match e:
        Event.Message(text) if text.len() > 5 => "long message: " + text
        Event.Message(text) => "message: " + text
        Event.Code(0) => "zero code"
        Event.Code(n) => "code {n}"
        Event.Ping => "ping"

fn tally(e: Event) -> Int:
    match e:
        Event.Message(_) => 1
        Event.Code(n) => n
        _ => 100

fn main():
    print("circle area = {area(Shape.Circle(2.0))}")
    print("rect area = {area(Shape.Rectangle(3.0, 4.0))}")
    print("point area = {area(Shape.Point)}")
    print(describe(Event.Message("hi")))
    print(describe(Event.Message("hello there")))
    print(describe(Event.Code(0)))
    print(describe(Event.Code(42)))
    print(describe(Event.Ping))
    print("tally msg = {tally(Event.Message("x"))}")
    print("tally code = {tally(Event.Code(7))}")
    print("tally ping = {tally(Event.Ping)}")
    stored := Shape.Rectangle(2.0, 5.0)
    print("stored area = {area(stored)}")
