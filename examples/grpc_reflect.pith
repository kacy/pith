# generated streaming grpc stubs, server and client in one process. the
# messages, the GeometryClient, and serve_Geometry_streaming all come from
# geometry_gen.pith, generated by tools/protogen from this proto:
#
#   syntax = "proto3";
#   package geo;
#
#   message Point {
#     int32 x = 1;
#     int32 y = 2;
#   }
#
#   message Shape {
#     string name = 1;
#     repeated Point vertices = 2;
#   }
#
#   service Geometry {
#     rpc Describe(Point) returns (Shape);
#     rpc Corners(Shape) returns (stream Point);
#     rpc Assemble(stream Point) returns (Shape);
#     rpc Reflect(stream Point) returns (stream Point);
#   }
#
# one listener serves all four rpc shapes: the unary Describe keeps its
# buffered (Req) -> Resp handler, while each streaming rpc drives a typed
# ServerCall — recv() decodes request messages as they arrive, send() frames
# replies immediately. the Reflect turns below interleave (the client reads
# each echo before composing its next point), which the buffered
# serve_Geometry cannot do. compare examples/grpc_chat.pith, the same idea
# hand-written against grpc.serve_stream without generated stubs.

import geometry_gen as geo
import std.net.grpc as grpc
import std.time as time

PORT := 50529

# unary: describe a point as a one-vertex shape.
fn describe(req: geo.Point) -> geo.Shape!grpc.GrpcError:
    return geo.Shape(name: "point({req.x},{req.y})", vertices: [req])

# server-streaming: send each vertex back as its own message.
fn corners(req: geo.Shape, call: geo.GeometryCornersServerCall) -> Int!grpc.GrpcError:
    for v in req.vertices:
        call.send(v)
    return 0

# client-streaming: gather points until the half-close, reply with one shape.
fn assemble(call: geo.GeometryAssembleServerCall) -> Int!grpc.GrpcError:
    mut pts: List[geo.Point] := []
    while true:
        got := call.recv()!
        if got.done:
            break
        pts.push(got.message)
    call.send(geo.Shape(name: "assembled", vertices: pts))
    return 0

# bidi: echo each point mirrored (x and y swapped) the moment it arrives.
fn reflect(call: geo.GeometryReflectServerCall) -> Int!grpc.GrpcError:
    while true:
        got := call.recv()!
        if got.done:
            break
        call.send(geo.Point(x: got.message.y, y: got.message.x))
    return 0

fn run_server():
    geo.serve_Geometry_streaming("127.0.0.1", PORT, describe, corners, assemble, reflect) catch 0

fn show(p: geo.Point) -> String:
    return "({p.x},{p.y})"

# one conversational turn: send a point, then read its mirrored echo before
# the caller composes the next one. per-message reads go through the typed
# handle's .inner (a grpc.BidiStream) — collect() would wait for the whole
# stream instead.
fn turn(call: geo.GeometryReflectCall, p: geo.Point):
    call.send(p)
    step := call.inner.recv()
    if step.is_err or step.ok.done:
        print("reflect ended early")
        return
    echoed := geo.decode_Point(step.ok.message)
    if not echoed.is_err:
        print("reflect " + show(p) + " -> " + show(echoed.ok))

fn main():
    spawn run_server()
    time.delay(400)
    dialed := grpc.dial_h2c("127.0.0.1", PORT)
    if dialed.is_err:
        print("dial failed")
        return
    conn := dialed.ok
    client := geo.new_GeometryClient(conn)

    # unary, through the same streaming listener as everything else
    shape := client.Describe(geo.Point(x: 2, y: 3))
    if not shape.is_err:
        print("describe -> " + shape.ok.name)

    # server-streaming: three vertices come back as three messages
    tri := geo.Shape(name: "tri", vertices: [geo.Point(x: 0, y: 0), geo.Point(x: 4, y: 0), geo.Point(x: 4, y: 3)])
    stream := client.Corners(tri)
    if stream.is_err:
        print("corners open failed")
        return
    pts := stream.ok.collect()
    if not pts.is_err:
        mut joined := ""
        for p in pts.ok:
            joined = joined + show(p) + " "
        print("corners -> " + joined.trim())

    # client-streaming: three sends, one reply after the half-close
    up := client.Assemble()
    if up.is_err:
        print("assemble open failed")
        return
    up.ok.send(geo.Point(x: 1, y: 1))
    up.ok.send(geo.Point(x: 2, y: 2))
    up.ok.send(geo.Point(x: 3, y: 3))
    up.ok.close_send()
    built := up.ok.recv_response()
    if not built.is_err:
        print("assemble -> " + built.ok.name + " with " + built.ok.vertices.len().to_string() + " vertices")

    # bidi, turn by turn: each echo arrives before the next point is sent
    bidi := client.Reflect()
    if bidi.is_err:
        print("reflect open failed")
        return
    call := bidi.ok
    turn(call, geo.Point(x: 1, y: 2))
    turn(call, geo.Point(x: 30, y: 40))
    call.close_send()
    last := call.inner.recv()
    if not last.is_err and last.ok.done:
        print("reflect done")
    conn.close()
