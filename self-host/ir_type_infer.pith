from ir_state import ir_active_fn_bindings, ir_active_generic_concrete_types, ir_active_generic_module_path, ir_active_generic_params, ir_all_module_paths, ir_all_module_roots, ir_assoc_bindings, ir_closure_return_kinds, ir_current_arc_func, ir_current_impl_subst_args, ir_current_impl_subst_params, ir_current_impl_type, ir_current_module_path, ir_enum_payload_kinds, ir_enum_variant_lists, ir_exact_int_arith, ir_func_local_names, ir_func_result_ok_kinds, ir_func_returns, ir_generic_decl_indices, ir_generic_method_owners, ir_global_map_value_types, ir_global_slot_names, ir_impl_method_owner, ir_impl_methods, ir_import_renames, ir_interface_coercion_bypass, ir_interface_decl_index, ir_local_lambda_targets, ir_loop_var_slot, ir_map_value_types, ir_module_aliases, ir_module_count, ir_plain_int_arith, ir_preloaded_import_paths, ir_preloaded_import_roots, ir_result_reg_flag, ir_result_reg_funcs, ir_struct_decl_nodes, ir_struct_field_index_lookup, ir_struct_field_lookup, ir_struct_names, ir_threadlocal_kinds, ir_threadlocal_slots, ir_type_alias_nodes, ir_var_regs
from ir_types import ir_alias_target_node, ir_bytes_keyed_type, ir_checked_index_type, ir_checked_result_kind, ir_checked_type, ir_declared_callable_ir_retkind, ir_declared_callable_return_type, ir_impl_method_key, ir_impl_tid_key, ir_is_declared_callable, ir_known_collection_method_return_type, ir_known_collection_return_type, ir_known_scalar_return_type, ir_known_string_method_return_type, ir_known_struct_return_type, ir_literal_expr_type, ir_lookup_name_type, ir_rc_kind, ir_resolve_assoc_type, ir_resolve_type_hint, ir_retkind, ir_strip_type_args, ir_struct_field_count, ir_struct_field_name_at, ir_struct_field_type_name, ir_struct_layout_name, ir_type_from_tid, ir_unary_expr_type
from ir_symbols import ResolvedCallee, ir_collect_generic_param_names, ir_generic_owner_param_count, ir_has_generic_params, ir_import_declares_global, ir_is_fn_decl_kind, ir_is_generic_function_name, ir_is_generic_method_name, ir_param_name_at, ir_plain_method_name, ir_queue_generic_specialization, ir_queue_generic_specialization_for_tids, ir_resolve_module_alias_method_call_name, ir_resolve_static_callee, ir_resolve_type_node, ir_resolve_type_node_with_subst, ir_specialize_type_name
