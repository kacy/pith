pub struct Box:
    pub a: Int
pub fn boxes(n: Int) -> List[Box]:
    mut out: List[Box] := []
    mut i := 0
    while i < n:
        out.push(Box(a: i))
        i = i + 1
    return out
pub fn sum(xs: List[Box]) -> Int:
    mut total := 0
    for x in xs:
        total = total + x.a
    return total
