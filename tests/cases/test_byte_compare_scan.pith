fn count_marks(s: String) -> Int:
    mut n := 0
    mut i := 0
    while i < s.len():
        if s[i] == ":":
            n = n + 1
        if s[i] != chr(58) and s[i] == chr(44):
            n = n + 100
        if s[i] == s[0]:
            n = n + 1000
        i = i + 1
    return n

fn main():
    print(count_marks("a:b:c,d:e").to_string())
    print(count_marks("").to_string())
    s := "xy"
    ok := s[5] == "x"
    print(ok.to_string())
    print(ord(s[1]).to_string())
