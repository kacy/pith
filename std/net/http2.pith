# std.net.http2 — a minimal http/2 client.
#
# http/2 is a different protocol from http/1.1 (binary framing, multiplexed
# streams, hpack header compression), so this is a separate module from the
# http/1.1 code in std.net.http. it is written entirely in pith on top of the
# native frame codec, hpack, and connection layer under std.net.http2, riding on
# pith's own tls 1.3 with alpn "h2" — no third-party http/2 stack. it is the
# transport a future grpc client sits on: grpc is http/2 plus length-prefixed
# protobuf messages and a `grpc-status` trailer.
#
#   r := http2.get("https://www.cloudflare.com/")!
#   print("status {r.status}, {r.body.len()} bytes")
#
# get() drives a single request on a fresh connection and returns the connection
# layer's Response (status, headers, trailers, body). to multiplex several
# requests over one connection, use the Client in std.net.http2.connection
# (open / open_url / request).

import std.net.http2.connection as connection

# GET an https url over http/2, negotiating alpn "h2". fails when the request
# cannot complete (connection, tls, or protocol error).
pub fn get(url: String) -> connection.Response!:
    return connection.get(url)!
