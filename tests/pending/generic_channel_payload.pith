# PENDING — no issue yet. not registered anywhere; it does not compile.
#
# a channel's payload type has to be written as a bare type name.
# `check_channel_constructor` (self-host/checker.pith) rejects anything whose
# type-argument node is not a plain ident, so every parameterized payload is
# out: a generic instance, and `List[Int]` and `Map[String, Int]` with it.
#
#   Channel[Holder[String]](2)  -> error[E210]: Channel type argument must be
#                                  a type name
#   Channel[Holder](2)          -> error[E202]: unknown type: Holder
#   Channel[List[Int]](2)       -> error[E210]
#
# so it is not a generics restriction as such — no parameterized payload works
# — but it is what a generic value has to route around, and it is not in
# docs/limitations.md. tests/cases/test_generic_boundary.pith carries its
# generic instances through a channel inside a concrete carrier struct because
# of this.

struct Holder[T]:
    pub item: T

fn main():
    ch := Channel[Holder[String]](2)
    ch.send(Holder("sent"))
    received := ch.recv()
    print(received.value().item)

    xs := Channel[List[Int]](2)
    xs.send([1, 2])
    got := xs.recv()
    print("{got.value().len()}")
