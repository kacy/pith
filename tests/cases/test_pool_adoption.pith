# a struct block a thread leaves in its pool is adopted by a later thread.
# the failure that would not show as growth is a block handed to two threads
# at once, or one still referenced after its slot moved on. so every task
# fills structs with values derived from its own seed and reads every one
# back, while the blocks it allocates into were left behind by the tasks
# before it. a wrong value prints a WRONG line, which the expected output
# does not contain.

struct Block:
    pub owner: Int
    pub value: Int
    pub tag: Int

fn fill(seed: Int) -> List[Block]:
    mut cells: List[Block] := []
    mut i := 0
    while i < 200:
        cells.push(Block(owner: seed, value: seed * 1000 + i, tag: 0))
        i = i + 1
    return cells

fn check(cells: List[Block], seed: Int) -> Int:
    mut bad := 0
    mut i := 0
    for c in cells:
        if c.owner != seed or c.value != seed * 1000 + i or c.tag != 0:
            bad = bad + 1
        i = i + 1
    return bad

# a task allocates a batch, checks it, then allocates a second batch while the
# first is still live, so the two cannot share blocks, and checks both.
fn worker(seed: Int) -> Int:
    first := fill(seed)
    mut bad := check(first, seed)
    mut second: List[Block] := []
    mut i := 0
    while i < 200:
        c := Block(owner: seed, value: seed * 1000 + i, tag: 0)
        if c.tag != 0:
            bad = bad + 1
        second.push(c)
        i = i + 1
    bad = bad + check(second, seed)
    return bad

fn main() -> Int:
    mut bad := 0
    mut i := 0
    while i < 60:
        t := spawn worker(i)
        bad = bad + await t
        i = i + 1
    if bad > 0:
        print("WRONG: {bad} corrupted cells")
    print("adopted blocks carried {60} tasks")
    return 0
