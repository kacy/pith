# the elm architecture in std.term.app: a model struct, an event handler
# that maps keys to messages, an update that folds them, and a view.
# app.run() would drive this against a real terminal; here app.drive() runs
# the same cycle over a scripted list of key presses and returns every frame,
# which is why an application built this way is testable in ci, and why this
# example is deterministic.
import std.term.app as app
from std.term.app import App, Cmd
import std.term.input as input
from std.term.input import Event

enum CounterMsg:
    Inc
    Dec
    Reset
    Halt

struct Counter:
    mut count: Int

impl App for Counter:
    type Msg = CounterMsg

    fn init() -> Cmd[CounterMsg]:
        return app.nothing[CounterMsg]()

    fn on_event(ev: Event) -> Cmd[CounterMsg]:
        if let Event.KeyPress(k) = ev:
            if let msg = key_message(input.key_name(k)):
                return self.update(msg)
        return app.nothing[CounterMsg]()

    fn update(msg: CounterMsg) -> Cmd[CounterMsg]:
        match msg:
            CounterMsg.Inc =>
                self.count = self.count + 1
            CounterMsg.Dec =>
                self.count = self.count - 1
            CounterMsg.Reset =>
                self.count = 0
            CounterMsg.Halt =>
                return app.quit[CounterMsg]()
        return app.nothing[CounterMsg]()

    fn view() -> String:
        return "count: {self.count}   (+/- change, r reset, q quit)"

# the keys the counter answers to; any other key is ignored.
fn key_message(name: String) -> CounterMsg?:
    return match name:
        "+" => CounterMsg.Inc
        "-" => CounterMsg.Dec
        "r" => CounterMsg.Reset
        "q" => CounterMsg.Halt
        _ => none

fn press(name: String) -> Event:
    return Event.KeyPress(input.Key(code: input.KeyCode.Char(name), mods: 0))

fn main():
    keys := [press("+"), press("+"), press("+"), press("-"), press("r"), press("+"), press("q")]
    result := app.drive(Counter(count: 0), keys)
    for frame in result.frames:
        print(frame)
    print("quit: {result.quit}")
