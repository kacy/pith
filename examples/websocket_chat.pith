# a chat room relaying messages between websocket sessions over real sockets.
#
# every connection runs on a task of its own. a member's first message is the
# name it joins with, and every later message goes to the whole room: the task
# that read it sends it on every member's session, including sessions other
# tasks accepted. a session's sends take a lock of their own, so two members
# talking at once never mix their frames on a third member's connection.
#
# main plays three clients. they join one at a time, then talk all at once, so
# the order lines arrive in differs between runs; each client sorts what it
# received before printing.

import std.collections as collections
import std.net.tcp as tcp
import std.net.websocket as websocket

PORT := 18112
MEMBERS := 3
LINES_EACH := 2

struct Member:
    id: Int
    name: String
    ws: websocket.WebSocket

# the room, in join order. tasks join and leave at any time, so it sits under
# a lock.
guard room_mu:
    mut members: List[Member] := []

fn join(member: Member):
    locked room_mu:
        members.push(member)

fn leave(id: Int):
    locked room_mu:
        members = members.filter(fn(m: Member) -> Bool => m.id != id)

# send `text` to every member. the list is copied under the lock and the sends
# happen outside it, so a slow connection does not hold up a join or a leave.
# a member whose connection is closing just misses the line.
fn broadcast(text: String):
    mut snapshot: List[Member] := []
    locked room_mu:
        snapshot = collections.copy_list(members)
    for member in snapshot:
        member.ws.send_text(text) catch 0

# one connection, from the handshake to the leave. returns how many lines the
# member said.
fn serve_member(id: Int, fd: Int) -> Int:
    ws := websocket.accept(fd) catch:
        tcp.close(fd)
        return 0
    defer ws.close_now()
    name := ws.recv_text() catch:
        return 0
    join(Member(id: id, name: name, ws: ws))
    broadcast("* {name} joined")
    mut said := 0
    while true:
        # recv_text fails once the client has sent its close frame.
        text := ws.recv_text() catch:
            break
        broadcast("{name}: {text}")
        said += 1
    leave(id)
    broadcast("* {name} left")
    return said

# accept `count` members, each on its own task, and wait for all of them.
fn serve_room(listener: Int, count: Int) -> Int!:
    defer tcp.close(listener)
    mut tasks: List[Task[Int]] := []
    for id in 0..count:
        fd := tcp.accept(listener)!
        tasks.push(spawn serve_member(id, fd))
    mut said := 0
    for t in tasks:
        said += await t
    return said

# a client's view of the room: the joins it saw and the chat lines it got.
struct Seen:
    joins: List[String]
    lines: List[String]

# join as `name` and wait to see our own join, so members join in order.
fn connect(name: String) -> websocket.WebSocket!:
    ws := websocket.dial("127.0.0.1", PORT, "/chat")!
    ws.send_text(name)!
    while true:
        if ws.recv_text()! == "* {name} joined":
            return ws
    return ws

# say our lines, then read until every member's lines have arrived. the joins
# of members who came later arrive first.
fn chat(name: String, ws: websocket.WebSocket, said: List[String]) -> Seen!:
    mut joins := ["* {name} joined"]
    for line in said:
        ws.send_text(line)!
    mut lines: List[String] := []
    while lines.len() < MEMBERS * LINES_EACH:
        text := ws.recv_text()!
        if text.starts_with("* "):
            joins.push(text)
        else:
            lines.push(text)
    ws.close(1000, "bye")!
    return Seen(joins: joins, lines: lines.sort())

# what each member says.
fn script(name: String) -> List[String]:
    if name == "alice":
        return ["hi all", "lunch at noon?"]
    if name == "bob":
        return ["hello", "noon works"]
    return ["hey", "count me in"]

fn main() -> Int!:
    # listen before the server task starts, so a client can dial at once.
    listener := tcp.listen("127.0.0.1", PORT)!
    server := spawn serve_room(listener, MEMBERS)

    names := ["alice", "bob", "carol"]
    mut sessions: List[websocket.WebSocket] := []
    for name in names:
        sessions.push(connect(name)!)

    # every client reads and writes on a task of its own from here.
    mut clients: List[Task[Seen!]] := []
    for name, i in names:
        clients.push(spawn chat(name, sessions[i], script(name)))
    mut transcripts: List[String] := []
    for name, i in names:
        seen := (await clients[i])!
        print("{name} saw {seen.joins.join(", ")}")
        transcripts.push(seen.lines.join("\n"))

    if transcripts[1] == transcripts[0] and transcripts[2] == transcripts[0]:
        print("every member got the same lines:")
        print(transcripts[0])
    else:
        print("the members got different lines")

    said := (await server)!
    print("the room relayed {said} lines")
    return 0
