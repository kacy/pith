fn main() -> Int!:
    xs: List[Int] := [10, 20, 30, 20]
    hit := xs.index_of(20)
    miss := xs.index_of(99)
    print("hit_present:" + (hit != none).to_string())
    print("hit_value:" + hit.unwrap_or(-1).to_string())
    print("miss_none:" + (miss == none).to_string())

    xs_first: List[Int] := [0, 1, 2]
    zero_hit := xs_first.index_of(0)
    print("zero_present:" + (zero_hit != none).to_string())
    print("zero_value:" + zero_hit.unwrap_or(-1).to_string())

    empty: List[Int] := []
    print("empty_none:" + (empty.index_of(5) == none).to_string())

    strs: List[String] := ["a", "b", "c"]
    print("str_hit:" + strs.index_of("b").unwrap_or(-1).to_string())
    print("str_miss_none:" + (strs.index_of("z") == none).to_string())
    return 0
