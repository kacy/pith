# helper for test_generic_enum_name_clash: one of two modules that each
# declare the generic enum Opt.
pub enum Opt[T]:
    Some(T)
    Nothing

pub fn some_a(v: Int) -> Opt[Int]:
    return Opt.Some(v)

pub fn read_a(o: Opt[Int]) -> String:
    match o:
        Opt.Some(n) => "a some {n}"
        Opt.Nothing => "a nothing"

pub fn wrap_a[T](v: T) -> Opt[T]:
    return Opt.Some(v)

pub fn none_a() -> Opt[Int]:
    return Opt.Nothing
