# clash_event_b — a different Event, same name, unrelated fields.
# the reader below imports this module after clash_event_a. under the old
# single global type table, this second registration overwrote the shared
# "Event" entry and hijacked references to clash_event_a's Event.
pub struct Event:
    pub topic: String
    pub payload: String

pub fn published(topic: String, payload: String) -> Event:
    return Event(topic, payload)
