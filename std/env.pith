## std.env — environment variable and argument access
##
## Functions:
##   get(key: String) -> String?   Get environment variable, or none when unset
##   get_args() -> List[String]    Get command-line arguments

## get an environment variable by name.
## returns Some(value) when set, none when the variable is not set.
pub fn get(key: String) -> String?:
    return env_opt(key)

## Get the command-line arguments as a list of strings
pub fn get_args() -> List[String]:
    return args()

test "env reads missing keys as none":
    assert(get("PITH_STD_ENV_TEST_MISSING_KEY") == none)

test "env exposes process arguments":
    values := get_args()

    assert(values.len() > 0)
