# std.net.tls — tls client and server streams
#
# the api borrows the same shape as go's crypto/tls: configs are reusable,
# conns read and write bytes, and dial/listen are convenience helpers.

import std.bytes as bytes
import std.binary as binary
import std.crypto.ecdh as ecdh
import std.crypto.random as random
import std.crypto.signature as signature
import std.crypto.subtle as subtle
import std.crypto.x509 as x509
import std.encoding as encoding
import std.io as io
import std.net.tls12 as tls12
import std.net.tls13 as tls13
import std.os.certs as os_certs
import std.time as time
from std.io import TcpStream

# the config registry: a config is a plain Int handle, and everything it holds
# lives in these handle-keyed maps. handle allocators come first. valid handles
# are non-negative (error paths fail with a
# Result, they don't hand back a config); the two ranges are kept apart — configs
# from 0, connections from a high base — so a handle reads unambiguously in a
# trace. they count up so every handle stays non-negative. (these start values
# used to be negative literals that a module-const compiler bug silently zeroed,
# which is why the first handle landed at 0; now the intended values are honored.)
mut next_native_config_handle := 0
mut next_native_conn_handle := 1000000
mut native_config_roots_pem: Map[Int, String] := {}
mut native_config_alpn: Map[Int, List[String]] := {}
mut native_config_resumption_enabled: Map[Int, Bool] := {}
mut native_config_require_tls13: Map[Int, Bool] := {}
mut native_client_cert_pem: Map[Int, String] := {}
mut native_client_key_der: Map[Int, Bytes] := {}
mut native_server_cert_pem: Map[Int, String] := {}
mut native_server_key_der: Map[Int, Bytes] := {}
mut native_server_client_ca_pem: Map[Int, String] := {}
mut native_server_client_ca_optional: Map[Int, Bool] := {}
mut native_listener_config: Map[Int, Int] := {}

# guards the whole config registry above, the two hook maps declared further
# down, the handle counter, and the root bundle caches below. the registry is
# not startup-only state: an https client builds a fresh config for every
# request (see std.net.http), so one task is allocating a handle and inserting
# while another is mid-handshake reading the same maps and a third is removing
# from them in Config.close(). two tasks that read the counter together would
# also land on the same handle and share a registry slot, so a handshake could
# pick up another config's certificate and key. the lock only ever spans a
# single map operation — pem parsing, certificate verification, and the
# user-supplied config hooks all run off it.
mut native_config_mu := Mutex()

# the registry accessors. each takes native_config_mu for one map operation and
# hands the value back to the caller, so nothing outside them touches a registry
# map. they are generic over the value type because the registry is a dozen maps
# of eight value types that all share this access shape.
fn config_has[V](values: Map[Int, V], handle: Int) -> Bool:
    native_config_mu.lock()
    found := values.contains_key(handle)
    native_config_mu.unlock()
    return found

fn config_get[V](values: Map[Int, V], handle: Int, fallback: V) -> V:
    native_config_mu.lock()
    mut out := fallback
    if values.contains_key(handle):
        out = values[handle]
    native_config_mu.unlock()
    return out

fn config_put[V](values: Map[Int, V], handle: Int, value: V):
    native_config_mu.lock()
    values.insert(handle, value)
    native_config_mu.unlock()

fn config_drop[V](values: Map[Int, V], handle: Int):
    native_config_mu.lock()
    if values.contains_key(handle):
        values.remove(handle)
    native_config_mu.unlock()

fn config_len[V](values: Map[Int, V]) -> Int:
    native_config_mu.lock()
    n := values.len()
    native_config_mu.unlock()
    return n

# the root bundle caches, guarded by native_config_mu like the registry above.
#
# a client config's trust anchors are the most expensive thing about it. the
# system bundle is ~220KB of pem holding ~150 certificates, and before these
# caches existed every client_config() re-read that file, re-parsed it, and
# handed each config its own copy of the text — then every handshake parsed it a
# second time to verify the peer chain. an https request therefore paid for two
# full bundle parses before it sent a byte, and each live config pinned another
# copy of the pem. measured on a 220KB bundle that was about a quarter second of
# cpu and about a megabyte of memory per request.
#
# both caches are keyed on content, not on a config handle, so configs that
# trust the same roots share one entry no matter how many of them exist or when
# they are closed. entries are never evicted — a parsed root bundle is valid for
# as long as the process runs — so a reader can hold one without a lock and a
# closing config never invalidates another config's roots. the cap is what keeps
# that bounded: a program trusting more than this many distinct bundles keeps
# working, it just parses the ones that did not fit.
TLS_MAX_ROOTS_CACHE := 8
mut native_system_roots_pem := ""
mut native_roots_parsed: Map[String, List[x509.Certificate]] := {}

# hand out the next config handle, one per caller.
fn next_config_handle() -> Int:
    native_config_mu.lock()
    handle := next_native_config_handle
    next_native_config_handle = next_native_config_handle + 1
    native_config_mu.unlock()
    return handle

# how many server handshakes have failed since the process started. a failed
# handshake is normal traffic — probes, scanners, clients that hang up — so a
# server drops it silently rather than logging a line an attacker could use to
# fill the disk. the counter is what makes it observable: read it from a metric
# or a status endpoint and watch the rate. see server_handshake_failures().
mut server_handshake_failure_count := AtomicInt(0)

# per-connection tls state was 12 module-global maps keyed by conn handle,
# raced by two connections doing i/o at once. it now lives in one
# NativeConnState struct in a single mutex-guarded map (defined just after
# ConnectionState below).
TLS_CONTENT_CHANGE_CIPHER_SPEC := 20
TLS_CONTENT_ALERT := 21
TLS_CONTENT_HANDSHAKE := 22
TLS_CONTENT_APPLICATION_DATA := 23

# a read deadline for an accepted server connection. without it a client can
# open a tls connection and then send nothing (or dribble ChangeCipherSpec /
# handshake records slowly), pinning the pre-auth handshake indefinitely. the
# deadline bounds the whole handshake — and the connection's later reads — to a
# wall-clock window. it is not a substitute for running the handshake off the
# accept loop: see accept_socket() and handshake() below.
SERVER_HANDSHAKE_TIMEOUT_MS := 10000
TLS_HANDSHAKE_CLIENT_HELLO := 1
TLS_HANDSHAKE_SERVER_HELLO := 2
TLS_HANDSHAKE_NEW_SESSION_TICKET := 4
TLS_HANDSHAKE_ENCRYPTED_EXTENSIONS := 8
TLS_HANDSHAKE_CERTIFICATE := 11
TLS_HANDSHAKE_CERTIFICATE_REQUEST := 13
TLS_HANDSHAKE_CERTIFICATE_VERIFY := 15
TLS_HANDSHAKE_FINISHED := 20
TLS_VERSION_13 := 772
TLS_VERSION_12 := 771
TLS_CIPHER_AES_128_GCM_SHA256 := 4865
TLS_CIPHER_CHACHA20_POLY1305_SHA256 := 4867
TLS_SIG_RSA_PSS_RSAE_SHA256 := 2052
TLS_SIG_RSA_PKCS1_SHA256 := 1025
TLS_SIG_ECDSA_SECP256R1_SHA256 := 1027
OID_EC_PUBLIC_KEY := "1.2.840.10045.2.1"
TLS_GROUP_X25519 := 29
TLS_GROUP_SECP256R1 := 23
TLS_MAX_PLAINTEXT_RECORD := 16384
TLS_MAX_HANDSHAKE_FLIGHT := 65536
TLS_SESSION_TICKET_LIFETIME := 86400
TLS_MAX_SERVER_SESSION_TICKETS := 64
TLS_MAX_CLIENT_SESSION_CACHE := 32

struct SessionTicketEntry:
    config_handle: Int
    cipher: Int
    psk: Bytes
    alpn_protocol: String
    issued_at_ms: Int
    lifetime_ms: Int

# summary view of one peer certificate.
pub struct PeerCertificate:
    pub subject_common_name: String
    pub issuer_common_name: String
    pub serial_hex: String
    pub not_before: String
    pub not_after: String
    pub dns_names: List[String]
    pub ip_addresses: List[String]
    pub is_ca: Bool

struct CachedSession:
    ticket: Bytes
    psk: Bytes
    cipher: Int
    alpn_protocol: String
    peer_common_name: String
    peer_issuer_common_name: String
    peer_serial_hex: String
    peer_not_before: String
    peer_not_after: String
    peer_dns_names: List[String]
    peer_ip_addresses: List[String]
    peer_certificate_count: Int
    peer_certificates: List[PeerCertificate]
    expires_at_ms: Int

mut native_server_session_tickets: Map[String, SessionTicketEntry] := {}
mut native_client_session_cache: Map[String, CachedSession] := {}
mut native_server_session_ticket_order: List[String] := []
mut native_client_session_cache_order: List[String] := []

# one lock covers all four session stores above. each map moves together with
# its lru order list, so any access has to hold the lock for the whole
# operation, not just the map half. concurrent handshakes are the normal case:
# clients dial from many tasks at once, and a server runs each handshake in its
# own spawned task. every critical section is a handful of in-memory map and
# list operations on stores capped at TLS_MAX_* entries — never network i/o —
# so a single shared lock costs nothing measurable and skips the question of
# lock ordering that two locks would raise.
#
# the mutex is not reentrant: relocking from the holder deadlocks. helpers that
# expect the lock to be held already carry a _locked suffix and must never call
# back into the locking wrappers.
mut native_session_mu := Mutex()

# reusable tls configuration.
pub struct Config:
    pub handle: Int

# a tls connection.
pub struct Conn:
    pub handle: Int

# summary of one negotiated tls connection.
pub struct ConnectionState:
    pub version: Int
    pub cipher_suite: Int
    pub negotiated_protocol: String
    pub did_resume: Bool
    pub peer_common_name: String
    pub peer_issuer_common_name: String
    pub peer_serial_hex: String
    pub peer_not_before: String
    pub peer_not_after: String
    pub peer_dns_names: List[String]
    pub peer_ip_addresses: List[String]
    pub peer_certificate_count: Int
    pub peer_certificates: List[PeerCertificate]
    pub peer_chain_present: Bool
    pub client_auth_requested: Bool
    pub client_auth_verified: Bool

# per-connection native tls state. the record sequence numbers feed the AEAD
# nonce, and reusing a nonce under one key is catastrophic for GCM (it leaks the
# authentication key), so each direction's read-seal-write / read-open-advance
# must be atomic against a second caller on the same direction. write_mu and
# read_mu serialize those spans; a single Conn shared across tasks is therefore
# safe, and `failed` fences a connection off once a record operation errors so a
# retry cannot reseal at a sequence a partial record already consumed.
struct NativeConnState:
    fd: Int
    cipher: Int
    mut read_key: Bytes
    mut read_iv: Bytes
    mut write_key: Bytes
    mut write_iv: Bytes
    mut read_seq: Int
    mut write_seq: Int
    mut pending: Bytes
    cache_key: String
    resumption_master_secret: Bytes
    state: ConnectionState
    version: Int
    write_mu: Mutex
    read_mu: Mutex
    mut failed: Bool
    # the current application traffic secrets, kept so a 1.3 KeyUpdate can
    # derive the next generation of keys. empty on a 1.2 connection, which has
    # no KeyUpdate.
    mut read_secret: Bytes
    mut write_secret: Bytes

mut native_conn_mu := Mutex()
mut native_conn_states: Map[Int, NativeConnState] := {}

# register a new connection's state and return its handle. the counter bump and
# the insert run under the lock so concurrent handshakes can't collide.
fn native_conn_register(state: NativeConnState) -> Int:
    native_conn_mu.lock()
    handle := next_native_conn_handle
    next_native_conn_handle = next_native_conn_handle + 1
    native_conn_states.insert(handle, state)
    native_conn_mu.unlock()
    return handle

# fetch a connection's state struct. it is a reference, so mutating its read_seq
# / write_seq / pending persists; the lock guards only the map lookup.
fn native_conn_get(handle: Int) -> NativeConnState:
    native_conn_mu.lock()
    state := native_conn_states[handle]
    native_conn_mu.unlock()
    return state

fn native_conn_has(handle: Int) -> Bool:
    native_conn_mu.lock()
    present := native_conn_states.contains_key(handle)
    native_conn_mu.unlock()
    return present

fn native_conn_drop(handle: Int):
    native_conn_mu.lock()
    if native_conn_states.contains_key(handle):
        native_conn_states.remove(handle)
    native_conn_mu.unlock()

# parsed client hello data used for server-side config selection.
pub struct ClientHelloInfo:
    pub server_name: String
    pub alpn_protocols: List[String]

# internal callback context shared by tls config hooks.
struct ConfigHookContext:
    kind: String
    state: ConnectionState
    client_hello: ClientHelloInfo

# internal callback result shared by tls config hooks.
struct ConfigHookResult:
    selected_config: Config
    reason: String

struct PeerIdentity:
    common_name: String
    issuer_common_name: String
    serial_hex: String
    not_before: String
    not_after: String
    dns_names: List[String]
    ip_addresses: List[String]
    certificate_count: Int
    certificates: List[PeerCertificate]
    chain_present: Bool

struct ServerResumptionDecision:
    did_resume: Bool
    cipher: Int
    psk: Bytes

# a tls listener.
pub struct Listener:
    pub handle: Int

# the config hooks, guarded by native_config_mu like the rest of the registry.
mut native_config_verify_connection: Map[Int, fn(ConfigHookContext) -> ConfigHookResult] := {}
mut native_server_config_selector: Map[Int, fn(ConfigHookContext) -> ConfigHookResult] := {}

# the value config_get falls back to when a config has no hook installed: it
# approves the connection and selects nothing. the callers check first and only
# reach this if the hook was removed in between, so the selected config is the
# negative handle no config can have rather than 0, which in a server-only
# program is a real server config the selector must not be able to land on.
fn no_config_hook(ctx: ConfigHookContext) -> ConfigHookResult:
    return ConfigHookResult(Config(0 - 1), "")

# parse a root bundle, reusing the parse when the same pem text has been seen.
#
# the lock is only ever held for a map operation; the parse itself runs off it,
# so two tasks that miss together both parse and one of them stores. that is
# wasted work on a cold start, never a wrong answer: parsing is pure, so the two
# results are equal and it does not matter which one wins. the alternative —
# holding the lock across the parse — would serialize every config creation in
# the process behind a quarter-second parse.
fn parse_roots_cached(roots_pem: String) -> List[x509.Certificate]!:
    native_config_mu.lock()
    hit := native_roots_parsed.contains_key(roots_pem)
    mut cached: List[x509.Certificate] := []
    if hit:
        cached = native_roots_parsed[roots_pem]
    native_config_mu.unlock()
    if hit:
        return cached
    parsed := x509.parse_pem_chain(roots_pem)!
    native_config_mu.lock()
    if not native_roots_parsed.contains_key(roots_pem) and native_roots_parsed.len() < TLS_MAX_ROOTS_CACHE:
        native_roots_parsed.insert(roots_pem, parsed)
    native_config_mu.unlock()
    return parsed

# the system root bundle as pem text, read from disk at most once.
#
# every caller gets the same string rather than its own copy of it, so the
# hundreds of configs an https client builds over a process lifetime pin one
# bundle between them instead of one each.
#
# the fill deliberately does not hold the lock across the read and the parse.
# it loads into a local first and then takes the lock once to decide the winner,
# so there is never a window where the global is published but not yet filled —
# a shape that has been a real bug in this registry before. two tasks racing a
# cold start both read the file and one of them wins; both return the winner, so
# every config still shares a single copy.
fn system_roots_pem() -> String!:
    native_config_mu.lock()
    cached := native_system_roots_pem
    native_config_mu.unlock()
    if cached != "":
        return cached
    loaded := os_certs.roots_pem()!
    # parse here so a broken system bundle fails config creation, and so the
    # first config warms the parse cache for every later one.
    parse_roots_cached(loaded)!
    native_config_mu.lock()
    if native_system_roots_pem == "":
        native_system_roots_pem = loaded
    winner := native_system_roots_pem
    native_config_mu.unlock()
    return winner

fn native_config_handle(roots_pem: String) -> Config!:
    if roots_pem == "":
        fail "tls root certificates not found"
    # parse once here so config creation fails early for bad pem data. the
    # parse is cached, so a second config over the same roots pays a lookup.
    parse_roots_cached(roots_pem)!
    handle := next_config_handle()
    config_put(native_config_roots_pem, handle, roots_pem)
    return Config(handle)

fn native_server_config_handle(cert_pem: String, key_pem: String) -> Config!:
    certs := x509.parse_pem_chain(cert_pem)!
    if certs.len() == 0:
        fail "tls certificate chain is empty"
    key := encoding.pem_decode(key_pem)!
    if key.kind != "PRIVATE KEY":
        fail "tls private key must be pkcs#8 pem"
    handle := next_config_handle()
    config_put(native_server_cert_pem, handle, cert_pem)
    config_put(native_server_key_der, handle, key.body)
    return Config(handle)

fn config_alpn_protocols(config: Config) -> List[String]:
    none_offered: List[String] := []
    return config_get(native_config_alpn, config.handle, none_offered)

fn config_alpn_key(config: Config) -> String:
    protocols := config_alpn_protocols(config)
    if protocols.len() == 0:
        return ""
    return protocols.join(",")

fn config_session_cache_key(config: Config, server_name: String) -> String:
    return config.handle.to_string() + "|" + server_name + "|" + config_alpn_key(config)

fn config_has_client_certificate(config: Config) -> Bool:
    return config_has(native_client_cert_pem, config.handle) and config_has(native_client_key_der, config.handle)

fn config_requires_client_certificate(config: Config) -> Bool:
    # a config with client ca roots requires a certificate unless it was
    # installed as optional; an absent flag reads as required.
    return config_has(native_server_client_ca_pem, config.handle) and not config_get(native_server_client_ca_optional, config.handle, false)

fn config_requests_client_certificate(config: Config) -> Bool:
    return config_has(native_server_client_ca_pem, config.handle)

fn config_resumption_enabled(config: Config) -> Bool:
    return config_get(native_config_resumption_enabled, config.handle, false)

# true when this config may negotiate the TLS 1.2 fallback (the default);
# require_tls13() turns it off.
fn config_offers_tls12(config: Config) -> Bool:
    return not config_get(native_config_require_tls13, config.handle, false)

fn native_config_client_cert_chain(config: Config) -> List[Bytes]!:
    cert_pem := config_get(native_client_cert_pem, config.handle, "")
    if cert_pem == "":
        fail "native tls client certificate not found"
    blocks := encoding.pem_decode_all(cert_pem)!
    certs: List[Bytes] := []
    for block in blocks:
        if block.kind == "CERTIFICATE":
            certs.push(block.body)
    if certs.len() == 0:
        fail "tls client certificate chain is empty"
    return certs

fn native_client_private_key(config: Config) -> Bytes!:
    key := config_get(native_client_key_der, config.handle, bytes.empty())
    if key.len() == 0:
        fail "native tls client key not found"
    return key

fn native_config_roots(config: Config) -> List[x509.Certificate]!:
    roots_pem := config_get(native_config_roots_pem, config.handle, "")
    if roots_pem == "":
        fail "native tls client config not found"
    return parse_roots_cached(roots_pem)!

fn is_native_config(config: Config) -> Bool:
    return config_has(native_config_roots_pem, config.handle)

fn is_native_server_config(config: Config) -> Bool:
    return config_has(native_server_cert_pem, config.handle)

fn is_native_conn(handle: Int) -> Bool:
    return native_conn_has(handle)

fn native_server_certificate_chain(config: Config) -> List[Bytes]!:
    cert_pem := config_get(native_server_cert_pem, config.handle, "")
    if cert_pem == "":
        fail "native tls server config not found"
    blocks := encoding.pem_decode_all(cert_pem)!
    certs: List[Bytes] := []
    for block in blocks:
        if block.kind == "CERTIFICATE":
            certs.push(block.body)
    if certs.len() == 0:
        fail "tls certificate chain is empty"
    return certs

fn native_server_private_key(config: Config) -> Bytes!:
    key := config_get(native_server_key_der, config.handle, bytes.empty())
    if key.len() == 0:
        fail "native tls server key not found"
    return key

fn checked_read(result: Int!binary.BinaryError) -> Int!:
    if result.is_err:
        fail result.err.message
    return result.ok

fn checked_write(result: Int!binary.BinaryError) -> Int!:
    if result.is_err:
        fail result.err.message
    return result.ok

fn write_u8(out: ByteBuffer, value: Int) -> Bool!:
    checked_write(binary.write_u8(out, value))!
    return true

fn write_u16_be(out: ByteBuffer, value: Int) -> Bool!:
    checked_write(binary.write_u16_be(out, value))!
    return true

fn native_read_record(stream: TcpStream) -> tls13.Record!:
    header := stream.read_exact_bytes(5)!
    if header.len() != 5:
        fail "truncated tls record header"
    length := checked_read(binary.read_u16_be_at(header, 3))!
    # bound the record before reading its body so a hostile peer cannot make us
    # buffer up to 64 kib per record (rfc 8446 §5.2 caps ciphertext at 2^14+256).
    if length > tls13.MAX_CIPHERTEXT_RECORD:
        fail "tls record overflow"
    payload := stream.read_exact_bytes(length)!
    if payload.len() != length:
        fail "truncated tls record payload"
    return tls13.decode_record(header.concat(payload))!

fn native_write_all(stream: TcpStream, data: Bytes) -> Int!:
    return stream.write_all_bytes(data)

fn transcript_append(transcript: ByteBuffer, message: tls13.HandshakeMessage) -> Bool!:
    encoded := tls13.encode_handshake(message.message_type, message.body)!
    if encoded.len() > 0:
        transcript.write(encoded)!
    return true

fn traffic_keys_for_cipher(cipher: Int, secret: Bytes) -> tls13.TrafficKeys!:
    if cipher == TLS_CIPHER_AES_128_GCM_SHA256:
        return tls13.traffic_keys_aes_128_gcm_sha256(secret)
    if cipher == TLS_CIPHER_CHACHA20_POLY1305_SHA256:
        return tls13.traffic_keys_chacha20_poly1305_sha256(secret)
    fail "unsupported tls cipher suite"

# return a small printable tls version label for connection state.
pub fn version_name(version: Int) -> String:
    if version == 772:
        return "tls1.3"
    if version == 771:
        return "tls1.2"
    return "unknown"

# return a printable cipher suite label for connection state.
pub fn cipher_suite_name(cipher: Int) -> String:
    if cipher == TLS_CIPHER_AES_128_GCM_SHA256:
        return "TLS_AES_128_GCM_SHA256"
    if cipher == TLS_CIPHER_CHACHA20_POLY1305_SHA256:
        return "TLS_CHACHA20_POLY1305_SHA256"
    if cipher == tls12.TLS12_ECDHE_ECDSA_AES128_GCM_SHA256:
        return "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
    if cipher == tls12.TLS12_ECDHE_RSA_AES128_GCM_SHA256:
        return "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
    if cipher == tls12.TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256:
        return "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256"
    if cipher == tls12.TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256:
        return "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"
    return "unknown"

fn select_cipher(client: tls13.ClientHello) -> Int!:
    if client.cipher_suites.contains(TLS_CIPHER_AES_128_GCM_SHA256):
        return TLS_CIPHER_AES_128_GCM_SHA256
    if client.cipher_suites.contains(TLS_CIPHER_CHACHA20_POLY1305_SHA256):
        return TLS_CIPHER_CHACHA20_POLY1305_SHA256
    fail "client did not offer a supported tls cipher suite"

fn open_record_for_cipher(cipher: Int, key: Bytes, iv: Bytes, sequence: Int, record: Bytes) -> tls13.Record!:
    if cipher == TLS_CIPHER_AES_128_GCM_SHA256:
        return tls13.open_application_aes_128_gcm(key, iv, sequence, record)
    if cipher == TLS_CIPHER_CHACHA20_POLY1305_SHA256:
        return tls13.open_application_chacha20_poly1305(key, iv, sequence, record)
    fail "unsupported tls cipher suite"

fn seal_record_for_cipher(cipher: Int, key: Bytes, iv: Bytes, sequence: Int, content_type: Int, plaintext: Bytes) -> Bytes!:
    if cipher == TLS_CIPHER_AES_128_GCM_SHA256:
        return tls13.seal_application_aes_128_gcm(key, iv, sequence, content_type, plaintext)
    if cipher == TLS_CIPHER_CHACHA20_POLY1305_SHA256:
        return tls13.seal_application_chacha20_poly1305(key, iv, sequence, content_type, plaintext)
    fail "unsupported tls cipher suite"

# version-aware record protection for the connection's application-data I/O. A
# 1.2 connection uses the TLS 1.2 AEAD record layout (explicit GCM nonce,
# sequence in the AAD); a 1.3 connection uses the 1.3 layout. The handshake
# paths call the version-specific functions directly.
fn open_conn_record(version: Int, cipher: Int, key: Bytes, iv: Bytes, sequence: Int, record: Bytes) -> tls13.Record!:
    if version == TLS_VERSION_12:
        if tls12.suite_uses_chacha(cipher):
            chacha := tls12.open_chacha20_poly1305(key, iv, sequence, record)!
            return tls13.Record(chacha.content_type, TLS_VERSION_12, chacha.payload)
        gcm := tls12.open_aes_128_gcm(key, iv, sequence, record)!
        return tls13.Record(gcm.content_type, TLS_VERSION_12, gcm.payload)
    return open_record_for_cipher(cipher, key, iv, sequence, record)

fn seal_conn_record(version: Int, cipher: Int, key: Bytes, iv: Bytes, sequence: Int, content_type: Int, plaintext: Bytes) -> Bytes!:
    if version == TLS_VERSION_12:
        if tls12.suite_uses_chacha(cipher):
            return tls12.seal_chacha20_poly1305(key, iv, sequence, content_type, plaintext)
        return tls12.seal_aes_128_gcm(key, iv, sequence, content_type, plaintext)
    return seal_record_for_cipher(cipher, key, iv, sequence, content_type, plaintext)

fn parse_certificate_chain(message: tls13.HandshakeMessage) -> List[x509.Certificate]!:
    cert_msg := tls13.parse_certificate_message(message.body)!
    chain: List[x509.Certificate] := []
    for entry in cert_msg.certificates:
        chain.push(x509.parse_der(entry.der)!)
    return chain

fn verify_certificate_chain(certs: List[x509.Certificate], config: Config, server_name: String) -> Bool!:
    roots := native_config_roots(config)!
    result := x509.verify_server_chain(certs, roots, server_name)
    if not result.ok:
        fail result.reason
    return true

fn verify_client_certificate_chain(certs: List[x509.Certificate], config: Config) -> Bool!:
    ca_pem := config_get(native_server_client_ca_pem, config.handle, "")
    if ca_pem == "":
        fail "native tls client ca config not found"
    roots := x509.parse_pem_chain(ca_pem)!
    result := x509.verify_client_chain(certs, roots)
    if not result.ok:
        fail result.reason
    return true

fn select_alpn_protocol(config: Config, offered: List[String]) -> String!:
    protocols := config_alpn_protocols(config)
    if protocols.len() == 0:
        return ""
    if offered.len() == 0:
        fail "client did not offer alpn"
    for protocol in protocols:
        if offered.contains(protocol):
            return protocol
    fail "client did not offer a supported alpn protocol"

fn resume_cache_key(config: Config, server_name: String) -> String:
    return config_session_cache_key(config, server_name)

fn server_ticket_key(ticket: Bytes) -> String:
    return encoding.to_hex(ticket)

fn cache_resumed_session(cache_key: String, ticket: Bytes, entry: SessionTicketEntry):
    expires_at_ms := entry.issued_at_ms + entry.lifetime_ms
    remember_client_cached_session(cache_key, cached_session_from_peer(ticket, entry.psk, entry.cipher, entry.alpn_protocol, empty_peer_identity(), expires_at_ms))

fn copy_string_list(items: List[String]) -> List[String]:
    out: List[String] := []
    for item in items:
        out.push(item)
    return out

fn copy_peer_certificate(cert: PeerCertificate) -> PeerCertificate:
    return PeerCertificate(cert.subject_common_name, cert.issuer_common_name, cert.serial_hex, cert.not_before, cert.not_after, copy_string_list(cert.dns_names), copy_string_list(cert.ip_addresses), cert.is_ca)

fn copy_peer_certificate_list(items: List[PeerCertificate]) -> List[PeerCertificate]:
    out: List[PeerCertificate] := []
    for item in items:
        out.push(copy_peer_certificate(item))
    return out

fn copy_connection_state(state: ConnectionState) -> ConnectionState:
    return ConnectionState(state.version, state.cipher_suite, state.negotiated_protocol, state.did_resume, state.peer_common_name, state.peer_issuer_common_name, state.peer_serial_hex, state.peer_not_before, state.peer_not_after, copy_string_list(state.peer_dns_names), copy_string_list(state.peer_ip_addresses), state.peer_certificate_count, copy_peer_certificate_list(state.peer_certificates), state.peer_chain_present, state.client_auth_requested, state.client_auth_verified)

fn empty_connection_state() -> ConnectionState:
    return ConnectionState(0, 0, "", false, "", "", "", "", "", [], [], 0, [], false, false, false)

fn empty_peer_identity() -> PeerIdentity:
    return PeerIdentity("", "", "", "", "", [], [], 0, [], false)

fn peer_certificate_from_x509(cert: x509.Certificate) -> PeerCertificate:
    return PeerCertificate(cert.subject_common_name, cert.issuer_common_name, cert.serial_hex, cert.not_before, cert.not_after, copy_string_list(cert.dns_names), copy_string_list(cert.ip_addresses), cert.is_ca)

fn certificate_summaries(certs: List[x509.Certificate]) -> List[PeerCertificate]:
    out: List[PeerCertificate] := []
    for cert in certs:
        out.push(peer_certificate_from_x509(cert))
    return out

fn peer_identity_from_certificates(certs: List[x509.Certificate]) -> PeerIdentity:
    if certs.len() == 0:
        return empty_peer_identity()
    leaf := certs[0]
    return PeerIdentity(leaf.subject_common_name, leaf.issuer_common_name, leaf.serial_hex, leaf.not_before, leaf.not_after, copy_string_list(leaf.dns_names), copy_string_list(leaf.ip_addresses), certs.len(), certificate_summaries(certs), true)

fn peer_identity_from_cached_session(session: CachedSession) -> PeerIdentity:
    chain_present := session.peer_common_name != "" or session.peer_dns_names.len() > 0 or session.peer_ip_addresses.len() > 0
    return PeerIdentity(session.peer_common_name, session.peer_issuer_common_name, session.peer_serial_hex, session.peer_not_before, session.peer_not_after, copy_string_list(session.peer_dns_names), copy_string_list(session.peer_ip_addresses), session.peer_certificate_count, copy_peer_certificate_list(session.peer_certificates), chain_present)

fn peer_identity_from_connection_state(state: ConnectionState) -> PeerIdentity:
    return PeerIdentity(state.peer_common_name, state.peer_issuer_common_name, state.peer_serial_hex, state.peer_not_before, state.peer_not_after, copy_string_list(state.peer_dns_names), copy_string_list(state.peer_ip_addresses), state.peer_certificate_count, copy_peer_certificate_list(state.peer_certificates), state.peer_chain_present)

fn connection_state_from_peer(version: Int, cipher: Int, negotiated_alpn: String, did_resume: Bool, peer: PeerIdentity, client_auth_requested: Bool, client_auth_verified: Bool) -> ConnectionState:
    return ConnectionState(version, cipher, negotiated_alpn, did_resume, peer.common_name, peer.issuer_common_name, peer.serial_hex, peer.not_before, peer.not_after, copy_string_list(peer.dns_names), copy_string_list(peer.ip_addresses), peer.certificate_count, copy_peer_certificate_list(peer.certificates), peer.chain_present, client_auth_requested, client_auth_verified)

fn cached_session_from_peer(ticket: Bytes, psk: Bytes, cipher: Int, alpn_protocol: String, peer: PeerIdentity, expires_at_ms: Int) -> CachedSession:
    return CachedSession(ticket, psk, cipher, alpn_protocol, peer.common_name, peer.issuer_common_name, peer.serial_hex, peer.not_before, peer.not_after, copy_string_list(peer.dns_names), copy_string_list(peer.ip_addresses), peer.certificate_count, copy_peer_certificate_list(peer.certificates), expires_at_ms)

fn empty_cached_session() -> CachedSession:
    return cached_session_from_peer(bytes.empty(), bytes.empty(), 0, "", empty_peer_identity(), 0)

fn empty_client_hello_info() -> ClientHelloInfo:
    return ClientHelloInfo("", [])

fn copy_client_hello_info(info: ClientHelloInfo) -> ClientHelloInfo:
    return ClientHelloInfo(info.server_name, copy_string_list(info.alpn_protocols))

fn run_verify_connection_hook(config: Config, state: ConnectionState) -> Bool!:
    if not config_has(native_config_verify_connection, config.handle):
        return true
    hook := config_get(native_config_verify_connection, config.handle, no_config_hook)
    ctx := ConfigHookContext("verify_connection", copy_connection_state(state), empty_client_hello_info())
    # the hook is application code and may do anything, so it runs off the
    # registry lock — config_get already copied the fn value out.
    result := hook(ctx)
    if result.reason != "":
        fail result.reason
    return true

fn select_server_config(config: Config, client_hello: tls13.ClientHello) -> Config!:
    return select_server_config_for(config, client_hello.server_name, client_hello.alpn_protocols)

# the server-name-based config selection shared by the 1.3 and 1.2 handshakes,
# so a name-based virtual host works on the fallback too.
fn select_server_config_for(config: Config, server_name: String, alpn_protocols: List[String]) -> Config!:
    if not config_has(native_server_config_selector, config.handle):
        return config
    selector := config_get(native_server_config_selector, config.handle, no_config_hook)
    info := ClientHelloInfo(server_name, copy_string_list(alpn_protocols))
    ctx := ConfigHookContext("select_server_config", empty_connection_state(), copy_client_hello_info(info))
    # application code again: called off the lock.
    result := selector(ctx)
    selected := result.selected_config
    if not is_native_server_config(selected):
        fail "tls config selector must return a server config"
    return selected

fn selected_psk_identity(did_resume: Bool) -> Int:
    if did_resume:
        return 0
    return 0 - 1

fn handshake_secret_for_resumption(did_resume: Bool, psk: Bytes, shared_secret: Bytes) -> Bytes!:
    if did_resume:
        return tls13.handshake_secret_from_early_secret_sha256(tls13.early_secret_from_psk_sha256(psk), shared_secret)
    return tls13.handshake_secret_sha256(shared_secret)

fn select_server_resumption(config: Config, client_hello: tls13.ClientHello, selected_alpn: String, fallback_cipher: Int) -> ServerResumptionDecision!:
    if not config_resumption_enabled(config) or config_requires_client_certificate(config):
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())
    if not client_hello.psk_mode_dhe or client_hello.psk_identity.len() == 0:
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())

    ticket_key := server_ticket_key(client_hello.psk_identity)
    # everything from the lookup to the lru touch runs under the lock, so a
    # concurrent handshake cannot evict the entry out from under the checks.
    # the binder check is a small in-memory hmac — no i/o, nothing that can
    # park a task — so holding the lock across it is cheaper and simpler than
    # releasing and revalidating. the defer also releases the lock when the
    # binder call propagates an error.
    native_session_mu.lock()
    defer native_session_mu.unlock()
    if not native_server_session_tickets.contains_key(ticket_key):
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())
    entry := native_server_session_tickets[ticket_key]
    if session_ticket_expired(entry):
        forget_server_ticket_locked(ticket_key)
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())
    if entry.config_handle != config.handle or not client_hello.cipher_suites.contains(entry.cipher) or entry.alpn_protocol != selected_alpn:
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())
    expected_binder := tls13.resumption_binder_verify_data_sha256(entry.psk, client_hello.psk_binder_input)!
    # the binder is a MAC that proves the client holds the PSK; compare it in
    # constant time. an ordinary byte-equality short-circuits on the first
    # differing byte, which leaks the correct binder one byte at a time and lets
    # an attacker who holds only the ticket forge it and resume as its owner.
    if not subtle.equal(expected_binder, client_hello.psk_binder):
        return ServerResumptionDecision(false, fallback_cipher, bytes.empty())
    touch_server_ticket_locked(ticket_key)
    return ServerResumptionDecision(true, entry.cipher, entry.psk)

fn append_client_certificate_flight(config: Config, transcript: ByteBuffer, flight: ByteBuffer) -> Bool!:
    if config_has_client_certificate(config):
        client_certs := native_config_client_cert_chain(config)!
        client_certificate := tls13.encode_certificate_message(client_certs)!
        transcript.write(client_certificate)!
        client_cert_input := tls13.client_certificate_verify_input_sha256(transcript.bytes())!
        client_sig := signature.sign_rsa_pss_sha256_pkcs8(native_client_private_key(config)!, client_cert_input)!
        client_certificate_verify := tls13.encode_certificate_verify(TLS_SIG_RSA_PSS_RSAE_SHA256, client_sig)!
        transcript.write(client_certificate_verify)!
        flight.write(client_certificate)!
        flight.write(client_certificate_verify)!
        return true
    client_certificate := tls13.encode_certificate_message([])!
    transcript.write(client_certificate)!
    flight.write(client_certificate)!
    return true

fn send_new_session_ticket_if_enabled(stream: TcpStream, config: Config, client_cert_requested: Bool, cipher: Int, selected_alpn: String, master_secret: Bytes, transcript: ByteBuffer, server_app_keys: tls13.TrafficKeys) -> Int!:
    if not config_resumption_enabled(config) or client_cert_requested:
        return 0
    ticket_nonce := random.bytes(8)!
    ticket := random.bytes(32)!
    resumption_master_secret := tls13.resumption_master_secret_sha256(master_secret, transcript.bytes())!
    ticket_psk := tls13.resumption_psk_sha256(resumption_master_secret, ticket_nonce)!
    remember_server_ticket(server_ticket_key(ticket), SessionTicketEntry(config.handle, cipher, ticket_psk, selected_alpn, time.now(), ttl_ms(TLS_SESSION_TICKET_LIFETIME)))
    ticket_message := tls13.encode_new_session_ticket(TLS_SESSION_TICKET_LIFETIME, 0, ticket_nonce, ticket)!
    ticket_record := seal_record_for_cipher(cipher, server_app_keys.key, server_app_keys.iv, 0, TLS_CONTENT_HANDSHAKE, ticket_message)!
    native_write_all(stream, ticket_record)!
    return 1

fn ttl_ms(seconds: Int) -> Int:
    if seconds <= 0:
        return 0
    return seconds * 1000

fn drop_key(order: List[String], key: String) -> List[String]:
    next: List[String] := []
    for item in order:
        if item != key:
            next.push(item)
    return next

fn session_ticket_expired(entry: SessionTicketEntry) -> Bool:
    if entry.lifetime_ms <= 0:
        return true
    return time.now() >= entry.issued_at_ms + entry.lifetime_ms

fn cached_session_expired(entry: CachedSession) -> Bool:
    if entry.expires_at_ms <= 0:
        return true
    return time.now() >= entry.expires_at_ms

# the _locked helpers assume the caller holds native_session_mu; the plain
# helpers below them take it. code that needs several store operations to be
# atomic (a lookup that also evicts, say) locks once and uses the _locked forms.

fn forget_server_ticket_locked(ticket_key: String):
    if native_server_session_tickets.contains_key(ticket_key):
        native_server_session_tickets.remove(ticket_key)
    native_server_session_ticket_order = drop_key(native_server_session_ticket_order, ticket_key)

fn forget_client_cached_session_locked(cache_key: String):
    if native_client_session_cache.contains_key(cache_key):
        native_client_session_cache.remove(cache_key)
    native_client_session_cache_order = drop_key(native_client_session_cache_order, cache_key)

fn remember_server_ticket_locked(ticket_key: String, entry: SessionTicketEntry):
    forget_server_ticket_locked(ticket_key)
    native_server_session_tickets.insert(ticket_key, entry)
    native_server_session_ticket_order.push(ticket_key)
    while native_server_session_ticket_order.len() > TLS_MAX_SERVER_SESSION_TICKETS:
        oldest := native_server_session_ticket_order[0]
        native_server_session_ticket_order = native_server_session_ticket_order.slice(1, native_server_session_ticket_order.len())
        if native_server_session_tickets.contains_key(oldest):
            native_server_session_tickets.remove(oldest)

fn touch_server_ticket_locked(ticket_key: String):
    if native_server_session_tickets.contains_key(ticket_key):
        native_server_session_ticket_order = drop_key(native_server_session_ticket_order, ticket_key)
        native_server_session_ticket_order.push(ticket_key)

fn remember_client_cached_session_locked(cache_key: String, session: CachedSession):
    forget_client_cached_session_locked(cache_key)
    native_client_session_cache.insert(cache_key, session)
    native_client_session_cache_order.push(cache_key)
    while native_client_session_cache_order.len() > TLS_MAX_CLIENT_SESSION_CACHE:
        oldest := native_client_session_cache_order[0]
        native_client_session_cache_order = native_client_session_cache_order.slice(1, native_client_session_cache_order.len())
        if native_client_session_cache.contains_key(oldest):
            native_client_session_cache.remove(oldest)

fn touch_client_cached_session_locked(cache_key: String):
    if native_client_session_cache.contains_key(cache_key):
        native_client_session_cache_order = drop_key(native_client_session_cache_order, cache_key)
        native_client_session_cache_order.push(cache_key)

fn forget_server_ticket(ticket_key: String):
    native_session_mu.lock()
    forget_server_ticket_locked(ticket_key)
    native_session_mu.unlock()

fn forget_client_cached_session(cache_key: String):
    native_session_mu.lock()
    forget_client_cached_session_locked(cache_key)
    native_session_mu.unlock()

fn remember_server_ticket(ticket_key: String, entry: SessionTicketEntry):
    native_session_mu.lock()
    remember_server_ticket_locked(ticket_key, entry)
    native_session_mu.unlock()

fn touch_server_ticket(ticket_key: String):
    native_session_mu.lock()
    touch_server_ticket_locked(ticket_key)
    native_session_mu.unlock()

fn remember_client_cached_session(cache_key: String, session: CachedSession):
    native_session_mu.lock()
    remember_client_cached_session_locked(cache_key, session)
    native_session_mu.unlock()

fn touch_client_cached_session(cache_key: String):
    native_session_mu.lock()
    touch_client_cached_session_locked(cache_key)
    native_session_mu.unlock()

# find a usable cached session for cache_key, refreshing its lru position, or
# return an empty session (zero-length ticket) when there is nothing to resume.
# an expired entry is dropped on the way past. the lock is scoped to this
# helper on purpose: the caller goes on to build and send the resuming client
# hello — network writes — and must not hold the lock across those.
fn lookup_resumable_client_session(cache_key: String) -> CachedSession:
    native_session_mu.lock()
    defer native_session_mu.unlock()
    if not native_client_session_cache.contains_key(cache_key):
        return empty_cached_session()
    session := native_client_session_cache[cache_key]
    if cached_session_expired(session):
        forget_client_cached_session_locked(cache_key)
        return empty_cached_session()
    touch_client_cached_session_locked(cache_key)
    return session

fn allocate_native_conn(stream: TcpStream, version: Int, cipher: Int, read_keys: tls13.TrafficKeys, write_keys: tls13.TrafficKeys, read_seq: Int, write_seq: Int, cache_key: String, resumption_master_secret: Bytes, state: ConnectionState, read_secret: Bytes, write_secret: Bytes) -> Conn:
    cs := NativeConnState(fd: stream.fd, cipher: cipher, read_key: read_keys.key, read_iv: read_keys.iv, write_key: write_keys.key, write_iv: write_keys.iv, read_seq: read_seq, write_seq: write_seq, pending: bytes.empty(), cache_key: cache_key, resumption_master_secret: resumption_master_secret, state: copy_connection_state(state), version: version, write_mu: Mutex(), read_mu: Mutex(), failed: false, read_secret: read_secret, write_secret: write_secret)
    return Conn(native_conn_register(cs))

fn native_fail_alert(record: tls13.Record) -> Bool!:
    alert := tls13.parse_alert(record.payload)
    if alert.is_ok:
        fail "tls alert " + alert.ok.description.to_string()
    fail "tls alert"

fn native_client_handshake(stream: TcpStream, server_name: String, config: Config) -> Conn!:
    # on any handshake failure, close the socket and the ephemeral keys rather
    # than leaking an fd and two registry slots per failed dial. close() is
    # idempotent, so the success-path close in the continuations is harmless.
    errdefer tcp_close(stream.fd)
    keypair := ecdh.x25519_keypair()!
    errdefer keypair.close()
    p256pair := ecdh.p256_keypair()!
    errdefer p256pair.close()
    client_random := random.bytes(32)!
    session_id := random.bytes(32)!
    alpn_protocols := config_alpn_protocols(config)
    mut cache_key := ""
    mut cached_session := empty_cached_session()
    mut offering_psk := false
    if config_resumption_enabled(config) and not config_has_client_certificate(config):
        cache_key = resume_cache_key(config, server_name)
        cached_session = lookup_resumable_client_session(cache_key)
        if cached_session.ticket.len() > 0:
            binder_input := tls13.client_hello_psk_binder_input(server_name, client_random, session_id, keypair.public_key, p256pair.public_key, alpn_protocols, cached_session.ticket, 0)!
            binder := tls13.resumption_binder_verify_data_sha256(cached_session.psk, binder_input)!
            client_hello := tls13.encode_client_hello_with_options(server_name, client_random, session_id, keypair.public_key, p256pair.public_key, alpn_protocols, cached_session.ticket, 0, binder)!
            native_write_all(stream, tls13.encode_record(TLS_CONTENT_HANDSHAKE, client_hello)!)!
            transcript := bytes.buffer()
            transcript.write(client_hello)!
            return native_client_handshake_after_client_hello(stream, server_name, config, client_random, keypair, p256pair, cached_session, true, cache_key, transcript)
    # a non-resumption hello offers the TLS 1.2 fallback unless the config is
    # locked to 1.3. resumption is a 1.3-only path (a 1.2 ticket is never
    # cached), so its hello above stays 1.3-only.
    mut client_hello := bytes.empty()
    if config_offers_tls12(config):
        client_hello = tls13.encode_client_hello_offering_tls12(server_name, client_random, session_id, keypair.public_key, p256pair.public_key, alpn_protocols, tls12.offered_suites())!
    else:
        client_hello = tls13.encode_client_hello_with_options(server_name, client_random, session_id, keypair.public_key, p256pair.public_key, alpn_protocols, bytes.empty(), 0, bytes.empty())!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_HANDSHAKE, client_hello)!)!
    transcript := bytes.buffer()
    transcript.write(client_hello)!
    return native_client_handshake_after_client_hello(stream, server_name, config, client_random, keypair, p256pair, cached_session, offering_psk, cache_key, transcript)

# The TLS 1.2 client handshake, reached from after_client_hello when the server
# negotiated 1.2. The ClientHello (in `transcript`) and the ServerHello (in
# `server_hello_message`) have already been exchanged; this drives the rest:
# Certificate, ServerKeyExchange, ServerHelloDone → ClientKeyExchange,
# ChangeCipherSpec, Finished → server ChangeCipherSpec, Finished.
fn native_client_handshake_tls12(stream: TcpStream, server_name: String, config: Config, client_random: Bytes, keypair: ecdh.X25519KeyPair, p256pair: ecdh.X25519KeyPair, server_hello_message: tls13.HandshakeMessage, transcript: ByteBuffer) -> Conn!:
    hello := tls12.parse_server_hello(server_hello_message.body)!
    # downgrade protection: we offered 1.3, so a genuine 1.2-only server would
    # not mark its random. the sentinel means a 1.3-capable server fell back to
    # 1.2 — our 1.3 offer was stripped by an active attacker.
    if tls12.has_downgrade_sentinel(hello.random):
        fail "tls downgrade attack detected: server signalled 1.3 capability but negotiated 1.2"
    if not tls12.is_supported_suite(hello.cipher_suite):
        fail "server selected an unsupported tls 1.2 cipher suite"
    # extended master secret is required (rfc 7627): it binds the master secret
    # to the full transcript and closes the triple-handshake class.
    if not hello.extended_master_secret:
        fail "server did not negotiate extended master secret"
    if hello.renegotiation_info.len() > 1 or (hello.renegotiation_info.len() == 1 and hello.renegotiation_info[0] != 0):
        fail "server sent a non-empty renegotiation info"
    cipher := hello.cipher_suite
    server_random := hello.random
    transcript_append(transcript, server_hello_message)!

    # read the server's plaintext flight (Certificate, ServerKeyExchange,
    # ServerHelloDone), buffering so a message split across records still
    # decodes, and record the exact bytes into the transcript.
    flight := bytes.buffer()
    defer flight.free()
    mut have_done := false
    while not have_done:
        record := native_read_record(stream)!
        if record.content_type == TLS_CONTENT_ALERT:
            native_fail_alert(record)!
        if record.content_type != TLS_CONTENT_HANDSHAKE:
            fail "expected a tls 1.2 handshake record"
        flight.write(record.payload)!
        # a legitimate server flight (certificate chain and key exchange) is far
        # under this; the cap stops a malicious server from growing the buffer
        # without ever sending ServerHelloDone.
        if flight.len() > TLS_MAX_HANDSHAKE_FLIGHT:
            fail "tls 1.2 server handshake flight is too large"
        for message in tls13.decode_handshakes(flight.bytes()) catch []:
            if message.message_type == tls12.TLS12_SERVER_HELLO_DONE:
                have_done = true
    server_flight := flight.bytes()
    transcript.write(server_flight)!
    messages := tls13.decode_handshakes(server_flight)!

    mut certs: List[x509.Certificate] := []
    mut ske_curve := 0
    mut ske_point := bytes.empty()
    mut have_ske := false
    for message in messages:
        if message.message_type == tls12.TLS12_CERTIFICATE:
            for der in tls12.parse_certificate_message(message.body)!:
                certs.push(x509.parse_der(der)!)
        elif message.message_type == tls12.TLS12_SERVER_KEY_EXCHANGE:
            if certs.len() == 0:
                fail "tls 1.2 server key exchange arrived before the certificate"
            ske := tls12.parse_server_key_exchange(message.body)!
            signed_data := tls12.server_key_exchange_signed_data(client_random, server_random, ske.signed_params)
            if not tls13.verify_certificate_signature(certs[0].subject_public_key, ske.signature_scheme, signed_data, ske.signature)!:
                fail "tls 1.2 server key exchange signature is invalid"
            ske_curve = ske.named_curve
            ske_point = ske.public_point
            have_ske = true
        elif message.message_type == tls12.TLS12_CERTIFICATE_REQUEST:
            fail "tls 1.2 client certificate authentication is not supported"
        elif message.message_type != tls12.TLS12_SERVER_HELLO_DONE:
            fail "unexpected tls 1.2 handshake message"
    if certs.len() == 0 or not have_ske:
        fail "incomplete tls 1.2 server flight"

    if not verify_certificate_chain(certs, config, server_name)!:
        fail "tls 1.2 server certificate verification failed"

    # ECDH with whichever curve the server chose from our key shares.
    mut pre_master := bytes.empty()
    mut client_point := bytes.empty()
    if ske_curve == tls12.NAMED_CURVE_X25519:
        pre_master = keypair.shared_secret(ske_point)!
        client_point = keypair.public_key
    elif ske_curve == tls12.NAMED_CURVE_SECP256R1:
        pre_master = p256pair.shared_secret(ske_point)!
        client_point = p256pair.public_key
    else:
        fail "server selected an unsupported tls 1.2 curve"
    keypair.close()
    p256pair.close()

    # ClientKeyExchange, then derive the keys over the transcript so far.
    cke_message := tls13.encode_handshake(tls12.TLS12_CLIENT_KEY_EXCHANGE, tls12.encode_client_key_exchange(client_point)!)!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_HANDSHAKE, cke_message)!)!
    transcript.write(cke_message)!
    session_hash := tls12.handshake_hash_sha256(transcript.bytes())
    master := tls12.extended_master_secret(pre_master, session_hash)!
    keys := tls12.key_block(master, server_random, client_random, tls12.suite_key_len(cipher), tls12.suite_iv_len(cipher))!

    # ChangeCipherSpec, then the encrypted client Finished over the transcript
    # through ClientKeyExchange.
    ccs := bytes.buffer_with_capacity(1)
    ccs.write_byte(1)!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_CHANGE_CIPHER_SPEC, ccs.bytes())!)!
    ccs.free()
    client_finished := tls13.encode_handshake(tls12.TLS12_FINISHED, tls12.finished_verify_data(master, "client finished", tls12.handshake_hash_sha256(transcript.bytes()))!)!
    native_write_all(stream, seal_conn_record(TLS_VERSION_12, cipher, keys.client_write_key, keys.client_write_iv, 0, TLS_CONTENT_HANDSHAKE, client_finished)!)!
    transcript.write(client_finished)!

    # the server answers with ChangeCipherSpec (possibly after a plaintext
    # NewSessionTicket we did not ask for and ignore) and its encrypted Finished.
    mut saw_ccs := false
    while not saw_ccs:
        record := native_read_record(stream)!
        if record.content_type == TLS_CONTENT_ALERT:
            native_fail_alert(record)!
        if record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
            saw_ccs = true
        elif record.content_type != TLS_CONTENT_HANDSHAKE:
            fail "expected server change cipher spec"
    finished_record := native_read_record(stream)!
    if finished_record.content_type == TLS_CONTENT_ALERT:
        native_fail_alert(finished_record)!
    server_inner := open_conn_record(TLS_VERSION_12, cipher, keys.server_write_key, keys.server_write_iv, 0, record_bytes(finished_record)!)!
    if server_inner.content_type != TLS_CONTENT_HANDSHAKE:
        fail "expected an encrypted server finished"
    finished_messages := tls13.decode_handshakes(server_inner.payload)!
    if finished_messages.len() == 0 or finished_messages[0].message_type != tls12.TLS12_FINISHED:
        fail "expected a server finished message"
    expected_finished := tls12.finished_verify_data(master, "server finished", tls12.handshake_hash_sha256(transcript.bytes()))!
    if not subtle.equal(expected_finished, finished_messages[0].body):
        fail "tls 1.2 server finished verification failed"

    # the server must not name an ALPN protocol we did not offer.
    if hello.alpn_protocol != "" and not config_alpn_protocols(config).contains(hello.alpn_protocol):
        fail "tls 1.2 server negotiated an unoffered alpn protocol"
    peer := peer_identity_from_certificates(certs)
    state := connection_state_from_peer(TLS_VERSION_12, cipher, hello.alpn_protocol, false, peer, false, false)
    # the connection-verification hook runs on the 1.2 path too, so pinning and
    # policy checks a caller installed apply regardless of the negotiated version.
    run_verify_connection_hook(config, state)!
    server_keys := tls13.TrafficKeys(keys.server_write_key, keys.server_write_iv)
    client_keys := tls13.TrafficKeys(keys.client_write_key, keys.client_write_iv)
    # a fresh cipher epoch starts at sequence 0 for the Finished, so the first
    # application record in each direction is sequence 1.
    return allocate_native_conn(stream, TLS_VERSION_12, cipher, server_keys, client_keys, 1, 1, "", bytes.empty(), state, bytes.empty(), bytes.empty())

fn native_client_handshake_after_client_hello(stream: TcpStream, server_name: String, config: Config, client_random: Bytes, keypair: ecdh.X25519KeyPair, p256pair: ecdh.X25519KeyPair, cached_session: CachedSession, offering_psk: Bool, cache_key: String, transcript: ByteBuffer) -> Conn!:
    mut transcript_buf := transcript
    alpn_protocols := config_alpn_protocols(config)
    mut peer := empty_peer_identity()

    mut first_record := native_read_record(stream)!
    while first_record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
        first_record = native_read_record(stream)!
    if first_record.content_type == TLS_CONTENT_ALERT:
        native_fail_alert(first_record)!
    if first_record.content_type != TLS_CONTENT_HANDSHAKE:
        fail "expected tls server hello"
    server_messages := tls13.decode_handshakes(first_record.payload)!
    if server_messages.len() == 0 or server_messages[0].message_type != TLS_HANDSHAKE_SERVER_HELLO:
        fail "expected tls server hello"
    # branch on the version the server negotiated. a 1.2 ServerHello would fail
    # the 1.3 parser (no supported_versions, no key share), so decide here.
    negotiated := tls13.negotiated_server_version(server_messages[0].body)!
    if negotiated == TLS_VERSION_12:
        if not config_offers_tls12(config):
            fail "server negotiated tls 1.2 but this config requires tls 1.3"
        return native_client_handshake_tls12(stream, server_name, config, client_random, keypair, p256pair, server_messages[0], transcript_buf)
    if negotiated != TLS_VERSION_13:
        fail "server negotiated an unsupported tls version"
    server_hello := tls13.parse_server_hello(server_messages[0].body)!
    transcript_append(transcript_buf, server_messages[0])!

    # the server picked one of our offered groups; derive with that keypair.
    mut shared_secret := bytes.empty()
    if server_hello.key_share_group == TLS_GROUP_SECP256R1:
        shared_secret = p256pair.shared_secret(server_hello.key_share)!
    elif server_hello.key_share_group == TLS_GROUP_X25519:
        shared_secret = keypair.shared_secret(server_hello.key_share)!
    else:
        fail "server selected an unsupported tls key share group"
    keypair.close()
    p256pair.close()
    mut did_resume := false
    if server_hello.selected_psk_identity >= 0:
        if not offering_psk or server_hello.selected_psk_identity != 0:
            fail "server selected an unexpected tls psk identity"
        did_resume = true
    handshake_secret := handshake_secret_for_resumption(did_resume, cached_session.psk, shared_secret)!
    server_hs_secret := tls13.server_handshake_traffic_secret_sha256(handshake_secret, transcript_buf.bytes())!
    client_hs_secret := tls13.client_handshake_traffic_secret_sha256(handshake_secret, transcript_buf.bytes())!
    server_hs_keys := traffic_keys_for_cipher(server_hello.cipher_suite, server_hs_secret)!
    client_hs_keys := traffic_keys_for_cipher(server_hello.cipher_suite, client_hs_secret)!

    mut server_hs_seq := 0
    mut certs: List[x509.Certificate] := []
    mut cert_verified := false
    mut cert_verify_seen := false
    mut client_cert_requested := false
    mut negotiated_alpn := ""
    mut server_finished := false
    while not server_finished:
        record := native_read_record(stream)!
        if record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
            continue
        if record.content_type == TLS_CONTENT_ALERT:
            native_fail_alert(record)!
        if record.content_type != TLS_CONTENT_APPLICATION_DATA:
            fail "expected encrypted tls handshake record"
        inner := open_record_for_cipher(server_hello.cipher_suite, server_hs_keys.key, server_hs_keys.iv, server_hs_seq, record_bytes(record)!)!
        server_hs_seq = server_hs_seq + 1
        if inner.content_type != TLS_CONTENT_HANDSHAKE:
            fail "expected tls handshake payload"
        messages := tls13.decode_handshakes(inner.payload)!
        for message in messages:
            if message.message_type == TLS_HANDSHAKE_ENCRYPTED_EXTENSIONS:
                encrypted_extensions := tls13.parse_encrypted_extensions(message.body)!
                if encrypted_extensions.alpn_protocol != "":
                    if not alpn_protocols.contains(encrypted_extensions.alpn_protocol):
                        fail "server negotiated an unexpected alpn protocol"
                negotiated_alpn = encrypted_extensions.alpn_protocol
                transcript_append(transcript_buf, message)!
            elif message.message_type == TLS_HANDSHAKE_CERTIFICATE_REQUEST:
                client_cert_requested = true
                request := tls13.parse_certificate_request(message.body)!
                if request.signature_schemes.len() > 0 and not request.signature_schemes.contains(TLS_SIG_RSA_PSS_RSAE_SHA256):
                    fail "server requested an unsupported client certificate signature"
                transcript_append(transcript_buf, message)!
            elif message.message_type == TLS_HANDSHAKE_CERTIFICATE:
                if did_resume:
                    fail "unexpected certificate during resumed tls handshake"
                certs = parse_certificate_chain(message)!
                verify_certificate_chain(certs, config, server_name)!
                peer = peer_identity_from_certificates(certs)
                cert_verified = true
                transcript_append(transcript_buf, message)!
            elif message.message_type == TLS_HANDSHAKE_CERTIFICATE_VERIFY:
                if did_resume:
                    fail "unexpected certificate verify during resumed tls handshake"
                if certs.len() == 0:
                    fail "certificate verify arrived before certificate"
                cv := tls13.parse_certificate_verify(message.body)!
                if not tls13.verify_server_certificate_sha256(certs[0].subject_public_key, cv.signature_scheme, transcript_buf.bytes(), cv.signature)!:
                    fail "certificate verify failed"
                cert_verify_seen = true
                transcript_append(transcript_buf, message)!
            elif message.message_type == TLS_HANDSHAKE_FINISHED:
                if not did_resume and (not cert_verified or not cert_verify_seen):
                    fail "server finished before certificate verification"
                verify_data := tls13.parse_finished(message.body)!
                if not tls13.verify_finished_sha256(server_hs_secret, transcript_buf.bytes(), verify_data)!:
                    fail "server finished verification failed"
                transcript_append(transcript_buf, message)!
                server_finished = true
            else:
                fail "unexpected tls handshake message"

    application_transcript := transcript_buf.bytes()
    master_secret := tls13.master_secret_sha256(handshake_secret)!
    server_app_secret := tls13.server_application_traffic_secret_sha256(master_secret, application_transcript)!
    client_app_secret := tls13.client_application_traffic_secret_sha256(master_secret, application_transcript)!
    server_app_keys := traffic_keys_for_cipher(server_hello.cipher_suite, server_app_secret)!
    client_app_keys := traffic_keys_for_cipher(server_hello.cipher_suite, client_app_secret)!

    client_flight := bytes.buffer()
    if client_cert_requested:
        append_client_certificate_flight(config, transcript_buf, client_flight)!
    client_verify := tls13.finished_verify_data_sha256(client_hs_secret, transcript_buf.bytes())!
    client_finished := tls13.encode_finished(client_verify)!
    transcript_buf.write(client_finished)!
    client_flight.write(client_finished)!
    native_write_all(stream, tls13.encode_change_cipher_spec()!)!
    encrypted_finished := seal_record_for_cipher(server_hello.cipher_suite, client_hs_keys.key, client_hs_keys.iv, 0, TLS_CONTENT_HANDSHAKE, client_flight.bytes())!
    native_write_all(stream, encrypted_finished)!
    mut resumption_master_secret := bytes.empty()
    if config_resumption_enabled(config) and not config_has_client_certificate(config):
        resumption_master_secret = tls13.resumption_master_secret_sha256(master_secret, transcript_buf.bytes())!
    if did_resume and negotiated_alpn != cached_session.alpn_protocol:
        fail "server resumed the session with a different alpn protocol"
    if did_resume:
        peer = peer_identity_from_cached_session(cached_session)
    state := connection_state_from_peer(772, server_hello.cipher_suite, negotiated_alpn, did_resume, peer, client_cert_requested, false)
    run_verify_connection_hook(config, state)!
    return allocate_native_conn(stream, TLS_VERSION_13, server_hello.cipher_suite, server_app_keys, client_app_keys, 0, 0, cache_key, resumption_master_secret, state, server_app_secret, client_app_secret)

# true when the configured server certificate carries an EC (P-256) public key
# rather than RSA, so the handshake signs with ECDSA.
fn server_key_is_ecdsa(config: Config) -> Bool!:
    chain := native_server_certificate_chain(config)!
    if chain.len() == 0:
        return false
    leaf := x509.parse_der(chain[0])!
    return leaf.public_key_algorithm == OID_EC_PUBLIC_KEY

# sign server handshake data with the certificate's key: ECDSA (asn.1 der) for
# an EC certificate, otherwise RSA. `rsa_pss` selects RSA-PSS (tls 1.3
# CertificateVerify) over RSA-PKCS1 (tls 1.2 ServerKeyExchange). Returns the
# signature scheme id and the signature bytes.
struct ServerSignature:
    scheme: Int
    signature: Bytes

fn sign_server_handshake(config: Config, is_ecdsa: Bool, rsa_pss: Bool, message: Bytes) -> ServerSignature!:
    key := native_server_private_key(config)!
    if is_ecdsa:
        return ServerSignature(TLS_SIG_ECDSA_SECP256R1_SHA256, signature.sign_ecdsa_p256_sha256_asn1_pkcs8(key, message)!)
    if rsa_pss:
        return ServerSignature(TLS_SIG_RSA_PSS_RSAE_SHA256, signature.sign_rsa_pss_sha256_pkcs8(key, message)!)
    return ServerSignature(TLS_SIG_RSA_PKCS1_SHA256, signature.sign_rsa_pkcs1_sha256_pkcs8(key, message)!)

# pick a TLS 1.2 suite from what the client offered, in server preference order.
# only ECDHE-RSA AEAD suites are eligible because the server key is RSA; an
# ECDHE-ECDSA suite would need an ECDSA certificate we do not serve.
fn select_tls12_suite(offered: List[Int], is_ecdsa: Bool) -> Int:
    mut preference := [tls12.TLS12_ECDHE_RSA_AES128_GCM_SHA256, tls12.TLS12_ECDHE_RSA_CHACHA20_POLY1305_SHA256]
    if is_ecdsa:
        preference = [tls12.TLS12_ECDHE_ECDSA_AES128_GCM_SHA256, tls12.TLS12_ECDHE_ECDSA_CHACHA20_POLY1305_SHA256]
    for candidate in preference:
        if offered.contains(candidate):
            return candidate
    return 0

# pick an ECDHE curve from the client's supported_groups (x25519 preferred).
# a client that sent no groups is treated as offering x25519, which every peer
# that reaches this fallback supports.
fn select_tls12_curve(groups: List[Int]) -> Int:
    if groups.len() == 0 or groups.contains(tls12.NAMED_CURVE_X25519):
        return tls12.NAMED_CURVE_X25519
    if groups.contains(tls12.NAMED_CURVE_SECP256R1):
        return tls12.NAMED_CURVE_SECP256R1
    return 0

# The TLS 1.2 server handshake, reached when a client did not offer 1.3 but
# offered a suite we can serve. Sends ServerHello (with the downgrade sentinel),
# Certificate, ServerKeyExchange, ServerHelloDone; reads ClientKeyExchange,
# ChangeCipherSpec, Finished; then sends its own ChangeCipherSpec and Finished.
fn native_server_handshake_tls12(stream: TcpStream, config: Config, client_hello_message: tls13.HandshakeMessage, lenient: tls13.LenientClientHello) -> Conn!:
    # select the certificate/config by server name first: the cert's key type
    # decides which suite family (ECDHE-RSA vs ECDHE-ECDSA) we can serve.
    handshake_config := select_server_config_for(config, lenient.server_name, lenient.alpn_protocols)!
    is_ecdsa := server_key_is_ecdsa(handshake_config)!
    cipher := select_tls12_suite(lenient.cipher_suites, is_ecdsa)
    if cipher == 0:
        fail "no supported tls 1.2 cipher suite offered"
    curve := select_tls12_curve(lenient.supported_groups)
    if curve == 0:
        fail "no supported tls 1.2 curve offered"
    selected_alpn := select_alpn_protocol(handshake_config, lenient.alpn_protocols)!
    client_random := lenient.random
    # a 1.3-capable server marks its random so a downgraded 1.3 client can tell.
    server_random := tls12.apply_downgrade_sentinel(random.bytes(32)!)!

    mut keypair := ecdh.x25519_keypair()!
    if curve == tls12.NAMED_CURVE_SECP256R1:
        keypair.close()
        keypair = ecdh.p256_keypair()!
    errdefer keypair.close()

    server_hello := tls13.encode_handshake(tls12.TLS12_SERVER_HELLO, tls12.encode_server_hello(server_random, lenient.session_id, cipher, selected_alpn)!)!
    certificate := tls13.encode_handshake(tls12.TLS12_CERTIFICATE, tls12.encode_certificate_message(native_server_certificate_chain(handshake_config)!)!)!
    params := tls12.server_key_exchange_params(curve, keypair.public_key)!
    signed_data := tls12.server_key_exchange_signed_data(client_random, server_random, params)
    ske_sig := sign_server_handshake(handshake_config, is_ecdsa, false, signed_data)!
    server_key_exchange := tls13.encode_handshake(tls12.TLS12_SERVER_KEY_EXCHANGE, tls12.encode_server_key_exchange(curve, keypair.public_key, ske_sig.scheme, ske_sig.signature)!)!
    server_done := tls13.encode_handshake(tls12.TLS12_SERVER_HELLO_DONE, bytes.empty())!

    transcript := bytes.buffer()
    transcript.write(tls13.encode_handshake(client_hello_message.message_type, client_hello_message.body)!)!
    transcript.write(server_hello)!
    transcript.write(certificate)!
    transcript.write(server_key_exchange)!
    transcript.write(server_done)!

    flight := bytes.buffer()
    flight.write(server_hello)!
    flight.write(certificate)!
    flight.write(server_key_exchange)!
    flight.write(server_done)!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_HANDSHAKE, flight.bytes())!)!
    flight.free()

    # ClientKeyExchange (plaintext handshake).
    cke_record := native_read_record(stream)!
    if cke_record.content_type == TLS_CONTENT_ALERT:
        native_fail_alert(cke_record)!
    if cke_record.content_type != TLS_CONTENT_HANDSHAKE:
        fail "expected tls 1.2 client key exchange"
    cke_messages := tls13.decode_handshakes(cke_record.payload)!
    if cke_messages.len() == 0 or cke_messages[0].message_type != tls12.TLS12_CLIENT_KEY_EXCHANGE:
        fail "expected tls 1.2 client key exchange"
    client_point := tls12.parse_client_key_exchange(cke_messages[0].body)!
    transcript.write(tls13.encode_handshake(cke_messages[0].message_type, cke_messages[0].body)!)!

    pre_master := keypair.shared_secret(client_point)!
    keypair.close()
    session_hash := tls12.handshake_hash_sha256(transcript.bytes())
    master := tls12.extended_master_secret(pre_master, session_hash)!
    keys := tls12.key_block(master, server_random, client_random, tls12.suite_key_len(cipher), tls12.suite_iv_len(cipher))!

    # client ChangeCipherSpec, then the encrypted client Finished.
    mut saw_ccs := false
    while not saw_ccs:
        record := native_read_record(stream)!
        if record.content_type == TLS_CONTENT_ALERT:
            native_fail_alert(record)!
        if record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
            saw_ccs = true
        elif record.content_type != TLS_CONTENT_HANDSHAKE:
            fail "expected client change cipher spec"
    finished_record := native_read_record(stream)!
    if finished_record.content_type == TLS_CONTENT_ALERT:
        native_fail_alert(finished_record)!
    client_inner := open_conn_record(TLS_VERSION_12, cipher, keys.client_write_key, keys.client_write_iv, 0, record_bytes(finished_record)!)!
    if client_inner.content_type != TLS_CONTENT_HANDSHAKE:
        fail "expected an encrypted client finished"
    client_finished := tls13.decode_handshakes(client_inner.payload)!
    if client_finished.len() == 0 or client_finished[0].message_type != tls12.TLS12_FINISHED:
        fail "expected a client finished message"
    expected_client := tls12.finished_verify_data(master, "client finished", tls12.handshake_hash_sha256(transcript.bytes()))!
    if not subtle.equal(expected_client, client_finished[0].body):
        fail "tls 1.2 client finished verification failed"
    transcript.write(tls13.encode_handshake(tls12.TLS12_FINISHED, client_finished[0].body)!)!

    # server ChangeCipherSpec, then the encrypted server Finished.
    ccs := bytes.buffer_with_capacity(1)
    ccs.write_byte(1)!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_CHANGE_CIPHER_SPEC, ccs.bytes())!)!
    ccs.free()
    server_verify := tls12.finished_verify_data(master, "server finished", tls12.handshake_hash_sha256(transcript.bytes()))!
    server_finished := tls13.encode_handshake(tls12.TLS12_FINISHED, server_verify)!
    native_write_all(stream, seal_conn_record(TLS_VERSION_12, cipher, keys.server_write_key, keys.server_write_iv, 0, TLS_CONTENT_HANDSHAKE, server_finished)!)!

    peer := empty_peer_identity()
    state := connection_state_from_peer(TLS_VERSION_12, cipher, selected_alpn, false, peer, false, false)
    run_verify_connection_hook(handshake_config, state)!
    client_keys := tls13.TrafficKeys(keys.client_write_key, keys.client_write_iv)
    server_keys := tls13.TrafficKeys(keys.server_write_key, keys.server_write_iv)
    return allocate_native_conn(stream, TLS_VERSION_12, cipher, client_keys, server_keys, 1, 1, "", bytes.empty(), state, bytes.empty(), bytes.empty())

fn native_server_handshake(stream: TcpStream, config: Config) -> Conn!:
    first_record := native_read_record(stream)!
    if first_record.content_type == TLS_CONTENT_ALERT:
        native_fail_alert(first_record)!
    if first_record.content_type != TLS_CONTENT_HANDSHAKE:
        fail "expected tls client hello"
    client_messages := tls13.decode_handshakes(first_record.payload)!
    if client_messages.len() == 0 or client_messages[0].message_type != TLS_HANDSHAKE_CLIENT_HELLO:
        fail "expected tls client hello"
    # a client that did not offer 1.3 takes the 1.2 fallback if this config
    # allows it and it offered a suite we can serve. a 1.3-capable client (our
    # own included) always has 772 in supported_versions and stays on the 1.3
    # path, whose parser is stricter.
    lenient_hello := tls13.parse_client_hello_lenient(client_messages[0].body)!
    if not lenient_hello.supported_versions.contains(TLS_VERSION_13):
        # the 1.2 fallback does not implement client-certificate authentication,
        # so a config that requests or requires it must never drop to a path
        # that ignores it — that would authenticate nobody. such a client falls
        # through to the strict 1.3 parser below, which rejects a 1.2-only hello.
        wants_client_auth := config_requires_client_certificate(config) or config_requests_client_certificate(config)
        if config_offers_tls12(config) and not wants_client_auth and select_tls12_suite(lenient_hello.cipher_suites, server_key_is_ecdsa(config) catch false) != 0:
            return native_server_handshake_tls12(stream, config, client_messages[0], lenient_hello)
    client_hello := tls13.parse_client_hello(client_messages[0].body)!
    handshake_config := select_server_config(config, client_hello)!
    fallback_cipher := select_cipher(client_hello)!
    selected_alpn := select_alpn_protocol(handshake_config, client_hello.alpn_protocols)!
    resumption := select_server_resumption(handshake_config, client_hello, selected_alpn, fallback_cipher)!
    cipher := resumption.cipher
    did_resume := resumption.did_resume

    keypair := ecdh.x25519_keypair()!
    errdefer keypair.close()
    server_random := random.bytes(32)!
    server_hello := tls13.encode_server_hello_with_options(server_random, client_hello.session_id, cipher, keypair.public_key, selected_psk_identity(did_resume))!
    native_write_all(stream, tls13.encode_record(TLS_CONTENT_HANDSHAKE, server_hello)!)!

    transcript := bytes.buffer()
    transcript_append(transcript, client_messages[0])!
    server_messages := tls13.decode_handshakes(server_hello)!
    transcript_append(transcript, server_messages[0])!

    shared_secret := keypair.shared_secret(client_hello.key_share)!
    keypair.close()
    handshake_secret := handshake_secret_for_resumption(did_resume, resumption.psk, shared_secret)!
    server_hs_secret := tls13.server_handshake_traffic_secret_sha256(handshake_secret, transcript.bytes())!
    client_hs_secret := tls13.client_handshake_traffic_secret_sha256(handshake_secret, transcript.bytes())!
    server_hs_keys := traffic_keys_for_cipher(cipher, server_hs_secret)!
    client_hs_keys := traffic_keys_for_cipher(cipher, client_hs_secret)!

    encrypted_extensions := tls13.encode_encrypted_extensions_with_alpn(selected_alpn)!
    transcript.write(encrypted_extensions)!
    server_flight := bytes.buffer()
    server_flight.write(encrypted_extensions)!
    client_cert_requested := config_requests_client_certificate(handshake_config)
    client_cert_required := config_requires_client_certificate(handshake_config)
    if client_cert_requested and not did_resume:
        certificate_request := tls13.encode_certificate_request([TLS_SIG_RSA_PSS_RSAE_SHA256])!
        transcript.write(certificate_request)!
        server_flight.write(certificate_request)!
    if not did_resume:
        certificate := tls13.encode_certificate_message(native_server_certificate_chain(handshake_config)!)!
        transcript.write(certificate)!
        cert_verify_input := tls13.server_certificate_verify_input_sha256(transcript.bytes())!
        cert_verify_sig := sign_server_handshake(handshake_config, server_key_is_ecdsa(handshake_config)!, true, cert_verify_input)!
        certificate_verify := tls13.encode_certificate_verify(cert_verify_sig.scheme, cert_verify_sig.signature)!
        transcript.write(certificate_verify)!
        server_flight.write(certificate)!
        server_flight.write(certificate_verify)!
    server_verify := tls13.finished_verify_data_sha256(server_hs_secret, transcript.bytes())!
    server_finished := tls13.encode_finished(server_verify)!
    server_flight.write(server_finished)!
    encrypted_flight := seal_record_for_cipher(cipher, server_hs_keys.key, server_hs_keys.iv, 0, TLS_CONTENT_HANDSHAKE, server_flight.bytes())!
    native_write_all(stream, encrypted_flight)!
    transcript.write(server_finished)!

    application_transcript := transcript.bytes()
    mut client_hs_seq := 0
    mut client_certs: List[x509.Certificate] := []
    mut client_cert_seen := false
    mut client_cert_verify_seen := false
    mut client_finished_seen := false
    mut peer := empty_peer_identity()
    while not client_finished_seen:
        record := native_read_record(stream)!
        if record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
            continue
        if record.content_type == TLS_CONTENT_ALERT:
            native_fail_alert(record)!
        if record.content_type != TLS_CONTENT_APPLICATION_DATA:
            fail "expected encrypted tls client finished"
        inner := open_record_for_cipher(cipher, client_hs_keys.key, client_hs_keys.iv, client_hs_seq, record_bytes(record)!)!
        client_hs_seq = client_hs_seq + 1
        if inner.content_type != TLS_CONTENT_HANDSHAKE:
            fail "expected tls client finished"
        messages := tls13.decode_handshakes(inner.payload)!
        for message in messages:
            if message.message_type == TLS_HANDSHAKE_CERTIFICATE:
                client_certs = parse_certificate_chain(message)!
                if client_certs.len() > 0:
                    verify_client_certificate_chain(client_certs, handshake_config)!
                    peer = peer_identity_from_certificates(client_certs)
                client_cert_seen = true
                transcript_append(transcript, message)!
            elif message.message_type == TLS_HANDSHAKE_CERTIFICATE_VERIFY:
                if client_certs.len() == 0:
                    fail "client certificate verify arrived before certificate"
                cv := tls13.parse_certificate_verify(message.body)!
                if not tls13.verify_client_certificate_sha256(client_certs[0].subject_public_key, cv.signature_scheme, transcript.bytes(), cv.signature)!:
                    fail "client certificate verify failed"
                client_cert_verify_seen = true
                transcript_append(transcript, message)!
            elif message.message_type == TLS_HANDSHAKE_FINISHED:
                if client_cert_required and (client_certs.len() == 0 or not client_cert_verify_seen):
                    fail "client finished arrived before client certificate verification"
                # a certificate is public, so presenting one proves nothing on
                # its own — only CertificateVerify proves the client holds the
                # matching private key (RFC 8446 4.4.2). without this, optional
                # mTLS would record a peer identity from a victim's certificate
                # that the client never proved it owns.
                if client_certs.len() > 0 and not client_cert_verify_seen:
                    fail "client presented a certificate without a certificate verify"
                verify_data := tls13.parse_finished(message.body)!
                # verify the client Finished over the LIVE transcript, which by
                # now includes the client Certificate and CertificateVerify
                # appended above (RFC 8446 4.4.4). application_transcript is the
                # snapshot taken at the server Finished and is deliberately kept
                # for the application-secret derivation below, which is keyed on
                # exactly that earlier point — using it here rejected every
                # genuine mTLS client, since the client computes its Finished
                # over the full transcript.
                if not tls13.verify_finished_sha256(client_hs_secret, transcript.bytes(), verify_data)!:
                    fail "client finished verification failed"
                transcript_append(transcript, message)!
                client_finished_seen = true
            else:
                fail "unexpected tls client handshake message"

    master_secret := tls13.master_secret_sha256(handshake_secret)!
    server_app_secret := tls13.server_application_traffic_secret_sha256(master_secret, application_transcript)!
    client_app_secret := tls13.client_application_traffic_secret_sha256(master_secret, application_transcript)!
    server_app_keys := traffic_keys_for_cipher(cipher, server_app_secret)!
    client_app_keys := traffic_keys_for_cipher(cipher, client_app_secret)!
    initial_write_seq := send_new_session_ticket_if_enabled(stream, handshake_config, client_cert_requested, cipher, selected_alpn, master_secret, transcript, server_app_keys)!
    state := connection_state_from_peer(772, cipher, selected_alpn, did_resume, peer, client_cert_requested, client_cert_seen and client_cert_verify_seen)
    run_verify_connection_hook(handshake_config, state)!
    return allocate_native_conn(stream, TLS_VERSION_13, cipher, client_app_keys, server_app_keys, 0, initial_write_seq, "", bytes.empty(), state, client_app_secret, server_app_secret)

fn record_bytes(record: tls13.Record) -> Bytes!:
    out := bytes.buffer_with_capacity(record.payload.len() + 5)
    write_u8(out, record.content_type)!
    write_u16_be(out, 771)!
    write_u16_be(out, record.payload.len())!
    if record.payload.len() > 0:
        out.write(record.payload)!
    return out.bytes()

fn remember_client_ticket_from_message(handle: Int, cipher: Int, message: tls13.HandshakeMessage) -> Bool!:
    cs := native_conn_get(handle)
    if message.message_type != TLS_HANDSHAKE_NEW_SESSION_TICKET or cs.resumption_master_secret.is_empty():
        return false
    cache_key := cs.cache_key
    if cache_key == "":
        return false
    ticket_message := tls13.parse_new_session_ticket(message.body)!
    if ticket_message.ticket_lifetime <= 0:
        return false
    psk := tls13.resumption_psk_sha256(cs.resumption_master_secret, ticket_message.nonce)!
    expires_at_ms := time.now() + ttl_ms(ticket_message.ticket_lifetime)
    state := cs.state
    peer := peer_identity_from_connection_state(state)
    remember_client_cached_session(cache_key, cached_session_from_peer(ticket_message.ticket, psk, cipher, state.negotiated_protocol, peer, expires_at_ms))
    return true

fn native_conn_read_bytes(handle: Int, max_bytes: Int) -> Bytes!:
    mut size := max_bytes
    if size <= 0:
        size = 4096
    cs := native_conn_get(handle)
    # serialize the whole read: the pending tail and the record loop both touch
    # cs.pending and cs.read_seq, and read_seq drives the AEAD nonce, so two
    # concurrent readers must not interleave here. write uses a separate mutex,
    # so full-duplex read/write is unaffected.
    cs.read_mu.lock()
    defer cs.read_mu.unlock()
    errdefer cs.failed = true
    if cs.failed:
        fail "tls connection is unusable after an earlier record error"
    pending := cs.pending
    if pending.len() > 0:
        if pending.len() > size:
            out := pending.slice(0, size)
            cs.pending = pending.slice(size, pending.len())
            return out
        cs.pending = bytes.empty()
        return pending

    stream := TcpStream(cs.fd)
    cipher := cs.cipher
    while true:
        record := native_read_record(stream)!
        # after the handshake every legitimate record is application_data (it
        # wraps the real content type, alerts and post-handshake messages
        # included). a middlebox-compatibility change_cipher_spec is the one
        # tolerated plaintext record and is ignored. anything else in the
        # clear — an alert above all — is an injection: treating a plaintext
        # alert as end-of-data is a truncation attack, since an attacker who
        # can splice `15 03 03 00 02 xx xx` onto the stream would end the
        # caller's read early and a partial response would read as complete.
        if record.content_type == TLS_CONTENT_CHANGE_CIPHER_SPEC:
            continue
        if record.content_type != TLS_CONTENT_APPLICATION_DATA:
            fail "unencrypted tls record after handshake"
        seq := cs.read_seq
        cs.read_seq = seq + 1
        inner := open_conn_record(cs.version, cipher, cs.read_key, cs.read_iv, seq, record_bytes(record)!)!
        if inner.content_type == TLS_CONTENT_ALERT:
            # close_notify is the clean end of the stream; every other alert
            # is a failure the caller must see rather than read as a quiet EOF.
            alert := tls13.parse_alert(inner.payload)!
            if alert.description == tls13.ALERT_CLOSE_NOTIFY:
                return bytes.empty()
            fail "tls alert " + tls13.alert_description_name(alert.description)
        if inner.content_type == TLS_CONTENT_HANDSHAKE:
            messages := tls13.decode_handshakes(inner.payload)!
            for message in messages:
                if message.message_type == tls13.HANDSHAKE_KEY_UPDATE:
                    apply_peer_key_update(cs, cipher, message)!
                else:
                    remember_client_ticket_from_message(handle, cipher, message)!
            continue
        if inner.content_type == TLS_CONTENT_APPLICATION_DATA:
            payload := inner.payload
            # a zero-length application record is legal (padding / traffic
            # shaping); skip it rather than returning empty, which the caller
            # reads as a clean close_notify end-of-stream.
            if payload.len() == 0:
                continue
            if payload.len() > size:
                cs.pending = payload.slice(size, payload.len())
                return payload.slice(0, size)
            return payload

fn native_conn_write_bytes(handle: Int, data: Bytes) -> Int!:
    if data.len() == 0:
        return 0
    cs := native_conn_get(handle)
    # hold the write lock across the whole seal-and-send so a second writer on
    # this connection cannot claim the same sequence number (a reused AEAD
    # nonce) or interleave its record bytes on the wire.
    cs.write_mu.lock()
    defer cs.write_mu.unlock()
    # any seal or write error poisons the connection.
    errdefer cs.failed = true
    if cs.failed:
        fail "tls connection is unusable after an earlier record error"
    stream := TcpStream(cs.fd)
    cipher := cs.cipher
    mut count := data.len()
    if count > TLS_MAX_PLAINTEXT_RECORD:
        count = TLS_MAX_PLAINTEXT_RECORD
    chunk := data.slice(0, count)
    seq := cs.write_seq
    # consume the sequence number before the send: if the write fails partway,
    # the connection is poisoned and no retry can reseal at this same sequence.
    cs.write_seq = seq + 1
    record := seal_conn_record(cs.version, cipher, cs.write_key, cs.write_iv, seq, TLS_CONTENT_APPLICATION_DATA, chunk)!
    native_write_all(stream, record)!
    return count

# send a close_notify alert, best-effort, before the socket closes. this is
# what lets a peer tell a clean shutdown from a truncation: without it, an
# attacker who cuts the tcp connection looks identical to us finishing, and a
# peer reading a length-delimited stream cannot know it got everything (RFC 8446
# §6.1). a failure here (already-closed, poisoned connection) just falls through
# to closing the socket.
fn send_close_notify(cs: NativeConnState) -> Int!:
    cs.write_mu.lock()
    defer cs.write_mu.unlock()
    if cs.failed:
        return 0
    alert := bytes.buffer_with_capacity(2)
    defer alert.free()
    alert.write_byte(1)!
    alert.write_byte(tls13.ALERT_CLOSE_NOTIFY)!
    seq := cs.write_seq
    cs.write_seq = seq + 1
    record := seal_conn_record(cs.version, cs.cipher, cs.write_key, cs.write_iv, seq, TLS_CONTENT_ALERT, alert.bytes())!
    native_write_all(TcpStream(cs.fd), record)!
    return 0

fn native_conn_close(handle: Int):
    if not native_conn_has(handle):
        return
    cs := native_conn_get(handle)
    send_close_notify(cs) catch 0
    tcp_close(cs.fd)
    native_conn_drop(handle)

# rotate our send keys to the next generation (RFC 8446 §7.2): announce the
# update under the current keys, then switch. the caller holds no write lock; we
# take it so a concurrent app-data write cannot interleave with the rotation.
fn rotate_send_keys(cs: NativeConnState, cipher: Int, request_peer_update: Bool) -> Bool!:
    cs.write_mu.lock()
    defer cs.write_mu.unlock()
    if cs.failed:
        return false
    update := tls13.encode_key_update(request_peer_update)!
    seq := cs.write_seq
    cs.write_seq = seq + 1
    record := seal_conn_record(cs.version, cipher, cs.write_key, cs.write_iv, seq, TLS_CONTENT_HANDSHAKE, update)!
    native_write_all(TcpStream(cs.fd), record)!
    next_secret := tls13.next_application_traffic_secret_sha256(cs.write_secret)!
    keys := traffic_keys_for_cipher(cipher, next_secret)!
    cs.write_key = keys.key
    cs.write_iv = keys.iv
    cs.write_seq = 0
    cs.write_secret = next_secret
    return true

# a peer sent a KeyUpdate: switch our receive keys to the next generation (we
# already hold read_mu here), and if it asked us to update in turn, rotate our
# send keys and announce it. this is what keeps a conformant peer's KeyUpdate
# from silently killing the connection.
fn apply_peer_key_update(cs: NativeConnState, cipher: Int, message: tls13.HandshakeMessage) -> Bool!:
    if cs.version != TLS_VERSION_13 or cs.read_secret.len() == 0:
        fail "unexpected key update on a non-1.3 connection"
    request_peer_update := tls13.parse_key_update(message.body)!
    next_secret := tls13.next_application_traffic_secret_sha256(cs.read_secret)!
    keys := traffic_keys_for_cipher(cipher, next_secret)!
    cs.read_key = keys.key
    cs.read_iv = keys.iv
    cs.read_seq = 0
    cs.read_secret = next_secret
    if request_peer_update:
        rotate_send_keys(cs, cipher, false)!
    return true

# send a KeyUpdate that asks the peer to rekey too, and rotate our send keys.
fn native_conn_request_key_update(handle: Int) -> Bool!:
    if not native_conn_has(handle):
        fail "tls connection is closed"
    cs := native_conn_get(handle)
    if cs.version != TLS_VERSION_13 or cs.write_secret.len() == 0:
        fail "key update requires a tls 1.3 connection"
    return rotate_send_keys(cs, cs.cipher, true)

# create a client config using system certificate roots.
#
# the caller owns the returned config and should close() it once the connections
# made from it have finished their handshakes. the system root bundle behind it
# is read and parsed at most once per process and shared by every config, so
# building one of these per request is cheap; leaving them unclosed is not,
# because each one keeps a registry slot for the life of the process.
#
# caching the bundle means a process does not notice the system trust store
# being updated underneath it — it keeps the roots it started with until it
# restarts. that is the usual bargain (go's SystemCertPool makes it too), and
# the alternative was re-reading and re-parsing a couple of hundred kilobytes on
# every request. a program that has to pick up a rotation without restarting
# should read the bundle itself and use client_config_with_ca_file.
pub fn client_config() -> Config!:
    return native_config_handle(system_roots_pem()!)

# create a client config using a pem ca file.
#
# owned by the caller and closed by the caller, like client_config(). the file
# is read on every call; the parse of it is shared with every other config over
# the same bundle.
pub fn client_config_with_ca_file(path: String) -> Config!:
    return native_config_handle(read_file(path)!)

# create a server config from pem certificate and private key files.
pub fn server_config(cert_path: String, key_path: String) -> Config!:
    return native_server_config_handle(read_file(cert_path)!, read_file(key_path)!)

# install a server-side config selector that runs before the native handshake.
pub fn with_config_selector(config: Config, chooser: fn(ClientHelloInfo) -> Config) -> Config:
    config_put(native_server_config_selector, config.handle, fn(ctx: ConfigHookContext) => ConfigHookResult(chooser(ctx.client_hello), ""))
    return config

# dial a tls server with system roots and host name verification.
pub fn dial(host: String, port: Int) -> Conn!:
    # this call built the config, so this call closes it. dial_with_config does
    # not, because there the config is the caller's and is usually reused.
    config := client_config()!
    defer config.close()
    return dial_with_config(host, port, host, config)

# dial a tls server with an explicit server name and config.
pub fn dial_with_config(host: String, port: Int, server_name: String, config: Config) -> Conn!:
    if is_native_config(config):
        return native_client_handshake(io.connect(host, port)!, server_name, config)
    fail "native tls client config required"

# wrap an existing tcp stream as a tls client connection.
pub fn client(stream: TcpStream, server_name: String, config: Config) -> Conn!:
    if is_native_config(config):
        return native_client_handshake(stream, server_name, config)
    fail "native tls client config required"

# rebuild a Conn from a handle taken from `conn.handle`. all connection state
# lives in handle-keyed tables, so a Conn is just its handle — this lets a
# caller stash the handle as a plain Int (for example in a driver's connection
# struct) and recover a usable Conn later, sidestepping storing the struct in an
# optional field.
pub fn conn_from_handle(handle: Int) -> Conn:
    return Conn(handle)

# listen for tls connections.
pub fn listen(host: String, port: Int, config: Config) -> Listener!:
    if is_native_server_config(config):
        fd := tcp_listen(host, port)!
        config_put(native_listener_config, fd, config.handle)
        return Listener(fd)
    if is_native_config(config):
        fail "tls.listen needs a server config, not a client config (use tls.server_config)"
    fail "native tls server config required"

# accept a tls connection: take the next socket off the listener and run the
# server handshake on it. this is the one-shot form, fine for a test or a tool
# that serves a single client. a server with an accept loop wants the two halves
# separately — see accept_socket() and handshake().
pub fn accept(listener: Listener) -> Conn!:
    return Listener(listener.handle).accept()

# accept the next tcp connection on a tls listener without handshaking it.
#
# an accept loop should use this and hand the socket to a task that calls
# handshake(). the handshake reads from the network, so running it in the loop
# lets one slow client hold every other client up for the whole
# SERVER_HANDSHAKE_TIMEOUT_MS window, and lets one failed handshake take the
# loop down with it.
pub fn accept_socket(listener: Listener) -> Int!:
    return Listener(listener.handle).accept_socket()

# run the tls server handshake on a socket that came from accept_socket().
#
# the socket is owned by this call: on success the returned Conn owns it and
# Conn.close() releases it, and on failure it is closed here before the error
# propagates, so a caller that spawns one of these per connection never leaks an
# fd to a client that never gets past the handshake.
pub fn handshake(listener: Listener, fd: Int) -> Conn!:
    return Listener(listener.handle).handshake(fd)

# rebuild a Listener from its handle. an accept loop that spawns a task per
# connection passes the handle rather than the struct, because a spawned task
# takes its arguments by value and the loop keeps using the listener.
pub fn listener_from_handle(handle: Int) -> Listener:
    return Listener(handle)

# forget a listener's tls config without touching its socket.
#
# Listener.close() does both halves, which is right for a listener the caller
# owns outright. during a graceful shutdown it is not: std.shutdown owns the
# socket (it closes registered listeners itself, which is what wakes a parked
# accept promptly), so the accept loop must release only the config half. doing
# both would close an fd number the kernel may already have reused.
#
# safe to call on a listener whose config is already gone; it is a no-op then.
pub fn release_listener_config(listener: Listener):
    config_drop(native_listener_config, listener.handle)

# how many server configs are open right now: one per server_config() that has
# not been closed yet.
#
# a server builds one config per listener, so on a running process this is flat
# and small. a number that climbs is a config leak, and the leak is not free —
# an open server config pins its certificate pem and its private key der in the
# registry for as long as it stays open.
pub fn open_server_configs() -> Int:
    return config_len(native_server_cert_pem)

# how many server handshakes have failed since this process started.
#
# a handshake fails when a peer opens a connection and then hangs up, sends
# something that is not tls, offers no cipher or alpn protocol the server
# accepts, or fails client-certificate verification. a low steady rate is
# background noise on any public port; a spike is worth an alert.
pub fn server_handshake_failures() -> Int:
    return server_handshake_failure_count.load()

# count a failed handshake and close the socket it came in on.
fn note_failed_handshake(fd: Int):
    mut counted := false
    while not counted:
        current := server_handshake_failure_count.load()
        counted = server_handshake_failure_count.compare_set(current, current + 1)
    tcp_close(fd)

impl Config:
    fn with_alpn(protocols: List[String]) -> Config:
        next_protocols: List[String] := []
        for protocol in protocols:
            if protocol != "":
                next_protocols.push(protocol)
        if next_protocols.len() == 0:
            config_drop(native_config_alpn, self.handle)
            return self
        config_put(native_config_alpn, self.handle, next_protocols)
        return self

    fn with_client_certificate(cert_path: String, key_path: String) -> Config!:
        cert_pem := read_file(cert_path)!
        certs := x509.parse_pem_chain(cert_pem)!
        if certs.len() == 0:
            fail "tls client certificate chain is empty"
        key_pem := read_file(key_path)!
        key := encoding.pem_decode(key_pem)!
        if key.kind != "PRIVATE KEY":
            fail "tls client private key must be pkcs#8 pem"
        config_put(native_client_cert_pem, self.handle, cert_pem)
        config_put(native_client_key_der, self.handle, key.body)
        return self

    fn require_client_ca_file(path: String) -> Config!:
        roots_pem := read_file(path)!
        roots := x509.parse_pem_chain(roots_pem)!
        if roots.len() == 0:
            fail "tls client ca bundle is empty"
        config_put(native_server_client_ca_pem, self.handle, roots_pem)
        config_drop(native_server_client_ca_optional, self.handle)
        return self

    fn request_client_ca_file(path: String) -> Config!:
        roots_pem := read_file(path)!
        roots := x509.parse_pem_chain(roots_pem)!
        if roots.len() == 0:
            fail "tls client ca bundle is empty"
        config_put(native_server_client_ca_pem, self.handle, roots_pem)
        config_put(native_server_client_ca_optional, self.handle, true)
        return self

    fn enable_session_resumption() -> Config:
        config_put(native_config_resumption_enabled, self.handle, true)
        return self

    # Restrict this config to TLS 1.3 only, refusing the TLS 1.2 fallback.
    #
    # By default a client offers 1.3 and 1.2 and takes the highest a server
    # supports, and a server answers either; this is the same posture as Go's
    # crypto/tls and rustls. Call this when a peer must not be allowed to
    # negotiate 1.2 — the equivalent of setting a minimum version of 1.3.
    fn require_tls13() -> Config:
        config_put(native_config_require_tls13, self.handle, true)
        return self

    fn with_verify_connection(verify: fn(ConnectionState) -> String) -> Config:
        config_put(native_config_verify_connection, self.handle, fn(ctx: ConfigHookContext) => ConfigHookResult(Config(0), verify(ctx.state)))
        return self

    # give the config's registry slot back.
    #
    # whoever built a config closes it; nothing closes one for you, and a config
    # left open holds its slot until the process exits. an https client builds
    # one per request, so that is a leak per request.
    #
    # closing is safe as soon as the handshakes made from the config have
    # returned. a client config is read only while a handshake runs, and the
    # connection it produces keeps its own keys rather than a reference back
    # here.
    #
    # a server config is the same rule read carefully. `listen` records the
    # handle against the listening socket, but that is a borrow, not a transfer:
    # Listener.close() gives back the borrow, and whoever called server_config()
    # still closes the config. the borrow is what makes the timing matter. an
    # accept loop hands each socket to its own task, and that task reads the
    # certificate and the key out of this registry when its handshake reaches
    # them — which can be a whole handshake timeout after the accept returned.
    # so a server closes its config after the drain, never before it.
    #
    # every map a config can write to is dropped here. missing one would move
    # the leak rather than fix it, so there is a test that walks all of them.
    # a handle is never reissued, so a use after close reads an empty registry
    # and fails — it cannot land on another config's certificate and key.
    fn close():
        config_drop(native_config_roots_pem, self.handle)
        config_drop(native_config_alpn, self.handle)
        config_drop(native_config_resumption_enabled, self.handle)
        config_drop(native_config_require_tls13, self.handle)
        config_drop(native_config_verify_connection, self.handle)
        config_drop(native_server_config_selector, self.handle)
        config_drop(native_client_cert_pem, self.handle)
        config_drop(native_client_key_der, self.handle)
        config_drop(native_server_cert_pem, self.handle)
        config_drop(native_server_key_der, self.handle)
        config_drop(native_server_client_ca_pem, self.handle)
        config_drop(native_server_client_ca_optional, self.handle)
        return

impl Listener:
    fn accept() -> Conn!:
        return self.handshake(self.accept_socket()!)!

    fn accept_socket() -> Int!:
        if config_has(native_listener_config, self.handle):
            fd := tcp_accept(self.handle)!
            # bound the handshake (and the connection's reads) so a slow or
            # silent client can't pin a server task before it authenticates.
            tcp_set_timeout(fd, SERVER_HANDSHAKE_TIMEOUT_MS)
            return fd
        fail "native tls listener not found"

    fn handshake(fd: Int) -> Conn!:
        # config handles count up from 0, so a negative one means this listener
        # has no config registered (it was never listened on, or it was closed).
        config_handle := config_get(native_listener_config, self.handle, 0 - 1)
        if config_handle < 0:
            note_failed_handshake(fd)
            fail "native tls listener not found"
        # the socket belongs to this call, so every error exit has to close it:
        # once the handshake fails there is no Conn for the caller to close.
        errdefer note_failed_handshake(fd)
        return native_server_handshake(TcpStream(fd), Config(config_handle))!

    fn close():
        if config_has(native_listener_config, self.handle):
            config_drop(native_listener_config, self.handle)
            tcp_close(self.handle)
            return
        return

impl Conn:
    fn state() -> ConnectionState:
        if native_conn_has(self.handle):
            return copy_connection_state(native_conn_get(self.handle).state)
        return empty_connection_state()

    fn version() -> Int:
        return self.state().version

    fn version_name() -> String:
        return version_name(self.version())

    fn cipher_suite() -> Int:
        return self.state().cipher_suite

    fn cipher_suite_name() -> String:
        return cipher_suite_name(self.cipher_suite())

    # Ask the peer to rekey and rotate our own send keys (TLS 1.3 KeyUpdate).
    # Useful on a long-lived connection to bound how much data one key protects.
    # Fails on a 1.2 connection, which has no KeyUpdate.
    fn request_key_update() -> Bool!:
        return native_conn_request_key_update(self.handle)

    fn negotiated_protocol() -> String:
        return self.state().negotiated_protocol

    fn did_resume() -> Bool:
        return self.state().did_resume

    fn peer_common_name() -> String:
        return self.state().peer_common_name

    fn peer_issuer_common_name() -> String:
        return self.state().peer_issuer_common_name

    fn peer_serial_hex() -> String:
        return self.state().peer_serial_hex

    fn peer_not_before() -> String:
        return self.state().peer_not_before

    fn peer_not_after() -> String:
        return self.state().peer_not_after

    fn peer_dns_names() -> List[String]:
        return self.state().peer_dns_names

    fn peer_ip_addresses() -> List[String]:
        return self.state().peer_ip_addresses

    fn peer_certificate_count() -> Int:
        return self.state().peer_certificate_count

    fn peer_certificates() -> List[PeerCertificate]:
        return self.state().peer_certificates

    fn peer_chain_present() -> Bool:
        return self.state().peer_chain_present

    fn client_auth_requested() -> Bool:
        return self.state().client_auth_requested

    fn client_auth_verified() -> Bool:
        return self.state().client_auth_verified

    fn read_bytes(max_bytes: Int) -> Bytes!:
        if is_native_conn(self.handle):
            return native_conn_read_bytes(self.handle, max_bytes)
        fail "native tls conn not found"

    fn read(max_bytes: Int) -> String!:
        return self.read_bytes(max_bytes)!.to_string_utf8()!

    fn write_bytes(data: Bytes) -> Int!:
        if is_native_conn(self.handle):
            return native_conn_write_bytes(self.handle, data)
        fail "native tls conn not found"

    fn write(data: String) -> Int!:
        return self.write_bytes(bytes.from_string_utf8(data))!

    fn write_all_bytes(data: Bytes) -> Int!:
        mut total := 0
        mut remaining := data
        while not remaining.is_empty():
            wrote := self.write_bytes(remaining)!
            if wrote <= 0:
                fail "tls write returned 0"
            total = total + wrote
            remaining = remaining.slice(wrote, remaining.len())
        return total

    fn write_all(data: String) -> Int!:
        return self.write_all_bytes(bytes.from_string_utf8(data))

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        mut size := chunk_size
        if size <= 0:
            size = 4096
        out := bytes.buffer_with_capacity(size)
        mut chunk := self.read_bytes(size)!
        while not chunk.is_empty():
            out.write(chunk)!
            chunk = self.read_bytes(size)!
        return out.bytes()

    fn read_all_bytes() -> Bytes!:
        return self.read_all_bytes_chunked(4096)

    fn read_all() -> String!:
        return self.read_all_bytes()!.to_string_utf8()!

    # stop this session's socket in both directions without closing it, and
    # report whether the kernel accepted it.
    #
    # a graceful shutdown needs to wake a task blocked reading a connection the
    # peer is not going to close, and closing the fd does not do that — a
    # blocking read already waiting on it stays waiting. shutdown(2) does, and it
    # leaves the descriptor valid, so the owner still closes it exactly once on
    # its own way out. the tls session state is left alone: the buffered read
    # side may still have plaintext in it, and the writer may still have a final
    # record to flush.
    fn shutdown_transport() -> Bool:
        if not native_conn_has(self.handle):
            return false
        return tcp_shutdown(native_conn_get(self.handle).fd) == 1

    fn close():
        if is_native_conn(self.handle):
            native_conn_close(self.handle)
            return

fn verify_state_accept(state: ConnectionState) -> String:
    if state.version != 772:
        return "unexpected tls version"
    return ""

fn verify_state_reject(state: ConnectionState) -> String:
    if state.negotiated_protocol == "reject":
        return "unexpected protocol"
    return "tls verify hook rejected connection"

fn select_test_server_config(info: ClientHelloInfo) -> Config:
    if info.server_name == "":
        return Config(-1)
    return Config(-2)

test "tls configs reject missing files":
    assert(client_config_with_ca_file("/path/that/does/not/exist").is_err)
    assert(server_config("/path/that/does/not/exist.crt", "/path/that/does/not/exist.key").is_err)

test "tls config helpers track alpn, client auth, and resumption":
    mut client_cfg := client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!
    client_cfg = client_cfg.with_alpn(["pith.rpc"]).with_client_certificate("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.enable_session_resumption().with_verify_connection(verify_state_accept)
    mut server_cfg := server_config("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!
    server_cfg = with_config_selector(server_cfg.with_alpn(["pith.rpc"]).require_client_ca_file("tests/live/fixtures/localhost-ca.crt")!.with_verify_connection(verify_state_reject), select_test_server_config)

    assert_eq(config_alpn_protocols(client_cfg).len(), 1)
    assert_eq(config_alpn_protocols(client_cfg)[0], "pith.rpc")
    assert(config_has_client_certificate(client_cfg))
    assert(config_resumption_enabled(client_cfg))
    assert(config_has(native_config_verify_connection, client_cfg.handle))
    assert_eq(select_alpn_protocol(server_cfg, ["pith.rpc", "http/1.1"])!, "pith.rpc")
    assert(select_alpn_protocol(server_cfg, ["http/1.1"]).is_err)
    assert(config_requests_client_certificate(server_cfg))
    assert(config_requires_client_certificate(server_cfg))
    assert(config_has(native_config_verify_connection, server_cfg.handle))
    assert(config_has(native_server_config_selector, server_cfg.handle))

    optional_cfg := server_config("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.request_client_ca_file("tests/live/fixtures/localhost-ca.crt")!
    assert(config_requests_client_certificate(optional_cfg))
    assert(not config_requires_client_certificate(optional_cfg))

    client_cfg.close()
    server_cfg.close()
    optional_cfg.close()

test "closing a client config empties every registry map it wrote to":
    cfg := client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!.with_alpn(["pith.rpc"]).with_client_certificate("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.enable_session_resumption().require_tls13().with_verify_connection(verify_state_accept)
    assert(is_native_config(cfg))

    cfg.close()

    # every map a client config can write to has to be empty afterwards. a
    # close that misses one moves the leak rather than fixing it, and the miss
    # is invisible from the outside because the handle is never reissued.
    assert(not config_has(native_config_roots_pem, cfg.handle))
    assert(not config_has(native_config_alpn, cfg.handle))
    assert(not config_has(native_config_resumption_enabled, cfg.handle))
    assert(not config_has(native_config_require_tls13, cfg.handle))
    assert(not config_has(native_config_verify_connection, cfg.handle))
    assert(not config_has(native_client_cert_pem, cfg.handle))
    assert(not config_has(native_client_key_der, cfg.handle))
    assert(not is_native_config(cfg))

    # a closed config is dead rather than dangerous: handles count up and are
    # never reissued, so a stale one misses the registry and fails cleanly
    # instead of landing on somebody else's certificate and key.
    assert(native_config_roots(cfg).is_err)
    assert(client(TcpStream(0 - 1), "example.com", cfg).is_err)

    # closing again is a no-op, so a failure path can close unconditionally.
    cfg.close()

test "closing a server config empties every registry map it wrote to":
    before := open_server_configs()
    cfg := server_config("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.with_alpn(["pith.rpc"]).request_client_ca_file("tests/live/fixtures/localhost-ca.crt")!
    assert(is_native_server_config(cfg))
    assert_eq(open_server_configs(), before + 1)

    cfg.close()

    # the server half of the client test above. the certificate pem and the
    # private key der are the expensive entries here, so a close that misses one
    # keeps a key in memory for the rest of the process.
    assert(not config_has(native_server_cert_pem, cfg.handle))
    assert(not config_has(native_server_key_der, cfg.handle))
    assert(not config_has(native_server_client_ca_pem, cfg.handle))
    assert(not config_has(native_server_client_ca_optional, cfg.handle))
    assert(not config_has(native_config_alpn, cfg.handle))
    assert(not is_native_server_config(cfg))
    assert_eq(open_server_configs(), before)

    # a closed server config fails a handshake rather than serving one with
    # whatever is left in the registry — handles are never reissued.
    assert(native_server_certificate_chain(cfg).is_err)

    cfg.close()

test "a root bundle is parsed once and shared by every config that trusts it":
    first := client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!
    second := client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!
    assert(first.handle != second.handle)

    first_roots := native_config_roots(first)!
    second_roots := native_config_roots(second)!
    assert(first_roots.len() > 0)
    assert_eq(first_roots.len(), second_roots.len())
    assert_eq(first_roots[0].subject_common_name, second_roots[0].subject_common_name)

    # closing one config must not disturb the other's trust anchors: the parse
    # belongs to the bundle, not to whichever config happened to ask first.
    first.close()
    still_there := native_config_roots(second)!
    assert_eq(still_there.len(), second_roots.len())
    second.close()

    # and the cache survives both of them, because a parsed bundle stays valid
    # for the life of the process.
    third := client_config_with_ca_file("tests/live/fixtures/localhost-ca.crt")!
    assert_eq(native_config_roots(third)!.len(), second_roots.len())
    third.close()

test "tls wrappers reject invalid handles":
    bad_conn := Conn(-1)
    bad_listener := Listener(-1)
    bad_state := bad_conn.state()

    assert(bad_conn.read_bytes(8).is_err)
    assert(bad_conn.write_bytes(bytes.from_string_utf8("hello")).is_err)
    assert_eq(bad_state.version, 0)
    assert_eq(bad_state.cipher_suite, 0)
    assert_eq(bad_state.negotiated_protocol, "")
    assert(not bad_state.did_resume)
    assert_eq(bad_state.peer_common_name, "")
    assert_eq(bad_state.peer_issuer_common_name, "")
    assert_eq(bad_state.peer_serial_hex, "")
    assert_eq(bad_state.peer_not_before, "")
    assert_eq(bad_state.peer_not_after, "")
    assert_eq(bad_state.peer_dns_names.len(), 0)
    assert_eq(bad_state.peer_ip_addresses.len(), 0)
    assert_eq(bad_state.peer_certificate_count, 0)
    assert_eq(bad_state.peer_certificates.len(), 0)
    assert(not bad_state.peer_chain_present)
    assert(not bad_state.client_auth_requested)
    assert(not bad_state.client_auth_verified)
    assert_eq(bad_conn.version(), 0)
    assert_eq(bad_conn.version_name(), "unknown")
    assert_eq(bad_conn.cipher_suite(), 0)
    assert_eq(bad_conn.cipher_suite_name(), "unknown")
    assert_eq(bad_conn.negotiated_protocol(), "")
    assert(not bad_conn.did_resume())
    assert_eq(bad_conn.peer_common_name(), "")
    assert_eq(bad_conn.peer_issuer_common_name(), "")
    assert_eq(bad_conn.peer_serial_hex(), "")
    assert_eq(bad_conn.peer_not_before(), "")
    assert_eq(bad_conn.peer_not_after(), "")
    assert_eq(bad_conn.peer_dns_names().len(), 0)
    assert_eq(bad_conn.peer_ip_addresses().len(), 0)
    assert_eq(bad_conn.peer_certificate_count(), 0)
    assert_eq(bad_conn.peer_certificates().len(), 0)
    assert(not bad_conn.peer_chain_present())
    assert(not bad_conn.client_auth_requested())
    assert(not bad_conn.client_auth_verified())
    assert(bad_listener.accept().is_err)
    bad_conn.close()
    bad_listener.close()

test "tls helper names cover current protocol values":
    assert_eq(version_name(772), "tls1.3")
    assert_eq(version_name(771), "tls1.2")
    assert_eq(version_name(0), "unknown")
    assert_eq(cipher_suite_name(TLS_CIPHER_AES_128_GCM_SHA256), "TLS_AES_128_GCM_SHA256")
    assert_eq(cipher_suite_name(TLS_CIPHER_CHACHA20_POLY1305_SHA256), "TLS_CHACHA20_POLY1305_SHA256")
    assert_eq(cipher_suite_name(0), "unknown")

# the test runner forks a fresh single-threaded process per test, so resetting
# and reading the stores directly is safe here; the mutating helpers under test
# still take native_session_mu, so the lock/unlock pairing is exercised too.
test "tls cache helpers evict oldest and expire entries":
    native_client_session_cache = {}
    native_client_session_cache_order = []
    native_server_session_tickets = {}
    native_server_session_ticket_order = []

    remember_client_cached_session("first", cached_session_from_peer(bytes.from_string_utf8("a"), bytes.from_string_utf8("psk-a"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() - 1))
    assert(native_client_session_cache.contains_key("first"))
    assert(cached_session_expired(native_client_session_cache["first"]))
    forget_client_cached_session("first")

    mut i := 0
    while i < TLS_MAX_CLIENT_SESSION_CACHE + 1:
        key := "client-" + i.to_string()
        remember_client_cached_session(key, cached_session_from_peer(bytes.from_string_utf8(key), bytes.from_string_utf8("psk"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() + 1000))
        i = i + 1
    touch_client_cached_session("client-1")
    remember_client_cached_session("client-extra", cached_session_from_peer(bytes.from_string_utf8("extra"), bytes.from_string_utf8("psk"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() + 1000))
    assert_eq(native_client_session_cache_order.len(), TLS_MAX_CLIENT_SESSION_CACHE)
    assert(not native_client_session_cache.contains_key("client-2"))
    assert(native_client_session_cache.contains_key("client-1"))

    remember_server_ticket("expired", SessionTicketEntry(1, TLS_CIPHER_AES_128_GCM_SHA256, bytes.from_string_utf8("psk"), "pith", time.now() - 1000, 1))
    assert(session_ticket_expired(native_server_session_tickets["expired"]))
    forget_server_ticket("expired")

    i = 0
    while i < TLS_MAX_SERVER_SESSION_TICKETS + 1:
        key := "server-" + i.to_string()
        remember_server_ticket(key, SessionTicketEntry(1, TLS_CIPHER_AES_128_GCM_SHA256, bytes.from_string_utf8("psk"), "pith", time.now(), 1000))
        i = i + 1
    touch_server_ticket("server-1")
    remember_server_ticket("server-extra", SessionTicketEntry(1, TLS_CIPHER_AES_128_GCM_SHA256, bytes.from_string_utf8("psk"), "pith", time.now(), 1000))
    assert_eq(native_server_session_ticket_order.len(), TLS_MAX_SERVER_SESSION_TICKETS)
    assert(not native_server_session_tickets.contains_key("server-2"))
    assert(native_server_session_tickets.contains_key("server-1"))

test "tls resumable session lookup drops expired entries and refreshes lru":
    native_client_session_cache = {}
    native_client_session_cache_order = []

    assert_eq(lookup_resumable_client_session("missing").ticket.len(), 0)

    remember_client_cached_session("stale", cached_session_from_peer(bytes.from_string_utf8("old"), bytes.from_string_utf8("psk"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() - 1))
    assert_eq(lookup_resumable_client_session("stale").ticket.len(), 0)
    assert(not native_client_session_cache.contains_key("stale"))
    assert_eq(native_client_session_cache_order.len(), 0)

    remember_client_cached_session("front", cached_session_from_peer(bytes.from_string_utf8("f"), bytes.from_string_utf8("psk"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() + 1000))
    remember_client_cached_session("back", cached_session_from_peer(bytes.from_string_utf8("b"), bytes.from_string_utf8("psk"), TLS_CIPHER_AES_128_GCM_SHA256, "pith", empty_peer_identity(), time.now() + 1000))
    found := lookup_resumable_client_session("front")
    assert_eq(found.ticket.to_string_utf8()!, "f")
    assert_eq(native_client_session_cache_order[native_client_session_cache_order.len() - 1], "front")
