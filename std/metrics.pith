# std.metrics - small in-memory metrics for apps and tools
#
# this stays intentionally simple:
# - counters accumulate
# - gauges move up and down
# - histograms keep fixed buckets plus count/sum/min/max
#
# ## how it scales
#
# writing a metric takes no lock at all. an instrument (Counter, Gauge,
# Histogram) is a handle onto the atomic cells of one series, resolved when the
# instrument is created; inc, add and observe then compare-and-set those cells
# and set stores into one, and none of them touches the registry. so two tasks
# bumping the same counter contend for one cache line rather than for a lock,
# and a task that loses a compare-and-set retries instead of parking.
#
# the registry itself — the name-to-cells directory, the help text, the bucket
# boundaries — is still guarded, because a map cannot be read while another
# thread inserts into it. it is sharded across REGISTRY_SHARDS mutexes by
# series key, so resolving a metric by name (which std.net.http does per
# request, one lookup per label set) spreads over the shards instead of
# queueing on one lock.
#
# ## what a scrape sees
#
# a scrape takes every shard lock in index order, copies the directory, and
# releases them; it then reads the cells, which needs no lock. writers are
# never blocked by a scrape and a scrape is never blocked for long.
#
# that snapshot is per-series rather than process-wide: two series read
# microseconds apart may not correspond to the same instant. within one
# histogram it is coherent, which is the property prometheus actually needs,
# and it is coherent by construction rather than by exclusion.
#
# the buckets are stored per boundary rather than cumulatively, so one
# observation touches exactly one of them and the exposition adds them up as it
# walks the boundaries in order. that leaves the histogram coherent whatever
# order a reader and a writer interleave in: a running total of counts that
# only ever rise is non-decreasing however stale each term is, the +Inf bucket
# and the _count line are the same total and cannot disagree, and an
# observation still in flight is simply not in the total yet. the one order
# that does matter is that an observation publishes its sum, min and max before
# the bucket that makes it visible, so a scrape that sees a non-zero count has
# already had that observation's min and max published to it.

# how many mutexes the registry directory is spread over. a power of two, so
# the shard index is a mask rather than a division. eight is well past the core
# count of anything this runs on, which is what matters: the point is that two
# writers resolving different names rarely queue behind each other.
REGISTRY_SHARDS := 8

# the ieee-754 bit patterns of +inf and -inf, used as the empty min/max
# sentinels. every real observation compares below +inf and above -inf, so the
# first observe wins its compare-and-set without a separate "is empty" flag to
# race over. neither ever renders: min and max print only when the count is
# above zero, by which point a writer has replaced both.
POSITIVE_INFINITY_BITS := 9218868437227405312
NEGATIVE_INFINITY_BITS := 0 - 4503599627370496

# a monotonically increasing metric.
pub struct Counter:
    pub name: String
    bare: String
    cell: AtomicInt

# a point-in-time integer value.
pub struct Gauge:
    pub name: String
    bare: String
    cell: AtomicInt

# a histogram with fixed buckets and integer observations.
pub struct Histogram:
    pub name: String
    bare: String
    pairs: List[String]
    sum: AtomicInt
    lo: AtomicInt
    hi: AtomicInt
    bounds: List[Float]
    buckets: List[AtomicInt]
    overflow: AtomicInt

# the registry entry for one counter or gauge series: its identity plus the one
# cell its writers hit. `cell` holds the value's ieee-754 bits, because an
# AtomicInt is the only lock-free cell the runtime has and a counter is a Float.
struct Series:
    key: String
    bare: String
    pairs: List[String]
    cell: AtomicInt

# the registry entry for one histogram series. `bounds` and `buckets` are
# index-aligned: buckets[i] counts the observations that landed in bounds[i],
# not the ones at or below it, and `overflow` counts the ones above every
# boundary. a series' count is the sum of all of them, which is why there is no
# separate count cell to keep in step. sum, lo and hi hold ieee-754 bits.
struct HistSeries:
    key: String
    bare: String
    pairs: List[String]
    sum: AtomicInt
    lo: AtomicInt
    hi: AtomicInt
    bounds: List[Float]
    buckets: List[AtomicInt]
    overflow: AtomicInt

# the registry, sharded. shard_mu[i] guards entry i of every map list below;
# nothing reads or writes those maps without it, and no path holds two shard
# locks except the whole-registry walk, which takes them in index order.
mut shard_mu: List[Mutex] := [Mutex(), Mutex(), Mutex(), Mutex(), Mutex(), Mutex(), Mutex(), Mutex()]

# series keyed by full series key (the bare name for an unlabeled metric, or
# name{k="v",...} for a labeled one). a key may appear in more than one of these
# if a program registers the same name as two kinds; the render order below
# resolves that the way the single-map version used to.
mut counter_series: List[Map[String, Series]] := [{}, {}, {}, {}, {}, {}, {}, {}]
mut gauge_series: List[Map[String, Series]] := [{}, {}, {}, {}, {}, {}, {}, {}]
mut histogram_series: List[Map[String, HistSeries]] := [{}, {}, {}, {}, {}, {}, {}, {}]

# optional help text and unit per bare metric name (see describe). the help
# renders as a prometheus `# HELP` line; both feed the OTLP Metric.description
# and .unit fields. keyed by the bare name, so sharded on that rather than on
# the series key.
mut metric_descriptions: List[Map[String, String]] := [{}, {}, {}, {}, {}, {}, {}, {}]
mut metric_units: List[Map[String, String]] := [{}, {}, {}, {}, {}, {}, {}, {}]

# custom bucket boundaries per bare metric name (see Histogram.buckets). a
# metric with no entry here uses default_histogram_buckets(). all series of one
# metric share its boundaries, so this is keyed by the bare name too.
mut histogram_bucket_defs: List[Map[String, List[Float]]] := [{}, {}, {}, {}, {}, {}, {}, {}]

# which shard owns a name. a sampled hash rather than a hash of every byte: this
# runs on the registry path, which std.net.http hits once per label set per
# request, and reading a whole key there costs more than the map lookup it is
# choosing a lock for. length plus three characters separates the series of one
# metric, which is what has to spread.
fn shard_of(name: String) -> Int:
    n := name.len()
    if n == 0:
        return 0
    mut h := n * 131
    h = h + ord(name[0]) * 31
    h = h + ord(name[n - 1]) * 7
    if n > 2:
        h = h + ord(name[n / 2])
    return bit_and(h, REGISTRY_SHARDS - 1)

# --- lock-free cell arithmetic -------------------------------------------
#
# every one of these is a compare-and-set retry loop. a writer that loses the
# race re-reads and tries again; it never blocks, never parks a green task, and
# never holds anything another writer needs.

fn atomic_add_float(cell: AtomicInt, delta: Float):
    while true:
        current := cell.load()
        if cell.compare_set(current, float_to_bits(float_from_bits(current) + delta)):
            return

fn atomic_add_int(cell: AtomicInt, delta: Int):
    while true:
        current := cell.load()
        if cell.compare_set(current, current + delta):
            return

fn atomic_min_float(cell: AtomicInt, value: Float):
    while true:
        current := cell.load()
        if not (value < float_from_bits(current)):
            return
        if cell.compare_set(current, float_to_bits(value)):
            return

fn atomic_max_float(cell: AtomicInt, value: Float):
    while true:
        current := cell.load()
        if not (value > float_from_bits(current)):
            return
        if cell.compare_set(current, float_to_bits(value)):
            return

# --- names, labels and rendering -----------------------------------------

# record a metric's help text and/or unit (first non-empty value wins).
fn register_description(bare: String, help: String, unit: String):
    s := shard_of(bare)
    shard_mu[s].lock()
    if help != "" and not metric_descriptions[s].contains_key(bare):
        metric_descriptions[s].insert(bare, help)
    if unit != "" and not metric_units[s].contains_key(bare):
        metric_units[s].insert(bare, unit)
    shard_mu[s].unlock()

# escape help text for a prometheus `# HELP` line: backslash and newline only
# (unlike a label value, a double-quote needs no escaping here).
fn escape_help(text: String) -> String:
    # collect the pieces and join once at the end: appending each character
    # to the result string recopied everything accumulated so far, which
    # made escaping quadratic in the text.
    mut parts: List[String] := []
    mut i := 0
    while i < text.len():
        c := text[i]
        if c == chr(92):
            parts.push(chr(92) + chr(92))
        elif c == chr(10):
            parts.push(chr(92) + "n")
        else:
            parts.push(c)
        i = i + 1
    return parts.join("")

# label names follow the same rule as metric names.
fn normalize_label_name(name: String) -> String:
    return normalize_metric_name(name)

# escape a label value for prometheus text: backslash, double-quote, newline.
fn escape_label_value(value: String) -> String:
    # collect the pieces and join once at the end: appending each character
    # to the result string recopied everything accumulated so far, which
    # made escaping quadratic in the value.
    mut parts: List[String] := []
    mut i := 0
    while i < value.len():
        c := value[i]
        if c == chr(92):
            parts.push(chr(92) + chr(92))
        elif c == chr(34):
            parts.push(chr(92) + chr(34))
        elif c == chr(10):
            parts.push(chr(92) + "n")
        else:
            parts.push(c)
        i = i + 1
    return parts.join("")

# build the {k="v",...} suffix from [k1,v1,k2,v2,...] with keys sorted so a label
# set has one canonical series key regardless of argument order. empty -> "".
fn label_suffix(pairs: List[String]) -> String:
    if pairs.len() < 2:
        return ""
    mut kv: Map[String, String] := {}
    mut keys: List[String] := []
    mut i := 0
    while i + 1 < pairs.len():
        k := normalize_label_name(pairs[i])
        if not kv.contains_key(k):
            keys.push(k)
        kv.insert(k, pairs[i + 1])
        i = i + 2
    if keys.len() == 0:
        return ""
    sorted := keys.sort()
    mut out := chr(123)
    mut first := true
    for k in sorted:
        if not first:
            out = out + ","
        out = out + k + "=" + chr(34) + escape_label_value(kv[k]) + chr(34)
        first = false
    return out + chr(125)

fn make_series_key(name: String, pairs: List[String]) -> String:
    return name + label_suffix(pairs)

fn default_histogram_buckets() -> List[Float]:
    return [1.0, 5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0, 1000.0, 5000.0]

# the bucket boundaries for a bare metric name: its custom set if one was
# registered (Histogram.buckets), else the defaults. takes and releases the
# bare name's shard, so it must be called before a series shard is held.
fn buckets_for(bare: String) -> List[Float]:
    s := shard_of(bare)
    shard_mu[s].lock()
    mut out := default_histogram_buckets()
    if histogram_bucket_defs[s].contains_key(bare):
        out = histogram_bucket_defs[s][bare]
    shard_mu[s].unlock()
    return out

# register custom bucket boundaries for a bare metric, first call wins so a
# metric's boundaries stay stable once observations start. it hands back the
# boundaries in force afterwards — the caller's own list the first time, the
# earlier one after that — so a caller does not need a second lock to find out
# whether it won.
fn register_buckets(bare: String, bounds: List[Float]) -> List[Float]:
    s := shard_of(bare)
    shard_mu[s].lock()
    if not histogram_bucket_defs[s].contains_key(bare):
        histogram_bucket_defs[s].insert(bare, bounds)
    effective := histogram_bucket_defs[s][bare]
    shard_mu[s].unlock()
    return effective

# a stable, human-readable rendering of a float bound or value: whole numbers
# print without a trailing ".0" (so a bucket reads le="5", a count reads "3"),
# fractions print in full. used for prometheus text and bucket keys alike.
fn render_value(v: Float) -> String:
    whole := v.to_int()
    if whole.to_float() == v:
        return whole.to_string()
    return v.to_string()

fn metric_name_char(c: String) -> String:
    if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_":
        return c
    return "_"

fn normalize_metric_name(name: String) -> String:
    if name == "":
        return "metric"
    # collect the pieces and join once at the end: appending each character
    # to the result string recopied everything accumulated so far, which
    # made normalizing quadratic in the name.
    mut parts: List[String] := []
    mut i := 0
    while i < name.len():
        parts.push(metric_name_char(name[i]))
        i = i + 1
    out := parts.join("")
    if out == "":
        return "metric"
    if out[0] >= "0" and out[0] <= "9":
        return "_" + out
    return out

# --- registry ------------------------------------------------------------

fn new_series(key: String, bare: String, pairs: List[String]) -> Series:
    return Series(key, bare, pairs, AtomicInt(float_to_bits(0.0)))

fn new_bucket_cells(count: Int) -> List[AtomicInt]:
    mut cells: List[AtomicInt] := []
    mut i := 0
    while i < count:
        cells.push(AtomicInt(0))
        i = i + 1
    return cells

fn new_hist_series(key: String, bare: String, pairs: List[String], bounds: List[Float]) -> HistSeries:
    return HistSeries(key, bare, pairs, AtomicInt(float_to_bits(0.0)), AtomicInt(POSITIVE_INFINITY_BITS), AtomicInt(NEGATIVE_INFINITY_BITS), bounds, new_bucket_cells(bounds.len()), AtomicInt(0))

fn counter_instrument(found: Series) -> Counter:
    return Counter(found.key, found.bare, found.cell)

fn gauge_instrument(found: Series) -> Gauge:
    return Gauge(found.key, found.bare, found.cell)

fn histogram_instrument(found: HistSeries) -> Histogram:
    return Histogram(found.key, found.bare, found.pairs, found.sum, found.lo, found.hi, found.bounds, found.buckets, found.overflow)

# how many observations a histogram has taken: its per-boundary counts plus its
# overflow, which is also what the exposition renders as the +Inf bucket and the
# _count line.
fn observed_total(buckets: List[AtomicInt], overflow: AtomicInt) -> Int:
    mut total := overflow.load()
    mut i := 0
    while i < buckets.len():
        total = total + buckets[i].load()
        i = i + 1
    return total

# find or create a counter series and hand back an instrument bound to its cell.
fn resolve_counter(key: String, bare: String, pairs: List[String]) -> Counter:
    s := shard_of(key)
    shard_mu[s].lock()
    if not counter_series[s].contains_key(key):
        counter_series[s].insert(key, new_series(key, bare, pairs))
    found := counter_series[s][key]
    shard_mu[s].unlock()
    return counter_instrument(found)

fn resolve_gauge(key: String, bare: String, pairs: List[String]) -> Gauge:
    s := shard_of(key)
    shard_mu[s].lock()
    if not gauge_series[s].contains_key(key):
        gauge_series[s].insert(key, new_series(key, bare, pairs))
    found := gauge_series[s][key]
    shard_mu[s].unlock()
    return gauge_instrument(found)

# find or create a histogram series. a series that already exists is one lock
# and two map reads; only the first sight of one needs the boundaries, which
# live on the bare name's shard. that lock is taken and released on its own, so
# no path in this module holds two shard locks at once except the
# whole-registry walk — and the common path does not pay for building a default
# boundary list it is about to throw away.
fn resolve_histogram(key: String, bare: String, pairs: List[String]) -> Histogram:
    s := shard_of(key)
    shard_mu[s].lock()
    known := histogram_series[s].contains_key(key)
    if known:
        found := histogram_series[s][key]
        shard_mu[s].unlock()
        return histogram_instrument(found)
    shard_mu[s].unlock()
    bounds := buckets_for(bare)
    shard_mu[s].lock()
    if not histogram_series[s].contains_key(key):
        histogram_series[s].insert(key, new_hist_series(key, bare, pairs, bounds))
    created := histogram_series[s][key]
    shard_mu[s].unlock()
    return histogram_instrument(created)

fn same_bounds(a: List[Float], b: List[Float]) -> Bool:
    if a.len() != b.len():
        return false
    mut i := 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    return true

# --- the whole-registry walk ---------------------------------------------

# a copy of the directory taken under every shard lock. the cells it names are
# read afterwards, unlocked: they are atomics, and a scrape has no business
# holding a lock a writer might want.
struct RegistryView:
    keys: List[String]
    counters: Map[String, Series]
    gauges: Map[String, Series]
    histograms: Map[String, HistSeries]
    descriptions: Map[String, String]
    units: Map[String, String]

fn lock_all_shards():
    mut i := 0
    while i < REGISTRY_SHARDS:
        shard_mu[i].lock()
        i = i + 1

fn unlock_all_shards():
    mut i := REGISTRY_SHARDS - 1
    while i >= 0:
        shard_mu[i].unlock()
        i = i - 1

fn collect_keys(view: RegistryView) -> List[String]:
    mut seen: Map[String, Bool] := {}
    mut names: List[String] := []
    for key in view.counters:
        seen.insert(key, true)
        names.push(key)
    for key in view.gauges:
        if seen.contains_key(key):
            continue
        seen.insert(key, true)
        names.push(key)
    for key in view.histograms:
        if seen.contains_key(key):
            continue
        seen.insert(key, true)
        names.push(key)
    return names.sort()

fn registry_view() -> RegistryView:
    mut counters: Map[String, Series] := {}
    mut gauges: Map[String, Series] := {}
    mut histograms: Map[String, HistSeries] := {}
    mut descriptions: Map[String, String] := {}
    mut units: Map[String, String] := {}
    lock_all_shards()
    mut s := 0
    while s < REGISTRY_SHARDS:
        for key in counter_series[s]:
            counters.insert(key, counter_series[s][key])
        for key in gauge_series[s]:
            gauges.insert(key, gauge_series[s][key])
        for key in histogram_series[s]:
            histograms.insert(key, histogram_series[s][key])
        for bare in metric_descriptions[s]:
            descriptions.insert(bare, metric_descriptions[s][bare])
        for bare in metric_units[s]:
            units.insert(bare, metric_units[s][bare])
        s = s + 1
    unlock_all_shards()
    mut view := RegistryView([], counters, gauges, histograms, descriptions, units)
    view.keys = collect_keys(view)
    return view

# which value map holds this series key, with the same precedence the
# single-map version had: a name registered as two kinds renders as the first
# of counter, gauge, histogram.
fn view_kind(view: RegistryView, key: String) -> String:
    if view.counters.contains_key(key):
        return "counter"
    if view.gauges.contains_key(key):
        return "gauge"
    return "histogram"

fn view_bare(view: RegistryView, key: String) -> String:
    if view.counters.contains_key(key):
        return view.counters[key].bare
    if view.gauges.contains_key(key):
        return view.gauges[key].bare
    if view.histograms.contains_key(key):
        return view.histograms[key].bare
    return key

fn view_pairs(view: RegistryView, key: String) -> List[String]:
    if view.counters.contains_key(key):
        return view.counters[key].pairs
    if view.gauges.contains_key(key):
        return view.gauges[key].pairs
    if view.histograms.contains_key(key):
        return view.histograms[key].pairs
    return []

fn view_description(view: RegistryView, bare: String) -> String:
    if view.descriptions.contains_key(bare):
        return view.descriptions[bare]
    return ""

fn view_unit(view: RegistryView, bare: String) -> String:
    if view.units.contains_key(bare):
        return view.units[bare]
    return ""

# --- public api ----------------------------------------------------------

# drop all in-memory metric values. useful for tests and short-lived tools.
#
# an instrument obtained before a reset keeps writing to the cells it was given,
# which are no longer in the registry: those writes are safe and invisible. take
# a fresh instrument after a reset.
pub fn reset():
    lock_all_shards()
    mut s := 0
    while s < REGISTRY_SHARDS:
        counter_series[s].clear()
        gauge_series[s].clear()
        histogram_series[s].clear()
        metric_descriptions[s].clear()
        metric_units[s].clear()
        histogram_bucket_defs[s].clear()
        s = s + 1
    unlock_all_shards()

# create or reopen a counter by name.
pub fn counter(name: String) -> Counter:
    normalized := normalize_metric_name(name)
    return resolve_counter(normalized, normalized, [])

# create or reopen a gauge by name.
pub fn gauge(name: String) -> Gauge:
    normalized := normalize_metric_name(name)
    return resolve_gauge(normalized, normalized, [])

# create or reopen a histogram by name.
pub fn histogram(name: String) -> Histogram:
    normalized := normalize_metric_name(name)
    return resolve_histogram(normalized, normalized, [])

impl Counter:
    fn inc():
        self.add(1.0)

    fn add(delta: Float):
        atomic_add_float(self.cell, delta)

    fn value() -> Float:
        return float_from_bits(self.cell.load())

    # a counter for this metric with the given label set. pairs is [k1,v1,k2,v2,
    # ...]; each distinct set is its own series. requests.labels(["route","/api"]).
    fn labels(pairs: List[String]) -> Counter:
        return resolve_counter(make_series_key(self.bare, pairs), self.bare, pairs)

    # attach help text and a unit to this metric (renders as a prometheus
    # `# HELP` line and fills OTLP description/unit). chainable; first call wins.
    fn describe(help: String, unit: String) -> Counter:
        register_description(self.bare, help, unit)
        return self

impl Gauge:
    fn set(value: Float):
        self.cell.store(float_to_bits(value))

    fn add(delta: Float):
        atomic_add_float(self.cell, delta)

    fn value() -> Float:
        return float_from_bits(self.cell.load())

    # a gauge for this metric with the given label set (see Counter.labels).
    fn labels(pairs: List[String]) -> Gauge:
        return resolve_gauge(make_series_key(self.bare, pairs), self.bare, pairs)

    # attach help text and a unit to this metric (see Counter.describe).
    fn describe(help: String, unit: String) -> Gauge:
        register_description(self.bare, help, unit)
        return self

impl Histogram:
    # record one observation.
    #
    # exactly one cell moves: the lowest boundary at or above the value, or the
    # overflow when the value is above all of them. the exposition adds the
    # buckets up in boundary order, so what a scrape sees is still cumulative.
    #
    # the sum, min and max go first, and that order is not free to change. a
    # scrape derives the count from the buckets, so publishing the bucket last
    # is what makes a non-zero count imply that this observation's min and max
    # are already visible to it.
    fn observe(value: Float):
        atomic_add_float(self.sum, value)
        atomic_min_float(self.lo, value)
        atomic_max_float(self.hi, value)
        mut i := 0
        while i < self.bounds.len():
            if value <= self.bounds[i]:
                atomic_add_int(self.buckets[i], 1)
                return
            i = i + 1
        atomic_add_int(self.overflow, 1)

    # choose this histogram's bucket boundaries (upper bounds, ascending). set it
    # before the first observe; the first call for a metric wins, and a later
    # call naming the boundaries the series already has changes nothing, so this
    # is safe to write on a path that runs per request.
    #
    # it returns the instrument to use, and that is not decoration: the
    # boundaries decide how many cells the series has, so changing them starts
    # the series over on a fresh set and the receiver this was called on still
    # points at the old ones. chain it:
    # histogram("latency_ms").buckets([0.005, 0.01, 0.05]).
    fn buckets(bounds: List[Float]) -> Histogram:
        effective := register_buckets(self.bare, bounds)
        if same_bounds(self.bounds, effective):
            return self
        s := shard_of(self.name)
        shard_mu[s].lock()
        mut found := new_hist_series(self.name, self.bare, self.pairs, effective)
        if histogram_series[s].contains_key(self.name):
            existing := histogram_series[s][self.name]
            if same_bounds(existing.bounds, effective):
                found = existing
            else:
                histogram_series[s].insert(self.name, found)
        else:
            histogram_series[s].insert(self.name, found)
        shard_mu[s].unlock()
        return histogram_instrument(found)

    fn count() -> Int:
        return observed_total(self.buckets, self.overflow)

    fn sum() -> Float:
        return float_from_bits(self.sum.load())

    fn min() -> Float:
        if self.count() == 0:
            return 0.0
        return float_from_bits(self.lo.load())

    fn max() -> Float:
        if self.count() == 0:
            return 0.0
        return float_from_bits(self.hi.load())

    # a histogram for this metric with the given label set (see Counter.labels).
    fn labels(pairs: List[String]) -> Histogram:
        return resolve_histogram(make_series_key(self.bare, pairs), self.bare, pairs)

    # attach help text and a unit to this metric (see Counter.describe).
    fn describe(help: String, unit: String) -> Histogram:
        register_description(self.bare, help, unit)
        return self

# --- exposition ----------------------------------------------------------

# a copy of `pairs` with one more k=v appended, for adding le to a bucket line.
fn append_pair(pairs: List[String], k: String, v: String) -> List[String]:
    mut out: List[String] := []
    for p in pairs:
        out.push(p)
    out.push(k)
    out.push(v)
    return out

# the value line(s) for one histogram series. the per-boundary counts are added
# up as the boundaries are walked, which is what turns them into the cumulative
# numbers prometheus expects; the running total carries straight on into the
# +Inf bucket and the _count line, so those two are the same number rather than
# two reads that have to agree.
fn render_histogram_lines(h: HistSeries) -> List[String]:
    mut lines: List[String] := []
    mut running := 0
    mut i := 0
    while i < h.bounds.len():
        running = running + h.buckets[i].load()
        le := append_pair(h.pairs, "le", render_value(h.bounds[i]))
        lines.push(h.bare + "_bucket" + label_suffix(le) + " " + running.to_string())
        i = i + 1
    observed := running + h.overflow.load()
    inf := append_pair(h.pairs, "le", "+Inf")
    lines.push(h.bare + "_bucket" + label_suffix(inf) + " " + observed.to_string())
    suffix := label_suffix(h.pairs)
    lines.push(h.bare + "_count" + suffix + " " + observed.to_string())
    lines.push(h.bare + "_sum" + suffix + " " + render_value(float_from_bits(h.sum.load())))
    if observed > 0:
        lines.push(h.bare + "_min" + suffix + " " + render_value(float_from_bits(h.lo.load())))
        lines.push(h.bare + "_max" + suffix + " " + render_value(float_from_bits(h.hi.load())))
    return lines

# the value line(s) for one series. the # TYPE line is emitted once per metric
# name by snapshot_text.
fn render_series_lines(view: RegistryView, key: String, kind: String) -> List[String]:
    mut lines: List[String] := []
    if kind == "counter":
        lines.push(key + " " + render_value(float_from_bits(view.counters[key].cell.load())))
        return lines
    if kind == "gauge":
        lines.push(key + " " + render_value(float_from_bits(view.gauges[key].cell.load())))
        return lines
    if not view.histograms.contains_key(key):
        return lines
    return render_histogram_lines(view.histograms[key])

# export a stable prometheus-text snapshot of all series. series of the same
# metric share one # TYPE line; each series carries its labels.
pub fn snapshot_text() -> String:
    view := registry_view()
    mut lines: List[String] := []
    mut typed: Map[String, Bool] := {}
    for key in view.keys:
        bare := view_bare(view, key)
        kind := view_kind(view, key)
        if not typed.contains_key(bare):
            help := view_description(view, bare)
            if help != "":
                lines.push("# HELP " + bare + " " + escape_help(help))
            lines.push("# TYPE " + bare + " " + kind)
            typed.insert(bare, true)
        for line in render_series_lines(view, key, kind):
            lines.push(line)
    return lines.join(chr(10))

# a typed view of one metric series, for building OTLP data points. the
# histogram fields are empty/zero for counters and gauges. bucket_bounds are the
# upper bounds and bucket_cumulative[i] is the count of observations <= bounds[i]
# (prometheus le semantics); an OTLP exporter differences them into per-bucket
# counts and adds the implicit +Inf overflow bucket.
pub struct MetricSample:
    pub name: String # bare metric name
    pub kind: String # "counter" | "gauge" | "histogram"
    pub labels: List[String] # [k1,v1,k2,v2,...]
    pub value: Float # counter/gauge value, or histogram observation count
    pub sum: Float # histogram sum of observations (0 for counter/gauge)
    pub description: String # help text, or ""
    pub unit: String # unit, or ""
    pub bucket_bounds: List[Float] # histogram upper bounds (empty otherwise)
    pub bucket_cumulative: List[Int] # cumulative count <= each bound
    pub min: Float # histogram min observation (0 otherwise)
    pub max: Float # histogram max observation (0 otherwise)

# the cumulative bucket counts for a histogram series: the running total
# render_histogram_lines builds, kept as a list.
fn cumulative_buckets(h: HistSeries) -> List[Int]:
    mut out: List[Int] := []
    mut running := 0
    mut i := 0
    while i < h.bounds.len():
        running = running + h.buckets[i].load()
        out.push(running)
        i = i + 1
    return out

fn histogram_sample(h: HistSeries, desc: String, unit: String) -> MetricSample:
    cumulative := cumulative_buckets(h)
    mut observed := h.overflow.load()
    if cumulative.len() > 0:
        observed = observed + cumulative[cumulative.len() - 1]
    mut lo := 0.0
    mut hi := 0.0
    if observed > 0:
        lo = float_from_bits(h.lo.load())
        hi = float_from_bits(h.hi.load())
    return MetricSample(h.bare, "histogram", h.pairs, observed.to_float(), float_from_bits(h.sum.load()), desc, unit, h.bounds, cumulative, lo, hi)

# a structured snapshot of every series, one MetricSample each. gives an OTLP
# exporter typed name/labels/value without parsing the prometheus text.
pub fn snapshot() -> List[MetricSample]:
    view := registry_view()
    mut out: List[MetricSample] := []
    for key in view.keys:
        bare := view_bare(view, key)
        kind := view_kind(view, key)
        desc := view_description(view, bare)
        unit := view_unit(view, bare)
        if kind == "counter":
            out.push(MetricSample(bare, kind, view_pairs(view, key), float_from_bits(view.counters[key].cell.load()), 0.0, desc, unit, [], [], 0.0, 0.0))
        elif kind == "gauge":
            out.push(MetricSample(bare, kind, view_pairs(view, key), float_from_bits(view.gauges[key].cell.load()), 0.0, desc, unit, [], [], 0.0, 0.0))
        elif view.histograms.contains_key(key):
            out.push(histogram_sample(view.histograms[key], desc, unit))
    return out

test "metrics counters and gauges normalize names and store values":
    reset()
    requests := counter("requests total")
    inflight := gauge("requests in flight")

    requests.inc()
    requests.add(2.0)
    inflight.set(3.0)
    inflight.add(0.0 - 1.0)

    snapshot := snapshot_text()
    assert_eq(requests.value(), 3.0)
    assert_eq(inflight.value(), 2.0)
    assert(snapshot.contains("# TYPE requests_total counter"))
    assert(snapshot.contains("requests_total 3"))
    assert(snapshot.contains("# TYPE requests_in_flight gauge"))
    assert(snapshot.contains("requests_in_flight 2"))

test "metrics histograms export bucketed text":
    reset()
    latency := histogram("request latency ms")

    latency.observe(4.0)
    latency.observe(30.0)

    snapshot := snapshot_text()
    assert_eq(latency.count(), 2)
    assert_eq(latency.sum(), 34.0)
    assert_eq(latency.min(), 4.0)
    assert_eq(latency.max(), 30.0)
    assert(snapshot.contains("# TYPE request_latency_ms histogram"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "5" + chr(34) + chr(125) + " 1"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "50" + chr(34) + chr(125) + " 2"))
    assert(snapshot.contains("request_latency_ms_bucket" + chr(123) + "le=" + chr(34) + "+Inf" + chr(34) + chr(125) + " 2"))
    assert(snapshot.contains("request_latency_ms_count 2"))
    assert(snapshot.contains("request_latency_ms_sum 34"))

fn stress_counter(name: String, times: Int) -> Int:
    c := counter(name)
    mut i := 0
    while i < times:
        c.inc()
        i = i + 1
    return times

fn stress_histogram(name: String, times: Int) -> Int:
    h := histogram(name)
    mut i := 0
    while i < times:
        h.observe(7.0)
        i = i + 1
    return times

test "metrics stay exact under concurrent updates":
    reset()
    per := 2000
    ca := spawn stress_counter("concurrent hits", per)
    cb := spawn stress_counter("concurrent hits", per)
    cc := spawn stress_counter("concurrent hits", per)
    cd := spawn stress_counter("concurrent hits", per)
    ce := spawn stress_counter("concurrent hits", per)
    cf := spawn stress_counter("concurrent hits", per)
    cg := spawn stress_counter("concurrent hits", per)
    ch := spawn stress_counter("concurrent hits", per)
    ha := spawn stress_histogram("concurrent obs", per)
    hb := spawn stress_histogram("concurrent obs", per)
    hc := spawn stress_histogram("concurrent obs", per)
    hd := spawn stress_histogram("concurrent obs", per)

    mut counted := 0
    counted = counted + await ca
    counted = counted + await cb
    counted = counted + await cc
    counted = counted + await cd
    counted = counted + await ce
    counted = counted + await cf
    counted = counted + await cg
    counted = counted + await ch
    mut observed := 0
    observed = observed + await ha
    observed = observed + await hb
    observed = observed + await hc
    observed = observed + await hd

    assert_eq(counted, per * 8)
    assert_eq(counter("concurrent hits").value(), (per * 8).to_float())
    assert_eq(observed, per * 4)
    assert_eq(histogram("concurrent obs").count(), per * 4)
    assert_eq(histogram("concurrent obs").sum(), (per * 4 * 7).to_float())
    # every observation was 7, so exactly the boundaries at or above 7 counted
    # it: a lost bucket update or a torn read shows up here and nowhere else.
    for s in snapshot():
        if s.name == "concurrent_obs":
            assert_eq(s.bucket_cumulative[1], 0) # <=5
            assert_eq(s.bucket_cumulative[2], per * 4) # <=10
            assert_eq(s.bucket_cumulative[9], per * 4) # <=5000

test "labels create independent series and render with a shared TYPE line":
    reset()
    reqs := counter("http_requests_total")
    reqs.labels(["route", "/api", "method", "GET"]).inc()
    reqs.labels(["route", "/api", "method", "GET"]).add(2.0)
    reqs.labels(["route", "/health", "method", "GET"]).inc()

    # each distinct label set is its own series; keys are sorted for a canonical form
    assert_eq(reqs.labels(["method", "GET", "route", "/api"]).value(), 3.0)
    assert_eq(reqs.labels(["route", "/health", "method", "GET"]).value(), 1.0)

    text := snapshot_text()
    # one TYPE line for the metric, one line per series with sorted labels
    assert(text.contains("# TYPE http_requests_total counter"))
    assert(text.contains("http_requests_total" + chr(123) + "method=" + chr(34) + "GET" + chr(34) + ",route=" + chr(34) + "/api" + chr(34) + chr(125) + " 3"))

test "structured snapshot reports typed samples with labels":
    reset()
    gauge("inflight").labels(["pool", "db"]).set(4.0)
    histogram("latency_ms").labels(["route", "/api"]).observe(7.0)
    histogram("latency_ms").labels(["route", "/api"]).observe(120.0)

    mut found_gauge := false
    mut found_hist := false
    for s in snapshot():
        if s.name == "inflight" and s.labels.len() == 2:
            assert_eq(s.kind, "gauge")
            assert_eq(s.value, 4.0)
            found_gauge = true
        if s.name == "latency_ms" and s.labels.len() == 2:
            assert_eq(s.kind, "histogram")
            assert_eq(s.value, 2.0)
            assert_eq(s.sum, 127.0)
            found_hist = true
    assert(found_gauge)
    assert(found_hist)

test "counters and gauges carry fractional values":
    reset()
    errors := counter("error_ratio")
    errors.add(0.5)
    errors.add(0.25)
    temp := gauge("cpu_load")
    temp.set(1.75)

    assert_eq(errors.value(), 0.75)
    assert_eq(temp.value(), 1.75)
    text := snapshot_text()
    assert(text.contains("error_ratio 0.75"))
    assert(text.contains("cpu_load 1.75"))

test "whole float values render without a trailing decimal":
    reset()
    counter("requests_total").add(5.0)
    gauge("workers").set(3.0)
    histogram("latency_ms").observe(2.0)

    text := snapshot_text()
    # prometheus is happy with 5.0, but 5 is the conventional rendering and what
    # the pre-float text emitted, so whole numbers stay integer-clean.
    assert(text.contains("requests_total 5"))
    assert(not text.contains("requests_total 5.0"))
    assert(text.contains("workers 3"))
    assert(text.contains("latency_ms_sum 2"))

test "custom histogram buckets replace the defaults":
    reset()
    # a latency histogram in seconds wants sub-second boundaries, not the 1..5000 default.
    lat := histogram("request_seconds").buckets([0.005, 0.01, 0.025, 0.1, 0.5])
    lat.observe(0.003)
    lat.observe(0.02)
    lat.observe(0.2)

    text := snapshot_text()
    # 0.003 and 0.02 fall at/under 0.025; 0.2 only at/under 0.5.
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "0.025" + chr(34) + chr(125) + " 2"))
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "0.5" + chr(34) + chr(125) + " 3"))
    assert(text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "+Inf" + chr(34) + chr(125) + " 3"))
    # the default 1..5000 boundaries must not appear for this metric.
    assert(not text.contains("request_seconds_bucket" + chr(123) + "le=" + chr(34) + "5000" + chr(34)))
    assert_eq(lat.count(), 3)

test "custom buckets registered before a labelled series reach every series":
    reset()
    histogram("seconds_spent").buckets([0.01, 0.1])
    per_route := histogram("seconds_spent").labels(["route", "/api"])
    per_route.observe(0.05)

    text := snapshot_text()
    assert(text.contains("le=" + chr(34) + "0.1" + chr(34) + ",route=" + chr(34) + "/api" + chr(34) + chr(125) + " 1"))
    assert(not text.contains("le=" + chr(34) + "5000" + chr(34)))

test "repeating the same boundaries leaves an observed histogram alone":
    reset()
    # the shape a request path has: resolve and set the boundaries every time.
    # the first call replaces the default cells, and every call after it finds
    # the boundaries already registered and must leave the counts where they are.
    first := histogram("stable_ms").buckets([1.0, 10.0])
    first.observe(5.0)
    again := histogram("stable_ms").buckets([1.0, 10.0])
    again.observe(5.0)
    assert_eq(again.count(), 2)
    assert_eq(first.count(), 2)
    assert(snapshot_text().contains("stable_ms_count 2"))

test "describe renders a HELP line and fills the sample":
    reset()
    counter("http_requests_total").describe("total http requests handled", "requests").inc()

    text := snapshot_text()
    # the HELP line renders immediately before the TYPE line for the metric.
    assert(text.contains("# HELP http_requests_total total http requests handled" + chr(10) + "# TYPE http_requests_total counter"))

    mut checked := false
    for s in snapshot():
        if s.name == "http_requests_total":
            assert_eq(s.description, "total http requests handled")
            assert_eq(s.unit, "requests")
            checked = true
    assert(checked)

test "snapshot carries cumulative histogram buckets, min, and max":
    reset()
    h := histogram("latency_ms")
    h.observe(3.0)
    h.observe(30.0)
    h.observe(3000.0)

    mut checked := false
    for s in snapshot():
        if s.name == "latency_ms":
            # default bounds 1,5,10,25,50,100,250,500,1000,5000
            assert_eq(s.bucket_bounds.len(), 10)
            assert_eq(s.bucket_cumulative.len(), 10)
            assert_eq(s.bucket_cumulative[0], 0) # <=1
            assert_eq(s.bucket_cumulative[1], 1) # <=5 (3)
            assert_eq(s.bucket_cumulative[4], 2) # <=50 (3, 30)
            assert_eq(s.bucket_cumulative[9], 3) # <=5000 (all)
            assert_eq(s.value, 3.0)
            assert_eq(s.min, 3.0)
            assert_eq(s.max, 3000.0)
            checked = true
    assert(checked)

test "an empty histogram reports no min or max":
    reset()
    h := histogram("untouched_ms")
    assert_eq(h.count(), 0)
    assert_eq(h.min(), 0.0)
    assert_eq(h.max(), 0.0)
    text := snapshot_text()
    assert(text.contains("untouched_ms_count 0"))
    assert(not text.contains("untouched_ms_min"))
    assert(not text.contains("untouched_ms_max"))

# --- concurrency proofs ---------------------------------------------------
#
# these check the two failures a lock-free registry can have that a locked one
# cannot: a lost update, and a scrape that catches a series mid-observation.

# the trailing number of a prometheus sample line, or -1 if there is not one.
fn sample_line_value(line: String) -> Int:
    cut := line.last_index_of(" ")
    if cut < 0:
        return 0 - 1
    parsed := parse_int(line.substring(cut + 1, line.len()))
    if parsed.is_ok:
        return parsed.ok
    return 0 - 1

# read one histogram out of a prometheus exposition and check everything a
# scrape racing an observation could break: the cumulative buckets must not
# fall as the boundary rises, the +Inf bucket must equal the _count line, and a
# non-zero count must come with the min and max lines carrying `extreme` (which
# a caller passes when every observation had the same value, and leaves empty
# otherwise). that last one is what pins the publication order — a histogram
# that counted an observation before publishing its min and max would render a
# count with no extremes behind it, or with the empty sentinel.
#
# returns the rendered count when the metric is there and holds, -1 when it is
# there and broken, -2 when it is not in the text at all.
fn histogram_text_count(text: String, bare: String, extreme: String) -> Int:
    bucket_prefix := bare + "_bucket" + chr(123)
    count_prefix := bare + "_count "
    mut previous := 0
    mut inf := 0 - 1
    mut counted := 0 - 1
    mut lo := ""
    mut hi := ""
    for line in text.split(chr(10)):
        if line.starts_with(bucket_prefix):
            value := sample_line_value(line)
            if value < previous:
                return 0 - 1
            previous = value
            if line.contains("+Inf"):
                inf = value
        elif line.starts_with(count_prefix):
            counted = sample_line_value(line)
        elif line.starts_with(bare + "_min "):
            lo = line.substring(bare.len() + 5, line.len())
        elif line.starts_with(bare + "_max "):
            hi = line.substring(bare.len() + 5, line.len())
    if inf < 0 or counted < 0:
        return 0 - 2
    if inf != counted:
        return 0 - 1
    if counted > 0 and extreme != "":
        if lo != extreme or hi != extreme:
            return 0 - 1
    return counted

# scrape and check until the series reaches `target`, or until the scrape
# budget runs out.
#
# the budget is what keeps this test from wedging, and it is not paranoia. a
# green task that spins without ever parking starves the tasks sharing its
# worker: this loop takes no lock a writer holds and never waits on i/o, so on
# a two-core box it can run two hundred thousand scrapes while the writers get
# nowhere. an earlier version waited on a flag that the writers finishing had
# to set, which meant the watcher was waiting on tasks it was itself starving —
# about one run in four hung outright, on both backends. a healthy run here
# takes fifty to a hundred and twenty scrapes, so a budget of two thousand
# leaves the race intact and bounds the failure.
fn scrape_while_written(target: Int, bare: String, extreme: String) -> Int:
    mut checked := 0
    mut spins := 0
    while spins < 2000:
        seen := histogram_text_count(snapshot_text(), bare, extreme)
        if seen == 0 - 1:
            return 0 - 1
        if seen >= 0:
            checked = checked + 1
            if seen >= target:
                return checked
        spins = spins + 1
    return checked

test "a scrape taken while a histogram is written is never incoherent":
    reset()
    per := 4000
    # one observation before anything is spawned, so the watcher's first scrape
    # finds the series populated whichever order the scheduler runs the four
    # tasks in. what this test must not depend on is winning that race — it is
    # here to check what a scrape sees, not who gets a worker first.
    histogram("racing ms").observe(7.0)
    target := 1 + per * 3
    watcher := spawn scrape_while_written(target, "racing_ms", "7")
    wa := spawn stress_histogram("racing ms", per)
    wb := spawn stress_histogram("racing ms", per)
    wc := spawn stress_histogram("racing ms", per)
    written := await wa + await wb + await wc
    checked := await watcher
    assert_eq(written, per * 3)
    # -1 is a scrape whose buckets fell as the boundary rose, whose +Inf
    # disagreed with its count, or whose non-zero count arrived with no min and
    # max behind it. the seeded observation is what makes `checked` at least one
    # without depending on the scheduler.
    assert(checked > 0)
    assert_eq(histogram("racing ms").count(), target)
    assert_eq(histogram_text_count(snapshot_text(), "racing_ms", "7"), target)

fn stress_gauge(name: String, times: Int) -> Int:
    g := gauge(name)
    mut i := 0
    while i < times:
        g.add(1.0)
        i = i + 1
    return times

test "concurrent gauge adds are not lost":
    reset()
    ga := spawn stress_gauge("level", 3000)
    gb := spawn stress_gauge("level", 3000)
    gc := spawn stress_gauge("level", 3000)
    gd := spawn stress_gauge("level", 3000)
    total := await ga + await gb + await gc + await gd
    assert_eq(total, 12000)
    assert_eq(gauge("level").value(), 12000.0)
