# types.pith — type representation for the self-hosted type checker
#
# flat type table used by the self-hosted checker and IR emitter. TypeIds are
# plain integers indexing into a flat list.

from std.collections import copy_list

# ---------------------------------------------------------------
# type id constants — must match checker and IR emitter assumptions
# ---------------------------------------------------------------

pub TID_INT := 0
pub TID_UINT := 1
pub TID_FLOAT := 2
pub TID_BOOL := 3
pub TID_STRING := 4
pub TID_BYTES := 5
pub TID_VOID := 6
pub TID_INT8 := 7
pub TID_INT16 := 8
pub TID_INT32 := 9
pub TID_INT64 := 10
pub TID_UINT8 := 11
pub TID_UINT16 := 12
pub TID_UINT32 := 13
pub TID_UINT64 := 14
pub TID_ERR := 15
# a bare `none` types as its own sentinel rather than as the error type.
# every checker guard skips its comparison when a side is the error type —
# that is the cascade-suppression rule, and overloading it for `none` made
# `none` compatible with every type in every position. a separate sentinel
# keeps the suppression and still lets `none` be compared: it is accepted
# only where an optional is expected (see types_structurally_equal).
pub TID_NONE := 16
pub TID_FIRST_USER := 17

# ---------------------------------------------------------------
# type info — flat struct with string kind tag
# ---------------------------------------------------------------
#
# kind values: "primitive", "struct", "enum", "function", "optional",
#   "result", "tuple", "task", "channel", "list", "map", "set"
#
# unused fields default to empty/0/-1 depending on kind.

# everything known about one type. this is a single record used for
# every kind of type, so `kind` decides which of the remaining fields
# mean anything and the rest are left empty:
#
#   struct     fields, field_types, field_pub, field_mut
#   function   param_types, return_type
#   optional / list / set / task / channel   inner
#   map        key_type, value_type
#   tuple      elements
#   enum       variants, variant_types
#   primitive  name only
#
# reading a field that does not belong to the kind gives an empty list
# or zero rather than an error, so check `kind` first. build these
# through the `ti_*` constructors, which set the right fields for each
# kind and leave the others empty.
pub struct TypeInfo:
    pub kind: String
    pub name: String
    # struct fields
    pub fields: List[String]
    pub field_types: List[Int]
    pub field_pub: List[Bool]
    pub field_mut: List[Bool]
    # function signature
    pub param_types: List[Int]
    pub return_type: Int
    # optional/list/set/task/channel inner type
    pub inner: Int
    # map key/value types
    pub key_type: Int
    pub value_type: Int
    # tuple element types
    pub elements: List[Int]
    # enum variants
    pub variants: List[String]
    pub variant_types: List[List[Int]]

# ---------------------------------------------------------------
# constructors — one per kind for clarity
# ---------------------------------------------------------------

# a leaf type that carries nothing but its name. only
# initialize_type_table builds these — the 15 builtin primitives plus
# the "<error>" and "none" sentinels — so a caller outside this file
# has no reason to.
pub fn ti_primitive(name: String) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("primitive", name, empty_s, empty_i, empty_b, empty_b, empty_i, -1, -1, -1, -1, empty_i, empty_s, empty_li)

# a named record. the four field lists are parallel and positional:
# fields[i] has type field_types[i] and its `pub`/`mut` flags at the
# same index. all four are copied, so the caller may keep mutating its
# own lists afterwards. the usual sequence is to add an empty shell
# first and set_type_info the filled-in struct after resolving the
# field types, so a field can name the struct's own type. interfaces
# are also registered this way, as a struct with zero fields.
pub fn ti_struct(name: String, fields: List[String], field_types: List[Int], field_pub: List[Bool], field_mut: List[Bool]) -> TypeInfo:
    mut empty_i: List[Int] := []
    mut empty_s: List[String] := []
    mut empty_li: List[List[Int]] := []
    copied_fields := copy_list(fields)
    copied_field_types := copy_list(field_types)
    copied_field_pub := copy_list(field_pub)
    copied_field_mut := copy_list(field_mut)
    return TypeInfo("struct", name, copied_fields, copied_field_types, copied_field_pub, copied_field_mut, empty_i, -1, -1, -1, -1, empty_i, empty_s, empty_li)

# a named sum type. variants and variant_types are parallel: variant i
# carries the payload types listed in variant_types[i], which is empty
# for a variant declared without a payload. unlike ti_struct, neither
# list is copied — the TypeInfo holds the caller's lists.
pub fn ti_enum(name: String, variants: List[String], variant_types: List[List[Int]]) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("enum", name, empty_s, empty_i, empty_b, empty_b, empty_i, -1, -1, -1, -1, empty_i, variants, variant_types)

# an anonymous callable signature — an `fn(...)` annotation, a declared
# function's own type, or a struct's synthesized constructor.
# param_types is copied. the name stays empty on purpose: get_type_name
# prints every function type as "fn". nothing interns these, so two
# identical signatures resolved separately land on different ids and
# must be compared structurally, never by id.
pub fn ti_function(param_types: List[Int], return_type: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    copied_params := copy_list(param_types)
    return TypeInfo("function", "", empty_s, empty_i, empty_b, empty_b, copied_params, return_type, -1, -1, -1, empty_i, empty_s, empty_li)

# `T?`, with T in the `inner` field. a bare `none` is not this type —
# it is TID_NONE, a separate sentinel that is accepted only where an
# optional is expected. like the other unnamed composites, optionals
# are not interned: two `Int?` annotations resolve to two ids, so
# compare them structurally.
pub fn ti_optional(inner: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("optional", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, inner, -1, -1, empty_i, empty_s, empty_li)

# `T!E`. mind the field placement, because there is no dedicated pair:
# the ok type is stored in `inner` and the error type in `value_type`.
# a `T!` annotation with no error type written gets String, filled in
# by the checker before it calls this. not interned.
pub fn ti_result(ok_type: Int, err_type: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("result", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, ok_type, -1, err_type, empty_i, empty_s, empty_li)

# `(A, B, ...)`. `elements` holds the member types in declaration order
# and is stored without copying. tuples are the only kind that uses
# that field — every single-parameter composite uses `inner` instead.
# not interned.
pub fn ti_tuple(elements: List[Int]) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("tuple", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, -1, -1, -1, elements, empty_s, empty_li)

# `List[element]`, with the element type in `inner` (not `elements`,
# which belongs to tuples). prefer intern_list_type over calling this
# and add_type_info yourself: interning gives each distinct element
# type exactly one id, so `List[Int]` written in two modules compares
# equal by id alone.
pub fn ti_list(element: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("list", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, element, -1, -1, empty_i, empty_s, empty_li)

# `Map[key_type, val_type]`, the only kind that fills both `key_type`
# and `value_type`. prefer intern_map_type, which hands back one shared
# id per distinct key/value pair.
pub fn ti_map(key_type: Int, val_type: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("map", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, -1, key_type, val_type, empty_i, empty_s, empty_li)

# `Set[element]`, with the element type in `inner`. prefer
# intern_set_type, which reuses one id per distinct element type.
pub fn ti_set(element: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("set", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, element, -1, -1, empty_i, empty_s, empty_li)

# `Task[inner]` — what `spawn f()` evaluates to, where inner is f's
# return type and awaiting the task unwraps back to it. prefer
# intern_task_type, which reuses one id per distinct inner type.
pub fn ti_task(inner: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("task", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, inner, -1, -1, empty_i, empty_s, empty_li)

# `Channel[inner]`, where inner is the type of the values sent over it.
# prefer intern_channel_type, which reuses one id per distinct payload
# type.
pub fn ti_channel(inner: Int) -> TypeInfo:
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    mut empty_li: List[List[Int]] := []
    return TypeInfo("channel", "", empty_s, empty_i, empty_b, empty_b, empty_i, -1, inner, -1, -1, empty_i, empty_s, empty_li)

# ---------------------------------------------------------------
# type table — global flat list + name map
# ---------------------------------------------------------------

mut tt_types: List[TypeInfo] := []
mut tt_names: Map[String, Int] := {}
# a second, module-qualified view of the same type ids, keyed by
# "module_path<TAB>name". tt_names is a single global namespace, so two
# modules that each declare a struct of the same name overwrite one another
# there (last writer wins). this map keeps every module's own declaration
# reachable, so a name referenced inside module M can resolve to M's struct
# instead of to whichever module registered the name into tt_names last.
mut tt_qualified_names: Map[String, Int] := {}

# add a type to the table, return its id
pub fn add_type_info(info: TypeInfo) -> Int:
    tt_types.push(info)
    return tt_types.len() - 1

# replace the TypeInfo at an existing id. used to fill in a struct's fields
# after its name is already registered, so a field can reference its own type.
pub fn set_type_info(tid: Int, info: TypeInfo):
    tt_types[tid] = info

# register a name -> type id mapping
pub fn register_type_name(name: String, tid: Int):
    tt_names.insert(name, tid)

# also record the mapping under a specific module, so a same-named struct in
# another module cannot hide it. the checker passes the module currently being
# registered; builtins and the entry file use "" and are only global.
pub fn register_qualified_type_name(module_path: String, name: String, tid: Int):
    if module_path.len() == 0:
        return
    tt_qualified_names.insert(module_path + chr(9) + name, tid)

# look up a type by name, returns -1 if not found
pub fn lookup_type_id(name: String) -> Int:
    if tt_names.contains_key(name):
        return tt_names[name]
    return -1

# look up a type declared by a specific module, returns -1 if that module never
# declared the name. used for module-scoped resolution of same-named structs.
pub fn lookup_qualified_type_id(module_path: String, name: String) -> Int:
    key := module_path + chr(9) + name
    if tt_qualified_names.contains_key(key):
        return tt_qualified_names[key]
    return -1

# get the number of types in the table
pub fn get_type_count() -> Int:
    return tt_types.len()

# get type info by id
pub fn get_type_info(tid: Int) -> TypeInfo:
    if tid < 0:
        return TypeInfo("<error>", "", [], [], [], [], [], -1, -1, -1, -1, [], [], [])
    if tid >= tt_types.len():
        return TypeInfo("<error>", "", [], [], [], [], [], -1, -1, -1, -1, [], [], [])
    return tt_types[tid]

# get the human-readable name for a type id
pub fn get_type_name(tid: Int) -> String:
    if tid == TID_INT:
        return "Int"
    if tid == TID_UINT:
        return "UInt"
    if tid == TID_FLOAT:
        return "Float"
    if tid == TID_BOOL:
        return "Bool"
    if tid == TID_STRING:
        return "String"
    if tid == TID_BYTES:
        return "Bytes"
    if tid == TID_VOID:
        return "Void"
    if tid == TID_INT8:
        return "Int8"
    if tid == TID_INT16:
        return "Int16"
    if tid == TID_INT32:
        return "Int32"
    if tid == TID_INT64:
        return "Int64"
    if tid == TID_UINT8:
        return "UInt8"
    if tid == TID_UINT16:
        return "UInt16"
    if tid == TID_UINT32:
        return "UInt32"
    if tid == TID_UINT64:
        return "UInt64"
    if tid == TID_ERR:
        return "<error>"
    if tid == TID_NONE:
        return "none"
    if tid < 0:
        return "<unknown>"
    if tid >= tt_types.len():
        return "<unknown>"
    info := tt_types[tid]
    if info.kind == "struct":
        return info.name
    if info.kind == "enum":
        return info.name
    if info.kind == "primitive":
        return info.name
    if info.kind == "function":
        return "fn"
    if info.kind == "optional":
        return "optional"
    if info.kind == "result":
        return "result"
    if info.kind == "tuple":
        return "tuple"
    if info.kind == "task":
        return "Task"
    if info.kind == "channel":
        return "Channel"
    if info.kind == "list":
        return "List"
    if info.kind == "map":
        return "Map"
    if info.kind == "set":
        return "Set"
    return "<unknown>"

# ---------------------------------------------------------------
# helper predicates
# ---------------------------------------------------------------

# true for Int, UInt, Float and the eight sized integer types; false
# for everything else, including Bool, String, Void and every user
# type. the checker gates the arithmetic and ordering operators on
# this. it re-resolves each builtin by name through the type table on
# every call instead of comparing against the TID_* constants, so it
# only answers correctly once initialize_type_table has run.
pub fn is_numeric_type(tid: Int) -> Bool:
    tid_int := lookup_type_id("Int")
    tid_uint := lookup_type_id("UInt")
    tid_float := lookup_type_id("Float")
    tid_int8 := lookup_type_id("Int8")
    tid_int16 := lookup_type_id("Int16")
    tid_int32 := lookup_type_id("Int32")
    tid_int64 := lookup_type_id("Int64")
    tid_uint8 := lookup_type_id("UInt8")
    tid_uint16 := lookup_type_id("UInt16")
    tid_uint32 := lookup_type_id("UInt32")
    tid_uint64 := lookup_type_id("UInt64")
    if tid == tid_int:
        return true
    if tid == tid_uint:
        return true
    if tid == tid_float:
        return true
    if tid == tid_int8:
        return true
    if tid == tid_int16:
        return true
    if tid == tid_int32:
        return true
    if tid == tid_int64:
        return true
    if tid == tid_uint8:
        return true
    if tid == tid_uint16:
        return true
    if tid == tid_uint32:
        return true
    if tid == tid_uint64:
        return true
    return false

# is_numeric_type minus Float — Int, UInt and the eight sized integer
# types. use it where a whole number is required and a Float is not
# good enough, such as a string, bytes, or list index. same name-based
# lookup, so the same dependency on initialize_type_table.
pub fn is_integer_type(tid: Int) -> Bool:
    tid_int := lookup_type_id("Int")
    tid_uint := lookup_type_id("UInt")
    tid_int8 := lookup_type_id("Int8")
    tid_int16 := lookup_type_id("Int16")
    tid_int32 := lookup_type_id("Int32")
    tid_int64 := lookup_type_id("Int64")
    tid_uint8 := lookup_type_id("UInt8")
    tid_uint16 := lookup_type_id("UInt16")
    tid_uint32 := lookup_type_id("UInt32")
    tid_uint64 := lookup_type_id("UInt64")
    if tid == tid_int:
        return true
    if tid == tid_uint:
        return true
    if tid == tid_int8:
        return true
    if tid == tid_int16:
        return true
    if tid == tid_int32:
        return true
    if tid == tid_int64:
        return true
    if tid == tid_uint8:
        return true
    if tid == tid_uint16:
        return true
    if tid == tid_uint32:
        return true
    if tid == tid_uint64:
        return true
    return false

# true only for the sentinel the checker returns from an expression it
# could not type. that sentinel is TID_ERR == 15, an ordinary positive
# id, so `tid >= 0` is not a valid "did this type check" test — this
# is. checker guards skip their comparison when either side is the
# error type, which is what stops one bad expression from producing a
# cascade of follow-on messages.
pub fn is_error_type(tid: Int) -> Bool:
    return tid == lookup_type_id("<error>")

# true for the bare-`none` sentinel. `none` carries no type of its own, so it
# only satisfies a target that is already an optional.
pub fn is_none_type(tid: Int) -> Bool:
    return tid == TID_NONE

# ---------------------------------------------------------------
# initialization — register all 17 builtin types
# ---------------------------------------------------------------

# throw away the whole table and re-seed it with the 17 builtins, in
# the order that puts each one at the index its TID_* constant names —
# the checker and the IR emitter both hard-code those ids, so the order
# here is load-bearing. everything else in this file assumes it has
# run. initialize_checker calls it once per check run; several modules
# checked in one run deliberately share the table, so do not call it
# between them or the earlier modules' types disappear.
pub fn initialize_type_table():
    tt_types = []
    tt_names = {}
    tt_qualified_names = {}
    # primitives at known indices 0-14
    add_type_info(ti_primitive("Int"))
    register_type_name("Int", TID_INT)
    add_type_info(ti_primitive("UInt"))
    register_type_name("UInt", TID_UINT)
    add_type_info(ti_primitive("Float"))
    register_type_name("Float", TID_FLOAT)
    add_type_info(ti_primitive("Bool"))
    register_type_name("Bool", TID_BOOL)
    add_type_info(ti_primitive("String"))
    register_type_name("String", TID_STRING)
    add_type_info(ti_primitive("Bytes"))
    register_type_name("Bytes", TID_BYTES)
    add_type_info(ti_primitive("Void"))
    register_type_name("Void", TID_VOID)
    add_type_info(ti_primitive("Int8"))
    register_type_name("Int8", TID_INT8)
    add_type_info(ti_primitive("Int16"))
    register_type_name("Int16", TID_INT16)
    add_type_info(ti_primitive("Int32"))
    register_type_name("Int32", TID_INT32)
    add_type_info(ti_primitive("Int64"))
    register_type_name("Int64", TID_INT64)
    add_type_info(ti_primitive("UInt8"))
    register_type_name("UInt8", TID_UINT8)
    add_type_info(ti_primitive("UInt16"))
    register_type_name("UInt16", TID_UINT16)
    add_type_info(ti_primitive("UInt32"))
    register_type_name("UInt32", TID_UINT32)
    add_type_info(ti_primitive("UInt64"))
    register_type_name("UInt64", TID_UINT64)
    # error sentinel at index 15
    add_type_info(ti_primitive("<error>"))
    register_type_name("<error>", TID_ERR)
    # bare-`none` sentinel at index 16. deliberately not registered under a
    # source-visible name: `none` is a value, never something to annotate with.
    add_type_info(ti_primitive("none"))
