# an error about one name of a from-import points at that name, wherever it
# sits on the line, and an unknown enum variant points at the variant rather
# than at the enum written before it.

from std.math import missing_fn, sqrt

enum Local:
    A
    B(Int)

fn main():
    print(sqrt(4.0).to_string())
    a := Local.Nope
    b := Local.Gone(1)
    c := Local.A
    match c:
        Local.Lost => print("lost")
        _ => print("other")
