# --- current function locals ---
mut ir_map_value_types: Map[String, String] := {} # map variable name -> value type

# enums with at least one payload-carrying variant are boxed: a value is a
# heap struct with the tag in slot 0 and payload values in slots 1..n.
# payload-free enums stay plain integer tags.

# checked tid of the innermost match subject, for tuple-pattern element
# types; set by the match emitters before lowering arms
# declared return kinds of closure-typed parameters in the current
# function: `key: fn(T) -> String` records "string" under "key", so a
# call through the parameter infers its result kind even where checked
# types are suppressed (generic bodies)
mut ir_closure_return_kinds: Map[String, String] := {}

# rc-managed locals owned by the current function, in binding order, with a
# parallel kind list (string/list/map/set). collected by a pre-pass before
# the body emits so every name can be zero-stored in the prologue; that
# makes the release loads at each return valid on every path (releasing 0
# is a no-op). lists, not maps, so cleanup order is deterministic and the
# emitted ir stays bootstrap-stable.
mut ir_string_locals: List[String] := []
mut ir_rc_local_kinds: List[String] := []

# --- module globals collected during the prepass ---

# --- type and symbol metadata copied from the checker ---

mut ir_local_struct_names: List[String] := [] # structs declared by this module
mut ir_dtor_memo: Map[String, Int] := {} # 1 needs dtor, 2 no/undecided
mut ir_tuple_dtor_sigs: List[String] := [] # rc-element signatures seen this module

mut ir_func_result_ok_kinds: Map[String, String] := {}
mut ir_named_fn_value_wrappers: Map[String, String] := {}
mut ir_lambda_count := 0
mut ir_for_count := 0
mut ir_break_stack: List[String] := []
mut ir_continue_stack: List[String] := []
mut ir_lambda_bodies: List[String] := [] # deferred lambda function IR
mut ir_module_count := 0 # increments per emit_ir call for unique naming

# Per-instantiation specialized impl method names, kept separate from
# ir_impl_methods because that map is reset between modules and would wipe
# specializations registered during an earlier module's emission. Key is
# "InstanceType.method" (e.g. "MapIter[Range,Int,Int].next") and value is the
# specialized symbol name. Read via ir_lookup_specialized_method.

mut ir_current_func_optional_inner_kind := ""

# True while emitting the body of a function that returns a Result (T! or
# T!E). Used by the index expression codegen to decide whether `map[k]` /
# `list[i]` should propagate a fail on miss (T! context) or fall through
# to the loud-miss runtime (non-T! context).
mut ir_current_func_returns_result := false
# the impl block's target type, set while a method body is being emitted, so
# `self.field = ...` knows what struct fields to look up
mut ir_current_impl_type := ""
# When a specialized impl method body is being emitted these hold the struct's
# generic param names and the concrete type names for this instantiation, so
# `self.field` references whose declared type is a struct param (`I`, `T`, `U`)
# resolve to the right concrete type for dispatch (e.g., `Range` not `I`).
mut ir_current_impl_subst_params: List[String] := []
mut ir_current_impl_subst_args: List[String] := []
# per-instance destructors needed for generic structs built via the backend
# constructor call (`Name[params](...)` inside a generic function). keyed by the
# sanitized instance symbol: one map holds the base struct name, the other the
# instance's concrete type-arg names (joined by chr(1), which never appears in a
# type name) so the destructor body can substitute them into each field type.
mut ir_generic_dtor_base: Map[String, String] := {}
mut ir_generic_dtor_args: Map[String, String] := {}
mut ir_preloaded_import_roots: List[Int] := []
mut ir_preloaded_import_paths: List[String] := []
mut ir_emit_tests := false
mut ir_emitting_test_func := false

pub fn set_import_roots(roots: List[Int], paths: List[String]):
    ir_preloaded_import_roots = roots
    ir_preloaded_import_paths = paths

pub fn set_test_mode(enabled: Bool):
    ir_emit_tests = enabled

fn ir_reset_local_state():
    ir_builder_reset()
    ir_builder_set_string_module_count(ir_module_count)
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()
    ir_map_value_types = {}

fn ir_reset_global_state():
    ir_global_int_names = []
    ir_global_string_names = []
    ir_global_list_string_names = []
    ir_global_list_names = []
    ir_global_map_names = []
    ir_global_map_int_names = []
    ir_global_map_value_types = {}
    ir_global_set_names = []
    ir_global_set_int_names = []
    ir_global_bool_names = []

fn ir_reset_type_state():
    ir_local_struct_names = []
    ir_dtor_memo = {}
    ir_tuple_dtor_sigs = []
    ir_struct_names.clear()
    ir_struct_field_lookup.clear()
    ir_struct_field_index_lookup.clear()
    ir_struct_decl_nodes.clear()
    ir_struct_field_default_nodes.clear()
    ir_impl_methods.clear()
    ir_import_renames = {}
    ir_func_returns.clear()
    ir_func_result_ok_kinds = {}
    ir_named_fn_value_wrappers = {}
    ir_module_aliases = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    ir_current_func_return_kind = ""
    ir_current_func_optional_inner_kind = ""
    ir_current_func_returns_result = false
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}
    ir_generic_specialization_keys = []
    ir_generic_specialization_names = {}
    ir_generic_specialization_type_lists = {}
    ir_generic_emitted_specializations = {}
    ir_active_generic_params = []
    ir_active_generic_concrete_types = []
    ir_active_generic_module_path = ""

fn ir_reset_control_flow_state():
    ir_break_stack = []
    ir_continue_stack = []

pub fn ir_reset():
    ir_reset_local_state()
    ir_reset_global_state()
    ir_reset_type_state()
    ir_reset_control_flow_state()

fn ir_lookup_map_value_type(name: String) -> String:
    if ir_map_value_types.contains_key(name):
        return ir_map_value_types[name]
    return ""

fn ir_lookup_map_value_type_for_expr(idx: Int) -> String:
    return ir_lookup_map_value_type_for_expr_with_state(idx, ir_map_value_types)

# the ir return kind of a struct's fn-value field (e.g. `make: fn() -> T!`),
# or "" when the field isn't a fn_type. a `self.make()` call is a closure-field
# call, not a method, so this lets its result kind be reported correctly — a
# Result-returning factory forwards its result instead of being re-wrapped.
fn ir_struct_fn_field_return_kind(struct_name: String, field_name: String) -> String:
    if not ir_struct_decl_nodes.contains_key(struct_name):
        return ""
    decl := get_node(ir_struct_decl_nodes[struct_name])
    for child in decl.children:
        field_node := ir_unwrap_pub_node(child)
        if field_node.kind == "field" and ir_struct_field_name(field_node) == field_name:
            if field_node.children.len() > 0:
                tn := get_node(field_node.children[0])
                if tn.kind == "fn_type" and tn.children.len() > 0:
                    last := get_node(tn.children[tn.children.len() - 1])
                    if last.kind == "returns" and last.children.len() > 0:
                        return ir_resolve_type_node(last.children[0])
    return ""

fn ir_expr_result_kind(idx: Int) -> String:
    checked_kind := ir_checked_result_kind(idx)
    if checked_kind.len() > 0:
        return checked_kind
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        # a call through a fn-value local (`f()` where `f := self.make`) carries
        # its recorded closure return kind, so a `fn() -> T!` factory forwards
        # its Result rather than getting re-wrapped.
        fn_local := get_node(node.children[0])
        if fn_local.kind == "ident" and ir_closure_return_kinds.contains_key(fn_local.value):
            return ir_closure_return_kinds[fn_local.value]
        mut callee := ir_resolve_static_callee(node.children[0])
        if callee.name.len() > 0:
            if ir_is_generic_function_name(callee.name):
                mut explicit_generic_types: List[String] := []
                callee_node := get_node(node.children[0])
                if callee_node.kind == "index":
                    explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
                mut concrete_types := explicit_generic_types
                if concrete_types.len() == 0:
                    concrete_types = ir_infer_generic_concrete_types(callee.name, node)
                mut generic_ret_type := ir_checked_type(idx)
                if generic_ret_type.len() == 0:
                    generic_ret_type = ir_infer_type(idx)
                ir_record_generic_spec_arg_tids(callee.name, concrete_types, ir_generic_arg_tids(node))
                callee = ResolvedCallee(ir_queue_generic_specialization(callee.name, concrete_types, generic_ret_type), false)
            declared_kind := ir_declared_callable_ir_retkind(callee.name)
            if declared_kind.len() > 0:
                return declared_kind
            builtin_kind := ir_builtin_result_retkind(callee.name)
            if builtin_kind.len() > 0:
                return builtin_kind
        return ir_expr_legacy_result_kind(idx)
    if node.kind == "method_call":
        mut call_name := ir_resolve_module_alias_method_call_name(idx)
        if call_name.len() > 0:
            if ir_is_generic_function_name(call_name):
                mut generic_ret_type := ir_checked_type(idx)
                if generic_ret_type.len() == 0:
                    generic_ret_type = ir_infer_type(idx)
                call_name = ir_queue_generic_specialization(call_name, ir_infer_generic_concrete_types(call_name, node), generic_ret_type)
            declared_kind := ir_declared_callable_ir_retkind(call_name)
            if declared_kind.len() > 0:
                return declared_kind
            builtin_kind := ir_builtin_result_retkind(call_name)
            if builtin_kind.len() > 0:
                return builtin_kind
            return ir_expr_legacy_result_kind(idx)
        obj_type := ir_method_receiver_type(node)
        method_name := ir_plain_method_name(node.value)
        impl_name := ir_lookup_impl_method_name(obj_type, method_name)
        if impl_name.len() > 0:
            declared_kind := ir_declared_callable_ir_retkind(impl_name)
            if declared_kind.len() > 0:
                return declared_kind
        # `self.make()` inside a generic impl where `make` is a closure field:
        # no method of that name, so the result kind is the field's declared
        # fn_type return kind. without this a `fn() -> T!` factory reads back as
        # "unknown" and its Result gets wrapped in a second Result.
        if impl_name.len() == 0 and ir_current_impl_type.len() > 0:
            recv_node := get_node(node.children[0])
            if recv_node.kind == "self":
                field_kind := ir_struct_fn_field_return_kind(ir_strip_type_args(ir_current_impl_type), method_name)
                if field_kind.len() > 0:
                    return field_kind
        emit_name := ir_method_emit_name(method_name, obj_type)
        declared_kind := ir_declared_callable_ir_retkind(emit_name)
        if declared_kind.len() > 0:
            return declared_kind
        builtin_kind := ir_builtin_result_retkind(emit_name)
        if builtin_kind.len() > 0:
            return builtin_kind
    return ir_expr_legacy_result_kind(idx)

fn ir_generic_result_ok_kind(name: String, concrete_types: List[String]) -> String:
    if not ir_generic_decl_indices.contains_key(name):
        return ""
    decl_idx := ir_generic_decl_indices[name]
    decl_node := get_node(decl_idx)
    generic_params := ir_collect_generic_param_names(decl_node)
    for child in decl_node.children:
        returns_node := get_node(child)
        if returns_node.kind != "returns":
            continue
        for type_idx in returns_node.children:
            type_node := get_node(type_idx)
            if type_node.kind == "result" or type_node.kind == "result_type":
                if type_node.children.len() > 0:
                    return ir_retkind(ir_resolve_type_node_with_subst(type_node.children[0], generic_params, concrete_types))
    return ""

fn ir_result_ok_kind_for_expr(idx: Int) -> String:
    tid := c_get_expr_type(idx)
    if tid >= 0:
        field_kind := ir_result_field_kind(tid, "ok")
        if field_kind != "unknown":
            return field_kind
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        mut callee := ir_resolve_static_callee(node.children[0])
        if callee.name.len() == 0:
            return ""
        if ir_is_generic_function_name(callee.name):
            mut explicit_generic_types: List[String] := []
            callee_node := get_node(node.children[0])
            if callee_node.kind == "index":
                explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
            mut concrete_types := explicit_generic_types
            if concrete_types.len() == 0:
                concrete_types = ir_infer_generic_concrete_types(callee.name, node)
            result_ok_kind := ir_generic_result_ok_kind(callee.name, concrete_types)
            if result_ok_kind.len() > 0:
                return result_ok_kind
        if ir_func_result_ok_kinds.contains_key(callee.name):
            return ir_retkind(ir_func_result_ok_kinds[callee.name])
        return ir_builtin_result_ok_kind(callee.name)
    if node.kind == "method_call":
        call_name := ir_resolve_module_alias_method_call_name(idx)
        if call_name.len() > 0:
            if ir_func_result_ok_kinds.contains_key(call_name):
                return ir_retkind(ir_func_result_ok_kinds[call_name])
            return ir_builtin_result_ok_kind(call_name)
        obj_type := ir_method_receiver_type(node)
        method_name := ir_plain_method_name(node.value)
        impl_name := ir_lookup_impl_method_name(obj_type, method_name)
        if impl_name.len() > 0 and ir_func_result_ok_kinds.contains_key(impl_name):
            return ir_retkind(ir_func_result_ok_kinds[impl_name])
        emit_name := ir_method_emit_name(method_name, obj_type)
        if ir_func_result_ok_kinds.contains_key(emit_name):
            return ir_retkind(ir_func_result_ok_kinds[emit_name])
        return ir_builtin_result_ok_kind(emit_name)
    return ""

fn ir_emit_result_ok_field_for_expr(obj_r: Int, expr_idx: Int) -> Int:
    mut field_kind := ir_result_ok_kind_for_expr(expr_idx)
    if field_kind.len() == 0:
        field_kind = "unknown"
    r := ir_reg()
    ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 8 " + field_kind + " ok")
    return r

fn ir_find_free_vars(idx: Int, bound: List[String]) -> List[String]:
    # ir_var_regs holds the enclosing scope's live variables, so a captured name
    # that shadows a same-named global is recognized as a real local.
    return ir_capture_find_free_vars(idx, bound, ir_capture_blocked_names(), ir_var_regs)

# --- collect strings (iterative to avoid deep recursion crashes) ---
fn ir_collect_strings(idx: Int):
    nodes := ir_cached_string_nodes(idx)
    for node_idx in nodes:
        ir_str(get_node(node_idx).value)

fn ir_struct_field_name(field_node: Node) -> String:
    mut field_name := field_node.value
    if field_name.contains(" "):
        field_name = field_name.split(" ")[0]
    return field_name

fn ir_collect_struct_field_strings(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        actual := ir_unwrap_pub_node(item_idx)
        if actual.kind == "struct_decl" or actual.kind == "struct":
            # the string table is emitted before function bodies, so the
            # labels the synthesized struct display uses must be interned
            # here, not when the display code emits.
            ir_str(actual.value + "(")
            ir_str(")")
            ir_str("...")
            # the single-pass json decoder references a packed field spec;
            # intern it here so the strref resolves. built by the same
            # function the decoder uses, so the strings match exactly.
            ir_str(ir_json_decode_spec_from_decl(actual))
            mut first := true
            for child in actual.children:
                field_node := get_node(child)
                if field_node.kind == "field":
                    fname := ir_struct_field_name(field_node)
                    ir_str(fname)
                    if first:
                        ir_str(fname + ": ")
                        first = false
                    else:
                        ir_str(", " + fname + ": ")

fn ir_is_sync_primitive_name(name: String) -> Bool:
    return name == "Mutex" or name == "WaitGroup" or name == "Semaphore" or name == "AtomicInt"

fn ir_emit_func_header(name: String, param_count: Int, ret_type: String):
    ir_emit("func " + name + " " + param_count.to_string() + " " + ir_retkind(ret_type))

# true when any variant of a boxed enum carries an rc payload, so the enum
# needs a tag-aware destructor to release it.
fn ir_enum_needs_dtor(ename: String) -> Bool:
    if not ir_enum_variant_lists.contains_key(ename):
        return false
    for variant in ir_enum_variant_lists[ename].split(","):
        vkey := ename + "." + variant
        if ir_enum_payload_kinds.contains_key(vkey):
            for pk in ir_enum_payload_kinds[vkey].split(","):
                if ir_rc_field_kind(pk).len() > 0:
                    return true
    return false

fn ir_struct_needs_dtor(raw_name: String) -> Bool:
    sname := ir_struct_base_name(raw_name)
    if ir_dtor_memo.contains_key(sname):
        return ir_dtor_memo[sname] == 1
    # mark first so self-referential fields don't recurse forever; a
    # direct rc field still sets the final answer below
    ir_dtor_memo.insert(sname, 2)
    # a boxed enum is a struct-shaped allocation but its releasable slots are
    # tagged payloads, not declared fields, so answer from the variants.
    if ir_boxed_enums.contains_key(sname):
        enum_needs := ir_enum_needs_dtor(sname)
        if enum_needs:
            ir_dtor_memo.insert(sname, 1)
        return enum_needs
    count := ir_struct_field_count(sname)
    mut i := 0
    mut needs := false
    while i < count:
        fname := ir_struct_field_name_at(sname, i)
        ftype := ir_struct_field_type_name(sname, fname)
        if ir_rc_field_kind(ftype).len() > 0:
            needs = true
        i = i + 1
    if needs:
        ir_dtor_memo.insert(sname, 1)
    return needs

# rc kind of a struct FIELD by its recorded type: like ir_rc_kind plus
# nested structs (a field holding a dtor-bearing struct is releasable)
fn ir_rc_field_kind(ftype: String) -> String:
    base := ir_rc_kind(ftype)
    if base.len() > 0:
        return base
    if ftype.starts_with("struct:"):
        if ir_struct_needs_dtor(ftype.substring(7, ftype.len())):
            return "struct"
    return ""

# a map target whose value type is string picks the heap-value
# constructor for empty literals, so runtime inserts retain
fn ir_map_init_target(name: String, target_type: String) -> String:
    mut val_type := ir_lookup_map_value_type(name)
    if val_type.len() == 0 and ir_global_map_value_types.contains_key(name):
        val_type = ir_global_map_value_types[name]
    if val_type == "string":
        if target_type == "map":
            return "map_str_val"
        if target_type == "map_int":
            return "map_int_str_val"
    return target_type

fn ir_rc_local_kind(name: String) -> String:
    mut i := 0
    while i < ir_string_locals.len():
        if ir_string_locals[i] == name and i < ir_rc_local_kinds.len():
            return ir_rc_local_kinds[i]
        i = i + 1
    return ""

fn ir_rc_track_local(name: String, kind: String):
    if not ir_string_locals.contains(name):
        ir_string_locals.push(name)
        ir_rc_local_kinds.push(kind)

# true when the expression reads a value some other owner keeps a count
# for: variables, collection elements, struct fields. anything else that
# produces a string (concat, substring, to_string, ...) hands us a fresh
# owned count.
fn ir_string_expr_is_borrowed(idx: Int) -> Bool:
    node := get_node(idx)
    # only expressions that provably mint a fresh buffer are owned: string
    # literals (retain is a no-op for them anyway), concatenation, string
    # interpolation, and methods known to build new strings. everything
    # else — variables, extractions, calls, match values — counts as
    # borrowed. over-classifying as borrowed can only over-retain (a leak);
    # the reverse dangles a pointer.
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return false
    if node.kind == "index" and node.children.len() > 0:
        # s[i] on a string mints a fresh char (char_at); container indexing
        # borrows the element. mirrors ir_emit_index_expr's dispatch.
        if ir_expr_is_fresh_string_index(idx):
            return false
        return true
    if node.kind == "binary" or node.kind == "interp" or node.kind == "string_interp":
        return false
    if node.kind == "grouped" and node.children.len() > 0:
        return ir_string_expr_is_borrowed(node.children[0])
    # a try (!) unwraps its inner result: ownership classification follows
    # the wrapped expression (a transferred call result stays owned)
    if (node.kind == "try" or node.kind == "try_expr") and node.children.len() > 0:
        inner := get_node(node.children[0])
        if inner.kind == "call" or inner.kind == "method_call":
            # the unwrapped ok value is a transfer: result returns route
            # through the same retain-borrowed-returns convention
            return false
        return ir_string_expr_is_borrowed(node.children[0])
    # collection literals mint fresh containers, and collection-typed call
    # results arrive with a transferred count (user returns exclude the
    # local, runtime producers build new containers). variable, element,
    # and field reads stay borrows.
    if node.kind == "list" or node.kind == "map" or node.kind == "set":
        return false
    if node.kind == "struct_init":
        return false
    # a tuple literal mints a fresh struct:tuple allocation with its own
    # count, the same as a struct_init.
    if node.kind == "tuple":
        return false
    # a lambda mints a fresh closure with its own count; returning or
    # binding it transfers that count rather than borrowing one.
    if node.kind == "lambda":
        return false
    if node.kind == "call" and ir_infer_type(idx) == "string":
        return false
    if node.kind == "call" or node.kind == "method_call":
        expr_kind := ir_rc_kind(ir_infer_type(idx))
        if expr_kind == "list" or expr_kind == "map" or expr_kind == "set" or expr_kind == "bytes" or expr_kind == "struct" or expr_kind == "closure" or expr_kind == "tuple":
            return false
    if node.kind == "method_call":
        # a user-defined method already settled its result's ownership on the
        # way out: it retains a returned borrow and transfers a fresh value, so
        # the result arrives owned — the caller must not retain it again (that
        # over-retain is a leak when the method returns a fresh string). only
        # builtin string methods, which don't route through that return path,
        # fall back to the known-fresh list.
        mname := ir_plain_method_name(node.value)
        if ir_lookup_impl_method_name(ir_method_receiver_type(node), mname).len() > 0:
            return false
        return not ir_string_method_returns_fresh(mname)
    return true

fn ir_string_method_returns_fresh(mname: String) -> Bool:
    if mname == "to_string" or mname == "trim" or mname == "substring":
        return true
    if mname == "to_upper" or mname == "to_lower" or mname == "reverse":
        return true
    if mname == "join" or mname == "repeat" or mname == "replace":
        return true
    if mname == "trim_left" or mname == "trim_right" or mname == "char_at":
        return true
    if mname == "pop":
        return true
    return false

# release every owned string local before a return, minus the one being
# returned (its count transfers to the caller). the prologue zero-stores
# each tracked name, so the loads are valid on every path.
fn ir_emit_string_cleanup(exclude: String):
    mut i := 0
    while i < ir_string_locals.len():
        name := ir_string_locals[i]
        mut kind := "string"
        if i < ir_rc_local_kinds.len():
            kind = ir_rc_local_kinds[i]
        if name != exclude and ir_rc_release_enabled(kind):
            r := ir_reg()
            ir_emit("load " + r.to_string() + " " + ir_resolve_storage_name(name))
            ir_rc_release_reg(r, kind)
        i = i + 1

# pre-pass: names of string-typed binds anywhere in the body. an
# under-approximation is safe — a missed name is never released (a leak),
# while emission-time classification only widens, never narrows, so every
# collected name really does hold owned counts.
fn ir_string_prepass_bind_type(parts: IrBindParts, names: List[String]) -> String:
    mut bind_type := ""
    if parts.type_idx >= 0:
        bind_type = ir_resolve_type_node(parts.type_idx)
    if bind_type.len() == 0 and parts.val_idx >= 0:
        # the collected names double as a type environment: a bind from an
        # already-collected name chains its tracking (and kind), so a later
        # rebind of the source cannot release a value this variable shares.
        val_node := get_node(parts.val_idx)
        if val_node.kind == "ident" and names.contains(val_node.value):
            bind_type = ir_rc_local_kind(val_node.value)
        else:
            # the checker's recorded type resolves module-qualified calls
            # (bytes.from_string_utf8 and friends) that local inference
            # cannot; inference stays as the fallback
            bind_type = ir_checked_type(parts.val_idx)
            if bind_type.len() == 0:
                bind_type = ir_infer_type(parts.val_idx)
            # in a generic impl body the checker suppresses the struct's type
            # params, so a bind from a method/call comes back with no rc kind
            # (or an unresolved optional). the emitter's own result kind still
            # resolves — the impl-subst context is active during the prologue —
            # and it is exactly the lowered kind the exit cleanup releases.
            if ir_rc_kind(bind_type).len() == 0 and (val_node.kind == "method_call" or val_node.kind == "call"):
                bind_type = ir_expr_result_kind(parts.val_idx)
            # `c := self.list[i]` on a generic list field: the checked/inferred
            # element type is suppressed to "unknown", so recover the element
            # type name from the field's declared `List[T]` node (the caller
            # substitutes T -> concrete). without this the element isn't tracked
            # and the returned value dangles once the list is mutated.
            if ir_rc_kind(ir_substitute_type_name(bind_type)).len() == 0 and val_node.kind == "index" and val_node.children.len() > 0 and ir_current_impl_type.len() > 0:
                list_node := get_node(val_node.children[0])
                if list_node.kind == "field_access":
                    elem := ir_self_list_field_element(list_node.value)
                    if elem.len() > 0:
                        bind_type = elem
    return bind_type

# the element type name of a `self`-list field declared `List[T]` on the
# current generic impl's struct (e.g. "T"/"C"), or "". reads the declaration
# node because the resolved field kind is just "list".
fn ir_self_list_field_element(field_name: String) -> String:
    if ir_current_impl_type.len() == 0:
        return ""
    base := ir_strip_type_args(ir_current_impl_type)
    if not ir_struct_decl_nodes.contains_key(base):
        return ""
    decl := get_node(ir_struct_decl_nodes[base])
    for child in decl.children:
        fnode := ir_unwrap_pub_node(child)
        if fnode.kind == "field" and ir_struct_field_name(fnode) == field_name:
            if fnode.children.len() > 0:
                tnode := get_node(fnode.children[0])
                if tnode.kind == "generic_type" and tnode.value == "List" and tnode.children.len() > 0:
                    return get_node(tnode.children[0]).value
    return ""

fn ir_collect_string_bind_names(idx: Int, names: List[String], poisoned: List[String]):
    node := get_node(idx)
    if ir_is_binding_kind(node.kind):
        parts := ir_collect_bind_parts(node)
        if parts.name.len() > 0:
            # substitute struct params (C -> the concrete type) so a bind of a
            # generic element (c := list[i] in a generic impl) is tracked and
            # retained; otherwise the element frees when the list is mutated and
            # the returned value dangles. no-op outside a specialized body.
            kind := ir_rc_kind(ir_substitute_type_name(ir_string_prepass_bind_type(parts, names)))
            if kind.len() > 0:
                if names.contains(parts.name):
                    if ir_rc_local_kind(parts.name) != kind and not poisoned.contains(parts.name):
                        # same name, different rc kind in a sibling branch:
                        # tracking it would fire the wrong retain/release at
                        # runtime. drop it — a leak, never a wild pointer.
                        poisoned.push(parts.name)
                else:
                    ir_rc_track_local(parts.name, kind)
            elif not poisoned.contains(parts.name):
                # bound with a non-rc (or unknown) type somewhere: same rule.
                poisoned.push(parts.name)
    # a match arm's payload bindings are owned locals too: ir_match_emit
    # retains each rc payload, so track them here for the exit cleanup to
    # release (or transfer on escape), same as any other owned local.
    if node.kind == "pat_variant" and node.children.len() > 0:
        mut variant_kinds: List[String] := []
        if ir_enum_payload_kinds.contains_key(node.value):
            variant_kinds = ir_enum_payload_kinds[node.value].split(",")
        for sub_idx, pi in node.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                mut payload_kind := ""
                if pi < variant_kinds.len():
                    payload_kind = ir_rc_kind(variant_kinds[pi])
                if payload_kind.len() > 0:
                    if names.contains(sub.value):
                        if ir_rc_local_kind(sub.value) != payload_kind and not poisoned.contains(sub.value):
                            poisoned.push(sub.value)
                    else:
                        ir_rc_track_local(sub.value, payload_kind)
    for child in node.children:
        ir_collect_string_bind_names(child, names, poisoned)

# prologue for the collected names: zero-store each one and retain string
# params (params are locals under the same rule, so the exit cleanup
# releasing them stays balanced with the caller's count).
mut ir_current_arc_func := ""

# params are borrows: the caller keeps its count alive for the whole call,
# so an unmodified string param needs no rc traffic at all. a param the
# body reassigns becomes an owned local — retained in the prologue so
# release-on-reassign and exit cleanup stay balanced with the caller.
fn ir_collect_reassigned_string_params(idx: Int, names: List[String]):
    node := get_node(idx)
    mut target := ""
    if node.kind == "assign":
        target = node.value
    elif node.kind == "assignment" and node.children.len() > 0:
        tn := get_node(node.children[0])
        if tn.kind == "ident":
            target = tn.value
    if target.len() > 0 and not names.contains(target):
        if ir_var_regs.contains_key(target):
            kind := ir_rc_kind(ir_lookup_name_type(target))
            if kind.len() > 0:
                ir_rc_track_local(target, kind)
    for child in node.children:
        ir_collect_reassigned_string_params(child, names)

fn ir_emit_string_prologue(body_idx: Int):
    mut poisoned: List[String] := []
    if body_idx >= 0:
        ir_collect_reassigned_string_params(body_idx, ir_string_locals)
        ir_collect_string_bind_names(body_idx, ir_string_locals, poisoned)
    if poisoned.len() > 0:
        mut kept: List[String] := []
        mut kept_kinds: List[String] := []
        mut pi := 0
        while pi < ir_string_locals.len():
            if not poisoned.contains(ir_string_locals[pi]):
                kept.push(ir_string_locals[pi])
                if pi < ir_rc_local_kinds.len():
                    kept_kinds.push(ir_rc_local_kinds[pi])
                else:
                    kept_kinds.push("string")
            pi = pi + 1
        ir_string_locals = kept
        ir_rc_local_kinds = kept_kinds
    mut i := 0
    while i < ir_string_locals.len():
        name := ir_string_locals[i]
        if ir_var_regs.contains_key(name):
            # param: retain the caller's value, no zero-store
            r := ir_reg()
            ir_emit("load " + r.to_string() + " " + ir_resolve_storage_name(name))
            ir_rc_retain_reg(r, ir_rc_local_kind(name))
        else:
            z := ir_reg()
            ir_emit("iconst " + z.to_string() + " 0")
            ir_emit("store " + ir_resolve_storage_name(name) + " " + z.to_string())
        i = i + 1

fn ir_ident_callee(name: String) -> ResolvedCallee:
    return ir_ident_callee_with_state(name, ir_import_renames, ir_active_generic_module_path, ir_import_declared_functions)

fn ir_resolve_static_callee(idx: Int) -> ResolvedCallee:
    return ir_resolve_static_callee_with_state(idx, ir_import_renames, ir_active_generic_module_path, ir_module_aliases, ir_import_declared_functions, ir_import_declared_globals)

fn ir_is_local_generic_callee(index_idx: Int, member_name: String, first_param_name: String) -> Bool:
    index_node := get_node(index_idx)
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind != "ident" or base_node.value != member_name:
        return false
    if not ir_generic_decl_indices.contains_key(member_name):
        return false
    return ir_param_name_at(ir_generic_decl_indices[member_name], 0) == first_param_name

fn ir_callee_uses_result_abi(callee: ResolvedCallee, idx: Int) -> Bool:
    raw_kind := ir_declared_callable_ir_retkind(callee.name)
    if raw_kind == "tuple" or raw_kind == "result_int" or raw_kind == "result_bool":
        return true
    return ir_builtin_result_retkind(callee.name).len() > 0

fn ir_temp_name(prefix: String) -> String:
    return prefix + "_" + ir_label()

fn ir_collect_call_arg_regs(node: Node, start_idx: Int) -> List[Int]:
    mut arg_regs: List[Int] := []
    for child, i in node.children:
        if i < start_idx:
            continue
        child_kind := node_kind(child)
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                arg_regs.push(ir_expr(cn.children[0]))
        else:
            arg_regs.push(ir_expr(child))
    return arg_regs

# owned string arguments (fresh chars from s[i], concat results, fresh
# method results) die once the call they fed returns: callees borrow their
# params, and storing callees add their own count. pairs registers with the
# same child walk ir_collect_call_arg_regs used.
# method variant: pairs registers with ir_method_call_arg_expr so the walk
# can never drift from the collector's. skip_pos marks a container-store
# argument: ownership transfers to the container there, and releasing it
# would dangle when the container is untagged and cannot retain.
fn ir_release_owned_method_args(node: Node, arg_regs: List[Int], skip_pos: Int):
    for reg, i in arg_regs:
        if i == skip_pos:
            continue
        expr_idx := ir_method_call_arg_expr(node, i)
        if expr_idx >= 0:
            ir_release_owned_string_operand(expr_idx, reg, ir_infer_type(expr_idx))

fn ir_release_owned_string_args(node: Node, start_idx: Int, arg_regs: List[Int]):
    mut reg_i := 0
    for child, i in node.children:
        if i < start_idx:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                continue
            expr_idx = cn.children[0]
        ir_release_owned_string_operand(expr_idx, arg_regs[reg_i], ir_infer_type(expr_idx))
        reg_i = reg_i + 1

fn ir_register_struct_layout(name: String, field_names: List[String], field_types: List[String]):
    if ir_struct_names.contains_key(name):
        return
    for field_name, i in field_names:
        ir_struct_field_lookup.insert(name + "." + field_name, field_types[i])
        ir_struct_field_index_lookup.insert(name + "." + field_name, i.to_string())
    ir_struct_names.insert(name, field_names.len())
    if not ir_local_struct_names.contains(name):
        ir_local_struct_names.push(name)
    ir_emit("struct " + name + " " + field_names.join(" "))

fn ir_substitute_type_name(name: String) -> String:
    mut i := 0
    while i < ir_current_impl_subst_params.len():
        if ir_current_impl_subst_params[i] == name and i < ir_current_impl_subst_args.len():
            return ir_current_impl_subst_args[i]
        i = i + 1
    return name

fn ir_impl_target_type(node: Node) -> String:
    mut impl_type := ""
    for child in node.children:
        child_node := get_node(child)
        if child_node.kind == "type":
            impl_type = child_node.value
        elif child_node.kind == "for_type":
            for type_idx in child_node.children:
                type_child := get_node(type_idx)
                if type_child.kind == "type":
                    impl_type = type_child.value
        elif child_node.kind == "generic_type" and impl_type == "":
            impl_type = child_node.value
    return impl_type

# for `impl Iface for Concrete`, the interface's base name; "" for a plain
# `impl T:` block. the first type child is the interface, a for_type follows.
fn ir_impl_interface_base(node: Node) -> String:
    mut has_for := false
    mut first_type := ""
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "type" and first_type == "":
            first_type = cn.value
        elif cn.kind == "generic_type" and first_type == "":
            first_type = cn.value
        elif cn.kind == "for_type":
            has_for = true
    if has_for == false:
        return ""
    return ir_strip_type_args(first_type)

fn ir_impl_defines_method(node: Node, method_name: String) -> Bool:
    for child in node.children:
        mn := get_node(ir_unwrap_pub_child(child))
        if ir_is_fn_decl_kind(mn.kind) and mn.value == method_name:
            return true
    return false

# the interface-default fn_decl nodes an impl inherits: each default method on
# the interface (a fn_decl member) that the impl did not override itself.
fn ir_inherited_default_indices(node: Node) -> List[Int]:
    mut result: List[Int] := []
    iface_base := ir_impl_interface_base(node)
    if iface_base.len() == 0:
        return result
    if ir_interface_decl_index.contains_key(iface_base) == false:
        return result
    iface_node := get_node(ir_interface_decl_index[iface_base])
    for member in iface_node.children:
        mn := get_node(member)
        if ir_is_fn_decl_kind(mn.kind):
            if ir_impl_defines_method(node, mn.value) == false:
                result.push(member)
    return result

# collect each impl's associated-type bindings so a method's `-> Item` header
# resolves to the bound type (and, for heap types, gets the right return kind).
fn ir_collect_assoc_bindings_in_root(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual := node
        if node.kind == "pub":
            actual = get_node(node.children[0])
        if actual.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual)
            if impl_type.len() > 0:
                mut names: List[String] := []
                for child in actual.children:
                    cn := get_node(child)
                    if cn.kind == "assoc_type_bind":
                        ir_assoc_bindings.insert(impl_type + "." + cn.value, ir_resolve_type_node(cn.children[0]))
                        names.push(cn.value)
                if names.len() > 0:
                    ir_type_assoc_names.insert(impl_type, names.join(","))

# index every interface_decl in a root by its base name so impls can find the
# defaults they inherit. must run before impl signatures are collected.
fn ir_index_interfaces_in_root(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual_idx := item_idx
        if node.kind == "pub":
            actual_idx = node.children[0]
        actual := get_node(actual_idx)
        if actual.kind == "interface_decl":
            ir_interface_decl_index.insert(actual.value, actual_idx)

fn ir_emit_impl_methods(node: Node, impl_type: String):
    # for a generic struct, also emit one specialized copy of each method per
    # known instantiation so calls inside the body (`self.src.next()`) can
    # dispatch on the concrete type rather than the unresolved generic
    # parameter (`I.next` -> `next unknown`). emit these BEFORE the base
    # bodies so we can read each method's still-prefixed base symbol name
    # out of ir_impl_methods (ir_impl_func below overwrites it).
    ir_emit_impl_method_specializations(node, impl_type)
    for child in node.children:
        # a pub method sits behind a pub wrapper node; without this
        # unwrap the method silently never emits and calls return zero
        method_idx := ir_unwrap_pub_child(child)
        child_node := get_node(method_idx)
        if child_node.kind == "fn_decl":
            ir_impl_func(method_idx, impl_type)
    # emit a per-type copy of each interface default this impl didn't override
    for default_idx in ir_inherited_default_indices(node):
        ir_impl_func(default_idx, impl_type)

fn ir_emit_impl_method_specializations(impl_node: Node, impl_type: String):
    if not has_generic_declaration(impl_type):
        return
    sdecl := get_node(get_generic_declaration_index(impl_type))
    struct_params := collect_generic_parameter_names(sdecl)
    if struct_params.len() == 0:
        return
    instance_tids := struct_instance_tids
    for inst_tid in instance_tids:
        if struct_instance_base_name[inst_tid] != impl_type:
            continue
        if not struct_instance_type_args.contains_key(inst_tid):
            continue
        arg_tids := decode_tid_list(struct_instance_type_args[inst_tid])
        mut arg_names: List[String] := []
        for at in arg_tids:
            arg_names.push(ir_type_from_tid(at))
        instance_type_name := get_type_name(inst_tid)
        for child in impl_node.children:
            method_idx := ir_unwrap_pub_child(child)
            child_node := get_node(method_idx)
            if child_node.kind == "fn_decl":
                ir_impl_func_specialized(method_idx, impl_type, instance_type_name, struct_params, arg_names)

fn ir_impl_func_specialized(idx: Int, base_impl_type: String, instance_type: String, params: List[String], arg_names: List[String]):
    node := get_node(idx)
    orig_name := node.value
    # specialized symbol name e.g. MapIter_Range_int_int_next
    mut suffix := ""
    for an in arg_names:
        suffix = suffix + "_" + ir_sanitize_symbol(an)
    full_name := base_impl_type + suffix + "_" + orig_name
    method_key := ir_impl_method_key(instance_type, orig_name)
    # if ir_impl_methods already has a specialized entry (e.g. a previous
    # ir_impl_func_specialized for the same instance ran in this emit pass)
    # then the body is already on its way out; skip emitting it again
    if ir_impl_methods.contains_key(method_key):
        return
    ir_impl_methods.insert(method_key, full_name)
    # also record in a dedicated, non-reset map keyed by the instance-typed
    # method. derive the module-path prefix from the base method's currently
    # registered symbol (phase-two metadata inserted it with the right
    # prefix; this runs before ir_impl_func overwrites it for the current
    # module's impls) so cross-module call sites use the right linker symbol.
    base_key := ir_impl_method_key(base_impl_type, orig_name)
    expected_base_sym := base_impl_type + "_" + orig_name
    mut prefixed_full := full_name
    if ir_impl_methods.contains_key(base_key):
        base_sym := ir_impl_methods[base_key]
        if base_sym.len() > expected_base_sym.len() and base_sym.ends_with(expected_base_sym):
            prefix_len := base_sym.len() - expected_base_sym.len()
            prefixed_full = base_sym.substring(0, prefix_len) + full_name
    ir_impl_method_specializations.insert(method_key, prefixed_full)

    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx) + 1
    ret_type := ir_extract_return_type(idx)
    ir_prepare_func_emission(ret_type)
    ir_current_func_optional_inner_kind = ir_extract_optional_inner_type(idx)
    ir_current_func_returns_result = ir_fn_returns_result(idx)
    ir_current_impl_type = instance_type
    ir_current_impl_subst_params = params
    ir_current_impl_subst_args = arg_names
    ir_emit_func_header(full_name, param_count, ret_type)
    ir_emit_named_param("self", instance_type)
    ir_emit_fn_params(idx)
    # like every other function body, track owned locals so the exit cleanup
    # releases them. the impl-subst context (set above) is active here, so the
    # prologue's bind prepass can resolve a method result's lowered kind even
    # though the checker suppressed the struct's type params in this body.
    ir_emit_string_prologue(body_idx)
    ir_func_returns.insert(method_key, ret_type)
    ir_func_returns.insert(full_name, ret_type)
    ir_finish_func_emission(body_idx)
    ir_current_impl_type = ""
    ir_current_impl_subst_params = []
    ir_current_impl_subst_args = []

fn ir_declared_struct_name(node: Node) -> String:
    if node.value.contains("["):
        return node.value.substring(0, node.value.index_of("["))
    return node.value

fn ir_record_struct_field(struct_name: String, field_names: List[String], field_node: Node) -> List[String]:
    field_name := ir_struct_field_name(field_node)
    mut updated_fields := field_names
    field_index := updated_fields.len()
    updated_fields.push(field_name)
    if field_node.children.len() > 0:
        type_node := get_node(field_node.children[0])
        # a closure field (fn_type) must be recorded too, or the struct's
        # destructor won't know to release it and the closure leaks
        if type_node.kind == "type" or type_node.kind == "generic_type" or type_node.kind == "optional_type" or type_node.kind == "fn_type":
            ir_struct_field_lookup.insert(struct_name + "." + field_name, ir_resolve_type_node(field_node.children[0]))
        if field_node.children.len() > 1:
            ir_struct_field_default_nodes.insert(struct_name + "." + field_name, field_node.children[1])
    ir_struct_field_index_lookup.insert(struct_name + "." + field_name, field_index.to_string())
    return updated_fields

fn ir_collect_struct_decl(node_idx: Int, node: Node, emit_decl: Bool):
    sname := ir_declared_struct_name(node)
    ir_struct_decl_nodes.insert(sname, node_idx)
    mut field_names: List[String] := []
    for child in node.children:
        field_node := ir_unwrap_pub_node(child)
        if field_node.kind == "field":
            field_names = ir_record_struct_field(sname, field_names, field_node)
    ir_struct_names.insert(sname, field_names.len())
    if emit_decl:
        if not ir_local_struct_names.contains(sname):
            ir_local_struct_names.push(sname)
        ir_emit("struct " + sname + " " + field_names.join(" "))

fn ir_collect_enum_decl(node: Node, emit_decl: Bool):
    sname := node.value
    mut variant_names: List[String] := []
    for child in node.children:
        variant_node := ir_unwrap_pub_node(child)
        if variant_node.kind == "variant":
            variant_index := variant_names.len()
            variant_names.push(variant_node.value)
            ir_struct_field_lookup.insert(sname + "." + variant_node.value, sname)
            ir_struct_field_index_lookup.insert(sname + "." + variant_node.value, variant_index.to_string())
            if variant_node.children.len() > 0:
                mut kinds: List[String] := []
                for type_idx in variant_node.children:
                    mut kind := ir_resolve_type_node(type_idx)
                    if kind.len() == 0:
                        kind = "unknown"
                    kinds.push(kind)
                ir_enum_payload_kinds.insert(sname + "." + variant_node.value, kinds.join(","))
                ir_boxed_enums.insert(sname, true)
    ir_enum_variant_lists.insert(sname, variant_names.join(","))
    ir_struct_names.insert(sname, variant_names.len())
    if emit_decl:
        ir_emit("struct " + sname + " " + variant_names.join(" "))

fn ir_collect_struct_decls(root_idx: Int, emit_decl: Bool):
    for item_idx in ir_root_items(root_idx):
        cn := get_node(item_idx)
        if cn.kind == "struct_decl" or cn.kind == "struct":
            ir_collect_struct_decl(item_idx, cn, emit_decl)
        elif cn.kind == "enum_decl" or cn.kind == "enum":
            ir_collect_enum_decl(cn, emit_decl)

fn ir_seed_global_types():
    for name in ir_global_int_names:
        ir_var_types.insert(name, "int")
    for name in ir_global_string_names:
        ir_var_types.insert(name, "string")
    for name in ir_global_list_string_names:
        ir_var_types.insert(name, "list_string")
    for name in ir_global_list_names:
        ir_var_types.insert(name, "list")
    for name in ir_global_map_int_names:
        ir_var_types.insert(name, "map_int")
    for name in ir_global_map_names:
        ir_var_types.insert(name, "map")
    for name in ir_global_set_int_names:
        ir_var_types.insert(name, "set_int")
    for name in ir_global_set_names:
        ir_var_types.insert(name, "set")
    for name in ir_global_bool_names:
        ir_var_types.insert(name, "bool")
    for name in ir_global_map_value_types.keys():
        ir_map_value_types.insert(name, ir_global_map_value_types[name])

fn ir_register_known_import_structs():
    ir_register_struct_layout("Node", ["kind", "value", "children", "line", "col"], ["string", "string", "list", "int", "int"])
    ir_register_struct_layout("Token", ["kind", "value", "current_line", "current_column"], ["string", "string", "int", "int"])
    ir_register_struct_layout("TypeInfo", ["kind", "name", "fields", "field_types", "field_pub", "field_mut", "param_types", "return_type", "inner", "key_type", "value_type", "elements", "variants", "variant_types"], ["string", "string", "list_string", "list", "list", "list", "list", "int", "int", "int", "int", "list", "list_string", "list"])
    ir_register_struct_layout("Diagnostic", ["severity", "code", "message", "file", "line", "col", "fix"], ["string", "string", "string", "string", "int", "int", "string"])

fn ir_expr_legacy_result_kind(idx: Int) -> String:
    node := get_node(idx)
    if node.kind == "call" and node.children.len() > 0:
        callee := ir_resolve_static_callee(node.children[0])
        if ir_declared_callable_ir_retkind(callee.name).len() > 0:
            return ""
        return ir_builtin_result_retkind(callee.name)
    if node.kind == "method_call":
        alias_name := ir_resolve_module_alias_method_call_name(idx)
        if alias_name.len() > 0:
            if ir_declared_callable_ir_retkind(alias_name).len() > 0:
                return ""
            return ir_builtin_result_retkind(alias_name)
        obj_type := ir_method_receiver_type(node)
        emit_name := ir_method_emit_name(ir_plain_method_name(node.value), obj_type)
        if ir_declared_callable_ir_retkind(emit_name).len() > 0:
            return ""
        return ir_builtin_result_retkind(emit_name)
    return ""

fn ir_call_retkind(idx: Int, uses_result_abi: Bool) -> String:
    if uses_result_abi:
        node := get_node(idx)
        if node.kind == "call" and node.children.len() > 0:
            callee := ir_resolve_static_callee(node.children[0])
            declared_kind := ir_declared_callable_ir_retkind(callee.name)
            if declared_kind.len() > 0:
                return declared_kind
        if node.kind == "method_call":
            alias_name := ir_resolve_module_alias_method_call_name(idx)
            if alias_name.len() > 0:
                declared_kind := ir_declared_callable_ir_retkind(alias_name)
                if declared_kind.len() > 0:
                    return declared_kind
            obj_type := ir_method_receiver_type(node)
            method_name := ir_plain_method_name(node.value)
            impl_name := ir_lookup_impl_method_name(obj_type, method_name)
            if impl_name.len() > 0:
                declared_kind := ir_declared_callable_ir_retkind(impl_name)
                if declared_kind.len() > 0:
                    return declared_kind
            emit_name := ir_method_emit_name(method_name, obj_type)
            declared_kind := ir_declared_callable_ir_retkind(emit_name)
            if declared_kind.len() > 0:
                return declared_kind
        legacy_kind := ir_expr_legacy_result_kind(idx)
        if legacy_kind.len() > 0:
            return legacy_kind
        result_kind := ir_checked_result_kind(idx)
        if result_kind.len() > 0:
            return result_kind
    return ir_infer_type(idx)

fn ir_call_retkind_for_name(idx: Int, uses_result_abi: Bool, callee_name: String) -> String:
    if uses_result_abi:
        declared_kind := ir_declared_callable_ir_retkind(callee_name)
        if declared_kind.len() > 0:
            return declared_kind
    return ir_call_retkind(idx, uses_result_abi)

fn ir_known_callable_return_type(fname: String) -> String:
    struct_type := ir_known_struct_return_type(fname)
    if struct_type.len() > 0:
        return struct_type
    scalar_type := ir_known_scalar_return_type(fname)
    if scalar_type.len() > 0:
        return scalar_type
    collection_type := ir_known_collection_return_type(fname)
    if collection_type.len() > 0:
        return collection_type
    return ir_declared_callable_return_type(fname)

fn ir_field_receiver_type(recv_idx: Int) -> String:
    mut obj_type := ir_infer_type(recv_idx)
    if obj_type.contains("["):
        base := obj_type.substring(0, obj_type.index_of("["))
        if ir_struct_names.contains_key(base):
            obj_type = base
    if obj_type.len() == 0:
        recv := get_node(recv_idx)
        if recv.kind == "ident" and ir_struct_names.contains_key(recv.value):
            obj_type = recv.value
        # `self` inside a method body resolves to the impl block's target type
        elif recv.kind == "self" and ir_current_impl_type.len() > 0:
            obj_type = ir_current_impl_type
    return obj_type

fn ir_known_method_return_type(obj_type: String, meth: String) -> String:
    impl_name := ir_lookup_impl_method_name(obj_type, meth)
    if impl_name.len() > 0:
        declared := ir_declared_callable_return_type(impl_name)
        if declared.len() > 0:
            return declared
    if ir_is_bool_returning_method(meth):
        return "bool"
    string_type := ir_known_string_method_return_type(meth)
    if string_type.len() > 0:
        return string_type
    if meth == "to_float":
        return "float"
    if meth == "len" or meth == "cap":
        return "int"
    if (meth == "slice" or meth == "concat") and obj_type == "bytes":
        return "bytes"
    collection_type := ir_known_collection_method_return_type(obj_type, meth)
    if collection_type.len() > 0:
        return collection_type
    return ""

fn ir_binary_expr_type(node: Node) -> String:
    op := node.value
    if op == "eq" or op == "neq" or op == "lt" or op == "gt" or op == "lte" or op == "gte" or op == "and" or op == "or":
        return "bool"
    if op == "add" or op == "sub" or op == "mul" or op == "div" or op == "mod":
        if node.children.len() >= 2:
            lt := ir_infer_type(node.children[0])
            rt := ir_infer_type(node.children[1])
            if lt == "float" or rt == "float":
                return "float"
            if lt == "string" or rt == "string":
                return "string"
        return "int"
    return "int"

fn ir_index_expr_type(idx: Int, node: Node) -> String:
    checked_index := ir_checked_index_type(idx)
    if checked_index.len() > 0:
        return checked_index
    if node.children.len() == 0:
        return ""
    coll_type := ir_infer_type(node.children[0])
    if coll_type == "string":
        return "string"
    if coll_type == "bytes":
        return "int"
    if coll_type == "list_string":
        return "string"
    if coll_type == "map" or coll_type == "map_int":
        return ir_lookup_map_value_type_for_expr(node.children[0])
    return ""

fn ir_call_expr_type(idx: Int, node: Node) -> String:
    if node.children.len() == 0:
        return ""
    callee_node := get_node(node.children[0])
    if callee_node.kind == "ident" and ir_closure_return_kinds.contains_key(callee_node.value):
        return ir_closure_return_kinds[callee_node.value]
    callee := ir_resolve_static_callee(node.children[0])
    if callee.name.len() == 0:
        return ""
    return ir_known_callable_return_type(callee.name)

fn ir_method_expr_type(idx: Int, node: Node) -> String:
    alias_fname := ir_resolve_module_alias_method_call_name(idx)
    if alias_fname.len() > 0:
        return ir_known_callable_return_type(alias_fname)
    mut obj_type := ""
    if node.children.len() > 0:
        obj_type = ir_infer_type(node.children[0])
    return ir_known_method_return_type(obj_type, ir_plain_method_name(node_value(idx)))

fn ir_checked_struct_field_type(recv_idx: Int, field_name: String) -> String:
    recv_tid := c_get_expr_type(recv_idx)
    if recv_tid < 0:
        return ""
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "struct":
        return ""
    for name, i in recv_info.fields:
        if name == field_name and i < recv_info.field_types.len():
            return ir_type_from_tid(recv_info.field_types[i])
    return ""

fn ir_field_expr_type(node: Node) -> String:
    if node.children.len() == 0:
        return ""
    fname := node.value
    if fname == "is_ok" or fname == "is_err":
        return "bool"
    if fname == "ok":
        obj_tid := c_get_expr_type(node.children[0])
        if obj_tid >= 0:
            obj_info := get_type_info(obj_tid)
            if obj_info.kind == "result":
                return ir_type_from_tid(obj_info.inner)
    if fname == "err":
        obj_tid := c_get_expr_type(node.children[0])
        if obj_tid >= 0:
            obj_info := get_type_info(obj_tid)
            if obj_info.kind == "result":
                return ir_type_from_tid(obj_info.value_type)
    concrete_field_type := ir_checked_struct_field_type(node.children[0], fname)
    if concrete_field_type.len() > 0:
        return concrete_field_type
    obj_type := ir_field_receiver_type(node.children[0])
    if obj_type.len() == 0:
        return ""
    lookup_key := obj_type + "." + fname
    if ir_struct_field_lookup.contains_key(lookup_key):
        return ir_struct_field_lookup[lookup_key]
    return ""

# --- centralized type inference for AST nodes ---
# Returns: "int", "float", "bool", "string", "list", "list_string",
#          "map", "map_int", "set", "set_int", or "" (unknown)
fn ir_infer_type(idx: Int) -> String:
    # a missing child (an absent optional argument) has index -1;
    # asking its type is a normal question with an unknown answer
    if idx < 0:
        return ""
    checked := ir_checked_type(idx)
    if checked.len() > 0:
        return checked
    node := get_node(idx)
    kind := node_kind(idx)
    literal_type := ir_literal_expr_type(node, kind)
    if literal_type.len() > 0:
        return literal_type
    # identifiers — look up tracked type
    if kind == "ident":
        return ir_lookup_name_type(node.value)
    if kind == "self":
        # use the current impl block's target type so field lookups resolve
        # to the right struct; "struct" is a generic placeholder fallback
        if ir_current_impl_type.len() > 0:
            return ir_current_impl_type
        return "struct"
    # grouped expression — infer inner
    if kind == "grouped" and node.children.len() > 0:
        return ir_infer_type(node.children[0])
    # binary ops
    if kind == "binary":
        return ir_binary_expr_type(node)
    # unary
    if kind == "unary":
        return ir_unary_expr_type(node)
    # function calls
    if kind == "call":
        return ir_call_expr_type(idx, node)
    # method calls
    if kind == "method_call":
        return ir_method_expr_type(idx, node)
    if kind == "field_access":
        return ir_field_expr_type(node)
    if kind == "struct_init":
        return ir_resolve_type_hint(node.value)
    # index — depends on collection type
    if kind == "index" and node.children.len() > 0:
        return ir_index_expr_type(idx, node)
    return ""

fn ir_lookup_name_type(name: String) -> String:
    return ir_lookup_name_type_with_state(name, ir_var_types, ir_global_int_names, ir_global_string_names, ir_global_list_string_names, ir_global_list_names, ir_global_map_int_names, ir_global_map_names, ir_global_set_int_names, ir_global_set_names, ir_global_bool_names)

fn ir_emit_value_for_target(val_idx: Int, target_type: String) -> Int:
    vn := get_node(val_idx)
    if target_type == "tuple":
        if vn.kind == "none_lit":
            return ir_emit_optional_none_value()
        value_r := ir_expr(val_idx)
        actual_tid := c_get_expr_type(val_idx)
        if actual_tid >= 0:
            actual_info := get_type_info(actual_tid)
            if actual_info.kind == "optional" or actual_info.kind == "result" or actual_info.kind == "tuple":
                # a passed-through optional/result/tuple is owned at this
                # position; take a count when it arrives borrowed so the holder
                # can release it. freshly wrapped optionals below are already
                # owned, and the struct-construction site no longer retains
                # tuple-typed fields, so this is the single owning retain.
                if ir_string_expr_is_borrowed(val_idx):
                    ir_rc_retain_reg(value_r, "tuple")
                return value_r
        # in a generic impl body, a method call's checked type is often
        # TID_ERR because the body was checked with the struct's type
        # params suppressed. assume `return <method_call>` from a
        # tuple-returning function already produces the right shape rather
        # than wrap-it-as-Some.
        if ir_current_impl_subst_params.len() > 0 and (vn.kind == "method_call" or vn.kind == "call"):
            return value_r
        # an optional wrapping an rc payload (a struct, list, map, set, bytes, or
        # closure) OWNS it: take a count when the value arrives borrowed, and
        # attach a destructor so the payload is released when the optional dies.
        # this keeps a `Node?` field's target alive instead of dangling. strings
        # stay borrowed (copy-on-derive already keeps them safe).
        payload_kind := ir_rc_kind(ir_infer_type(val_idx))
        if payload_kind == "struct" or payload_kind == "list" or payload_kind == "map" or payload_kind == "set" or payload_kind == "bytes" or payload_kind == "closure":
            if ir_string_expr_is_borrowed(val_idx):
                ir_rc_retain_reg(value_r, payload_kind)
            return ir_emit_optional_owned_some(value_r, payload_kind)
        return ir_emit_optional_some_value(value_r)
    empty_init_call := ir_empty_collection_init_call_name(vn.kind, vn.children.len(), target_type)
    if empty_init_call.len() > 0:
        r := ir_reg()
        ir_emit_call0(r, empty_init_call, ir_normalize_collection_target(target_type))
        return r
    return ir_expr(val_idx)

fn ir_checked_target_type(target_idx: Int, fallback_name: String) -> String:
    checked := ir_checked_type(target_idx)
    if checked.len() > 0:
        return checked
    if fallback_name.len() > 0:
        return ir_lookup_name_type(fallback_name)
    return ""

fn ir_method_receiver_type(node: Node) -> String:
    if node.children.len() == 0:
        return ""
    # `self` is always the impl type currently being emitted. reading the
    # checker's recorded type would be wrong for a shared interface-default
    # body, which is type-checked once per implementing type — the last one
    # wins and would misroute self.method() to that type.
    recv0 := get_node(node.children[0])
    if recv0.kind == "self" and ir_current_impl_type.len() > 0:
        return ir_current_impl_type
    recv_tid := c_get_expr_type(node.children[0])
    if recv_tid >= 0:
        recv_info := get_type_info(recv_tid)
        if recv_info.kind == "channel" and recv_info.inner >= 0:
            return "channel:" + ir_type_from_tid(recv_info.inner)
        if recv_info.kind == "task" and recv_info.inner >= 0:
            return "task:" + ir_type_from_tid(recv_info.inner)
        known := ir_type_from_tid(recv_tid)
        if known.len() > 0:
            return ir_substitute_type_name(known)
    checked := ir_checked_type(node.children[0])
    if checked.len() > 0:
        return ir_substitute_type_name(checked)
    inferred := ir_infer_type(node.children[0])
    if inferred.len() > 0:
        return ir_substitute_type_name(inferred)
    # fallback: if the receiver is `self.field` inside an impl method, look
    # up the field's declared type from the impl struct and substitute. this
    # is what lets a specialized MapIter[Range,_,_]_next route self.src.next()
    # to Range_next when the checker recorded self.src as TID_ERR
    recv_node := get_node(node.children[0])
    if recv_node.kind == "field_access" and recv_node.children.len() > 0 and ir_current_impl_type.len() > 0:
        inner := get_node(recv_node.children[0])
        if inner.kind == "self":
            fname := node_value(node.children[0])
            base_struct := ir_strip_type_args(ir_current_impl_type)
            field_key := base_struct + "." + fname
            if ir_struct_field_lookup.contains_key(field_key):
                return ir_substitute_type_name(ir_struct_field_lookup[field_key])
    return ""

fn ir_emit_optional_unwrap(node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    opt_tid := c_get_expr_type(node.children[0])
    flag_r := ir_optional_flag_field(recv_r)
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
    ir_emit_label(some_l)
    decoded_r := ir_optional_value_field(recv_r, opt_tid)
    ir_emit("jmp " + merge_l)
    ir_emit_label(none_l)
    if ir_emit_tests and ir_emitting_test_func:
        ir_test_assert_fail_return()
    else:
        si := ir_str("unwrap of none")
        err_r := ir_reg()
        ir_emit("strref " + err_r.to_string() + " " + si)
        ir_emit("ret " + ir_emit_err_result_tuple(err_r).to_string())
    ir_emit_label(merge_l)
    return decoded_r

fn ir_collect_method_call_regs(node: Node) -> List[Int]:
    mut regs: List[Int] := []
    for child, i in node.children:
        if i == 0:
            regs.push(ir_expr(child))
        else:
            child_kind := node_kind(child)
            if child_kind == "arg":
                cn := get_node(child)
                if cn.children.len() > 0:
                    regs.push(ir_expr(cn.children[0]))
            else:
                regs.push(ir_expr(child))
    return regs

# {x:8.2}-style parts: convert with precision when asked, then pad.
# the spec was validated by the parser, so parsing here is positional.
fn ir_interp_spec_width(spec: String) -> Int:
    mut i := 0
    c0 := spec[0]
    if c0 == "<" or c0 == ">" or c0 == "^":
        i = 1
    if i < spec.len() and spec[i] == "0":
        i = i + 1
    mut w := 0
    mut saw := false
    while i < spec.len() and spec[i] != ".":
        w = w * 10 + (ord(spec[i]) - 48)
        saw = true
        i = i + 1
    if not saw:
        return 0 - 1
    return w

fn ir_interp_spec_precision(spec: String) -> Int:
    dot := spec.index_of(".")
    if dot < 0:
        return 0 - 1
    mut p := 0
    mut i := dot + 1
    while i < spec.len():
        p = p * 10 + (ord(spec[i]) - 48)
        i = i + 1
    return p

ALIGN_LEFT_BYTE := 60 # '<'
ALIGN_CENTER_BYTE := 94 # '^'
ALIGN_RIGHT_BYTE := 62 # '>'
FILL_ZERO_BYTE := 48 # '0'
FILL_SPACE_BYTE := 32 # ' '

fn ir_interp_spec_align(spec: String) -> Int:
    c0 := spec[0]
    if c0 == "<":
        return ALIGN_LEFT_BYTE
    if c0 == "^":
        return ALIGN_CENTER_BYTE
    return ALIGN_RIGHT_BYTE

fn ir_interp_spec_fill(spec: String) -> Int:
    mut i := 0
    c0 := spec[0]
    if c0 == "<" or c0 == ">" or c0 == "^":
        i = 1
    if i < spec.len() and spec[i] == "0":
        return FILL_ZERO_BYTE
    return FILL_SPACE_BYTE

fn ir_emit_interp_spec_part(node: Node) -> Int:
    spec := node.value
    expr_idx := node.children[0]
    prec := ir_interp_spec_precision(spec)
    part_type := ir_infer_type(expr_idx)
    mut str_r := 0 - 1
    if prec >= 0 and part_type == "float":
        raw_r := ir_expr(expr_idx)
        prec_r := ir_reg()
        ir_emit("iconst " + prec_r.to_string() + " " + prec.to_string())
        str_r = ir_reg()
        ir_emit_call2(str_r, "float_format", "string", raw_r, prec_r)
    else:
        str_r = ir_string_interp_expr_part(expr_idx)
    width := ir_interp_spec_width(spec)
    if width <= 0:
        return str_r
    w_r := ir_reg()
    ir_emit("iconst " + w_r.to_string() + " " + width.to_string())
    a_r := ir_reg()
    ir_emit("iconst " + a_r.to_string() + " " + ir_interp_spec_align(spec).to_string())
    f_r := ir_reg()
    ir_emit("iconst " + f_r.to_string() + " " + ir_interp_spec_fill(spec).to_string())
    padded_r := ir_reg()
    ir_emit("call " + padded_r.to_string() + " format_pad string 4 " + str_r.to_string() + " " + w_r.to_string() + " " + a_r.to_string() + " " + f_r.to_string())
    # the unpadded intermediate is garbage once copied, unless it was a
    # borrowed string passed straight through
    if ir_infer_type(node.children[0]) != "string" or not ir_string_expr_is_borrowed(node.children[0]):
        ir_string_release_reg(str_r)
    return padded_r

fn ir_string_interp_expr_part(expr_idx: Int) -> Int:
    mut part_r := ir_expr(expr_idx)
    part_tid := c_get_expr_type(expr_idx)
    part_type := ir_infer_type(expr_idx)
    if part_type == "string":
        return part_r
    if part_type == "bool":
        converted := ir_reg()
        ir_emit_call1(converted, "bool_to_string", "string", part_r)
        return converted
    if part_type == "float":
        converted := ir_reg()
        ir_emit_call1(converted, "float_to_string", "string", part_r)
        return converted
    if part_type == "int":
        converted := ir_reg()
        ir_emit_call1(converted, "int_to_string", "string", part_r)
        return converted
    if part_tid >= 0:
        part_info := get_type_info(part_tid)
        if part_info.kind == "result":
            return ir_emit_result_value_to_string(part_r, part_tid)
        if part_info.kind == "list":
            return ir_emit_display_list(part_r, ir_type_from_tid(part_info.inner), false)
        if part_info.kind == "map":
            return ir_emit_display_map(part_r, ir_type_from_tid(part_info.key_type), ir_type_from_tid(part_info.value_type))
        if part_info.kind == "set":
            converted := ir_reg()
            ir_emit_call1(converted, "__set_to_list", "list", part_r)
            return ir_emit_display_list(converted, ir_type_from_tid(part_info.inner), true)
    if part_type.len() > 0 and ir_struct_names.contains_key(part_type):
        if not ir_boxed_enums.contains_key(part_type):
            return ir_emit_display_struct(part_r, part_type)
    return part_r

# kind codes shared with the runtime display helpers:
# 0=int, 1=float, 2=bool, 3=string
fn ir_display_kind_code(kind: String) -> Int:
    if kind == "float":
        return 1
    if kind == "bool":
        return 2
    if kind == "string":
        return 3
    return 0

fn ir_emit_display_list(list_r: Int, elem_kind: String, sorted: Bool) -> Int:
    kind_r := ir_reg()
    ir_emit("iconst " + kind_r.to_string() + " " + ir_display_kind_code(elem_kind).to_string())
    sort_r := ir_reg()
    mut sort_flag := "0"
    if sorted:
        sort_flag = "1"
    ir_emit("iconst " + sort_r.to_string() + " " + sort_flag)
    r := ir_reg()
    ir_emit_call3(r, "pith_display_list", "string", list_r, kind_r, sort_r)
    return r

fn ir_emit_display_map(map_r: Int, key_kind: String, val_kind: String) -> Int:
    kk_r := ir_reg()
    ir_emit("iconst " + kk_r.to_string() + " " + ir_display_kind_code(key_kind).to_string())
    vk_r := ir_reg()
    ir_emit("iconst " + vk_r.to_string() + " " + ir_display_kind_code(val_kind).to_string())
    r := ir_reg()
    ir_emit_call3(r, "pith_display_map", "string", map_r, kk_r, vk_r)
    return r

# a struct in interpolation renders through its show() impl when one
# exists; otherwise as "Name(field: value, ...)" with scalar and string
# fields formatted and anything deeper shown as "...".
fn ir_emit_display_struct(obj_r: Int, struct_name: String) -> Int:
    show_name := ir_lookup_impl_method_name(struct_name, "show")
    if show_name.len() > 0:
        r := ir_reg()
        ir_emit_call1(r, show_name, "string", obj_r)
        return r
    mut acc_r := ir_reg()
    ir_emit("strref " + acc_r.to_string() + " " + ir_str(struct_name + "("))
    total := ir_struct_field_count(struct_name)
    mut fi := 0
    while fi < total:
        field_name := ir_struct_field_name_at(struct_name, fi)
        field_kind := ir_struct_field_type_name(struct_name, field_name)
        mut label := field_name + ": "
        if fi > 0:
            label = ", " + field_name + ": "
        label_r := ir_reg()
        ir_emit("strref " + label_r.to_string() + " " + ir_str(label))
        with_label := ir_reg()
        ir_emit("concat " + with_label.to_string() + " " + acc_r.to_string() + " " + label_r.to_string())
        ir_string_release_reg(acc_r)
        field_r := ir_reg()
        ir_emit("field " + field_r.to_string() + " " + obj_r.to_string() + " " + (fi * 8).to_string() + " " + field_kind + " " + field_name)
        mut text_r := field_r
        if field_kind == "int":
            text_r = ir_reg()
            ir_emit_call1(text_r, "int_to_string", "string", field_r)
        elif field_kind == "float":
            text_r = ir_reg()
            ir_emit_call1(text_r, "float_to_string", "string", field_r)
        elif field_kind == "bool":
            text_r = ir_reg()
            ir_emit_call1(text_r, "bool_to_string", "string", field_r)
        elif field_kind != "string":
            text_r = ir_reg()
            ir_emit("strref " + text_r.to_string() + " " + ir_str("..."))
        next_acc := ir_reg()
        ir_emit("concat " + next_acc.to_string() + " " + with_label.to_string() + " " + text_r.to_string())
        ir_string_release_reg(with_label)
        if field_kind == "int" or field_kind == "float" or field_kind == "bool":
            ir_string_release_reg(text_r)
        acc_r = next_acc
        fi = fi + 1
    close_r := ir_reg()
    ir_emit("strref " + close_r.to_string() + " " + ir_str(")"))
    out_r := ir_reg()
    ir_emit("concat " + out_r.to_string() + " " + acc_r.to_string() + " " + close_r.to_string())
    ir_string_release_reg(acc_r)
    return out_r

# the runtime tag telling a closure how to release a captured slot when
# the closure is freed. matches the CLOSURE_TAG_* constants in the
# runtime; 0 means a plain value with nothing to release.
fn ir_closure_capture_tag(kind: String) -> Int:
    if kind == "string":
        return 1
    if kind == "list":
        return 2
    if kind == "map":
        return 3
    if kind == "set":
        return 4
    if kind == "bytes":
        return 5
    if kind == "struct":
        return 6
    if kind == "closure":
        return 7
    return 0

fn ir_emit_lambda_capture_setup(closure_r: Int, captures: List[String]):
    for capture_name, i in captures:
        cap_val := ir_reg()
        ir_emit("load " + cap_val.to_string() + " " + capture_name)
        slot := ir_reg()
        ir_emit("iconst " + slot.to_string() + " " + i.to_string())
        # the closure environment keeps its own count on captured rc values
        # so the origin scope's cleanup cannot pull them out from under it;
        # the tag lets the closure drop that count when it is freed.
        cap_kind := ir_rc_kind(ir_lookup_name_type(capture_name))
        if cap_kind.len() > 0:
            ir_rc_retain_reg(cap_val, cap_kind)
            tag_r := ir_reg()
            ir_emit("iconst " + tag_r.to_string() + " " + ir_closure_capture_tag(cap_kind).to_string())
            ir_emit_call_text(ir_reg(), "pith_closure_set_env_rc", "void", 4, " " + closure_r.to_string() + " " + slot.to_string() + " " + cap_val.to_string() + " " + tag_r.to_string())
        else:
            ir_emit_call3(ir_reg(), "__closure_set_env", "void", closure_r, slot, cap_val)

fn ir_emit_lambda_hidden_param():
    closure_r := ir_reg()
    ir_var_regs.insert("__closure", closure_r)
    ir_emit("param __closure")

fn ir_emit_lambda_capture_loads(captures: List[String]):
    closure_r := ir_var_regs["__closure"]
    for capture_name, i in captures:
        cap_r := ir_reg()
        slot_r := ir_reg()
        ir_emit("iconst " + slot_r.to_string() + " " + i.to_string())
        ir_emit_call2(cap_r, "__closure_get_env", "unknown", closure_r, slot_r)
        ir_var_regs.insert(capture_name, cap_r)
        ir_emit("store " + capture_name + " " + cap_r.to_string())

fn ir_append_deferred_lambda_body():
    lines := ir_builder_lines()
    mut bodies: List[String] := ir_lambda_bodies
    for line in lines:
        bodies.push(line)
    ir_lambda_bodies = bodies

fn ir_emit_unary_expr(node: Node) -> Int:
    operand_r := ir_expr(node.children[0])
    return ir_emit_unary_op(node.value, operand_r)

fn ir_emit_binary_neq(result_reg: Int, left_r: Int, right_r: Int, is_str_op: Bool, is_bytes_op: Bool):
    if is_str_op:
        eq_r := ir_reg()
        ir_emit_call2(eq_r, "__str_eq", "bool", left_r, right_r)
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        ir_emit("sub " + result_reg.to_string() + " " + one_r.to_string() + " " + eq_r.to_string())
        return
    if is_bytes_op:
        eq_r := ir_reg()
        ir_emit_call2(eq_r, "bytes_eq", "bool", left_r, right_r)
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        ir_emit("sub " + result_reg.to_string() + " " + one_r.to_string() + " " + eq_r.to_string())
        return
    ir_emit("neq " + result_reg.to_string() + " " + left_r.to_string() + " " + right_r.to_string())

# an owned string operand (a fresh char from s[i], a concat result, a
# fresh method result) dies once the operation that consumed it emits.
# this is the loop-condition reclaim: `while s[i] == ":"` builds a fresh
# char every iteration, and the release lands in the same block as the
# compare, so dominance is never in question.
# true only for s[i] with a string receiver: that lowers to char_at,
# which always mints a fresh one-char string. everything else keeps the
# general borrowed-by-default classification.
fn ir_expr_is_fresh_string_index(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "index" or node.children.len() == 0:
        return false
    # inside generic or specialized bodies the checked types are suppressed
    # and inference can misname a map or list receiver as a string; a wrong
    # answer here frees a container's element, so freshness requires the
    # non-generic certainty path.
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return false
    # replicate ir_emit_index_expr's dispatch exactly: checked type first,
    # inference as fallback.
    mut obj_type := ir_checked_type(node.children[0])
    if obj_type.len() == 0:
        obj_type = ir_infer_type(node.children[0])
    return obj_type == "string"

fn ir_binary_op_is_comparison(simple_op: String) -> Bool:
    return simple_op == "lt" or simple_op == "gt" or simple_op == "lte" or simple_op == "gte"

fn ir_release_owned_string_operand(expr_idx: Int, reg: Int, expr_type: String):
    if expr_type == "string" and not ir_string_expr_is_borrowed(expr_idx):
        ir_string_release_reg(reg)
    elif expr_type == "bytes" and not ir_string_expr_is_borrowed(expr_idx):
        ir_rc_release_reg(reg, "bytes")
    elif ir_expr_is_fresh_string_index(expr_idx):
        # loop-condition reclaim: `while s[i] == ":"` mints a fresh char
        # per iteration; it dies with the compare, in the same block
        ir_string_release_reg(reg)
    elif ir_expr_is_transferred_call_temp(expr_idx):
        # a call result in comparison position is a transferred count
        # nothing else references: `c == chr(9)` leaked one string per
        # iteration. user returns transfer, and runtime string builders
        # (chr, conversions) mint fresh buffers.
        ir_string_release_reg(reg)
    else:
        # an owned struct/closure/collection argument dies when the call it
        # fed returns, exactly like an owned string (docs/ownership.md): the
        # callee borrowed it and a storing callee took its own count, so the
        # caller releases the count it still holds. a borrowed arg (a
        # variable/field/element the caller keeps) is not released; a fresh
        # literal (a struct init, a lambda) or a transferred result is.
        mut arg_kind := ir_rc_kind(expr_type)
        if arg_kind.len() == 0 and get_node(expr_idx).kind == "lambda":
            arg_kind = "closure"
        if (arg_kind == "struct" or arg_kind == "closure") and not ir_string_expr_is_borrowed(expr_idx):
            ir_rc_release_reg(reg, arg_kind)

# true for call and method-call results whose checked or inferred type is
# string, outside generic bodies where the types cannot be trusted.
fn ir_expr_is_transferred_call_temp(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind != "call" and node.kind != "method_call":
        return false
    if ir_active_generic_params.len() > 0 or ir_current_impl_subst_params.len() > 0:
        return false
    mut expr_type := ir_checked_type(idx)
    if expr_type.len() == 0:
        expr_type = ir_infer_type(idx)
    return expr_type == "string"

# a register holding one byte of string content as an integer, or -1
# when the expression can't be read as a byte. covers s[i] on strings
# (an allocation-free byte_at instead of a fresh one-char string),
# single-character literals, and chr(n) with a literal argument.
fn ir_emit_byte_operand(idx: Int) -> Int:
    node := get_node(idx)
    if node.kind == "index" and node.children.len() >= 2:
        if ir_expr_is_fresh_string_index(idx):
            obj_r := ir_expr(node.children[0])
            idx_r := ir_expr(node.children[1])
            r := ir_reg()
            ir_emit_call2(r, "byte_at", "int", obj_r, idx_r)
            return r
        return 0 - 1
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        if node.value.len() == 1:
            r := ir_reg()
            ir_emit("iconst " + r.to_string() + " " + ord(node.value).to_string())
            return r
        return 0 - 1
    if node.kind == "call" and node.children.len() >= 2:
        callee := get_node(node.children[0])
        arg := get_node(node.children[1])
        if callee.kind == "ident" and callee.value == "chr" and arg.kind == "int_lit":
            r := ir_reg()
            ir_emit("iconst " + r.to_string() + " " + arg.value)
            return r
    return 0 - 1

# `s[i] == ":"` compares one byte against one byte: read both sides as
# integers and skip the two string allocations plus their rc traffic.
# at least one side must be an index — the scanner-loop shape this
# exists for.
fn ir_is_byte_operand(idx: Int) -> Bool:
    node := get_node(idx)
    if node.kind == "index" and node.children.len() >= 2:
        return ir_expr_is_fresh_string_index(idx)
    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return node.value.len() == 1
    if node.kind == "call" and node.children.len() >= 2:
        callee := get_node(node.children[0])
        arg := get_node(node.children[1])
        return callee.kind == "ident" and callee.value == "chr" and arg.kind == "int_lit"
    return false

fn ir_try_emit_byte_compare(node: Node, op: String) -> Int:
    left := get_node(node.children[0])
    right := get_node(node.children[1])
    if left.kind != "index" and right.kind != "index":
        return 0 - 1
    if ir_infer_type(node.children[0]) != "string" or ir_infer_type(node.children[1]) != "string":
        return 0 - 1
    if not ir_is_byte_operand(node.children[0]) or not ir_is_byte_operand(node.children[1]):
        return 0 - 1
    left_b := ir_emit_byte_operand(node.children[0])
    right_b := ir_emit_byte_operand(node.children[1])
    r := ir_reg()
    if op == "eq":
        ir_emit("eq " + r.to_string() + " " + left_b.to_string() + " " + right_b.to_string())
    else:
        ir_emit("neq " + r.to_string() + " " + left_b.to_string() + " " + right_b.to_string())
    return r

# Short-circuit `and` / `or`. Pith's other IR operators lower with both
# operands eagerly evaluated, but that means guards like
# `if i == 0 or item != list[i-1]` still index `list[-1]` on the LHS-true
# path. Emit a labeled branch instead so the RHS only runs when the LHS
# doesn't decide the result.
#
#   or:  eval L; if L => merge (result = L); else => eval R (result = R)
#   and: eval L; if L => eval R (result = R); else => merge (result = L)
fn ir_emit_short_circuit_logic(node: Node) -> Int:
    op := node.value
    temp_name := ir_new_temp_name(op)
    default_r := ir_reg()
    ir_emit("iconst " + default_r.to_string() + " 0")
    ir_emit("store " + temp_name + " " + default_r.to_string())
    left_r := ir_expr(node.children[0])
    ir_emit("store " + temp_name + " " + left_r.to_string())
    right_l := ir_label()
    merge_l := ir_label()
    if op == "or":
        ir_emit("brif " + left_r.to_string() + " " + merge_l + " " + right_l)
    else:
        ir_emit("brif " + left_r.to_string() + " " + right_l + " " + merge_l)
    ir_emit("label " + right_l)
    right_r := ir_expr(node.children[1])
    ir_emit("store " + temp_name + " " + right_r.to_string())
    ir_emit("label " + merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

# For an operand node, return the concrete Optional tid when the node is
# a param identifier whose substituted type is Optional. Returns -1
# otherwise. The tid comes from the arg-tid map populated at spec entry —
# the emission-kind concrete_types list flattens Optional to "tuple" and
# would lose the inner type, so we route through the arg tids recorded at
# call sites.
fn ir_generic_param_optional_tid(operand_node: Node) -> Int:
    if operand_node.kind != "ident":
        return - 1
    name := operand_node.value
    if not ir_active_param_optional_tids.contains_key(name):
        return - 1
    return ir_active_param_optional_tids[name]

fn ir_emit_binary_expr(node: Node) -> Int:
    if node.value == "eq" or node.value == "neq":
        fast_r := ir_try_emit_byte_compare(node, node.value)
        if fast_r >= 0:
            return fast_r
    if node.value == "and" or node.value == "or":
        return ir_emit_short_circuit_logic(node)
    left_r := ir_expr(node.children[0])
    right_r := ir_expr(node.children[1])
    r := ir_reg()
    op := node.value
    left_type := ir_infer_type(node.children[0])
    right_type := ir_infer_type(node.children[1])
    left_tid := c_get_expr_type(node.children[0])
    right_tid := c_get_expr_type(node.children[1])
    left_info := get_type_info(left_tid)
    right_info := get_type_info(right_tid)
    left_node := get_node(node.children[0])
    right_node := get_node(node.children[1])
    is_str_op := left_type == "string" or right_type == "string"
    is_bytes_op := left_type == "bytes" and right_type == "bytes"
    is_float_op := left_type == "float" or right_type == "float"
    if op == "eq" or op == "neq":
        if left_node.kind == "none_lit" and right_info.kind == "optional":
            ir_emit_optional_none_compare(r, op, right_r)
            return r
        if right_node.kind == "none_lit" and left_info.kind == "optional":
            ir_emit_optional_none_compare(r, op, left_r)
            return r
        # in a generic impl body, the non-none side's type may be TID_ERR
        # because the struct's type parameters were suppressed at registration;
        # treat `expr == none` / `expr != none` as an optional comparison anyway
        if ir_current_impl_subst_params.len() > 0:
            if left_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, right_r)
                return r
            if right_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, left_r)
                return r
        # T? == T?: raw pointer eq would compare heap addresses, not contents.
        # Compare by (is_some, value) so callers can put an Optional inside
        # assert_eq or a generic container without silently getting identity.
        # Optional type ids are not interned (add_type_info doesn't dedupe),
        # so match by inner type rather than by tid.
        if left_info.kind == "optional" and right_info.kind == "optional" and left_info.inner >= 0 and left_info.inner == right_info.inner:
            ir_emit_optional_optional_compare(r, op, left_r, right_r, left_tid)
            return r
        # Inside a generic specialization the check-time tid is the un-
        # specialized generic marker, so left_info.kind isn't "optional"
        # even when the concrete substituted type is. Recover the tid from
        # the per-spec param map and dispatch structurally. Match by inner
        # type since add_type_info doesn't intern (the two params get
        # different Optional tids for the same shape).
        if ir_active_param_optional_tids.len() > 0:
            gen_left_tid := ir_generic_param_optional_tid(left_node)
            gen_right_tid := ir_generic_param_optional_tid(right_node)
            if gen_left_tid >= 0 and gen_right_tid >= 0:
                lg := get_type_info(gen_left_tid)
                rg := get_type_info(gen_right_tid)
                if lg.inner >= 0 and lg.inner == rg.inner:
                    ir_emit_optional_optional_compare(r, op, left_r, right_r, gen_left_tid)
                    return r
            if gen_left_tid >= 0 and right_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, left_r)
                return r
            if gen_right_tid >= 0 and left_node.kind == "none_lit":
                ir_emit_optional_none_compare(r, op, right_r)
                return r
    if is_float_op and ir_is_float_arithmetic(op):
        ir_emit_float_binary(r, op, left_r, right_r)
        return r
    if op == "add" and is_str_op:
        ir_emit("concat " + r.to_string() + " " + left_r.to_string() + " " + right_r.to_string())
        # owned operands (nested concats, interpolations, fresh method
        # results) are garbage once copied into the new buffer; borrowed
        # operands keep their owner's count. literals release as no-ops.
        ir_release_owned_string_operand(node.children[0], left_r, left_type)
        ir_release_owned_string_operand(node.children[1], right_r, right_type)
    elif op == "eq":
        if is_str_op:
            ir_emit_call2(r, "__str_eq", "bool", left_r, right_r)
            ir_release_owned_string_operand(node.children[0], left_r, left_type)
            ir_release_owned_string_operand(node.children[1], right_r, right_type)
        elif is_bytes_op:
            ir_emit_call2(r, "bytes_eq", "bool", left_r, right_r)
        elif ir_binary_enum_eq_name(node) != "":
            # boxed enum values are pointers; a raw eq is identity, not
            # equality — call the per-enum structural helper
            ir_emit_call2(r, "__enum_eq_" + ir_binary_enum_eq_name(node), "bool", left_r, right_r)
        else:
            ir_emit_simple_binary(r, "eq", left_r, right_r)
    elif op == "neq":
        if ir_binary_enum_eq_name(node) != "":
            eq_r := ir_reg()
            ir_emit_call2(eq_r, "__enum_eq_" + ir_binary_enum_eq_name(node), "bool", left_r, right_r)
            zr := ir_reg()
            ir_emit("iconst " + zr.to_string() + " 0")
            ir_emit("eq " + r.to_string() + " " + eq_r.to_string() + " " + zr.to_string())
        else:
            ir_emit_binary_neq(r, left_r, right_r, is_str_op, is_bytes_op)
            if is_str_op:
                ir_release_owned_string_operand(node.children[0], left_r, left_type)
                ir_release_owned_string_operand(node.children[1], right_r, right_type)
    else:
        simple_op := ir_binary_simple_ir_op(op)
        if simple_op.len() > 0:
            if is_str_op and ir_binary_op_is_comparison(simple_op):
                # ordered string comparison calls the runtime: the simple
                # op would compare the two pointers, which "works" only by
                # allocation-address luck
                if simple_op == "lt":
                    ir_emit_call2(r, "pith_cstring_lt", "bool", left_r, right_r)
                elif simple_op == "lte":
                    ir_emit_call2(r, "pith_cstring_lte", "bool", left_r, right_r)
                elif simple_op == "gt":
                    ir_emit_call2(r, "pith_cstring_lt", "bool", right_r, left_r)
                else:
                    ir_emit_call2(r, "pith_cstring_lte", "bool", right_r, left_r)
                ir_release_owned_string_operand(node.children[0], left_r, left_type)
                ir_release_owned_string_operand(node.children[1], right_r, right_type)
            else:
                ir_emit_simple_binary(r, simple_op, left_r, right_r)
        else:
            ir_emit("binop " + r.to_string() + " " + op + " " + left_r.to_string() + " " + right_r.to_string())
    return r

fn ir_test_assert_fail():
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    exit_r := ir_reg()
    ir_emit_call1(exit_r, "exit", "unknown", one_r)

fn ir_test_assert_fail_return():
    ir_test_assert_fail()
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("ret " + one_r.to_string())

fn ir_assert_eq_operand_type(node: Node, child_idx: Int) -> String:
    if node.children.len() <= child_idx:
        return ""
    mut expr_idx := node.children[child_idx]
    child_node := get_node(expr_idx)
    if child_node.kind == "arg" and child_node.children.len() > 0:
        expr_idx = child_node.children[0]
    return ir_infer_type(expr_idx)

fn ir_emit_test_assert(arg_regs: List[Int]) -> Int:
    ok_l := ir_label()
    fail_l := ir_label()
    ir_emit("brif " + arg_regs[0].to_string() + " " + ok_l + " " + fail_l)
    ir_emit_label(fail_l)
    assert_r := ir_reg()
    ir_emit_call1(assert_r, "assert", "unknown", arg_regs[0])
    ir_test_assert_fail()
    ir_emit_label(ok_l)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

# the kind that drives assert_eq's value comparison and its decoded failure
# message. string wins so a string-vs-int typo still compares as text; otherwise
# the most specific known collection/scalar kind is used.
fn ir_assert_eq_kind(left: String, right: String) -> String:
    if left == "string" or right == "string":
        return "string"
    if left == "bytes" or right == "bytes":
        return "bytes"
    if left == "list_string" or right == "list_string":
        return "list_string"
    if left == "list" or right == "list":
        return "list"
    if left == "float" or right == "float":
        return "float"
    if left == "bool" or right == "bool":
        return "bool"
    return "int"

# the kind code pith_assert_eq_fail uses to decode both sides for the message.
fn ir_assert_eq_kind_code(kind: String) -> Int:
    if kind == "float":
        return 1
    if kind == "string":
        return 2
    if kind == "bytes":
        return 3
    if kind == "bool":
        return 4
    if kind == "list":
        return 5
    if kind == "list_string":
        return 6
    return 0

fn ir_emit_test_assert_eq(node: Node, arg_regs: List[Int]) -> Int:
    cmp_r := ir_reg()
    kind := ir_assert_eq_kind(ir_assert_eq_operand_type(node, 1), ir_assert_eq_operand_type(node, 2))
    # compare by value: bytes and lists otherwise compare heap handles, so two
    # equal-content collections would wrongly differ. maps/sets fall through to
    # identity for now (assert_eq on them is uncommon).
    if kind == "string":
        ir_emit_call2(cmp_r, "__str_eq", "bool", arg_regs[0], arg_regs[1])
    elif kind == "bytes":
        ir_emit_call2(cmp_r, "bytes_eq", "bool", arg_regs[0], arg_regs[1])
    elif kind == "list_string":
        ir_emit_call2(cmp_r, "pith_list_eq_string", "bool", arg_regs[0], arg_regs[1])
    elif kind == "list":
        ir_emit_call2(cmp_r, "pith_list_eq_scalar", "bool", arg_regs[0], arg_regs[1])
    else:
        ir_emit_simple_binary(cmp_r, "eq", arg_regs[0], arg_regs[1])
    ok_l := ir_label()
    fail_l := ir_label()
    ir_emit("brif " + cmp_r.to_string() + " " + ok_l + " " + fail_l)
    ir_emit_label(fail_l)
    kind_r := ir_reg()
    ir_emit("iconst " + kind_r.to_string() + " " + ir_assert_eq_kind_code(kind).to_string())
    fail_r := ir_reg()
    ir_emit_call3(fail_r, "pith_assert_eq_fail", "unknown", arg_regs[0], arg_regs[1], kind_r)
    ir_test_assert_fail()
    ir_emit_label(ok_l)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_local_toml_decode_text_path_call(idx: Int, node: Node, callee_node: Node) -> Int:
    arg_regs := ir_collect_call_arg_regs(node, 1)
    if arg_regs.len() < 2:
        return ir_zero_reg()

    input_r := arg_regs[0]
    dotted_path_r := arg_regs[1]
    temp_name := ir_new_temp_name("toml_decode_text_path")
    ir_var_types.insert(temp_name, "tuple")
    done_l := ir_label()
    parse_result_r := ir_reg()
    ir_emit_call1(parse_result_r, ir_resolve_generic_module_call_name(ir_active_generic_module_path, "parse_required"), "tuple", input_r)
    ir_emit_result_store_error_branch(parse_result_r, temp_name, done_l)
    root_r := ir_emit_result_ok_field_typed(parse_result_r, "Int")

    mut generic_ret_type := ir_checked_type(idx)
    if generic_ret_type.len() == 0:
        generic_ret_type = ir_infer_type(idx)
    mut concrete_types := ir_explicit_generic_concrete_types(callee_node)
    if concrete_types.len() == 0:
        concrete_types = ir_infer_generic_concrete_types("decode_text_path", node)
    decode_path_name := ir_queue_generic_specialization("decode_path", concrete_types, generic_ret_type)
    path_result_r := ir_reg()
    ir_emit_call2(path_result_r, decode_path_name, "tuple", root_r, dotted_path_r)
    ir_emit("store " + temp_name + " " + path_result_r.to_string())
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_list_map_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 3:
        return - 1
    return ir_emit_list_map_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]))

fn ir_emit_list_map_lowering(idx: Int, list_idx: Int, mapper_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    mapper_r := ir_expr(mapper_idx)
    mapper_name := ir_temp_name("__map_fn")
    ir_emit("store " + mapper_name + " " + mapper_r.to_string())

    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = "list"
    mut elem_kind := ir_list_element_kind(list_idx)
    mapped_kind := ir_function_return_kind(mapper_idx)

    return ir_emit_list_map_loop(list_r, mapper_name, ir_retkind(result_kind), ir_retkind(elem_kind), ir_retkind(mapped_kind), ir_temp_name("__map_i"))

fn ir_emit_list_filter_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 3:
        return - 1
    return ir_emit_list_filter_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]))

fn ir_emit_list_filter_lowering(idx: Int, list_idx: Int, keep_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    keep_r := ir_expr(keep_idx)
    keep_name := ir_temp_name("__filter_fn")
    ir_emit("store " + keep_name + " " + keep_r.to_string())

    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = ir_infer_type(list_idx)
    if result_kind.len() == 0:
        result_kind = "list"
    mut elem_kind := ir_list_element_kind(list_idx)

    return ir_emit_list_filter_loop(list_r, keep_name, ir_retkind(result_kind), ir_retkind(elem_kind), ir_temp_name("__filter_i"))

fn ir_emit_list_reduce_call(idx: Int, node: Node) -> Int:
    if node.children.len() != 4:
        return - 1
    return ir_emit_list_reduce_lowering(idx, ir_call_arg_expr_index(node.children[1]), ir_call_arg_expr_index(node.children[2]), ir_call_arg_expr_index(node.children[3]))

fn ir_emit_list_reduce_lowering(idx: Int, list_idx: Int, init_idx: Int, reducer_idx: Int) -> Int:
    list_r := ir_expr(list_idx)
    init_r := ir_expr(init_idx)
    reducer_r := ir_expr(reducer_idx)
    reducer_name := ir_temp_name("__reduce_fn")
    acc_name := ir_temp_name("__reduce_acc")
    ir_emit("store " + reducer_name + " " + reducer_r.to_string())
    ir_emit("store " + acc_name + " " + init_r.to_string())

    elem_kind := ir_list_element_kind(list_idx)
    mut result_kind := ir_checked_type(idx)
    if result_kind.len() == 0:
        result_kind = ir_infer_type(init_idx)
    if result_kind.len() == 0:
        result_kind = "unknown"

    return ir_emit_list_reduce_loop(list_r, reducer_name, acc_name, ir_retkind(elem_kind), ir_retkind(result_kind), ir_temp_name("__reduce_i"))

fn ir_emit_higher_order_list_call(idx: Int, node: Node, callee_name: String) -> Int:
    if callee_name == "map":
        return ir_emit_list_map_call(idx, node)
    if callee_name == "filter":
        return ir_emit_list_filter_call(idx, node)
    if callee_name == "reduce":
        return ir_emit_list_reduce_call(idx, node)
    return - 1

fn ir_emit_list_is_empty_method(node: Node) -> Int:
    list_r := ir_expr(node.children[0])
    return ir_emit_list_is_empty(list_r)

fn ir_emit_list_index_search(node: Node, obj_type: String) -> Int:
    if node.children.len() < 2:
        return ir_emit_list_missing_index_result()
    list_idx := node.children[0]
    target_idx := ir_method_call_arg_expr(node, 0)
    list_r := ir_expr(list_idx)
    target_r := ir_expr(target_idx)
    mut elem_kind := ir_list_element_kind(list_idx)
    if obj_type == "list_string":
        elem_kind = "string"

    return ir_emit_list_index_search_loop(list_r, target_r, ir_retkind(elem_kind), ir_temp_name("__list_index_result"), ir_temp_name("__list_index_i"))

fn ir_emit_list_contains_method(node: Node, obj_type: String) -> Int:
    index_r := ir_emit_list_index_search(node, obj_type)
    return ir_emit_list_contains_from_index(index_r)

# Wrap a raw index-search result (a valid index or -1) as an Optional[Int].
# Emits: iconst 0; ge cmp raw 0; if cmp then Some(raw) else None. Reuses
# the existing optional-tuple builders so the layout matches the rest of
# the ABI.
fn ir_emit_index_search_to_optional(raw_r: Int) -> Int:
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    found_r := ir_reg()
    ir_emit("gte " + found_r.to_string() + " " + raw_r.to_string() + " " + zero_r.to_string())
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    result_name := ir_temp_name("__idx_opt_result")
    default_r := ir_reg()
    ir_emit("iconst " + default_r.to_string() + " 0")
    ir_emit("store " + result_name + " " + default_r.to_string())
    ir_emit("brif " + found_r.to_string() + " " + some_l + " " + none_l)
    ir_emit("label " + some_l)
    some_tuple := ir_emit_optional_some_value(raw_r)
    ir_emit("store " + result_name + " " + some_tuple.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit("label " + none_l)
    none_tuple := ir_emit_optional_none_value()
    ir_emit("store " + result_name + " " + none_tuple.to_string())
    ir_emit("label " + merge_l)
    out_r := ir_reg()
    ir_emit("load " + out_r.to_string() + " " + result_name)
    return out_r

fn ir_emit_self_hosted_list_method(idx: Int, node: Node, mname: String, obj_type: String) -> Int:
    if not ir_is_list_runtime_type(obj_type):
        return - 1
    if mname == "is_empty":
        return ir_emit_list_is_empty_method(node)
    if mname == "index_of":
        raw_idx_r := ir_emit_list_index_search(node, obj_type)
        return ir_emit_index_search_to_optional(raw_idx_r)
    if mname == "contains":
        return ir_emit_list_contains_method(node, obj_type)
    if mname == "map":
        # list.map(fn): receiver is the list, child 0; the mapper is arg 0
        return ir_emit_list_map_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0))
    if mname == "filter":
        return ir_emit_list_filter_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0))
    if mname == "reduce":
        # list.reduce(init, fn): init is arg 0, reducer is arg 1
        return ir_emit_list_reduce_lowering(idx, node.children[0], ir_method_call_arg_expr(node, 0), ir_method_call_arg_expr(node, 1))
    return - 1

fn ir_emit_index_json_decode_call(idx: Int, node: Node, callee_idx: Int) -> Int:
    if ir_is_json_decode_callee(callee_idx, "decode") or ir_is_local_generic_callee(callee_idx, "decode", "input"):
        return ir_emit_json_decode_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_text") or ir_is_local_generic_callee(callee_idx, "decode_text", "input"):
        return ir_emit_json_decode_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_object") or ir_is_local_generic_callee(callee_idx, "decode_object", "handle"):
        return ir_emit_json_decode_object_call(idx, node, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_path") or ir_is_local_generic_callee(callee_idx, "decode_path", "handle"):
        return ir_emit_json_decode_path_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_text_path") or ir_is_local_generic_callee(callee_idx, "decode_text_path", "input"):
        return ir_emit_json_decode_path_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_file") or ir_is_local_generic_callee(callee_idx, "decode_file", "file_path"):
        return ir_emit_json_decode_file_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_json_decode_callee(callee_idx, "decode_file_path") or ir_is_local_generic_callee(callee_idx, "decode_file_path", "file_path"):
        return ir_emit_json_decode_file_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    return 0 - 1

fn ir_emit_index_toml_decode_call(idx: Int, node: Node, callee_idx: Int, callee_node: Node) -> Int:
    if ir_is_toml_decode_callee(callee_idx, "decode") or ir_is_local_generic_callee(callee_idx, "decode", "handle"):
        return ir_emit_toml_decode_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_toml_decode_callee(callee_idx, "decode_text") or ir_is_local_generic_callee(callee_idx, "decode_text", "input"):
        return ir_emit_toml_decode_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_toml_decode_callee(callee_idx, "decode_path"):
        return ir_emit_toml_decode_path_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_toml_decode_callee(callee_idx, "decode_text_path"):
        return ir_emit_toml_decode_path_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    if ir_is_local_generic_callee(callee_idx, "decode_text_path", "input"):
        return ir_emit_local_toml_decode_text_path_call(idx, node, callee_node)
    if ir_is_toml_decode_callee(callee_idx, "decode_file") or ir_is_local_generic_callee(callee_idx, "decode_file", "file_path"):
        return ir_emit_toml_decode_file_call(idx, node, false, ir_expr, ir_emit_value_for_target)
    if ir_is_toml_decode_callee(callee_idx, "decode_file_path") or ir_is_local_generic_callee(callee_idx, "decode_file_path", "file_path"):
        return ir_emit_toml_decode_file_call(idx, node, true, ir_expr, ir_emit_value_for_target)
    return 0 - 1

fn ir_emit_index_decode_call(idx: Int, node: Node, callee_idx: Int, callee_node: Node) -> Int:
    json_r := ir_emit_index_json_decode_call(idx, node, callee_idx)
    if json_r >= 0:
        return json_r
    config_r := ir_emit_index_config_decode_call(idx, node, callee_idx, ir_expr, ir_emit_value_for_target)
    if config_r >= 0:
        return config_r
    return ir_emit_index_toml_decode_call(idx, node, callee_idx, callee_node)

fn ir_static_struct_init_call(idx: Int, node: Node, callee_name: String) -> Int:
    expr_tid := c_get_expr_type(idx)
    if expr_tid < 0:
        return 0 - 1
    expr_info := get_type_info(expr_tid)
    if expr_info.kind != "struct":
        return 0 - 1
    if ir_is_declared_callable(callee_name) or ir_is_sync_primitive_name(callee_name):
        return 0 - 1
    # a closure-typed variable or parameter is an indirect call, not a
    # construction: the consumer dispatches through the closure handle
    if ir_lookup_name_type(callee_name) == "closure":
        return 0 - 1
    mut arg_nodes: List[Int] := []
    for child, i in node.children:
        if i == 0:
            continue
        arg_nodes.push(child)
    return ir_emit_struct_positional_init(expr_info.name, arg_nodes)

# substitute a base field type name that is a bare generic param (I, T, U) with
# the instance's concrete type name; anything else passes through unchanged.
fn ir_subst_generic_field_type(base_ftype: String, params: List[String], arg_names: List[String]) -> String:
    mut i := 0
    while i < params.len():
        if params[i] == base_ftype and i < arg_names.len():
            return arg_names[i]
        i = i + 1
    return base_ftype

# does a generic struct instance have any field that must be released once its
# type params are substituted in (e.g. `src: I` bound to a struct)?
fn ir_generic_instance_needs_dtor(base: String, params: List[String], arg_names: List[String]) -> Bool:
    count := ir_struct_field_count(base)
    mut i := 0
    while i < count:
        fname := ir_struct_field_name_at(base, i)
        base_ftype := ir_struct_field_type_name(base, fname)
        if ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names)).len() > 0:
            return true
        i = i + 1
    return false

# a generic struct built inside a generic function lowers to a backend
# constructor call (`call MapIter struct:MapIter`) which attaches no destructor,
# because the checker typed the construction as TID_ERR (its params were
# suppressed). at the specialization site we do know the concrete type args, so
# resolve them and attach a per-instance destructor to the freshly built struct.
# a generic struct built by base name (`Wrap(v, ...)` with no explicit `[args]`)
# lowers to a plain backend `call Wrap` that stores its fields as-is and gets no
# per-instance destructor. it still keeps only the caller's count for a borrowed
# rc field arg, so the caller's owned-arg release would free a value the struct
# still holds. retain each borrowed rc arg here to give the field its own count;
# the value's own kind classifies it, since the field's declared type is a bare
# generic param the checker leaves unresolved in a generic body.
fn ir_retain_base_name_construction_fields(node: Node, callee_name: String, arg_regs: List[Int]):
    if not ir_struct_names.contains_key(callee_name):
        return
    if not has_generic_declaration(callee_name):
        return
    mut reg_i := 0
    for child, i in node.children:
        if i == 0:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                reg_i = reg_i + 1
                continue
            expr_idx = cn.children[0]
        arg_kind := ir_rc_kind(ir_infer_type(expr_idx))
        if arg_kind.len() > 0 and ir_string_expr_is_borrowed(expr_idx):
            ir_rc_retain_reg(arg_regs[reg_i], arg_kind)
        reg_i = reg_i + 1

# true when a static call is really a generic struct being built through the
# backend constructor path (`Wrap(...)` or `Wrap[T](...)` whose base names a
# generic struct). such a call stores every argument into a field, so its
# arguments follow the container-store transfer rule rather than the
# owned-argument release rule.
fn ir_is_generic_struct_construction_call(node: Node) -> Bool:
    if node.children.len() == 0:
        return false
    cn := get_node(node.children[0])
    mut base := ""
    if cn.kind == "ident":
        base = cn.value
    elif cn.kind == "index" and cn.children.len() >= 2:
        bn := get_node(cn.children[0])
        if bn.kind == "ident":
            base = bn.value
    if base.len() == 0:
        return false
    return ir_struct_names.contains_key(base) and has_generic_declaration(base)

fn ir_attach_generic_construction_dtor(node: Node, ret_type: String, struct_r: Int, arg_regs: List[Int]):
    # the callee is `Base[args]` — an index node whose base names a generic
    # struct; that identifies this call as a generic struct construction.
    callee_node := get_node(node.children[0])
    if callee_node.kind == "ident":
        ir_retain_base_name_construction_fields(node, callee_node.value, arg_regs)
        return
    if callee_node.kind != "index" or callee_node.children.len() < 2:
        return
    base_node := get_node(callee_node.children[0])
    if base_node.kind != "ident":
        return
    base := base_node.value
    if not ir_struct_names.contains_key(base):
        return
    if not has_generic_declaration(base):
        return
    arg_names := ir_explicit_generic_concrete_types(callee_node)
    if arg_names.len() == 0:
        return
    params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
    if not ir_generic_instance_needs_dtor(base, params, arg_names):
        return
    # the backend stored the field args as-is; a borrowed rc arg (a field
    # holding another struct/closure passed by value from a local or param)
    # keeps only its caller's count. the per-instance dtor below releases it,
    # so retain it here to give the field its own count — otherwise the caller
    # and the dtor both release the one count and free it twice. a fresh arg
    # already arrives owned, so is_borrowed gates the retain exactly like the
    # non-generic ir_emit_struct_positional_init path.
    ir_retain_generic_construction_fields(node, base, params, arg_names, arg_regs)
    sym := ir_sanitize_symbol(base + "[" + arg_names.join(",") + "]")
    ir_generic_dtor_base.insert(sym, base)
    ir_generic_dtor_args.insert(sym, arg_names.join(chr(1)))
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __dtor_" + sym)
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + fr.to_string())

# retain each borrowed rc field arg of a backend-constructed generic struct so
# the field owns its own count, balancing the per-instance destructor's release.
fn ir_retain_generic_construction_fields(node: Node, base: String, params: List[String], arg_names: List[String], arg_regs: List[Int]):
    mut reg_i := 0
    for child, i in node.children:
        if i == 0:
            continue
        if reg_i >= arg_regs.len():
            return
        mut expr_idx := child
        cn := get_node(child)
        if cn.kind == "arg":
            if cn.children.len() == 0:
                reg_i = reg_i + 1
                continue
            expr_idx = cn.children[0]
        field_pos := reg_i
        if field_pos < ir_struct_field_count(base):
            fname := ir_struct_field_name_at(base, field_pos)
            base_ftype := ir_struct_field_type_name(base, fname)
            fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
            if fkind.len() > 0 and ir_string_expr_is_borrowed(expr_idx):
                ir_rc_retain_reg(arg_regs[reg_i], fkind)
        reg_i = reg_i + 1

# one destructor per generic struct instance that was constructed via a backend
# constructor call, emitted after the body so every construction site recorded
# its instance. resolves each field type with the instance's args before
# deciding whether to release it.
fn ir_emit_generic_instance_dtors():
    for sym in ir_generic_dtor_base.keys():
        base := ir_generic_dtor_base[sym]
        mut arg_names: List[String] := []
        args_str := ir_generic_dtor_args[sym]
        if args_str.len() > 0:
            arg_names = args_str.split(chr(1))
        params := collect_generic_parameter_names(get_node(get_generic_declaration_index(base)))
        ir_emit_func_header("__dtor_" + sym, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(base)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(base, i)
            base_ftype := ir_struct_field_type_name(base, fname)
            fkind := ir_rc_field_kind(ir_subst_generic_field_type(base_ftype, params, arg_names))
            if fkind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_release_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_specialize_static_callee(idx: Int, node: Node, callee: ResolvedCallee, explicit_generic_types: List[String]) -> ResolvedCallee:
    if not ir_is_generic_function_name(callee.name):
        return callee
    mut generic_ret_type := ir_checked_type(idx)
    if generic_ret_type.len() == 0:
        generic_ret_type = ir_infer_type(idx)
    mut concrete_types := explicit_generic_types
    if concrete_types.len() == 0:
        concrete_types = ir_infer_generic_concrete_types(callee.name, node)
    ir_record_generic_spec_arg_tids(callee.name, concrete_types, ir_generic_arg_tids(node))
    return ResolvedCallee(ir_queue_generic_specialization(callee.name, concrete_types, generic_ret_type), false)

# a call whose callee is an expression rather than a name — a function
# value fetched from a list, a field, or another call. emit the callee
# to a register, stash it in a fresh temp so the consumer sees a named
# closure handle, and dispatch through it. without this the callee's
# base name was mistaken for the target (`ops[0](x)` called `ops`, the
# list itself, and segfaulted).
fn ir_emit_indirect_expr_call(idx: Int, node: Node, callee_idx: Int) -> Int:
    callee_r := ir_expr(callee_idx)
    tmp := ir_new_temp_name("__callee")
    ir_emit("store " + tmp + " " + callee_r.to_string())
    arg_regs := ir_collect_call_arg_regs(node, 1)
    mut ret_kind := ir_function_return_kind(callee_idx)
    if ret_kind == "unknown":
        ret_kind = "int"
    r := ir_reg()
    ir_emit_call_text(r, tmp, ret_kind, arg_regs.len(), ir_join_arg_regs(arg_regs))
    ir_release_owned_string_args(node, 1, arg_regs)
    return r

# true when the callee node is an expression (not a plain name) whose
# checked type is a function value.
fn ir_callee_is_function_expr(callee_idx: Int, callee_node: Node) -> Bool:
    if callee_node.kind == "ident":
        return false
    callee_tid := c_get_expr_type(callee_idx)
    if callee_tid < 0:
        return false
    return get_type_info(callee_tid).kind == "function"

fn ir_emit_static_call(idx: Int, node: Node) -> Int:
    mut explicit_generic_types: List[String] := []
    if node.children.len() > 0:
        callee_node := get_node(node.children[0])
        if callee_node.kind == "index":
            special_r := ir_emit_index_decode_call(idx, node, node.children[0], callee_node)
            if special_r >= 0:
                return special_r
            explicit_generic_types = ir_explicit_generic_concrete_types(callee_node)
        if ir_callee_is_function_expr(node.children[0], callee_node):
            return ir_emit_indirect_expr_call(idx, node, node.children[0])

    mut callee := ResolvedCallee("unknown", false)
    if node.children.len() > 0:
        callee = ir_resolve_static_callee(node.children[0])
        if callee.name.len() == 0:
            callee = ResolvedCallee("unknown", false)
    # ord(s[i]) reads one byte: byte_at skips the one-character string
    # that s[i] would otherwise allocate just to take its code point
    if callee.name == "ord" and node.children.len() >= 2:
        if ir_is_byte_operand(node.children[1]) and get_node(node.children[1]).kind == "index":
            return ir_emit_byte_operand(node.children[1])
    higher_order_r := ir_emit_higher_order_list_call(idx, node, callee.name)
    if higher_order_r >= 0:
        return higher_order_r
    struct_r := ir_static_struct_init_call(idx, node, callee.name)
    if struct_r >= 0:
        return struct_r
    callee = ir_specialize_static_callee(idx, node, callee, explicit_generic_types)
    arg_regs := ir_collect_call_arg_regs(node, 1)
    if callee.name == "Channel" and arg_regs.len() == 0:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        arg_regs.push(zero_r)

    if ir_emit_tests and callee.name == "assert" and arg_regs.len() >= 1:
        return ir_emit_test_assert(arg_regs)
    if ir_emit_tests and callee.name == "assert_eq" and arg_regs.len() >= 2:
        return ir_emit_test_assert_eq(node, arg_regs)

    r := ir_reg()
    uses_result_abi := ir_callee_uses_result_abi(callee, idx)
    ret_type := ir_call_retkind_for_name(idx, uses_result_abi, callee.name)
    ir_emit_call_text(r, callee.name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
    # a generic struct built here (backend constructor call) gets no destructor
    # from the backend; attach a per-instance one so its rc fields release
    ir_attach_generic_construction_dtor(node, ret_type, r, arg_regs)
    # a generic construction stores every argument into a field: a borrowed one
    # is retained above, a fresh one transfers its count. either way the count
    # now belongs to the struct, so the caller must not also release it here —
    # that is the container-store transfer rule (docs/ownership.md) applied to a
    # backend struct build. ordinary calls still release their owned arguments.
    if not ir_is_generic_struct_construction_call(node):
        ir_release_owned_string_args(node, 1, arg_regs)
    if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
        return ir_emit_wrapped_legacy_result(r, ret_type, callee.name)
    return r

fn ir_emit_map_entry_insert(map_r: Int, has_int_keys: Bool, entry: Node, val_target: String):
    if entry.kind != "entry" or entry.children.len() < 2:
        return
    k_r := ir_expr(entry.children[0])
    # wrap the value to its declared kind so an optional value type
    # stores Some(v), not the raw v — the same fix collection element
    # literals need (a map literal typed Map[K, Int?] otherwise stored
    # bare ints and a later .value() dereferenced one as a heap tuple).
    v_r := ir_emit_value_for_target(entry.children[1], val_target)
    if has_int_keys:
        ir_emit_call3(ir_reg(), "map_insert_ikey", "void", map_r, k_r, v_r)
    else:
        ir_emit_call3(ir_reg(), "map_insert", "void", map_r, k_r, v_r)

fn ir_emit_map_literal(idx: Int, node: Node) -> Int:
    map_r := ir_reg()
    has_int_keys := ir_map_uses_int_keys(node)
    mut val_target := ""
    tid := c_get_expr_type(idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "map" and info.value_type >= 0:
            val_target = ir_type_from_tid(info.value_type)
    mut val_is_string := false
    if node.children.len() > 0:
        entry0 := get_node(node.children[0])
        if entry0.kind == "entry" and entry0.children.len() >= 2:
            val_is_string = ir_infer_type(entry0.children[1]) == "string"
    if has_int_keys:
        if val_is_string:
            ir_emit_call0(map_r, "__map_new_int_str_val", "map_int")
        else:
            ir_emit_call0(map_r, "__map_new_int", "map_int")
    elif val_is_string:
        ir_emit_call0(map_r, "__map_new_str_val", "map")
    else:
        ir_emit_call0(map_r, "__map_new", "map")
    for child in node.children:
        ir_emit_map_entry_insert(map_r, has_int_keys, get_node(child), val_target)
    return map_r

fn ir_emit_set_literal(idx: Int, node: Node) -> Int:
    set_r := ir_reg()
    # an empty literal carries no element evidence; the checked type
    # decides between the string and int constructors
    mut literal_type := ir_literal_expr_type(node, "set")
    checked := ir_checked_type(idx)
    if checked == "set_int" or checked == "set":
        literal_type = checked
    ir_emit_call0(set_r, ir_set_new_name(literal_type), literal_type)
    for child in node.children:
        elem_r := ir_expr(child)
        ir_emit_call2(ir_reg(), ir_set_add_name(literal_type), "void", set_r, elem_r)
    return set_r

fn ir_list_ctor_for_elem_kind(elem_kind: String) -> String:
    if elem_kind == "string":
        return "__list_new_str"
    if elem_kind == "list":
        return "__list_new_list"
    if elem_kind == "map":
        return "__list_new_map"
    return "__list_new"

fn ir_emit_list_literal(idx: Int, node: Node) -> Int:
    # a tagged list owns its heap elements: the runtime push retains, and
    # release cascades. the checker's type covers empty literals in any
    # position (a bare `return []` was creating untagged List[String]
    # buffers whose elements nothing owned); the first element is the
    # fallback when no checked type exists.
    mut elem_kind := ""
    # the element's own emission kind: for an optional element it is
    # "tuple", which tells ir_emit_value_for_target to wrap each value as
    # Some. without this, `[1, none, 3]` typed List[Int?] pushed raw ints
    # and a later .value() dereferenced an integer as a heap tuple.
    mut elem_target := ""
    tid := c_get_expr_type(idx)
    if tid >= 0:
        info := get_type_info(tid)
        if info.kind == "list" and info.inner >= 0:
            elem_target = ir_type_from_tid(info.inner)
            elem_kind = ir_rc_kind(elem_target)
    if elem_kind.len() == 0 and node.children.len() > 0:
        elem_kind = ir_rc_kind(ir_infer_type(node.children[0]))
    list_r := ir_reg()
    ir_emit_call0(list_r, ir_list_ctor_for_elem_kind(elem_kind), "list")
    for child in node.children:
        elem_r := ir_emit_value_for_target(child, elem_target)
        ir_emit_call2(ir_reg(), "__list_push", "void", list_r, elem_r)
    return list_r

fn ir_emit_tuple_literal_stores(tuple_r: Int, elem_regs: List[Int], elem_nodes: List[Int]):
    for elem_reg, i in elem_regs:
        if i < elem_nodes.len():
            tuple_kind := ir_rc_kind(ir_infer_type(elem_nodes[i]))
            # a fresh element transfers its count into the tuple; only a
            # borrow needs a retain, mirroring struct construction. the
            # tuple's destructor releases the slot on free either way.
            if tuple_kind.len() > 0 and ir_string_expr_is_borrowed(elem_nodes[i]):
                ir_rc_retain_reg(elem_reg, tuple_kind)
        ir_emit("sstore " + tuple_r.to_string() + " " + i.to_string() + " " + elem_reg.to_string())

# one letter per element kind, so a tuple type maps to a short signature
# ("s0" is (String, Int)). the destructor for a signature releases just
# its rc slots; two tuples with the same signature share one destructor.
fn ir_tuple_elem_code(kind: String) -> String:
    if kind == "string":
        return "s"
    if kind == "list":
        return "l"
    if kind == "map":
        return "m"
    if kind == "set":
        return "t"
    if kind == "bytes":
        return "b"
    if kind == "struct":
        return "u"
    if kind == "closure":
        return "c"
    if kind == "tuple":
        return "p"
    return "0"

fn ir_tuple_dtor_code_kind(code: String) -> String:
    if code == "s":
        return "string"
    if code == "l":
        return "list"
    if code == "m":
        return "map"
    if code == "t":
        return "set"
    if code == "b":
        return "bytes"
    if code == "u":
        return "struct"
    if code == "c":
        return "closure"
    if code == "p":
        return "tuple"
    return ""

fn ir_tuple_dtor_signature(elem_nodes: List[Int]) -> String:
    mut sig := ""
    for child in elem_nodes:
        sig = sig + ir_tuple_elem_code(ir_rc_kind(ir_infer_type(child)))
    return sig

# module-suffixed so each module carries its own copy, exactly like the
# struct destructors — no cross-module references, no name clashes.
fn ir_tuple_dtor_name(sig: String) -> String:
    return "__tuple_dtor_" + sig + "_m" + ir_module_count.to_string()

fn ir_tuple_sig_has_rc(sig: String) -> Bool:
    mut i := 0
    while i < sig.len():
        if sig.substring(i, i + 1) != "0":
            return true
        i = i + 1
    return false

# attach the shared destructor when a tuple holds any rc element; an
# all-scalar tuple needs none (its box frees with no cascade).
fn ir_emit_attach_tuple_dtor(tuple_r: Int, elem_nodes: List[Int]):
    sig := ir_tuple_dtor_signature(elem_nodes)
    if not ir_tuple_sig_has_rc(sig):
        return
    if not ir_tuple_dtor_sigs.contains(sig):
        ir_tuple_dtor_sigs.push(sig)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " " + ir_tuple_dtor_name(sig))
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + tuple_r.to_string() + " " + fr.to_string())

fn ir_emit_tuple_literal(node: Node) -> Int:
    mut elem_regs: List[Int] := []
    mut elem_nodes: List[Int] := []
    for child in node.children:
        elem_regs.push(ir_expr(child))
        elem_nodes.push(child)
    r := ir_reg()
    nf := ir_reg()
    ir_emit("iconst " + nf.to_string() + " " + elem_regs.len().to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:tuple", nf)
    ir_emit_tuple_literal_stores(r, elem_regs, elem_nodes)
    ir_emit_attach_tuple_dtor(r, elem_nodes)
    return r

fn ir_field_lookup_key(recv_idx: Int, field_name: String) -> String:
    return ir_field_receiver_type(recv_idx) + "." + field_name

# the widest payload across an enum's variants. every variant is boxed
# at this size so a match arm can read a payload slot of a value that
# turned out to be a different, narrower variant without running past
# the allocation — the tag check still gates whether the comparison
# counts, but the read itself must stay in bounds and land on a zeroed
# slot (Event.Ping carries no payload, yet a Code(0) arm reads slot 1).
fn ir_enum_max_payload_count(enum_name: String) -> Int:
    mut max_count := 0
    if ir_enum_variant_lists.contains_key(enum_name):
        for vname in ir_enum_variant_lists[enum_name].split(","):
            vkey := enum_name + "." + vname
            if ir_enum_payload_kinds.contains_key(vkey):
                count := ir_enum_payload_kinds[vkey].split(",").len()
                if count > max_count:
                    max_count = count
    return max_count

fn ir_emit_variant_alloc(enum_name: String, variant_key: String, payload_count: Int) -> Int:
    mut slots := ir_enum_max_payload_count(enum_name)
    if payload_count > slots:
        slots = payload_count
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + (slots + 1).to_string())
    r := ir_reg()
    ir_emit_call1(r, "__struct_alloc", "struct:" + enum_name, count_r)
    tag_r := ir_reg()
    ir_emit("iconst " + tag_r.to_string() + " " + ir_struct_field_index_lookup[variant_key])
    ir_emit("sstore " + r.to_string() + " 0 " + tag_r.to_string())
    # attach the tag-aware destructor so the box releases its rc payloads when
    # it dies (self-guards: a no-op for enums with no releasable payloads).
    ir_emit_attach_dtor(r, enum_name)
    return r

# Shape.Circle(2.5): build the boxed value and store each payload argument.
fn ir_emit_variant_construction(node: Node, enum_name: String, variant_key: String) -> Int:
    mut kinds: List[String] := []
    if ir_enum_payload_kinds.contains_key(variant_key):
        kinds = ir_enum_payload_kinds[variant_key].split(",")
    r := ir_emit_variant_alloc(enum_name, variant_key, kinds.len())
    mut i := 0
    while i < kinds.len():
        arg_idx := ir_method_call_arg_expr(node, i)
        if arg_idx >= 0:
            arg_r := ir_expr(arg_idx)
            # the enum value owns a count on rc payloads, same as any
            # other struct-shaped store
            payload_kind := ir_rc_kind(kinds[i])
            if payload_kind.len() > 0 and ir_string_expr_is_borrowed(arg_idx):
                ir_rc_retain_reg(arg_r, payload_kind)
            ir_emit("sstore " + r.to_string() + " " + (i + 1).to_string() + " " + arg_r.to_string())
        i = i + 1
    return r

fn ir_emit_field_access(idx: Int, node: Node) -> Int:
    fname := node_value(idx)
    if node.children.len() == 0:
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 0")
        return r
    recv_node := get_node(node.children[0])
    if recv_node.kind == "ident":
        lookup_key := recv_node.value + "." + fname
        if ir_struct_field_index_lookup.contains_key(lookup_key):
            if ir_struct_field_lookup.contains_key(lookup_key):
                if ir_struct_field_lookup[lookup_key] == recv_node.value:
                    if ir_boxed_enums.contains_key(recv_node.value):
                        return ir_emit_variant_alloc(recv_node.value, lookup_key, 0)
                    r := ir_reg()
                    ir_emit("iconst " + r.to_string() + " " + ir_struct_field_index_lookup[lookup_key])
                    return r
    recv_idx := node.children[0]
    obj_r := ir_expr(recv_idx)
    r := ir_reg()
    if ir_emit_tuple_field_access(r, obj_r, recv_idx, fname):
        return r
    ir_emit_named_field_access(r, obj_r, ir_field_lookup_key(recv_idx, fname), fname, ir_checked_struct_field_type(recv_idx, fname))
    return r

fn ir_emit_result_tuple(is_ok_r: Int, ok_r: Int, err_r: Int) -> Int:
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " 3")
    result_r := ir_reg()
    ir_emit_call1(result_r, "__struct_alloc", "struct:tuple", count_r)
    ir_emit("sstore " + result_r.to_string() + " 0 " + is_ok_r.to_string())
    ir_emit("sstore " + result_r.to_string() + " 1 " + ok_r.to_string())
    ir_emit("sstore " + result_r.to_string() + " 2 " + err_r.to_string())
    return result_r

fn ir_emit_ok_result_tuple(ok_r: Int) -> Int:
    one := ir_reg()
    ir_emit("iconst " + one.to_string() + " 1")
    return ir_emit_result_tuple(one, ok_r, ir_zero_reg())

fn ir_emit_err_result_tuple(err_r: Int) -> Int:
    zero := ir_zero_reg()
    return ir_emit_result_tuple(zero, zero, err_r)

fn ir_emit_wrapped_legacy_result(raw_r: Int, legacy_kind: String, callee_name: String) -> Int:
    temp_name := ir_new_temp_name("legacy_result")
    ir_var_types.insert(temp_name, "tuple")
    zero_r := ir_reg()
    if legacy_kind == "float":
        ir_emit("fconst " + zero_r.to_string() + " 0.0")
    else:
        ir_emit("iconst " + zero_r.to_string() + " 0")
    cond_r := ir_reg()
    ir_emit("neq " + cond_r.to_string() + " " + raw_r.to_string() + " " + zero_r.to_string())
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    mut ok_r := raw_r
    if legacy_kind == "result_int" or legacy_kind == "result_bool":
        ok_r = ir_decode_result_value(raw_r, legacy_kind)
    ok_tuple := ir_emit_ok_result_tuple(ok_r)
    ir_emit("store " + temp_name + " " + ok_tuple.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_tuple := ir_emit_err_result_tuple(ir_emit_result_error_message(callee_name))
    ir_emit("store " + temp_name + " " + err_tuple.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_result_field_access(idx: Int, obj_r: Int, fname: String) -> Int:
    obj_tid := c_get_expr_type(node_child(idx, 0))
    if obj_tid >= 0:
        obj_info := get_type_info(obj_tid)
        if obj_info.kind == "result":
            if fname == "ok":
                return ir_emit_result_value_field(obj_r, obj_tid, "ok")
            if fname == "err":
                return ir_emit_result_value_field(obj_r, obj_tid, "err")
            if fname == "is_ok" or fname == "is_err":
                return ir_emit_result_flag_field(obj_r, fname)
    return 0 - 1

fn ir_method_call_arg_expr(node: Node, arg_index: Int) -> Int:
    actual_index := arg_index + 1
    if actual_index >= node.children.len():
        return 0 - 1
    child := node.children[actual_index]
    cn := get_node(child)
    if cn.kind == "arg" and cn.children.len() > 0:
        return cn.children[0]
    return child

fn ir_emit_result_unwrap_or(node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("unwrap_or")
    arg_idx := ir_method_call_arg_expr(node, 0)
    fallback_r := ir_expr(arg_idx)
    ok_l := ir_label()
    fallback_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + fallback_l)
    ir_emit_label(ok_l)
    ok_value_r := ir_emit_result_value_field(recv_r, recv_tid, "ok")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + ok_value_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(fallback_l)
    ir_emit_release_result_error(recv_r, recv_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + fallback_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_result_value_to_string(recv_r: Int, recv_tid: Int) -> Int:
    mut ok_tid := 0 - 1
    mut err_tid := 0 - 1
    if recv_tid >= 0:
        recv_info := get_type_info(recv_tid)
        if recv_info.kind == "result":
            ok_tid = recv_info.inner
            err_tid = recv_info.value_type
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("result_to_string")
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_r := ir_emit_result_value_field(recv_r, recv_tid, "ok")
    ir_emit("store " + temp_name + " " + ir_emit_stringify_value(ok_r, ok_tid).to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_r := ir_emit_result_value_field(recv_r, recv_tid, "err")
    ir_emit("store " + temp_name + " " + ir_emit_stringify_value(err_r, err_tid).to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_stringify_value(value_r: Int, value_tid: Int) -> Int:
    value_type := ir_type_from_tid(value_tid)
    if value_type == "string":
        return value_r
    out_r := ir_reg()
    if value_type == "bool":
        ir_emit_call1(out_r, "bool_to_string", "string", value_r)
        return out_r
    if value_type == "float":
        ir_emit_call1(out_r, "float_to_string", "string", value_r)
        return out_r
    if value_type == "int":
        ir_emit_call1(out_r, "int_to_string", "string", value_r)
        return out_r
    if value_tid >= 0:
        value_info := get_type_info(value_tid)
        if value_info.kind == "result":
            return ir_emit_result_value_to_string(value_r, value_tid)
    return value_r

fn ir_emit_result_to_string(node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    return ir_emit_result_value_to_string(recv_r, recv_tid)

fn ir_emit_named_handler_call(handler_idx: Int, arg_r: Int, ret_type: String) -> Int:
    handler_node := get_node(handler_idx)
    callee := ir_resolve_static_callee(handler_idx)
    mut call_name := callee.name
    if call_name.len() == 0 and handler_node.kind == "ident":
        call_name = handler_node.value
    if call_name.len() > 0:
        out_r := ir_reg()
        legacy_kind := ir_builtin_result_retkind(call_name)
        mut call_type := ret_type
        if legacy_kind.len() > 0:
            call_type = legacy_kind
        ir_emit_call_text(out_r, call_name, call_type, 1, " " + arg_r.to_string())
        if legacy_kind.len() > 0 and ret_type == "tuple":
            return ir_emit_wrapped_legacy_result(out_r, legacy_kind, call_name)
        return out_r
    handler_r := ir_expr(handler_idx)
    handler_name := ir_new_temp_name("handler")
    ir_emit("store " + handler_name + " " + handler_r.to_string())
    out_r := ir_reg()
    ir_emit_call_text(out_r, handler_name, ret_type, 1, " " + arg_r.to_string())
    return out_r

fn ir_emit_result_or_else(idx: Int, node: Node) -> Int:
    recv_r := ir_expr(node.children[0])
    recv_tid := c_get_expr_type(node.children[0])
    cond_r := ir_emit_result_flag_field(recv_r, "is_ok")
    temp_name := ir_new_temp_name("or_else")
    ir_var_types.insert(temp_name, "tuple")
    handler_idx := ir_method_call_arg_expr(node, 0)
    ok_l := ir_label()
    err_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ir_emit("store " + temp_name + " " + recv_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(err_l)
    err_r := ir_emit_result_value_field(recv_r, recv_tid, "err")
    handled_r := ir_emit_named_handler_call(handler_idx, err_r, ir_checked_type(idx))
    # the handler borrowed the error; the original result is spent now,
    # so drop the error value and the tuple shell before continuing
    ir_emit_release_result_error(recv_r, recv_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", recv_r)
    ir_emit("store " + temp_name + " " + handled_r.to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_select_recv_probe(recv_idx: Int) -> Int:
    recv_node := get_node(recv_idx)
    if recv_node.kind != "method_call" or recv_node.children.len() == 0:
        return ir_zero_reg()
    ch_r := ir_expr(recv_node.children[0])
    r := ir_reg()
    ir_emit_call1(r, "pith_channel_try_recv", "tuple", ch_r)
    return r

fn ir_emit_select_send_probe(send_idx: Int) -> Int:
    send_node := get_node(send_idx)
    if send_node.kind != "method_call" or send_node.children.len() == 0:
        return ir_zero_reg()
    ch_r := ir_expr(send_node.children[0])
    arg_idx := ir_method_call_arg_expr(send_node, 0)
    if arg_idx < 0:
        return ir_zero_reg()
    val_r := ir_expr(arg_idx)
    r := ir_reg()
    ir_emit_call2(r, "pith_channel_try_send", "bool", ch_r, val_r)
    return r

fn ir_emit_select_arm_body(body_idx: Int, bind_name: String, bind_r: Int, bind_type: String) -> Int:
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    if bind_name.len() > 0:
        if bind_type.len() > 0:
            ir_var_types.insert(bind_name, bind_type)
        ir_emit("store " + bind_name + " " + bind_r.to_string())
    body_node := get_node(body_idx)
    mut body_r := ir_zero_reg()
    if body_node.kind == "body":
        if body_node.children.len() > 0:
            body_r = ir_expr(body_node.children[0])
    elif body_node.kind == "block":
        ir_block(body_idx)
    else:
        body_r = ir_expr(body_idx)
    ir_var_regs = saved_vars
    ir_var_types = saved_types
    return body_r

fn ir_select_probe_arm_indices(node: Node) -> List[Int]:
    mut probe_arms: List[Int] := []
    for arm_idx in node.children:
        arm_node := get_node(arm_idx)
        if arm_node.kind == "select_recv_arm" or arm_node.kind == "select_send_arm":
            probe_arms.push(arm_idx)
    return probe_arms

struct IrSelectParts:
    probe_arms: List[Int]
    timeout_idx: Int
    default_idx: Int

fn ir_collect_select_parts(node: Node) -> IrSelectParts:
    mut timeout_idx := 0 - 1
    mut default_idx := 0 - 1
    for child in node.children:
        arm_node := get_node(child)
        if arm_node.kind == "select_timeout_arm" and timeout_idx < 0:
            timeout_idx = child
        elif arm_node.kind == "select_default_arm" and default_idx < 0:
            default_idx = child
    return IrSelectParts(ir_select_probe_arm_indices(node), timeout_idx, default_idx)

fn ir_emit_select_probe_arm(arm_idx: Int, result_temp: String, end_l: String):
    arm_node := get_node(arm_idx)
    if arm_node.kind == "select_recv_arm" and arm_node.children.len() >= 2:
        maybe_r := ir_emit_select_recv_probe(arm_node.children[0])
        ready_r := ir_optional_flag_field(maybe_r)
        hit_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + ready_r.to_string() + " " + hit_l + " " + next_l)
        ir_emit_label(hit_l)
        body_r := ir_emit_select_arm_body(arm_node.children[1], arm_node.value, maybe_r, ir_checked_type(arm_node.children[0]))
        ir_emit("store " + result_temp + " " + body_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(next_l)
    elif arm_node.kind == "select_send_arm" and arm_node.children.len() >= 2:
        ready_r := ir_emit_select_send_probe(arm_node.children[0])
        hit_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + ready_r.to_string() + " " + hit_l + " " + next_l)
        ir_emit_label(hit_l)
        body_r := ir_emit_select_arm_body(arm_node.children[1], "", 0, "")
        ir_emit("store " + result_temp + " " + body_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(next_l)

fn ir_emit_select_deadline(timeout_idx: Int) -> String:
    if timeout_idx < 0:
        return ""
    deadline_name := ir_new_temp_name("select_deadline")
    timeout_node := get_node(timeout_idx)
    timeout_r := ir_expr(timeout_node.children[0])
    now_r := ir_reg()
    ir_emit_call0(now_r, "time", "int")
    deadline_r := ir_reg()
    ir_emit("add " + deadline_r.to_string() + " " + now_r.to_string() + " " + timeout_r.to_string())
    ir_emit("store " + deadline_name + " " + deadline_r.to_string())
    return deadline_name

fn ir_emit_select_offset(probe_count: Int) -> String:
    if probe_count <= 1:
        return ""
    offset_name := ir_new_temp_name("select_offset")
    count_r := ir_reg()
    ir_emit("iconst " + count_r.to_string() + " " + probe_count.to_string())
    seed_r := ir_reg()
    ir_emit_call1(seed_r, "pith_select_next_index", "int", count_r)
    ir_emit("store " + offset_name + " " + seed_r.to_string())
    return offset_name

fn ir_emit_rotated_select_probes(probe_arms: List[Int], offset_name: String, result_temp: String, end_l: String):
    probe_count := probe_arms.len()
    probe_done_l := ir_label()
    offset_r := ir_reg()
    ir_emit("load " + offset_r.to_string() + " " + offset_name)
    mut i := 0
    while i < probe_count:
        case_l := ir_label()
        next_case_l := ir_label()
        match_r := ir_reg()
        case_r := ir_reg()
        ir_emit("iconst " + case_r.to_string() + " " + i.to_string())
        ir_emit("eq " + match_r.to_string() + " " + offset_r.to_string() + " " + case_r.to_string())
        ir_emit("brif " + match_r.to_string() + " " + case_l + " " + next_case_l)
        ir_emit_label(case_l)
        mut j := 0
        while j < probe_count:
            probe_idx := (i + j) % probe_count
            ir_emit_select_probe_arm(probe_arms[probe_idx], result_temp, end_l)
            j = j + 1
        ir_emit("jmp " + probe_done_l)
        ir_emit_label(next_case_l)
        i = i + 1
    ir_emit_label(probe_done_l)

fn ir_emit_select_probes(probe_arms: List[Int], offset_name: String, result_temp: String, end_l: String):
    probe_count := probe_arms.len()
    if probe_count == 0:
        return
    if probe_count == 1:
        ir_emit_select_probe_arm(probe_arms[0], result_temp, end_l)
        return
    ir_emit_rotated_select_probes(probe_arms, offset_name, result_temp, end_l)

fn ir_emit_select_default(default_idx: Int, result_temp: String, end_l: String):
    if default_idx < 0:
        return
    default_node := get_node(default_idx)
    if default_node.children.len() == 0:
        return
    body_r := ir_emit_select_arm_body(default_node.children[0], "", 0, "")
    ir_emit("store " + result_temp + " " + body_r.to_string())
    ir_emit("jmp " + end_l)

fn ir_emit_select_timeout(timeout_idx: Int, deadline_name: String, result_temp: String, end_l: String):
    if timeout_idx < 0:
        return
    now_r := ir_reg()
    ir_emit_call0(now_r, "time", "int")
    deadline_r := ir_reg()
    ir_emit("load " + deadline_r.to_string() + " " + deadline_name)
    expired_r := ir_reg()
    ir_emit("gte " + expired_r.to_string() + " " + now_r.to_string() + " " + deadline_r.to_string())
    timeout_l := ir_label()
    wait_l := ir_label()
    ir_emit("brif " + expired_r.to_string() + " " + timeout_l + " " + wait_l)
    ir_emit_label(timeout_l)
    timeout_node := get_node(timeout_idx)
    body_r := ir_emit_select_arm_body(timeout_node.children[1], "", 0, "")
    ir_emit("store " + result_temp + " " + body_r.to_string())
    ir_emit("jmp " + end_l)
    ir_emit_label(wait_l)

fn ir_advance_select_offset(probe_count: Int, offset_name: String):
    if probe_count <= 1:
        return
    next_offset_r := ir_reg()
    cur_offset_r := ir_reg()
    one_r := ir_reg()
    count_r := ir_reg()
    ir_emit("load " + cur_offset_r.to_string() + " " + offset_name)
    ir_emit("iconst " + one_r.to_string() + " 1")
    ir_emit("iconst " + count_r.to_string() + " " + probe_count.to_string())
    next_sum_r := ir_reg()
    ir_emit("add " + next_sum_r.to_string() + " " + cur_offset_r.to_string() + " " + one_r.to_string())
    ir_emit("mod " + next_offset_r.to_string() + " " + next_sum_r.to_string() + " " + count_r.to_string())
    ir_emit("store " + offset_name + " " + next_offset_r.to_string())

fn ir_emit_select_wait(loop_l: String, probe_count: Int, offset_name: String):
    ir_advance_select_offset(probe_count, offset_name)
    delay_r := ir_reg()
    ir_emit("iconst " + delay_r.to_string() + " 1")
    sleep_r := ir_reg()
    ir_emit_call1(sleep_r, "sleep", "unknown", delay_r)
    ir_emit("jmp " + loop_l)

fn ir_emit_select_expr(node: Node) -> Int:
    result_temp := ir_new_temp_name("select")
    parts := ir_collect_select_parts(node)
    probe_count := parts.probe_arms.len()
    deadline_name := ir_emit_select_deadline(parts.timeout_idx)

    loop_l := ir_label()
    end_l := ir_label()
    ir_emit_label(loop_l)

    offset_name := ir_emit_select_offset(probe_count)
    ir_emit_select_probes(parts.probe_arms, offset_name, result_temp, end_l)
    ir_emit_select_default(parts.default_idx, result_temp, end_l)
    ir_emit_select_timeout(parts.timeout_idx, deadline_name, result_temp, end_l)
    ir_emit_select_wait(loop_l, probe_count, offset_name)
    ir_emit_label(end_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

# --- method call dispatch ---
fn ir_emit_method_call(idx: Int) -> Int:
    node := get_node(idx)
    # first child is object, then args. value is method_name (may have leading dot)
    mname := ir_plain_method_name(node_value(idx))

    # Shape.Circle(2.5) parses as a method call on the enum type name; it is
    # really a variant construction
    if node.children.len() > 0:
        ctor_recv := get_node(node.children[0])
        if ctor_recv.kind == "ident" and ir_boxed_enums.contains_key(ctor_recv.value):
            ctor_key := ctor_recv.value + "." + mname
            if ir_struct_field_index_lookup.contains_key(ctor_key):
                return ir_emit_variant_construction(node, ctor_recv.value, ctor_key)
        # a module-qualified variant, `mod.Enum.Variant(...)`: the receiver is a
        # field access `mod.Enum` where mod is an import alias and Enum is a
        # boxed enum (registered by its base name across modules). resolve it the
        # same as the local `Enum.Variant(...)` form.
        if ctor_recv.kind == "field_access" and ctor_recv.children.len() > 0:
            qual_mod := get_node(ctor_recv.children[0])
            if qual_mod.kind == "ident" and ir_module_aliases.contains_key(qual_mod.value) and ir_boxed_enums.contains_key(ctor_recv.value):
                qual_key := ctor_recv.value + "." + mname
                if ir_struct_field_index_lookup.contains_key(qual_key):
                    return ir_emit_variant_construction(node, ctor_recv.value, qual_key)

    if node.children.len() > 0:
        recv_tid := c_get_expr_type(node.children[0])
        if recv_tid >= 0:
            recv_info := get_type_info(recv_tid)
            if recv_info.kind == "primitive" and mname == "to_string":
                if recv_info.name == "UInt" or recv_info.name == "UInt8" or recv_info.name == "UInt16" or recv_info.name == "UInt32" or recv_info.name == "UInt64":
                    obj_r := ir_expr(node.children[0])
                    out_r := ir_reg()
                    ir_emit_call1(out_r, "uint_to_string", "string", obj_r)
                    return out_r
            if recv_info.kind == "result":
                if mname == "unwrap_or":
                    return ir_emit_result_unwrap_or(node)
                if mname == "or_else":
                    return ir_emit_result_or_else(idx, node)
                if mname == "to_string":
                    return ir_emit_result_to_string(node)
            if recv_info.kind == "optional" and mname == "value":
                # unchecked extraction of the inner value (caller has verified
                # the optional is Some); used by iterator adapters in std.iter
                obj_r := ir_expr(node.children[0])
                return ir_optional_value_field(obj_r, recv_tid)
            if recv_info.kind == "optional" and mname == "unwrap_or":
                # some(v) -> v, none -> the default argument
                obj_r := ir_expr(node.children[0])
                flag_r := ir_optional_flag_field(obj_r)
                tmp := ir_new_temp_name("unwrap_or")
                some_l := ir_label()
                none_l := ir_label()
                end_l := ir_label()
                ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
                ir_emit_label(some_l)
                inner_r := ir_optional_value_field(obj_r, recv_tid)
                ir_emit("store " + tmp + " " + inner_r.to_string())
                ir_emit("jmp " + end_l)
                ir_emit_label(none_l)
                default_idx := ir_method_call_arg_expr(node, 0)
                default_r := ir_expr(default_idx)
                ir_emit("store " + tmp + " " + default_r.to_string())
                ir_emit_label(end_l)
                out_r := ir_reg()
                ir_emit("load " + out_r.to_string() + " " + tmp)
                return out_r
    # In a specialized generic impl body the receiver of `.value()` may have
    # type T? where T was suppressed at registration (so c_get_expr_type returns
    # TID_ERR). Emit the optional value-field extract directly when we're
    # clearly inside such a body.
    if mname == "value" and ir_current_impl_subst_params.len() > 0 and node.children.len() == 1:
        obj_r := ir_expr(node.children[0])
        r := ir_reg()
        ir_emit("field " + r.to_string() + " " + obj_r.to_string() + " 8 unknown value")
        return r

    alias_fname := ir_resolve_module_alias_method_call_name(idx)
    if alias_fname.len() > 0:
        mut call_name := alias_fname
        if ir_is_generic_function_name(call_name):
            mut generic_ret_type := ir_checked_type(idx)
            if generic_ret_type.len() == 0:
                generic_ret_type = ir_infer_type(idx)
            mct := ir_infer_generic_concrete_types(call_name, node)
            ir_record_generic_spec_arg_tids(call_name, mct, ir_generic_arg_tids(node))
            call_name = ir_queue_generic_specialization(call_name, mct, generic_ret_type)
        arg_regs := ir_collect_call_arg_regs(node, 1)
        r := ir_reg()
        uses_result_abi := ir_callee_uses_result_abi(ResolvedCallee(call_name, true), idx)
        ret_type := ir_call_retkind_for_name(idx, uses_result_abi, call_name)
        ir_emit_call_text(r, call_name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
        # module-qualified calls take the same transfer convention as
        # plain static calls: owned string temps die with the call
        ir_release_owned_string_args(node, 1, arg_regs)
        if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
            return ir_emit_wrapped_legacy_result(r, ret_type, call_name)
        return r

    obj_type := ir_method_receiver_type(node)
    self_hosted_list_r := ir_emit_self_hosted_list_method(idx, node, mname, obj_type)
    if self_hosted_list_r >= 0:
        return self_hosted_list_r
    # `self.f(args)` inside a generic impl body where `f` is a closure-typed
    # field: there's no method named `f` on the struct so dispatch would
    # normally emit a literal `call f unknown ...`. instead, load the field
    # into a named local and emit a `call result <tmp> ...` so the consumer's
    # named-vars path routes through pith_closure_get_fn (the same pattern a
    # local `f := fn(...) ...; f(x)` uses).
    # `recv.f(args)` where `f` is a closure-typed field of recv's struct (and
    # not a method of it): load the field and call it through the closure abi,
    # the same as a local `f := ...; f(x)`. covers `self.f()` inside a generic
    # impl and `h.f(x)` on any struct value. the checker only reaches emission
    # for this shape when `f` is genuinely a fn-value field.
    cf_struct := ir_strip_type_args(obj_type)
    if cf_struct.len() > 0:
        field_key := cf_struct + "." + mname
        existing_method := ir_lookup_impl_method_name(obj_type, mname)
        if ir_struct_field_index_lookup.contains_key(field_key) and existing_method.len() == 0:
            recv_r := ir_expr(node.children[0])
            field_idx := ir_unpack_field_index(ir_struct_field_index_lookup[field_key])
            handle_r := ir_reg()
            ir_emit("field " + handle_r.to_string() + " " + recv_r.to_string() + " " + (field_idx * 8).to_string() + " unknown " + mname)
            tmp_name := ir_temp_name("__cl_field")
            ir_emit("store " + tmp_name + " " + handle_r.to_string())
            mut arg_regs: List[Int] := []
            mut ai := 0
            while ai < node.children.len() - 1:
                arg_idx := ir_method_call_arg_expr(node, ai)
                arg_regs.push(ir_expr(arg_idx))
                ai = ai + 1
            r := ir_reg()
            ir_emit("call " + r.to_string() + " " + tmp_name + " unknown " + arg_regs.len().to_string() + ir_join_arg_regs(arg_regs))
            return r
    mut emit_name := ir_method_emit_name(mname, obj_type)
    if emit_name == "list_join" and ir_list_element_kind(node.children[0]) == "int":
        # list_join assumes string elements; Int lists need decimal formatting
        emit_name = "list_join_int"
    if ir_is_bool_returning_method(emit_name):
        ir_var_types.insert("__last_call", "bool")

    # prefer a specialized impl method (registered per-instantiation) so that
    # inside a generic body, self.src.next() dispatches to the specialized
    # version when src's type is itself a generic instance
    mut impl_name := ir_lookup_specialized_method(obj_type, mname)
    if impl_name.len() == 0:
        impl_name = ir_lookup_impl_method_name(obj_type, mname)
    impl_dispatch := impl_name.len() > 0
    if impl_dispatch:
        emit_name = impl_name

    call_regs := ir_collect_method_call_regs(node)
    obj_r := call_regs[0]
    mut arg_regs: List[Int] := []
    mut ci := 0
    while ci + 1 < call_regs.len():
        arg_regs.push(call_regs[ci + 1])
        ci = ci + 1
    r := ir_reg()
    uses_result_abi := ir_callee_uses_result_abi(ResolvedCallee(emit_name, impl_dispatch), idx)
    mut ret_type := ir_call_retkind_for_name(idx, uses_result_abi, emit_name)
    if ir_is_void_method(emit_name):
        ret_type = "void"
    # container stores keep a count for borrowed string values; owned results
    # transfer theirs. untagged containers never release, so a wrong guess
    # here can only leak, never dangle.
    # container stores get special ownership treatment twice below: the
    # compensation retain, and the argument-release skip (ownership
    # transfers into the container at that position)
    mut store_value_pos := 0 - 1
    if emit_name == "send" or emit_name == "pith_channel_send" or emit_name == "push" or emit_name == "pith_list_push_value" or emit_name == "__list_push":
        store_value_pos = 0
    elif emit_name == "insert" or emit_name == "map_insert" or emit_name == "map_insert_ikey" or emit_name == "set" or emit_name == "pith_list_set_value":
        store_value_pos = 1
    if not impl_dispatch:
        # tagged containers retain their elements in the runtime. the
        # emitter still adds a count where tagging cannot be guaranteed:
        # channel sends, container values inside maps, and collection
        # values inside lists (an empty-annotated List[List] is
        # indistinguishable from List[Int] in the type strings, so it is
        # created untagged). a double count on a tagged container is a
        # bounded leak; a missing count is a dangling element.
        if store_value_pos >= 0 and store_value_pos < arg_regs.len():
            value_expr := ir_method_call_arg_expr(node, store_value_pos)
            if value_expr >= 0:
                store_kind := ir_rc_kind(ir_infer_type(value_expr))
                mut compensate := false
                if emit_name == "send" or emit_name == "pith_channel_send":
                    compensate = store_kind.len() > 0
                elif store_kind == "list" or store_kind == "map" or store_kind == "set" or store_kind == "bytes" or store_kind == "struct":
                    compensate = true
                if compensate and ir_string_expr_is_borrowed(value_expr):
                    ir_rc_retain_reg(arg_regs[store_value_pos], store_kind)
    call_args := ir_method_call_arg_regs(obj_r, arg_regs)
    if emit_name == "identity" and not impl_dispatch:
        return obj_r
    ir_emit_call_text(r, emit_name, ret_type, call_args.len(), ir_join_arg_regs(call_args))
    # a string-valued map is created tagged on every construction path,
    # so its insert retains and an owned string argument can complete
    # its transfer by releasing here. other kinds — and maps whose value
    # type the emitter can't prove — keep the skip: their containers may
    # not retain, and releasing would dangle the stored element.
    mut release_skip_pos := store_value_pos
    if store_value_pos >= 0 and (emit_name == "insert" or emit_name == "map_insert" or emit_name == "map_insert_ikey") and node.children.len() > 0:
        skip_expr := ir_method_call_arg_expr(node, store_value_pos)
        if skip_expr >= 0 and ir_rc_kind(ir_infer_type(skip_expr)) == "string":
            if ir_lookup_map_value_type_for_expr(node.children[0]) == "string":
                release_skip_pos = 0 - 1
    ir_release_owned_method_args(node, arg_regs, release_skip_pos)
    if node.children.len() > 0:
        recv_idx := node.children[0]
        recv_kind := ir_rc_kind(ir_infer_type(recv_idx))
        if recv_kind.len() > 0 and not ir_string_expr_is_borrowed(recv_idx):
            ir_rc_release_reg(obj_r, recv_kind)
    if uses_result_abi and ret_type != "tuple" and ir_checked_result_kind(idx) == "tuple":
        return ir_emit_wrapped_legacy_result(r, ret_type, emit_name)
    if ir_is_void_method(emit_name):
        return obj_r
    return r

# --- string interpolation ---
fn ir_string_interp_part_reg(child: Int) -> Int:
    cn := get_node(child)
    if cn.kind == "lit":
        si := ir_str(cn.value)
        part_r := ir_reg()
        ir_emit("strref " + part_r.to_string() + " " + si)
        return part_r
    if cn.kind == "interp_spec":
        return ir_emit_interp_spec_part(cn)
    return ir_string_interp_expr_part(child)

fn ir_string_interp_part_owned(child: Int) -> Bool:
    cn := get_node(child)
    if cn.kind == "interp_spec":
        # spec parts allocate fresh output in every shape
        return true
    if cn.kind == "lit":
        # literal strrefs are static; releasing one is a no-op, so treating
        # them as owned keeps the fold logic uniform
        return true
    # a string-typed expression part passes through as a borrow; any other
    # part type goes through a to-string conversion and arrives fresh
    return ir_infer_type(child) != "string" or not ir_string_expr_is_borrowed(child)

fn ir_emit_string_interp(idx: Int) -> Int:
    node := get_node(idx)
    # fold the parts left to right, releasing each intermediate the moment
    # the next concat has copied it. the fold is straight-line code, so the
    # releases stay in the same block as the values they drop.
    mut result_r := 0 - 1
    mut result_owned := false
    mut _fi4 := 0
    kids4_children := node.children
    while _fi4 < kids4_children.len():
        child := kids4_children[_fi4]
        part_r := ir_string_interp_part_reg(child)
        part_owned := ir_string_interp_part_owned(child)
        if result_r < 0:
            result_r = part_r
            result_owned = part_owned
        else:
            nr := ir_reg()
            ir_emit("concat " + nr.to_string() + " " + result_r.to_string() + " " + part_r.to_string())
            if result_owned:
                ir_string_release_reg(result_r)
            if part_owned:
                ir_string_release_reg(part_r)
            result_r = nr
            result_owned = true
        _fi4 = _fi4 + 1
    if result_r < 0:
        result_r = ir_reg()
        ir_emit("strref " + result_r.to_string() + " " + ir_str(""))
        result_owned = true
    if not result_owned:
        # single borrowed part ("{s}"): callers treat interpolation results
        # as owned, so give this one its own count
        ir_string_retain_reg(result_r)
    return result_r

# --- lambda compilation ---
struct LambdaParts:
    params: List[String]
    body_idx: Int
    captures: List[String]

fn ir_collect_lambda_parts(idx: Int) -> LambdaParts:
    mut params: List[String] := []
    mut body_idx := 0 - 1
    mut i := 0
    while i < node_child_count(idx):
        child := node_child(idx, i)
        cn := get_node(child)
        if cn.kind == "param":
            params.push(cn.value)
        elif cn.kind == "body" or cn.kind == "block":
            body_idx = child
        i = i + 1
    mut captures: List[String] := []
    if body_idx >= 0:
        captures = ir_find_free_vars(body_idx, params)
    return LambdaParts(params, body_idx, captures)

fn ir_reset_lambda_emit_state():
    ir_builder_reset_function()
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()

fn ir_emit_lambda_params(params: List[String]):
    for param in params:
        lr := ir_reg()
        ir_var_regs.insert(param, lr)
        ir_emit("param " + param)

# a lambda's returned value transfers to the caller, like any function
# return: a borrowed string (a field read, a parameter) takes a count
# on the way out, so the caller's release is balanced.
fn ir_emit_lambda_expr_return(expr_idx: Int):
    br := ir_expr(expr_idx)
    if ir_infer_type(expr_idx) == "string" and ir_string_expr_is_borrowed(expr_idx):
        ir_rc_retain_reg(br, "string")
    ir_emit("ret " + br.to_string())

fn ir_emit_lambda_body_value(body_idx: Int):
    if body_idx < 0:
        return
    if node_kind(body_idx) == "body" and node_child_count(body_idx) > 0:
        ir_emit_lambda_expr_return(node_child(body_idx, 0))
        return
    if node_kind(body_idx) == "block":
        # multi-line lambda: statements run in order, return statements
        # produce the value, and the default return after this covers a
        # fall-through end
        ir_block(body_idx)
        return
    ir_emit_lambda_expr_return(body_idx)

fn ir_emit_lambda_default_return():
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")

fn ir_finish_lambda_emit(saved_builder: IrBuilderSnapshot, saved_vars: Map[String, Int], saved_types: Map[String, String]):
    ir_append_deferred_lambda_body()
    ir_builder_restore(saved_builder)
    ir_var_regs = saved_vars
    ir_var_types = saved_types

fn ir_emit_lambda(idx: Int) -> Int:
    # compile lambda body as a separate function
    lambda_name := "__lambda_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    parts := ir_collect_lambda_parts(idx)

    # save current state and emit lambda to deferred buffer
    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)
    saved_string_locals := ir_string_locals
    saved_rc_kinds := ir_rc_local_kinds
    ir_string_locals = []
    ir_rc_local_kinds = []
    ir_reset_lambda_emit_state()
    ir_emit_func_header(lambda_name, parts.params.len() + 1, "unknown")
    ir_emit_lambda_hidden_param()
    ir_emit_lambda_params(parts.params)
    ir_emit_lambda_capture_loads(parts.captures)
    ir_emit_lambda_body_value(parts.body_idx)
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)
    ir_string_locals = saved_string_locals
    ir_rc_local_kinds = saved_rc_kinds
    # return closure handle and fill captures
    r := ir_reg()
    ir_emit("closure_ref " + r.to_string() + " " + lambda_name)
    ir_emit_lambda_capture_setup(r, parts.captures)
    return r

fn ir_emit_spawn_wrapper(call_idx: Int) -> Int:
    wrapper_name := "__spawn_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    mut captures: List[String] := []
    call_node := get_node(call_idx)
    if call_node.children.len() > 0:
        callee := ir_resolve_static_callee(call_node.children[0])
        if callee.name.len() == 0:
            captures = ir_find_free_vars(call_node.children[0], [])
        mut i := 1
        while i < call_node.children.len():
            free_in_arg := ir_find_free_vars(call_node.children[i], [])
            mut j := 0
            while j < free_in_arg.len():
                if not ir_list_contains(captures, free_in_arg[j]):
                    captures.push(free_in_arg[j])
                j = j + 1
            i = i + 1

    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)

    ir_reset_lambda_emit_state()
    ir_emit_func_header(wrapper_name, 1, "unknown")
    ir_emit_lambda_hidden_param()
    ir_emit_lambda_capture_loads(captures)
    ir_emit("ret " + ir_expr(call_idx).to_string())
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)

    closure_r := ir_reg()
    ir_emit("closure_ref " + closure_r.to_string() + " " + wrapper_name)
    ir_emit_lambda_capture_setup(closure_r, captures)
    return closure_r

fn ir_resolve_storage_name(name: String) -> String:
    if ir_import_renames.contains_key(name):
        return ir_import_renames[name]
    if ir_active_generic_module_path.len() > 0 and ir_import_declares_global(ir_active_generic_module_path, name):
        return ir_import_target_name(ir_active_generic_module_path, name)
    return name

fn ir_ident_is_function_value(idx: Int, name: String) -> Bool:
    if ir_var_regs.contains_key(name) or ir_var_types.contains_key(name):
        return false
    callee := ir_ident_callee(name)
    return ir_is_declared_callable(callee.name)

# named functions need a small adapter so they can travel through the same
# closure abi lambdas already use.
fn ir_named_function_value_wrapper(idx: Int, target_name: String) -> String:
    if ir_named_fn_value_wrappers.contains_key(target_name):
        return ir_named_fn_value_wrappers[target_name]

    wrapper_name := "__fnval_" + ir_lambda_count.to_string()
    ir_lambda_count = ir_lambda_count + 1
    tid := c_get_expr_type(idx)
    info := get_type_info(tid)
    mut ret_type := ir_declared_callable_return_type(target_name)
    if ret_type.len() == 0:
        ret_type = "unknown"

    saved_builder := ir_builder_snapshot()
    saved_vars := ir_copy_var_regs(ir_var_regs)
    saved_types := ir_copy_var_types(ir_var_types)

    ir_reset_lambda_emit_state()
    mut param_count := 1
    if info.kind == "function":
        param_count = info.param_types.len() + 1
    ir_emit_func_header(wrapper_name, param_count, ret_type)
    ir_emit_lambda_hidden_param()

    mut arg_names: List[String] := []
    if info.kind == "function":
        mut i := 0
        while i < info.param_types.len():
            arg_name := "__arg_" + i.to_string()
            arg_names.push(arg_name)
            ir_emit_named_param(arg_name, "")
            i = i + 1

    mut arg_regs: List[Int] := []
    for arg_name in arg_names:
        arg_r := ir_reg()
        ir_emit("load " + arg_r.to_string() + " " + arg_name)
        arg_regs.push(arg_r)

    if ret_type == "void":
        call_r := ir_reg()
        ir_emit_call_text(call_r, target_name, "void", arg_regs.len(), ir_join_arg_regs(arg_regs))
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("ret " + zero_r.to_string())
    else:
        call_r := ir_reg()
        ir_emit_call_text(call_r, target_name, ret_type, arg_regs.len(), ir_join_arg_regs(arg_regs))
        ir_emit("ret " + call_r.to_string())
    ir_emit_lambda_default_return()
    ir_finish_lambda_emit(saved_builder, saved_vars, saved_types)
    ir_named_fn_value_wrappers.insert(target_name, wrapper_name)
    return wrapper_name

fn ir_emit_ident_load(idx: Int, name: String) -> Int:
    r := ir_reg()
    if ir_ident_is_function_value(idx, name):
        callee := ir_ident_callee(name)
        wrapper_name := ir_named_function_value_wrapper(idx, callee.name)
        ir_emit("closure_ref " + r.to_string() + " " + wrapper_name)
        return r
    # normal variables and globals still load through storage.
    ir_emit("load " + r.to_string() + " " + ir_resolve_storage_name(name))
    return r

# True when any argument carries a field name (named construction).
fn ir_struct_args_have_names(arg_nodes: List[Int]) -> Bool:
    for an_idx in arg_nodes:
        an := get_node(an_idx)
        if an.kind == "arg" and an.value.len() > 0:
            return true
    return false

# Emit a struct built with named fields (`Point(x: 3, y: 4)`). Fields can be
# given in any order and any defaulted field may be omitted, so we walk the
# struct's declaration order and pull each field's value by name, falling back
# to its default. The checker has already validated names and required fields.
fn ir_emit_struct_named_init(sname: String, arg_nodes: List[Int]) -> Int:
    total_fields := ir_struct_field_count(sname)
    mut field_regs: List[Int] := []
    mut field_idx := 0
    while field_idx < total_fields:
        field_name := ir_struct_field_name_at(sname, field_idx)
        field_type := ir_struct_field_type_name(sname, field_name)
        mut value_node := 0 - 1
        for an_idx in arg_nodes:
            an := get_node(an_idx)
            if an.kind == "arg" and an.value == field_name and an.children.len() > 0:
                value_node = an.children[0]
        if value_node >= 0:
            fr := ir_emit_value_for_target(value_node, field_type)
            named_field_kind := ir_rc_kind(field_type)
            # tuple-typed (optional) field values arrive already owned from
            # ir_emit_value_for_target, so they must not be retained again.
            if named_field_kind.len() > 0 and named_field_kind != "tuple" and ir_string_expr_is_borrowed(value_node):
                ir_rc_retain_reg(fr, named_field_kind)
            field_regs.push(fr)
        else:
            default_idx := ir_struct_field_default_node(sname, field_name)
            if default_idx >= 0:
                field_regs.push(ir_emit_value_for_target(default_idx, field_type))
            else:
                field_regs.push(ir_zero_reg())
        field_idx = field_idx + 1

    r := ir_reg()
    field_count_r := ir_reg()
    ir_emit("iconst " + field_count_r.to_string() + " " + total_fields.to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:" + sname, field_count_r)
    for field_reg, fi in field_regs:
        ir_emit("sstore " + r.to_string() + " " + fi.to_string() + " " + field_reg.to_string())
    ir_emit_attach_dtor(r, sname)
    return r

fn ir_emit_struct_positional_init(sname: String, arg_nodes: List[Int]) -> Int:
    if ir_struct_args_have_names(arg_nodes):
        return ir_emit_struct_named_init(sname, arg_nodes)
    mut field_regs: List[Int] := []
    mut field_idx := 0
    while field_idx < arg_nodes.len():
        child := arg_nodes[field_idx]
        cn := get_node(child)
        ftype := ir_struct_field_type_name(sname, ir_struct_field_name_at(sname, field_idx))
        mut value_idx := child
        if cn.kind == "field_init" and cn.children.len() > 0:
            value_idx = cn.children[0]
        elif cn.kind == "arg" and cn.children.len() > 0:
            value_idx = cn.children[0]
        fr := ir_emit_value_for_target(value_idx, ftype)
        pos_field_kind := ir_rc_kind(ftype)
        # tuple-typed (optional) field values arrive already owned; don't retain.
        if pos_field_kind.len() > 0 and pos_field_kind != "tuple" and ir_string_expr_is_borrowed(value_idx):
            ir_rc_retain_reg(fr, pos_field_kind)
        field_regs.push(fr)
        field_idx = field_idx + 1
    total_fields := ir_struct_field_count(sname)
    while field_idx < total_fields:
        field_name := ir_struct_field_name_at(sname, field_idx)
        default_idx := ir_struct_field_default_node(sname, field_name)
        if default_idx >= 0:
            field_regs.push(ir_emit_value_for_target(default_idx, ir_struct_field_type_name(sname, field_name)))
        else:
            field_regs.push(ir_zero_reg())
        field_idx = field_idx + 1

    r := ir_reg()
    field_count_r := ir_reg()
    ir_emit("iconst " + field_count_r.to_string() + " " + total_fields.to_string())
    ir_emit_call1(r, "__struct_alloc", "struct:" + sname, field_count_r)
    for field_reg, fi in field_regs:
        ir_emit("sstore " + r.to_string() + " " + fi.to_string() + " " + field_reg.to_string())
    ir_emit_attach_dtor(r, sname)
    return r

fn ir_emit_struct_init(node: Node) -> Int:
    return ir_emit_struct_positional_init(node.value, node.children)

fn ir_emit_spawn_expr(node: Node) -> Int:
    if node.children.len() > 0:
        inner := get_node(node.children[0])
        if inner.kind == "call":
            closure_r := ir_emit_spawn_wrapper(node.children[0])
            r := ir_reg()
            ir_emit_call1(r, "spawn", "unknown", closure_r)
            return r
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_try_expr(node: Node) -> Int:
    if node.children.len() > 0:
        result_kind := ir_expr_result_kind(node.children[0])
        val_r := ir_expr(node.children[0])
        if result_kind == "tuple":
            cond_r := ir_emit_result_flag_field(val_r, "is_ok")
            ok_l := ir_label()
            err_l := ir_label()
            merge_l := ir_label()
            ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
            ir_emit_label(ok_l)
            decoded_r := ir_emit_result_ok_field_for_expr(val_r, node.children[0])
            # the extracted payload carries the count; the tuple shell has
            # no destructor, so this frees only the three-slot allocation.
            # the error path returns the same tuple upward instead — its
            # consumer releases it there.
            ir_emit_call1(ir_reg(), "pith_struct_release", "void", val_r)
            ir_emit("jmp " + merge_l)
            ir_emit_label(err_l)
            if ir_emit_tests and ir_emitting_test_func:
                ir_test_assert_fail_return()
            else:
                # propagating the error out early skips the normal return,
                # so release the function's owned locals here too; the error
                # tuple being returned is a fresh value, not a tracked local
                ir_emit_string_cleanup("")
                ir_emit("ret " + val_r.to_string())
            ir_emit_label(merge_l)
            return decoded_r
        mut cond_r := val_r
        mut decoded_r := val_r
        if ir_uses_result_abi(result_kind):
            decoded_r = ir_decode_result_value(val_r, result_kind)
        elif result_kind.len() > 0:
            zero_cmp := ir_reg()
            if result_kind == "float":
                ir_emit("fconst " + zero_cmp.to_string() + " 0.0")
            else:
                ir_emit("iconst " + zero_cmp.to_string() + " 0")
            cond_r = ir_reg()
            ir_emit("neq " + cond_r.to_string() + " " + val_r.to_string() + " " + zero_cmp.to_string())
        ok_l := ir_label()
        err_l := ir_label()
        merge_l := ir_label()
        ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
        ir_emit_label(ok_l)
        ir_emit("jmp " + merge_l)
        ir_emit_label(err_l)
        if ir_emit_tests and ir_emitting_test_func:
            ir_test_assert_fail_return()
        else:
            ir_emit_string_cleanup("")
            zero := ir_reg()
            ir_emit("iconst " + zero.to_string() + " 0")
            ir_emit("ret " + zero.to_string())
        ir_emit_label(merge_l)
        return decoded_r
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_fail_expr(node: Node) -> Int:
    if node.children.len() > 0:
        err_r := ir_expr(node.children[0])
        # the error value transfers to the caller the same way a normal
        # return's value does: a returned local is skipped in cleanup, a
        # returned borrow gets a fresh count. the result tuple only borrows
        # the error slot, so without this the function's other owned locals
        # leaked on every fail (cleanup ran only on the normal return).
        mut exclude := ""
        expr_node := get_node(node.children[0])
        err_kind := ir_rc_kind(ir_infer_type(node.children[0]))
        if err_kind.len() > 0:
            if expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value) == err_kind:
                exclude = expr_node.value
            elif ir_string_expr_is_borrowed(node.children[0]):
                ir_rc_retain_reg(err_r, err_kind)
        tuple_r := ir_emit_err_result_tuple(err_r)
        ir_emit_string_cleanup(exclude)
        ir_emit("ret " + tuple_r.to_string())
    else:
        ir_emit_string_cleanup("")
        ir_emit("ret " + ir_emit_err_result_tuple(ir_zero_reg()).to_string())
    ub := ir_label()
    ir_emit_label(ub)
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_index_expr(idx: Int, node: Node) -> Int:
    obj_r := ir_expr(node.children[0])
    idx_r := ir_expr(node.children[1])
    r := ir_reg()
    mut obj_type := ir_checked_type(node.children[0])
    mut value_type := ir_checked_index_type(idx)
    if obj_type.len() == 0:
        obj_type = ir_infer_type(node.children[0])
    if value_type.len() == 0:
        value_type = ir_lookup_map_value_type_for_expr(node.children[0])
    if value_type.len() == 0:
        value_type = ir_infer_type(idx)
    # In a T! function, propagate on miss instead of aborting. Callers
    # can `catch` or `unwrap_or` at their level. Outside T! context, the
    # strict variants keep aborting cleanly.
    if ir_current_func_returns_result and ir_index_supports_propagate(obj_type):
        return ir_emit_index_expr_propagate(obj_r, idx_r, obj_type, value_type)
    call_name := ir_index_get_call_name(obj_type)
    if obj_type == "string":
        ir_emit_call2(r, call_name, "string", obj_r, idx_r)
    elif obj_type == "bytes":
        ir_emit_call2(r, call_name, "int", obj_r, idx_r)
    elif obj_type == "map_int" or obj_type == "map":
        if value_type.len() == 0:
            value_type = "unknown"
        ir_emit_call2(r, call_name, value_type, obj_r, idx_r)
    else:
        ir_emit_call2(r, call_name, ir_infer_type(idx), obj_r, idx_r)
    return r

# True when obj_type has an `_opt` runtime we can dispatch to for
# fail-propagate. Maps and lists ship the opt variants; string, bytes,
# and set fall through to the strict runtime (they don't have _opt
# accessors yet).
fn ir_index_supports_propagate(obj_type: String) -> Bool:
    if obj_type == "map":
        return true
    if obj_type == "map_int":
        return true
    if obj_type == "list":
        return true
    if obj_type == "list_string":
        return true
    return false

# Emit `map[k]` / `list[i]` as a fail-propagate: call the _opt runtime,
# branch on is_some, on none return the fail result tuple, on some
# continue with the unwrapped value. Mirrors ir_emit_optional_unwrap.
fn ir_emit_index_expr_propagate(obj_r: Int, idx_r: Int, obj_type: String, value_type: String) -> Int:
    opt_name := ir_index_get_opt_call_name(obj_type)
    opt_r := ir_reg()
    ir_emit_call2(opt_r, opt_name, "tuple", obj_r, idx_r)
    flag_r := ir_optional_flag_field(opt_r)
    some_l := ir_label()
    none_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + flag_r.to_string() + " " + some_l + " " + none_l)
    ir_emit_label(some_l)
    mut val_kind := value_type
    if val_kind.len() == 0:
        val_kind = "unknown"
    unwrapped_r := ir_reg()
    ir_emit("field " + unwrapped_r.to_string() + " " + opt_r.to_string() + " 8 " + val_kind + " value")
    # the _opt wrapper is a throwaway tuple shell; free it now that the value is
    # extracted. releasing it frees only the tuple's slots (no destructor), so
    # the extracted value is untouched — without this every `list[i]` leaks it.
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    ir_emit("jmp " + merge_l)
    ir_emit_label(none_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    if ir_emit_tests and ir_emitting_test_func:
        ir_test_assert_fail_return()
    else:
        msg := ir_str("index out of bounds")
        err_r := ir_reg()
        ir_emit("strref " + err_r.to_string() + " " + msg)
        ir_emit("ret " + ir_emit_err_result_tuple(err_r).to_string())
    ir_emit_label(merge_l)
    return unwrapped_r

fn ir_index_get_opt_call_name(obj_type: String) -> String:
    if obj_type == "map":
        return "map_get_opt"
    if obj_type == "map_int":
        return "map_get_ikey_opt"
    return "pith_list_get_opt"

fn ir_emit_index_assignment(target_idx: Int, value_idx: Int) -> Bool:
    target := get_node(target_idx)
    if target.kind != "index" or target.children.len() < 2:
        return false

    obj_r := ir_expr(target.children[0])
    idx_r := ir_expr(target.children[1])
    mut obj_type := ir_checked_type(target.children[0])
    mut value_type := ir_checked_index_type(target_idx)
    if obj_type.len() == 0:
        obj_type = ir_infer_type(target.children[0])
    if value_type.len() == 0:
        value_type = ir_lookup_map_value_type_for_expr(target.children[0])
    if value_type.len() == 0:
        value_type = ir_infer_type(value_idx)
    value_r := ir_emit_value_for_target(value_idx, value_type)
    # tagged containers retain stored elements in the runtime; the emitter
    # compensates only for maps holding lists/maps/sets, which have no
    # tagged constructor yet.
    idx_store_kind := ir_rc_kind(value_type)
    if idx_store_kind == "list" or idx_store_kind == "map" or idx_store_kind == "set" or idx_store_kind == "bytes" or idx_store_kind == "struct":
        if ir_string_expr_is_borrowed(value_idx):
            ir_rc_retain_reg(value_r, idx_store_kind)
    ir_emit_call3(ir_reg(), ir_index_set_call_name(obj_type), "void", obj_r, idx_r, value_r)
    return true

# --- expression lowering ---
#
# ir_expr is the recursion root: every value-producing node comes
# through here and leaves its result in a register. simple shapes are
# handled inline; anything with control flow or ownership subtlety
# gets its own ir_emit_* function below.
fn ir_expr(idx: Int) -> Int:
    node := get_node(idx)

    if node.kind == "int_lit" or node.kind == "int" or node.kind == "integer":
        return ir_emit_int_literal(node)

    if node.kind == "string_lit" or node.kind == "string" or node.kind == "str_lit":
        return ir_emit_string_literal(node)

    if node.kind == "float_lit" or node.kind == "float":
        return ir_emit_float_literal(node)

    if node.kind == "bool" or node.kind == "bool_lit":
        return ir_emit_bool_literal(node)

    if node.kind == "ident":
        return ir_emit_ident_load(idx, node.value)

    if node.kind == "self":
        return ir_emit_ident_load(idx, "self")

    if node.kind == "unary":
        return ir_emit_unary_expr(node)

    if node.kind == "binary":
        return ir_emit_binary_expr(node)

    if node.kind == "call":
        return ir_emit_static_call(idx, node)

    else:
        return ir_expr_complex(idx, node)

fn ir_emit_zero_value() -> Int:
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

fn ir_emit_field_access_expr(idx: Int, node: Node) -> Int:
    fname := node_value(idx)
    if node.children.len() > 0:
        # a module function used as a value: `hash.sha256_bytes` where `hash`
        # is a module alias and the member is a function. resolve it the way a
        # call would and wrap it into a closure value, the same as a bare
        # function name. this must run before the receiver is evaluated — a
        # module alias is not a loadable value.
        recv_node := get_node(node.children[0])
        if recv_node.kind == "ident" and ir_module_aliases.contains_key(recv_node.value):
            expr_tid := c_get_expr_type(idx)
            if expr_tid >= 0 and get_type_info(expr_tid).kind == "function":
                callee := ir_resolve_static_callee(idx)
                if callee.name.len() > 0:
                    r := ir_reg()
                    wrapper := ir_named_function_value_wrapper(idx, callee.name)
                    ir_emit("closure_ref " + r.to_string() + " " + wrapper)
                    return r
        obj_r := ir_expr(node.children[0])
        # result fields are special: `.ok` and status checks read the tagged value,
        # not a struct field.
        result_r := ir_emit_result_field_access(idx, obj_r, fname)
        if result_r >= 0:
            return result_r
    return ir_emit_field_access(idx, node)

fn ir_emit_await_expr(node: Node) -> Int:
    if node.children.len() == 0:
        return ir_emit_zero_value()
    task_r := ir_expr(node.children[0])
    r := ir_reg()
    ir_emit_call1(r, "await", "unknown", task_r)
    return r

# release a result's error value when it is being discarded. the result
# tuple is a shell with no destructor, so releasing the tuple frees only
# its three slots — a heap error value (a string message, a struct error)
# would leak unless dropped here first.
fn ir_emit_release_result_error(result_r: Int, result_tid: Int):
    err_kind := ir_rc_kind(ir_result_field_kind(result_tid, "err"))
    if err_kind.len() > 0:
        err_r := ir_emit_result_value_field(result_r, result_tid, "err")
        ir_rc_release_reg(err_r, err_kind)

# fully release a discarded result: drop its live payload (the ok value or the
# err value, depending on the tag) and then free the shell. a bare call
# statement like `buf.write_byte(x)` leaves the result unowned, so without this
# its box — and any heap payload — leaks. mirrors the ownership dance in catch.
fn ir_emit_discard_result(result_r: Int, result_tid: Int):
    cond_r := ir_emit_result_flag_field(result_r, "is_ok")
    ok_l := ir_label()
    err_l := ir_label()
    done_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + err_l)
    ir_emit_label(ok_l)
    ok_kind := ir_rc_kind(ir_result_field_kind(result_tid, "ok"))
    if ok_kind.len() > 0:
        ok_r := ir_emit_result_value_field(result_r, result_tid, "ok")
        ir_rc_release_reg(ok_r, ok_kind)
    ir_emit("jmp " + done_l)
    ir_emit_label(err_l)
    ir_emit_release_result_error(result_r, result_tid)
    ir_emit("jmp " + done_l)
    ir_emit_label(done_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)

fn ir_emit_catch_expr(node: Node) -> Int:
    result_r := ir_expr(node.children[0])
    result_tid := c_get_expr_type(node.children[0])
    cond_r := ir_emit_result_flag_field(result_r, "is_ok")
    temp_name := ir_new_temp_name("catch")
    ok_l := ir_label()
    fallback_l := ir_label()
    merge_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + ok_l + " " + fallback_l)
    ir_emit_label(ok_l)
    ok_value_r := ir_emit_result_value_field(result_r, result_tid, "ok")
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    ir_emit("store " + temp_name + " " + ok_value_r.to_string())
    ir_emit("jmp " + merge_l)
    ir_emit_label(fallback_l)
    # the error is being thrown away for the fallback value; drop it first
    ir_emit_release_result_error(result_r, result_tid)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", result_r)
    ir_emit("store " + temp_name + " " + ir_expr(node.children[1]).to_string())
    ir_emit_label(merge_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp_name)
    return r

fn ir_emit_grouped_expr(node: Node) -> Int:
    if node.children.len() > 0:
        return ir_expr(node.children[0])
    return ir_emit_zero_value()

# A match compiles to a linear chain of pattern tests. The subject is evaluated
# once; each arm tests its pattern (and guard) and, on a match, runs its body
# and jumps to the end. Arm bodies that are expressions store their value into a
# result temp, so the whole match can be used as an expression. Bare enum values
# lower to their integer variant index, so variant matching is an integer eq.

# When a match sits in a function's tail position its value is the function's
# implicit return. This holds that match node so its arms emit `ret` directly.

# Emit an arm body that returns its value (tail-position match). Block bodies
# run as statements (and return on their own).
fn ir_expr_complex(idx: Int, node: Node) -> Int:
    kind := node_kind(idx)
    if kind == "match_expr":
        if idx == ir_tail_match_node:
            ir_emit_match_return(idx, node, ir_expr, ir_block)
            return ir_emit_zero_value()
        return ir_emit_match_expr(idx, node, ir_expr, ir_block)
    if kind == "method_call":
        return ir_emit_method_call(idx)

    if kind == "string_interp":
        return ir_emit_string_interp(idx)

    if kind == "map":
        # an empty {} annotated as a set must build a set, not a map:
        # the wrong container silently swallows inserts and its method
        # calls take the map arg shapes
        checked_lit := ir_checked_type(idx)
        if checked_lit == "set" or checked_lit == "set_int":
            return ir_emit_set_literal(idx, node)
        return ir_emit_map_literal(idx, node)

    if kind == "set":
        return ir_emit_set_literal(idx, node)

    if kind == "list":
        return ir_emit_list_literal(idx, node)

    if kind == "tuple":
        return ir_emit_tuple_literal(node)

    if kind == "struct_init":
        return ir_emit_struct_init(node)

    if kind == "field_access":
        return ir_emit_field_access_expr(idx, node)

    if kind == "lambda":
        return ir_emit_lambda(idx)

    if kind == "spawn":
        return ir_emit_spawn_expr(node)

    if kind == "await":
        return ir_emit_await_expr(node)

    if kind == "unwrap":
        return ir_emit_optional_unwrap(node)

    if kind == "try" or kind == "try_expr":
        return ir_emit_try_expr(node)

    if kind == "catch_expr":
        return ir_emit_catch_expr(node)

    if kind == "select_expr":
        return ir_emit_select_expr(node)

    if kind == "fail":
        return ir_emit_fail_expr(node)

    if kind == "grouped":
        return ir_emit_grouped_expr(node)

    if kind == "index":
        return ir_emit_index_expr(idx, node)

    # fallback
    return ir_emit_zero_value()

fn ir_emit_return_stmt(node: Node):
    if node.children.len() > 0:
        mut r := ir_expr(node.children[0])
        # hand the returned string's count to the caller: a returned local
        # transfers its count (skip it in cleanup), a returned borrow gets
        # a fresh count. fresh results already arrive owned.
        mut exclude := ""
        expr_node := get_node(node.children[0])
        # a returned tracked local transfers its count to the caller, so it
        # must be skipped in the exit cleanup. trust the tracked kind directly:
        # in a generic body the inferred type can miss (a tuple-lowered
        # optional reads back as the optional type, whose rc_kind is empty),
        # yet the local is still tracked and returning it must not release it.
        if expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value).len() > 0:
            exclude = expr_node.value
        else:
            # substitute struct params (T -> the concrete type) so a specialized
            # impl method returning a borrowed T still retains it. without this
            # the inferred type stays "T", rc_kind reads empty, no retain fires,
            # and the caller's arg release frees the value the method handed back.
            ret_kind := ir_rc_kind(ir_substitute_type_name(ir_infer_type(node.children[0])))
            if ret_kind.len() > 0 and ir_string_expr_is_borrowed(node.children[0]):
                ir_rc_retain_reg(r, ret_kind)
        result_kind := ir_expr_result_kind(node.children[0])
        expr_tid := c_get_expr_type(node.children[0])
        mut expr_kind := ""
        if expr_tid >= 0:
            expr_kind = get_type_info(expr_tid).kind
        if ir_current_func_optional_inner_kind.len() > 0:
            # is the returned expression already an optional (so forward it),
            # or the inner value (so wrap in Some)? the checker knows in the
            # normal case; in a generic body a call like `c.maybe()` isn't
            # resolved to optional at declaration time, so also trust the
            # emitter's own retkind — an optional lowers to a tuple, and a
            # tuple retkind can only be the optional wrapper unless the inner
            # value is itself tuple-shaped.
            # a local tracked as a tuple already holds the optional wrapper, so
            # forwarding it (rather than wrapping in Some again) is the same
            # signal as a tuple retkind — the guard against an Optional[Tuple]
            # inner still applies.
            ident_tuple_local := expr_node.kind == "ident" and ir_rc_local_kind(expr_node.value) == "tuple"
            already_optional := expr_kind == "optional" or ((result_kind == "tuple" or ident_tuple_local) and ir_current_func_optional_inner_kind != "tuple")
            if expr_node.kind == "none_lit":
                r = ir_emit_optional_none_value()
            elif already_optional == false:
                r = ir_emit_optional_some_value(r)
        elif ir_current_func_return_kind == "tuple":
            if result_kind != "tuple":
                r = ir_emit_ok_result_tuple(r)
        ir_emit_string_cleanup(exclude)
        ir_emit("ret " + r.to_string())
    else:
        ir_emit_string_cleanup("")
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 0")
        ir_emit("ret " + r.to_string())
    ir_last_was_ret = true

fn ir_emit_bind_stmt(node: Node):
    parts := ir_collect_bind_parts(node)
    name := parts.name
    val_idx := parts.val_idx
    type_idx := parts.type_idx
    # a bind from a call through a closure-typed parameter carries the
    # closure's declared return kind — the one type source that stays
    # reliable in generic bodies, where checked types are suppressed
    if type_idx < 0 and val_idx >= 0:
        vn := get_node(val_idx)
        if vn.kind == "call" and vn.children.len() > 0:
            callee_n := get_node(vn.children[0])
            if callee_n.kind == "ident" and ir_closure_return_kinds.contains_key(callee_n.value):
                ir_var_types.insert(name, ir_closure_return_kinds[callee_n.value])
        # `f := self.make` binds a closure-typed field to a local; carry the
        # field's fn_type return kind so a later `f()` reports the right result
        # kind (the same reason a closure-typed parameter does).
        elif vn.kind == "field_access" and vn.children.len() > 0 and ir_current_impl_type.len() > 0:
            recv := get_node(vn.children[0])
            if recv.kind == "self":
                field_kind := ir_struct_fn_field_return_kind(ir_strip_type_args(ir_current_impl_type), vn.value)
                if field_kind.len() > 0:
                    ir_closure_return_kinds.insert(name, field_kind)
    mut target_type := ""
    if type_idx >= 0:
        target_type = ir_resolve_type_node(type_idx)
        if target_type.len() > 0:
            ir_var_types.insert(name, target_type)
        map_value_type := ir_resolve_map_value_type_node(type_idx)
        if map_value_type.len() > 0:
            ir_map_value_types.insert(name, map_value_type)
    if val_idx >= 0:
        # a tracked string local that is bound again (a loop body re-entering
        # the binding) owns a count on its previous value; capture it before
        # the new value lands, release it after the new value is retained so
        # a self-referencing bind stays alive.
        bind_kind := ir_rc_local_kind(name)
        tracked := bind_kind.len() > 0
        mut old_r := 0 - 1
        if tracked and ir_rc_release_enabled(bind_kind):
            old_r = ir_reg()
            ir_emit("load " + old_r.to_string() + " " + ir_resolve_storage_name(name))
        bind_target := ir_map_init_target(name, target_type)
        r := ir_emit_value_for_target(val_idx, bind_target)
        if tracked and bind_target != "tuple" and ir_string_expr_is_borrowed(val_idx):
            ir_rc_retain_reg(r, bind_kind)
        if old_r >= 0:
            ir_rc_release_reg(old_r, bind_kind)
        ir_var_regs.insert(name, r)
        ir_emit("store " + ir_resolve_storage_name(name) + " " + r.to_string())
        if not ir_var_types.contains_key(name):
            inferred := ir_infer_type(val_idx)
            if inferred.len() > 0:
                ir_var_types.insert(name, inferred)

fn ir_emit_assign_stmt(node: Node):
    name := node.value
    if node.children.len() >= 2:
        if ir_emit_index_assignment(node.children[0], node.children[1]):
            return
    if node.children.len() > 0:
        # same ownership dance as rebinding; string globals get the
        # retain/release pair too but are never in the exit cleanup.
        legacy_kind := ir_rc_kind(ir_lookup_name_type(name))
        tracked := ir_rc_local_kind(name).len() > 0
        mut old_r := 0 - 1
        if legacy_kind.len() > 0 and ir_rc_release_enabled(legacy_kind):
            if tracked or (legacy_kind == "string" and ir_global_string_names.contains(name)):
                old_r = ir_reg()
                ir_emit("load " + old_r.to_string() + " " + ir_resolve_storage_name(name))
        legacy_target := ir_map_init_target(name, ir_lookup_name_type(name))
        r := ir_emit_value_for_target(node.children[0], legacy_target)
        if legacy_kind.len() > 0 and legacy_target != "tuple" and ir_string_expr_is_borrowed(node.children[0]):
            ir_rc_retain_reg(r, legacy_kind)
        if old_r >= 0:
            ir_rc_release_reg(old_r, legacy_kind)
        ir_var_regs.insert(name, r)
        ir_emit("store " + ir_resolve_storage_name(name) + " " + r.to_string())

fn ir_resolve_field_lookup_key(recv_idx: Int, fname: String) -> String:
    direct := ir_field_lookup_key(recv_idx, fname)
    if ir_struct_field_index_lookup.contains_key(direct):
        return direct
    recv_type := ir_field_receiver_type(recv_idx)
    base := ir_strip_type_args(recv_type)
    if base != recv_type:
        base_key := base + "." + fname
        if ir_struct_field_index_lookup.contains_key(base_key):
            return base_key
    return ""

# Assign to a struct field target: `obj.field = value`. Returns false if the
# target is not a known struct field (so the caller falls back to other forms).
fn ir_emit_field_assignment(target_idx: Int, value_idx: Int) -> Bool:
    target := get_node(target_idx)
    if target.kind != "field_access" or target.children.len() == 0:
        return false
    fname := node_value(target_idx)
    recv_idx := target.children[0]
    lookup_key := ir_resolve_field_lookup_key(recv_idx, fname)
    if lookup_key.len() == 0:
        return false
    field_index := ir_unpack_field_index(ir_struct_field_index_lookup[lookup_key])
    obj_r := ir_expr(recv_idx)
    mut value_type := ir_checked_struct_field_type(recv_idx, fname)
    if value_type.len() == 0:
        value_type = ir_infer_type(value_idx)
    fassign_kind := ir_rc_kind(value_type)
    # release the value already in the field before overwriting it, the same
    # ownership dance local and global assignment do. load the old value first
    # so a self-referential rhs (obj.f = obj.f...) still sees it, then release
    # after the store.
    mut old_r := 0 - 1
    if fassign_kind.len() > 0 and ir_rc_release_enabled(fassign_kind):
        old_r = ir_reg()
        ir_emit_named_field_access(old_r, obj_r, lookup_key, fname, value_type)
    value_r := ir_emit_value_for_target(value_idx, value_type)
    # a tuple-typed (optional) rhs is already owned from ir_emit_value_for_target,
    # so it must not be retained again; the old value is still released below, so
    # its payload is freed via the optional's destructor.
    if fassign_kind.len() > 0 and fassign_kind != "tuple" and ir_string_expr_is_borrowed(value_idx):
        ir_rc_retain_reg(value_r, fassign_kind)
    ir_emit("sstore " + obj_r.to_string() + " " + field_index.to_string() + " " + value_r.to_string())
    if old_r >= 0:
        ir_rc_release_reg(old_r, fassign_kind)
    return true

# Compound assign to a struct field: `obj.field += value` (and -=, *=, /=).
fn ir_emit_field_compound_assignment(target_idx: Int, value_idx: Int, compound_op: String) -> Bool:
    target := get_node(target_idx)
    if target.kind != "field_access" or target.children.len() == 0:
        return false
    fname := node_value(target_idx)
    recv_idx := target.children[0]
    lookup_key := ir_resolve_field_lookup_key(recv_idx, fname)
    if lookup_key.len() == 0:
        return false
    field_index := ir_unpack_field_index(ir_struct_field_index_lookup[lookup_key])
    obj_r := ir_expr(recv_idx)
    cur := ir_reg()
    ir_emit_named_field_access(cur, obj_r, lookup_key, fname, ir_checked_struct_field_type(recv_idx, fname))
    rhs := ir_expr(value_idx)
    res := ir_reg()
    ir_emit_simple_binary(res, compound_op, cur, rhs)
    ir_emit("sstore " + obj_r.to_string() + " " + field_index.to_string() + " " + res.to_string())
    return true

fn ir_emit_compound_assignment(node: Node):
    op := node.value
    if op == "=" and node.children.len() >= 2:
        if ir_emit_index_assignment(node.children[0], node.children[1]):
            return
        if ir_emit_field_assignment(node.children[0], node.children[1]):
            return
        tn := get_node(node.children[0])
        name := tn.value
        target_type := ir_checked_target_type(node.children[0], name)
        # same ownership dance as ir_emit_bind_stmt: retain a borrowed RHS,
        # release the value being replaced. this is the path plain
        # `name = value` statements actually take.
        mut assign_kind := ir_rc_kind(target_type)
        if assign_kind.len() == 0:
            assign_kind = ir_rc_kind(ir_lookup_name_type(name))
        tracked := ir_rc_local_kind(name).len() > 0
        mut old_r := 0 - 1
        if assign_kind.len() > 0 and ir_rc_release_enabled(assign_kind):
            if tracked or (assign_kind == "string" and ir_global_string_names.contains(name)):
                old_r = ir_reg()
                ir_emit("load " + old_r.to_string() + " " + ir_resolve_storage_name(name))
        assign_target := ir_map_init_target(name, target_type)
        r := ir_emit_value_for_target(node.children[1], assign_target)
        # a tuple (optional) rhs is owned from ir_emit_value_for_target; don't retain.
        if assign_kind.len() > 0 and assign_target != "tuple" and ir_string_expr_is_borrowed(node.children[1]):
            ir_rc_retain_reg(r, assign_kind)
        if old_r >= 0:
            ir_rc_release_reg(old_r, assign_kind)
        ir_emit("store " + ir_resolve_storage_name(name) + " " + r.to_string())
        return
    compound_op := ir_compound_assignment_ir_op(op)
    if compound_op.len() > 0 and node.children.len() >= 2:
        if ir_emit_field_compound_assignment(node.children[0], node.children[1], compound_op):
            return
        tn := get_node(node.children[0])
        name := tn.value
        cur := ir_reg()
        ir_emit("load " + cur.to_string() + " " + ir_resolve_storage_name(name))
        rhs := ir_expr(node.children[1])
        res := ir_reg()
        ir_emit_simple_binary(res, compound_op, cur, rhs)
        ir_emit("store " + ir_resolve_storage_name(name) + " " + res.to_string())

# emit a label and clear the return-tracking flag: a label starts a
# fresh block, so whatever terminator came before it belongs to a
# different path
fn ir_emit_if_branch(branch: IrIfBranch, then_label: String, next_label: String, end_label: String):
    if branch.cond_idx >= 0:
        cr := ir_expr(branch.cond_idx)
        ir_emit("brif " + cr.to_string() + " " + then_label + " " + next_label)
    ir_emit_label(then_label)
    ir_last_was_ret = false
    if branch.body_idx >= 0:
        ir_block(branch.body_idx)
    if not ir_last_was_ret:
        ir_emit("jmp " + end_label)
    ir_emit_label(next_label)

fn ir_emit_for_loop_value_binding(value_name: String, index_name: String, item_kind: String, iter_name: String, index_name_internal: String):
    it_r := ir_reg()
    ir_emit("load " + it_r.to_string() + " " + iter_name)
    idx_r := ir_reg()
    ir_emit("load " + idx_r.to_string() + " " + index_name_internal)
    elem_r := ir_reg()
    item_ret_kind := ir_for_loop_item_return_kind(item_kind)
    ir_emit_call2(elem_r, ir_for_loop_item_call_name(item_kind), item_ret_kind, it_r, idx_r)
    # always register the loop variable as a local, even when its element type
    # is unknown (as in a generic body where the element is T). otherwise a loop
    # var whose name matches a module function is mistaken for that function and
    # loaded as a fn-value. "unknown" carries no rc kind, so this is release-safe.
    ir_var_types.insert(value_name, item_ret_kind)
    ir_emit("store " + value_name + " " + elem_r.to_string())
    if index_name.len() > 0:
        idx_val := ir_reg()
        ir_emit("load " + idx_val.to_string() + " " + index_name_internal)
        ir_emit("store " + index_name + " " + idx_val.to_string())
        ir_var_types.insert(index_name, "int")

# --- statement lowering ---
#
# statements are where ownership moves: binds and assigns retain,
# rebinds release the old value, returns hand the value out. the
# string-ownership rules live in the long comment above
# ir_emit_call2; every statement shape here follows them.
fn ir_stmt(idx: Int):
    node := get_node(idx)
    kind := node.kind

    # each statement speaks for itself: without this reset, a nested
    # `if x: return` leaves the flag stuck on true, and the statements
    # after it lose their branch-merge jump — the code falls through
    # into the else arm
    ir_last_was_ret = false

    if ir_stmt_is_expr(kind):
        r := ir_expr(idx)
        # a discarded result from a bare `foo()!`-less call owns its box: free
        # its live payload and the shell, or both leak (this is what a bare
        # `buf.write_byte(x)` did before).
        if kind == "call" or kind == "method_call":
            stmt_tid := c_get_expr_type(idx)
            if stmt_tid >= 0 and get_type_info(stmt_tid).kind == "result":
                ir_emit_discard_result(r, stmt_tid)
                return
        # a discarded owned string result (a popped element, an unused
        # fresh string) is garbage as soon as the statement ends
        if ir_infer_type(idx) == "string" and not ir_string_expr_is_borrowed(idx):
            ir_string_release_reg(r)
        return

    if kind == "block":
        ir_block(idx)
        return

    if kind == "return":
        ir_emit_return_stmt(node)
        return

    if kind == "bind" or kind == "binding":
        ir_emit_bind_stmt(node)
        return

    if kind == "assign":
        ir_emit_assign_stmt(node)
        return

    if kind == "assignment":
        ir_emit_compound_assignment(node)
        return

    ir_stmt_control(idx, node)

fn ir_emit_if_stmt(node: Node):
    mut elif_indices: List[Int] := []
    mut else_idx := 0 - 1
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "elif":
            elif_indices.push(child)
        elif cn.kind == "else":
            else_idx = child
    main_branch := ir_collect_if_branch(node)
    end_label := ir_label()
    then_label := ir_label()
    next_label := ir_label()
    ir_emit_if_branch(main_branch, then_label, next_label, end_label)
    for elif_idx in elif_indices:
        branch := ir_collect_if_branch(get_node(elif_idx))
        ir_emit_if_branch(branch, ir_label(), ir_label(), end_label)
    if else_idx >= 0:
        ir_block(else_idx)
    ir_emit_label(end_label)

# if let / while let share the match machinery: a variant pattern uses the
# match condition and binding emitters, a bare binding tests an optional's
# flag and extracts its value.
fn ir_emit_let_cond(pat_idx: Int, subj_r: Int) -> Int:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        r := ir_reg()
        ir_emit_optional_none_compare(r, "neq", subj_r)
        return r
    return ir_emit_match_cond(pat_idx, subj_r)

fn ir_emit_let_bindings(pat_idx: Int, subj_r: Int, subj_idx: Int):
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        subj_tid := c_get_expr_type(subj_idx)
        val_r := ir_optional_value_field(subj_r, subj_tid)
        ir_var_regs.insert(pat.value, val_r)
        if subj_tid >= 0:
            info := get_type_info(subj_tid)
            if info.kind == "optional" and info.inner >= 0:
                inner_kind := ir_type_from_tid(info.inner)
                if inner_kind.len() > 0:
                    ir_var_types.insert(pat.value, inner_kind)
        ir_emit("store " + pat.value + " " + val_r.to_string())
        return
    ir_emit_match_bindings(pat_idx, subj_r, "")

fn ir_emit_if_let_stmt(node: Node):
    if node.children.len() < 3:
        return
    subj_r := ir_expr(node.children[1])
    cond_r := ir_emit_let_cond(node.children[0], subj_r)
    then_l := ir_label()
    else_l := ir_label()
    end_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + then_l + " " + else_l)
    ir_emit_label(then_l)
    ir_last_was_ret = false
    ir_emit_let_bindings(node.children[0], subj_r, node.children[1])
    ir_block(node.children[2])
    if not ir_last_was_ret:
        ir_emit("jmp " + end_l)
    ir_emit_label(else_l)
    ir_last_was_ret = false
    if node.children.len() > 3:
        ir_block(node.children[3])
    ir_emit_label(end_l)
    ir_last_was_ret = false

fn ir_emit_while_let_stmt(node: Node):
    if node.children.len() < 3:
        return
    head_label := ir_label()
    body_label := ir_label()
    end_label := ir_label()
    ir_emit_label(head_label)
    subj_r := ir_expr(node.children[1])
    cond_r := ir_emit_let_cond(node.children[0], subj_r)
    ir_emit("brif " + cond_r.to_string() + " " + body_label + " " + end_label)
    ir_emit_label(body_label)
    ir_last_was_ret = false
    ir_emit_let_bindings(node.children[0], subj_r, node.children[1])
    ir_break_stack = ir_push_string(ir_break_stack, end_label)
    ir_continue_stack = ir_push_string(ir_continue_stack, head_label)
    ir_block(node.children[2])
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit("jmp " + head_label)
    ir_emit_label(end_label)
    ir_last_was_ret = false

fn ir_emit_while_stmt(node: Node):
    head_label := ir_label()
    body_label := ir_label()
    end_label := ir_label()
    ir_emit_label(head_label)
    if node.children.len() >= 2:
        cr := ir_expr(node.children[0])
        ir_emit("brif " + cr.to_string() + " " + body_label + " " + end_label)
        ir_emit_label(body_label)
        ir_break_stack = ir_push_string(ir_break_stack, end_label)
        ir_continue_stack = ir_push_string(ir_continue_stack, head_label)
        ir_block(node.children[1])
        ir_break_stack.remove(ir_break_stack.len() - 1)
        ir_continue_stack.remove(ir_continue_stack.len() - 1)
        ir_emit("jmp " + head_label)
    ir_emit_label(end_label)

fn ir_emit_for_stmt(node: Node):
    names := ir_for_binding_names(node)
    if node.children.len() >= 2:
        if get_node(node.children[0]).kind == "range":
            ir_emit_for_range_stmt(node, names)
            return
        # iterator protocol: a struct with a `next() -> T?` method drives the
        # loop via next() instead of index-based access
        mut iter_struct := ir_infer_type(node.children[0])
        # if the inferred name is a generic struct's base and matches the base
        # of an active generic-function concrete type, promote it to the full
        # instance name so dispatch picks the specialized impl method
        if iter_struct.len() > 0 and iter_struct.contains("[") == false:
            mut gi := 0
            while gi < ir_active_generic_concrete_types.len():
                concrete := ir_active_generic_concrete_types[gi]
                if ir_strip_type_args(concrete) == iter_struct:
                    iter_struct = concrete
                    gi = ir_active_generic_concrete_types.len()
                gi = gi + 1
        # prefer a specialized method body (recorded by per-instantiation
        # emission) so iterators specialized for this instance dispatch
        # without falling back to the base body's unresolved calls
        mut next_name := ir_lookup_specialized_method(iter_struct, "next")
        if next_name.len() == 0:
            next_name = ir_lookup_impl_method_name(iter_struct, "next")
        if next_name.len() > 0:
            ir_emit_for_iterator_stmt(node, names, next_name)
            return
        iter_type := ir_infer_type(node.children[0])
        mut iter_r := ir_expr(node.children[0])
        item_kind := ir_for_iter_item_kind(iter_type)
        # an owned iterable (a split result, a keys() list) dies when the
        # loop ends; a converted iterable is always a fresh container
        mut iter_release_kind := ""
        if not ir_string_expr_is_borrowed(node.children[0]):
            iter_release_kind = ir_rc_kind(iter_type)
        conversion_call := ir_for_iter_conversion_call(iter_type)
        if conversion_call.len() > 0:
            converted_r := ir_reg()
            ir_emit_call1(converted_r, conversion_call, ir_for_iter_conversion_return_kind(iter_type), iter_r)
            if iter_release_kind.len() > 0:
                ir_rc_release_reg(iter_r, iter_release_kind)
            iter_r = converted_r
            iter_release_kind = ir_rc_kind(ir_for_iter_conversion_return_kind(iter_type))
        fid := ir_for_count
        ir_for_count = ir_for_count + 1
        fi := "__for_idx_" + fid.to_string()
        fl := "__for_len_" + fid.to_string()
        ft := "__for_iter_" + fid.to_string()
        len_r := ir_reg()
        ir_emit_call1(len_r, ir_for_len_call_name(item_kind), "int", iter_r)
        idx_r := ir_reg()
        ir_emit("iconst " + idx_r.to_string() + " 0")
        ir_emit("store " + fi + " " + idx_r.to_string())
        ir_emit("store " + fl + " " + len_r.to_string())
        ir_emit("store " + ft + " " + iter_r.to_string())
        head_l := ir_label()
        body_l := ir_label()
        step_l := ir_label()
        end_l := ir_label()
        ir_emit_label(head_l)
        ci := ir_reg()
        ir_emit("load " + ci.to_string() + " " + fi)
        cl := ir_reg()
        ir_emit("load " + cl.to_string() + " " + fl)
        cmp_r := ir_reg()
        ir_emit("lt " + cmp_r.to_string() + " " + ci.to_string() + " " + cl.to_string())
        ir_emit("brif " + cmp_r.to_string() + " " + body_l + " " + end_l)
        ir_emit_label(body_l)
        ir_emit_for_loop_value_binding(names.value_name, names.index_name, item_kind, ft, fi)
        ir_break_stack = ir_push_string(ir_break_stack, end_l)
        ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
        ir_block(node.children[1])
        ir_break_stack.remove(ir_break_stack.len() - 1)
        ir_continue_stack.remove(ir_continue_stack.len() - 1)
        ir_emit_label(step_l)
        idx3 := ir_reg()
        ir_emit("load " + idx3.to_string() + " " + fi)
        one_r := ir_reg()
        ir_emit("iconst " + one_r.to_string() + " 1")
        inc_r := ir_reg()
        ir_emit("add " + inc_r.to_string() + " " + idx3.to_string() + " " + one_r.to_string())
        ir_emit("store " + fi + " " + inc_r.to_string())
        ir_emit("jmp " + head_l)
        ir_emit_label(end_l)
        if iter_release_kind.len() > 0:
            fin_r := ir_reg()
            ir_emit("load " + fin_r.to_string() + " " + ft)
            ir_rc_release_reg(fin_r, iter_release_kind)

# `for i in lo..hi` lowers to a counted loop over an Int counter, with no
# intermediate list allocation. exclusive (`..`) stops at hi, inclusive
# (`..=`) includes it. an optional index binding tracks the 0-based position.
fn ir_emit_for_range_stmt(node: Node, names: IrForBindingNames):
    iter_node := get_node(node.children[0])
    inclusive := iter_node.value == "inclusive"
    lo_r := ir_expr(iter_node.children[0])
    hi_r := ir_expr(iter_node.children[1])
    fid := ir_for_count
    ir_for_count = ir_for_count + 1
    fv := "__for_val_" + fid.to_string()
    fh := "__for_hi_" + fid.to_string()
    fp := "__for_pos_" + fid.to_string()
    has_index := names.index_name.len() > 0
    ir_emit("store " + fv + " " + lo_r.to_string())
    ir_emit("store " + fh + " " + hi_r.to_string())
    if has_index:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("store " + fp + " " + zero_r.to_string())
    head_l := ir_label()
    body_l := ir_label()
    step_l := ir_label()
    end_l := ir_label()
    ir_emit_label(head_l)
    cv := ir_reg()
    ir_emit("load " + cv.to_string() + " " + fv)
    ch := ir_reg()
    ir_emit("load " + ch.to_string() + " " + fh)
    cmp_r := ir_reg()
    mut cmp_op := "lt"
    if inclusive:
        cmp_op = "lte"
    ir_emit(cmp_op + " " + cmp_r.to_string() + " " + cv.to_string() + " " + ch.to_string())
    ir_emit("brif " + cmp_r.to_string() + " " + body_l + " " + end_l)
    ir_emit_label(body_l)
    bind_r := ir_reg()
    ir_emit("load " + bind_r.to_string() + " " + fv)
    ir_var_types.insert(names.value_name, "int")
    ir_emit("store " + names.value_name + " " + bind_r.to_string())
    if has_index:
        pos_r := ir_reg()
        ir_emit("load " + pos_r.to_string() + " " + fp)
        ir_var_types.insert(names.index_name, "int")
        ir_emit("store " + names.index_name + " " + pos_r.to_string())
    ir_break_stack = ir_push_string(ir_break_stack, end_l)
    ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
    ir_block(node.children[1])
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit_label(step_l)
    v3 := ir_reg()
    ir_emit("load " + v3.to_string() + " " + fv)
    one_r := ir_reg()
    ir_emit("iconst " + one_r.to_string() + " 1")
    inc_r := ir_reg()
    ir_emit("add " + inc_r.to_string() + " " + v3.to_string() + " " + one_r.to_string())
    ir_emit("store " + fv + " " + inc_r.to_string())
    if has_index:
        p3 := ir_reg()
        ir_emit("load " + p3.to_string() + " " + fp)
        pone_r := ir_reg()
        ir_emit("iconst " + pone_r.to_string() + " 1")
        pinc_r := ir_reg()
        ir_emit("add " + pinc_r.to_string() + " " + p3.to_string() + " " + pone_r.to_string())
        ir_emit("store " + fp + " " + pinc_r.to_string())
    ir_emit("jmp " + head_l)
    ir_emit_label(end_l)

# `for x in it` where `it` is an iterator (a struct with `next() -> T?`).
# Drives the loop by calling next() each iteration: the result is an optional
# tuple (is_some flag at field 0, value at field 8); stop when the flag is 0.
fn ir_emit_for_iterator_stmt(node: Node, names: IrForBindingNames, next_name: String):
    iter_r := ir_expr(node.children[0])
    fid := ir_for_count
    ir_for_count = ir_for_count + 1
    it_var := "__for_it_" + fid.to_string()
    fp := "__for_pos_" + fid.to_string()
    has_index := names.index_name.len() > 0
    ir_emit("store " + it_var + " " + iter_r.to_string())
    if has_index:
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        ir_emit("store " + fp + " " + zero_r.to_string())
    # the element type was cached on the loop-var node by the checker
    mut elem_kind := ir_retkind(ir_type_from_tid(c_get_expr_type(node.children[2])))
    if elem_kind.len() == 0:
        elem_kind = "unknown"
    head_l := ir_label()
    body_l := ir_label()
    step_l := ir_label()
    end_l := ir_label()
    ir_emit_label(head_l)
    it_cur := ir_reg()
    ir_emit("load " + it_cur.to_string() + " " + it_var)
    opt_r := ir_reg()
    ir_emit("call " + opt_r.to_string() + " " + next_name + " tuple 1 " + it_cur.to_string())
    flag_r := ir_optional_flag_field(opt_r)
    ir_emit("brif " + flag_r.to_string() + " " + body_l + " " + end_l)
    ir_emit_label(body_l)
    val_r := ir_reg()
    ir_emit("field " + val_r.to_string() + " " + opt_r.to_string() + " 8 " + elem_kind + " value")
    ir_var_types.insert(names.value_name, elem_kind)
    ir_emit("store " + names.value_name + " " + val_r.to_string())
    if has_index:
        pos_r := ir_reg()
        ir_emit("load " + pos_r.to_string() + " " + fp)
        ir_var_types.insert(names.index_name, "int")
        ir_emit("store " + names.index_name + " " + pos_r.to_string())
    ir_break_stack = ir_push_string(ir_break_stack, end_l)
    ir_continue_stack = ir_push_string(ir_continue_stack, step_l)
    ir_block(node.children[1])
    ir_break_stack.remove(ir_break_stack.len() - 1)
    ir_continue_stack.remove(ir_continue_stack.len() - 1)
    ir_emit_label(step_l)
    # release the optional next() returned this iteration; the element was
    # borrowed into the loop var (the body retained it if it kept it), so the
    # tuple's own count is dropped here. without this, one optional per step
    # (and the none that ends the loop) leaks.
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)
    if has_index:
        p3 := ir_reg()
        ir_emit("load " + p3.to_string() + " " + fp)
        pone_r := ir_reg()
        ir_emit("iconst " + pone_r.to_string() + " 1")
        pinc_r := ir_reg()
        ir_emit("add " + pinc_r.to_string() + " " + p3.to_string() + " " + pone_r.to_string())
        ir_emit("store " + fp + " " + pinc_r.to_string())
    ir_emit("jmp " + head_l)
    ir_emit_label(end_l)
    ir_emit_call1(ir_reg(), "pith_struct_release", "void", opt_r)

fn ir_stmt_control(idx: Int, node: Node):
    if node.kind == "if" or node.kind == "if_stmt":
        ir_emit_if_stmt(node)

    elif node.kind == "if_let":
        ir_emit_if_let_stmt(node)

    elif node.kind == "while_let":
        ir_emit_while_let_stmt(node)

    elif node.kind == "while" or node.kind == "while_stmt":
        ir_emit_while_stmt(node)

    elif node.kind == "for" or node.kind == "for_stmt":
        ir_emit_for_stmt(node)

# --- block lowering ---
#
# a block is statements plus the two loop-control jumps that need to
# know their enclosing labels (break, continue).
# Recursive block walker — unwrap block/body/then/else wrappers
# and emits statements in source order.
# returns a throwaway 0 so it can travel as a fn value: void
# functions are not yet recognized by the function-value path.
fn ir_block(idx: Int) -> Int:
    kind := node_kind(idx)
    if kind == "block" or kind == "then" or kind == "else" or kind == "body":
        mut i := 0
        child_count := node_child_count(idx)
        while i < child_count:
            ir_block(node_child(idx, i))
            i = i + 1
    else:
        # loop control jumps are the one statement shape that still needs
        # direct block-level handling. everything else goes through ir_stmt.
        if kind == "break":
            if ir_break_stack.len() > 0:
                ir_emit("jmp " + ir_break_stack[ir_break_stack.len() - 1])
                ir_last_was_ret = true
            return 0
        if kind == "continue":
            if ir_continue_stack.len() > 0:
                ir_emit("jmp " + ir_continue_stack[ir_continue_stack.len() - 1])
                ir_last_was_ret = true
            return 0
        ir_stmt(idx)
    return 0

# --- helpers for function emission ---

fn ir_extract_param_type(param_idx: Int) -> String:
    node := get_node(param_idx)
    if node.kind == "param" and node.children.len() > 0:
        return ir_resolve_type_node(node.children[0])
    return "Int"

fn ir_find_body(fn_idx: Int) -> Int:
    node := get_node(fn_idx)
    nk := node.children
    mut i := 0
    while i < nk.len():
        cn := get_node(nk[i])
        if cn.kind == "body":
            return nk[i]
        i = i + 1
    if nk.len() > 0:
        return nk[nk.len() - 1]
    return 0 - 1

fn ir_param_count(fn_idx: Int) -> Int:
    node := get_node(fn_idx)
    nk := node.children
    mut count := 0
    for child in nk:
        cn := get_node(child)
        if cn.kind == "param":
            count = count + 1
    return count

fn ir_record_closure_param_return(param_idx: Int):
    node := get_node(param_idx)
    if node.kind != "param" or node.children.len() == 0:
        return
    tn := get_node(node.children[0])
    if tn.kind != "fn_type" or tn.children.len() == 0:
        return
    # a fn_type node's last child wraps its return type in a "returns"
    # node; a fn type without one returns nothing
    last := get_node(tn.children[tn.children.len() - 1])
    if last.kind != "returns" or last.children.len() == 0:
        return
    ret_kind := ir_resolve_type_node(last.children[0])
    if ret_kind.len() > 0:
        ir_closure_return_kinds.insert(node.value, ret_kind)

fn ir_emit_named_param(name: String, param_type: String):
    r := ir_reg()
    ir_var_regs.insert(name, r)
    if param_type.len() > 0:
        ir_var_types.insert(name, param_type)
    ir_emit("param " + name)

fn ir_emit_fn_params(fn_idx: Int):
    node := get_node(fn_idx)
    nk := node.children
    for child in nk:
        cn := get_node(child)
        if cn.kind == "param":
            mut ptype := ir_extract_param_type(child)
            # inside an impl method, an associated-type param (`x: Item`)
            # resolves to the bound type so it gets the right arc treatment
            if ir_current_impl_type.len() > 0:
                ptype = ir_resolve_assoc_type(ir_current_impl_type, ptype)
            ir_emit_named_param(cn.value, ptype)
            ir_record_closure_param_return(child)

fn ir_extract_return_type(fn_idx: Int) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "type" or rn.kind == "generic_type" or rn.kind == "result_type" or rn.kind == "optional_type":
                    return ir_resolve_type_node(returns_child)
    return "unknown"

fn ir_extract_optional_inner_type(fn_idx: Int) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "optional_type" and rn.children.len() > 0:
                    return ir_resolve_type_node(rn.children[0])
    return ""

# True when the function declared at `fn_idx` returns a Result (T! or T!E).
# Used to decide whether index-expression codegen should propagate a fail
# on miss.
fn ir_fn_returns_result(fn_idx: Int) -> Bool:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "result_type":
                    return true
    return false

fn ir_lookup_impl_method_name(type_name: String, method_name: String) -> String:
    if type_name.len() == 0:
        return ""
    key := ir_impl_method_key(type_name, method_name)
    if ir_impl_methods.contains_key(key):
        return ir_impl_methods[key]
    resolved := ir_resolve_type_hint(type_name)
    if resolved != type_name:
        resolved_key := ir_impl_method_key(resolved, method_name)
        if ir_impl_methods.contains_key(resolved_key):
            return ir_impl_methods[resolved_key]
    if type_name.contains("["):
        base := type_name.substring(0, type_name.index_of("["))
        base_key := ir_impl_method_key(base, method_name)
        if ir_impl_methods.contains_key(base_key):
            return ir_impl_methods[base_key]
    return ""

fn ir_collect_impl_methods(root_idx: Int, module_path: String):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if node.kind == "impl_decl":
            ir_collect_impl_method_signatures(node, module_path)

fn ir_collect_generic_function_decls_from_root(root_idx: Int, module_path: String):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if ir_is_fn_decl_kind(node.kind) and ir_has_generic_params(node):
            ir_record_generic_function_decl(item_idx, node, module_path)

fn ir_infer_generic_concrete_types(name: String, node: Node) -> List[String]:
    if not ir_generic_decl_indices.contains_key(name):
        return ir_generic_arg_types(node)
    return ir_infer_generic_concrete_types_with_state(name, node, ir_generic_decl_indices)

fn ir_resolve_explicit_generic_type_arg(type_idx: Int) -> String:
    type_node := get_node(type_idx)
    if type_node.kind == "ident":
        resolved := ir_specialize_type_name(type_node.value, ir_active_generic_params, ir_active_generic_concrete_types)
        if resolved.len() > 0:
            return resolved
        return ir_resolve_type_hint(type_node.value)
    return ir_resolve_type_node_with_subst(type_idx, ir_active_generic_params, ir_active_generic_concrete_types)

fn ir_explicit_generic_concrete_types(index_node: Node) -> List[String]:
    mut concrete_types: List[String] := []
    mut i := 1
    while i < index_node.children.len():
        concrete_types.push(ir_resolve_explicit_generic_type_arg(index_node.children[i]))
        i = i + 1
    return concrete_types

fn ir_emit_fn_params_with_types(fn_idx: Int, param_types: List[String]):
    node := get_node(fn_idx)
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            mut param_type := ""
            if param_idx < param_types.len():
                param_type = param_types[param_idx]
            ir_emit_named_param(cn.value, param_type)
            ir_record_closure_param_return(child)
            param_idx = param_idx + 1

fn ir_generic_arg_types(node: Node) -> List[String]:
    mut arg_types: List[String] := []
    for child, i in node.children:
        if i == 0:
            continue
        child_kind := node_kind(child)
        mut expr_idx := child
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                expr_idx = cn.children[0]
        checked := ir_checked_type(expr_idx)
        if checked.len() > 0:
            arg_types.push(checked)
        else:
            arg_types.push(ir_infer_type(expr_idx))
    return arg_types

fn ir_generic_arg_tids(node: Node) -> List[Int]:
    mut arg_tids: List[Int] := []
    for child, i in node.children:
        if i == 0:
            continue
        child_kind := node_kind(child)
        mut expr_idx := child
        if child_kind == "arg":
            cn := get_node(child)
            if cn.children.len() > 0:
                expr_idx = cn.children[0]
        arg_tids.push(c_get_expr_type(expr_idx))
    return arg_tids

# resolve a `T.Item` type name through a generic specialization: substitute the
# base param (T -> the concrete type) then look up that type's assoc binding.
fn ir_resolve_assoc_in_generic(type_name: String, params: List[String], concrete: List[String]) -> String:
    if type_name.contains(".") == false:
        return type_name
    parts := type_name.split(".")
    if parts.len() != 2:
        return type_name
    mut i := 0
    for p in params:
        if p == parts[0] and i < concrete.len():
            akey := ir_strip_type_args(concrete[i]) + "." + parts[1]
            if ir_assoc_bindings.contains_key(akey):
                return ir_assoc_bindings[akey]
        i = i + 1
    return type_name

fn ir_emit_generic_specialization(key: String):
    if not ir_generic_specialization_names.contains_key(key):
        return
    base_name := key.split(chr(9))[0]
    if not ir_generic_decl_indices.contains_key(base_name):
        return
    decl_idx := ir_generic_decl_indices[base_name]
    decl_node := get_node(decl_idx)
    generic_params := ir_collect_generic_param_names(decl_node)
    concrete_types := ir_decode_type_list(ir_generic_specialization_type_lists[key])
    spec_name := ir_generic_specialization_names[key]
    body_idx := ir_find_body(decl_idx)
    param_count := ir_param_count(decl_idx)
    ret_type := ir_resolve_assoc_in_generic(ir_extract_return_type_with_subst(decl_idx, generic_params, concrete_types), generic_params, concrete_types)
    mut param_types := ir_extract_param_types_with_subst(decl_idx, generic_params, concrete_types)
    mut resolved_param_types: List[String] := []
    for pt in param_types:
        resolved_param_types.push(ir_resolve_assoc_in_generic(pt, generic_params, concrete_types))
    param_types = resolved_param_types
    saved_params := ir_active_generic_params
    saved_types := ir_active_generic_concrete_types
    saved_module_path := ir_active_generic_module_path
    saved_param_optional_tids := ir_active_param_optional_tids
    ir_active_generic_params = generic_params
    ir_active_generic_concrete_types = concrete_types
    ir_active_param_optional_tids = ir_collect_param_optional_tids(decl_idx, key)
    if ir_generic_decl_module_paths.contains_key(base_name):
        ir_active_generic_module_path = ir_generic_decl_module_paths[base_name]
    else:
        ir_active_generic_module_path = ""
    ir_prepare_func_emission(ret_type)
    ir_current_func_optional_inner_kind = ir_resolve_assoc_in_generic(ir_extract_optional_inner_type_with_subst(decl_idx, generic_params, concrete_types), generic_params, concrete_types)
    ir_current_func_returns_result = ir_fn_returns_result(decl_idx)
    ir_emit_func_header(spec_name, param_count, ret_type)
    ir_emit_fn_params_with_types(decl_idx, param_types)
    ir_func_returns.insert(spec_name, ret_type)
    if concrete_types.len() == 1 and ir_is_config_decode_specialization(base_name, false, ir_active_generic_module_path, decl_idx):
        ir_emit_config_decode_specialization_body(concrete_types[0], false, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_config_decode_specialization(base_name, true, ir_active_generic_module_path, decl_idx):
        ir_emit_config_decode_specialization_body(concrete_types[0], true, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_toml_decode_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_toml_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_toml_decode_text_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_toml_decode_text_specialization_body(concrete_types[0], ir_active_generic_module_path, concrete_types, ret_type)
    elif concrete_types.len() == 1 and ir_is_toml_decode_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_toml_decode_path_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_expr, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_toml_decode_text_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_toml_decode_text_path_specialization_body(concrete_types[0], ir_active_generic_module_path, concrete_types, ret_type)
    elif concrete_types.len() == 1 and ir_is_json_decode_specialization(base_name, ir_active_generic_module_path, decl_idx, false):
        ir_emit_json_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, false, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_specialization(base_name, ir_active_generic_module_path, decl_idx, true):
        ir_emit_json_decode_specialization_body(concrete_types[0], ir_active_generic_module_path, true, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_object_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_json_decode_object_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_emit_value_for_target, ir_emit_default_return)
    elif concrete_types.len() == 1 and ir_is_json_decode_path_specialization(base_name, ir_active_generic_module_path, decl_idx):
        ir_emit_json_decode_path_specialization_body(concrete_types[0], ir_active_generic_module_path, ir_emit_value_for_target, ir_emit_default_return)
    else:
        ir_finish_func_emission(body_idx)
    ir_active_generic_params = saved_params
    ir_active_generic_concrete_types = saved_types
    ir_active_generic_module_path = saved_module_path
    ir_active_param_optional_tids = saved_param_optional_tids

fn ir_collect_param_optional_tids(fn_idx: Int, spec_key: String) -> Map[String, Int]:
    result: Map[String, Int] := {}
    arg_tids := ir_decode_generic_spec_arg_tids(spec_key)
    if arg_tids.len() == 0:
        return result
    node := get_node(fn_idx)
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if param_idx < arg_tids.len():
                tid := arg_tids[param_idx]
                if tid >= 0 and get_type_info(tid).kind == "optional":
                    result.insert(cn.value, tid)
            param_idx = param_idx + 1
    return result

fn ir_emit_generic_specializations():
    mut i := 0
    while i < ir_generic_specialization_keys.len():
        key := ir_generic_specialization_keys[i]
        if not ir_generic_emitted_specializations.contains_key(key):
            ir_emit_generic_specialization(key)
            ir_generic_emitted_specializations.insert(key, 1)
        i = i + 1

fn ir_collect_impl_method_signatures(node: Node, module_path: String):
    impl_type := ir_impl_target_type(node)
    if impl_type.len() == 0:
        return
    for child in node.children:
        method_idx := ir_unwrap_pub_child(child)
        method_node := get_node(method_idx)
        if ir_is_fn_decl_kind(method_node.kind):
            ir_record_impl_method_signature(impl_type, method_idx, method_node, module_path)
    # inherited interface defaults get a signature under this concrete type too
    for default_idx in ir_inherited_default_indices(node):
        ir_record_impl_method_signature(impl_type, default_idx, get_node(default_idx), module_path)

fn ir_record_impl_method_signature(impl_type: String, method_idx: Int, method_node: Node, module_path: String):
    method_name := method_node.value
    mut full_name := impl_type + "_" + method_name
    if module_path.len() > 0:
        full_name = ir_import_impl_method_name(module_path, impl_type, method_name)
    key := ir_impl_method_key(impl_type, method_name)
    ret_type := ir_resolve_assoc_type(impl_type, ir_extract_return_type(method_idx))
    ir_impl_methods.insert(key, full_name)
    ir_func_returns.insert(key, ret_type)
    ir_func_returns.insert(full_name, ret_type)

# returns a throwaway 0 so it can travel as a fn value: void
# functions are not yet recognized by the function-value path.
fn ir_emit_default_return() -> Int:
    ir_emit_string_cleanup("")
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")
    return 0

fn ir_prepare_func_emission(ret_type: String):
    # each function starts from a clean local register/type state but keeps
    # the seeded global type tables so lowering stays consistent.
    ir_builder_reset_registers()
    ir_var_regs = {}
    ir_var_types = {}
    ir_closure_return_kinds.clear()
    ir_map_value_types = {}
    ir_string_locals = []
    ir_rc_local_kinds = []
    ir_seed_global_types()
    ir_current_func_return_kind = ret_type
    ir_current_func_optional_inner_kind = ""

# A value-returning function whose body ends in a bare match has no explicit
# return, so the match is the implicit return value. (Such functions return 0
# today, so handling this can only fix behavior.) Returns the tail match node
# index, or -1.
# Find a tail-position match: unwrap block/body wrappers to the last statement,
# and report it if it is a match in a value-returning function. Such a function
# returns 0 today (no implicit-return support), so honoring the tail match can
# only fix behavior.
fn ir_finish_func_emission(body_idx: Int):
    if body_idx >= 0:
        # mark the tail match (if any) so it returns its value instead of
        # discarding it; ir_block emits the body, prefix statements included.
        ir_tail_match_node = ir_function_tail_match(body_idx)
        ir_block(body_idx)
        ir_tail_match_node = 0 - 1
    ir_emit_default_return()

fn ir_collect_test_decls(root_idx: Int) -> List[Int]:
    mut tests: List[Int] := []
    for item_idx in ir_root_items(root_idx):
        if get_node(item_idx).kind == "test_decl":
            tests.push(item_idx)
    return tests

fn ir_emit_test_func(idx: Int, ordinal: Int):
    body_idx := ir_find_body(idx)
    ir_prepare_func_emission("int")
    ir_emit_func_header("__test_" + ordinal.to_string(), 0, "int")
    ir_emitting_test_func = true
    ir_finish_func_emission(body_idx)
    ir_emitting_test_func = false

# the generated test main is a pure dispatcher: for each test it forks, runs the
# test in the child, and records the outcome in the parent. isolating each test
# in its own process means a failing assert (which exits) or a crash ends only
# that test — the rest still run and every result is reported. the parent never
# runs a test body, so no test's state leaks into the next child.
fn ir_emit_test_main(root_idx: Int):
    tests := ir_collect_test_decls(root_idx)
    if tests.len() == 0:
        return
    ir_prepare_func_emission("int")
    ir_emit_func_header("main", 0, "int")

    for test_idx, i in tests:
        name_r := ir_reg()
        ir_emit("strref " + name_r.to_string() + " " + ir_str(get_node(test_idx).value))

        # skip tests filtered out by PITH_TEST_FILTER before doing any work
        run_r := ir_reg()
        ir_emit_call1(run_r, "pith_test_should_run", "int", name_r)
        run_l := ir_label()
        skip_l := ir_label()
        ir_emit("brif " + run_r.to_string() + " " + run_l + " " + skip_l)

        ir_emit_label(run_l)
        pid_r := ir_reg()
        ir_emit_call0(pid_r, "pith_test_fork", "int")
        parent_l := ir_label()
        child_l := ir_label()
        ir_emit("brif " + pid_r.to_string() + " " + parent_l + " " + child_l)

        # child: remember the test name (so skip_test can name it), run the one
        # test, then exit cleanly (a failed assert or skip exits first)
        ir_emit_label(child_l)
        ir_emit_call1(ir_reg(), "pith_test_enter", "int", name_r)
        ir_emit_call0(ir_reg(), "__test_" + i.to_string(), "int")
        ir_emit_call0(ir_reg(), "pith_test_child_ok", "int")
        term_r := ir_reg()
        ir_emit("iconst " + term_r.to_string() + " 0")
        ir_emit("ret " + term_r.to_string())

        # parent: wait for the child and record pass/fail, then rejoin
        ir_emit_label(parent_l)
        ir_emit_call2(ir_reg(), "pith_test_record", "int", name_r, pid_r)
        ir_emit("jmp " + skip_l)
        ir_emit_label(skip_l)

    # exit with the failure count so `pith test` fails the process on any failure,
    # regardless of how the entry wrapper treats main's return value.
    summary_r := ir_reg()
    ir_emit_call0(summary_r, "pith_test_summary", "int")
    ir_emit_call1(ir_reg(), "exit", "unknown", summary_r)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("ret " + zero_r.to_string())
    ir_emit("endfunc")

# --- emit function ---
fn ir_func(idx: Int):
    node := get_node(idx)
    full_name := node.value
    name := ir_base_decl_name(full_name)
    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx)
    ret_type := ir_lookup_func_return(full_name, name)
    ir_prepare_func_emission(ret_type)
    ir_current_arc_func = name
    ir_current_func_optional_inner_kind = ir_extract_optional_inner_type(idx)
    ir_current_func_returns_result = ir_fn_returns_result(idx)
    ir_emit_func_header(name, param_count, ret_type)
    ir_emit_fn_params(idx)
    ir_emit_string_prologue(body_idx)
    ir_finish_func_emission(body_idx)

# --- emit impl method ---
fn ir_impl_func(idx: Int, impl_type: String):
    node := get_node(idx)
    orig_name := node.value
    full_name := impl_type + "_" + orig_name
    method_key := ir_impl_method_key(impl_type, orig_name)
    ir_impl_methods.insert(method_key, full_name)

    body_idx := ir_find_body(idx)
    param_count := ir_param_count(idx) + 1
    # resolve an associated-type return (`-> Item`) to the impl's bound type so
    # the function's return kind is right — critical for heap types and arc
    ret_type := ir_resolve_assoc_type(impl_type, ir_extract_return_type(idx))
    ir_prepare_func_emission(ret_type)
    # an `-> Item?` return: resolve the inner kind too so the optional's
    # payload is reclaimed correctly for heap-typed bindings
    ir_current_func_optional_inner_kind = ir_resolve_assoc_type(impl_type, ir_extract_optional_inner_type(idx))
    ir_current_impl_type = impl_type
    ir_current_arc_func = full_name
    ir_emit_func_header(full_name, param_count, ret_type)
    ir_emit_named_param("self", impl_type)
    ir_emit_fn_params(idx)
    ir_emit_string_prologue(body_idx)
    ir_func_returns.insert(method_key, ret_type)
    ir_func_returns.insert(full_name, ret_type)
    ir_finish_func_emission(body_idx)
    ir_current_impl_type = ""

fn ir_type_alias_target(node: Node) -> String:
    for tc in node.children:
        tn := get_node(tc)
        if tn.kind == "type":
            return tn.value
    return ""

fn ir_collect_import_item(node: Node):
    if node.kind == "import":
        ir_register_import_alias(node.value)
    elif node.kind == "from_import":
        ir_collect_from_import_renames(node.value)

fn ir_register_alias_structs(root_idx: Int):
    for item_idx in ir_root_items(root_idx):
        cn := get_node(item_idx)
        if cn.kind == "type_alias":
            aname := cn.value
            if ir_type_aliases.contains_key(aname):
                target := ir_type_aliases[aname]
                if ir_struct_names.contains_key(target):
                    ir_struct_names.insert(aname, ir_struct_names[target])
                    ir_emit("struct_alias " + aname + " " + target)

fn ir_record_function_return(node: Node):
    mut has_returns := false
    for returns_idx in node.children:
        returns_node := get_node(returns_idx)
        if returns_node.kind == "returns":
            ir_record_returns_clause(node.value, returns_node)
            has_returns = true
    # a function with no returns clause returns void; still record it so it is
    # recognized as a declared callable (e.g. usable as a fn-value).
    if not has_returns:
        ir_func_returns.insert(node.value, "void")

fn ir_record_function_return_as(name: String, node: Node):
    mut has_returns := false
    for returns_idx in node.children:
        returns_node := get_node(returns_idx)
        if returns_node.kind == "returns":
            ir_record_returns_clause(name, returns_node)
            has_returns = true
    if not has_returns:
        ir_func_returns.insert(name, "void")

fn ir_record_returns_clause(name: String, returns_node: Node):
    for type_idx in returns_node.children:
        type_node := get_node(type_idx)
        if type_node.kind == "type" or type_node.kind == "generic_type" or type_node.kind == "result_type" or type_node.kind == "optional_type":
            ir_func_returns.insert(name, ir_resolve_type_node(type_idx))
        if type_node.kind == "result" or type_node.kind == "result_type":
            if type_node.children.len() > 0:
                ir_func_result_ok_kinds.insert(name, ir_retkind(ir_resolve_type_node(type_node.children[0])))

fn ir_emit_global_binding(node: Node):
    gname := ir_binding_name(node)
    mut init_val := "0"
    mut global_type := ""
    mut global_map_value_type := ""
    for gc in node.children:
        gcn := get_node(gc)
        if gcn.kind == "type" or gcn.kind == "generic_type" or gcn.kind == "optional_type":
            global_type = ir_resolve_type_node(gc)
            if global_map_value_type.len() == 0:
                global_map_value_type = ir_resolve_map_value_type_node(gc)
        elif gcn.kind == "int_lit":
            init_val = gcn.value
            if global_type.len() == 0:
                global_type = "int"
        elif gcn.kind == "string_lit":
            si := ir_str(gcn.value)
            init_val = "str:" + si
            if global_type.len() == 0:
                global_type = "string"
        elif gcn.kind == "list":
            init_val = "list"
            if global_type.len() == 0:
                global_type = "list"
        elif gcn.kind == "map":
            init_val = "map"
            if global_type.len() == 0:
                global_type = "map"
        elif gcn.kind == "set":
            init_val = ir_checked_type(gc)
            if init_val.len() == 0:
                init_val = ir_infer_type(gc)
            if init_val.len() == 0:
                init_val = "set"
            if global_type.len() == 0:
                global_type = init_val
        elif gcn.kind == "bool_lit":
            if gcn.value == "true":
                init_val = "1"
            else:
                init_val = "0"
            if global_type.len() == 0:
                global_type = "bool"
    if global_type.len() > 0:
        ir_record_global_type(gname, global_type)
    if global_map_value_type.len() > 0:
        ir_global_map_value_types.insert(gname, global_map_value_type)
    ir_emit("global " + gname + " " + init_val)

fn ir_emit_global_bindings(root: Node):
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if ir_is_binding_kind(cn.kind):
            ir_emit_global_binding(cn)

# attach the type's destructor to a freshly built struct so its rc
# fields release when the struct dies
fn ir_emit_attach_dtor(struct_r: Int, raw_name: String):
    if not ir_struct_needs_dtor(raw_name):
        return
    sname := ir_struct_base_name(raw_name)
    fr := ir_reg()
    ir_emit("funcref " + fr.to_string() + " __dtor_" + sname)
    ir_emit_call_text(ir_reg(), "pith_struct_set_dtor", "void", 2, " " + struct_r.to_string() + " " + fr.to_string())

# one destructor per known struct with rc fields: releases each such
# field, then the runtime frees the allocation. every module emits its
# own copy (module prefixing keeps the names distinct), so construction
# sites never need cross-module destructor references.
# one destructor per rc payload kind for owned optionals. an optional that owns
# a struct/list/map/set/bytes/closure payload attaches the matching dtor, which
# releases the payload (slot 1) when the optional tuple dies. release on a null
# payload is a no-op, so no is_some guard is needed — none tuples never carry a
# dtor anyway.
fn ir_emit_optional_dtors():
    kinds := ["struct", "list", "map", "set", "bytes", "closure"]
    for k in kinds:
        ir_emit_func_header("__opt_dtor_" + k, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        vr := ir_reg()
        ir_emit("field " + vr.to_string() + " " + pr.to_string() + " 8 unknown value")
        ir_rc_release_reg(vr, k)
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_emit_struct_dtors():
    for sname in ir_struct_names.keys():
        if sname.index_of("[") >= 0:
            continue
        # boxed enums live in ir_struct_names too but their releasable slots
        # are tagged payloads, not fields — ir_emit_enum_dtors handles them.
        if ir_boxed_enums.contains_key(sname):
            continue
        if not ir_struct_needs_dtor(sname):
            continue
        ir_emit_func_header("__dtor_" + sname, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        count := ir_struct_field_count(sname)
        mut i := 0
        while i < count:
            fname := ir_struct_field_name_at(sname, i)
            ftype := ir_struct_field_type_name(sname, fname)
            fkind := ir_rc_field_kind(ftype)
            if fkind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown " + fname)
                ir_rc_release_reg(fr, fkind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# one tag-aware destructor per boxed enum with rc payloads: read the tag,
# and for the matching variant release each releasable payload slot. the box
# layout is [tag, payload0, payload1, ...] at offsets 0, 8, 16, mirroring the
# variant allocator and the equality helper.
fn ir_emit_enum_dtors():
    for ename in ir_boxed_enums.keys():
        if not ir_enum_needs_dtor(ename):
            continue
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_func_header("__dtor_" + ename, 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        tag_r := ir_reg()
        ir_emit("field " + tag_r.to_string() + " " + pr.to_string() + " 0 int __enum_tag")
        variants := ir_enum_variant_lists[ename].split(",")
        mut vi := 0
        while vi < variants.len():
            vkey := ename + "." + variants[vi]
            if ir_enum_payload_kinds.contains_key(vkey):
                kinds := ir_enum_payload_kinds[vkey].split(",")
                mut has_rc := false
                mut c := 0
                while c < kinds.len():
                    if ir_rc_field_kind(kinds[c]).len() > 0:
                        has_rc = true
                    c = c + 1
                if has_rc:
                    vtag := ir_reg()
                    ir_emit("iconst " + vtag.to_string() + " " + vi.to_string())
                    is_v := ir_reg()
                    ir_emit("eq " + is_v.to_string() + " " + tag_r.to_string() + " " + vtag.to_string())
                    hit_l := ir_label()
                    skip_l := ir_label()
                    ir_emit("brif " + is_v.to_string() + " " + hit_l + " " + skip_l)
                    ir_emit_label(hit_l)
                    mut s := 0
                    while s < kinds.len():
                        rk := ir_rc_field_kind(kinds[s])
                        if rk.len() > 0:
                            slot_r := ir_reg()
                            ir_emit("field " + slot_r.to_string() + " " + pr.to_string() + " " + ((s + 1) * 8).to_string() + " unknown __p" + s.to_string())
                            ir_rc_release_reg(slot_r, rk)
                        s = s + 1
                    ir_emit_label(skip_l)
            vi = vi + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

# one equality helper per boxed enum: same pointer or same tag with
# equal payloads. string payloads compare by content and nested boxed
# enums recurse; struct payloads keep pointer identity.
# one destructor per rc-bearing tuple signature seen in this module.
# emitted after the bodies, since tuple shapes are only discovered at
# their literal sites. mirrors ir_emit_struct_dtors, keyed by the
# structural signature instead of a declared name.
fn ir_emit_tuple_dtors():
    for sig in ir_tuple_dtor_sigs:
        ir_emit_func_header(ir_tuple_dtor_name(sig), 1, "void")
        ir_emit("param p")
        pr := ir_reg()
        ir_emit("load " + pr.to_string() + " p")
        mut i := 0
        while i < sig.len():
            kind := ir_tuple_dtor_code_kind(sig.substring(i, i + 1))
            if kind.len() > 0:
                fr := ir_reg()
                ir_emit("field " + fr.to_string() + " " + pr.to_string() + " " + (i * 8).to_string() + " unknown __tuple_" + i.to_string())
                ir_rc_release_reg(fr, kind)
            i = i + 1
        zr := ir_reg()
        ir_emit("iconst " + zr.to_string() + " 0")
        ir_emit("ret " + zr.to_string())
        ir_emit("endfunc")

fn ir_emit_enum_eq_fns():
    for ename in ir_boxed_enums.keys():
        if not ir_enum_variant_lists.contains_key(ename):
            continue
        ir_emit_func_header("__enum_eq_" + ename, 2, "bool")
        ir_emit("param a")
        ir_emit("param b")
        ra := ir_reg()
        ir_emit("load " + ra.to_string() + " a")
        rb := ir_reg()
        ir_emit("load " + rb.to_string() + " b")
        true_l := ir_label()
        false_l := ir_label()
        check_l := ir_label()
        same_r := ir_reg()
        ir_emit("eq " + same_r.to_string() + " " + ra.to_string() + " " + rb.to_string())
        ir_emit("brif " + same_r.to_string() + " " + true_l + " " + check_l)
        ir_emit_label(check_l)
        ta := ir_reg()
        ir_emit("field " + ta.to_string() + " " + ra.to_string() + " 0 int __enum_tag")
        tb := ir_reg()
        ir_emit("field " + tb.to_string() + " " + rb.to_string() + " 0 int __enum_tag")
        tags_r := ir_reg()
        ir_emit("eq " + tags_r.to_string() + " " + ta.to_string() + " " + tb.to_string())
        # only payload variants need slot comparison; for the rest an
        # equal tag is the whole story
        variants := ir_enum_variant_lists[ename].split(",")
        mut vi := 0
        mut chain_l := ir_label()
        ir_emit("brif " + tags_r.to_string() + " " + chain_l + " " + false_l)
        while vi < variants.len():
            vkey := ename + "." + variants[vi]
            if ir_enum_payload_kinds.contains_key(vkey):
                ir_emit_label(chain_l)
                chain_l = ir_label()
                vtag := ir_reg()
                ir_emit("iconst " + vtag.to_string() + " " + vi.to_string())
                is_v := ir_reg()
                ir_emit("eq " + is_v.to_string() + " " + ta.to_string() + " " + vtag.to_string())
                slots_l := ir_label()
                ir_emit("brif " + is_v.to_string() + " " + slots_l + " " + chain_l)
                ir_emit_label(slots_l)
                kinds := ir_enum_payload_kinds[vkey].split(",")
                mut k := 0
                while k < kinds.len():
                    fa := ir_reg()
                    ir_emit("field " + fa.to_string() + " " + ra.to_string() + " " + ((k + 1) * 8).to_string() + " unknown __p" + k.to_string())
                    fb := ir_reg()
                    ir_emit("field " + fb.to_string() + " " + rb.to_string() + " " + ((k + 1) * 8).to_string() + " unknown __p" + k.to_string())
                    cmp_r := ir_reg()
                    if kinds[k] == "string":
                        ir_emit_call2(cmp_r, "__str_eq", "bool", fa, fb)
                    elif ir_boxed_enums.contains_key(kinds[k]):
                        ir_emit_call2(cmp_r, "__enum_eq_" + kinds[k], "bool", fa, fb)
                    else:
                        ir_emit("eq " + cmp_r.to_string() + " " + fa.to_string() + " " + fb.to_string())
                    next_slot_l := ir_label()
                    ir_emit("brif " + cmp_r.to_string() + " " + next_slot_l + " " + false_l)
                    ir_emit_label(next_slot_l)
                    k = k + 1
                ir_emit("jmp " + true_l)
            vi = vi + 1
        ir_emit_label(chain_l)
        ir_emit("jmp " + true_l)
        ir_emit_label(false_l)
        f_r := ir_reg()
        ir_emit("iconst " + f_r.to_string() + " 0")
        ir_emit("ret " + f_r.to_string())
        ir_emit_label(true_l)
        t_r := ir_reg()
        ir_emit("iconst " + t_r.to_string() + " 1")
        ir_emit("ret " + t_r.to_string())
        ir_emit("endfunc")

# a global whose initializer is a bare literal gets its value through
# the declaration; anything else — calls, operators, interpolation,
# collection literals with elements — must run at startup. previously
# only empty collection constructors ran, and every other initializer
# silently left its global zeroed.
fn ir_global_needs_runtime_init(cn: Node) -> Bool:
    parts := ir_collect_bind_parts(cn)
    if parts.val_idx < 0:
        return false
    vk := get_node(parts.val_idx).kind
    if vk == "int_lit" or vk == "float_lit" or vk == "bool_lit" or vk == "true" or vk == "false":
        return false
    if vk == "string_lit" or vk == "string" or vk == "str_lit":
        return false
    if vk == "unary" or vk == "neg":
        return false
    return true

fn ir_emit_init_globals(root: Node):
    mut has_runtime_inits := false
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if ir_is_binding_kind(cn.kind) and ir_global_needs_runtime_init(cn):
            has_runtime_inits = true
    if not has_runtime_inits:
        return

    ir_emit_func_header("__init_globals", 0, "int")
    for child in root.children:
        cn := ir_unwrap_pub_node(child)
        if ir_is_binding_kind(cn.kind) and ir_global_needs_runtime_init(cn):
            gname := ir_binding_name(cn)
            parts := ir_collect_bind_parts(cn)
            mut target := ""
            if parts.type_idx >= 0:
                target = ir_resolve_type_node(parts.type_idx)
            if target.len() == 0:
                target = ir_infer_type(parts.val_idx)
            gtarget := ir_map_init_target(gname, target)
            r := ir_emit_value_for_target(parts.val_idx, gtarget)
            gkind := ir_rc_kind(target)
            if gkind.len() > 0 and gtarget != "tuple" and ir_string_expr_is_borrowed(parts.val_idx):
                ir_rc_retain_reg(r, gkind)
            ir_emit("store " + gname + " " + r.to_string())
    dr := ir_reg()
    ir_emit("iconst " + dr.to_string() + " 0")
    ir_emit("ret " + dr.to_string())
    ir_emit("endfunc")

fn ir_emit_top_level_items(root_idx: Int, root: Node):
    mut test_ord := 0
    for item_idx in ir_root_items(root_idx):
        actual_node := get_node(item_idx)
        if actual_node.kind == "fn" or actual_node.kind == "fn_decl":
            if ir_has_generic_params(actual_node):
                continue
            if not (ir_emit_tests and actual_node.value == "main"):
                ir_func(item_idx)
        elif actual_node.kind == "test_decl":
            if ir_emit_tests:
                ir_emit_test_func(item_idx, test_ord)
                test_ord = test_ord + 1
        elif actual_node.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual_node)
            ir_emit_impl_methods(actual_node, impl_type)
    if ir_emit_tests:
        ir_emit_test_main(root_idx)

fn ir_append_lambda_bodies():
    bodies: List[String] := ir_lambda_bodies
    ir_builder_append_lines(bodies)

fn ir_preseed_result_error_strings():
    builtin_names := "parse_int,file_open_read,file_open_write,file_open_append,byte_buffer_write,byte_buffer_write_string_utf8,byte_buffer_write_byte,file_write,file_write_bytes,tcp_connect,tcp_listen,tcp_accept,tcp_write,tcp_write_bytes,process_spawn,process_spawn_argv,process_output_argv,process_write,process_write_bytes,crypto_x25519_keygen,write_file,append_file,write_file_bytes,append_file_bytes,read_file,exec_output,dns_resolve,bytes_to_string_utf8,bytes_substring_utf8,file_read,tcp_read,process_read,process_read_err,read_file_bytes,b64_decode,from_hex,file_read_bytes,tcp_read_bytes,process_read_bytes,process_read_err_bytes,crypto_x25519_public_key,crypto_x25519_shared_secret,crypto_aes_128_gcm_seal,crypto_aes_128_gcm_open,crypto_chacha20_poly1305_seal,crypto_chacha20_poly1305_open,crypto_sign_rsa_pss_sha256_pkcs8".split(",")
    for builtin_name in builtin_names:
        ir_str(builtin_name + " failed")

fn ir_collect_root_import_metadata(root_idx: Int):
    ir_import_renames = {}
    ir_import_declared_functions = {}
    ir_import_declared_globals = {}
    for root, i in ir_preloaded_import_roots:
        ir_collect_preloaded_root_metadata(root, ir_preloaded_import_paths[i])

fn ir_collect_root_phase_one_metadata(root_idx: Int):
    ir_func_returns.clear()
    ir_type_aliases = {}
    ir_generic_decl_indices = {}
    ir_generic_decl_module_paths = {}

    for root, preload_i in ir_preloaded_import_roots:
        mut module_path := ""
        if preload_i < ir_preloaded_import_paths.len():
            module_path = ir_preloaded_import_paths[preload_i]
        for item_idx in ir_root_items(root):
            node := get_node(item_idx)
            if ir_is_fn_decl_kind(node.kind):
                ir_record_function_return_as(ir_import_target_name(module_path, node.value), node)
        ir_collect_generic_function_decls_from_root(root, module_path)

    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        ir_collect_import_item(node)
        if node.kind == "type_alias":
            target := ir_type_alias_target(node)
            if target.len() > 0:
                ir_type_aliases.insert(node.value, target)
        elif ir_is_fn_decl_kind(node.kind):
            ir_record_function_return(node)
            if ir_has_generic_params(node):
                ir_record_generic_function_decl(item_idx, node, "")

fn ir_collect_root_phase_two_metadata(root_idx: Int):
    ir_local_struct_names = []
    ir_dtor_memo = {}
    ir_struct_names.clear()
    ir_struct_field_lookup.clear()
    ir_struct_field_index_lookup.clear()
    ir_struct_decl_nodes.clear()
    ir_impl_methods.clear()
    ir_interface_decl_index.clear()
    ir_assoc_bindings.clear()
    ir_type_assoc_names.clear()
    ir_register_known_import_structs()

    # index every interface (imports + root) before any impl signatures are
    # collected, so an impl can find its interface's defaults regardless of
    # declaration order across modules
    mut iface_i := 0
    while iface_i < ir_preloaded_import_roots.len():
        ir_index_interfaces_in_root(ir_preloaded_import_roots[iface_i])
        ir_collect_assoc_bindings_in_root(ir_preloaded_import_roots[iface_i])
        iface_i = iface_i + 1
    ir_index_interfaces_in_root(root_idx)
    ir_collect_assoc_bindings_in_root(root_idx)

    mut preload_i := 0
    while preload_i < ir_preloaded_import_roots.len():
        ir_collect_struct_decls(ir_preloaded_import_roots[preload_i], false)
        ir_collect_impl_methods(ir_preloaded_import_roots[preload_i], ir_preloaded_import_paths[preload_i])
        preload_i = preload_i + 1

    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if node.kind == "struct_decl" or node.kind == "struct":
            ir_collect_struct_decl(item_idx, node, true)
        elif node.kind == "enum_decl" or node.kind == "enum":
            ir_collect_enum_decl(node, true)
        elif node.kind == "impl_decl":
            ir_collect_impl_method_signatures(node, "")

    ir_register_alias_structs(root_idx)

fn ir_emit_root_module(root_idx: Int, root: Node):
    ir_generic_dtor_base = {}
    ir_generic_dtor_args = {}
    ir_emit_global_bindings(root)
    ir_emit_init_globals(root)
    ir_emit_optional_dtors()
    ir_emit_struct_dtors()
    ir_emit_enum_dtors()
    ir_emit_enum_eq_fns()
    # pre-register all impl method specializations across the module so that
    # an earlier impl's specialized body can dispatch to a later impl's
    # specialized version (e.g. MapIter[FilterIter[..], ..].next calling
    # FilterIter[Range, Int].next)
    ir_preregister_all_impl_specializations(root_idx, root)
    ir_emit_top_level_items(root_idx, root)
    # tuple destructors last: their shapes are only known once every
    # tuple literal in the module body has been emitted.
    ir_emit_tuple_dtors()
    ir_emit_generic_specializations()
    # per-instance destructors for generic structs built via a backend
    # constructor call: emitted after the specializations, since those bodies
    # are where such constructions (and their attaches) are recorded.
    ir_emit_generic_instance_dtors()
    ir_append_lambda_bodies()

# Walk every impl_decl in the current root and register specialization name
# entries into ir_impl_method_specializations without emitting bodies yet.
# Then ir_emit_impl_methods's per-impl loop can emit bodies safely; any
# cross-impl dispatch lookup will already find the right specialized symbol.
fn ir_preregister_all_impl_specializations(root_idx: Int, root: Node):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        mut actual_node := node
        if node.kind == "pub":
            actual_node = get_node(node.children[0])
        if actual_node.kind == "impl_decl":
            impl_type := ir_impl_target_type(actual_node)
            if impl_type.len() > 0:
                ir_register_impl_method_specialization_names(actual_node, impl_type)

fn ir_register_impl_method_specialization_names(impl_node: Node, impl_type: String):
    if not has_generic_declaration(impl_type):
        return
    sdecl := get_node(get_generic_declaration_index(impl_type))
    struct_params := collect_generic_parameter_names(sdecl)
    if struct_params.len() == 0:
        return
    instance_tids := struct_instance_tids
    for inst_tid in instance_tids:
        if struct_instance_base_name[inst_tid] != impl_type:
            continue
        if not struct_instance_type_args.contains_key(inst_tid):
            continue
        arg_tids := decode_tid_list(struct_instance_type_args[inst_tid])
        mut arg_names: List[String] := []
        for at in arg_tids:
            arg_names.push(ir_type_from_tid(at))
        instance_type_name := get_type_name(inst_tid)
        for child in impl_node.children:
            child_node := get_node(child)
            if child_node.kind == "fn_decl":
                ir_register_one_specialized_method_name(child_node, impl_type, instance_type_name, arg_names)

fn ir_finish_module_emit():
    ir_module_count = ir_module_count + 1
    ir_preloaded_import_roots = []
    ir_preloaded_import_paths = []
    ir_emit_tests = false
    ir_emitting_test_func = false

# --- main entry ---
#
# per module: intern every string first (the table heads the output),
# collect import metadata so names resolve, then emit globals and
# functions in declaration order.
pub fn emit_ir(root_idx: Int) -> String:
    ir_reset()

    root := get_node(root_idx)
    mut preload_i := 0
    while preload_i < ir_preloaded_import_roots.len():
        ir_collect_strings(ir_preloaded_import_roots[preload_i])
        ir_collect_struct_field_strings(ir_preloaded_import_roots[preload_i])
        preload_i = preload_i + 1
    ir_collect_strings(root_idx)
    ir_collect_struct_field_strings(root_idx)
    ir_preseed_result_error_strings()
    # test names live on the test_decl node, not in a string literal the collector
    # would see, so intern them here — before the table is emitted — for the test
    # main's per-test report line.
    if ir_emit_tests:
        for test_idx in ir_collect_test_decls(root_idx):
            _name_id := ir_str(get_node(test_idx).value)
    ir_emit_string_table()

    # collect aliases first so both type and callable metadata can resolve
    # through the same table.
    ir_collect_root_import_metadata(root_idx)
    ir_collect_root_phase_one_metadata(root_idx)
    ir_collect_root_phase_two_metadata(root_idx)

    ir_lambda_count = 0
    ir_lambda_bodies = []
    ir_emit_root_module(root_idx, root)
    lines := ir_builder_lines()
    ir_finish_module_emit()
    return lines.join(chr(10))
