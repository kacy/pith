# std/compress/zstd_pure_fse — finite state entropy (fse) for pure-pith zstd.
#
# fse is zstd's table-based arithmetic-adjacent coder. a decode table maps
# (state, low bits) to a symbol plus the next state; the reference table-build
# spreads each symbol across 2^log slots by a fixed stride so the layout is
# reproducible from the normalized counts alone. this module builds the decode
# table, reads a symbol stream, and — for the encoder — builds the matching
# encode table and the normalized-count header.

import std.bits as bits
import std.compress.zstd_pure_bits as stream
import std.bytes as bytes

# the reference spread stride: (size >> 1) + (size >> 3) + 3, stepped modulo
# the table size, visits every slot exactly once for any power-of-two size.
fn spread_step(size: Int) -> Int:
    return bits.shr(size, 1) + bits.shr(size, 3) + 3

## one decode-table entry: the symbol emitted, how many bits to read next,
## and the base state those bits add to.
pub struct FseEntry:
    pub symbol: Int
    pub nbits: Int
    pub base: Int

## a built fse decode table: its log2 size and its entries.
pub struct FseTable:
    pub log: Int
    pub entries: List[FseEntry]

## build a decode table from normalized counts (one per symbol; -1 means the
## "less than one" probability that occupies the top slots). this is the
## reference algorithm: place symbols by the spread walk, then for each slot
## derive its baseline and bit count from how many times its symbol appears.
pub fn build_decode_table(counts: List[Int], log: Int) -> FseTable:
    size := bits.shl(1, log)
    mask := size - 1
    mut symbol_of: List[Int] := []
    mut i := 0
    while i < size:
        symbol_of.push(0)
        i = i + 1

    # low-probability (-1) symbols take the highest slots, one each.
    mut high := size - 1
    mut s := 0
    while s < counts.len():
        if counts[s] == -1:
            symbol_of[high] = s
            high = high - 1
        s = s + 1

    # everything else is spread by the stride walk, skipping the reserved
    # high slots.
    step := spread_step(size)
    mut pos := 0
    s = 0
    while s < counts.len():
        mut n := counts[s]
        while n > 0:
            symbol_of[pos] = s
            pos = (pos + step) % size
            while pos > high:
                pos = (pos + step) % size
            n = n - 1
        s = s + 1

    # per symbol, count occurrences so each slot's next-state math is set.
    mut seen: List[Int] := []
    s = 0
    while s < counts.len():
        seen.push(0)
        s = s + 1

    mut entries: List[FseEntry] := []
    i = 0
    while i < size:
        entries.push(FseEntry(0, 0, 0))
        i = i + 1

    i = 0
    while i < size:
        sym := symbol_of[i]
        occ := seen[sym] + 1
        seen[sym] = occ
        # the next state uses `log - floor(log2(occ))` bits; base is where
        # this slot's states begin in the table.
        nb := log - bit_length(occ - 1)
        # guard: an unused symbol (count 0) never lands in a slot, so occ>=1.
        base := bits.shl(occ, nb) - size
        entries[i] = FseEntry(sym, nb, base)
        i = i + 1

    return FseTable(log, entries)

# floor(log2(v)) + 1 for v>=1, i.e. the number of significant bits; 0 for v=0.
fn bit_length(v: Int) -> Int:
    mut n := 0
    mut x := v
    while x > 0:
        n = n + 1
        x = bits.shr(x, 1)
    return n

## an fse decoder positioned in a backward stream. init reads `log` bits for
## the starting state; each step emits the current state's symbol, then reads
## that entry's bits to move to the next state.
pub struct FseDecoder:
    table: FseTable
    state: Int

## start a decoder by reading the initial state from the backward stream.
pub fn fse_decoder(table: FseTable, reader: stream.BackReader) -> FseDecoder:
    return FseDecoder(table, reader.read(table.log))

impl FseDecoder:
    ## the symbol at the current state (does not advance).
    fn symbol() -> Int:
        return self.table.entries[self.state].symbol

    ## consume the current entry's bits and move to the next state.
    fn advance(reader: stream.BackReader):
        entry := self.table.entries[self.state]
        self.state = entry.base + reader.read(entry.nbits)

# ---------------------------------------------------------------
# encoder side
# ---------------------------------------------------------------

## build an encode table: for each symbol, the list of states (table slots)
## that emit it, in the order the decoder assigns them. the encoder walks a
## symbol backward and, at each step, picks the state that will decode to it
## and records the low bits of the previous state.
pub fn build_encode_states(counts: List[Int], log: Int) -> List[List[Int]]:
    table := build_decode_table(counts, log)
    mut by_symbol: List[List[Int]] := []
    mut s := 0
    while s < counts.len():
        empty: List[Int] := []
        by_symbol.push(empty)
        s = s + 1
    mut i := 0
    while i < table.entries.len():
        by_symbol[table.entries[i].symbol].push(i)
        i = i + 1
    return by_symbol

# encode `symbols` into a backward bitstream using the table these counts
# build. walks the sequence backward: fixes the final state (a slot for the
# last symbol), and for each earlier symbol finds the slot whose base-range
# reaches the next state, recording the low bits that bridge them. the init
# state is written first so the decoder reads it first.
pub fn fse_encode(symbols: List[Int], counts: List[Int], log: Int) -> List[Int]:
    table := build_decode_table(counts, log)
    slots := build_encode_states(counts, log)

    n := symbols.len()
    # the last symbol's state can be any of its slots; the lowest keeps the
    # numbers small and is what the reference picks.
    mut next_state := slots[symbols[n - 1]][0]

    mut bit_values: List[Int] := []
    mut bit_widths: List[Int] := []
    mut k := n - 1
    while k >= 1:
        prev_sym := symbols[k - 1]
        mut chosen := -1
        for j in slots[prev_sym]:
            base := table.entries[j].base
            span := bits.shl(1, table.entries[j].nbits)
            if next_state >= base and next_state < base + span:
                chosen = j
        bit_values.push(next_state - table.entries[chosen].base)
        bit_widths.push(table.entries[chosen].nbits)
        next_state = chosen
        k = k - 1

    # write init first, then the transition bits in decode order (reverse of
    # how they were collected).
    w := stream.back_writer()
    w.write(next_state, log)
    mut b := bit_values.len() - 1
    while b >= 0:
        w.write(bit_values[b], bit_widths[b])
        b = b - 1
    return w.finish()

# decode `count` symbols from a backward stream built by fse_encode.
pub fn fse_decode_all(data: Bytes, counts: List[Int], log: Int, count: Int) -> List[Int]:
    table := build_decode_table(counts, log)
    reader := stream.back_reader(data, 0, data.len())
    dec := fse_decoder(table, reader)
    mut out: List[Int] := []
    mut i := 0
    while i < count:
        out.push(dec.symbol())
        if i + 1 < count:
            dec.advance(reader)
        i = i + 1
    return out

# ---------------------------------------------------------------
# tests — round trip through a table built from real counts
# ---------------------------------------------------------------

test "fse round trips a symbol sequence through a real backward stream":
    counts := [10, 12, 10]
    symbols := [0, 1, 2, 1, 1, 0, 2, 2, 1, 0, 1, 2]
    packed := fse_encode(symbols, counts, 5)
    mut buf := bytes.buffer()
    for byte in packed:
        buf.write_byte(byte)
    data := buf.take_bytes()
    decoded := fse_decode_all(data, counts, 5, symbols.len())
    assert_eq(decoded.len(), symbols.len())
    mut i := 0
    while i < symbols.len():
        assert_eq(decoded[i], symbols[i])
        i = i + 1

test "fse round trips a skewed distribution":
    # symbol 3 dominates; the rare symbols get few slots and wide bit reads.
    counts := [2, 1, 1, 28]
    symbols := [3, 3, 3, 0, 3, 3, 1, 3, 3, 3, 3, 2, 3, 3, 0, 3]
    packed := fse_encode(symbols, counts, 5)
    mut buf := bytes.buffer()
    for byte in packed:
        buf.write_byte(byte)
    data := buf.take_bytes()
    decoded := fse_decode_all(data, counts, 5, symbols.len())
    mut i := 0
    while i < symbols.len():
        assert_eq(decoded[i], symbols[i])
        i = i + 1

test "a decode table places every slot and stays in range":
    # counts summing to the table size (32): the stride is coprime to the
    # size at realistic table logs, which is what the spread relies on.
    counts := [10, 12, 10]
    table := build_decode_table(counts, 5)
    assert_eq(table.entries.len(), 32)
    mut i := 0
    mut seen0 := 0
    while i < 32:
        e := table.entries[i]
        assert(e.symbol >= 0 and e.symbol < 3)
        assert(e.nbits >= 0 and e.nbits <= 5)
        if e.symbol == 0:
            seen0 = seen0 + 1
        i = i + 1
    # symbol 0 has count 10, so it occupies exactly ten slots.
    assert_eq(seen0, 10)

test "the spread walk visits every slot once at realistic sizes":
    for size in [32, 64, 256, 1024]:
        step := spread_step(size)
        mut hits: List[Int] := []
        mut i := 0
        while i < size:
            hits.push(0)
            i = i + 1
        mut pos := 0
        i = 0
        while i < size:
            hits[pos] = hits[pos] + 1
            pos = (pos + step) % size
            i = i + 1
        i = 0
        while i < size:
            assert_eq(hits[i], 1)
            i = i + 1

test "bit_length matches floor-log2 plus one":
    assert_eq(bit_length(0), 0)
    assert_eq(bit_length(1), 1)
    assert_eq(bit_length(2), 2)
    assert_eq(bit_length(3), 2)
    assert_eq(bit_length(7), 3)
    assert_eq(bit_length(8), 4)
