# compound assignment on the types that support it, alongside plain assignment
# into an optional, which is a different question and still allowed.
fn main() -> Int:
    mut n := 5
    n += 3
    n -= 1
    n *= 2
    n /= 7
    print("int {n}")

    mut f := 1.5
    f += 0.5
    f *= 3.0
    print("float {f}")

    # a plain assignment still widens into an optional target
    mut o: Int? := none
    o = 7
    if let v = o:
        print("widened {v}")
    o = none
    if o == none:
        print("cleared")
    return 0
