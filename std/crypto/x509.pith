# std.crypto.x509 — certificate parsing helpers
#
# this is the start of the native tls stack: enough der/x.509 support to
# inspect certificates and apply hostname checks without leaning on rust.

import std.bits as bits
import std.bytes as bytes
import std.encoding as encoding
import std.crypto.signature as signature
import std.time as time

TAG_BOOLEAN := 1
TAG_INTEGER := 2
TAG_BIT_STRING := 3
TAG_OCTET_STRING := 4
TAG_NULL := 5
TAG_OBJECT_ID := 6
TAG_UTF8_STRING := 12
TAG_SEQUENCE := 48
TAG_SET := 49
TAG_PRINTABLE_STRING := 19
TAG_IA5_STRING := 22
TAG_UTC_TIME := 23
TAG_GENERALIZED_TIME := 24
TAG_DNS_NAME := 130
TAG_IP_ADDRESS := 135
TAG_EXTENSIONS := 163
# name-constraints subtrees are implicitly tagged [0] (permitted) and [1]
# (excluded); both are constructed context tags wrapping a sequence of subtrees.
TAG_PERMITTED_SUBTREES := 160
TAG_EXCLUDED_SUBTREES := 161

OID_COMMON_NAME := "2.5.4.3"
OID_SUBJECT_ALT_NAME := "2.5.29.17"
OID_BASIC_CONSTRAINTS := "2.5.29.19"
OID_KEY_USAGE := "2.5.29.15"
OID_EXTENDED_KEY_USAGE := "2.5.29.37"
OID_NAME_CONSTRAINTS := "2.5.29.30"
# extendedKeyUsage purpose ids we recognise for tls server and client certificates.
OID_SERVER_AUTH := "1.3.6.1.5.5.7.3.1"
OID_CLIENT_AUTH := "1.3.6.1.5.5.7.3.2"
OID_ANY_EKU := "2.5.29.37.0"

# one der tag-length-value entry.
pub struct DerValue:
    pub tag: Int
    pub header_start: Int
    pub value_start: Int
    pub value_end: Int
    pub next: Int
    pub constructed: Bool

# parsed x.509 certificate metadata used by tls verification.
pub struct Certificate:
    pub der: Bytes
    pub tbs_der: Bytes
    pub subject_public_key_info: Bytes
    pub subject_public_key: Bytes
    pub signature: Bytes
    pub version: Int
    pub serial_hex: String
    pub signature_algorithm: String
    pub public_key_algorithm: String
    pub issuer_common_name: String
    pub subject_common_name: String
    pub not_before: String
    pub not_after: String
    pub dns_names: List[String]
    pub ip_addresses: List[String]
    pub is_ca: Bool
    # raw der of the issuer and subject distinguished names, used for exact
    # full-dn matching when selecting the issuer of a certificate.
    pub issuer_dn: Bytes
    pub subject_dn: Bytes
    # extendedKeyUsage: has_eku is false when the extension is absent (which
    # rfc 5280 treats as "valid for any purpose"). when present, eku_oids holds
    # every listed purpose object identifier.
    pub has_eku: Bool
    pub eku_oids: List[String]
    # dnsname name-constraints copied from this certificate when it is a ca
    # (the iPAddress pair is below). empty lists mean the certificate
    # constrains no dnsnames.
    pub permitted_dns: List[String]
    pub excluded_dns: List[String]
    # keyUsage: has_key_usage is false when the extension is absent (rfc 5280
    # treats that as "valid for any purpose"). when present, key_cert_sign is
    # the keyCertSign bit, which a certificate must carry to sign others.
    pub has_key_usage: Bool
    pub key_cert_sign: Bool
    # digitalSignature (bit 0): required of a tls peer certificate when the
    # keyUsage extension is present — the handshake is signed with the leaf key.
    pub digital_signature: Bool
    # basicConstraints pathLenConstraint: has_path_len is false when absent.
    # when present, path_len bounds how many intermediate cas may appear below
    # this one on a valid path.
    pub has_path_len: Bool
    pub path_len: Int
    # dnsname and iPAddress name-constraints copied from this certificate when
    # it is a ca. an iPAddress subtree base is the network address followed by
    # the netmask (8 bytes for ipv4, 32 for ipv6); empty lists constrain
    # nothing of that name type (rfc 5280 §4.2.1.10).
    pub permitted_ip: List[Bytes]
    pub excluded_ip: List[Bytes]

# result from native certificate verification preflight.
pub struct VerificationResult:
    pub ok: Bool
    pub hostname_ok: Bool
    pub issuer_ok: Bool
    pub root_ca_ok: Bool
    pub signature_verified: Bool
    pub reason: String

fn read_len(data: Bytes, pos: Int, available_end: Int) -> Int!:
    if pos >= available_end:
        fail "truncated der length"
    first := data[pos]
    if bits.band(first, 128) == 0:
        return first
    count := bits.band(first, 127)
    if count == 0:
        fail "indefinite der length is not supported"
    if count > 4:
        fail "der length is too large"
    if pos + count >= available_end:
        fail "truncated der long length"
    if data[pos + 1] == 0:
        fail "non-canonical der length"
    mut value := 0
    mut i := 0
    while i < count:
        value = bits.shl(value, 8) + data[pos + 1 + i]
        i = i + 1
    if value < 128:
        fail "non-canonical der length"
    return value

fn len_width(data: Bytes, pos: Int) -> Int!:
    first := data[pos]
    if bits.band(first, 128) == 0:
        return 1
    count := bits.band(first, 127)
    if count == 0:
        fail "indefinite der length is not supported"
    return 1 + count

# read one der value bounded by `end`.
fn read_value_in(data: Bytes, pos: Int, end: Int) -> DerValue!:
    if pos < 0 or end > data.len() or pos + 2 > end:
        fail "truncated der value"
    length := read_len(data, pos + 1, end)!
    width := len_width(data, pos + 1)!
    value_start := pos + 1 + width
    value_end := value_start + length
    if value_end > end:
        fail "der value extends past container"
    tag := data[pos]
    return DerValue(tag, pos, value_start, value_end, value_end, bits.band(tag, 32) != 0)

# read one der value at offset.
pub fn read_value(data: Bytes, pos: Int) -> DerValue!:
    return read_value_in(data, pos, data.len())!

fn expect_tag_in(data: Bytes, pos: Int, end: Int, tag: Int) -> DerValue!:
    value := read_value_in(data, pos, end)!
    if value.tag != tag:
        fail "unexpected der tag"
    return value

fn expect_tag(data: Bytes, pos: Int, tag: Int) -> DerValue!:
    return expect_tag_in(data, pos, data.len(), tag)!

fn value_bytes(data: Bytes, value: DerValue) -> Bytes:
    return data.slice(value.value_start, value.value_end)

# largest value that can be shifted left 7 bits without overflowing signed 64-bit Int.
OID_MAX_BEFORE_SHIFT := 72057594037927935

fn read_oid_value(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_OBJECT_ID:
        fail "expected object id"
    body := value_bytes(data, value)
    if body.len() == 0:
        fail "empty object id"
    first := body[0]
    mut parts: List[String] := []
    if first < 40:
        parts.push("0")
        parts.push(first.to_string())
    elif first < 80:
        parts.push("1")
        parts.push((first - 40).to_string())
    else:
        parts.push("2")
        parts.push((first - 80).to_string())
    mut component := 0
    mut in_arc := false
    mut i := 1
    while i < body.len():
        b := body[i]
        # X.690 §8.19.2: the leading octet of a subidentifier must not be 0x80.
        if not in_arc and b == 128:
            fail "non-minimal object id"
        if component > OID_MAX_BEFORE_SHIFT:
            fail "object id component overflows"
        in_arc = true
        component = bits.shl(component, 7) + bits.band(b, 127)
        if bits.band(b, 128) == 0:
            parts.push(component.to_string())
            component = 0
            in_arc = false
        i = i + 1
    if in_arc:
        fail "truncated object id"
    return parts.join(".")

# decode an object identifier value to dotted form.
pub fn read_oid(data: Bytes, pos: Int) -> String!:
    return read_oid_value(data, expect_tag(data, pos, TAG_OBJECT_ID)!)!

fn read_der_string(data: Bytes, value: DerValue) -> String!:
    if value.tag == TAG_UTF8_STRING or value.tag == TAG_PRINTABLE_STRING or value.tag == TAG_IA5_STRING or value.tag == TAG_UTC_TIME or value.tag == TAG_GENERALIZED_TIME:
        return value_bytes(data, value).to_string_utf8()!
    fail "unsupported der string tag"

fn read_int_hex(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_INTEGER:
        fail "expected integer"
    return encoding.to_hex(value_bytes(data, value))

fn read_bit_string(data: Bytes, value: DerValue) -> Bytes!:
    if value.tag != TAG_BIT_STRING:
        fail "expected bit string"
    body := value_bytes(data, value)
    if body.len() == 0:
        fail "empty bit string"
    if body[0] != 0:
        fail "bit strings with unused bits are not supported"
    return body.slice(1, body.len())

fn read_algorithm_oid(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected algorithm sequence"
    oid_value := expect_tag_in(data, value.value_start, value.value_end, TAG_OBJECT_ID)!
    return read_oid_value(data, oid_value)!

fn parse_name_common_name(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected name sequence"
    mut pos := value.value_start
    while pos < value.value_end:
        rdn := expect_tag_in(data, pos, value.value_end, TAG_SET)!
        mut rdn_pos := rdn.value_start
        while rdn_pos < rdn.value_end:
            attr := expect_tag_in(data, rdn_pos, rdn.value_end, TAG_SEQUENCE)!
            oid_val := expect_tag_in(data, attr.value_start, attr.value_end, TAG_OBJECT_ID)!
            oid := read_oid_value(data, oid_val)!
            attr_value := read_value_in(data, oid_val.next, attr.value_end)!
            if oid == OID_COMMON_NAME:
                return read_der_string(data, attr_value)!
            rdn_pos = attr.next
        pos = rdn.next
    return ""

fn parse_validity(data: Bytes, value: DerValue) -> List[String]!:
    if value.tag != TAG_SEQUENCE:
        fail "expected validity sequence"
    first := read_value_in(data, value.value_start, value.value_end)!
    second := read_value_in(data, first.next, value.value_end)!
    if second.next != value.value_end:
        fail "trailing bytes in validity sequence"
    mut out: List[String] := []
    out.push(read_der_string(data, first)!)
    out.push(read_der_string(data, second)!)
    return out

fn parse_spki_algorithm(data: Bytes, value: DerValue) -> String!:
    if value.tag != TAG_SEQUENCE:
        fail "expected public key info sequence"
    alg := expect_tag_in(data, value.value_start, value.value_end, TAG_SEQUENCE)!
    return read_algorithm_oid(data, alg)!

fn parse_spki_public_key(data: Bytes, value: DerValue) -> Bytes!:
    if value.tag != TAG_SEQUENCE:
        fail "expected public key info sequence"
    alg := expect_tag_in(data, value.value_start, value.value_end, TAG_SEQUENCE)!
    key_bits := expect_tag_in(data, alg.next, value.value_end, TAG_BIT_STRING)!
    if key_bits.next != value.value_end:
        fail "trailing bytes in public key info"
    return read_bit_string(data, key_bits)!

fn read_ip_address(data: Bytes, value: DerValue) -> String!:
    body := value_bytes(data, value)
    if body.len() == 4:
        return "{body[0]}.{body[1]}.{body[2]}.{body[3]}"
    return encoding.to_hex(body)

fn parse_san(data: Bytes, extn_value: DerValue, dns_names: List[String], ip_addresses: List[String]) -> Bool!:
    inner := value_bytes(data, extn_value)
    names := expect_tag_in(inner, 0, inner.len(), TAG_SEQUENCE)!
    if names.next != inner.len():
        fail "trailing bytes in san extension"
    mut pos := names.value_start
    while pos < names.value_end:
        name := read_value_in(inner, pos, names.value_end)!
        if name.tag == TAG_DNS_NAME:
            dns_names.push(value_bytes(inner, name).to_string_utf8()!)
        elif name.tag == TAG_IP_ADDRESS:
            ip_addresses.push(read_ip_address(inner, name)!)
        pos = name.next
    return true

# The cA flag and optional pathLenConstraint from a basicConstraints extension.
struct BasicConstraints:
    is_ca: Bool
    has_path_len: Bool
    path_len: Int

# read a small non-negative der integer body into an Int. path lengths are
# tiny; an absurd value is clamped so the multiply can never wrap.
fn der_small_int(body: Bytes) -> Int:
    mut value := 0
    mut i := 0
    while i < body.len():
        if value > 1000000:
            return 1000000
        value = value * 256 + body[i]
        i = i + 1
    return value

fn parse_basic_constraints(data: Bytes, extn_value: DerValue) -> BasicConstraints!:
    inner := value_bytes(data, extn_value)
    seq := expect_tag_in(inner, 0, inner.len(), TAG_SEQUENCE)!
    if seq.next != inner.len():
        fail "trailing bytes in basic constraints"
    if seq.value_start >= seq.value_end:
        return BasicConstraints(false, false, 0)
    mut pos := seq.value_start
    first := read_value_in(inner, pos, seq.value_end)!
    mut is_ca := false
    if first.tag == TAG_BOOLEAN:
        body := value_bytes(inner, first)
        is_ca = body.len() > 0 and body[0] != 0
        pos = first.next
    # pathLenConstraint is only meaningful for a ca and follows the cA boolean.
    if is_ca and pos < seq.value_end:
        next := read_value_in(inner, pos, seq.value_end)!
        if next.tag == TAG_INTEGER:
            return BasicConstraints(true, true, der_small_int(value_bytes(inner, next)))
    return BasicConstraints(is_ca, false, 0)

fn parse_eku(data: Bytes, extn_value: DerValue, eku_oids: List[String]) -> Bool!:
    inner := value_bytes(data, extn_value)
    seq := expect_tag_in(inner, 0, inner.len(), TAG_SEQUENCE)!
    if seq.next != inner.len():
        fail "trailing bytes in extended key usage"
    mut pos := seq.value_start
    while pos < seq.value_end:
        oid_value := expect_tag_in(inner, pos, seq.value_end, TAG_OBJECT_ID)!
        eku_oids.push(read_oid_value(inner, oid_value)!)
        pos = oid_value.next
    return true

# collect the dnsname bases from one generalsubtrees value. we only look at
# dnsname (context tag [2]); other name types are left unconstrained here.
fn collect_dns_subtrees(inner: Bytes, subtrees: DerValue, out: List[String]) -> Bool!:
    mut pos := subtrees.value_start
    while pos < subtrees.value_end:
        subtree := expect_tag_in(inner, pos, subtrees.value_end, TAG_SEQUENCE)!
        base := read_value_in(inner, subtree.value_start, subtree.value_end)!
        if base.tag == TAG_DNS_NAME:
            out.push(value_bytes(inner, base).to_string_utf8()!)
        pos = subtree.next
    return true

# collect the iPAddress subtree bases (network ++ netmask) from a GeneralSubtrees
# sequence. only 8-byte (ipv4) and 32-byte (ipv6) bases are kept; anything else
# is a malformed constraint and is skipped rather than trusted.
fn collect_ip_subtrees(inner: Bytes, subtrees: DerValue, out: List[Bytes]) -> Bool!:
    mut pos := subtrees.value_start
    while pos < subtrees.value_end:
        subtree := expect_tag_in(inner, pos, subtrees.value_end, TAG_SEQUENCE)!
        base := read_value_in(inner, subtree.value_start, subtree.value_end)!
        if base.tag == TAG_IP_ADDRESS:
            body := value_bytes(inner, base)
            if body.len() == 8 or body.len() == 32:
                out.push(body)
        pos = subtree.next
    return true

fn parse_name_constraints(data: Bytes, extn_value: DerValue, permitted_dns: List[String], excluded_dns: List[String], permitted_ip: List[Bytes], excluded_ip: List[Bytes]) -> Bool!:
    inner := value_bytes(data, extn_value)
    constraints := expect_tag_in(inner, 0, inner.len(), TAG_SEQUENCE)!
    if constraints.next != inner.len():
        fail "trailing bytes in name constraints"
    mut pos := constraints.value_start
    while pos < constraints.value_end:
        field := read_value_in(inner, pos, constraints.value_end)!
        if field.tag == TAG_PERMITTED_SUBTREES:
            collect_dns_subtrees(inner, field, permitted_dns)!
            collect_ip_subtrees(inner, field, permitted_ip)!
        elif field.tag == TAG_EXCLUDED_SUBTREES:
            collect_dns_subtrees(inner, field, excluded_dns)!
            collect_ip_subtrees(inner, field, excluded_ip)!
        pos = field.next
    return true

# whether the keyUsage extension asserts keyCertSign (bit 5). a BIT STRING is
# [unused-bit-count][bits...], MSB first, so keyCertSign sits in bit 2 of the
# first content byte. an absent keyUsage extension permits every usage.
fn parse_key_usage_cert_sign(data: Bytes, extn_value: DerValue) -> Bool!:
    inner := value_bytes(data, extn_value)
    bit_str := expect_tag_in(inner, 0, inner.len(), TAG_BIT_STRING)!
    if bit_str.next != inner.len():
        fail "trailing bytes in key usage"
    body := value_bytes(inner, bit_str)
    if body.len() < 2:
        return false
    return bits.band(bits.shr(body[1], 2), 1) == 1

# whether the keyUsage extension asserts digitalSignature (bit 0), the usage a
# tls peer certificate must carry: every suite this stack speaks authenticates
# the handshake with a signature from the leaf key.
fn parse_key_usage_digital_signature(data: Bytes, extn_value: DerValue) -> Bool!:
    inner := value_bytes(data, extn_value)
    bit_str := expect_tag_in(inner, 0, inner.len(), TAG_BIT_STRING)!
    if bit_str.next != inner.len():
        fail "trailing bytes in key usage"
    body := value_bytes(inner, bit_str)
    if body.len() < 2:
        return false
    return bits.band(bits.shr(body[1], 7), 1) == 1

# extension data gathered in one pass over the certificate's extensions.
struct ParsedExtensions:
    is_ca: Bool
    has_eku: Bool
    has_key_usage: Bool
    key_cert_sign: Bool
    digital_signature: Bool
    has_path_len: Bool
    path_len: Int

fn parse_extensions(data: Bytes, value: DerValue, dns_names: List[String], ip_addresses: List[String], eku_oids: List[String], permitted_dns: List[String], excluded_dns: List[String], permitted_ip: List[Bytes], excluded_ip: List[Bytes]) -> ParsedExtensions!:
    extensions := expect_tag_in(data, value.value_start, value.value_end, TAG_SEQUENCE)!
    if extensions.next != value.value_end:
        fail "trailing bytes in extensions wrapper"
    mut is_ca := false
    mut has_eku := false
    mut has_key_usage := false
    mut key_cert_sign := false
    mut digital_signature := false
    mut has_path_len := false
    mut path_len := 0
    mut pos := extensions.value_start
    while pos < extensions.value_end:
        ext := expect_tag_in(data, pos, extensions.value_end, TAG_SEQUENCE)!
        oid_value := expect_tag_in(data, ext.value_start, ext.value_end, TAG_OBJECT_ID)!
        oid := read_oid_value(data, oid_value)!
        mut child_pos := oid_value.next
        mut is_critical := false
        mut child := read_value_in(data, child_pos, ext.value_end)!
        if child.tag == TAG_BOOLEAN:
            # DER criticality flag: any non-zero body byte is TRUE (canonical
            # DER uses 0xFF). absent means false, the default.
            crit_body := value_bytes(data, child)
            is_critical = crit_body.len() > 0 and crit_body[0] != 0
            child_pos = child.next
            child = read_value_in(data, child_pos, ext.value_end)!
        if child.tag != TAG_OCTET_STRING or child.next != ext.value_end:
            fail "expected extension value"
        if oid == OID_SUBJECT_ALT_NAME:
            parse_san(data, child, dns_names, ip_addresses)!
        elif oid == OID_BASIC_CONSTRAINTS:
            bc := parse_basic_constraints(data, child)!
            is_ca = bc.is_ca
            has_path_len = bc.has_path_len
            path_len = bc.path_len
        elif oid == OID_EXTENDED_KEY_USAGE:
            has_eku = true
            parse_eku(data, child, eku_oids)!
        elif oid == OID_KEY_USAGE:
            has_key_usage = true
            key_cert_sign = parse_key_usage_cert_sign(data, child)!
            digital_signature = parse_key_usage_digital_signature(data, child)!
        elif oid == OID_NAME_CONSTRAINTS:
            parse_name_constraints(data, child, permitted_dns, excluded_dns, permitted_ip, excluded_ip)!
        elif is_critical:
            # RFC 5280 §4.2 / §6.1: a certificate carrying a critical extension
            # this validator does not recognise MUST be rejected. otherwise a
            # CA-signed CT precertificate (the critical poison extension
            # 1.3.6.1.4.1.11129.2.4.3), or a cert with critical policy or
            # keyUsage restrictions we do not enforce, would validate as an
            # ordinary certificate.
            fail "unrecognised critical extension: " + oid
        pos = ext.next
    return ParsedExtensions(is_ca, has_eku, has_key_usage, key_cert_sign, digital_signature, has_path_len, path_len)

fn skip_optional_tbs_field(tag: Int) -> Bool:
    return tag == 129 or tag == 161 or tag == 130 or tag == 162

fn parse_tbs(data: Bytes, tbs: DerValue, outer_sig_alg_der: Bytes, signature_value: Bytes) -> Certificate!:
    mut pos := tbs.value_start
    mut version := 1
    first := read_value_in(data, pos, tbs.value_end)!
    if first.tag == 160:
        version_value := expect_tag_in(data, first.value_start, first.value_end, TAG_INTEGER)!
        if version_value.next != first.value_end:
            fail "trailing bytes in certificate version"
        version_body := value_bytes(data, version_value)
        if version_body.len() > 0:
            version = version_body[version_body.len() - 1] + 1
        pos = first.next

    serial := expect_tag_in(data, pos, tbs.value_end, TAG_INTEGER)!
    pos = serial.next
    signature_alg := expect_tag_in(data, pos, tbs.value_end, TAG_SEQUENCE)!
    # RFC 5280 §4.1.1.2: Certificate.signatureAlgorithm MUST match TBSCertificate.signature.
    if not bytes.eq(outer_sig_alg_der, data.slice(signature_alg.header_start, signature_alg.next)):
        fail "certificate signature algorithm mismatch"
    pos = signature_alg.next
    issuer := expect_tag_in(data, pos, tbs.value_end, TAG_SEQUENCE)!
    pos = issuer.next
    validity := expect_tag_in(data, pos, tbs.value_end, TAG_SEQUENCE)!
    pos = validity.next
    subject := expect_tag_in(data, pos, tbs.value_end, TAG_SEQUENCE)!
    pos = subject.next
    spki := expect_tag_in(data, pos, tbs.value_end, TAG_SEQUENCE)!
    pos = spki.next

    validity_parts := parse_validity(data, validity)!
    mut dns_names: List[String] := []
    mut ip_addresses: List[String] := []
    mut eku_oids: List[String] := []
    mut permitted_dns: List[String] := []
    mut excluded_dns: List[String] := []
    mut permitted_ip: List[Bytes] := []
    mut excluded_ip: List[Bytes] := []
    mut is_ca := false
    mut has_eku := false
    mut has_key_usage := false
    mut key_cert_sign := false
    mut digital_signature := false
    mut has_path_len := false
    mut path_len := 0
    while pos < tbs.value_end:
        child := read_value_in(data, pos, tbs.value_end)!
        if child.tag == TAG_EXTENSIONS:
            parsed := parse_extensions(data, child, dns_names, ip_addresses, eku_oids, permitted_dns, excluded_dns, permitted_ip, excluded_ip)!
            is_ca = parsed.is_ca
            has_eku = parsed.has_eku
            has_key_usage = parsed.has_key_usage
            key_cert_sign = parsed.key_cert_sign
            digital_signature = parsed.digital_signature
            has_path_len = parsed.has_path_len
            path_len = parsed.path_len
        elif not skip_optional_tbs_field(child.tag):
            fail "unexpected tbs certificate field"
        pos = child.next

    issuer_dn := data.slice(issuer.header_start, issuer.next)
    subject_dn := data.slice(subject.header_start, subject.next)
    return Certificate(data, data.slice(tbs.header_start, tbs.next), data.slice(spki.header_start, spki.next), parse_spki_public_key(data, spki)!, signature_value, version, read_int_hex(data, serial)!, read_algorithm_oid(data, signature_alg)!, parse_spki_algorithm(data, spki)!, parse_name_common_name(data, issuer)!, parse_name_common_name(data, subject)!, validity_parts[0], validity_parts[1], dns_names, ip_addresses, is_ca, issuer_dn, subject_dn, has_eku, eku_oids, permitted_dns, excluded_dns, has_key_usage, key_cert_sign, digital_signature, has_path_len, path_len, permitted_ip, excluded_ip)

# parse a der-encoded x.509 certificate.
pub fn parse_der(data: Bytes) -> Certificate!:
    cert := expect_tag_in(data, 0, data.len(), TAG_SEQUENCE)!
    if cert.next != data.len():
        fail "trailing bytes after der certificate"
    tbs := expect_tag_in(data, cert.value_start, cert.value_end, TAG_SEQUENCE)!
    outer_sig_alg := expect_tag_in(data, tbs.next, cert.value_end, TAG_SEQUENCE)!
    sig_bits := expect_tag_in(data, outer_sig_alg.next, cert.value_end, TAG_BIT_STRING)!
    if sig_bits.next != cert.value_end:
        fail "trailing bytes in der certificate"
    outer_sig_alg_der := data.slice(outer_sig_alg.header_start, outer_sig_alg.next)
    return parse_tbs(data, tbs, outer_sig_alg_der, read_bit_string(data, sig_bits)!)!

# parse the first certificate in a pem document.
pub fn parse_pem(text: String) -> Certificate!:
    block := encoding.pem_decode(text)!
    if block.kind != "CERTIFICATE":
        fail "pem block is not a certificate"
    return parse_der(block.body)!

# parse every certificate in a pem document.
pub fn parse_pem_chain(text: String) -> List[Certificate]!:
    blocks := encoding.pem_decode_all(text)!
    mut certs: List[Certificate] := []
    for block in blocks:
        if block.kind == "CERTIFICATE":
            certs.push(parse_der(block.body)!)
    if certs.len() == 0:
        fail "pem certificate not found"
    return certs

fn host_is_ip(host: String) -> Bool:
    if host.contains(":"):
        return true
    return parse_ipv4_bytes(host).len() == 4

fn wildcard_matches(pattern: String, host: String) -> Bool:
    if not pattern.starts_with("*."):
        return false
    suffix := pattern.substring(1, pattern.len())
    # the wildcard must sit left of at least two labels: `*.example.com` is
    # legitimate, `*.com` is a public-suffix-wide certificate no ca should
    # issue and no client should honor (rfc 9525 §6.3).
    if suffix.split(".").len() < 2:
        return false
    if not host.ends_with(suffix):
        return false
    prefix_len := host.len() - suffix.len()
    if prefix_len <= 0:
        return false
    # the wildcard replaces exactly one left-most label, so what it stands in
    # for must be a single label with no embedded dot.
    return not host.substring(0, prefix_len).contains(".")

# match a hostname or ip address against the certificate's san list.
pub fn matches_hostname(cert: Certificate, host: String) -> Bool:
    target := host.to_lower()
    target_ip := ip_string_to_bytes(target)
    if target_ip.len() == 4 or target_ip.len() == 16:
        for ip in cert.ip_addresses:
            ip_bytes := ip_string_to_bytes(ip)
            if ip_bytes.len() == target_ip.len() and bytes.eq(ip_bytes, target_ip):
                return true
        return false
    if host_is_ip(target):
        for ip in cert.ip_addresses:
            if ip.to_lower() == target:
                return true
        return false
    for name in cert.dns_names:
        pattern := name.to_lower()
        if pattern == target or wildcard_matches(pattern, target):
            return true
    # deliberately NO Common Name fallback. RFC 9525 (and every modern TLS
    # client since ~2017) matches a hostname only against subjectAltName; a
    # CN-only certificate matches nothing here. this also closes a
    # name-constraint bypass: a name-constrained sub-CA could issue a leaf
    # with NO SAN and an arbitrary CN (CN=www.bank.com). name_constraints
    # checks SAN entries, not the CN, so such a leaf carries nothing to
    # constrain, and a CN fallback would then have matched. subject_common_name
    # remains available for display, just not for identity.
    return false

impl Certificate:
    fn matches_hostname(host: String) -> Bool:
        return matches_hostname(self, host)

# candidate-selection check: does `issuer` look like the certificate that
# signed `cert`? we compare the full distinguished names byte-for-byte rather
# than just the common name. this only narrows which issuer we try; the
# signature check in verify_signature is the real gate.
fn issuer_matches(cert: Certificate, issuer: Certificate) -> Bool:
    return cert.issuer_dn.len() > 0 and bytes.eq(cert.issuer_dn, issuer.subject_dn)

# a tls server leaf may carry an extendedKeyUsage extension. when it does, it
# must allow serverAuth (or the anyExtendedKeyUsage escape hatch); a cert that
# whether `cert` permits `required_eku` (or carries no EKU extension, or
# carries anyExtendedKeyUsage). enforced on leaf, intermediate CAs, and roots
# so a sub-CA restricted to emailProtection or clientAuth cannot issue TLS
# server certificates, and a serverAuth-only sub-CA cannot issue mTLS client
# certificates.
fn cert_permits_eku(cert: Certificate, required_eku: String) -> Bool:
    if not cert.has_eku:
        return true
    for oid in cert.eku_oids:
        if oid == required_eku or oid == OID_ANY_EKU:
            return true
    return false

fn leaf_permits_server_auth(cert: Certificate) -> Bool:
    return cert_permits_eku(cert, OID_SERVER_AUTH)

fn leaf_permits_client_auth(cert: Certificate) -> Bool:
    return cert_permits_eku(cert, OID_CLIENT_AUTH)

# rfc 5280 dnsname constraint match: a constraint of "example.com" matches
# "example.com" and any subdomain; a leading-dot constraint (".example.com")
# matches subdomains only. an empty constraint matches everything.
fn dns_constraint_matches(constraint: String, name: String) -> Bool:
    c := constraint.to_lower()
    n := name.to_lower()
    if c == "":
        return true
    if c.starts_with("."):
        return n.ends_with(c)
    if n == c:
        return true
    return n.ends_with("." + c)

fn dns_excluded_matches(constraint: String, name: String) -> Bool:
    if dns_constraint_matches(constraint, name):
        return true
    c := constraint.to_lower()
    n := name.to_lower()
    # a wildcard SAN like `*.example.com` covers `secret.example.com`; reject it
    # if the excluded constraint falls within the wildcard's covered label.
    if n.starts_with("*."):
        suffix := n.substring(1, n.len())
        if c.len() > suffix.len() and c.ends_with(suffix):
            prefix := c.substring(0, c.len() - suffix.len())
            if not prefix.contains("."):
                return true
    return false

# strict dotted-quad ipv4 parser: requires exactly four non-empty decimal
# octets (0..255) separated by single dots, rejecting empty segments such as
# "127..0.0.1" and ambiguous leading zeros like "0127.0.0.1".
fn parse_ipv4_bytes(text: String) -> Bytes:
    if text.len() < 7 or text.len() > 15:
        return bytes.empty()
    out := bytes.buffer_with_capacity(4)
    defer out.free()
    mut octets := 0
    mut digits := 0
    mut value := 0
    mut leading_zero := false
    mut i := 0
    while i <= text.len():
        at_end := i == text.len()
        if at_end or ord(text[i]) == 46:
            if digits == 0 or (leading_zero and digits > 1) or value > 255 or octets >= 4:
                return bytes.empty()
            out.write_byte(value) catch 0
            octets = octets + 1
            digits = 0
            value = 0
            leading_zero = false
        else:
            c := ord(text[i])
            if c < 48 or c > 57 or digits >= 3:
                return bytes.empty()
            if digits == 0 and c == 48:
                leading_zero = true
            value = value * 10 + (c - 48)
            digits = digits + 1
        i = i + 1
    if octets != 4:
        return bytes.empty()
    return out.bytes()

fn parse_ipv6_group(text: String) -> Int:
    if text.len() == 0 or text.len() > 4:
        return 0 - 1
    mut value := 0
    mut i := 0
    while i < text.len():
        c := ord(text[i])
        mut digit := 0 - 1
        if c >= 48 and c <= 57:
            digit = c - 48
        elif c >= 97 and c <= 102:
            digit = c - 97 + 10
        elif c >= 65 and c <= 70:
            digit = c - 65 + 10
        else:
            return 0 - 1
        value = value * 16 + digit
        i = i + 1
    return value

fn parse_ipv6_side(text: String, allow_ipv4_tail: Bool) -> List[Int]:
    mut groups: List[Int] := []
    if text == "":
        return groups
    if text.starts_with(":") or text.ends_with(":") or text.contains("::"):
        return [-1]
    parts := text.split(":")
    mut i := 0
    while i < parts.len():
        p := parts[i]
        if allow_ipv4_tail and i == parts.len() - 1 and p.contains("."):
            v4 := parse_ipv4_bytes(p)
            if v4.len() != 4:
                return [-1]
            groups.push(v4[0] * 256 + v4[1])
            groups.push(v4[2] * 256 + v4[3])
        else:
            g := parse_ipv6_group(p)
            if g < 0:
                return [-1]
            groups.push(g)
        i = i + 1
    return groups

fn parse_ipv6_bytes(raw: String) -> Bytes:
    mut text := raw
    if text.starts_with("[") and text.ends_with("]") and text.len() >= 2:
        text = text.substring(1, text.len() - 1)
    if not text.contains(":"):
        return bytes.empty()
    dcolon := text.index_of("::")
    mut left: List[Int] := []
    mut right: List[Int] := []
    if dcolon < 0:
        left = parse_ipv6_side(text, true)
        if left.len() != 8 or left[0] < 0:
            return bytes.empty()
    else:
        left_text := text.substring(0, dcolon)
        right_text := text.substring(dcolon + 2, text.len())
        if right_text.contains("::"):
            return bytes.empty()
        left = parse_ipv6_side(left_text, false)
        if left.len() > 0 and left[0] < 0:
            return bytes.empty()
        right = parse_ipv6_side(right_text, true)
        if right.len() > 0 and right[0] < 0:
            return bytes.empty()
        if left.len() + right.len() >= 8:
            return bytes.empty()
    zeros := 8 - left.len() - right.len()
    out := bytes.buffer_with_capacity(16)
    defer out.free()
    for g in left:
        out.write_byte(bits.shr(g, 8)) catch 0
        out.write_byte(bits.band(g, 255)) catch 0
    mut z := 0
    while z < zeros:
        out.write_byte(0) catch 0
        out.write_byte(0) catch 0
        z = z + 1
    for g in right:
        out.write_byte(bits.shr(g, 8)) catch 0
        out.write_byte(bits.band(g, 255)) catch 0
    return out.bytes()

# parse an ip san or host string back to its raw bytes: a dotted-quad to 4
# bytes, colon-hex ipv6 (with optional brackets and :: compression) to 16
# bytes, or the 32-char hex form read_ip_address emits for ipv6 to 16 bytes.
# returns empty on anything it cannot parse.
fn ip_string_to_bytes(text: String) -> Bytes:
    if text.contains(":"):
        return parse_ipv6_bytes(text)
    if text.contains("."):
        return parse_ipv4_bytes(text)
    if text.len() == 32:
        decoded := encoding.from_hex(text)
        if decoded.is_ok and decoded.ok.len() == 16:
            return decoded.ok
    return bytes.empty()

# whether an ip address falls inside a name-constraint subtree base, which is
# the network address followed by its netmask (rfc 5280 §4.2.1.10). the address
# and the base's two halves must share a length, and every address bit must
# match the network under the mask.
fn ip_in_subtree(ip: Bytes, base: Bytes) -> Bool:
    half := base.len() / 2
    if ip.len() != half:
        return false
    mut i := 0
    while i < half:
        mask := base[half + i]
        if bits.band(ip[i], mask) != bits.band(base[i], mask):
            return false
        i = i + 1
    return true

fn name_constraints_permit_leaf(leaf: Certificate, ca: Certificate) -> Bool:
    for name in leaf.dns_names:
        for excluded in ca.excluded_dns:
            if dns_excluded_matches(excluded, name):
                return false
    if ca.permitted_dns.len() > 0:
        for name in leaf.dns_names:
            mut inside := false
            for permitted in ca.permitted_dns:
                if dns_constraint_matches(permitted, name):
                    inside = true
            if not inside:
                return false
    # iPAddress constraints follow the same shape: an excluded subtree rejects
    # a matching leaf ip, and a non-empty permitted set requires every leaf ip
    # to sit inside one. only leaf ips that parse are checked; an unparseable
    # one matches no permitted subtree and is refused when the set is present.
    for ip_text in leaf.ip_addresses:
        leaf_ip := ip_string_to_bytes(ip_text)
        for excluded in ca.excluded_ip:
            if ip_in_subtree(leaf_ip, excluded):
                return false
    if ca.permitted_ip.len() > 0:
        for ip_text in leaf.ip_addresses:
            leaf_ip := ip_string_to_bytes(ip_text)
            mut inside := false
            for permitted in ca.permitted_ip:
                if ip_in_subtree(leaf_ip, permitted):
                    inside = true
            if not inside:
                return false
    return true

# read two ascii digits at `start` as an integer.
#
# the bytes are read in place rather than sliced out. len() counts bytes and
# substring() takes byte offsets, so the length check above proves nothing
# about where these cuts land, and a cut through a multi-byte character stops
# the process — during a handshake, on a certificate that has not been verified
# yet and whose contents the peer chose. checking each byte is an ascii digit
# proves exactly what the cut needed proving, and rejects the field either way.
fn parse_two_digits(text: String, start: Int) -> Int!:
    if start < 0 or start + 2 > text.len():
        fail "invalid der time digits"
    tens := ord(text[start]) - 48
    ones := ord(text[start + 1]) - 48
    if tens < 0 or tens > 9 or ones < 0 or ones > 9:
        fail "invalid der time digits"
    return tens * 10 + ones

# days from the unix epoch (1970-01-01) to a civil date, via howard hinnant's
# well-known algorithm. valid for any proleptic gregorian date; certificate
# dates are always well inside its range.
fn days_from_civil(year: Int, month: Int, day: Int) -> Int:
    mut y := year
    if month <= 2:
        y = y - 1
    era := y / 400
    year_of_era := y - era * 400
    # shift so march is month 0, which keeps the leap day at the year's end.
    mut month_index := month + 9
    if month > 2:
        month_index = month - 3
    day_of_year := (153 * month_index + 2) / 5 + day - 1
    day_of_era := year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
    return era * 146097 + day_of_era - 719468

# convert an x.509 validity timestamp to unix epoch milliseconds.
#
# rfc 5280 pins both encodings to utc with whole seconds: utctime as
# yymmddhhmmssz (13 chars) and generalizedtime as yyyymmddhhmmssz (15 chars).
# we reject anything else rather than risk reading a local time as utc.
fn der_time_to_epoch_ms(text: String) -> Int!:
    if not text.ends_with("Z"):
        fail "der time is not utc"
    mut year := 0
    mut idx := 0
    if text.len() == 13:
        # utctime two-digit year: rfc 5280 reads >= 50 as 19yy, else 20yy.
        yy := parse_two_digits(text, 0)!
        if yy >= 50:
            year = 1900 + yy
        else:
            year = 2000 + yy
        idx = 2
    elif text.len() == 15:
        year = parse_two_digits(text, 0)! * 100 + parse_two_digits(text, 2)!
        idx = 4
    else:
        fail "unsupported der time length"
    month := parse_two_digits(text, idx)!
    day := parse_two_digits(text, idx + 2)!
    hour := parse_two_digits(text, idx + 4)!
    minute := parse_two_digits(text, idx + 6)!
    second := parse_two_digits(text, idx + 8)!
    if month < 1 or month > 12 or day < 1 or day > 31:
        fail "der time has an invalid date"
    days := days_from_civil(year, month, day)
    epoch_seconds := ((days * 24 + hour) * 60 + minute) * 60 + second
    return epoch_seconds * 1000

# true when `now_ms` falls inside the certificate's validity window. a leaked
# but expired (or not-yet-valid) certificate must not verify, otherwise an
# attacker holding an old cert+key for the hostname could impersonate the
# server indefinitely. an unparseable timestamp fails closed.
fn validity_contains(cert: Certificate, now_ms: Int) -> Bool:
    not_before := der_time_to_epoch_ms(cert.not_before)
    not_after := der_time_to_epoch_ms(cert.not_after)
    if not_before.is_err or not_after.is_err:
        return false
    if now_ms < not_before.ok:
        return false
    if now_ms > not_after.ok:
        return false
    return true

## The reason a chain carrying a certificate outside its validity window is
## refused. Named so a caller can answer the peer with the alert that says
## which failure it was rather than a generic one.
pub EXPIRED_REASON := "certificate is expired or not yet valid"
## The reason a chain that never reaches a trusted root is refused.
pub UNTRUSTED_ISSUER_REASON := "certificate issuer is not trusted"
EKU_REASON := "certificate is not valid for tls server authentication"
CLIENT_EKU_REASON := "certificate is not valid for tls client authentication"
NAME_CONSTRAINT_REASON := "certificate name is outside a ca name constraint"
KEY_USAGE_REASON := "certificate issuer is not permitted to sign certificates"
LEAF_KEY_USAGE_REASON := "certificate key usage does not permit digital signatures"
PATH_LEN_REASON := "certificate chain exceeds a ca path length constraint"

fn verify_signature_for_algorithm(cert: Certificate, issuer: Certificate) -> Bool:
    if cert.signature_algorithm == "1.2.840.113549.1.1.11":
        return signature.verify_rsa_pkcs1_sha256(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.113549.1.1.12":
        return signature.verify_rsa_pkcs1_sha384(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.10045.4.3.2":
        return signature.verify_ecdsa_p256_sha256_asn1(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.2.840.10045.4.3.3":
        return signature.verify_ecdsa_p384_sha384_asn1(issuer.subject_public_key, cert.tbs_der, cert.signature)
    if cert.signature_algorithm == "1.3.101.112":
        return signature.verify_ed25519(issuer.subject_public_key, cert.tbs_der, cert.signature)
    return false

# verify a certificate signature with its issuer certificate.
pub fn verify_signature(cert: Certificate, issuer: Certificate) -> Bool:
    if cert.signature.len() == 0 or cert.tbs_der.len() == 0:
        return false
    return verify_signature_for_algorithm(cert, issuer)

fn verification_reason(hostname_ok: Bool, issuer_ok: Bool, root_ca_ok: Bool, signature_verified: Bool) -> String:
    if not hostname_ok:
        return "hostname does not match certificate san"
    if not issuer_ok:
        return "issuer does not match trusted root metadata"
    if not root_ca_ok:
        return "trusted root is not a ca certificate"
    if not signature_verified:
        return "certificate signature verification failed"
    return "ok"

fn eku_reason_for(required_eku: String) -> String:
    if required_eku == OID_CLIENT_AUTH:
        return CLIENT_EKU_REASON
    return EKU_REASON

# check whether `issuer` is a valid CA issuer for `current` (carrying `leaf` at
# depth `intermediates_used` below `issuer`) under `required_eku`. returns an
# ok VerificationResult when every check passes, or the specific failure.
fn check_issuer_hop(leaf: Certificate, current: Certificate, issuer: Certificate, now_ms: Int, intermediates_used: Int, hostname_ok: Bool, required_eku: String) -> VerificationResult:
    if not validity_contains(issuer, now_ms):
        return VerificationResult(false, hostname_ok, true, false, false, EXPIRED_REASON)
    root_ca_ok := issuer.is_ca
    signature_verified := verify_signature(current, issuer)
    if not root_ca_ok or not signature_verified:
        return VerificationResult(false, hostname_ok, true, root_ca_ok, signature_verified, verification_reason(hostname_ok, true, root_ca_ok, signature_verified))
    if issuer.has_key_usage and not issuer.key_cert_sign:
        return VerificationResult(false, hostname_ok, true, false, signature_verified, KEY_USAGE_REASON)
    if issuer.has_path_len and intermediates_used > issuer.path_len:
        return VerificationResult(false, hostname_ok, true, root_ca_ok, signature_verified, PATH_LEN_REASON)
    if not cert_permits_eku(issuer, required_eku):
        return VerificationResult(false, hostname_ok, true, root_ca_ok, signature_verified, eku_reason_for(required_eku))
    if not name_constraints_permit_leaf(leaf, issuer):
        return VerificationResult(false, hostname_ok, true, root_ca_ok, signature_verified, NAME_CONSTRAINT_REASON)
    return VerificationResult(true, hostname_ok, true, true, true, "ok")

fn verify_chain_issuers(chain: List[Certificate], trusted_roots: List[Certificate], hostname_ok: Bool, required_eku: String) -> VerificationResult:
    # one clock read for the whole walk so every certificate is judged against
    # the same instant.
    now_ms := time.now()
    leaf := chain[0]
    # the leaf must be within its validity window before we trust it, even on
    # the pinned-certificate fast path below.
    if not validity_contains(leaf, now_ms):
        return VerificationResult(false, hostname_ok, false, false, false, EXPIRED_REASON)
    # a trust anchor byte-identical to the leaf is a pinned certificate:
    # trusting the exact certificate needs no ca bit and no chain walk. this
    # is how self-signed servers (a dev postgres or a database with an
    # auto-generated cert) verify — pass the server's own pem as the ca file.
    for root in trusted_roots:
        if bytes.eq(root.der, leaf.der):
            return VerificationResult(hostname_ok, hostname_ok, true, true, true, verification_reason(hostname_ok, true, true, true))
    # track visited chain entries so out-of-order intermediates are discovered
    # regardless of wire order and no certificate is ever matched twice.
    mut used: List[Bool] := []
    mut k := 0
    while k < chain.len():
        used.push(k == 0)
        k = k + 1
    mut current := leaf
    mut intermediates_used := 0
    while intermediates_used <= chain.len():
        # try every trusted root whose subject DN matches `current.issuer_dn`
        # first: reaching a trust anchor finishes the walk immediately even if
        # the peer appended an old/untrusted root or out-of-order certs.
        mut matched_any_root := false
        mut root_failure := VerificationResult(false, hostname_ok, false, false, false, UNTRUSTED_ISSUER_REASON)
        for root in trusted_roots:
            if not issuer_matches(current, root):
                continue
            matched_any_root = true
            res := check_issuer_hop(leaf, current, root, now_ms, intermediates_used, hostname_ok, required_eku)
            if res.ok:
                return VerificationResult(hostname_ok, hostname_ok, true, true, true, verification_reason(hostname_ok, true, true, true))
            root_failure = res
        # otherwise walk through any unused intermediate in `chain` (in any
        # position, handling out-of-order and cross-signed chains).
        mut matched_any_chain := false
        mut chain_failure := VerificationResult(false, hostname_ok, false, false, false, UNTRUSTED_ISSUER_REASON)
        mut advanced := false
        mut i := 1
        while i < chain.len():
            if not used[i] and issuer_matches(current, chain[i]):
                matched_any_chain = true
                res := check_issuer_hop(leaf, current, chain[i], now_ms, intermediates_used, hostname_ok, required_eku)
                if res.ok:
                    used[i] = true
                    current = chain[i]
                    intermediates_used = intermediates_used + 1
                    advanced = true
                    break
                chain_failure = res
            i = i + 1
        if advanced:
            continue
        if matched_any_chain:
            return chain_failure
        if matched_any_root:
            return root_failure
        return VerificationResult(false, hostname_ok, false, false, false, UNTRUSTED_ISSUER_REASON)
    return VerificationResult(false, hostname_ok, false, false, false, "certificate chain is too deep")

# check the server name against the certificate san list.
pub fn verify_hostname(cert: Certificate, host: String) -> VerificationResult:
    hostname_ok := matches_hostname(cert, host)
    return VerificationResult(hostname_ok, hostname_ok, true, true, true, verification_reason(hostname_ok, true, true, true))

# run the native trust preflight for a server certificate and root.
#
# this checks hostname, issuer metadata, ca constraints (basicConstraints,
# keyCertSign, EKU, name constraints), and certificate signature.
pub fn preflight_server_certificate(cert: Certificate, trusted_root: Certificate, host: String) -> VerificationResult:
    hostname_ok := matches_hostname(cert, host)
    # both the leaf and the trust anchor must be inside their validity windows.
    now_ms := time.now()
    if not validity_contains(cert, now_ms) or not validity_contains(trusted_root, now_ms):
        return VerificationResult(false, hostname_ok, false, false, false, EXPIRED_REASON)
    # a leaf whose eku forbids server authentication is being misused as a
    # server certificate, even if it chains and its name matches.
    if not leaf_permits_server_auth(cert):
        return VerificationResult(false, hostname_ok, false, false, false, EKU_REASON)
    if not leaf_permits_signing(cert):
        return VerificationResult(false, hostname_ok, false, false, false, LEAF_KEY_USAGE_REASON)
    issuer_ok := issuer_matches(cert, trusted_root)
    root_ca_ok := trusted_root.is_ca
    signature_verified := verify_signature(cert, trusted_root)
    if not issuer_ok or not root_ca_ok or not signature_verified:
        return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, verification_reason(hostname_ok, issuer_ok, root_ca_ok, signature_verified))
    if trusted_root.has_key_usage and not trusted_root.key_cert_sign:
        return VerificationResult(false, hostname_ok, issuer_ok, false, signature_verified, KEY_USAGE_REASON)
    if not cert_permits_eku(trusted_root, OID_SERVER_AUTH):
        return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, EKU_REASON)
    if not name_constraints_permit_leaf(cert, trusted_root):
        return VerificationResult(false, hostname_ok, issuer_ok, root_ca_ok, signature_verified, NAME_CONSTRAINT_REASON)
    return VerificationResult(hostname_ok, hostname_ok, issuer_ok, root_ca_ok, signature_verified, verification_reason(hostname_ok, issuer_ok, root_ca_ok, signature_verified))

# whether a peer's leaf certificate may sign the handshake. every suite this
# stack speaks (ecdhe on 1.2, certificateverify on 1.3) authenticates with a
# signature from the leaf key, so a keyUsage extension that withholds
# digitalSignature makes the certificate unusable as a tls peer. an absent
# extension permits every usage (rfc 5280 §4.2.1.3).
fn leaf_permits_signing(leaf: Certificate) -> Bool:
    if not leaf.has_key_usage:
        return true
    return leaf.digital_signature

# verify a server certificate chain against trusted roots.
pub fn verify_server_chain(chain: List[Certificate], trusted_roots: List[Certificate], host: String) -> VerificationResult:
    if chain.len() == 0:
        return VerificationResult(false, false, false, false, false, "certificate chain is empty")
    if trusted_roots.len() == 0:
        return VerificationResult(false, false, false, false, false, "trusted roots are empty")
    leaf := chain[0]
    hostname_ok := matches_hostname(leaf, host)
    if not hostname_ok:
        return VerificationResult(false, false, true, true, true, verification_reason(false, true, true, true))
    # reject a leaf whose extendedKeyUsage does not permit tls server auth
    # before doing the more expensive chain walk.
    if not leaf_permits_server_auth(leaf):
        return VerificationResult(false, hostname_ok, false, false, false, EKU_REASON)
    if not leaf_permits_signing(leaf):
        return VerificationResult(false, hostname_ok, false, false, false, LEAF_KEY_USAGE_REASON)

    return verify_chain_issuers(chain, trusted_roots, hostname_ok, OID_SERVER_AUTH)

# verify a client certificate chain against trusted roots.
pub fn verify_client_chain(chain: List[Certificate], trusted_roots: List[Certificate]) -> VerificationResult:
    if chain.len() == 0:
        return VerificationResult(false, true, false, false, false, "certificate chain is empty")
    if trusted_roots.len() == 0:
        return VerificationResult(false, true, false, false, false, "trusted roots are empty")
    if not leaf_permits_client_auth(chain[0]):
        return VerificationResult(false, true, false, false, false, CLIENT_EKU_REASON)
    if not leaf_permits_signing(chain[0]):
        return VerificationResult(false, true, false, false, false, LEAF_KEY_USAGE_REASON)
    return verify_chain_issuers(chain, trusted_roots, true, OID_CLIENT_AUTH)

test "x509 does not match a hostname against a certificate's common name":
    # a leaf with NO subjectAltName and CN=www.bank.com must not match the
    # hostname www.bank.com — RFC 9525, and the close of a name-constraint
    # bypass (a constrained sub-CA could mint such a leaf for any name).
    cert := parse_pem(read_file("tests/live/fixtures/cn-only-no-san.crt")!)!
    assert_eq(cert.subject_common_name, "www.bank.com")
    assert(not cert.matches_hostname("www.bank.com"))
    # a cert that carries the name as a SAN still matches (the localhost
    # fixture has DNS:localhost).
    ok := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    assert(ok.matches_hostname("localhost"))

test "x509 rejects a certificate carrying an unrecognised critical extension":
    # a CT precertificate is a CA-signed cert whose only mark of not-a-real-cert
    # is the critical poison extension 1.3.6.1.4.1.11129.2.4.3. RFC 5280 requires
    # rejecting an unrecognised critical extension; accepting it would let a
    # precert pulled from a public CT log validate as a genuine certificate.
    result := parse_pem(read_file("tests/live/fixtures/poison-critical-ext.crt")!)
    assert(result.is_err)
    # a benign cert with a critical keyUsage (which this validator DOES
    # recognise) must still parse — the localhost fixture carries exactly that.
    ok := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)
    assert(ok.is_ok)

test "x509 rejects a clientauth-only leaf used as a server certificate":
    # this leaf is legitimately issued and chains to its ca, but its
    # extendedKeyUsage lists only clientAuth. it must not verify as a server
    # certificate even though the hostname and signature are fine.
    leaf := parse_pem(read_file("tests/live/fixtures/clientauth-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/eku-ca.crt")!)!

    assert(leaf.has_eku)
    assert(not leaf.eku_oids.contains(OID_SERVER_AUTH))

    server := verify_server_chain([leaf], [ca], "localhost")
    assert(not server.ok)
    assert_eq(server.reason, EKU_REASON)

    # the same certificate is valid for client authentication, proving it is a
    # real chain that we reject only for the wrong purpose.
    client := verify_client_chain([leaf], [ca])
    assert(client.ok)

test "x509 rejects a serverauth-only leaf used as a client certificate":
    # this leaf chains to its ca and passes server verification, but its
    # extendedKeyUsage lists only serverAuth. it must not verify as an mtls
    # client certificate.
    leaf := parse_pem(read_file("tests/live/fixtures/nc-good-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/nc-ca.crt")!)!

    assert(leaf.has_eku)
    assert(leaf.eku_oids.contains(OID_SERVER_AUTH))
    assert(not leaf.eku_oids.contains(OID_CLIENT_AUTH))

    server := verify_server_chain([leaf], [ca], "good.example.com")
    assert(server.ok)

    client := verify_client_chain([leaf], [ca])
    assert(not client.ok)
    assert_eq(client.reason, CLIENT_EKU_REASON)

    # a certificate with no eku extension permits any purpose per rfc 5280.
    assert(not ca.has_eku)
    assert(leaf_permits_client_auth(ca))

test "x509 accepts a serverauth leaf and an eku-less leaf":
    # localhost.crt carries a serverAuth eku and must be accepted.
    with_eku := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    assert(with_eku.has_eku)
    assert(with_eku.eku_oids.contains(OID_SERVER_AUTH))
    good := verify_server_chain([with_eku], [ca], "localhost")
    assert(good.ok)

    # a certificate with no eku extension is valid for any purpose, so the
    # server-auth check must not reject it.
    assert(not ca.has_eku)
    assert(leaf_permits_server_auth(ca))

test "x509 enforces ipaddress name-constraints on the chain":
    inrange := parse_pem(read_file("tests/live/fixtures/ipnc-inrange-leaf.crt")!)!
    outrange := parse_pem(read_file("tests/live/fixtures/ipnc-outrange-leaf.crt")!)!
    intermediate := parse_pem(read_file("tests/live/fixtures/ipnc-int.crt")!)!
    root := parse_pem(read_file("tests/live/fixtures/ipnc-root.crt")!)!

    # the intermediate is permitted the 10.0.0.0/8 block only.
    assert_eq(intermediate.permitted_ip.len(), 1)
    assert(inrange.ip_addresses.contains("10.1.2.3"))
    assert(outrange.ip_addresses.contains("8.8.8.8"))

    # 10.1.2.3 sits inside the permitted block, so the chain verifies.
    good := verify_server_chain([inrange, intermediate], [root], "10.1.2.3")
    assert(good.ok)

    # 8.8.8.8 is outside it; the constrained intermediate may not vouch for it
    # even though the signature verifies and the ip san matches the host.
    bad := verify_server_chain([outrange, intermediate], [root], "8.8.8.8")
    assert(not bad.ok)
    assert_eq(bad.reason, NAME_CONSTRAINT_REASON)

test "x509 enforces dnsname name-constraints on the chain":
    good := parse_pem(read_file("tests/live/fixtures/nc-good-leaf.crt")!)!
    bad := parse_pem(read_file("tests/live/fixtures/nc-bad-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/nc-ca.crt")!)!

    assert(ca.permitted_dns.contains("example.com"))

    # good.example.com falls inside the permitted example.com subtree.
    inside := verify_server_chain([good], [ca], "good.example.com")
    assert(inside.ok)

    # evil.com is outside the permitted subtree; the constrained ca may not
    # anchor it even though the signature verifies and the hostname matches.
    outside := verify_server_chain([bad], [ca], "evil.com")
    assert(not outside.ok)
    assert_eq(outside.reason, NAME_CONSTRAINT_REASON)

test "der oid decoder reads common object ids":
    data := encoding.from_hex("0603551D11")!
    assert_eq(read_oid(data, 0)!, OID_SUBJECT_ALT_NAME)

test "x509 parses tls fixture certificates":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!

    assert_eq(cert.version, 3)
    assert_eq(cert.subject_common_name, "localhost")
    assert_eq(cert.issuer_common_name, "pith-test-ca")
    assert_eq(cert.signature_algorithm, "1.2.840.113549.1.1.11")
    assert_eq(cert.public_key_algorithm, "1.2.840.113549.1.1.1")
    assert(cert.tbs_der.len() > 0)
    assert(cert.subject_public_key_info.len() > 0)
    assert(cert.subject_public_key.len() > 0)
    assert(cert.signature.len() > 0)
    assert(cert.dns_names.contains("localhost"))
    assert(cert.ip_addresses.contains("127.0.0.1"))
    assert(not cert.is_ca)
    assert(ca.is_ca)

test "x509 hostname matching uses san names":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!

    assert(cert.matches_hostname("localhost"))
    assert(cert.matches_hostname("127.0.0.1"))
    assert(not cert.matches_hostname("example.com"))

test "x509 wildcard hostname matching is single-label and not public-suffix-wide":
    # *.example.com covers one left-most label only.
    assert(wildcard_matches("*.example.com", "www.example.com"))
    assert(wildcard_matches("*.example.com", "api.example.com"))
    # not two labels, not the bare domain, not a different domain.
    assert(not wildcard_matches("*.example.com", "a.b.example.com"))
    assert(not wildcard_matches("*.example.com", "example.com"))
    assert(not wildcard_matches("*.example.com", "www.example.org"))
    # a single-label (top-level-domain) wildcard is refused outright. a
    # multi-label public suffix like co.uk needs the public suffix list to
    # reject fully, which is out of scope here — the label-count rule catches
    # the most dangerous and most common case.
    assert(not wildcard_matches("*.com", "victim.com"))
    assert(not wildcard_matches("*.org", "victim.org"))
    # a bare or malformed wildcard matches nothing.
    assert(not wildcard_matches("*", "anything"))
    assert(not wildcard_matches("www.example.com", "www.example.com"))

test "x509 parses pem certificate chains":
    chain := read_file("tests/live/fixtures/localhost.crt")! + read_file("tests/live/fixtures/localhost-ca.crt")!
    certs := parse_pem_chain(chain)!

    assert_eq(certs.len(), 2)
    assert_eq(certs[0].subject_common_name, "localhost")
    assert_eq(certs[1].subject_common_name, "pith-test-ca")

test "x509 trust preflight verifies fixture signature":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := preflight_server_certificate(cert, ca, "localhost")
    bad_host := preflight_server_certificate(cert, ca, "example.com")

    assert(verify_signature(cert, ca))
    assert(good.hostname_ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(good.ok)
    assert_eq(good.reason, "ok")
    assert(not bad_host.hostname_ok)

test "x509 verifies server chains against trusted roots":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := verify_server_chain([cert], [ca], "localhost")
    bad_host := verify_server_chain([cert], [ca], "example.com")
    bad_roots := verify_server_chain([cert], [], "localhost")

    assert(good.ok)
    assert(good.hostname_ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(not bad_host.ok)
    assert(not bad_host.hostname_ok)
    assert(not bad_roots.ok)

test "x509 enforces keyCertSign and pathLenConstraint on ca certificates":
    fx := "tests/live/fixtures/"
    root := parse_pem(read_file(fx + "constraint-root.crt")!)!
    # a well-formed chain through a keyCertSign ca still verifies.
    good := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-good.crt")!)!, parse_pem(read_file(fx + "constraint-int-good.crt")!)!], [root], "leaf.test")
    assert(good.ok)
    # an intermediate whose keyUsage omits keyCertSign may not sign the leaf.
    no_sign := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-no-keycertsign.crt")!)!, parse_pem(read_file(fx + "constraint-int-no-keycertsign.crt")!)!], [root], "leaf.test")
    assert(not no_sign.ok)
    assert_eq(no_sign.reason, KEY_USAGE_REASON)
    # a pathlen:0 intermediate may not have another intermediate below it.
    too_deep := verify_server_chain([parse_pem(read_file(fx + "constraint-leaf-pathlen.crt")!)!, parse_pem(read_file(fx + "constraint-int-below-pathlen0.crt")!)!, parse_pem(read_file(fx + "constraint-int-pathlen0.crt")!)!], [root], "leaf.test")
    assert(not too_deep.ok)
    assert_eq(too_deep.reason, PATH_LEN_REASON)

test "x509 requires digitalSignature key usage of a tls leaf":
    fx := "tests/live/fixtures/"
    root := parse_pem(read_file(fx + "keyusage-root.crt")!)!
    # a leaf whose keyUsage grants only keyEncipherment cannot sign a handshake.
    enc := verify_server_chain([parse_pem(read_file(fx + "keyusage-leaf-encipherment.crt")!)!], [root], "leaf.test")
    assert(not enc.ok)
    assert_eq(enc.reason, LEAF_KEY_USAGE_REASON)
    # the same subject with digitalSignature verifies.
    signing := verify_server_chain([parse_pem(read_file(fx + "keyusage-leaf-signing.crt")!)!], [root], "leaf.test")
    assert(signing.ok)
    # the client-chain path applies the same leaf rule.
    enc_client := verify_client_chain([parse_pem(read_file(fx + "keyusage-leaf-encipherment.crt")!)!], [root])
    assert(not enc_client.ok)
    assert_eq(enc_client.reason, LEAF_KEY_USAGE_REASON)

test "x509 verifies client chains against trusted roots":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/localhost-ca.crt")!)!
    good := verify_client_chain([cert], [ca])
    bad_roots := verify_client_chain([cert], [])

    assert(good.ok)
    assert(good.issuer_ok)
    assert(good.root_ca_ok)
    assert(good.signature_verified)
    assert(not bad_roots.ok)

test "x509 verifies an ecdsa p-384 sha-384 chain signature":
    leaf := parse_pem(read_file("tests/live/fixtures/p384-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/p384-ca.crt")!)!

    # public ca intermediates sign with ecdsa-with-sha384; this is the
    # algorithm the tls client needs to walk a real chain to a public root.
    assert_eq(leaf.signature_algorithm, "1.2.840.10045.4.3.3")
    assert(verify_signature(leaf, ca))
    # a leaf does not verify against its own key.
    assert(not verify_signature(leaf, leaf))

test "x509 verifies an rsa sha-384 chain signature":
    leaf := parse_pem(read_file("tests/live/fixtures/rsa384-leaf.crt")!)!
    ca := parse_pem(read_file("tests/live/fixtures/rsa384-ca.crt")!)!

    assert_eq(leaf.signature_algorithm, "1.2.840.113549.1.1.12")
    assert(verify_signature(leaf, ca))
    assert(not verify_signature(leaf, leaf))

test "x509 der time parses utctime and generalizedtime to epoch millis":
    # unix epoch expressed as a two-digit utctime year.
    assert_eq(der_time_to_epoch_ms("700101000000Z")!, 0)
    # a full generalizedtime; 2020-01-01 00:00:00 utc.
    assert_eq(der_time_to_epoch_ms("20200101000000Z")!, 1577836800000)
    # utctime years below 50 resolve into the 2000s, matching generalizedtime.
    assert_eq(der_time_to_epoch_ms("260721123456Z")!, der_time_to_epoch_ms("20260721123456Z")!)
    # a timestamp without the mandatory utc marker is rejected, not misread.
    assert(der_time_to_epoch_ms("20200101000000").is_err)
    # a field that is the right length and ends in the marker but is not ascii
    # digits. the digits used to be sliced two at a time, and a String is cut in
    # bytes, so a multi-byte character straddling one of those cuts stopped the
    # process — during a handshake, on a certificate nobody had verified yet.
    # "7é101000000Z" is thirteen bytes with the character sitting across the
    # first cut.
    assert(der_time_to_epoch_ms("7é101000000Z").is_err)
    # the same, fifteen bytes, for the generalizedtime branch.
    assert(der_time_to_epoch_ms("2é01010000000Z").is_err)

test "x509 rejects an expired certificate":
    expired := parse_pem(read_file("tests/live/fixtures/expired-localhost.crt")!)!
    # the hostname still matches, but the window closed in 2021, so both the
    # pinned-trust fast path and the preflight must refuse the certificate.
    pinned := verify_server_chain([expired], [expired], "localhost")
    preflight := preflight_server_certificate(expired, expired, "localhost")

    assert(expired.matches_hostname("localhost"))
    assert(not pinned.ok)
    assert_eq(pinned.reason, EXPIRED_REASON)
    assert(not preflight.ok)
    assert_eq(preflight.reason, EXPIRED_REASON)

test "x509 fixture key signs rsa pss messages":
    cert := parse_pem(read_file("tests/live/fixtures/localhost.crt")!)!
    key := encoding.pem_decode(read_file("tests/live/fixtures/localhost.key")!)!
    message := bytes.from_string_utf8("pith signature")
    sig := signature.sign_rsa_pss_sha256_pkcs8(key.body, message)!

    assert(signature.verify_rsa_pss_sha256(cert.subject_public_key, message, sig))

test "x509 wildcard excluded constraints and ipv6 san matching work":
    assert(dns_excluded_matches("secret.example.com", "*.example.com"))
    assert(dns_excluded_matches(".example.com", "*.example.com"))
    assert(dns_excluded_matches("example.com", "*.example.com"))
    assert(not dns_excluded_matches("secret.example.com", "*.other.example.com"))
    assert(not dns_excluded_matches("other.net", "*.example.com"))
    # canonical ipv6 byte parsing matches compressed, bracketed, ipv4-mapped, and 32-char hex
    loopback := ip_string_to_bytes("::1")
    assert_eq(loopback.len(), 16)
    assert(bytes.eq(loopback, ip_string_to_bytes("[::1]")))
    assert(bytes.eq(loopback, ip_string_to_bytes("00000000000000000000000000000001")))
    assert(bytes.eq(ip_string_to_bytes("2001:db8::1"), ip_string_to_bytes("2001:0db8:0000:0000:0000:0000:0000:0001")))
    assert(bytes.eq(ip_string_to_bytes("::ffff:127.0.0.1"), ip_string_to_bytes("00000000000000000000ffff7f000001")))
    assert_eq(ip_string_to_bytes("not::an::ip").len(), 0)
    assert_eq(ip_string_to_bytes("127..0.0.1").len(), 0)
    assert_eq(ip_string_to_bytes(".127.0.0.1").len(), 0)
    assert_eq(ip_string_to_bytes("127.0.0.1.").len(), 0)
    assert_eq(ip_string_to_bytes("0127.0.0.1").len(), 0)
    assert_eq(ip_string_to_bytes("1:::2").len(), 0)
    assert(not host_is_ip("127..0.0.1"))

test "x509 oid decoder rejects non-minimal 0x80, truncated 0x80, and 64-bit overflow":
    # non-minimal leading 0x80 subidentifier (06 03 2a 80 01)
    assert(read_oid(encoding.from_hex("06032a8001")!, 0).is_err)
    # truncated trailing 0x80 subidentifier (06 02 2a 80)
    assert(read_oid(encoding.from_hex("06022a80")!, 0).is_err)
    # 10-byte base-128 arc overflows 64-bit Int
    assert(read_oid(encoding.from_hex("060b2a81818181818181818101")!, 0).is_err)

test "x509 enforces preflight name constraints, keyCertSign, intermediate EKU, out-of-order chains, and outer sig alg":
    # preflight enforces name constraints (nc-ca constrains to example.com)
    bad_nc := parse_pem(read_file("tests/live/fixtures/nc-bad-leaf.crt")!)!
    nc_ca := parse_pem(read_file("tests/live/fixtures/nc-ca.crt")!)!
    pre_nc := preflight_server_certificate(bad_nc, nc_ca, "evil.com")
    assert(not pre_nc.ok)
    assert_eq(pre_nc.reason, NAME_CONSTRAINT_REASON)

    # preflight enforces keyCertSign on trusted root
    fx := "tests/live/fixtures/"
    no_kcs_leaf := parse_pem(read_file(fx + "constraint-leaf-no-keycertsign.crt")!)!
    no_kcs_ca := parse_pem(read_file(fx + "constraint-int-no-keycertsign.crt")!)!
    pre_kcs := preflight_server_certificate(no_kcs_leaf, no_kcs_ca, "leaf.test")
    assert(not pre_kcs.ok)
    assert_eq(pre_kcs.reason, KEY_USAGE_REASON)

    # intermediate CA carrying clientAuth-only EKU cannot anchor a TLS server cert
    good_leaf := parse_pem(read_file(fx + "constraint-leaf-good.crt")!)!
    good_int := parse_pem(read_file(fx + "constraint-int-good.crt")!)!
    root := parse_pem(read_file(fx + "constraint-root.crt")!)!
    client_only_int := Certificate(good_int.der, good_int.tbs_der, good_int.subject_public_key_info, good_int.subject_public_key, good_int.signature, good_int.version, good_int.serial_hex, good_int.signature_algorithm, good_int.public_key_algorithm, good_int.issuer_common_name, good_int.subject_common_name, good_int.not_before, good_int.not_after, good_int.dns_names, good_int.ip_addresses, good_int.is_ca, good_int.issuer_dn, good_int.subject_dn, true, [OID_CLIENT_AUTH], good_int.permitted_dns, good_int.excluded_dns, good_int.has_key_usage, good_int.key_cert_sign, good_int.digital_signature, good_int.has_path_len, good_int.path_len, good_int.permitted_ip, good_int.excluded_ip)
    bad_eku_srv := verify_server_chain([good_leaf, client_only_int], [root], "leaf.test")
    assert(not bad_eku_srv.ok)
    assert_eq(bad_eku_srv.reason, EKU_REASON)

    # intermediate CA carrying serverAuth-only EKU cannot anchor an mTLS client cert
    server_only_int := Certificate(good_int.der, good_int.tbs_der, good_int.subject_public_key_info, good_int.subject_public_key, good_int.signature, good_int.version, good_int.serial_hex, good_int.signature_algorithm, good_int.public_key_algorithm, good_int.issuer_common_name, good_int.subject_common_name, good_int.not_before, good_int.not_after, good_int.dns_names, good_int.ip_addresses, good_int.is_ca, good_int.issuer_dn, good_int.subject_dn, true, [OID_SERVER_AUTH], good_int.permitted_dns, good_int.excluded_dns, good_int.has_key_usage, good_int.key_cert_sign, good_int.digital_signature, good_int.has_path_len, good_int.path_len, good_int.permitted_ip, good_int.excluded_ip)
    bad_eku_cli := verify_client_chain([good_leaf, server_only_int], [root])
    assert(not bad_eku_cli.ok)
    assert_eq(bad_eku_cli.reason, CLIENT_EKU_REASON)

    # out-of-order intermediates still verify and still enforce pathLenConstraint
    pl_leaf := parse_pem(read_file(fx + "constraint-leaf-pathlen.crt")!)!
    pl_below := parse_pem(read_file(fx + "constraint-int-below-pathlen0.crt")!)!
    pl_top := parse_pem(read_file(fx + "constraint-int-pathlen0.crt")!)!
    reordered := verify_server_chain([pl_leaf, pl_top, pl_below], [root], "leaf.test")
    assert(not reordered.ok)
    assert_eq(reordered.reason, PATH_LEN_REASON)
    # extra unrelated cert before the real intermediate still finds the real intermediate
    with_decoy := verify_server_chain([good_leaf, nc_ca, good_int], [root], "leaf.test")
    assert(with_decoy.ok)

    # mismatched outer signatureAlgorithm vs TBSCertificate.signature is rejected
    cert_der := good_leaf.der
    outer_seq := expect_tag_in(cert_der, 0, cert_der.len(), TAG_SEQUENCE)!
    tbs_tlv := expect_tag_in(cert_der, outer_seq.value_start, outer_seq.value_end, TAG_SEQUENCE)!
    outer_alg := expect_tag_in(cert_der, tbs_tlv.next, outer_seq.value_end, TAG_SEQUENCE)!
    # flip the last OID byte inside outer signatureAlgorithm (sha256WithRSA -> sha384WithRSA)
    mut tampered := bytes.buffer_with_capacity(cert_der.len())
    defer tampered.free()
    mut pos := 0
    while pos < cert_der.len():
        if pos == outer_alg.value_start + 10:
            tampered.write_byte(cert_der[pos] + 1)!
        else:
            tampered.write_byte(cert_der[pos])!
        pos = pos + 1
    assert(parse_der(tampered.bytes()).is_err)
