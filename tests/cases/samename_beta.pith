pub struct Box:
    pub label: String
pub fn boxes(labels: List[String]) -> List[Box]:
    mut out: List[Box] := []
    for s in labels:
        out.push(Box(label: s))
    return out
pub fn joined(xs: List[Box]) -> String:
    mut out := ""
    for x in xs:
        out = out + x.label
    return out
