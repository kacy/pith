# errdefer: cleanup that runs only when a function leaves through an error.
#
# moves money between two accounts inside a transaction. the transfer
# begins a transaction, registers `errdefer tx.rollback()` right after, and
# commits at the end. a failed step (a `fail`, or a `!` that propagates)
# rolls the transaction back; a successful commit is left alone, which a
# plain defer would not do.
#
# the store is in memory so the example runs on its own, but the shape is the
# one to write against std.db: begin, errdefer rollback, work, commit.

struct Store:
    balances: Map[String, Int]
    open_transactions: Int = 0

struct Tx:
    store: Store
    # changes are staged here and applied to the store only on commit
    staged: Map[String, Int]

impl Store:
    fn begin() -> Tx:
        self.open_transactions += 1
        return Tx(store: self, staged: {})

impl Tx:
    fn balance(account: String) -> Int!:
        if let staged = self.staged.get(account):
            return staged
        if let current = self.store.balances.get(account):
            return current
        fail "no account named {account}"

    fn adjust(account: String, cents: Int) -> Int!:
        updated := self.balance(account)! + cents
        if updated < 0:
            fail "{account} would be overdrawn by {-updated}"
        self.staged[account] = updated
        return updated

    fn commit():
        for account in self.staged.keys():
            self.store.balances[account] = self.staged[account]
        self.store.open_transactions -= 1

    fn rollback():
        print("  rolled back")
        self.store.open_transactions -= 1

fn transfer(store: Store, source: String, target: String, cents: Int) -> Int!:
    tx := store.begin()
    errdefer tx.rollback()

    tx.adjust(source, -cents)!
    tx.adjust(target, cents)!
    tx.commit()
    return cents

fn main():
    store := Store(balances: {"alice": 10000, "bob": 2500})
    attempts := [("alice", "bob", 3000), ("bob", "alice", 9000), ("alice", "carol", 500)]
    for attempt in attempts:
        print("transfer {attempt.2} from {attempt.0} to {attempt.1}")
        moved := transfer(store, attempt.0, attempt.1, attempt.2)
        if moved.is_err:
            print("  failed: {moved.err}")
        else:
            print("  done")
        print("  alice {store.balances["alice"]}, bob {store.balances["bob"]}, open transactions {store.open_transactions}")
