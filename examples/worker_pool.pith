# a worker pool: count the words in a batch of documents with four workers.
#
# the documents go out on one channel and the counts come back on another.
# this is the shape the green backend is built for, many small tasks handing
# values to each other, and it runs the same on either backend:
#
#     pith run examples/worker_pool.pith                # tasks share a worker pool (linux default)
#     PITH_GREEN=0 pith run examples/worker_pool.pith   # one os thread per task
#
# which worker takes which document varies from run to run, so main reports
# sums, which do not depend on the order the counts arrive in.

WORKERS := 4

struct Count:
    words: Int
    longest: Int

# take documents until the channel is closed and drained, then return how
# many this worker handled.
fn worker(docs: Channel[String], counts: Channel[Count]) -> Int:
    mut handled := 0
    while let doc = docs.recv():
        words := doc.split(" ").filter(fn(w: String) => w != "")
        longest := words.reduce(0, fn(best: Int, w: String) => if w.len() > best: w.len() else: best)
        counts.send(Count(words: words.len(), longest: longest))
        handled = handled + 1
    return handled

fn documents() -> List[String]:
    mut docs: List[String] := []
    for i in 0..20:
        week := i + 1
        docs.push("report {week} covers week {week} with nothing unusual to note")
    docs.push("")
    docs.push("an   extraordinarily   spaced   memo")
    return docs

fn main() -> Int!:
    docs := documents()
    total_docs := docs.len()
    queue := Channel[String](total_docs)
    counts := Channel[Count](total_docs)

    mut pool: List[Task[Int]] := []
    for w in 0..WORKERS:
        pool.push(spawn worker(queue, counts))

    for doc in docs:
        queue.send(doc)
    # closing tells the workers there is no more work once the queue drains.
    queue.close()

    mut words := 0
    mut longest := 0
    for n in 0..total_docs:
        c := counts.recv().unwrap_or(Count(words: 0, longest: 0))
        words = words + c.words
        longest = if c.longest > longest: c.longest else: longest

    mut handled := 0
    for t in pool:
        handled = handled + await t

    print("workers:        {WORKERS}")
    print("documents:      {handled}")
    print("words:          {words}")
    print("longest word:   {longest} letters")
    return 0
