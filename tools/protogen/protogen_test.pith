# tests for the code protogen generates from sample.proto (sample_gen.pith).
# round-trips exercise every field kind; the hex assertions check the generated
# encoder emits the canonical protobuf wire bytes, byte for byte.

from sample_gen import Point, Shape, encode_Point, decode_Point, encode_Shape, decode_Shape, Color_RED, Color_GREEN
from sample_gen import Sticker, encode_Sticker, decode_Sticker, StickerDesign, StickerBacking
from sample_gen import Sticker_emoji, Sticker_anchor, Sticker_tint, Sticker_design_unset, Sticker_reusable, Sticker_stock, Sticker_backing_unset
from sample_gen import Inventory, Bin, encode_Inventory, decode_Inventory
from protogen_lib import parse, generate
from std.protobuf import writer
import std.bytes as bytes
import std.encoding as encoding
import std.fs as fs
import std.strings as strings

test "a point round-trips":
    p := Point(x: 150, y: 7)
    back := decode_Point(encode_Point(p))!
    assert_eq(back.x, 150)
    assert_eq(back.y, 7)

test "a point encodes to the canonical wire bytes":
    # field 1 = 150 is 08 96 01; y = 0 is the default and is skipped.
    p := Point(x: 150, y: 0)
    assert_eq(encoding.to_hex(encode_Point(p)), "089601")

test "a shape round-trips every field kind":
    s := Shape(name: "sq", id: 42, filled: true, color: Color_RED, center: Point(x: 1, y: 2), vertices: [Point(x: 3, y: 4), Point(x: 5, y: 6)], tags: [10, 20, 30], labels: ["a", "b"], blob: bytes.from_string_utf8("xy"), area: 2.5, offset: 0 - 7)
    back := decode_Shape(encode_Shape(s))!
    assert_eq(back.name, "sq")
    assert_eq(back.id, 42)
    assert(back.filled)
    assert_eq(back.color, Color_RED)
    if let c = back.center:
        assert_eq(c.x, 1)
        assert_eq(c.y, 2)
    else:
        assert(false)
    assert_eq(back.vertices.len(), 2)
    assert_eq(back.vertices[1].x, 5)
    assert_eq(back.tags, [10, 20, 30])
    assert_eq(back.labels, ["a", "b"])
    assert_eq(encoding.to_hex(back.blob), "7879")
    assert_eq(back.area, 2.5)
    assert_eq(back.offset, 0 - 7)

test "a string field is the canonical tag-length-utf8":
    s := empty_shape()
    s.name = "pith"
    # field 1, wire 2 (length-delimited): 0a 04 then "pith".
    assert_eq(encoding.to_hex(encode_Shape(s)), "0a0470697468")

test "a nested message field is length-prefixed":
    s := empty_shape()
    s.center = Point(x: 150, y: 0)
    # field 5, wire 2: 2a 03 then the Point's 08 96 01.
    assert_eq(encoding.to_hex(encode_Shape(s)), "2a03089601")

test "a repeated scalar field packs its varints":
    s := empty_shape()
    s.tags = [3, 270, 86942]
    # field 7, wire 2, a 6-byte packed payload of three varints.
    assert_eq(encoding.to_hex(encode_Shape(s)), "3a06038e029ea705")

test "unset fields decode back to their defaults":
    back := decode_Shape(encode_Shape(empty_shape()))!
    assert_eq(back.name, "")
    assert_eq(back.id, 0)
    assert(not back.filled)
    assert_eq(back.vertices.len(), 0)
    assert(back.center == none)

fn empty_shape() -> Shape:
    return Shape(name: "", id: 0, filled: false, color: 0, center: none, vertices: [], tags: [], labels: [], blob: bytes.empty(), area: 0.0, offset: 0)

# --- oneof ------------------------------------------------------------------

fn empty_sticker() -> Sticker:
    return Sticker(name: "", design: Sticker_design_unset(), backing: Sticker_backing_unset())

# render each oneof for assertions: the set variant and its payload. these
# also exercise matching the generated enums from another module. (they are
# plain fns because a match binding inside a test block miscompiles today.)
fn show_design(d: StickerDesign) -> String:
    return match d:
        StickerDesign.Emoji(e) => "emoji:{e}"
        StickerDesign.Anchor(p) => "anchor:{p.x},{p.y}"
        StickerDesign.Tint(c) => "tint:{c}"
        StickerDesign.StickerDesignUnset => "unset"

fn show_backing(b: StickerBacking) -> String:
    return match b:
        StickerBacking.Reusable(r) => "reusable:{r}"
        StickerBacking.Stock(n) => "stock:{n}"
        StickerBacking.StickerBackingUnset => "unset"

test "a oneof string member round-trips":
    s := empty_sticker()
    s.design = Sticker_emoji("star")
    back := decode_Sticker(encode_Sticker(s))!
    assert_eq(show_design(back.design), "emoji:star")

test "a oneof message member round-trips":
    s := empty_sticker()
    s.design = Sticker_anchor(Point(x: 3, y: 9))
    back := decode_Sticker(encode_Sticker(s))!
    assert_eq(show_design(back.design), "anchor:3,9")

test "a oneof enum member round-trips":
    s := empty_sticker()
    s.design = Sticker_tint(Color_GREEN)
    back := decode_Sticker(encode_Sticker(s))!
    assert_eq(show_design(back.design), "tint:{Color_GREEN}")

test "an unset oneof encodes nothing and decodes back to unset":
    assert_eq(encoding.to_hex(encode_Sticker(empty_sticker())), "")
    back := decode_Sticker(encode_Sticker(empty_sticker()))!
    assert_eq(show_design(back.design), "unset")
    assert_eq(show_backing(back.backing), "unset")

test "a set oneof member writes even at its zero value":
    # oneof presence: bool false still goes on the wire (field 5, varint 0).
    s := empty_sticker()
    s.backing = Sticker_reusable(false)
    assert_eq(encoding.to_hex(encode_Sticker(s)), "2800")
    back := decode_Sticker(encode_Sticker(s))!
    assert_eq(show_backing(back.backing), "reusable:false")

test "two oneof groups in one message stay independent":
    s := empty_sticker()
    s.design = Sticker_emoji("dot")
    s.backing = Sticker_stock(7)
    back := decode_Sticker(encode_Sticker(s))!
    assert_eq(show_design(back.design), "emoji:dot")
    assert_eq(show_backing(back.backing), "stock:7")

test "the last oneof member on the wire wins":
    # hand-craft bytes carrying two members of the same group: emoji (field 2)
    # then anchor (field 3). proto3 says the later one wins.
    w := writer()
    w.write_string(2, "old")!
    w.write_message(3, encode_Point(Point(x: 5, y: 6)))!
    raw := w.bytes()
    w.free()
    back := decode_Sticker(raw)!
    assert_eq(show_design(back.design), "anchor:5,6")

# --- maps -------------------------------------------------------------------

fn empty_inventory() -> Inventory:
    return Inventory(counts: {}, bins: {}, names: {})

test "an empty map encodes nothing":
    assert_eq(encoding.to_hex(encode_Inventory(empty_inventory())), "")
    back := decode_Inventory(encode_Inventory(empty_inventory()))!
    assert_eq(back.counts.len(), 0)
    assert_eq(back.bins.len(), 0)
    assert_eq(back.names.len(), 0)

test "a single map entry encodes the canonical entry message":
    # field 1, wire 2, a 5-byte entry: key "a" (0a 01 61), value 5 (10 05).
    inv := empty_inventory()
    inv.counts.insert("a", 5)
    assert_eq(encoding.to_hex(encode_Inventory(inv)), "0a050a01611005")

test "a string-keyed map round-trips multiple entries":
    inv := empty_inventory()
    inv.counts.insert("apples", 3)
    inv.counts.insert("pears", 0)
    inv.counts.insert("plums", 12)
    # map iteration order is not fixed, so assert on the decoded contents,
    # not the exact bytes.
    back := decode_Inventory(encode_Inventory(inv))!
    assert_eq(back.counts.len(), 3)
    assert_eq(back.counts["apples"], 3)
    assert_eq(back.counts["pears"], 0)
    assert_eq(back.counts["plums"], 12)

test "a message-valued map round-trips":
    inv := empty_inventory()
    inv.bins.insert("north", Bin(size: 9))
    inv.bins.insert("south", Bin(size: 0))
    back := decode_Inventory(encode_Inventory(inv))!
    assert_eq(back.bins.len(), 2)
    assert_eq(back.bins["north"].size, 9)
    assert_eq(back.bins["south"].size, 0)

test "an int-keyed map round-trips":
    inv := empty_inventory()
    inv.names.insert(7, "seven")
    inv.names.insert(1000, "grand")
    back := decode_Inventory(encode_Inventory(inv))!
    assert_eq(back.names.len(), 2)
    assert_eq(back.names[7], "seven")
    assert_eq(back.names[1000], "grand")

test "a duplicate map key takes the last value":
    # hand-craft two entries for the same key on field 1; proto3 merges map
    # entries with last-one-wins.
    entry1 := writer()
    entry1.write_string(1, "k")!
    entry1.write_int32(2, 1)!
    entry2 := writer()
    entry2.write_string(1, "k")!
    entry2.write_int32(2, 2)!
    w := writer()
    w.write_message(1, entry1.bytes())!
    w.write_message(1, entry2.bytes())!
    raw := w.bytes()
    entry1.free()
    entry2.free()
    w.free()
    back := decode_Inventory(raw)!
    assert_eq(back.counts.len(), 1)
    assert_eq(back.counts["k"], 2)

test "a map entry may omit its key or its value":
    # an entry with only a value means the zero key; an entry with only a
    # key means the zero value.
    only_value := writer()
    only_value.write_int32(2, 9)!
    only_key := writer()
    only_key.write_string(1, "bare")!
    w := writer()
    w.write_message(1, only_value.bytes())!
    w.write_message(1, only_key.bytes())!
    raw := w.bytes()
    only_value.free()
    only_key.free()
    w.free()
    back := decode_Inventory(raw)!
    assert_eq(back.counts.len(), 2)
    assert_eq(back.counts[""], 9)
    assert_eq(back.counts["bare"], 0)

fn has(text: String, needle: String) -> Bool:
    return strings.find_all(text, needle).len() > 0

# wrap a field declaration in `message M { ... }` for parse-error tests.
# (chr because a brace in a string literal would read as interpolation.)
fn proto_message(body: String) -> String:
    return "message M " + chr(123) + " " + body + " " + chr(125)

test "a bool or fixed map key is a parse error":
    bad := parse(proto_message("map<bool, int32> x = 1;"))
    assert(bad.is_err)
    assert(has(bad.err.message, "map key type 'bool'"))
    bad2 := parse(proto_message("map<fixed32, int32> x = 1;"))
    assert(bad2.is_err)
    assert(has(bad2.err.message, "map key type 'fixed32'"))

test "a labeled map or a map-valued map is a parse error":
    bad := parse(proto_message("repeated map<string, int32> x = 1;"))
    assert(bad.is_err)
    bad2 := parse(proto_message("map<string, map<string, int32>> x = 1;"))
    assert(bad2.is_err)
    assert(has(bad2.err.message, "cannot be another map"))

# the service in sample.proto exercises all four rpc shapes; assert the
# generator emits a typed client with the right method signatures and paths.
# (the generated GeometryClient itself is compiled by the sample_gen import
# above, which type-checks the stubs against std.net.grpc.)
test "the geometry service generates typed client stubs":
    read := fs.read("tools/protogen/sample.proto")
    assert(not read.is_err)
    parsed := parse(read.ok)
    assert(not parsed.is_err)
    gen := generate(parsed.ok)
    assert(not gen.is_err)
    out := gen.ok

    # the client wrapper and its unary method, with the full rpc path
    assert(has(out, "pub struct GeometryClient:"))
    assert(has(out, "pub fn Describe(req: Point) -> Shape!grpc.GrpcError:"))
    assert(has(out, "self.conn.unary("))
    assert(has(out, "/sample.Geometry/Describe"))

    # server-streaming: a typed handle with a collect(), reached via server_stream
    assert(has(out, "pub struct GeometryCornersCall:"))
    assert(has(out, "pub fn Corners(req: Shape) -> GeometryCornersCall!grpc.GrpcError:"))
    assert(has(out, "self.conn.server_stream("))
    assert(has(out, "pub fn collect() -> List[Point]!grpc.GrpcError:"))

    # client-streaming: send / close_send / recv_response
    assert(has(out, "pub struct GeometryAssembleCall:"))
    assert(has(out, "self.conn.client_stream("))
    assert(has(out, "pub fn recv_response() -> Shape!grpc.GrpcError:"))

    # bidi: send / close_send / collect
    assert(has(out, "pub struct GeometryReflectCall:"))
    assert(has(out, "self.conn.bidi_stream("))
    assert(has(out, "pub fn send(req: Point) -> Int:"))
