# byte buffers, byte arrays and ecdh key pairs with every free() and close()
# left out.
#
# a ByteBuffer and a ByteArray own runtime storage with no count behind it,
# and an ecdh key pair owns a boxed private key, so until each implemented
# Drop a value that was never freed held its storage for the life of the
# process. the rounds also take the bytes out of one buffer, which frees its
# storage, so the destructor that follows must find nothing left to free.
import leakprobe as probe
import std.bytes as bytes
import std.crypto.ecdh as ecdh

fn round(i: Int) -> Int:
    buf := bytes.buffer_with_capacity(256)
    buf.write_string_utf8("payload-{i}") catch 0

    taken := bytes.buffer()
    taken.write_string_utf8("taken") catch 0
    out := taken.take_bytes()

    arr := bytes.array_filled(64, 7) catch bytes.array()

    mut keys := 0
    if i % 16 == 0:
        pair := ecdh.x25519_keypair()
        if pair.is_ok:
            keys = pair.ok.public_key.len()
    return buf.len() + out.len() + arr.len() + keys

fn main():
    n := probe.rounds()
    mut i := 0
    mut acc := 0
    while i < n:
        acc = acc + round(i)
        i = i + 1
    if acc < 0:
        print("unreachable")
    kb := probe.peak_kb()
    print("{kb}")
