# the other module: same struct name, same function name, different layout
# and different method bodies. registered after samename_fnret_a, so the
# shared global name table's last entry for "parser" is this one.
pub struct Parser:
    pub count: Int
    pub tag: String

impl Parser:
    fn describe() -> String:
        return "b:" + self.tag + ":" + self.count.to_string()

pub fn parser() -> Parser:
    return Parser(3, "second")
