# a List of Lists in a json decode target is refused at the checker: the
# element of a List field is a scalar or a decode-target struct, and a
# nested collection is not read yet (#1110).
import std.json as json

struct Grid:
    pub name: String
    pub cells: List[List[Int]]

fn main():
    r := json.decode_text[Grid]("x")
    if r.is_err:
        print("err")
