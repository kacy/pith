# data_pipeline: filter, transform and aggregate a list of records.
#
# turns a quarter of raw sales lines into a report. each stage is a small
# function built on the list methods (filter, map, reduce) and the grouping
# helpers in std.collections, so the stages read top to bottom and each one
# can be checked on its own.

import std.collections as collections

enum Status:
    Paid
    Refunded
    Pending

struct Sale:
    rep: String
    region: String
    cents: Int
    status: Status

fn quarter() -> List[Sale]:
    return [
        Sale(rep: "alice", region: "north", cents: 120000, status: Status.Paid),
        Sale(rep: "bob", region: "south", cents: 45000, status: Status.Paid),
        Sale(rep: "carol", region: "north", cents: 98000, status: Status.Refunded),
        Sale(rep: "dave", region: "south", cents: 61000, status: Status.Paid),
        Sale(rep: "alice", region: "north", cents: 30500, status: Status.Pending),
        Sale(rep: "erin", region: "west", cents: 150000, status: Status.Paid),
        Sale(rep: "bob", region: "south", cents: 22000, status: Status.Paid),
        Sale(rep: "carol", region: "north", cents: 87000, status: Status.Paid),
]

# only money that has actually arrived counts toward the report
fn is_booked(sale: Sale) -> Bool:
    return match sale.status:
        Status.Paid => true
        Status.Refunded => false
        Status.Pending => false

fn total(sales: List[Sale]) -> Int:
    return sales.reduce(0, fn(sum: Int, sale: Sale) => sum + sale.cents)

fn dollars(cents: Int) -> String:
    return "${cents / 100}"

fn main():
    all_sales := quarter()
    booked := all_sales.filter(is_booked)
    print("{booked.len()} of {all_sales.len()} sales booked, {dollars(total(booked))} in total")

    print("")
    print("by region")
    by_region := collections.group_by(booked, fn(sale: Sale) => sale.region)
    for region in by_region.keys().sort():
        sales := by_region[region]
        average := total(sales) / sales.len()
        print("  {region:<6} {dollars(total(sales)):>8}  avg {dollars(average):>7}  ({sales.len()} booked)")

    print("")
    print("by rep")
    by_rep := collections.group_by(booked, fn(sale: Sale) => sale.rep)
    rep_totals := by_rep.keys().sort().map(fn(rep: String) => (rep, total(by_rep[rep])))
    ranked := collections.sorted_by(rep_totals, fn(a: (String, Int), b: (String, Int)) => a.1 > b.1)
    for entry, index in ranked:
        print("  {index + 1}. {entry.0:<6} {dollars(entry.1):>8}")

    pending := all_sales.filter(fn(sale: Sale) => sale.status == Status.Pending)
    print("")
    print("awaiting payment: {pending.map(fn(sale: Sale) => "{sale.rep} {dollars(sale.cents)}").join(", ")}")
