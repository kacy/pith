# `fn main() -> T!` that returns a failing call's result whole has to report
# the error and exit 1, the way a `fail` or a `!` in main does. the entry
# glue drops what main returns, so this used to exit 0 without a word.
fn load(n: Int) -> Int!:
    if n > 1:
        fail "load {n} failed"
    return n

fn main() -> Int!:
    print("start")
    print("{load(1)!}")
    return load(2)
