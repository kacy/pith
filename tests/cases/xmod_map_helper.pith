# helper for test_xmod_map: build a map here, read it in the caller. an older
# codegen bug returned empty values when a map was read across a module
# boundary (keys survived, values did not).
pub fn build() -> Map[String, Int]:
    mut m: Map[String, Int] := {}
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    return m
