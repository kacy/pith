# counting page views in redis with std.redis.
#
# the client connects, counts visits per page with INCR, remembers the last
# visitor with SET and GET, lists the counters with KEYS, and resets one with
# DEL. so the example runs without a redis server, main first starts a stand-in
# on loopback that answers each command with a recorded reply. against a real
# server, drop the stand-in and point redis.connect at it.

import std.net.tcp as tcp
import std.redis as redis

PORT := 17654

# the replies a real redis would send, in RESP, one per command main sends.
REPLIES := [
    "+PONG\r\n",
    ":1\r\n",
    ":2\r\n",
    ":1\r\n",
    "+OK\r\n",
    "$3\r\nada\r\n",
    "*2\r\n$11\r\nviews:/home\r\n$12\r\nviews:/about\r\n",
    ":1\r\n",
    ":0\r\n",
]

# the stand-in does not parse requests: the client sends them in a known
# order, so answering each with the next recorded reply is enough.
fn stand_in_redis(port: Int) -> Int!:
    listener := tcp.listen("127.0.0.1", port)!
    defer tcp.close(listener)
    conn := tcp.accept(listener)!
    defer tcp.close(conn)
    for reply in REPLIES:
        tcp.read(conn, 4096)!
        tcp.write_all(conn, reply)!
    return REPLIES.len()

# the stand-in accepts exactly one connection, so retry the connect itself
# instead of probing the port first.
fn connect_when_ready(port: Int) -> redis.Client!:
    for attempt in 0..100:
        client := redis.connect("127.0.0.1", port) catch:
            sleep(10)
            continue
        return client
    fail "nothing is listening on port {port}"

fn main() -> Int!:
    server := spawn stand_in_redis(PORT)
    client := connect_when_ready(PORT)!
    defer client.close()

    print("ping: {client.ping()!}")
    for page in ["/home", "/home", "/about"]:
        print("views of {page}: {client.incr("views:{page}")!}")
    client.set("last_visitor", "ada")!
    print("last visitor: {client.get("last_visitor")!}")
    print("counters: {client.keys("views:*")!.join(", ")}")
    print("reset /about: {client.del("views:/about")!} key removed")
    print("/about still counted: {client.exists("views:/about")!}")

    await server
    return 0
