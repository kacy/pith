# recursion: functions that call themselves on a smaller piece of the input.
#
# three classics and a tree walk. gcd and fast power shrink a number each
# call, quicksort splits a list around a pivot and sorts the halves, and a
# directory walk adds up file sizes through any depth of folders. each has a
# base case that stops the recursion; without one it would run until the
# stack ran out.

import std.fmt as fmt

fn gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a
    return gcd(b, a % b)

# squaring halves the exponent, so 2^62 takes about 6 multiplications
fn power(base: Int, exponent: Int) -> Int:
    if exponent == 0:
        return 1
    half := power(base, exponent / 2)
    if exponent % 2 == 0:
        return half * half
    return half * half * base

fn quicksort(items: List[Int]) -> List[Int]:
    if items.len() <= 1:
        return items
    pivot := items[0]
    mut sorted := quicksort(items.filter(fn(item: Int) => item < pivot))
    for item in items.filter(fn(item: Int) => item == pivot):
        sorted.push(item)
    for item in quicksort(items.filter(fn(item: Int) => item > pivot)):
        sorted.push(item)
    return sorted

# a folder holds entries, and an entry is a file or another folder, so the
# type refers to itself. a file's size is its own, and a folder's is the sum
# of everything below it, however deep.
enum Entry:
    File(String, Int)
    Folder(String, List[Entry])

fn total_bytes(entry: Entry) -> Int:
    match entry:
        Entry.File(_, bytes) =>
            return bytes
        Entry.Folder(_, inside) =>
            mut total := 0
            for child in inside:
                total += total_bytes(child)
            return total

fn print_tree(entry: Entry, depth: Int):
    indent := "  ".repeat(depth)
    match entry:
        Entry.File(name, bytes) =>
            print("{indent}{name} ({bytes} bytes)")
        Entry.Folder(name, inside) =>
            print("{indent}{name} ({total_bytes(entry)} bytes)")
            for child in inside:
                print_tree(child, depth + 1)

fn main():
    print("gcd(1071, 462) = {gcd(1071, 462)}")
    print("3^13 = {power(3, 13)}, 2^62 = {power(2, 62)}")
    print("sorted: {fmt.ints(quicksort([38, 27, 43, 3, 9, 82, 10, 27]))}")

    std_dir := Entry.Folder("std/", [Entry.File("io.pith", 3300)])
    src := Entry.Folder("src/", [Entry.File("main.pith", 5100), Entry.File("parser.pith", 12800), std_dir])
    tests := Entry.Folder("tests/", [Entry.File("parser_test.pith", 4100)])
    print_tree(Entry.Folder("project/", [Entry.File("README.md", 2400), src, tests]), 0)
