# ir_control_helpers.pith - statement and control-flow metadata helpers

from ast import get_node, Node

# the two halves of one `if` or `elif` — the condition and the body, as
# arena indices. gathered in one pass so the emitter does not re-walk
# the node's children looking for each part by position.
pub struct IrIfBranch:
    cond_idx: Int
    body_idx: Int

# the names a `for` loop binds: the element, and the index when the
# loop declares one. `index_name` is "" for the common single-binding
# form, which is the check for whether an index slot is needed at all.
pub struct IrForBindingNames:
    value_name: String
    index_name: String

# a binding statement taken apart: the name, the initializer, and the
# written type annotation. `type_idx` is negative when the binding has
# no annotation and its type must come from inferring the initializer.
pub struct IrBindParts:
    name: String
    val_idx: Int
    type_idx: Int

# true for the node kinds that are expressions even when they stand
# alone as a statement, so ir_stmt lowers them through ir_expr and then
# throws the value away. that discard is not free: a bare `spawn` has
# to be detached, a discarded Result has to be freed, and a discarded
# owned string has to be released — ir_stmt does all three, and a kind
# added here without a matching discard rule leaks.
pub fn ir_stmt_is_expr(kind: String) -> Bool:
    if kind == "call" or kind == "method_call" or kind == "spawn":
        return true
    if kind == "await" or kind == "try" or kind == "try_expr":
        return true
    if kind == "catch_expr" or kind == "catch_block":
        return true
    if kind == "select_expr":
        return true
    if kind == "match_expr":
        return true
    return kind == "fail"

# pick the condition and the body out of one arm of an if chain. pass
# the `if` node for the leading arm and an `elif` node for each of the
# rest; the else arm has no condition and is emitted directly instead.
# the condition is the first child that is not a then / else / elif /
# block, the body is the then or block child, and either is -1 when the
# arm does not have one. ir_emit_if_branch reads -1 as "no test",
# emitting the body unconditionally, so a malformed arm falls through
# rather than being rejected here.
pub fn ir_collect_if_branch(node: Node) -> IrIfBranch:
    mut cond_idx := 0 - 1
    mut body_idx := 0 - 1
    for child in node.children:
        cn := get_node(child)
        if cond_idx < 0 and cn.kind != "then" and cn.kind != "else" and cn.kind != "elif" and cn.kind != "block":
            cond_idx = child
        elif cn.kind == "then" or cn.kind == "block":
            body_idx = child
    return IrIfBranch(cond_idx, body_idx)

# split a for statement's loop variables. the parser packs them into
# the node's value as one string, so `for item, i in xs` arrives as
# "item, i" and comes back here as two trimmed names. index_name is ""
# for the one-variable form, which is how the loop emitters tell
# whether an index local has to be materialized. only the first two
# comma-separated names are read; anything after a second comma is
# dropped without complaint.
pub fn ir_for_binding_names(node: Node) -> IrForBindingNames:
    mut value_name := node.value
    mut index_name := ""
    if value_name.contains(","):
        parts := value_name.split(",")
        value_name = parts[0].trim()
        if parts.len() > 1:
            index_name = parts[1].trim()
    return IrForBindingNames(value_name, index_name)

# the bare variable name from a binding node's value. the parser packs
# the declaration's modifiers into that same string as a suffix, so
# `mut x := 1` stores "x mut" and `weak p := q` stores "p weak"; this
# takes them back off. callers that need to know which modifier was
# present test the raw value for " mut" / " weak" themselves, before
# calling this. same rule as ir_binding_name in ir_ast_helpers.
pub fn ir_bind_stmt_name(raw_name: String) -> String:
    mut name := raw_name
    if name.contains(" mut"):
        name = name.substring(0, name.len() - 4)
    elif name.contains(" "):
        name = name.split(" ")[0]
    return name

# take a binding apart into its name, its initializer and its type
# annotation. the annotation is optional and the children carry no
# fixed order, so a type / generic_type / optional_type child is read
# as the annotation and any other child as the initializer; each is -1
# when absent. used for local `bind` statements and for module-level
# globals and threadlocals alike, which is why callers resolve
# type_idx first and only fall back to inferring from val_idx.
pub fn ir_collect_bind_parts(node: Node) -> IrBindParts:
    mut val_idx := 0 - 1
    mut type_idx := 0 - 1
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "type" or cn.kind == "generic_type" or cn.kind == "optional_type":
            type_idx = child
        else:
            val_idx = child
    return IrBindParts(ir_bind_stmt_name(node.value), val_idx, type_idx)
