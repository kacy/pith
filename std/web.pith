# std.web — a small, opinionated web framework.
#
# spin up a server in about ten lines: build an App, hang some routes off it,
# and call listen(). listen() owns the accept loop and runs every connection on
# its own task, so slow clients never block each other. it works the same on the
# green runtime (the default on linux) and on os threads (PITH_GREEN=0).
#
#   import std.web as web
#   import std.net.http as http
#
#   fn main() -> Int!:
#       app := web.new().get("/", fn(req: web.Request) => http.text(200, "hello"))
#       app.listen("0.0.0.0", 8080)!
#       return 0
#
# routes match in the order they are added, first match wins. path patterns take
# `:name` segments (`/users/:id`); the router pulls those out for you, so a
# handler just calls req.param("id"). the response builders live in std.net.http
# (http.text / http.json / http.html / http.not_found_response); web only owns
# the routing and the accept loop.
#
# middleware wraps every matched route in an onion. register it with use_mw();
# the first one registered runs outermost, so it sees the request first and the
# response last. a middleware takes the rest of the chain (`next`) plus the
# request and returns a response, so it can run code before or after next, or
# short-circuit by skipping next entirely:
#
#   fn logging(next: fn(web.Request) -> http.HttpResponse, req: web.Request) -> http.HttpResponse:
#       print(req.method() + " " + req.path())
#       return next(req)
#
#   app := web.new().use_mw(logging).get("/", home)
#
# a server built with new() is observable out of the box: a built-in middleware
# records in-memory metrics for every request (a request counter, an in-flight
# gauge, and a duration histogram, labeled by method and route) and opens a trace
# span that stays a cheap no-op until std.obs is configured. new() also serves
# GET /metrics with the prometheus text of everything std.metrics has collected,
# so you can scrape a pith server with zero instrumentation code. use web.bare()
# when you want the framework and none of that — e.g. a benchmark.

import std.net.http as http
import std.resilience as resilience
import std.net.http2.server as http2server
import std.net.http2.frames as frames
import std.net.http2.hpack as hpack
import std.net.tcp as tcp
import std.net.tls as tls
import std.binary as binary
import std.bytes as bytes
import std.json as json
import std.metrics as metrics
import std.prometheus as prometheus
import std.time as time_mod
import std.log as log
import std.shutdown as shutdown

# how long a connection may sit idle before the server hangs up on it, in
# milliseconds. keeps a stalled client from tying up a task forever.
CONNECTION_TIMEOUT_MS := 5000

# the most connections listen() and listen_tls() serve at once. every connection
# costs a task with a pooled stack plus its buffers, so an accept loop with no
# ceiling lets a client trade cheap sockets for expensive server memory: open
# them faster than they complete and the task count grows without bound. the
# number matches the http/2 server's cap, so the front doors of one program agree
# on what "too many" means.
#
# the budget is per accept loop family, not per process: this bounds the two
# loops web owns (listen and listen_tls, which share the counter below), while
# listen_h2c delegates to std.net.http2.server and is bounded by that module's
# own permits.
MAX_CONNECTIONS := 512

# how many connections the two web accept loops are serving right now, against
# MAX_CONNECTIONS. an AtomicInt rather than a Semaphore on purpose: a semaphore's
# whole point is that acquire() *waits*, and the decision below is that these
# loops must never wait. what is left when the waiting is removed is a counter,
# so that is what this is.
#
# it lives as a module global because the connection task is where the slot is
# given back, so the counter must outlive any one accept loop and be the same
# instance both loops and every connection task see. (it once had to be a global
# because a sync-primitive could not be handed to a spawned task as an argument;
# that is fixed, but a single shared instance is naturally a global.) `mut` is
# only how a global holding a constructed value is declared — the binding is
# never reassigned.
mut live_connections := AtomicInt(0)

# ## what happens at the cap, and why it is not what http/2 does
#
# the http/2 accept loops block: they wait on a permit before accepting again,
# which applies backpressure and lets the kernel backlog absorb the overflow.
# copying that here would be wrong, because the same mechanism has a different
# consequence on the two protocols.
#
# an http/2 connection is a multiplexer. requests arrive on connections that are
# already open, so an accept loop that stops accepting keeps serving requests at
# full rate — including a health check on any established connection. blocking
# costs new peers their connection and nothing else.
#
# http/1.1 has no such decoupling. a request needs a connection, and past the
# first keep-alive burst a new request needs a new accept. an accept loop that
# stops accepting stops answering *everything*: the load balancer's probe, the
# orchestrator's liveness check, `GET /healthz`. the process is then killed for
# being unresponsive at exactly the moment it is healthy and full — and the
# replacement comes up into the same load. worse, a tcp-level probe still
# succeeds against a backlogged listener, so the failure reports itself
# inconsistently depending on how it is measured.
#
# so these loops accept and refuse instead. a refused connection costs one write
# and one close on the accept loop, never a task, so the memory the cap exists to
# protect is still protected. every peer gets an answer of some kind immediately
# rather than a socket that never replies, so a load balancer sheds to another
# instance instead of waiting — and the health check keeps being served, which is
# the whole argument. how much of an answer the peer gets is the one part that is
# not guaranteed; refuse_conn has that.
#
# this also decides how the cap behaves against a connection that stalls forever.
# CONNECTION_TIMEOUT_MS now reclaims such a slot on either backend — the green
# read path reads the socket's own deadline and gives up at it, where it used to
# park on the reactor with no deadline at all and hold the slot for good. so the
# stall is bounded rather than permanent. refusing is still the right answer at
# the cap, because a burst of clients that each stall for the full timeout would
# otherwise queue behind the blocking accept: refusing keeps every peer getting
# an immediate answer, with a refusal counter climbing and the live-connection
# gauge pinned at MAX_CONNECTIONS — which is that situation's exact signature,
# visible on a scrape.

# the accept loops' own metrics, recorded by listen() and listen_tls() rather
# than by the request middleware, so they exist on a bare() app too — a server
# that opted out of per-request observability still needs to know it is turning
# clients away. both are process-wide and unlabeled, because the cap they
# describe is one budget shared by the two loops.
#
#   * OBS_CONNECTIONS pinned at MAX_CONNECTIONS with no requests flowing is a
#     stalled-connection wedge.
#   * OBS_CONNECTIONS_REFUSED climbing is the cap actively shedding load.
OBS_CONNECTIONS := "http_server_connections"
OBS_CONNECTIONS_REFUSED := "http_server_connections_refused_total"

# claim one of the MAX_CONNECTIONS slots, reporting whether there was one free.
# compare_set in a retry loop rather than store(load() + 1): the two web accept
# loops can run in the same process, and a lost increment is a cap that drifts
# upward forever.
fn claim_connection_slot() -> Bool:
    mut settled := false
    while not settled:
        live := live_connections.load()
        if live >= MAX_CONNECTIONS:
            return false
        settled = live_connections.compare_set(live, live + 1)
    metrics.gauge(OBS_CONNECTIONS).add(1.0)
    return true

# give a slot back. every path that takes one pairs with this through a `defer`
# on the connection task, alongside the drain count's `leave()` — a slot that
# leaks lowers the ceiling permanently, and the server wedges hours later with no
# trace of why.
fn release_connection_slot():
    mut settled := false
    while not settled:
        live := live_connections.load()
        settled = live_connections.compare_set(live, live - 1)
    metrics.gauge(OBS_CONNECTIONS).add(0.0 - 1.0)

# what a refused plaintext connection is told. short and fixed: this is written
# by the accept loop, so its cost is paid by every other pending connection.
CAPACITY_BODY := "server at capacity"

# refuse an accepted connection: a complete 503 and a close, written inline on
# the accept loop. no task is spawned, which is the point — spawning one to say
# "no" would cost the memory the cap exists to save. the response is a couple of
# hundred bytes into a fresh socket's send buffer, so the write cannot block even
# against a peer that never reads, and a failure to write is ignored: the client
# is going away either way.
#
# ## the 503 is best-effort, and that is not a hedge
#
# closing a socket that still has unread data in its receive queue sends RST
# rather than FIN, and a client that gets RST discards what it had buffered. so a
# peer that had already sent its request — which is most of them, since a cap
# fires while the accept queue is full of connections that have been waiting —
# may see a reset instead of the 503. draining the request first is what would
# fix it, and there is no way to do that cheaply here. a read on a socket whose
# peer sent nothing can be bounded — a deadline set on the fd is honoured on
# either backend — but the bound is the cost: every refusal would hold the accept
# loop for as long as the slowest silent peer takes to hit it, and a loop that
# never waits is the property this whole design exists to keep.
#
# it is still worth writing. a peer that has not sent yet gets a clean FIN and
# the real 503, and every other peer gets a reset — refused promptly, which is
# the property that matters, and exactly what the tls path gives everyone. the
# response can only improve on the reset, never replace it, so the operator's
# signal is the refusal counter rather than anything the client reports.
fn refuse_conn(fd: Int):
    crlf := chr(13) + chr(10)
    head := "HTTP/1.1 503 Service Unavailable" + crlf + "Content-Type: text/plain" + crlf + "Content-Length: " + CAPACITY_BODY.len().to_string() + crlf + "Retry-After: 1" + crlf + "Connection: close" + crlf + crlf
    tcp.write_all(fd, head + CAPACITY_BODY) catch 0
    tcp_close(fd)
    metrics.counter(OBS_CONNECTIONS_REFUSED).inc()

# refuse an accepted tls connection by closing the socket. there is no 503 to
# send: saying it in http would mean completing a handshake first, and the
# handshake — an asymmetric key exchange and a certificate — is the expensive
# work being refused. a client sees the connection close before its hello is
# answered, which is what any tls front door does when it is out of capacity.
fn refuse_tls_conn(fd: Int):
    tcp_close(fd)
    metrics.counter(OBS_CONNECTIONS_REFUSED).inc()

# an incoming request, handed to every route handler. `raw` is the underlying
# std.net.http request if you need headers, cookies, or the body as bytes;
# `params` holds the path parameters the router pulled out of the pattern; and
# `pattern` is the matched route pattern (e.g. "/users/:id"), which the
# observability middleware uses as a low-cardinality metric label.
pub struct Request:
    pub raw: http.HttpRequestBytes
    pub params: Map[String, String]
    pub pattern: String
    pub values: Map[String, String]

impl Request:
    # a copy of the request with `key` set in its value store. middleware
    # hands data to handlers this way — explicitly, through the request that
    # flows down the chain, rather than through module state:
    #
    #   return next(req.with_value("user", session.subject()))
    fn with_value(key: String, value: String) -> Request:
        mut updated := self.values
        updated.insert(key, value)
        return Request(self.raw, self.params, self.pattern, updated)

    # a value an earlier middleware attached, or "" when nothing did.
    fn value(key: String) -> String:
        if self.values.contains_key(key):
            return self.values[key]
        return ""

    # the value of a path parameter, e.g. req.param("id") for a `/users/:id`
    # route. returns "" when the route has no such parameter.
    fn param(name: String) -> String:
        if self.params.contains_key(name):
            return self.params[name]
        return ""

    # the value of a query-string parameter, or "" when it is absent.
    fn query(name: String) -> String:
        return self.raw.query_param(name) catch ""

    # the value of a query-string parameter, or `fallback` when it is missing
    # or empty. reads cleaner than query() for optional parameters that have a
    # sensible default, e.g. req.query_or("limit", "20").
    fn query_or(name: String, fallback: String) -> String:
        value := self.raw.query_param(name) catch ""
        if value == "":
            return fallback
        return value

    # the value of a request header, or "" when it is absent.
    fn header(name: String) -> String:
        return self.raw.header(name) catch ""

    # true when the request carries a json body, i.e. its Content-Type is
    # application/json. use it to guard a handler before decoding the body.
    fn is_json() -> Bool:
        return self.header("Content-Type").contains("application/json")

    # the request body decoded as text, or "" when there is none.
    fn body() -> String:
        return self.raw.body_text() catch ""

    # the request method, e.g. "GET" or "POST".
    fn method() -> String:
        return self.raw.method() catch "GET"

    # the request path, without the query string.
    fn path() -> String:
        return self.raw.path() catch "/"

# decode the request body as json into a typed struct `T` — the one-liner most
# json handlers reach for. it forwards to json.decode_text, so `T`'s fields must
# be `pub` and the body must be a json object with matching fields; a missing
# field or malformed json comes back as a JsonDecodeError. a handler returns a
# response rather than propagating, so check the result's `.is_err` and answer
# with a 400 instead of using `!`:
#
#   fn create_user(req: web.Request) -> http.HttpResponse:
#       parsed := web.parse[NewUser](req)
#       if parsed.is_err:
#           return http.bad_request_response()
#       return http.json(201, user_json(parsed.ok))
pub fn parse[T](req: Request) -> T!json.JsonDecodeError:
    return json.decode_text[T](req.body())!

# one registered route: a method, a path pattern, and the handler to run when
# both match. the fn-type is written inline on purpose — a type-aliased handler
# field is miscopied when the App builder clones itself.
struct Route:
    method: String
    pattern: String
    handler: fn(Request) -> http.HttpResponse

# a middleware bound to a path prefix by group(): it only wraps requests
# whose path lives under that prefix. the fn-type is written out longhand
# for the same builder-cloning reason as App.middleware.
struct Scoped:
    prefix: String
    mw: fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse

# a web application: an ordered list of routes plus the middleware that wraps
# them. build one with new(), add routes with get/post/put/delete and middleware
# with use_mw (app-wide) or group (bound to a path prefix), then call listen().
#
# the middleware fn-type is written inline here (and everywhere it appears) on
# purpose: a type-aliased fn field is miscopied when the App builder clones
# itself, the same reason Route.handler is written out longhand.
pub struct App:
    routes: List[Route]
    middleware: List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse]
    scoped: List[Scoped]

# a batteries-included App: the default `GET /healthz`, the built-in
# observability middleware wrapping every route (metrics + a per-request trace
# span), and a `GET /metrics` endpoint that serves the prometheus text of
# everything std.metrics has collected. so a server built with new() is
# instrumented and scrapable with no extra code. reach for bare() when you want
# the framework and none of the observability.
pub fn new() -> App:
    metrics_route := fn(req: Request) => prometheus.metrics_response()
    return bare().use_mw(observe).get("/metrics", metrics_route)

# a bare App with only the default `GET /healthz` route: no observability
# middleware and no `/metrics` endpoint, so every request skips the metric
# bookkeeping and the trace span. use it for a benchmark or a minimal server
# where you want the routing and the accept loop and nothing else; new() is the
# opinionated, observable default.
pub fn bare() -> App:
    healthz := fn(req: Request) => http.text(200, "ok")
    return App([Route("GET", "/healthz", healthz)], [], [])

# return a copy of `routes` with `route` appended. building a new list keeps the
# App builder pure: adding a route never mutates an App someone else is holding.
fn with_route(routes: List[Route], route: Route) -> List[Route]:
    mut out: List[Route] := []
    for existing in routes:
        out.push(existing)
    out.push(route)
    return out

# return a copy of `middleware` with `mw` appended, so registering middleware
# never mutates an App someone else is holding. same pure-copy pattern as
# with_route, just for the middleware list.
fn with_mw(middleware: List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse], mw: fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse) -> List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse]:
    mut out: List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse] := []
    for existing in middleware:
        out.push(existing)
    out.push(mw)
    return out

# the pieces the chain runner walks: the middleware list and the route handler at
# the bottom. bundling them in a struct lets the `next` closure below close over
# a single struct value and an index, rather than over the bare middleware and
# handler fn-values. capturing a fn-value held in a variable into a closure once
# miscompiled (the captured name lost its type, so a call through it was mistaken
# for a construction and never invoked); that is fixed and the natural onion fold
# now compiles, but the single-struct capture is kept as the clearer shape —
# `next` closes over one Chain value and an index instead of two bare fn-values.
struct Chain:
    middleware: List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse]
    handler: fn(Request) -> http.HttpResponse

# run the onion from `index` outward. call middleware[index] with a `next` that
# recurses one level deeper; when we run past the end, call the handler. this is
# the recursive form of the fold: the first middleware (index 0) runs outermost
# and the handler sits innermost, which is the ordering use_mw promises.
fn run_chain(chain: Chain, index: Int, req: Request) -> http.HttpResponse:
    if index >= chain.middleware.len():
        return chain.handler(req)
    mw := chain.middleware[index]
    next := fn(r: Request) => run_chain(chain, index + 1, r)
    return mw(next, req)

# wrap `handler` in the middleware onion and return the composed handler. the
# returned closure captures only the Chain struct, so calling it kicks off
# run_chain from the outermost middleware down to the handler.
fn wrap_middleware(middleware: List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse], handler: fn(Request) -> http.HttpResponse) -> fn(Request) -> http.HttpResponse:
    chain := Chain(middleware, handler)
    return fn(req: Request) => run_chain(chain, 0, req)

# the metric names the observability middleware records. they follow the RED
# convention — a request counter (errors show up in the status label), an
# in-flight gauge, and a duration histogram — and match the names
# begin/end_server_span use, so a program that mixes the two sees one metric
# family rather than two.
OBS_REQUESTS_TOTAL := "http_server_requests_total"
OBS_IN_FLIGHT := "http_server_requests_in_flight"
OBS_DURATION_MS := "http_server_duration_ms"

# the built-in observability middleware new() installs on every app. it records
# in-memory RED metrics for each request — labeled by method and route pattern so
# cardinality stays bounded — and opens a server trace span. the metrics are
# always on and need no setup: they accumulate in std.metrics and are scraped at
# GET /metrics. the span is a cheap no-op until std.obs configures tracing, so an
# app that never wires up OTLP pays only the metric bookkeeping.
fn observe(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    method := req.method()
    route := req.pattern
    labels := ["method", method, "route", route]
    started := time_mod.now()
    inflight := metrics.gauge(OBS_IN_FLIGHT).labels(labels)
    inflight.add(1.0)
    span := http.begin_server_span(req.raw)

    resp := next(req)

    http.finish_server_span(span, resp.status)
    inflight.add(0.0 - 1.0)
    elapsed := time_mod.now() - started
    status_label := resp.status.to_string()
    metrics.counter(OBS_REQUESTS_TOTAL).labels(["method", method, "route", route, "status", status_label]).inc()
    metrics.histogram(OBS_DURATION_MS).labels(labels).observe(elapsed.to_float())
    return resp

# a built-in access-log middleware. opt in with app.use_mw(web.access_log): it
# writes one structured line per request to std.log (which goes to stderr) with
# the method, route pattern, path, status, and elapsed time. it is not installed
# by default — metrics and traces carry the observable-by-default story silently,
# while an access log adds a write per request and would clutter an example or
# benchmark, so you turn it on when you want it (the same choice most servers
# make).
pub fn access_log(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    started := time_mod.now()
    resp := next(req)
    elapsed := time_mod.now() - started
    log.root().target("http.access").info().str("method", req.method()).str("route", req.pattern).str("path", req.path()).int("status", resp.status).duration_ms("elapsed_ms", elapsed).msg("request")
    return resp

# a middleware that spends one token from `limiter` per request and answers
# 429 when the bucket is empty. build one limiter and share it — that is the
# point: every serving task drains the same bucket, so the cap holds for the
# whole app no matter how many connections are open.
#
#   limiter := resilience.rate_limiter(100, 20)
#   app := web.new().use_mw(web.rate_limit(limiter)).get("/", home)
#
# scope it to a group to shield one expensive surface:
#   app.group("/search", web.rate_limit(limiter))
pub fn rate_limit(limiter: resilience.Limiter) -> fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse:
    return fn(next: fn(Request) -> http.HttpResponse, req: Request):
        if not limiter.allow():
            return http.response(429).text_body("rate limited")
        return next(req)

# a middleware that runs requests through a circuit breaker: a 5xx from the
# handler counts as a failure, and once the breaker trips, callers get an
# immediate 503 instead of waiting on a downstream that is already drowning.
# the breaker's half-open probe is a real request; its outcome decides
# whether the circuit closes again.
#
#   breaker := resilience.circuit_breaker(5, 10_000)
#   app.group("/reports", web.circuit(breaker))
pub fn circuit(breaker: resilience.Breaker) -> fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse:
    return fn(next: fn(Request) -> http.HttpResponse, req: Request):
        if not breaker.allow():
            return http.response(503).text_body("temporarily unavailable")
        resp := next(req)
        if resp.status >= 500:
            breaker.failure()
        else:
            breaker.success()
        return resp

# the path parameters named in `pattern` (its `:name` segments), pulled out of
# the request's actual path so a handler can read them by name.
fn params_for(pattern: String, req: http.HttpRequestBytes) -> Map[String, String]:
    mut params: Map[String, String] := {}
    for segment in pattern.split("/"):
        if segment.starts_with(":"):
            name := segment.substring(1, segment.len())
            params.insert(name, req.path_param(pattern, name) catch "")
    return params

# true when `path` lives under `prefix`: the prefix itself, or anything
# below it. "/api" scopes "/api" and "/api/me" but not "/apiary".
#
# this compares on path segments, exactly as the router matches routes, so the
# two never disagree. a raw `starts_with` would let "//api/me" — which the
# router collapses to "/api/me" and happily matches a guarded route — slip the
# group guard, because "//api/me" does not start with "/api/". segmenting both
# sides closes that bypass.
fn path_in_scope(path: String, prefix: String) -> Bool:
    prefix_parts := http.path_segments(prefix)
    path_parts := http.path_segments(path)
    if path_parts.len() < prefix_parts.len():
        return false
    mut i := 0
    while i < prefix_parts.len():
        if path_parts[i] != prefix_parts[i]:
            return false
        i = i + 1
    return true

# the middleware onion for `path`: app-wide first, then any group middleware
# whose prefix covers it — so a group guard runs inside the logging and
# metrics that wrap everything.
fn chain_for(app: App, path: String) -> List[fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse]:
    mut chain := app.middleware
    for scope in app.scoped:
        if path_in_scope(path, scope.prefix):
            chain = with_mw(chain, scope.mw)
    return chain

# the methods registered for a path, in registration order, as an `Allow`
# header value. empty when no route matches the path at all.
fn allowed_methods(app: App, req: http.HttpRequestBytes) -> String:
    mut out := ""
    mut seen: List[String] := []
    for route in app.routes:
        matched := req.matches_path(route.pattern) catch false
        if not matched:
            continue
        mut already := false
        for method in seen:
            if method == route.method:
                already = true
        if already:
            continue
        seen.push(route.method)
        if out.len() > 0:
            out = out + ", "
        out = out + route.method
    if out.len() > 0:
        return out + ", OPTIONS"
    return out

# the pattern of the first route that matches this path under any method, so
# a synthesized OPTIONS answer is labeled with the route it is about rather
# than the raw path — the observability middleware uses it as a metric label.
fn pattern_for_path(app: App, req: http.HttpRequestBytes) -> String:
    for route in app.routes:
        matched := req.matches_path(route.pattern) catch false
        if matched:
            return route.pattern
    return ""

# what an OPTIONS request is answered with: 204 and the methods the path
# accepts. it closes over a small struct rather than the bare string for the
# same reason Chain does — a matter of shape now that the closure-capture bug it
# once worked around is fixed.
struct Options:
    allow: String

fn options_handler(options: Options) -> fn(Request) -> http.HttpResponse:
    return fn(req: Request) => http.no_content().header("Allow", options.allow)

# find the first route whose method and path match, wrap its handler in the
# middleware onion, run it, and return the response. a request that matches
# nothing gets a 404 and skips middleware entirely. this is the single place
# every request funnels through, and where the middleware chain wraps in.
fn dispatch(app: App, req: http.HttpRequestBytes) -> http.HttpResponse:
    method := req.method() catch "GET"
    path := req.path() catch "/"
    empty_values: Map[String, String] := {}
    for route in app.routes:
        matched := req.matches_path(route.pattern) catch false
        if route.method == method and matched:
            handler := wrap_middleware(chain_for(app, path), route.handler)
            return handler(Request(req, params_for(route.pattern, req), route.pattern, empty_values))
    # an OPTIONS request to a path that exists under some other method is not
    # a miss. it is either a client asking what the route supports, which
    # deserves an Allow header, or the preflight a browser sends before a
    # cross-origin call — and a preflight that 404s before the middleware runs
    # can never be answered by cors middleware at all.
    if method == "OPTIONS":
        allow := allowed_methods(app, req)
        if allow.len() > 0:
            pattern := pattern_for_path(app, req)
            handler := wrap_middleware(chain_for(app, path), options_handler(Options(allow)))
            return handler(Request(req, params_for(pattern, req), pattern, empty_values))
    return http.not_found_response()

# serve one accepted connection to completion on its own task, then close it.
# errors are swallowed so a broken client only ever affects its own connection.
#
# the drain count and the concurrency slot this releases were both taken at the
# accept, in spawn_conn. `defer` releases them on the error path too — a
# connection that leaks its count holds the whole shutdown open for the full
# grace period, and one that leaks its slot lowers the cap for the life of the
# process.
#
# the slot is given back before the drain count (defers run last-written-first),
# so a drain that reports zero has already returned every slot: the two cannot
# disagree in the window a caller looks at them.
fn handle_conn(app: App, fd: Int):
    defer shutdown.leave()
    defer release_connection_slot()
    tcp_set_timeout(fd, CONNECTION_TIMEOUT_MS)
    http.serve_connection_fd(fd, fn(req: http.HttpRequestBytes) => dispatch(app, req)) catch 0

# hand an accepted socket to its own task, counted in the drain from the moment
# it was accepted — or refuse it, if the server is already at MAX_CONNECTIONS.
#
# the slot is claimed first, and a refusal returns before anything else is taken.
# nothing between the claim and the spawn can fail, so there is no path that
# holds a slot without a task to give it back; the same is true of the drain
# count, which is why the claim is the outer of the two.
#
# ## why the count is taken here and not inside the task
#
# between `spawn` and the spawned task's first instruction the connection is
# invisible: it has not entered, a drain sees nothing outstanding and returns,
# and a client that was accepted moments before the shutdown request gets its
# socket cut with no response and no trace. listen() does not return until every
# connection that got *accepted* has finished — that is the promise. counting
# from the task's first instruction keeps a weaker one, without saying so.
#
# the direction of the remaining error is deliberate. a task that never runs
# holds a count nobody releases, and `drain()` gives up at the grace period and
# returns it as work it abandoned — bounded, and reported. the other direction
# drops a connection silently.
fn spawn_conn(app: App, fd: Int):
    if not claim_connection_slot():
        refuse_conn(fd)
        return
    shutdown.enter()
    spawn handle_conn(app, fd)

# serve one accepted tls connection: native http/2 when the client negotiated
# alpn "h2", http/1.1 over the same tls session otherwise. either way the request
# funnels through dispatch, so routing, middleware, and observability are the same
# as the plaintext listen. the http/2 server closes the conn itself; the http/1.1
# fallback does not, so we close it here. spawned per connection by listen_tls.
fn handle_tls_conn(app: App, conn: tls.Conn):
    if conn.negotiated_protocol() == "h2":
        http2server.serve_h2_tls_connection(conn, fn(req: http.HttpRequestBytes) => dispatch(app, req))
        return
    http.serve_connection_tls(conn, fn(req: http.HttpRequestBytes) => dispatch(app, req)) catch 0
    conn.close()

# handshake an accepted socket and serve it. spawned per connection by
# listen_tls, so the handshake runs here rather than in the accept loop: a client
# that never finishes one only ever costs itself, and a client that fails one
# does not end the loop. tls.handshake closes the socket on its own failure.
fn handshake_and_serve_tls_conn(app: App, listener_handle: Int, fd: Int) -> Bool!:
    handle_tls_conn(app, tls.handshake(tls.listener_from_handle(listener_handle), fd)!)
    return true

# release a tls listener at the end of an accept loop, in the two halves a
# graceful shutdown needs them: std.shutdown owns the socket (closing it is what
# wakes a parked accept during a drain, and it closes at most once), and the tls
# config bound to that socket is dropped here either way.
fn release_tls_listener(listener: tls.Listener):
    shutdown.close_listener(listener.handle)
    tls.release_listener_config(listener)

# the whole of the tls connection, handshake included, under the drain count and
# the concurrency slot taken for it at the accept: a handshake interrupted
# mid-shutdown is still a client waiting, and a handshake that never finishes is
# still a connection occupying the server.
fn handle_tls_socket(app: App, listener_handle: Int, fd: Int):
    defer shutdown.leave()
    defer release_connection_slot()
    handshake_and_serve_tls_conn(app, listener_handle, fd) catch false

# hand an accepted tls socket to its own task, counted in the drain from the
# accept — see spawn_conn for why the count cannot wait for the task to start,
# and for why reaching MAX_CONNECTIONS refuses rather than stalls the loop.
fn spawn_tls_conn(app: App, listener_handle: Int, fd: Int):
    if not claim_connection_slot():
        refuse_tls_conn(fd)
        return
    shutdown.enter()
    spawn handle_tls_socket(app, listener_handle, fd)

impl App:
    # register a GET route. returns a new App, so calls chain:
    # `web.new().get("/", home).get("/users/:id", show)`.
    fn get(pattern: String, handler: fn(Request) -> http.HttpResponse) -> App:
        return App(with_route(self.routes, Route("GET", pattern, handler)), self.middleware, self.scoped)

    # register a POST route. returns a new App.
    fn post(pattern: String, handler: fn(Request) -> http.HttpResponse) -> App:
        return App(with_route(self.routes, Route("POST", pattern, handler)), self.middleware, self.scoped)

    # register a PUT route. returns a new App.
    fn put(pattern: String, handler: fn(Request) -> http.HttpResponse) -> App:
        return App(with_route(self.routes, Route("PUT", pattern, handler)), self.middleware, self.scoped)

    # register a DELETE route. returns a new App.
    fn delete(pattern: String, handler: fn(Request) -> http.HttpResponse) -> App:
        return App(with_route(self.routes, Route("DELETE", pattern, handler)), self.middleware, self.scoped)

    # register a middleware. returns a new App, so calls chain alongside routes.
    # the first middleware registered runs outermost: it sees the request first
    # and the response last. middleware wraps every matched route, including the
    # default `GET /healthz`. a middleware takes `next` (the rest of the chain)
    # and the request, and returns a response:
    #
    #   app := web.new().use_mw(logging).use_mw(auth).get("/", home)
    #
    # here logging wraps auth wraps home.
    fn use_mw(mw: fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse) -> App:
        return App(self.routes, with_mw(self.middleware, mw), self.scoped)

    # bind a middleware to a path prefix: it wraps only the routes that live
    # under that prefix, and runs after (inside) the app-wide middleware. the
    # routes that guard a service usually split into a public handful and a
    # protected rest, and this is that split, spelled at one site:
    #
    #   app := web.new()
    #       .post("/login", login)
    #       .group("/api", require_token)
    #       .get("/api/me", me)
    #
    # `/login` and `/healthz` stay open; everything under `/api` is guarded.
    fn group(prefix: String, mw: fn(fn(Request) -> http.HttpResponse, Request) -> http.HttpResponse) -> App:
        mut out: List[Scoped] := []
        for existing in self.scoped:
            out.push(existing)
        out.push(Scoped(prefix, mw))
        return App(self.routes, self.middleware, out)

    # bind host:port and serve, one task per connection. this blocks, so it is
    # usually the last thing main does; spawn it if you need to keep going.
    #
    # at most MAX_CONNECTIONS connections are served at once. past that the loop
    # keeps accepting and answers 503 immediately rather than stalling, so the
    # server stays reachable — and diagnosable — while it is full;
    # `http_server_connections_refused_total` counts what it turned away.
    #
    # it returns when a graceful shutdown is requested (see std.shutdown): the
    # listener stops accepting, the in-flight connections are given the
    # configured grace period to finish, and the return value is how much work
    # was still unfinished when that period expired — 0 for a clean drain. with
    # no shutdown ever requested this serves forever, as it always did.
    fn listen(host: String, port: Int) -> Int!:
        app := self
        # registering transfers the close to std.shutdown, so a drain and a
        # normal teardown cannot both close the same fd number.
        fd := shutdown.register_listener(tcp_listen(host, port)!)
        # close the listener if the accept loop ever gives up: a listening socket
        # nobody accepts from still passes a tcp health check.
        defer shutdown.close_listener(fd)
        mut failures := 0
        while not shutdown.requested():
            accepted := tcp.accept(fd)
            if accepted.is_err:
                # a shutdown closes the listener out from under this accept,
                # which is how the parked loop is woken promptly. that error is
                # the drain beginning, not a failure to back off from.
                if shutdown.requested():
                    break
                failures = failures + 1
                tcp.back_off_after_accept_failure(failures, accepted.err)!
                continue
            failures = 0
            spawn_conn(app, accepted.ok)
        # free the port before draining, not after: the replacement instance of
        # a rolling deploy is waiting to bind it, and the drain can take the
        # whole grace period. the defer above is then a no-op — close_listener
        # closes at most once — and still covers the error exits.
        shutdown.close_listener(fd)
        return shutdown.drain_default()

    # bind host:port and serve forever over cleartext http/2 (h2c), one task per
    # connection. the whole app runs unchanged — every request funnels through the
    # same dispatch listen uses, so routing, middleware, and observability behave
    # identically, only over http/2. h2c has no tls, so this needs no certificate;
    # reach for listen_tls when you want http/2 with encryption. this blocks, like
    # listen; spawn it if you need to keep going.
    fn listen_h2c(host: String, port: Int) -> Int!:
        app := self
        return http2server.listen_h2c(host, port, fn(req: http.HttpRequestBytes) => dispatch(app, req))!

    # bind host:port and serve forever over tls, negotiating http/2 when the client
    # supports it and falling back to http/1.1 on the same connection otherwise.
    # the listener offers alpn ["h2", "http/1.1"]: a client that selects "h2" is
    # served by the native http/2 server, and anything else (http/1.1, or a client
    # that sends no alpn) is served as http/1.1 over the same tls session. either
    # way every request runs through dispatch, so the app behaves exactly as it
    # does on the plaintext listen. `cert` and `key` are paths to pem files. this
    # blocks, like listen; spawn it if you need to keep going.
    #
    # it shares listen's MAX_CONNECTIONS budget. a connection past the cap is
    # closed before its handshake — the certificate work is the expensive thing
    # being refused, and there is no way to say 503 without doing it first.
    fn listen_tls(host: String, port: Int, cert: String, key: String) -> Int!:
        app := self
        config := tls.server_config(cert, key)!.with_alpn(["h2", "http/1.1"])
        bound := tls.listen(host, port, config)
        if bound.is_err:
            # the bind never happened, so nothing borrowed the config and it is
            # still this call's to close. a server that retries a taken port
            # would otherwise leak a certificate and a key per attempt.
            config.close()
            fail bound.err
        listener := bound.ok
        shutdown.register_listener(listener.handle)
        defer release_tls_listener(listener)
        mut failures := 0
        while not shutdown.requested():
            accepted := tls.accept_socket(listener)
            if accepted.is_err:
                if shutdown.requested():
                    break
                failures = failures + 1
                # a give-up here leaves the config open on purpose: nothing
                # drains on this path, and a task already mid-handshake still
                # reads the certificate and key out of the registry.
                tcp.back_off_after_accept_failure(failures, accepted.err)!
                continue
            failures = 0
            spawn_tls_conn(app, listener.handle, accepted.ok)
        # free the port before draining (see the plaintext listener above), but
        # only the port. the listener's binding to the tls config outlives the
        # accept loop, because a connection accepted a moment before the
        # shutdown has not necessarily reached its handshake yet — and the
        # handshake finds the certificate and the key through that binding.
        shutdown.close_listener(listener.handle)
        drained := shutdown.drain_default()
        # the drain is over, so every connection that borrowed the config has
        # finished with it: drop the listener's binding, then close the config
        # this call built. see docs/tls.md.
        release_tls_listener(listener)
        config.close()
        return drained

# --- tests ---

# a background listen() for tests: swallow the (never-returned) result so it can
# be spawned as a plain call. listen loops forever, so the test process reaps it.
fn serve_bg(app: App, port: Int) -> Int:
    return app.listen("127.0.0.1", port) catch 0

# a minimal GET that returns just the response body (or "" on failure). used to
# drive the server under test without pulling in the whole http client.
fn get_body(port: Int, path: String) -> String:
    connected := tcp.connect("127.0.0.1", port)
    if connected.is_err:
        return ""
    fd := connected.ok
    tcp.set_timeout(fd, 2000)
    crlf := chr(13) + chr(10)
    tcp.write(fd, "GET " + path + " HTTP/1.1" + crlf + "Host: localhost" + crlf + "Connection: close" + crlf + crlf) catch 0
    return read_response_body(fd)

# same as get_body but sends a Content-Type header, so a handler can test what
# req.is_json() makes of the request.
fn get_body_with_content_type(port: Int, path: String, content_type: String) -> String:
    connected := tcp.connect("127.0.0.1", port)
    if connected.is_err:
        return ""
    fd := connected.ok
    tcp.set_timeout(fd, 2000)
    crlf := chr(13) + chr(10)
    tcp.write(fd, "GET " + path + " HTTP/1.1" + crlf + "Host: localhost" + crlf + "Content-Type: " + content_type + crlf + "Connection: close" + crlf + crlf) catch 0
    return read_response_body(fd)

# read a whole response off a socket and return only the body.
fn read_response_body(fd: Int) -> String:
    crlf := chr(13) + chr(10)
    raw := tcp.read(fd, 65536) catch ""
    tcp.close(fd)
    split := raw.index_of(crlf + crlf)
    if split < 0:
        return raw
    return raw.substring(split + 4, raw.len())

# two test middleware that bracket the response body with a fixed marker, so the
# nesting is visible in the output: an outer middleware produces `outer(inner)`.
fn bracket_a(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    return http.text(200, "a(" + (next(req).body_text() catch "?") + ")")

fn bracket_b(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    return http.text(200, "b(" + (next(req).body_text() catch "?") + ")")

# a middleware that answers on its own without calling next, to prove a
# middleware can short-circuit the chain.
fn short_circuit(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    return http.text(200, "blocked")

test "middleware composes as an onion, first registered outermost":
    handler := fn(req: Request) => http.text(200, "core")
    app := new().use_mw(bracket_a).use_mw(bracket_b).get("/", handler)
    port := 18985
    spawn serve_bg(app, port)
    sleep(200)
    # a registered first so it wraps b, which wraps the handler.
    assert_eq(get_body(port, "/"), "a(b(core))")

test "middleware also wraps the default health check":
    app := new().use_mw(bracket_a)
    port := 18986
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/healthz"), "a(ok)")

test "a middleware can short-circuit without calling next":
    app := new().use_mw(short_circuit).get("/", fn(req: Request) => http.text(200, "core"))
    port := 18987
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/"), "blocked")

test "routes match by method and path, params are injected":
    show := fn(req: Request) => http.text(200, "user " + req.param("id"))
    app := new().get("/users/:id", show)
    port := 18981
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/users/42"), "user 42")

test "a fresh app answers its default health check":
    app := new()
    port := 18982
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/healthz"), "ok")

test "an unmatched path returns a 404 body":
    app := new().get("/", fn(req: Request) => http.text(200, "home"))
    port := 18983
    spawn serve_bg(app, port)
    sleep(200)
    assert(get_body(port, "/missing").contains("404"))

test "a trailing slash matches the same route":
    app := new().get("/about", fn(req: Request) => http.text(200, "about"))
    port := 18984
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/about/"), "about")

# echoes a query parameter through query_or so a test can see the fallback.
fn echo_limit(req: Request) -> http.HttpResponse:
    return http.text(200, req.query_or("limit", "20"))

test "query_or returns the value when present and the fallback when not":
    app := new().get("/items", echo_limit)
    port := 18988
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/items?limit=5"), "5")
    assert_eq(get_body(port, "/items"), "20")

# reports whether the request looked like json, so a test can check is_json.
fn echo_is_json(req: Request) -> http.HttpResponse:
    return http.text(200, req.is_json().to_string())

test "is_json is true only for an application/json content type":
    app := new().get("/probe", echo_is_json)
    port := 18989
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body_with_content_type(port, "/probe", "application/json"), "true")
    assert_eq(get_body_with_content_type(port, "/probe", "text/plain"), "false")

# a flat struct for the web.parse tests: json.decode_text fills its pub fields.
struct ParsedUser:
    pub name: String
    pub age: Int

# build a Request carrying `body` as its json body, so the parse tests can run
# without standing up a server. only body() is exercised here, so the rest of the
# request fields are left empty.
fn request_with_body(body: String) -> Request:
    raw := http.HttpRequestBytes(bytes.empty(), bytes.from_string_utf8(body), "POST", "/users", "", "HTTP/1.1", "", body, {}, {}, [])
    return Request(raw, {}, "/users", {})

test "web.parse decodes a valid json body into a typed struct":
    dq := chr(34)
    body := chr(123) + dq + "name" + dq + ":" + dq + "ada" + dq + "," + dq + "age" + dq + ":36" + chr(125)
    parsed := parse[ParsedUser](request_with_body(body))
    assert(parsed.is_ok)
    assert_eq(parsed.ok.name, "ada")
    assert_eq(parsed.ok.age, 36)

test "web.parse reports an error for a malformed json body":
    parsed := parse[ParsedUser](request_with_body("not json"))
    assert(parsed.is_err)

# a trivial handler used by the observability tests.
fn ping(req: Request) -> http.HttpResponse:
    return http.text(200, "pong")

test "the default app serves /metrics and records the request counter":
    app := new().get("/obs-ping", ping)
    port := 18990
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/obs-ping"), "pong")
    assert_eq(get_body(port, "/obs-ping"), "pong")
    # scraping /metrics returns the prometheus text with the auto-recorded counter.
    metrics_text := get_body(port, "/metrics")
    assert(metrics_text.contains("# TYPE http_server_requests_total counter"))
    assert(metrics_text.contains("route=" + chr(34) + "/obs-ping" + chr(34)))

test "a bare app has no observability middleware and no /metrics":
    app := bare().get("/", ping)
    port := 18991
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/"), "pong")
    # bare() registers no /metrics route, so a scrape falls through to a 404.
    assert(get_body(port, "/metrics").contains("404"))

test "metrics are recorded with tracing off, and the span is a no-op":
    # no std.obs.init, so tracing is inactive: the per-request span is a cheap
    # no-op, but the in-memory metrics still increment. this is the
    # observable-by-default guarantee — metrics with zero setup.
    series := ["method", "GET", "route", "/obs-count", "status", "200"]
    before := metrics.counter(OBS_REQUESTS_TOTAL).labels(series).value()
    app := new().get("/obs-count", ping)
    port := 18992
    spawn serve_bg(app, port)
    sleep(200)
    assert_eq(get_body(port, "/obs-count"), "pong")
    after := metrics.counter(OBS_REQUESTS_TOTAL).labels(series).value()
    assert_eq(after - before, 1.0)

# --- http/2 (h2c) tests ---
#
# these serve a real web.App over cleartext http/2 and drive it with the tiny
# h2c client below, proving the whole routing/middleware stack answers the same
# over http/2 as it does over http/1.1. the client speaks just enough http/2 for
# one request: the connection preface, an empty SETTINGS frame, and a GET as a
# single HEADERS frame; it then reads response frames until the stream ends and
# returns the DATA payload as the body.

H2C_PREFACE := "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

# a background listen_h2c() for tests: swallow the (never-returned) result so it
# can be spawned as a plain call, exactly like serve_bg does for listen.
fn serve_h2c_bg(app: App, port: Int) -> Int:
    return app.listen_h2c("127.0.0.1", port) catch 0

# a framed reader over a tcp fd: buffer bytes and slice out one whole frame at a
# time, pulling more from the socket when the buffer is short (a frame can span
# reads). the same shape the server's ServerConn uses to read frames.
struct FrameStream:
    mut fd: Int
    mut buf: Bytes
    mut pos: Int

impl FrameStream:
    fn fill(n: Int) -> Int!:
        while self.buf.len() - self.pos < n:
            chunk := tcp_read_bytes(self.fd, 16384)!
            if chunk.len() == 0:
                fail "h2c client: connection closed"
            self.buf = bytes.concat(self.buf.slice(self.pos, self.buf.len()), chunk)
            self.pos = 0
        return 0

    fn next_frame() -> frames.Frame!:
        self.fill(9)!
        length_res := binary.read_u24_be_at(self.buf, self.pos)
        if length_res.is_err:
            fail length_res.err.message
        total := 9 + length_res.ok
        self.fill(total)!
        full := self.buf.slice(self.pos, self.pos + total)
        self.pos = self.pos + total
        return frames.read_frame(binary.reader(full), frames.MAX_ALLOWED_FRAME_SIZE)!

# send the preface, an empty SETTINGS, and a bodiless GET as one HEADERS frame
# (END_STREAM + END_HEADERS). :authority is a fixed "localhost" — the app does
# not route on it.
fn send_h2c_get(fd: Int, path: String) -> Int!:
    tcp.write_all_bytes(fd, bytes.from_string_utf8(H2C_PREFACE))!
    no_settings: List[frames.Setting] := []
    tcp.write_all_bytes(fd, frames.frame_bytes(frames.settings_frame(no_settings)!)!)!
    encoder := hpack.new_encoder(hpack.DEFAULT_HEADER_TABLE_SIZE, false)
    fields := [hpack.header_field(":method", "GET"), hpack.header_field(":path", path), hpack.header_field(":scheme", "http"), hpack.header_field(":authority", "localhost")]
    block := encoder.encode(fields)
    tcp.write_all_bytes(fd, frames.frame_bytes(frames.headers_frame(1, block, true, true))!)!
    return 0

# read response frames until stream 1 ends, returning the DATA payload as text.
# the server's SETTINGS and WINDOW_UPDATE housekeeping is ignored — a single
# short-lived request need not ack it.
fn read_h2c_body(fd: Int) -> String:
    stream := FrameStream(fd, bytes.empty(), 0)
    body := bytes.buffer()
    while true:
        attempt := stream.next_frame()
        if attempt.is_err:
            break
        frame := attempt.ok
        t := frame.header.frame_type
        if t == frames.FRAME_HEADERS:
            parsed := frames.parse_headers(frame)
            if parsed.is_ok and parsed.ok.end_stream:
                break
        elif t == frames.FRAME_DATA:
            data := frames.parse_data(frame)
            if data.is_ok:
                body.write(data.ok.data) catch 0
                if data.ok.end_stream:
                    break
        elif t == frames.FRAME_GOAWAY:
            break
    result := body.bytes()
    body.free()
    return result.to_string_utf8() catch ""

# GET `path` from an h2c server on `port` and return the response body, or "" on
# any connection error. mirrors get_body's role for the http/1.1 tests.
fn h2c_get_body(port: Int, path: String) -> String:
    connected := tcp.connect("127.0.0.1", port)
    if connected.is_err:
        return ""
    fd := connected.ok
    tcp.set_timeout(fd, 2000)
    send_h2c_get(fd, path) catch 0
    body := read_h2c_body(fd)
    tcp.close(fd)
    return body

test "a web.App served over h2c routes a param path":
    show := fn(req: Request) => http.text(200, "user " + req.param("id"))
    app := new().get("/users/:id", show)
    port := 18993
    spawn serve_h2c_bg(app, port)
    sleep(200)
    assert_eq(h2c_get_body(port, "/users/42"), "user 42")

test "a web.App served over h2c answers the default health check":
    app := new()
    port := 18994
    spawn serve_h2c_bg(app, port)
    sleep(200)
    assert_eq(h2c_get_body(port, "/healthz"), "ok")

test "a web.App served over h2c returns a 404 body for an unmatched path":
    app := new().get("/", fn(req: Request) => http.text(200, "home"))
    port := 18995
    spawn serve_h2c_bg(app, port)
    sleep(200)
    assert(h2c_get_body(port, "/missing").contains("404"))

# a bare request for dispatch, so the routing tests below need no socket at
# all. only the method and path are read on this path.
fn request_for(method: String, path: String) -> http.HttpRequestBytes:
    return http.HttpRequestBytes(bytes.empty(), bytes.empty(), method, path, "", "HTTP/1.1", "", "", {}, {}, [])

fn show_user(req: Request) -> http.HttpResponse:
    return http.text(200, "user " + req.param("id"))

fn create_user(req: Request) -> http.HttpResponse:
    return http.text(201, "created")

test "OPTIONS on a known path answers with the methods that path accepts":
    app := bare().get("/users/:id", show_user).post("/users/:id", create_user)
    resp := dispatch(app, request_for("OPTIONS", "/users/42"))

    assert_eq(resp.status, 204)
    assert_eq(resp.header_value("Allow"), "GET, POST, OPTIONS")

test "OPTIONS on a path no route claims is still a 404":
    app := bare().get("/users/:id", show_user)
    resp := dispatch(app, request_for("OPTIONS", "/orders/42"))

    assert_eq(resp.status, 404)

test "the synthesized OPTIONS answer runs through the middleware chain":
    # this is what makes cors preflight reachable: without it an OPTIONS
    # request would 404 before any middleware got to look at it.
    app := bare().use_mw(bracket_a).get("/about", show_user)
    resp := dispatch(app, request_for("OPTIONS", "/about"))

    assert_eq(resp.body_text()!, "a()")

fn deny_group(next: fn(Request) -> http.HttpResponse, req: Request) -> http.HttpResponse:
    return http.text(401, "blocked")

test "a group guard is not bypassed by a leading or doubled empty path segment":
    # the router collapses empty segments, so "//api/items" and "/api//items"
    # both reach the guarded handler; the scope check must collapse them too or
    # the group guard is skipped.
    app := bare().group("/api", deny_group).get("/api/items", show_user)
    assert_eq(dispatch(app, request_for("GET", "/api/items")).status, 401)
    assert_eq(dispatch(app, request_for("GET", "//api/items")).status, 401)
    assert_eq(dispatch(app, request_for("GET", "/api//items")).status, 401)
    # a path genuinely outside the group is still unguarded.
    open_app := bare().group("/api", deny_group).get("/items", show_user)
    assert_eq(dispatch(open_app, request_for("GET", "/items")).status, 200)

test "a group guard also wraps the synthesized OPTIONS answer":
    app := bare().group("/api", bracket_b).get("/api/items", show_user)
    resp := dispatch(app, request_for("OPTIONS", "/api/items"))

    assert_eq(resp.body_text()!, "b()")
    # a path outside the group is not wrapped by it.
    outside := dispatch(bare().group("/api", bracket_b).get("/items", show_user), request_for("OPTIONS", "/items"))
    assert_eq(outside.status, 204)

fn always_pong(req: Request) -> http.HttpResponse:
    return http.text(200, "pong")

fn always_broken(req: Request) -> http.HttpResponse:
    return http.server_error_response()

test "the rate limit middleware answers 429 once the bucket is empty":
    limiter := resilience.rate_limiter(50, 2)
    guarded := rate_limit(limiter)
    req := request_with_body("")

    assert_eq(guarded(always_pong, req).status, 200)
    assert_eq(guarded(always_pong, req).status, 200)
    assert_eq(guarded(always_pong, req).status, 429)
    # 50/s refills a token every 20 ms; wait comfortably past one.
    sleep(60)
    assert_eq(guarded(always_pong, req).status, 200)

test "the circuit middleware trips on 5xx and recovers through its probe":
    breaker := resilience.circuit_breaker(2, 40)
    shielded := circuit(breaker)
    req := request_with_body("")

    assert_eq(shielded(always_broken, req).status, 500)
    assert_eq(shielded(always_broken, req).status, 500)
    # tripped: the handler is no longer reached.
    assert_eq(shielded(always_pong, req).status, 503)
    sleep(60)
    # the half-open probe is a real request; a 200 closes the circuit.
    assert_eq(shielded(always_pong, req).status, 200)
    assert_eq(shielded(always_pong, req).status, 200)

# --- accept-time drain registration ---
#
# these drive spawn_conn / spawn_tls_conn directly, over real sockets and
# without an accept loop, so the drain count can be read in the window between
# the spawn and the task's first instruction — the window the count exists to
# cover. an accept loop's only other job is tcp.accept, which is what these do
# by hand.

# open `count` connected socket pairs against a listener on `port` and return the
# server-side fds. the client ends go onto `clients` so the test can close them
# and let the connection tasks finish.
fn accepted_pairs(port: Int, count: Int, clients: List[Int]) -> List[Int]:
    listener := tcp_listen("127.0.0.1", port) catch -1
    assert(listener > 0)
    mut served: List[Int] := []
    mut i := 0
    while i < count:
        connected := tcp.connect("127.0.0.1", port)
        assert(not connected.is_err)
        clients.push(connected.ok)
        accepted := tcp.accept(listener)
        assert(not accepted.is_err)
        served.push(accepted.ok)
        i = i + 1
    tcp_close(listener)
    return served

test "an accepted connection is in the drain count before its task runs":
    shutdown.reset()
    app := new().get("/", always_pong)
    mut clients: List[Int] := []
    served := accepted_pairs(18991, 8, clients)
    for fd in served:
        spawn_conn(app, fd)
    # taken on this task, so the count is complete the instant the last hand-off
    # returns, however many of the eight tasks have actually started. with the
    # count taken inside the task, most of these are invisible here — and a
    # shutdown landing now would report a clean drain over eight clients that
    # were accepted and never answered.
    assert_eq(shutdown.inflight(), 8)
    # nothing can finish while the peers hold their sockets open and send
    # nothing, so a drain gives up at its deadline and reports all eight.
    assert_eq(shutdown.drain(20), 8)
    for c in clients:
        tcp_close(c)
    # every task leaves exactly once, including on this path where the request
    # never arrived: no double count and nothing left behind.
    assert_eq(shutdown.drain(5000), 0)
    assert_eq(shutdown.inflight(), 0)
    shutdown.reset()

test "an accepted tls connection is in the drain count before its handshake starts":
    shutdown.reset()
    app := new().get("/", always_pong)
    config := tls.server_config("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.with_alpn(["h2", "http/1.1"])
    bound := tls.listen("127.0.0.1", 18992, config)
    assert(not bound.is_err)
    listener := bound.ok
    mut clients: List[Int] := []
    mut served: List[Int] := []
    mut i := 0
    while i < 4:
        # plain tcp peers that never send a client hello: every handshake parks
        # on its first read, so no task can reach its `leave`.
        connected := tcp.connect("127.0.0.1", 18992)
        assert(not connected.is_err)
        clients.push(connected.ok)
        accepted := tls.accept_socket(listener)
        assert(not accepted.is_err)
        served.push(accepted.ok)
        i = i + 1
    for fd in served:
        spawn_tls_conn(app, listener.handle, fd)
    # a connection still mid-handshake when a shutdown lands is a client waiting
    # for an answer, so it counts from the accept like any other.
    assert_eq(shutdown.inflight(), 4)
    for c in clients:
        tcp_close(c)
    # the handshakes fail once their peers are gone, and that path leaves the
    # count exactly once too.
    assert_eq(shutdown.drain(5000), 0)
    assert_eq(shutdown.inflight(), 0)
    release_tls_listener(listener)
    config.close()
    shutdown.reset()

# --- the concurrent-connection cap ---
#
# these drive spawn_conn directly, like the drain tests above, so the accept
# loop's decision at the cap can be read without an accept loop and without
# waiting for one to bind. the cap is MAX_CONNECTIONS, and holding that many real
# sockets open would cost more file descriptors than a test should: instead the
# counter is filled to one below the cap through the same claim these loops use,
# so the two connections that follow straddle it exactly.

# take `n` slots the way an accept loop would, asserting each one is granted.
fn hold_connection_slots(n: Int):
    mut taken := 0
    while taken < n:
        assert(claim_connection_slot())
        taken = taken + 1

# hand `n` slots back, undoing hold_connection_slots.
fn drop_connection_slots(n: Int):
    mut given := 0
    while given < n:
        release_connection_slot()
        given = given + 1

# send a request on an already-connected socket and return the response body.
# the peer is a socket this test accepted itself, so there is nothing to connect.
fn request_on(fd: Int, path: String) -> String:
    crlf := chr(13) + chr(10)
    tcp.write(fd, "GET " + path + " HTTP/1.1" + crlf + "Host: localhost" + crlf + "Connection: close" + crlf + crlf) catch 0
    return read_response_body(fd)

# read whatever a refused peer was sent, head included. the refusal is one small
# write followed by a close, so a single read gets all of it and there is nothing
# to wait for.
fn read_raw_response(fd: Int) -> String:
    raw := tcp.read(fd, 65536) catch ""
    tcp.close(fd)
    return raw

test "at the connection cap the accept loop refuses instead of blocking, and serves again after":
    shutdown.reset()
    app := new().get("/", always_pong)
    baseline := live_connections.load()
    hold_connection_slots(MAX_CONNECTIONS - 1 - baseline)
    mut clients: List[Int] := []
    served := accepted_pairs(19010, 2, clients)
    refused_before := metrics.counter(OBS_CONNECTIONS_REFUSED).value()

    # the last free slot: admitted, and it becomes a task counted in the drain.
    spawn_conn(app, served[0])
    assert_eq(shutdown.inflight(), 1)
    # one past the cap. the hand-off returns rather than parking on a permit —
    # if it blocked, this test would never reach the next line, which is the
    # whole difference from what the http/2 loops do.
    spawn_conn(app, served[1])
    # no second task, and no second place in the drain: the refusal cost a write
    # and a close on this task.
    assert_eq(shutdown.inflight(), 1)
    assert_eq(metrics.counter(OBS_CONNECTIONS_REFUSED).value() - refused_before, 1.0)

    # the refused client is told why, in http. it has sent nothing, so its
    # receive queue is empty and the close is a clean FIN — the case where the
    # 503 survives. a peer that had already sent a request gets a reset instead;
    # see refuse_conn on why that cannot be helped from here.
    refusal := read_raw_response(clients[1])
    assert(refusal.contains("503 Service Unavailable"))
    assert(refusal.contains(CAPACITY_BODY))
    # the admitted one is served normally, at the same moment.
    assert_eq(request_on(clients[0], "/"), "pong")
    assert_eq(shutdown.drain(5000), 0)

    # with the held slots given back the cap is whole again, and the next
    # connection is admitted rather than refused — the cap sheds load, it does
    # not latch.
    drop_connection_slots(MAX_CONNECTIONS - 1 - baseline)
    assert_eq(live_connections.load(), baseline)
    mut after_clients: List[Int] := []
    after := accepted_pairs(19011, 1, after_clients)
    spawn_conn(app, after[0])
    assert_eq(shutdown.inflight(), 1)
    assert_eq(request_on(after_clients[0], "/"), "pong")
    assert_eq(shutdown.drain(5000), 0)
    assert_eq(live_connections.load(), baseline)
    shutdown.reset()

test "a finished connection gives its slot back, so a burst does not ratchet the cap down":
    shutdown.reset()
    app := new().get("/", always_pong)
    baseline := live_connections.load()
    mut clients: List[Int] := []
    served := accepted_pairs(19012, 6, clients)
    for fd in served:
        spawn_conn(app, fd)
    # claimed on this task, before the spawn, so the count is exact here however
    # many of the six tasks have started.
    assert_eq(live_connections.load() - baseline, 6)
    for c in clients:
        assert_eq(request_on(c, "/"), "pong")
    # every task ran its defers: the drain reporting zero is the ordering
    # guarantee that the slots went back first. this is the leak case — a slot
    # kept here is a cap that shrinks with every burst until the server refuses
    # everything, hours later, with nothing to point at.
    assert_eq(shutdown.drain(5000), 0)
    assert_eq(live_connections.load(), baseline)
    shutdown.reset()

# connect to a tls listener over plain tcp and accept the socket, without sending
# a client hello: the handshake, if one is reached at all, parks on its first
# read. returns the client fd and the accepted server fd.
fn tls_socket_pair(listener: tls.Listener, port: Int, clients: List[Int]) -> Int:
    connected := tcp.connect("127.0.0.1", port)
    assert(not connected.is_err)
    clients.push(connected.ok)
    accepted := tls.accept_socket(listener)
    assert(not accepted.is_err)
    return accepted.ok

test "a tls connection holds a slot through its handshake and is refused past the cap":
    shutdown.reset()
    app := new().get("/", always_pong)
    config := tls.server_config("tests/live/fixtures/localhost.crt", "tests/live/fixtures/localhost.key")!.with_alpn(["h2", "http/1.1"])
    bound := tls.listen("127.0.0.1", 19013, config)
    assert(not bound.is_err)
    listener := bound.ok
    baseline := live_connections.load()

    # an admitted tls connection occupies a slot from the accept, before its
    # handshake has read a byte — a client that never completes one is still a
    # connection the server is carrying.
    mut clients: List[Int] := []
    spawn_tls_conn(app, listener.handle, tls_socket_pair(listener, 19013, clients))
    assert_eq(live_connections.load() - baseline, 1)
    assert_eq(shutdown.inflight(), 1)
    # the handshake fails once its peer is gone, and that path gives the slot
    # back like any other — the failure path is the one that matters here,
    # because it is the one a hostile client picks.
    tcp_close(clients[0])
    assert_eq(shutdown.drain(5000), 0)
    assert_eq(live_connections.load(), baseline)

    # now full. the next connection is closed rather than handshaked.
    hold_connection_slots(MAX_CONNECTIONS - baseline)
    mut refused_clients: List[Int] := []
    server_fd := tls_socket_pair(listener, 19013, refused_clients)
    refused_before := metrics.counter(OBS_CONNECTIONS_REFUSED).value()
    spawn_tls_conn(app, listener.handle, server_fd)
    # no task, no drain count, and no handshake — the certificate work is exactly
    # what the cap is refusing to spend.
    assert_eq(shutdown.inflight(), 0)
    assert_eq(metrics.counter(OBS_CONNECTIONS_REFUSED).value() - refused_before, 1.0)
    # the peer sees end-of-stream rather than a server hello.
    assert_eq(read_raw_response(refused_clients[0]), "")
    drop_connection_slots(MAX_CONNECTIONS - baseline)
    assert_eq(live_connections.load(), baseline)
    release_tls_listener(listener)
    config.close()
    shutdown.reset()
