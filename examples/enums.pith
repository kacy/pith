# enums: tag-only enums with methods, and variants that carry data.
#
# drives a warehouse robot around a grid. a Heading has no payload and gets
# its behavior from methods; a Command carries whatever data its variant
# needs, and match takes it apart. the checker rejects a match that misses
# a variant, so adding a command means the compiler lists every place to
# update.

enum Heading:
    North
    East
    South
    West

impl Heading:
    fn turn_right() -> Heading:
        return match self:
            Heading.North => Heading.East
            Heading.East => Heading.South
            Heading.South => Heading.West
            Heading.West => Heading.North

    fn turn_left() -> Heading:
        return self.turn_right().turn_right().turn_right()

    # one grid step in this direction, as (dx, dy)
    fn step() -> (Int, Int):
        return match self:
            Heading.North => (0, 1)
            Heading.East => (1, 0)
            Heading.South => (0, -1)
            Heading.West => (-1, 0)

    fn name() -> String:
        return match self:
            Heading.North => "north"
            Heading.East => "east"
            Heading.South => "south"
            Heading.West => "west"

enum Command:
    Forward(Int)
    Left
    Right
    Jump(Int, Int)

struct Robot:
    x: Int
    y: Int
    heading: Heading

fn run(robot: Robot, command: Command):
    match command:
        Command.Forward(steps) =>
            step := robot.heading.step()
            robot.x += step.0 * steps
            robot.y += step.1 * steps
        Command.Left =>
            robot.heading = robot.heading.turn_left()
        Command.Right =>
            robot.heading = robot.heading.turn_right()
        Command.Jump(x, y) =>
            robot.x = x
            robot.y = y

fn describe(command: Command) -> String:
    return match command:
        Command.Forward(steps) => "forward {steps}"
        Command.Left => "turn left"
        Command.Right => "turn right"
        Command.Jump(x, y) => "jump to ({x}, {y})"

fn main():
    robot := Robot(x: 0, y: 0, heading: Heading.North)
    program := [Command.Forward(3), Command.Right, Command.Forward(2), Command.Jump(10, 10), Command.Left, Command.Left, Command.Forward(4)]
    for command in program:
        run(robot, command)
        print("{describe(command):<16} at ({robot.x}, {robot.y}) facing {robot.heading.name()}")
