# stdlib_rand: seeded random numbers with std.rand.
#
# draws the winners of an office raffle. the generator is seeded, so the same
# seed gives the same draw on every run: that is what makes a draw you can
# publish and someone else can check. shuffle, sample and choice pick from
# lists; int, roll and chance cover numbers; string makes a claim code.

import std.fmt as fmt
import std.rand as rand

struct Draw:
    winners: List[Int]
    grand_prize: String
    claim_code: String

fn draw(seed: Int, tickets: List[Int], prizes: List[String]) -> Draw:
    rand.seed(seed)
    winners := rand.sample(tickets, 3)
    return Draw(winners: winners, grand_prize: rand.choice_string(prizes), claim_code: rand.string(8))

fn main():
    tickets := [101, 102, 103, 104, 105, 106, 107, 108, 109, 110]
    prizes := ["bicycle", "headphones", "coffee machine", "day off"]

    first := draw(2026, tickets, prizes)
    print("seed 2026 winners: {fmt.ints(first.winners)}")
    print("grand prize:       {first.grand_prize}")
    print("claim code length: {first.claim_code.len()}")

    # anyone with the seed can repeat the draw and get the same result
    again := draw(2026, tickets, prizes)
    same := fmt.ints(again.winners) == fmt.ints(first.winners) and again.claim_code == first.claim_code
    print("repeat with seed 2026 matches: {same}")
    other := draw(7, tickets, prizes)
    print("seed 7 winners:    {fmt.ints(other.winners)}")

    # the seating order for the prize table
    rand.seed(2026)
    print("")
    print("seating order: {fmt.ints(rand.shuffle([1, 2, 3, 4, 5, 6]))}")

    # a tie for the last prize goes to dice, rerolled until someone wins
    mut rounds := 0
    mut alice := 0
    mut bob := 0
    while alice == bob:
        alice = rand.roll(6)
        bob = rand.roll(6)
        rounds += 1
    winner := if alice > bob: "alice" else: "bob"
    print("tie-break: alice {alice}, bob {bob} after {rounds} round(s), {winner} wins")

    # chance(30) is true about 30% of the time; over many trials it settles
    mut hits := 0
    for trial in 0..1000:
        if rand.chance(30):
            hits += 1
    print("chance(30) over 1000 trials: {hits} hits")
    print("door prize goes to ticket {rand.int(101, 110)}")
