pub mut ir_global_int_names: List[String] := []
pub mut ir_global_string_names: List[String] := []
pub mut ir_global_list_string_names: List[String] := []
pub mut ir_global_list_names: List[String] := []
pub mut ir_global_map_names: List[String] := []
pub mut ir_global_map_int_names: List[String] := []
pub mut ir_global_map_value_types: Map[String, String] := {}
pub mut ir_global_set_names: List[String] := []
pub mut ir_global_set_int_names: List[String] := []
pub mut ir_global_bool_names: List[String] := []
## file a global under its emission kind for per-function seeding.
pub fn ir_record_global_type(name: String, global_type: String):
    if global_type == "int":
        ir_global_int_names = ir_push_string(ir_global_int_names, name)
    elif global_type == "string":
        ir_global_string_names = ir_push_string(ir_global_string_names, name)
    elif global_type == "list_string":
        ir_global_list_string_names = ir_push_string(ir_global_list_string_names, name)
    elif global_type == "list":
        ir_global_list_names = ir_push_string(ir_global_list_names, name)
    elif global_type == "map_int":
        ir_global_map_int_names = ir_push_string(ir_global_map_int_names, name)
    elif global_type == "map":
        ir_global_map_names = ir_push_string(ir_global_map_names, name)
    elif global_type == "set":
        ir_global_set_names = ir_push_string(ir_global_set_names, name)
    elif global_type == "set_int":
        ir_global_set_int_names = ir_push_string(ir_global_set_int_names, name)
    elif global_type == "bool":
        ir_global_bool_names = ir_push_string(ir_global_bool_names, name)

# Substitute a type-name string using the active impl substitution map. If the
# name matches one of the struct's generic parameters (in ir_current_impl_subst_params)
# the corresponding concrete type name is returned; otherwise the input is
# returned unchanged. Used when emitting specialized impl method bodies.

pub mut ir_active_generic_params: List[String] := []
pub mut ir_active_generic_concrete_types: List[String] := []
pub mut ir_active_generic_module_path := ""

## Per-specialization map from parameter name to the concrete Optional tid
## of that parameter (only params whose substituted type is Optional[X] get
## an entry). Empty outside a generic specialization. Used by the binop
## path to recover Optional-ness after check-time saw only the un-
## specialized generic tid — arg tids are threaded through the spec
## pipeline via `ir_record_generic_spec_arg_tids`, decoded at spec entry,
## and looked up here.
pub mut ir_active_param_optional_tids: Map[String, Int] := {}

## resolve a type annotation node to an emission kind, honoring
## any active generic substitution.
pub fn ir_resolve_type_node(type_idx: Int) -> String:
    if ir_active_generic_params.len() > 0:
        resolved := ir_resolve_type_node_with_subst(type_idx, ir_active_generic_params, ir_active_generic_concrete_types)
        if resolved.len() > 0:
            return resolved
    tn := get_node(type_idx)
    if tn.kind == "type":
        return ir_resolve_type_hint(tn.value)
    if tn.kind == "generic_type":
        generic_type := ir_resolve_generic_type_node(tn)
        if generic_type.len() > 0:
            return generic_type
        return ir_resolve_type_hint(tn.value)
    if tn.kind == "result_type" and tn.children.len() > 0:
        inner_type := ir_resolve_type_node(tn.children[0])
        return ir_resolve_result_type_kind(inner_type)
    if tn.kind == "optional_type" and tn.children.len() > 0:
        return "tuple"
    if tn.kind == "fn_type":
        return "closure"
    if tn.kind == "tuple_type":
        return "tuple"
    return ""

## a map annotation's value-type kind, or "".
pub fn ir_resolve_map_value_type_node(type_idx: Int) -> String:
    tn := get_node(type_idx)
    if tn.kind == "generic_type" and tn.value == "Map" and tn.children.len() > 1:
        if ir_active_generic_params.len() > 0:
            return ir_resolve_type_node_with_subst(tn.children[1], ir_active_generic_params, ir_active_generic_concrete_types)
        return ir_resolve_type_node(tn.children[1])
    return ""

pub mut ir_type_aliases: Map[String, String] := {} # alias name -> target type
pub mut ir_import_renames: Map[String, String] := {}
pub mut ir_module_aliases: Map[String, String] := {}
pub mut ir_import_declared_functions: Map[String, Bool] := {}
pub mut ir_import_declared_globals: Map[String, Bool] := {}

## resolve a type name through aliases to an emission hint.
pub fn ir_resolve_type_hint(type_name: String) -> String:
    return ir_resolve_type_hint_with_state(type_name, ir_type_aliases, ir_struct_names)

## names a closure may not capture: aliases and import renames.
pub fn ir_capture_blocked_names() -> Map[String, Bool]:
    mut blocked: Map[String, Bool] := {}
    for name in ir_module_aliases.keys():
        blocked.insert(name, true)
    for name in ir_import_renames.keys():
        blocked.insert(name, true)
    for name in ir_struct_names.keys():
        blocked.insert(name, true)
    for name in ir_func_returns.keys():
        blocked.insert(name, true)
    return blocked

## the ir return kind for a declared type name.
pub fn ir_retkind(type_name: String) -> String:
    return ir_retkind_with_state(type_name, ir_type_aliases, ir_struct_names)

## true when the import declares the function.
pub fn ir_import_declares_function(module_path: String, name: String) -> Bool:
    return ir_import_declares_function_with_state(module_path, name, ir_import_declared_functions)

## true when the import declares the global.
pub fn ir_import_declares_global(module_path: String, name: String) -> Bool:
    return ir_import_declares_global_with_state(module_path, name, ir_import_declared_globals)

## record what a preloaded module root declares and aliases.
pub fn ir_collect_preloaded_root_metadata(root_idx: Int, module_path: String):
    for item_idx in ir_root_items(root_idx):
        node := get_node(item_idx)
        if ir_is_fn_decl_kind(node.kind):
            ir_import_declared_functions.insert(module_path + "." + ir_base_decl_name(node.value), true)
        elif ir_is_binding_kind(node.kind):
            ir_import_declared_globals.insert(module_path + "." + ir_binding_name(node), true)
            ir_record_imported_global_kind(node)

# an imported global's type kind travels with the import: without it,
# assigning a fresh {} to an imported Map[String, String] built the
# untagged map flavor, its values went in without retains, and the
# renames table came back as dangling pointers — the bug that sank
# two attempts to split this file.

## record an imported global's type kind so empty literals
## assigned to it keep the right container flavor.
pub fn ir_record_imported_global_kind(node: Node):
    gname := ir_binding_name(node)
    for gc in node.children:
        gcn := get_node(gc)
        if gcn.kind == "type" or gcn.kind == "generic_type" or gcn.kind == "optional_type":
            kind := ir_resolve_type_node(gc)
            if kind.len() > 0:
                ir_record_global_type(gname, kind)
            value_kind := ir_resolve_map_value_type_node(gc)
            if value_kind.len() > 0:
                ir_global_map_value_types.insert(gname, value_kind)

## resolve alias.method() to its qualified symbol, or "".
pub fn ir_resolve_module_alias_method_call_name(idx: Int) -> String:
    return ir_resolve_module_alias_method_call_name_with_state(idx, ir_module_aliases, ir_import_declared_functions, ir_import_declared_globals)

