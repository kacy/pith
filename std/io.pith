fn read_exact_bytes_cursor(reader: BytesCursor, count: Int) -> Bytes!:
    if count <= 0:
        return bytes.empty()
    buf := bytes.buffer_with_capacity(count)
    while buf.len() < count:
        chunk := bytes_cursor_read(reader, count - buf.len())!
        if chunk.is_empty():
            fail "unexpected eof"
        buf.write(chunk)!
    return buf.take_bytes()

fn read_exact_buffered_bytes_reader(reader: BufferedBytesReader, count: Int) -> Bytes!:
