# a lazy adapter's next() binds the inner optional it pulls from its source
# (`n := self.src.next()`), then either forwards it or unwraps its value. that
# inner optional must be released on every return path, or one leaks per step.
# the release has to be safe even when the mapped value aliases the inner
# optional's contents (an identity map): the closure hands back an owned count,
# so dropping the inner optional after building the result cannot dangle it.
# a filter forwards the optional itself (`return n`), which must transfer the
# count rather than release it. drained in a loop here, the whole pipeline must
# stay balanced: no leak, no double free.

pub interface Iterator[T]:
    fn next() -> T?

pub struct Range:
    mut cur: Int
    hi: Int

impl Iterator[Int] for Range:
    fn next() -> Int?:
        if self.cur >= self.hi:
            return none
        v := self.cur
        self.cur = self.cur + 1
        return v

pub struct MapIter[I, T, U]:
    src: I
    f: fn(T) -> U

impl Iterator[U] for MapIter:
    fn next() -> U?:
        n := self.src.next()
        if n == none:
            return none
        return self.f(n.value())

pub struct FilterIter[I, T]:
    src: I
    keep: fn(T) -> Bool

impl Iterator[T] for FilterIter:
    fn next() -> T?:
        while true:
            n := self.src.next()
            if n == none:
                return none
            if self.keep(n.value()):
                return n
        return none

pub fn map_iter[I: Iterator[T], T, U](src: I, f: fn(T) -> U) -> MapIter[I, T, U]:
    return MapIter[I, T, U](src, f)

pub fn filter_iter[I: Iterator[T], T](src: I, keep: fn(T) -> Bool) -> FilterIter[I, T]:
    return FilterIter[I, T](src, keep)

fn main():
    mut total := 0
    mut k := 0
    while k < 1000:
        pipeline := filter_iter(map_iter(Range(cur: 0, hi: 6), fn(x: Int) => x * 2), fn(x: Int) => x > 3)
        for y in pipeline:
            total = total + y
        k = k + 1
    print("{total}")
