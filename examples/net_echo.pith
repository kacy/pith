# TCP echo server/client test

fn run_server(port: Int) -> Int!:
    s := tcp_listen("127.0.0.1", port)!
    defer tcp_close(s)
    c := tcp_accept(s)!
    defer tcp_close(c)
    data := tcp_read(c, 1024)!
    tcp_write(c, "echo: {data}")!
    return 0

fn run() -> String!:
    port := 18440

    # spawn server — MUST capture task handle (expression form)
    task := spawn run_server(port)
    sleep(200)

    # connect client
    conn := tcp_connect("127.0.0.1", port)!
    defer tcp_close(conn)
    tcp_write(conn, "hello pith")!
    response := tcp_read(conn, 1024)!
    print(response)

    await task
    print("net echo works")
    return ""

fn main():
    run()
