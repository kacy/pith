# higher-order functions: functions that take or return other functions.
#
# cleans up a batch of sensor readings. small steps (convert, calibrate,
# clamp) are plain functions, `compose` glues two of them into one, and the
# built-in map, filter and reduce run a step over a whole list.

import std.fmt as fmt

fn fahrenheit_to_celsius(tenths: Int) -> Int:
    return (tenths - 320) * 5 / 9

fn compose(first: fn(Int) -> Int, second: fn(Int) -> Int) -> fn(Int) -> Int:
    return fn(value: Int) => second(first(value))

# returns a function that adds a fixed offset, for a sensor that reads off
fn offset_by(amount: Int) -> fn(Int) -> Int:
    return fn(value: Int) => value + amount

fn between(low: Int, high: Int) -> fn(Int) -> Bool:
    return fn(value: Int) => value >= low and value <= high

fn apply_times(value: Int, times: Int, step: fn(Int) -> Int) -> Int:
    mut current := value
    for i in 0..times:
        current = step(current)
    return current

fn main():
    # readings in tenths of a degree fahrenheit; 9999 is a sensor glitch
    raw := [698, 712, 9999, 655, 731, 704, -400]

    # one function out of two: convert first, then correct the offset
    to_celsius := compose(fahrenheit_to_celsius, offset_by(-5))
    plausible := between(-200, 500)

    celsius := filter(map(raw, to_celsius), plausible)
    print("celsius (tenths): {fmt.ints(celsius)}")

    total := reduce(celsius, 0, fn(sum: Int, value: Int) => sum + value)
    print("average: {total / celsius.len()} tenths")

    warmest := reduce(celsius, celsius[0], fn(best: Int, value: Int) => max(best, value))
    print("warmest: {warmest} tenths")

    # the same step applied over and over: three hours of 2% drift
    drifted := apply_times(1000, 3, fn(value: Int) => value + value * 2 / 100)
    print("1000 after three drift steps: {drifted}")
