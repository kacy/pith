# the same shape as test_samename_struct_ctor with the imports reversed: which
# module registered Widget last must not matter, so both orders print the same
# golden output.
import clash_widget_b as b
import clash_widget_a as a

fn main():
    va := a.Widget(5)
    vb := b.Widget("lbl", 5)
    print(va.tag().to_string())
    print(vb.tag().to_string())
    print(va.only_a())
    print(vb.only_b())
