# proxy.pith: forward one request to an upstream and relay the answer.
#
# a request body is buffered, capped by max_body_bytes, which keeps it in hand for
# a retry. a response is relayed as it arrives when it is large or has no declared
# length, so server-sent events and downloads pass through, and the retry decision
# is made on the response head. a small response with a declared length is read
# whole, which is the common case and the cheaper one.

import std.bytes as bytes
import std.metrics as metrics
import std.net.http as http
import std.net.url as url
import std.shutdown as shutdown
import std.time as time
import std.web as web
import auth
import config
import upstream

# headers that describe one connection rather than the message (rfc 9110 7.6.1),
# plus the ones the client recomputes for the outbound request.
fn is_hop_by_hop(lower: String) -> Bool:
    return lower == "connection" or lower == "keep-alive" or lower == "proxy-authenticate" or lower == "proxy-authorization" or lower == "proxy-connection" or lower == "te" or lower == "trailer" or lower == "transfer-encoding" or lower == "upgrade"

# the extra hop-by-hop fields a Connection header names.
fn connection_tokens(value: String) -> List[String]:
    mut out: List[String] := []
    for token in value.split(","):
        out.push(token.trim().to_lower())
    return out

SUBJECT_HEADER_LOWER := auth.SUBJECT_HEADER.to_lower()

# headers a client may not choose: only the gateway sets these for an upstream.
fn is_gateway_owned(lower: String) -> Bool:
    return lower == SUBJECT_HEADER_LOWER or lower == "x-forwarded-for" or lower == "x-forwarded-host" or lower == "x-forwarded-proto"

# a path a backend could split differently than the router did: an encoded slash
# or backslash in a segment. `/public/a%2f..%2f..%2fadmin` is one segment under a
# public route here, and /admin to a backend that decodes before it routes, which
# would walk around that route's auth. encoded dot segments never get this far:
# std.web redirects them to the clean path, which the router then matches again.
fn path_is_ambiguous(path: String) -> Bool:
    if not path.contains("%"):
        return false
    decoded := url.decode_path(path)
    return decoded.split("/").len() != path.split("/").len() or decoded.contains("\\")

# the path sent upstream: the raw path with the route's prefix segments dropped
# when the route asks for that. it counts segments because the router matched by
# segment, and `/%61pi` reaches a route under `/api`.
fn upstream_path(path: String, query: String, skip_segments: Int) -> String:
    mut target := path
    if skip_segments > 0:
        parts := path.split("/")
        target = ""
        mut i := skip_segments
        while i < parts.len():
            target = target + "/" + parts[i]
            i = i + 1
        if target == "" or path.ends_with("/"):
            target = target + "/"
    if query != "":
        return target + "?" + query
    return target

fn count_segments(prefix: String) -> Int:
    mut count := 0
    for part in prefix.split("/"):
        if part != "":
            count = count + 1
    return count

fn outbound_headers(req: web.Request, scheme: String, trust_forwarded_for: Bool) -> Map[String, String]:
    fields := req.raw.header_fields()
    mut named: List[String] := []
    if fields.contains_key("connection"):
        named = connection_tokens(fields["connection"])
    mut out: Map[String, String] := {}
    for name in fields:
        if is_hop_by_hop(name) or is_gateway_owned(name) or named.contains(name):
            continue
        if name == "host" or name == "content-length" or name.starts_with(":"):
            continue
        out.insert(name, fields[name])
    if fields.contains_key("host"):
        out.insert("x-forwarded-host", fields["host"])
    out.insert("x-forwarded-proto", scheme)
    mut forwarded_for := req.peer_ip()
    if trust_forwarded_for and fields.contains_key("x-forwarded-for"):
        forwarded_for = fields["x-forwarded-for"] + ", " + forwarded_for
    out.insert("x-forwarded-for", forwarded_for)
    subject := req.value(auth.SUBJECT_KEY)
    if subject != "":
        out.insert(auth.SUBJECT_HEADER, subject)
    return out

# what crosses back from an upstream's answer: its headers, minus those about the
# connection. a body read whole gets its length from the server that sends it.
fn relayed_headers(answer: http.OpenResponse, keep_length: Bool) -> Map[String, String]:
    mut named: List[String] := []
    for name in answer.headers:
        if name.to_lower() == "connection":
            named = connection_tokens(answer.headers[name])
    mut headers: Map[String, String] := {}
    for name in answer.headers:
        lower := name.to_lower()
        # the cookies travel in set_cookie_headers, and the map repeats the last
        if is_hop_by_hop(lower) or named.contains(lower) or lower == "set-cookie":
            continue
        if lower == "content-length" and not keep_length:
            continue
        headers.insert(name, answer.headers[name])
    return headers

fn relayed_head(answer: http.OpenResponse, body: Bytes, keep_length: Bool) -> http.HttpResponse:
    no_trailers: Map[String, String] := {}
    return http.HttpResponse(answer.status, answer.content_type, relayed_headers(answer, keep_length), body, answer.set_cookie_headers, no_trailers)

# copy an upstream's body to the client as it arrives, ending once a shutdown has
# used up its grace for streams.
fn pump_body(answer: http.OpenResponse, write: fn(Bytes) -> Int!) -> Int!:
    defer answer.close()
    mut total := 0
    while true:
        piece := answer.read()!
        if piece.is_empty():
            return total
        write(piece)!
        total = total + piece.len()
        if shutdown.stream_deadline_passed():
            fail "shutting down"
    return total

fn can_repeat(method: String) -> Bool:
    return method == "GET" or method == "HEAD" or method == "OPTIONS" or method == "PUT" or method == "DELETE"

# an answer that says this upstream could not do the work, rather than that the
# request was wrong.
fn upstream_failed(status: Int) -> Bool:
    return status == 502 or status == 503 or status == 504

# a response up to this size with a declared length is read whole and sent as one
# write. a larger one, or one with no declared length, is relayed as it arrives.
READ_WHOLE_BYTES := 65536

fn failure_response(error: String) -> http.HttpResponse:
    if error.to_lower().contains("timeout") or error.to_lower().contains("timed out"):
        return http.response(504).text_body("upstream timed out")
    return http.response(502).text_body("bad gateway")

# read a small body whole and relay it. a HEAD answer has no body, so what it
# declares is kept for the client.
fn read_whole(answer: http.OpenResponse, method: String) -> http.HttpResponse:
    defer answer.close()
    body := answer.read_all(READ_WHOLE_BYTES)
    if body.is_err:
        return failure_response(body.err)
    return relayed_head(answer, body.ok, method == "HEAD")

fn relay_as_it_comes(answer: http.OpenResponse) -> http.HttpResponse:
    pump := fn(write: fn(Bytes) -> Int!) -> Int!:
        return pump_body(answer, write)!
    return http.stream_response(relayed_head(answer, bytes.empty(), true), pump)

# one upstream's metrics, looked up once so a request does not build label lists.
struct UpstreamMetrics:
    ok: metrics.Counter
    failed: metrics.Counter
    error: metrics.Counter
    duration: metrics.Histogram

fn upstream_metrics(route: String, address: String) -> UpstreamMetrics:
    requests := metrics.counter("gateway_upstream_requests_total")
    outcome := fn(name: String) => requests.labels(["route", route, "upstream", address, "outcome", name])
    return UpstreamMetrics(outcome("ok"), outcome("failed"), outcome("error"), metrics.histogram("gateway_upstream_duration_ms").labels(["route", route, "upstream", address]))

pub struct Forwarder:
    route: config.Route
    pool: upstream.Pool
    instruments: List[UpstreamMetrics]
    client: http.Client
    skip_segments: Int
    scheme: String
    trust_forwarded_for: Bool

# a forwarder for one route, sending to its pool through `client`.
pub fn forwarder(route: config.Route, pool: upstream.Pool, client: http.Client, scheme: String, trust_forwarded_for: Bool) -> Forwarder:
    mut skip := 0
    if route.strip_prefix:
        skip = count_segments(route.prefix)
    mut instruments: List[UpstreamMetrics] := []
    for target in pool.upstreams:
        instruments.push(upstream_metrics(route.name, target.address))
    return Forwarder(route, pool, instruments, client, skip, scheme, trust_forwarded_for)

fn record(outcome: metrics.Counter, duration: metrics.Histogram, started: Int):
    outcome.inc()
    duration.observe((time.mono_millis() - started).to_float())

impl Forwarder:
    # try upstreams in turn: as many as the route's retries allow for a method
    # that is safe to repeat, and one for any other method.
    fn forward(req: web.Request) -> http.HttpResponse:
        raw_path := req.raw.path() catch "/"
        if path_is_ambiguous(raw_path):
            return http.response(400).text_body("bad path")
        method := req.method()
        target := upstream_path(raw_path, req.raw.query() catch "", self.skip_segments)
        headers := outbound_headers(req, self.scheme, self.trust_forwarded_for)
        n := self.pool.upstreams.len()
        mut tried: List[Bool] := []
        for i in 0..n:
            tried.push(false)
        mut attempts := 1
        if can_repeat(method):
            attempts = self.route.retries + 1
        mut last := http.response(503).text_body("no upstream available")
        mut attempt := 0
        while attempt < attempts:
            index := self.pool.pick(tried)
            if index < 0:
                break
            tried[index] = true
            chosen := self.pool.upstreams[index]
            instruments := self.instruments[index]
            if attempt > 0:
                metrics.counter("gateway_retries_total").labels(["route", self.route.name]).inc()
            started := time.mono_millis()
            outbound := http.ClientRequest(method, chosen.host, chosen.port, target, headers, req.raw.body, chosen.use_tls, self.route.timeout_ms, 0, 0)
            opened := self.client.open(outbound)
            if opened.is_err:
                chosen.breaker.failure()
                record(instruments.error, instruments.duration, started)
                last = failure_response(opened.err)
            elif upstream_failed(opened.ok.status):
                chosen.breaker.failure()
                record(instruments.failed, instruments.duration, started)
                last = read_whole(opened.ok, method)
            else:
                chosen.breaker.success()
                record(instruments.ok, instruments.duration, started)
                answer := opened.ok
                if answer.content_length >= 0 and answer.content_length <= READ_WHOLE_BYTES or method == "HEAD":
                    return read_whole(answer, method)
                return relay_as_it_comes(answer)
            attempt = attempt + 1
        return last
