# crypto_ops: message authentication and key derivation.
#
# three jobs a web backend does with std.crypto: check that a webhook really
# came from the sender who shares our secret (hmac), turn a password into a
# slow-to-guess stored hash (pbkdf2), and split one master key into separate
# keys for separate purposes (hkdf). comparisons of secret values go through
# subtle.equal, which takes the same time whether or not they match.

import std.bytes as bytes
import std.crypto.hmac as hmac
import std.crypto.kdf as kdf
import std.crypto.subtle as subtle
import std.encoding as encoding

fn text(value: String) -> Bytes:
    return bytes.from_string_utf8(value)

fn sign_webhook(secret: Bytes, body: String) -> String:
    return encoding.to_hex(hmac.sha256(secret, text(body)))

fn webhook_is_authentic(secret: Bytes, body: String, signature_hex: String) -> Bool:
    claimed := encoding.from_hex(signature_hex) catch:
        return false
    return hmac.verify_sha256(secret, text(body), claimed)

# real deployments use far more iterations; this keeps the example quick
fn hash_password(password: String, salt: Bytes) -> Bytes!:
    return kdf.pbkdf2_sha256(text(password), salt, 1000, 32)!

fn main() -> Int!:
    secret := text("whsec_shared_between_us")
    body := "{{\"event\":\"invoice.paid\",\"amount\":4200}}"
    signature := sign_webhook(secret, body)
    print("signature: {signature}")
    print("genuine body accepted:  {webhook_is_authentic(secret, body, signature)}")
    print("edited body rejected:   {not webhook_is_authentic(secret, body.replace("4200", "9900"), signature)}")
    print("malformed hex rejected: {not webhook_is_authentic(secret, body, "zz")}")

    print("")
    salt := text("per-user-salt-01")
    stored := hash_password("correct horse battery staple", salt)!
    print("stored hash: {encoding.to_hex(stored).substring(0, 32)}...")
    for attempt in ["correct horse battery staple", "Correct horse battery staple"]:
        matches := subtle.equal(hash_password(attempt, salt)!, stored)
        print("login with '{attempt}': {matches}")

    # one master key, two derived keys: a leak of one does not expose the other
    print("")
    master := encoding.from_hex("000102030405060708090a0b0c0d0e0f")!
    encryption_key := kdf.hkdf_sha256(master, text("app-v1"), text("encryption"), 16)!
    signing_key := kdf.hkdf_sha256(master, text("app-v1"), text("signing"), 16)!
    print("encryption key: {encoding.to_hex(encryption_key)}")
    print("signing key:    {encoding.to_hex(signing_key)}")
    print("keys differ:    {not subtle.equal(encryption_key, signing_key)}")
    return 0
