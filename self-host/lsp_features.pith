# lsp_features.pith — analysis, diagnostics, hover, symbols, formatting
#
# each language feature reads the compiler's state after a front-end
# run: diagnostics render the checker's findings as publishDiagnostics
# notifications, hover reads the expression type cache, documentSymbol
# and workspace/symbol walk the module roots, code actions replay the
# checker's fix suggestions, and formatting diffs against fmt_source.
# one analysis is valid at a time — the node arena and type cache
# describe only the most recent run_check_pipeline call — so every
# feature goes through ensure_analyzed first.

from check_pipeline import run_check_pipeline, run_parse_only, last_timing_line, last_module_timing_lines, last_parse_only_ms
from driver import file_for_node, dr_read_source
from checker import c_get_expr_type, get_definition_of
from types import get_type_name, TID_ERR
from ast import get_node, node_count
from errors import Diagnostic
from lexer import lex_all
from formatter import fmt_source
import std.log as log
from lsp_state import PithPos, uri_to_path, path_to_uri, document_text, open_document_uris, clear_dirty_if, dirty_is, get_position_encoding, line_col_to_lsp_pos, lsp_pos_to_line_col, text_line, text_line_count
from scope import all_binding_names, all_binding_types, all_binding_decl_nodes
import std.json as json
import std.lsp.protocol as protocol
import std.time as time

# at most this many diagnostics publish per file; an unparsable file can
# produce hundreds and the first few are the actionable ones.
MAX_DIAGNOSTICS_PER_FILE := 20

# workspace/symbol responses stop growing past this many entries.
MAX_WORKSPACE_SYMBOLS := 200

# the fix text check_assignment attaches to E216; the one fix shape a
# code action can apply mechanically.
MUT_FIX_PREFIX := "declare with 'mut': mut "

## how long the server lets the typing settle before running the full
## analysis. the syntax fast lane exists to answer inside this window,
## so the window is also the budget it has to stay under.
pub DEBOUNCE_MS := 300

# what parsing each document on its own last cost, in milliseconds.
# the fast lane pays for itself only while that stays under the
# debounce window it is racing. below the window a syntax error reaches
# the editor sooner for a parse nobody notices; above it the parse is
# duplicated work sitting in front of a full run that will parse the
# same text again, which pushes the real diagnostics out by however
# long the file takes to parse. both sides of that line are real files
# in this repository: a 300-line module parses in a few milliseconds
# and a 10,000-line one in a few hundred. the cost is measured rather
# than guessed from the file's size, so the first change to a document
# runs the lane and remembers what it cost.
mut parse_only_cost_ms: Map[String, Int] := {}

# which document the compiler state currently describes, and whether the
# checker ran for it (a parse or import failure stops before checking,
# leaving the type cache stale).
mut analyzed_uri := ""
mut analyzed_root := 0 - 1
mut analyzed_import_roots: List[Int] := []
mut analyzed_checked := false

# the last run's diagnostics grouped by the file they point at, kept so
# a codeAction request can recover the fix text its diagnostics carried
# — published diagnostics do not round-trip the fix field.
mut last_diags_by_path: Map[String, List[Diagnostic]] := {}

# how many diagnostics were last published per uri, so a document whose
# problems disappear gets one clearing publish instead of silence.
mut last_published_counts: Map[String, Int] := {}

# ---------------------------------------------------------------
# diagnostics
# ---------------------------------------------------------------

fn severity_number(severity: String) -> Int:
    if severity == "warning":
        return 2
    return 1

# insertion sort by (line, col, code); diagnostic lists are short.
fn sort_diagnostics(diags: List[Diagnostic]) -> List[Diagnostic]:
    mut sorted: List[Diagnostic] := []
    for d in diags:
        mut inserted := false
        mut i := 0
        while i < sorted.len() and not inserted:
            s := sorted[i]
            after := d.line < s.line or (d.line == s.line and (d.col < s.col or (d.col == s.col and d.code < s.code)))
            if after:
                sorted.insert(i, d)
                inserted = true
            i = i + 1
        if not inserted:
            sorted.push(d)
    return sorted

## the byte length of the token starting at 1-based col on this line,
## or 0 when no token starts there. the line is lexed alone, so token
## columns are columns within the line.
pub fn token_length_at(line_text: String, col: Int) -> Int:
    toks := lex_all(line_text)
    for tok in toks:
        if tok.current_line == 1 and tok.current_column == col:
            return tok.len
    return 0

# one diagnostic as a json object, with a range spanning the token at
# its position when one is found there.
fn diagnostic_json(d: Diagnostic, text: String, mode: String) -> Int:
    start := line_col_to_lsp_pos(text, d.line, d.col, mode)
    mut end_col := d.col
    span := token_length_at(text_line(text, start.line), d.col)
    if span > 0:
        end_col = d.col + span
    end := line_col_to_lsp_pos(text, d.line, end_col, mode)
    range := json.make_object()
    start_obj := json.make_object()
    json.object_set(start_obj, "line", json.make_int(start.line))
    json.object_set(start_obj, "character", json.make_int(start.character))
    end_obj := json.make_object()
    json.object_set(end_obj, "line", json.make_int(end.line))
    json.object_set(end_obj, "character", json.make_int(end.character))
    json.object_set(range, "start", start_obj)
    json.object_set(range, "end", end_obj)
    obj := json.make_object()
    json.object_set(obj, "range", range)
    json.object_set(obj, "severity", json.make_int(severity_number(d.severity)))
    if d.code != "":
        json.object_set(obj, "code", json.make_string(d.code))
    json.object_set(obj, "source", json.make_string("pith"))
    json.object_set(obj, "message", json.make_string(d.message))
    return obj

# an encoded publishDiagnostics notification for one uri.
fn publish_body(uri: String, diags: List[Diagnostic], mode: String) -> String:
    text := document_text(uri)
    arr := json.make_array()
    mut seen: Map[String, Bool] := {}
    mut emitted := 0
    for d in sort_diagnostics(diags):
        key := "{d.line}:" + d.code
        if seen.contains_key(key):
            continue
        seen.insert(key, true)
        if emitted >= MAX_DIAGNOSTICS_PER_FILE:
            break
        json.array_push(arr, diagnostic_json(d, text, mode))
        emitted = emitted + 1
    params := json.make_object()
    json.object_set(params, "uri", json.make_string(uri))
    json.object_set(params, "diagnostics", arr)
    return protocol.notification_body("textDocument/publishDiagnostics", params)

# where one analysis spent its time, on stderr so the protocol channel
# on fd 1 never sees it. PITH_LSP_TIMING=1 logs the phase split plus the
# cost of turning the outcome into publishDiagnostics bodies;
# PITH_LSP_TIMING=2 adds one line per module of the closure, which is
# how a slow closure names the module responsible.
fn log_analysis_timing(path: String, publish_ms: Int):
    level := env("PITH_LSP_TIMING")
    if level != "1" and level != "2":
        return
    log.info("analysis " + path + " " + last_timing_line() + " publish={publish_ms}ms")
    if level != "2":
        return
    for line in last_module_timing_lines():
        log.info("  " + line)

## run the front end for one document and build the publishDiagnostics
## notifications that fall out: always one for the analyzed document,
## and one per other open document that has findings now or had some at
## its last publish. bodies are encoded strings, so they stay valid
## after the caller closes its json scope.
pub fn run_analysis(uri: String) -> List[String]:
    path := uri_to_path(uri)
    mut bodies: List[String] := []
    outcome := run_check_pipeline(path) catch:
        return bodies
    pipeline_done := time.mono_millis()
    clear_dirty_if(uri)
    analyzed_uri = uri
    analyzed_root = outcome.root
    analyzed_import_roots = outcome.import_roots
    analyzed_checked = outcome.parse_ok and outcome.import_ok
    mode := get_position_encoding()

    # group findings by the file they point at
    mut by_path: Map[String, List[Diagnostic]] := {}
    for d in outcome.diags:
        mut file := d.file
        if file == "":
            file = path
        if by_path.contains_key(file):
            by_path[file].push(d)
        else:
            by_path.insert(file, [d])

    for open_uri in open_document_uris():
        open_path := uri_to_path(open_uri)
        mut file_diags: List[Diagnostic] := []
        if by_path.contains_key(open_path):
            file_diags = by_path[open_path]
        mut previous := 0
        if last_published_counts.contains_key(open_path):
            previous = last_published_counts[open_path]
        if open_uri == uri or file_diags.len() > 0 or previous > 0:
            bodies.push(publish_body(open_uri, file_diags, mode))
            last_published_counts.insert(open_path, file_diags.len())
    last_diags_by_path = by_path
    log_analysis_timing(path, time.mono_millis() - pipeline_done)
    return bodies

## the fast lane: lex and parse just this document and build the
## publishDiagnostics bodies for what the parser found, leaving the
## import closure alone. it costs what one file costs to parse, so a
## syntax error surfaces while the full analysis is still ahead of it.
##
## a document that parses cleanly produces no bodies at all. publishing
## an empty list for it would wipe the last analysis's findings off the
## screen and put them back when the closure check lands, which reads
## as a flicker; a parse error is different, because it makes those
## findings stale by definition, so it publishes and replaces them.
##
## nothing here touches the analyzed-document state: the full run still
## has to happen, and this neither satisfies nor cancels it.
pub fn syntax_diagnostics(uri: String) -> List[String]:
    path := uri_to_path(uri)
    mut bodies: List[String] := []
    if parse_only_cost_ms.contains_key(path) and parse_only_cost_ms[path] >= DEBOUNCE_MS:
        return bodies
    diags := run_parse_only(path) catch:
        return bodies
    cost := last_parse_only_ms()
    parse_only_cost_ms.insert(path, cost)
    level := env("PITH_LSP_TIMING")
    if level == "1" or level == "2":
        found := diags.len()
        log.info("syntax " + path + " parse={cost}ms diags={found}")
    if diags.len() == 0:
        return bodies
    bodies.push(publish_body(uri, diags, get_position_encoding()))
    # remember the publish so a later analysis that finds nothing still
    # sends the clearing notification for this document
    last_published_counts.insert(path, diags.len())
    return bodies

## forget what the fast lane learned about a document, so a later
## didOpen measures it again instead of trusting a figure taken before
## the file was edited elsewhere.
pub fn forget_syntax_cost(uri: String):
    parse_only_cost_ms.remove(uri_to_path(uri))

## whether the last analysis ran the checker to completion, so the
## type cache and definition map describe the current node arena.
pub fn analysis_is_checked() -> Bool:
    return analyzed_checked

## make the compiler state describe this document, re-running analysis
## when the last run was for another document or the text changed since.
## returns any publishDiagnostics bodies a re-run produced.
pub fn ensure_analyzed(uri: String) -> List[String]:
    if analyzed_uri == uri and not dirty_is(uri):
        mut none_needed: List[String] := []
        return none_needed
    return run_analysis(uri)

# ---------------------------------------------------------------
# hover
# ---------------------------------------------------------------

## the hover result for a position as a json handle, or -1 for null.
## finds the typed expression node starting closest before the position
## on its line and reports the checker's type for it.
# true for the bytes an identifier is made of
fn is_ident_byte(b: Int) -> Bool:
    if b >= 97 and b <= 122:
        return true
    if b >= 65 and b <= 90:
        return true
    if b >= 48 and b <= 57:
        return true
    return b == 95

# the identifier the cursor sits on, or "" when it sits on anything
# else. pos_col is the 1-based byte column within the line.
fn word_at(line_text: String, pos_col: Int) -> String:
    mut idx := pos_col - 1
    if idx >= line_text.len():
        return ""
    if not is_ident_byte(ord(line_text[idx])):
        return ""
    mut start := idx
    while start > 0 and is_ident_byte(ord(line_text[start - 1])):
        start = start - 1
    mut end := idx + 1
    while end < line_text.len() and is_ident_byte(ord(line_text[end])):
        end = end + 1
    return line_text.substring(start, end)

# the type and declaration node of the named binding from the last
# run, walking the arena backwards so an inner shadowing binding wins
# over an outer one. (-1, -1) when the name is unknown.
fn binding_by_name(name: String) -> (Int, Int):
    if name == "":
        return (0 - 1, 0 - 1)
    names := all_binding_names()
    types := all_binding_types()
    decls := all_binding_decl_nodes()
    mut i := names.len() - 1
    while i >= 0:
        if names[i] == name:
            return (types[i], decls[i])
        i = i - 1
    return (0 - 1, 0 - 1)

# the contiguous run of comment lines directly above the 1-based
# declaration line, with the leading comment marker stripped — the
# doc-comment convention the linter and doc coverage gate enforce.
fn doc_comment_above(source: String, decl_line: Int) -> String:
    mut collected: List[String] := []
    mut line0 := decl_line - 2
    mut scanning := true
    while scanning and line0 >= 0:
        trimmed := text_line(source, line0).trim()
        if trimmed.len() > 0 and ord(trimmed[0]) == 35:
            mut start := 0
            while start < trimmed.len() and ord(trimmed[start]) == 35:
                start = start + 1
            if start < trimmed.len() and trimmed[start] == " ":
                start = start + 1
            collected.push(trimmed.substring(start, trimmed.len()))
            line0 = line0 - 1
        else:
            scanning = false
    if collected.len() == 0:
        return ""
    # collected bottom-up; join back in source order
    mut out := ""
    mut i := collected.len() - 1
    while i >= 0:
        if out != "":
            out = out + chr(10)
        out = out + collected[i]
        i = i - 1
    return out

# the doc comment above a declaration node, read from the file that
# declared it (through the driver's overlays, so unsaved buffers
# count). only declaration kinds with a doc convention answer.
fn doc_comment_for(decl_idx: Int, name: String) -> String:
    if decl_idx < 0 or name == "":
        return ""
    decl := get_node(decl_idx)
    if decl.kind != "fn_decl" and decl.kind != "struct_decl" and decl.kind != "enum_decl" and decl.kind != "interface_decl":
        return ""
    file := file_for_node(decl_idx)
    if file == "":
        return ""
    source := dr_read_source(file) catch ""
    if source == "":
        return ""
    decl_pos := find_decl_position(source, decl.kind, name)
    if decl_pos.line <= 0:
        return ""
    return doc_comment_above(source, decl_pos.line)

fn hover_body(value: String) -> Int:
    contents := json.make_object()
    json.object_set(contents, "kind", json.make_string("plaintext"))
    json.object_set(contents, "value", json.make_string(value))
    result := json.make_object()
    json.object_set(result, "contents", contents)
    return result

## the json handle for a textDocument/hover result, or -1 when there is
## nothing to show — response_body encodes a negative handle as a null
## result, which is what the protocol wants for "no hover". line0 and
## character arrive 0-based in the client's negotiated position
## encoding. the hover text is "word: Type", plus the declaration's doc
## comment when the cursor resolves to one. requires an analysis that
## ran the checker to completion, so call ensure_analyzed first; -1 comes
## straight back otherwise.
pub fn hover_result(uri: String, line0: Int, character: Int) -> Int:
    if not analyzed_checked:
        return 0 - 1
    path := uri_to_path(uri)
    text := document_text(uri)
    pos := lsp_pos_to_line_col(text, line0, character, get_position_encoding())
    word := word_at(text_line(text, pos.line - 1), pos.col)
    mut best_idx := 0 - 1
    mut best_col := 0 - 1
    total := node_count()
    mut i := 0
    while i < total:
        node := get_node(i)
        if node.line == pos.line and node.col <= pos.col and file_for_node(i) == path:
            tid := c_get_expr_type(i)
            if tid != TID_ERR and tid >= 0:
                # a later start is a tighter fit; at the same start the
                # lower index is the leaf, parents being added after
                # their children
                if node.col > best_col or (node.col == best_col and i < best_idx):
                    best_idx = i
                    best_col = node.col
        i = i + 1
    mut name := ""
    mut decl_idx := 0 - 1
    if best_idx >= 0:
        name = get_type_name(c_get_expr_type(best_idx))
        defs := get_definition_of()
        if defs.contains_key(best_idx):
            decl_idx = defs[best_idx]
        if decl_idx < 0 and word != "":
            # a qualified call's use-def entry is keyed on the call
            # node, which sits at the closing token — not under the
            # cursor. accept a same-line entry only when its target
            # declaration is named exactly what the cursor sits on.
            for use_idx in defs.keys():
                if decl_idx < 0:
                    use_node := get_node(use_idx)
                    if use_node.line == pos.line and file_for_node(use_idx) == path:
                        candidate := defs[use_idx]
                        if get_node(candidate).value == word:
                            decl_idx = candidate
    # the expression walk misses the commonest hover there is — a name
    # on its declaration line, whose binding node sits at the line's
    # last token — and answers "Void" for statement-level punctuation.
    # fall back to the identifier under the cursor and the binding
    # tables from the last run.
    if name == "" or name == "<error>" or name == "Void":
        fallback := binding_by_name(word)
        if fallback.0 < 0:
            return 0 - 1
        name = get_type_name(fallback.0)
        if name == "" or name == "<error>":
            return 0 - 1
        decl_idx = fallback.1
    # "name: Type" when the cursor is on an identifier; a literal or
    # an operator hovers as its bare type. a documented declaration
    # brings its doc comment along.
    mut value := name
    if word != "":
        value = word + ": " + name
        doc := doc_comment_for(decl_idx, word)
        if doc != "":
            value = value + chr(10) + chr(10) + doc
    return hover_body(value)

# ---------------------------------------------------------------
# document symbols
# ---------------------------------------------------------------

# a top-level entry unwrapped: a `pub` declaration is a marker node
# holding the real declaration as its only child.
fn unwrap_pub(child_idx: Int) -> Int:
    node := get_node(child_idx)
    if node.kind == "pub" and node.children.len() == 1:
        return node.children[0]
    return child_idx

fn symbol_kind_number(node_kind: String) -> Int:
    if node_kind == "fn_decl":
        return 12
    if node_kind == "struct_decl":
        return 23
    if node_kind == "enum_decl":
        return 10
    if node_kind == "interface_decl":
        return 11
    return 0

## a declaration name without any generic parameter brackets.
pub fn bare_symbol_name(value: String) -> String:
    bracket := value.index_of("[")
    if bracket >= 0:
        return value.substring(0, bracket)
    return value

fn decl_keyword(node_kind: String) -> String:
    if node_kind == "fn_decl":
        return "fn"
    if node_kind == "struct_decl":
        return "struct"
    if node_kind == "enum_decl":
        return "enum"
    return "interface"

# true when the name at this byte offset ends there as an identifier —
# the next byte is not part of a longer name.
fn name_ends_at(line: String, end: Int) -> Bool:
    if end >= line.len():
        return true
    c := ord(line[end])
    if c >= 97 and c <= 122:
        return false
    if c >= 65 and c <= 90:
        return false
    if c >= 48 and c <= 57:
        return false
    if c == 95:
        return false
    return true

## true when the identifier starting exactly at 1-based byte col is
## name — the byte before is not part of an identifier and the byte
## after the name is not either.
pub fn word_starts_at(line_text: String, col: Int, name: String) -> Bool:
    idx := col - 1
    if idx < 0 or name.len() == 0 or idx + name.len() > line_text.len():
        return false
    if line_text.substring(idx, idx + name.len()) != name:
        return false
    if idx > 0 and is_ident_byte(ord(line_text[idx - 1])):
        return false
    return name_ends_at(line_text, idx + name.len())

## the first 1-based byte column where name occurs in a line as a
## whole identifier, or 0 when it never does.
pub fn word_col_in_line(line_text: String, name: String) -> Int:
    mut col := 1
    while col + name.len() - 1 <= line_text.len():
        if word_starts_at(line_text, col, name):
            return col
        col = col + 1
    return 0

## where a top-level declaration's name sits in the source: ast nodes
## carry the position of their last token, so the name is found by
## scanning lines for the declaring keyword instead. returns the name's
## 1-based line and byte column, or line 0 when no line matches.
pub fn find_decl_position(text: String, node_kind: String, name: String) -> PithPos:
    keyword := decl_keyword(node_kind)
    plain := keyword + " " + name
    public := "pub " + plain
    total := text_line_count(text)
    mut line0 := 0
    while line0 < total:
        line := text_line(text, line0)
        # methods inside an impl block are indented; measure the indent
        # so their names locate at the real column, not just at column 1
        mut indent := 0
        while indent < line.len() and line[indent] == " ":
            indent = indent + 1
        body := line.substring(indent, line.len())
        mut name_col := 0 - 1
        if body.starts_with(plain):
            name_col = indent + keyword.len() + 1
        elif body.starts_with(public):
            name_col = indent + keyword.len() + 5
        if name_col >= 0 and name_ends_at(line, name_col + name.len()):
            return PithPos(line0 + 1, name_col + 1)
        line0 = line0 + 1
    return PithPos(0, 0)

# one SymbolInformation object {name, kind, location} for a declaration
# in a file's text, locating the name by the declaration-line scan and
# falling back to the node position when the scan finds nothing.
fn symbol_information_json(uri: String, text: String, node_kind: String, kind_num: Int, name: String, fallback: PithPos, mode: String) -> Int:
    mut at := find_decl_position(text, node_kind, name)
    if at.line == 0:
        at = fallback
    start := line_col_to_lsp_pos(text, at.line, at.col, mode)
    end := line_col_to_lsp_pos(text, at.line, at.col + name.len(), mode)
    range := json.make_object()
    start_obj := json.make_object()
    json.object_set(start_obj, "line", json.make_int(start.line))
    json.object_set(start_obj, "character", json.make_int(start.character))
    end_obj := json.make_object()
    json.object_set(end_obj, "line", json.make_int(end.line))
    json.object_set(end_obj, "character", json.make_int(end.character))
    json.object_set(range, "start", start_obj)
    json.object_set(range, "end", end_obj)
    location := json.make_object()
    json.object_set(location, "uri", json.make_string(uri))
    json.object_set(location, "range", range)
    entry := json.make_object()
    json.object_set(entry, "name", json.make_string(name))
    json.object_set(entry, "kind", json.make_int(kind_num))
    json.object_set(entry, "location", location)
    return entry

## the flat symbol list for a document as a json array handle: one
## SymbolInformation entry per top-level fn, struct, enum, and
## interface declaration.
pub fn document_symbols(uri: String) -> Int:
    path := uri_to_path(uri)
    text := document_text(uri)
    mode := get_position_encoding()
    arr := json.make_array()
    if analyzed_root < 0:
        return arr
    root := get_node(analyzed_root)
    for child_idx in root.children:
        if file_for_node(child_idx) != path:
            continue
        child := get_node(unwrap_pub(child_idx))
        kind_num := symbol_kind_number(child.kind)
        if kind_num == 0:
            continue
        name := bare_symbol_name(child.value)
        entry := symbol_information_json(uri, text, child.kind, kind_num, name, PithPos(child.line, child.col), mode)
        json.array_push(arr, entry)
    return arr

## SymbolInformation entries for the top-level fn, struct, enum, and
## interface declarations across every file the last analysis walked —
## the analyzed document and each module it imported, transitively.
## the query filters names by case-insensitive (ascii) substring; ""
## matches everything. capped at 200 entries.
pub fn workspace_symbols(query: String) -> Int:
    arr := json.make_array()
    if analyzed_root < 0:
        return arr
    mode := get_position_encoding()
    needle := query.to_lower()
    mut roots: List[Int] := [analyzed_root]
    for imp_root in analyzed_import_roots:
        roots.push(imp_root)
    mut emitted := 0
    for root_idx in roots:
        root := get_node(root_idx)
        for child_idx in root.children:
            if emitted >= MAX_WORKSPACE_SYMBOLS:
                continue
            decl_idx := unwrap_pub(child_idx)
            child := get_node(decl_idx)
            kind_num := symbol_kind_number(child.kind)
            if kind_num == 0:
                continue
            name := bare_symbol_name(child.value)
            if needle != "" and not name.to_lower().contains(needle):
                continue
            path := file_for_node(decl_idx)
            if path == "":
                continue
            text := dr_read_source(path) catch ""
            entry := symbol_information_json(path_to_uri(path), text, child.kind, kind_num, name, PithPos(child.line, child.col), mode)
            json.array_push(arr, entry)
            emitted = emitted + 1
    return arr

# ---------------------------------------------------------------
# code actions
# ---------------------------------------------------------------

# a Position json object from a compiler position.
fn position_json(text: String, line: Int, col: Int, mode: String) -> Int:
    at := line_col_to_lsp_pos(text, line, col, mode)
    obj := json.make_object()
    json.object_set(obj, "line", json.make_int(at.line))
    json.object_set(obj, "character", json.make_int(at.character))
    return obj

# the fix text of the stored diagnostic matching a client diagnostic:
# same code, same start position once the stored line/col converts to
# the negotiated encoding. "" when nothing matches — the client may
# hold diagnostics from a text this analysis no longer describes.
fn fix_for_client_diagnostic(d: Int, stored: List[Diagnostic], text: String, mode: String) -> String:
    code := json.object_get_string_or(d, "code", "")
    if code == "":
        return ""
    range := json.object_get(d, "range")
    if range < 0:
        return ""
    start := json.object_get(range, "start")
    if start < 0:
        return ""
    line0 := json.object_get_int_or(start, "line", 0 - 1)
    character := json.object_get_int_or(start, "character", 0 - 1)
    mut fix := ""
    for s in stored:
        if fix == "" and s.code == code and s.fix != "":
            at := line_col_to_lsp_pos(text, s.line, s.col, mode)
            if at.line == line0 and at.character == character:
                fix = s.fix
    return fix

# the quickfix action applying E216's "declare with 'mut'" suggestion:
# a WorkspaceEdit inserting "mut " in front of the binding the checker
# recorded for the name the fix carries. -1 when the binding cannot be
# pinned to an identifier in this document — an advisory title without
# an edit would be a button that does nothing.
fn mut_quickfix_action(uri: String, text: String, mode: String, fix: String, d: Int) -> Int:
    name := fix.substring(MUT_FIX_PREFIX.len(), fix.len())
    binding := binding_by_name(name)
    if binding.1 < 0:
        return 0 - 1
    if file_for_node(binding.1) != uri_to_path(uri):
        return 0 - 1
    # a binding node sits at its initializer's last token; the name is
    # found by scanning the declaring line, as rename does
    decl := get_node(binding.1)
    col := word_col_in_line(text_line(text, decl.line - 1), name)
    if col == 0:
        return 0 - 1
    range := json.make_object()
    json.object_set(range, "start", position_json(text, decl.line, col, mode))
    json.object_set(range, "end", position_json(text, decl.line, col, mode))
    edit := json.make_object()
    json.object_set(edit, "range", range)
    json.object_set(edit, "newText", json.make_string("mut "))
    edits := json.make_array()
    json.array_push(edits, edit)
    changes := json.make_object()
    json.object_set(changes, uri, edits)
    workspace_edit := json.make_object()
    json.object_set(workspace_edit, "changes", changes)
    diags := json.make_array()
    json.array_push(diags, d)
    action := json.make_object()
    json.object_set(action, "title", json.make_string(fix))
    json.object_set(action, "kind", json.make_string("quickfix"))
    json.object_set(action, "diagnostics", diags)
    json.object_set(action, "edit", workspace_edit)
    return action

## quickfix actions for the diagnostics a codeAction request carries,
## as a json array handle. only mechanically applicable fixes become
## actions — today that is E216's "declare with 'mut'". every other
## fix the compiler attaches is advice in prose, which stays in the
## diagnostic message instead of becoming an action with no edit.
pub fn code_actions(uri: String, params: Int) -> Int:
    arr := json.make_array()
    path := uri_to_path(uri)
    text := document_text(uri)
    mode := get_position_encoding()
    context := json.object_get(params, "context")
    if context < 0:
        return arr
    diags := json.object_get(context, "diagnostics")
    if diags < 0 or json.type_of(diags) != "array":
        return arr
    mut stored: List[Diagnostic] := []
    if last_diags_by_path.contains_key(path):
        stored = last_diags_by_path[path]
    mut i := 0
    while i < json.array_len(diags):
        d := json.array_get(diags, i)
        fix := fix_for_client_diagnostic(d, stored, text, mode)
        if fix.starts_with(MUT_FIX_PREFIX):
            action := mut_quickfix_action(uri, text, mode, fix, d)
            if action >= 0:
                json.array_push(arr, action)
        i = i + 1
    return arr

# ---------------------------------------------------------------
# formatting
# ---------------------------------------------------------------

## the edits that format a document: an empty array when the text is
## already formatted, otherwise one edit replacing the whole document.
pub fn formatting_edits(uri: String) -> Int:
    text := document_text(uri)
    arr := json.make_array()
    formatted := fmt_source(text)
    if formatted == text:
        return arr
    start_obj := json.make_object()
    json.object_set(start_obj, "line", json.make_int(0))
    json.object_set(start_obj, "character", json.make_int(0))
    end_obj := json.make_object()
    json.object_set(end_obj, "line", json.make_int(text_line_count(text) + 1))
    json.object_set(end_obj, "character", json.make_int(0))
    range := json.make_object()
    json.object_set(range, "start", start_obj)
    json.object_set(range, "end", end_obj)
    edit := json.make_object()
    json.object_set(edit, "range", range)
    json.object_set(edit, "newText", json.make_string(formatted))
    json.array_push(arr, edit)
    return arr
