# text_processing: a word-frequency report.
#
# counts the words in a short passage with a Map, ranks them with a
# comparator sort, and prints a small bar chart. std.strings splits the text
# into lines and words; punctuation is stripped and case folded first so
# "The" and "the," count as the same word.

import std.collections as collections
import std.strings as strings

struct WordCount:
    word: String
    count: Int

# words this short carry no meaning in a frequency report
fn is_stop_word(word: String) -> Bool:
    return ["a", "an", "and", "at", "in", "is", "it", "not", "of", "the", "to", "was"].contains(word)

fn normalize(word: String) -> String:
    return strings.trim_right_chars(strings.trim_left_chars(word.to_lower(), "\"'("), ".,;:!?\"')")

fn count_words(text: String) -> Map[String, Int]:
    mut counts: Map[String, Int] := {}
    for raw in strings.words(text):
        word := normalize(raw)
        if word.is_empty() or is_stop_word(word):
            continue
        counts[word] = counts.get(word).unwrap_or(0) + 1
    return counts

# highest count first, and alphabetical among equals so the order is stable
fn ranked(counts: Map[String, Int]) -> List[WordCount]:
    entries := counts.keys().map(fn(word: String) => WordCount(word: word, count: counts[word]))
    return collections.sorted_by(entries, fn(a: WordCount, b: WordCount) => a.count > b.count or (a.count == b.count and a.word < b.word))

fn main():
    passage := strings.join_lines([
        "The sea was calm, and the boat drifted.",
        "The boat was small; the sea was not.",
        "At dawn the gulls came, and the sea turned grey.",
])

    lines := strings.lines(passage)
    words := strings.words(passage)
    longest := collections.max_by(words, fn(w: String) => normalize(w).len()) catch ""
    print("lines: {lines.len()}, words: {words.len()}, longest: {normalize(longest)}")

    counts := count_words(passage)
    print("distinct words (no stop words): {counts.len()}")
    print("")
    for entry in ranked(counts).slice(0, 5):
        print("{entry.word:<8} {entry.count:>2} {"#".repeat(entry.count)}")

    # the line each word first shows up on, numbered from one
    print("")
    for target in ["boat", "gulls", "anchor"]:
        mut found := "not found"
        for line, index in lines:
            if strings.words(line).map(normalize).contains(target):
                found = "line {index + 1}"
                break
        print("{target}: {found}")
