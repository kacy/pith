fn word32_to_hex(val: Int) -> String:
    hex := "0123456789abcdef"
    mut result := ""
    mut i := 0
    while i < 8:
        nibble := bits.band(bits.shr(val, 28 - i * 4), 15)
        result = result + hex[nibble]
        i = i + 1
    return result

fn word64_to_hex(val: Int) -> String:
    hex := "0123456789abcdef"
    mut result := ""
    mut i := 0
    while i < 16:
        nibble := bits.band(bits.shr(val, 60 - i * 4), 15)
        result = result + hex[nibble]
        i = i + 1
    return result

fn add64_4(a: Int, b: Int, c: Int, d: Int) -> Int:
    return bits.add64(bits.add64(bits.add64(a, b), c), d)

fn add64_5(a: Int, b: Int, c: Int, d: Int, e: Int) -> Int:
    return bits.add64(add64_4(a, b, c, d), e)

fn word64_from_be(msg: List[Int], off: Int) -> Int:
    return bits.bor(bits.bor(bits.bor(bits.bor(bits.bor(bits.bor(bits.bor(bits.shl(msg[off], 56), bits.shl(msg[off + 1], 48)), bits.shl(msg[off + 2], 40)), bits.shl(msg[off + 3], 32)), bits.shl(msg[off + 4], 24)), bits.shl(msg[off + 5], 16)), bits.shl(msg[off + 6], 8)), msg[off + 7])

# the padded tail of a message (fips 180-4 section 5.1): the input bytes
# from `start` to the end, then the 0x80 terminator, zeros up to the length
# field, and the length of the whole input in bits as a big-endian integer
# filling the field. `block_size` is 64 or 128 and the result is one or
# two whole blocks. the kernels hash every whole block straight out of the
# input and only this tail through a List[Int], so the byte-at-a-time work
# is bounded by two blocks however long the input is.
fn sha_padded_tail(input: Bytes, start: Int, block_size: Int) -> List[Int]:
    mut tail: List[Int] := []
    n := input.len()
    mut i := start
    while i < n:
        tail.push(input[i])
        i = i + 1
    tail.push(128)
    # the length field is block_size / 8 bytes wide: eight for the 64-byte
    # block, sixteen for the 128-byte one. zeros run up to the field, and
    # the field's own high bytes beyond the eight the bit count occupies
    # are zero as well.
    while tail.len() % block_size != block_size - block_size / 8:
        tail.push(0)
    while tail.len() % block_size != block_size - 8:
        tail.push(0)
    bit_len := n * 8
    tail.push(bits.mask8(bits.shr(bit_len, 56)))
    tail.push(bits.mask8(bits.shr(bit_len, 48)))
    tail.push(bits.mask8(bits.shr(bit_len, 40)))
    tail.push(bits.mask8(bits.shr(bit_len, 32)))
    tail.push(bits.mask8(bits.shr(bit_len, 24)))
    tail.push(bits.mask8(bits.shr(bit_len, 16)))
    tail.push(bits.mask8(bits.shr(bit_len, 8)))
    tail.push(bits.mask8(bit_len))
    return tail

# a message schedule of `count` zero words, filled in place per block so
# the kernels allocate one list per digest rather than one per block.
fn zero_words(count: Int) -> List[Int]:
    mut w: List[Int] := []
    mut i := 0
    while i < count:
        w.push(0)
        i = i + 1
    return w

# reverse the byte order of a 32-bit value: bytes_read_word reads little-
# endian and the sha word order is big-endian. `value` is below 2^32.
fn swap32(value: Int) -> Int:
    return bits.bor(bits.bor(bits.shl(bits.band(value, 255), 24), bits.shl(bits.band(value, 65280), 8)), bits.bor(bits.band(bits.shr(value, 8), 65280), bits.shr(value, 24)))

# reverse the byte order of a 64-bit value, for the same reason as swap32.
# the result is the signed 64-bit reading of the big-endian bytes, which
# is what word64_from_be produces for the tail.
fn swap64(value: Int) -> Int:
    low := bits.bor(bits.bor(bits.shl(bits.band(value, 255), 56), bits.shl(bits.band(value, 65280), 40)), bits.bor(bits.shl(bits.band(value, 16711680), 24), bits.shl(bits.band(value, 4278190080), 8)))
    high := bits.bor(bits.bor(bits.band(bits.shr(value, 8), 4278190080), bits.band(bits.shr(value, 24), 16711680)), bits.bor(bits.band(bits.shr(value, 40), 65280), bits.shr(value, 56)))
    return bits.bor(low, high)

# fill w[0..16] with the sixteen big-endian 32-bit words of the 64-byte
# block at `off` in `input`. bytes_read_word is called by name because it
# lowers to one inlined eight-byte load where a per-byte subscript is a
# runtime call; every caller has off + 64 <= input.len(), so the read
# stays on that fast path and a pair of words is one load and two swaps.
fn sha_load_words32(w: List[Int], input: Bytes, off: Int):
    mut j := 0
    while j < 16:
        pair := bytes_read_word(input, off + j * 4, 8)
        w[j] = swap32(bits.band(pair, 4294967295))
        w[j + 1] = swap32(bits.shr(pair, 32))
        j = j + 2

# fill w[0..16] from the 64-byte block at `off` in a padded tail, whose
# entries are byte values.
fn sha_load_words32_tail(w: List[Int], tail: List[Int], off: Int):
    mut j := 0
    while j < 16:
        at := off + j * 4
        w[j] = tail[at] * 16777216 + tail[at + 1] * 65536 + tail[at + 2] * 256 + tail[at + 3]
        j = j + 1

# fill w[0..16] with the sixteen big-endian 64-bit words of the 128-byte
# block at `off` in `input`; see sha_load_words32 for the read.
fn sha_load_words64(w: List[Int], input: Bytes, off: Int):
    mut j := 0
    while j < 16:
        w[j] = swap64(bytes_read_word(input, off + j * 8, 8))
        j = j + 1

# fill w[0..16] from the 128-byte block at `off` in a padded tail.
fn sha_load_words64_tail(w: List[Int], tail: List[Int], off: Int):
    mut j := 0
    while j < 16:
        w[j] = word64_from_be(tail, off + j * 8)
        j = j + 1

# the 32-bit sha-2 core behind sha-224 and sha-256. whole 64-byte blocks
# are hashed straight out of `input`; the final partial block and the
# padding go through sha_padded_tail. sha2_32_reference below is the
# copy-everything-into-a-list definition this replaced, kept as the
# oracle the randomized test compares against.
fn sha2_32(input: Bytes, ih0: Int, ih1: Int, ih2: Int, ih3: Int, ih4: Int, ih5: Int, ih6: Int, ih7: Int, words: Int) -> String:
    mut h0 := ih0
    mut h1 := ih1
    mut h2 := ih2
    mut h3 := ih3
    mut h4 := ih4
    mut h5 := ih5
    mut h6 := ih6
    mut h7 := ih7

    n := input.len()
    full := n - n % 64
    tail := sha_padded_tail(input, full, 64)
    total := full + tail.len()
    w := zero_words(64)

    mut block := 0
    while block < total:
        if block < full:
            sha_load_words32(w, input, block)
        else:
            sha_load_words32_tail(w, tail, block - full)
        # a 32-bit rotate right by k is spelled band(bor(shr(x, k), shl(x,
        # 32 - k)), 2^32 - 1): the two-argument bits.* forms lower to single
        # instructions, where bits.rotr32 and mask32 are calls. the sums are
        # masked once at the end, which is the same value modulo 2^32.
        mut i := 16
        while i < 64:
            x := w[i - 15]
            s0 := bits.band(bits.xor(bits.xor(bits.bor(bits.shr(x, 7), bits.shl(x, 25)), bits.bor(bits.shr(x, 18), bits.shl(x, 14))), bits.shr(x, 3)), 4294967295)
            y := w[i - 2]
            s1 := bits.band(bits.xor(bits.xor(bits.bor(bits.shr(y, 17), bits.shl(y, 15)), bits.bor(bits.shr(y, 19), bits.shl(y, 13))), bits.shr(y, 10)), 4294967295)
            w[i] = bits.band(w[i - 16] + s0 + w[i - 7] + s1, 4294967295)
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4
        mut f := h5
        mut g := h6
        mut h := h7

        i = 0
        while i < 64:
            s1 := bits.band(bits.xor(bits.xor(bits.bor(bits.shr(e, 6), bits.shl(e, 26)), bits.bor(bits.shr(e, 11), bits.shl(e, 21))), bits.bor(bits.shr(e, 25), bits.shl(e, 7))), 4294967295)
            ch := bits.xor(bits.band(e, f), bits.band(bits.xor(e, 4294967295), g))
            temp1 := bits.band(h + s1 + ch + sha256_round_constants[i] + w[i], 4294967295)
            s0 := bits.band(bits.xor(bits.xor(bits.bor(bits.shr(a, 2), bits.shl(a, 30)), bits.bor(bits.shr(a, 13), bits.shl(a, 19))), bits.bor(bits.shr(a, 22), bits.shl(a, 10))), 4294967295)
            maj := bits.xor(bits.xor(bits.band(a, b), bits.band(a, c)), bits.band(b, c))
            temp2 := bits.band(s0 + maj, 4294967295)
            h = g
            g = f
            f = e
            e = bits.band(d + temp1, 4294967295)
            d = c
            c = b
            b = a
            a = bits.band(temp1 + temp2, 4294967295)
            i = i + 1

        h0 = bits.band(h0 + a, 4294967295)
        h1 = bits.band(h1 + b, 4294967295)
        h2 = bits.band(h2 + c, 4294967295)
        h3 = bits.band(h3 + d, 4294967295)
        h4 = bits.band(h4 + e, 4294967295)
        h5 = bits.band(h5 + f, 4294967295)
        h6 = bits.band(h6 + g, 4294967295)
        h7 = bits.band(h7 + h, 4294967295)
        block = block + 64

    mut out := word32_to_hex(h0) + word32_to_hex(h1) + word32_to_hex(h2) + word32_to_hex(h3) + word32_to_hex(h4) + word32_to_hex(h5) + word32_to_hex(h6)
    if words > 7:
        out = out + word32_to_hex(h7)
    return out

# the 64-bit sha-2 core behind sha-384 and sha-512, shaped like sha2_32
# with 128-byte blocks and 80 rounds. sha2_64_reference below is the
# definition this replaced, kept as the randomized test's oracle.
fn sha2_64(input: Bytes, ih0: Int, ih1: Int, ih2: Int, ih3: Int, ih4: Int, ih5: Int, ih6: Int, ih7: Int, words: Int) -> String:
    mut h0 := ih0
    mut h1 := ih1
    mut h2 := ih2
    mut h3 := ih3
    mut h4 := ih4
    mut h5 := ih5
    mut h6 := ih6
    mut h7 := ih7

    n := input.len()
    full := n - n % 128
    tail := sha_padded_tail(input, full, 128)
    total := full + tail.len()
    w := zero_words(80)

    mut block := 0
    while block < total:
        if block < full:
            sha_load_words64(w, input, block)
        else:
            sha_load_words64_tail(w, tail, block - full)
        # a 64-bit rotate right by k is spelled bor(shr(x, k), shl(x, 64 -
        # k)), for the reason given in sha2_32; bits.shr is a logical shift,
        # so it is right on the negative half of the range too. Int addition
        # wraps at 64 bits, which is what bits.add64 relied on as well.
        mut i := 16
        while i < 80:
            x := w[i - 15]
            s0 := bits.xor(bits.xor(bits.bor(bits.shr(x, 1), bits.shl(x, 63)), bits.bor(bits.shr(x, 8), bits.shl(x, 56))), bits.shr(x, 7))
            y := w[i - 2]
            s1 := bits.xor(bits.xor(bits.bor(bits.shr(y, 19), bits.shl(y, 45)), bits.bor(bits.shr(y, 61), bits.shl(y, 3))), bits.shr(y, 6))
            w[i] = w[i - 16] + s0 + w[i - 7] + s1
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4
        mut f := h5
        mut g := h6
        mut h := h7

        i = 0
        while i < 80:
            s1 := bits.xor(bits.xor(bits.bor(bits.shr(e, 14), bits.shl(e, 50)), bits.bor(bits.shr(e, 18), bits.shl(e, 46))), bits.bor(bits.shr(e, 41), bits.shl(e, 23)))
            ch := bits.xor(bits.band(e, f), bits.band(bits.xor(e, -1), g))
            temp1 := h + s1 + ch + sha512_round_constants[i] + w[i]
            s0 := bits.xor(bits.xor(bits.bor(bits.shr(a, 28), bits.shl(a, 36)), bits.bor(bits.shr(a, 34), bits.shl(a, 30))), bits.bor(bits.shr(a, 39), bits.shl(a, 25)))
            maj := bits.xor(bits.xor(bits.band(a, b), bits.band(a, c)), bits.band(b, c))
            temp2 := s0 + maj
            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
            i = i + 1

        h0 = h0 + a
        h1 = h1 + b
        h2 = h2 + c
        h3 = h3 + d
        h4 = h4 + e
        h5 = h5 + f
        h6 = h6 + g
        h7 = h7 + h
        block = block + 128

    mut out := word64_to_hex(h0) + word64_to_hex(h1) + word64_to_hex(h2) + word64_to_hex(h3) + word64_to_hex(h4) + word64_to_hex(h5)
    if words > 6:
        out = out + word64_to_hex(h6)
    if words > 7:
        out = out + word64_to_hex(h7)
    return out

# the copy-everything-into-a-list sha2_32 this module shipped before the
# kernels read the input directly, kept verbatim so the randomized test
# has an independent definition to agree with. not part of the module's
# surface.
fn sha2_32_reference(input: Bytes, ih0: Int, ih1: Int, ih2: Int, ih3: Int, ih4: Int, ih5: Int, ih6: Int, ih7: Int, words: Int) -> String:
    mut h0 := ih0
    mut h1 := ih1
    mut h2 := ih2
    mut h3 := ih3
    mut h4 := ih4
    mut h5 := ih5
    mut h6 := ih6
    mut h7 := ih7

    mut msg: List[Int] := []
    mut i := 0
    while i < input.len():
        msg.push(input[i])
        i = i + 1

    msg.push(128)
    while msg.len() % 64 != 56:
        msg.push(0)

    bit_len := input.len() * 8
    msg.push(bits.mask8(bits.shr(bit_len, 56)))
    msg.push(bits.mask8(bits.shr(bit_len, 48)))
    msg.push(bits.mask8(bits.shr(bit_len, 40)))
    msg.push(bits.mask8(bits.shr(bit_len, 32)))
    msg.push(bits.mask8(bits.shr(bit_len, 24)))
    msg.push(bits.mask8(bits.shr(bit_len, 16)))
    msg.push(bits.mask8(bits.shr(bit_len, 8)))
    msg.push(bits.mask8(bit_len))

    mut block := 0
    while block < msg.len():
        mut w: List[Int] := []
        i = 0
        while i < 16:
            off := block + i * 4
            word := msg[off] * 16777216 + msg[off + 1] * 65536 + msg[off + 2] * 256 + msg[off + 3]
            w.push(word)
            i = i + 1
        while i < 64:
            s0 := bits.xor(bits.xor(rotate_right(w[i - 15], 7), rotate_right(w[i - 15], 18)), bits.shr(w[i - 15], 3))
            s1 := bits.xor(bits.xor(rotate_right(w[i - 2], 17), rotate_right(w[i - 2], 19)), bits.shr(w[i - 2], 10))
            w.push(mask32(w[i - 16] + s0 + w[i - 7] + s1))
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4
        mut f := h5
        mut g := h6
        mut h := h7

        i = 0
        while i < 64:
            s1 := bits.xor(bits.xor(rotate_right(e, 6), rotate_right(e, 11)), rotate_right(e, 25))
            ch := bits.xor(bits.band(e, f), bits.band(mask32(bits.invert(e)), g))
            temp1 := mask32(h + s1 + ch + sha256_round_constants[i] + w[i])
            s0 := bits.xor(bits.xor(rotate_right(a, 2), rotate_right(a, 13)), rotate_right(a, 22))
            maj := bits.xor(bits.xor(bits.band(a, b), bits.band(a, c)), bits.band(b, c))
            temp2 := mask32(s0 + maj)
            h = g
            g = f
            f = e
            e = mask32(d + temp1)
            d = c
            c = b
            b = a
            a = mask32(temp1 + temp2)
            i = i + 1

        h0 = mask32(h0 + a)
        h1 = mask32(h1 + b)
        h2 = mask32(h2 + c)
        h3 = mask32(h3 + d)
        h4 = mask32(h4 + e)
        h5 = mask32(h5 + f)
        h6 = mask32(h6 + g)
        h7 = mask32(h7 + h)
        block = block + 64

    mut out := word32_to_hex(h0) + word32_to_hex(h1) + word32_to_hex(h2) + word32_to_hex(h3) + word32_to_hex(h4) + word32_to_hex(h5) + word32_to_hex(h6)
    if words > 7:
        out = out + word32_to_hex(h7)
    return out

# the copy-everything-into-a-list sha2_64 this module shipped before the
# kernels read the input directly, kept verbatim as the randomized test's
# oracle. not part of the module's surface.
fn sha2_64_reference(input: Bytes, ih0: Int, ih1: Int, ih2: Int, ih3: Int, ih4: Int, ih5: Int, ih6: Int, ih7: Int, words: Int) -> String:
    mut h0 := ih0
    mut h1 := ih1
    mut h2 := ih2
    mut h3 := ih3
    mut h4 := ih4
    mut h5 := ih5
    mut h6 := ih6
    mut h7 := ih7

    mut msg: List[Int] := []
    mut i := 0
    while i < input.len():
        msg.push(input[i])
        i = i + 1

    msg.push(128)
    while msg.len() % 128 != 112:
        msg.push(0)

    i = 0
    while i < 8:
        msg.push(0)
        i = i + 1

    bit_len := input.len() * 8
    msg.push(bits.mask8(bits.shr(bit_len, 56)))
    msg.push(bits.mask8(bits.shr(bit_len, 48)))
    msg.push(bits.mask8(bits.shr(bit_len, 40)))
    msg.push(bits.mask8(bits.shr(bit_len, 32)))
    msg.push(bits.mask8(bits.shr(bit_len, 24)))
    msg.push(bits.mask8(bits.shr(bit_len, 16)))
    msg.push(bits.mask8(bits.shr(bit_len, 8)))
    msg.push(bits.mask8(bit_len))

    mut block := 0
    while block < msg.len():
        mut w: List[Int] := []
        i = 0
        while i < 16:
            w.push(word64_from_be(msg, block + i * 8))
            i = i + 1
        while i < 80:
            s0 := bits.xor(bits.xor(bits.rotr64(w[i - 15], 1), bits.rotr64(w[i - 15], 8)), bits.shr(w[i - 15], 7))
            s1 := bits.xor(bits.xor(bits.rotr64(w[i - 2], 19), bits.rotr64(w[i - 2], 61)), bits.shr(w[i - 2], 6))
            w.push(add64_4(w[i - 16], s0, w[i - 7], s1))
            i = i + 1

        mut a := h0
        mut b := h1
        mut c := h2
        mut d := h3
        mut e := h4
        mut f := h5
        mut g := h6
        mut h := h7

        i = 0
        while i < 80:
            s1 := bits.xor(bits.xor(bits.rotr64(e, 14), bits.rotr64(e, 18)), bits.rotr64(e, 41))
            ch := bits.xor(bits.band(e, f), bits.band(bits.invert(e), g))
            temp1 := add64_5(h, s1, ch, sha512_round_constants[i], w[i])
            s0 := bits.xor(bits.xor(bits.rotr64(a, 28), bits.rotr64(a, 34)), bits.rotr64(a, 39))
            maj := bits.xor(bits.xor(bits.band(a, b), bits.band(a, c)), bits.band(b, c))
            temp2 := bits.add64(s0, maj)
            h = g
            g = f
            f = e
            e = bits.add64(d, temp1)
            d = c
            c = b
            b = a
            a = bits.add64(temp1, temp2)
            i = i + 1

        h0 = bits.add64(h0, a)
        h1 = bits.add64(h1, b)
        h2 = bits.add64(h2, c)
        h3 = bits.add64(h3, d)
        h4 = bits.add64(h4, e)
        h5 = bits.add64(h5, f)
        h6 = bits.add64(h6, g)
        h7 = bits.add64(h7, h)
        block = block + 128

    mut out := word64_to_hex(h0) + word64_to_hex(h1) + word64_to_hex(h2) + word64_to_hex(h3) + word64_to_hex(h4) + word64_to_hex(h5)
    if words > 6:
        out = out + word64_to_hex(h6)
    if words > 7:
        out = out + word64_to_hex(h7)
    return out

# compute a sha-256 digest and return it as lowercase hex.
pub fn sha256(input: Bytes) -> String:
    return sha2_32(input, 1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225, 8)

fn hash_sha256(input: Bytes) -> String:
    return sha256(input)

# compute a sha-256 digest and return raw bytes.
pub fn sha256_bytes(input: Bytes) -> Bytes:
    return encoding.from_hex(sha256(input)) catch bytes.empty()

# compute a sha-256 digest and return lowercase hex.
pub fn sha256_hex(input: Bytes) -> String:
    return sha256(input)

# hash a utf-8 string with sha-256.
pub fn sha256_string(input: String) -> String:
    return sha256(bytes.from_string_utf8(input))

fn hash_sha256_string(input: String) -> String:
    return sha256_string(input)

