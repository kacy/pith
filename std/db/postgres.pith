# std.db.postgres — the pooled, opinionated postgres entry point.
#
# open a pool from a url and run explicit sql; every query and exec borrows a
# connection from the pool and returns it, so many green tasks can share one
# `Db`:
#
#   import std.db.postgres as db
#   import std.sql as sql
#
#   handle := db.open("postgres://me:pw@127.0.0.1:5432/app")!
#   rows := handle.query("select id, name from users where id = $1", ["7"])!
#   for row in rows:
#       print("{row.int(\"id\")} {row.text(\"name\")}")
#   handle.close()
#
# parameters bind postgres-style with `$1`, `$2`, ... placeholders. use `query`
# for selects and `exec` for writes; to read back a generated id, add
# `returning id` to the insert and read it with `query`.
#
# for a group of statements that must succeed or fail together, open a
# transaction with `begin` and finish it with `commit` or `rollback`; for a hot
# query run many times, prepare it once with `prepare`. both pin a single
# connection for their lifetime — see the sections below.
#
# query and exec are observable in the box: each records a RED metric (a
# db_queries_total counter and a db_query_duration_ms histogram, labeled by
# driver and op) and opens a client trace span, the same story as the http and
# grpc clients.

import std.db as db
import std.postgres as postgres
import std.sql as sql
import std.metrics as metrics
import std.trace as trace
import std.time as time

# a pooled handle to a postgres database. it holds its pool, which
# synchronizes itself, so one Db is safe to share across tasks; a copy of a Db
# is another count on the same pool, not a second pool.
#
# a Db nobody closes needs no destructor of its own: when its last count goes,
# the pool goes with it (unless a Tx or Stmt still holds it), and every idle
# connection in the pool closes its socket from its own destructor.
pub struct Db:
    pool: postgres.Pool

# open a pooled postgres database from a url. the url sets the host, port,
# credentials, database, and optional `?pool=N` cap on open connections; see
# std.db.parse_url for the full shape. connections open lazily, on first use, and
# past the cap an acquirer waits for one to free rather than opening more.
pub fn open(url: String) -> Db!:
    dsn := db.parse_url(url)!
    if dsn.driver != "postgres":
        fail "db.postgres: url is not a postgres url: {url}"
    return Db(pool: postgres.pool(dsn.host, dsn.port, dsn.user, dsn.password, dsn.dbname, dsn.pool_size))

# --- pinned connections (transactions and prepared statements) ---
#
# a transaction runs every statement on one connection, and a prepared statement
# is parsed once on one connection and reused; both therefore pin a connection
# out of the pool for their lifetime and return it when they finish. the Tx or
# Stmt holds its Pin, and the Pin is the one owner of the connection while the
# pin is live.

# a connection pinned out of a pool. `pool` is the pool it came from, held as a
# value so the connection can go back there even after the Db that opened it is
# gone. `broken` turns true when a statement on it fails: a failed statement
# leaves the connection out of protocol sync, so it is discarded rather than
# returned to the pool. `finished` guards against use after the transaction or
# statement has ended.
#
# `conn` is none while a statement has the connection out (see take) and once
# the pin finishes. every changing field sits under `mu`, and each method takes
# it around a few field reads or writes only; the connection i/o happens after
# the unlock.
struct Pin:
    guard mu:
        mut conn: postgres.Conn?
        mut broken: Bool
        mut finished: Bool
    pool: postgres.Pool

# pin a fresh connection from `pool`. the caller then runs BEGIN or PREPARE on
# the pinned connection.
fn pin_connection(pool: postgres.Pool) -> Pin!:
    conn := pool.acquire()!
    return Pin(conn: conn, broken: false, finished: false, pool: pool)

# every prepared statement is parsed under this one name. a Stmt pins its own
# connection, so the fixed name never collides across statements; it is
# deallocated when the Stmt closes, before the connection returns to the pool.
PREPARED_NAME := "pith_db_stmt"

impl Pin:
    # take the pinned connection out for one statement, failing with `ended`
    # once the pin has finished. the pin holds no connection until put hands it
    # back, so two tasks using one Tx or Stmt at once never share it: the
    # second fails on the empty pin instead.
    fn take(ended: String) -> postgres.Conn!:
        mut found: postgres.Conn? := none
        mut done := false
        locked self.mu:
            done = self.finished
            found = self.conn
            self.conn = none
        if done:
            fail ended
        if found == none:
            fail "db.postgres: the pinned connection is in use by another task"
        return found.value()

    # hand the connection back once the statement is done. the pin keeps it, so
    # the caller does not use it again.
    fn put(conn: postgres.Conn):
        locked self.mu:
            self.conn = conn

    # whether the pin has ended (committed, closed, or discarded).
    fn is_finished() -> Bool:
        locked self.mu:
            done := self.finished
            return done

    # whether a statement on the pinned connection has failed.
    fn is_broken() -> Bool:
        locked self.mu:
            broken := self.broken
            return broken

    # mark the pinned connection out of sync after a failed statement.
    fn mark_broken():
        locked self.mu:
            self.broken = true

    # end the pin and hand back its connection, or none if it had already
    # ended. only the first call gets the connection.
    fn finish() -> postgres.Conn?:
        mut conn: postgres.Conn? := none
        locked self.mu:
            if not self.finished:
                self.finished = true
                conn = self.conn
                self.conn = none
        return conn

    # end the pin and return its connection to the pool for reuse.
    fn release():
        conn := self.finish()
        if conn != none:
            self.pool.release(conn.value())

    # end the pin and close its connection instead of reusing it, for when it
    # is out of protocol sync. its cap slot still returns to the pool.
    fn discard():
        conn := self.finish()
        if conn != none:
            self.pool.discard(conn.value())

# a Tx or Stmt dropped without commit, rollback or close ends its pin here. a
# destructor must not do network i/o, so it cannot send ROLLBACK or DEALLOCATE,
# and the connection cannot go back to the pool with a transaction or a
# statement still open on it. it closes the socket instead, without a tls
# close_notify, and returns the cap slot. postgres rolls back an open
# transaction and frees the session's prepared statements when its client goes
# away, so the work is undone on the server and the pool loses nothing.
impl Drop for Pin:
    fn drop():
        conn := self.finish()
        if conn != none:
            self.pool.abandon(conn.value())

# a transaction: a connection pinned out of the pool with BEGIN already sent.
# finish it with commit() or rollback(). one dropped without either is rolled
# back by closing its connection (see the Pin destructor above).
pub struct Tx:
    pin: Pin

TX_ENDED := "db.postgres: transaction already finished"
STMT_ENDED := "db.postgres: prepared statement already closed"

impl Tx:
    # run a query inside the transaction, on its pinned connection. the rows read
    # the same as Db.query's.
    pub fn query(text: String, params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(text, params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run a write inside the transaction, on its pinned connection.
    pub fn exec(text: String, params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(text, params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    fn run_query(text: String, params: List[String]) -> List[sql.Row]!:
        conn := self.pin.take(TX_ENDED)!
        attempt := postgres.query_params(conn, text, params)
        self.pin.put(conn)
        if attempt.is_err:
            self.pin.mark_broken()
            fail attempt.err
        mut rows: List[sql.Row] := []
        for row in attempt.ok:
            rows.push(row)
        return rows

    fn run_exec(text: String, params: List[String]) -> db.ExecResult!:
        conn := self.pin.take(TX_ENDED)!
        attempt := postgres.exec_params(conn, text, params)
        self.pin.put(conn)
        if attempt.is_err:
            self.pin.mark_broken()
            fail attempt.err
        return db.exec_result(attempt.ok, 0)

    # commit the transaction and return the connection to the pool. a
    # transaction with a failed statement cannot commit — it is rolled back (its
    # connection discarded) and this fails.
    pub fn commit() -> Bool!:
        if self.pin.is_finished():
            fail TX_ENDED
        if self.pin.is_broken():
            self.pin.discard()
            fail "db.postgres: transaction has a failed statement; rolled back"
        conn := self.pin.take(TX_ENDED)!
        committed := postgres.exec(conn, "commit")
        self.pin.put(conn)
        if committed.is_err:
            self.pin.discard()
            fail committed.err
        self.pin.release()
        return true

    # roll back the transaction, discarding its changes, and return the
    # connection to the pool. it is always safe to call — on a failed statement
    # it discards the out-of-sync connection — so it fits an error path directly
    # without itself failing.
    pub fn rollback():
        if self.pin.is_finished():
            return
        if self.pin.is_broken():
            self.pin.discard()
            return
        taken := self.pin.take(TX_ENDED)
        if taken.is_err:
            return
        conn := taken.ok
        rolled := postgres.exec(conn, "rollback")
        self.pin.put(conn)
        if rolled.is_err:
            self.pin.discard()
            return
        self.pin.release()

# a prepared statement: a connection pinned out of the pool with the statement
# parsed on it. free it with close(); one dropped without close() has its
# connection closed, which frees the statement on the server too.
pub struct Stmt:
    pin: Pin

impl Stmt:
    # run the prepared statement as a query, binding `params`.
    pub fn query(params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run the prepared statement as a write, binding `params`.
    pub fn exec(params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    fn run_query(params: List[String]) -> List[sql.Row]!:
        conn := self.pin.take(STMT_ENDED)!
        attempt := postgres.query_prepared(conn, PREPARED_NAME, params)
        self.pin.put(conn)
        if attempt.is_err:
            self.pin.mark_broken()
            fail attempt.err
        mut rows: List[sql.Row] := []
        for row in attempt.ok:
            rows.push(row)
        return rows

    fn run_exec(params: List[String]) -> db.ExecResult!:
        conn := self.pin.take(STMT_ENDED)!
        attempt := postgres.exec_prepared(conn, PREPARED_NAME, params)
        self.pin.put(conn)
        if attempt.is_err:
            self.pin.mark_broken()
            fail attempt.err
        return db.exec_result(attempt.ok, 0)

    # deallocate the statement and return its connection to the pool. always safe
    # to call; a broken or already-closed statement simply drops its connection.
    pub fn close():
        if self.pin.is_finished():
            return
        if self.pin.is_broken():
            self.pin.discard()
            return
        taken := self.pin.take(STMT_ENDED)
        if taken.is_err:
            return
        conn := taken.ok
        freed := postgres.exec(conn, "deallocate {PREPARED_NAME}")
        self.pin.put(conn)
        if freed.is_err:
            self.pin.discard()
            return
        self.pin.release()

impl Db:
    # run a parameterized query and buffer its rows. `$1`, `$2`, ... bind to
    # `params` (in text form), keeping values off the sql string. the result is a
    # list of std.sql.Row — iterate it, index it, or pass it to std.db.first; each
    # row carries the typed accessors (row.int("id"), row.opt_text("email"), ...).
    pub fn query(text: String, params: List[String]) -> List[sql.Row]!:
        span := trace.start_kind("db.query", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_query(text, params)
        span.end()
        record("query", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # run a write (insert/update/delete/ddl) and report the rows it affected.
    # postgres does not return a generated id here — add `returning id` and use
    # `query` for that — so `last_insert_id` is always 0.
    pub fn exec(text: String, params: List[String]) -> db.ExecResult!:
        span := trace.start_kind("db.exec", trace.CLIENT)
        start := time.mono_millis()
        outcome := self.run_exec(text, params)
        span.end()
        record("exec", outcome.is_err, time.mono_millis() - start)
        if outcome.is_err:
            fail outcome.err
        return outcome.ok

    # borrow a connection, run the query, and return the connection to the pool.
    # a failed query leaves the connection out of protocol sync, so it is
    # discarded (closed, its slot returned) rather than reused.
    fn run_query(text: String, params: List[String]) -> List[sql.Row]!:
        conn := self.pool.acquire()!
        attempt := postgres.query_params(conn, text, params)
        if attempt.is_err:
            self.pool.discard(conn)
            fail attempt.err
        mut rows: List[sql.Row] := []
        for row in attempt.ok:
            rows.push(row)
        self.pool.release(conn)
        return rows

    # borrow a connection, run the write, and return the connection to the pool.
    fn run_exec(text: String, params: List[String]) -> db.ExecResult!:
        conn := self.pool.acquire()!
        attempt := postgres.exec_params(conn, text, params)
        if attempt.is_err:
            self.pool.discard(conn)
            fail attempt.err
        self.pool.release(conn)
        return db.exec_result(attempt.ok, 0)

    # begin a transaction on a single pinned connection. every statement you run
    # on the returned Tx uses that same connection; finish with commit() to keep
    # the changes or rollback() to discard them, and either way the connection
    # returns to the pool. see the Tx methods above.
    pub fn begin() -> Tx!:
        pin := pin_connection(self.pool)!
        # if BEGIN fails the pinned connection never becomes a live transaction,
        # so discard it; on success the Tx keeps the pin and this does not run.
        errdefer pin.discard()
        conn := pin.take(TX_ENDED)!
        started := postgres.exec(conn, "begin")
        pin.put(conn)
        if started.is_err:
            fail started.err
        return Tx(pin: pin)

    # prepare `text` once on a pinned connection so a hot query can run many
    # times without re-parsing. run it with Stmt.query / Stmt.exec and free it
    # with Stmt.close(), which returns the connection to the pool.
    pub fn prepare(text: String) -> Stmt!:
        pin := pin_connection(self.pool)!
        errdefer pin.discard()
        conn := pin.take(STMT_ENDED)!
        prepared := postgres.prepare(conn, PREPARED_NAME, text)
        pin.put(conn)
        if prepared.is_err:
            fail prepared.err
        return Stmt(pin: pin)

    # drain the pool, closing every idle connection. the connection close
    # network i/o happens in the pool, off its lock.
    pub fn close():
        self.pool.close()

# record the RED metrics for one operation: a count labeled ok/err and the
# duration in the shared histogram.
fn record(op: String, failed: Bool, elapsed_ms: Int):
    mut status := "ok"
    if failed:
        status = "err"
    metrics.counter("db_queries_total").labels(["driver", "postgres", "op", op, "status", status]).inc()
    metrics.histogram("db_query_duration_ms").labels(["driver", "postgres", "op", op]).observe(elapsed_ms.to_float())
