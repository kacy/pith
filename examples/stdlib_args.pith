# std.args: declare a tool's flags, options and positionals, then parse.
#
# std.args keeps one parser per program: declare the arguments with the add_*
# calls, parse once, and read the values anywhere. for a tool with
# subcommands, or to parse more than one argument list, std.cli is the
# stateless alternative (see stdlib_cli.pith).

from std.args import init, add_flag, add_option, add_positional, help_text
from std.args import parse_list, get_flag, get_option, get_positional, has_errors, get_errors

fn main() -> Int!:
    init("thumbs", "make thumbnails of the images in a directory")
    add_flag("dry-run", "n", "list what would be written")
    add_option("size", "s", "longest edge in pixels", "256")
    add_option("format", "f", "output format", "webp")
    add_positional("dir", "directory of images")
    print(help_text())
    print("")

    # a real tool calls parse(), which reads the process arguments. a fixed
    # list keeps this output the same however the example is run.
    parse_list(["-n", "--size", "128", "photos/"])
    if has_errors():
        print(get_errors())
        return 2

    size := parse_int(get_option("size")) catch:
        fail "--size must be a number"
    verb := if get_flag("dry-run"): "would write" else: "writing"
    print("{verb} {size}px {get_option("format")} thumbnails for {get_positional("dir")}")
    return 0
