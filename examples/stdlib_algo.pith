# stdlib_algo: sorting and searching with std.algo, plus the integer list
# helpers in std.collections.
#
# grades one test for a class: sorted scores give the median and the top
# three, binary search looks up a score, set-like helpers compare who sat the
# test with who sat the retake, and chunks splits the class into study groups.

import std.algo as algo
import std.collections as collections
import std.fmt as fmt

fn median(sorted: List[Int]) -> Int:
    middle := sorted.len() / 2
    if sorted.len() % 2 == 1:
        return sorted[middle]
    return (sorted[middle - 1] + sorted[middle]) / 2

fn main():
    student_ids := [101, 102, 103, 104, 105, 106, 107, 108, 109, 110]
    scores := [72, 88, 45, 91, 60, 88, 100, 54, 79, 60]

    sorted := algo.sort(scores)
    print("scores, low to high: {fmt.ints(sorted)}")
    print("average {collections.sum(scores) / scores.len()}, median {median(sorted)}, range {collections.min_of(scores)}-{collections.max_of(scores)}")
    print("top three: {fmt.ints(collections.take(algo.sort_desc(scores), 3))}")
    print("distinct scores: {collections.unique(sorted).len()}, perfect scores: {collections.count(scores, 100)}")

    pass_mark := 60
    failed := sorted.filter(fn(score: Int) => score < pass_mark).len()
    print("pass mark {pass_mark}: {sorted.len() - failed} passed, {failed} below")
    print("passing scores: {fmt.ints(collections.drop(sorted, failed))}")

    # binary search needs sorted input and answers in log2(n) steps
    for wanted in [79, 80]:
        found := algo.binary_search(sorted, wanted)
        print("anyone on exactly {wanted}: {found != none}")

    # who scored the first 88, by position in the original list
    if let first_88 = collections.index_of(scores, 88):
        print("first 88 by student {student_ids[first_88]}")

    print("")
    retake_ids := [103, 108, 111]
    print("sat the retake too: {fmt.ints(collections.intersection(student_ids, retake_ids))}")
    print("retake only: {fmt.ints(collections.difference(retake_ids, student_ids))}")
    print("register in order: {collections.is_sorted(student_ids)}")

    groups := collections.chunks(student_ids, 4)
    print("study groups: {fmt.nested_ints(groups)}")
    print("everyone placed: {collections.flatten(groups).len() == student_ids.len()}")
