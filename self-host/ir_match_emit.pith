# ir_match_emit.pith — lowering of match expressions and statements:
# subject evaluation, per-arm conditions (including variant payload
# destructuring), binding setup, and arm bodies.
#
# arm bodies contain statements and expressions, which stay in the
# core; the functions here take those emitters as explicit parameters
# (emit_expr, emit_block), the same seam the decode module uses.

from ast import Node, get_node
from checker import c_get_expr_type
from types import get_type_info
from ir_builder import ir_emit, ir_label, ir_new_temp_name, ir_reg, ir_var_regs, ir_var_types, ir_current_func_return_kind, ir_untracked_rc_binds
from ir_call_emit import ir_emit_call2, ir_emit_label, ir_last_was_ret
from ir_literals import ir_emit_bool_literal, ir_emit_float_literal, ir_emit_int_literal, ir_emit_string_literal
from ir_alias_registry import ir_emission_tid
from ir_optionals import ir_optional_flag_field, ir_optional_value_field
from ir_struct_registry import ir_boxed_enums, ir_enum_payload_kinds, ir_struct_field_index_lookup, ir_rc_kind
from ir_ownership import ir_rc_retain_reg, ir_rc_release_reg
from ir_type_helpers import ir_checked_type, ir_type_from_tid

pub mut ir_match_subject_tid := 0 - 1

pub mut ir_tail_match_node := 0 - 1

## emit one arm's body as the function's return value.
pub fn ir_emit_match_arm_return(body_idx: Int, emit_expr: fn(Int) -> Int, emit_block: fn(Int) -> Int):
    body := get_node(body_idx)
    if body.kind == "block":
        emit_block(body_idx)
        return
    mut expr_idx := body_idx
    if body.kind == "body" and body.children.len() > 0:
        expr_idx = body.children[0]
    val_r := emit_expr(expr_idx)
    ir_emit("ret " + val_r.to_string())
    ir_last_was_ret = true

# Lower a tail-position match: each matching arm returns its value. A no-match
# fall-through lands on the function's default return.

## lower a function-tail match directly into returns.
pub fn ir_emit_match_return(idx: Int, node: Node, emit_expr: fn(Int) -> Int, emit_block: fn(Int) -> Int):
    subj_r := emit_expr(node.children[0])
    subj_type := ir_checked_type(node.children[0])
    ir_match_subject_tid = ir_emission_tid(node.children[0])
    mut i := 1
    while i < node.children.len():
        arm := get_node(node.children[i])
        pat_idx := arm.children[0]
        mut guard_idx := 0 - 1
        mut body_idx := 0 - 1
        mut j := 1
        while j < arm.children.len():
            cn := get_node(arm.children[j])
            if cn.kind == "guard":
                if cn.children.len() > 0:
                    guard_idx = cn.children[0]
            else:
                body_idx = arm.children[j]
            j = j + 1
        cond_r := ir_emit_match_cond(pat_idx, subj_r)
        cand_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + cond_r.to_string() + " " + cand_l + " " + next_l)
        ir_emit_label(cand_l)
        ir_emit_match_bindings(pat_idx, subj_r, subj_type)
        if guard_idx >= 0:
            g_r := emit_expr(guard_idx)
            body_l := ir_label()
            ir_emit("brif " + g_r.to_string() + " " + body_l + " " + next_l)
            ir_emit_label(body_l)
        ir_emit_match_arm_return(body_idx, emit_expr, emit_block)
        ir_emit_label(next_l)
        i = i + 1

# Emit a bool register that is 1 when subj_r matches pat, ignoring any bindings
# (those are emitted separately, only in the branch where the pattern matched).

## the boolean register deciding whether an arm matches.
pub fn ir_emit_match_cond(pat_idx: Int, subj_r: Int) -> Int:
    pat := get_node(pat_idx)
    if pat.kind == "pat_wildcard":
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 1")
        return r
    if pat.kind == "pat_binding":
        # on an optional subject a binding matches only the some case
        # (the none arm is spelled `none`); anywhere else it always
        # matches
        subj_info := get_type_info(ir_match_subject_tid)
        if subj_info.kind == "optional":
            return ir_optional_flag_field(subj_r)
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 1")
        return r
    if pat.kind == "pat_none":
        flag_r := ir_optional_flag_field(subj_r)
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + flag_r.to_string() + " " + zero_r.to_string())
        return r
    if pat.kind == "pat_int":
        lit_r := ir_emit_int_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_bool":
        lit_r := ir_emit_bool_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_float":
        lit_r := ir_emit_float_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_string":
        lit_r := ir_emit_string_literal(pat)
        r := ir_reg()
        ir_emit_call2(r, "__str_eq", "bool", subj_r, lit_r)
        return r
    if pat.kind == "pat_variant":
        r := ir_reg()
        if ir_struct_field_index_lookup.contains_key(pat.value):
            enum_name := ir_variant_enum_name(pat.value)
            lit_r := ir_reg()
            ir_emit("iconst " + lit_r.to_string() + " " + ir_struct_field_index_lookup[pat.value])
            if ir_boxed_enums.contains_key(enum_name):
                # boxed enum: the subject is a pointer; compare the stored tag,
                # then fold in any literal payload sub-patterns
                tag_r := ir_reg()
                ir_emit("field " + tag_r.to_string() + " " + subj_r.to_string() + " 0 int __enum_tag")
                ir_emit("eq " + r.to_string() + " " + tag_r.to_string() + " " + lit_r.to_string())
                return ir_emit_variant_payload_conds(pat, subj_r, r)
            ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
            return r
        ir_emit("iconst " + r.to_string() + " 0")
        return r
    if pat.kind == "pat_range":
        # lo <= subject and subject <= hi ("incl") or < hi ("excl")
        lo_r := ir_emit_int_literal(get_node(pat.children[0]))
        hi_r := ir_emit_int_literal(get_node(pat.children[1]))
        lo_ok := ir_reg()
        ir_emit("gte " + lo_ok.to_string() + " " + subj_r.to_string() + " " + lo_r.to_string())
        hi_ok := ir_reg()
        if pat.value == "incl":
            ir_emit("lte " + hi_ok.to_string() + " " + subj_r.to_string() + " " + hi_r.to_string())
        else:
            ir_emit("lt " + hi_ok.to_string() + " " + subj_r.to_string() + " " + hi_r.to_string())
        r := ir_reg()
        ir_emit("and " + r.to_string() + " " + lo_ok.to_string() + " " + hi_ok.to_string())
        return r
    if pat.kind == "pat_or":
        # matches when any alternative matches.
        mut acc_r := ir_emit_match_cond(pat.children[0], subj_r)
        mut k := 1
        while k < pat.children.len():
            alt_r := ir_emit_match_cond(pat.children[k], subj_r)
            or_r := ir_reg()
            ir_emit("or " + or_r.to_string() + " " + acc_r.to_string() + " " + alt_r.to_string())
            acc_r = or_r
            k = k + 1
        return acc_r
    if pat.kind == "pat_tuple":
        # each element loads its slot and recurses into the ordinary
        # pattern machinery; bindings and wildcards match anything
        elems := ir_match_tuple_element_kinds(pat.children.len())
        acc_r := ir_reg()
        ir_emit("iconst " + acc_r.to_string() + " 1")
        mut out_r := acc_r
        for sub_idx, i in pat.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding" or sub.kind == "pat_wildcard":
                continue
            elem_r := ir_reg()
            ir_emit("field " + elem_r.to_string() + " " + subj_r.to_string() + " " + (i * 8).to_string() + " " + elems[i] + " __t" + i.to_string())
            sub_r := ir_emit_match_cond(sub_idx, elem_r)
            and_r := ir_reg()
            ir_emit("and " + and_r.to_string() + " " + out_r.to_string() + " " + sub_r.to_string())
            out_r = and_r
        return out_r
    # pat_none is not lowered yet.
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

# element kind names for the current match subject's tuple type;
# "unknown" per element when the subject isn't a known tuple

## element kinds for a tuple-pattern subject.
pub fn ir_match_tuple_element_kinds(count: Int) -> List[String]:
    mut out: List[String] := []
    info := get_type_info(ir_match_subject_tid)
    mut i := 0
    while i < count:
        if info.kind == "tuple" and i < info.elements.len():
            out.push(ir_type_from_tid(info.elements[i]))
        else:
            out.push("unknown")
        i = i + 1
    return out

## the enum a variant pattern name belongs to, or "".
pub fn ir_variant_enum_name(variant_key: String) -> String:
    mut i := 0
    while i < variant_key.len():
        if variant_key[i] == ".":
            return variant_key.substring(0, i)
        i = i + 1
    return variant_key

# Literal payload sub-patterns (Shape.Circle(0.0)) narrow the tag match:
# each one loads its slot and ANDs an equality into the arm condition.
# Binding and wildcard sub-patterns always match here; bindings are stored
# by ir_emit_match_bindings once the arm is taken.

## extend an arm condition with variant payload checks.
pub fn ir_emit_variant_payload_conds(pat: Node, subj_r: Int, tag_cond_r: Int) -> Int:
    mut acc_r := tag_cond_r
    mut kinds: List[String] := []
    if ir_enum_payload_kinds.contains_key(pat.value):
        kinds = ir_enum_payload_kinds[pat.value].split(",")
    for sub_idx, i in pat.children:
        sub := get_node(sub_idx)
        if sub.kind == "pat_binding" or sub.kind == "pat_wildcard":
            continue
        mut kind := "unknown"
        if i < kinds.len():
            kind = kinds[i]
        slot_r := ir_reg()
        ir_emit("field " + slot_r.to_string() + " " + subj_r.to_string() + " " + ((i + 1) * 8).to_string() + " " + kind + " __payload")
        mut cond_r := ir_reg()
        if sub.kind == "pat_int":
            lit_r := ir_emit_int_literal(sub)
            ir_emit("eq " + cond_r.to_string() + " " + slot_r.to_string() + " " + lit_r.to_string())
        elif sub.kind == "pat_bool":
            lit_r := ir_emit_bool_literal(sub)
            ir_emit("eq " + cond_r.to_string() + " " + slot_r.to_string() + " " + lit_r.to_string())
        elif sub.kind == "pat_float":
            lit_r := ir_emit_float_literal(sub)
            ir_emit("eq " + cond_r.to_string() + " " + slot_r.to_string() + " " + lit_r.to_string())
        elif sub.kind == "pat_string":
            lit_r := ir_emit_string_literal(sub)
            ir_emit_call2(cond_r, "__str_eq", "bool", slot_r, lit_r)
        else:
            ir_emit("iconst " + cond_r.to_string() + " 0")
        and_r := ir_reg()
        ir_emit("and " + and_r.to_string() + " " + acc_r.to_string() + " " + cond_r.to_string())
        acc_r = and_r
    return acc_r

# Bind any names a pattern introduces, in the branch where it matched.

## bind pattern names to the matched subject's pieces.
pub fn ir_emit_match_bindings(pat_idx: Int, subj_r: Int, subj_type: String):
    pat := get_node(pat_idx)
    if pat.kind == "pat_or":
        # the alternatives bind the same names but may pull them from
        # different payload slots, so each alternative re-tests its own
        # condition and binds from its own shape
        done_l := ir_label()
        mut k := 0
        while k < pat.children.len():
            cond_r := ir_emit_match_cond(pat.children[k], subj_r)
            bind_l := ir_label()
            next_l := ir_label()
            ir_emit("brif " + cond_r.to_string() + " " + bind_l + " " + next_l)
            ir_emit_label(bind_l)
            ir_emit_match_bindings(pat.children[k], subj_r, subj_type)
            ir_emit("jmp " + done_l)
            ir_emit_label(next_l)
            k = k + 1
        ir_emit_label(done_l)
        return
    if pat.kind == "pat_tuple":
        elems := ir_match_tuple_element_kinds(pat.children.len())
        for sub_idx, i in pat.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                elem_r := ir_reg()
                ir_emit("field " + elem_r.to_string() + " " + subj_r.to_string() + " " + (i * 8).to_string() + " " + elems[i] + " " + sub.value)
                ir_var_regs.insert(sub.value, elem_r)
                if elems[i] != "unknown":
                    ir_var_types.insert(sub.value, elems[i])
                ir_emit("store " + sub.value + " " + elem_r.to_string())
        return
    if pat.kind == "pat_binding":
        subj_info := get_type_info(ir_match_subject_tid)
        if subj_info.kind == "optional":
            # the binding is the unwrapped inner value, mirroring if let
            inner_r := ir_optional_value_field(subj_r, ir_match_subject_tid)
            ir_var_regs.insert(pat.value, inner_r)
            inner_kind := ir_type_from_tid(subj_info.inner)
            if inner_kind.len() > 0:
                ir_var_types.insert(pat.value, inner_kind)
            ir_emit("store " + pat.value + " " + inner_r.to_string())
            return
        ir_var_regs.insert(pat.value, subj_r)
        if subj_type.len() > 0:
            ir_var_types.insert(pat.value, subj_type)
        ir_emit("store " + pat.value + " " + subj_r.to_string())
    if pat.kind == "pat_variant" and pat.children.len() > 0:
        # extract each bound payload slot from the boxed enum value. an rc
        # payload is retained so the binding owns its own count: the enum box
        # is released at scope exit (which frees the payload), so a plain
        # borrow would dangle once the box dies. the prepass tracks these
        # names, so the exit cleanup releases them (or transfers on escape).
        mut kinds: List[String] := []
        if ir_enum_payload_kinds.contains_key(pat.value):
            kinds = ir_enum_payload_kinds[pat.value].split(",")
        for sub_idx, i in pat.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                mut kind := "unknown"
                if i < kinds.len():
                    kind = kinds[i]
                slot_r := ir_reg()
                ir_emit("field " + slot_r.to_string() + " " + subj_r.to_string() + " " + ((i + 1) * 8).to_string() + " " + kind + " " + sub.value)
                rc_kind := ir_rc_kind(kind)
                if rc_kind.len() > 0:
                    if not ir_untracked_rc_binds.contains(sub.value):
                        # release whatever the binding held before (it is zero
                        # on first reach and a stale payload when an arm rebinds
                        # the name in a loop), then retain the new one so it
                        # owns its count, mirroring the reassign dance for
                        # ordinary locals.
                        old_r := ir_reg()
                        ir_emit("load " + old_r.to_string() + " " + sub.value)
                        ir_rc_release_reg(old_r, rc_kind)
                    # an untracked name (sibling arms bind it with different rc
                    # kinds) gets no prologue zero-store, so loading it here
                    # would reference an undeclared name — and the previous
                    # value's kind is unknowable anyway, so any release could
                    # be the wrong one. skip the release (a bounded leak) but
                    # still retain: the binding must own its count or it would
                    # dangle once the enum box is released at scope exit.
                    ir_rc_retain_reg(slot_r, rc_kind)
                ir_var_regs.insert(sub.value, slot_r)
                if kind != "unknown":
                    ir_var_types.insert(sub.value, kind)
                ir_emit("store " + sub.value + " " + slot_r.to_string())

# Emit an arm body. A block body runs as statements (and may return); an
# expression body produces a value stored into result_temp.

## emit one arm's body and jump to the merge label.
pub fn ir_emit_match_arm_body(body_idx: Int, result_temp: String, emit_expr: fn(Int) -> Int, emit_block: fn(Int) -> Int):
    body := get_node(body_idx)
    if body.kind == "block":
        emit_block(body_idx)
        return
    mut expr_idx := body_idx
    if body.kind == "body" and body.children.len() > 0:
        expr_idx = body.children[0]
    val_r := emit_expr(expr_idx)
    ir_emit("store " + result_temp + " " + val_r.to_string())
    ir_last_was_ret = false

## lower an if used as an expression: evaluate the first branch whose condition
## holds into a shared temp, so the whole chain produces one value — the same
## temp-store shape ir_emit_match_expr uses. children are
## [condition, then_expr, elif_branch(cond, expr)..., else_expr].
pub fn ir_emit_if_expr(node: Node, emit_expr: fn(Int) -> Int) -> Int:
    result_temp := ir_new_temp_name("ifexpr")
    end_l := ir_label()
    cond_r := emit_expr(node.children[0])
    then_l := ir_label()
    mut next_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + then_l + " " + next_l)
    ir_emit_label(then_l)
    then_r := emit_expr(node.children[1])
    ir_emit("store " + result_temp + " " + then_r.to_string())
    ir_emit("jmp " + end_l)
    ir_emit_label(next_l)
    mut i := 2
    while i < node.children.len() - 1:
        branch := get_node(node.children[i])
        branch_cond_r := emit_expr(branch.children[0])
        body_l := ir_label()
        after_l := ir_label()
        ir_emit("brif " + branch_cond_r.to_string() + " " + body_l + " " + after_l)
        ir_emit_label(body_l)
        branch_r := emit_expr(branch.children[1])
        ir_emit("store " + result_temp + " " + branch_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(after_l)
        i = i + 1
    else_r := emit_expr(node.children[node.children.len() - 1])
    ir_emit("store " + result_temp + " " + else_r.to_string())
    ir_emit_label(end_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

## lower a match used as an expression.
pub fn ir_emit_match_expr(idx: Int, node: Node, emit_expr: fn(Int) -> Int, emit_block: fn(Int) -> Int) -> Int:
    subj_r := emit_expr(node.children[0])
    subj_type := ir_checked_type(node.children[0])
    ir_match_subject_tid = ir_emission_tid(node.children[0])
    result_temp := ir_new_temp_name("match")
    end_l := ir_label()
    mut i := 1
    while i < node.children.len():
        arm := get_node(node.children[i])
        pat_idx := arm.children[0]
        mut guard_idx := 0 - 1
        mut body_idx := 0 - 1
        mut j := 1
        while j < arm.children.len():
            cn := get_node(arm.children[j])
            if cn.kind == "guard":
                if cn.children.len() > 0:
                    guard_idx = cn.children[0]
            else:
                body_idx = arm.children[j]
            j = j + 1
        cond_r := ir_emit_match_cond(pat_idx, subj_r)
        cand_l := ir_label()
        next_l := ir_label()
        ir_emit("brif " + cond_r.to_string() + " " + cand_l + " " + next_l)
        ir_emit_label(cand_l)
        ir_emit_match_bindings(pat_idx, subj_r, subj_type)
        if guard_idx >= 0:
            g_r := emit_expr(guard_idx)
            body_l := ir_label()
            ir_emit("brif " + g_r.to_string() + " " + body_l + " " + next_l)
            ir_emit_label(body_l)
        ir_emit_match_arm_body(body_idx, result_temp, emit_expr, emit_block)
        if not ir_last_was_ret:
            ir_emit("jmp " + end_l)
        ir_emit_label(next_l)
        i = i + 1
    # no arm matched: leave a zero so the result temp is always defined.
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + result_temp + " " + zero_r.to_string())
    ir_emit_label(end_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

## the tail match node of a function body, or -1.
pub fn ir_function_tail_match(body_idx: Int) -> Int:
    if ir_current_func_return_kind.len() == 0:
        return 0 - 1
    if ir_current_func_return_kind == "void":
        return 0 - 1
    return ir_unwrap_tail_match(body_idx)

## unwrap a returns-wrapped tail match node.
pub fn ir_unwrap_tail_match(idx: Int) -> Int:
    n := get_node(idx)
    if n.kind == "match_expr":
        return idx
    if n.kind == "body" or n.kind == "block" or n.kind == "then" or n.kind == "else":
        if n.children.len() == 0:
            return 0 - 1
        return ir_unwrap_tail_match(n.children[n.children.len() - 1])
    return 0 - 1
