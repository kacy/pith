# helper for test_transitive_field_offset: returns Pair values built in
# field_offset_inner. the top-level test imports only this module, so it reaches
# Pair's type through this return type without importing its defining module.

import field_offset_inner as inner

pub fn pairs() -> List[inner.Pair]:
    return [inner.pair("alpha", "one"), inner.pair("beta", "two"), inner.pair("gamma", "three")]
