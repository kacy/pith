# stdlib_collections: the generic helpers in std.collections.
#
# builds the weekly report for a small basketball league from a flat list of
# player lines: team totals with group_by, the leaders with sort_by_key and
# max_by, and a few one-line questions answered with any, find_index and
# count_by.

import std.collections as collections

struct Player:
    name: String
    team: String
    points: Int
    assists: Int

fn season() -> List[Player]:
    return [
        Player(name: "ana", team: "hawks", points: 31, assists: 4),
        Player(name: "ben", team: "otters", points: 12, assists: 9),
        Player(name: "cyd", team: "hawks", points: 18, assists: 7),
        Player(name: "dee", team: "otters", points: 27, assists: 3),
        Player(name: "eli", team: "foxes", points: 9, assists: 11),
        Player(name: "fay", team: "foxes", points: 22, assists: 5),
        Player(name: "gus", team: "hawks", points: 6, assists: 2),
]

fn team_points(roster: List[Player]) -> Int:
    return collections.sum(roster.map(fn(p: Player) => p.points))

fn main():
    players := season()

    print("team totals")
    by_team := collections.group_by(players, fn(p: Player) => p.team)
    for team in by_team.keys().sort():
        roster := by_team[team]
        names := roster.map(fn(p: Player) => p.name).join(", ")
        print("  {team:<7} {team_points(roster):>3} pts  ({names})")

    # sort_by_key sorts ascending, so the leaders sit at the end
    print("")
    print("top scorers")
    leaders := collections.sort_by_key(players, fn(p: Player) => p.points)
    for rank in 0..3:
        leader := leaders[leaders.len() - 1 - rank]
        print("  {rank + 1}. {leader.name} {leader.points}")

    playmaker := collections.max_by(players, fn(p: Player) => p.assists) catch players[0]
    print("most assists: {playmaker.name} ({playmaker.assists})")

    print("")
    roster_sizes := collections.count_by(players, fn(p: Player) => p.team)
    print("hawks roster size: {roster_sizes["hawks"]}")
    print("anyone over 30: {collections.any(players, fn(p: Player) => p.points > 30)}")
    if let first_double = collections.find_index(players, fn(p: Player) => p.assists >= 10):
        print("first double-digit assists: {players[first_double].name}")

    # sets answer "who is in either list" without duplicates
    all_stars := {"ana", "dee"}
    fan_votes := {"dee", "fay"}
    print("all-star ballot: {collections.set_union(all_stars, fan_votes).len()} players")
