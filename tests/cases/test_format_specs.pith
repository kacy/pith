# rust-style format specs in interpolation: {x:8.2} pads to width 8
# with 2 decimals, {n:04} zero-pads, < ^ align, bare .N sets precision.
fn main():
    total := 142.5
    n := 42
    name := "widget"
    pi := 3.14159265
    print("[{total:8.2}]")
    print("[{n:04}]")
    print("[{name:<12}] ok")
    print("[{name:^12}] mid")
    print("[{pi:.3}]")
    print("[{n:6}]")
    neg := 0 - 7
    print("[{neg:05}]")
    ratio := 2.0 / 3.0
    print("[{ratio:10.4}]")
    print("no spec: {n} and {name}")
    m: Map[String, Int] := {"a:b": 1}
    print("colon in key: {m["a:b"]}")
    wide := "already wider than five"
    print("[{wide:5}]")
