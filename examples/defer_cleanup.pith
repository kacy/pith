# defer: cleanup that runs on every exit from a function.
#
# writes reports to files. `defer file.close()` sits on the line after the
# open, and runs whether the function returns normally, fails, or passes an
# error up with `!`, so no exit can leak the file. several defers in one
# block run last first, the reverse of the order they were written.
#
# a File here is an in-memory stand-in so the example runs on its own; the
# shape is the same with std.fs.

struct Disk:
    open_files: Int = 0

struct File:
    disk: Disk
    name: String
    lines: Int = 0

impl Disk:
    fn open(name: String) -> File:
        self.open_files += 1
        print("  open {name}")
        return File(disk: self, name: name)

impl File:
    fn write(line: String) -> Int!:
        if line.len() == 0:
            fail "empty line in {self.name}"
        self.lines += 1
        return line.len()

    fn close():
        self.disk.open_files -= 1
        print("  close {self.name}, lines written: {self.lines}")

fn save(disk: Disk, name: String, lines: List[String]) -> Int!:
    file := disk.open(name)
    defer file.close()

    mut written := 0
    for line in lines:
        written += file.write(line)!
    return written

# two files open at once: the defers close them in reverse order
fn copy_with_log(disk: Disk, lines: List[String]) -> Int!:
    target := disk.open("copy.txt")
    defer target.close()
    log := disk.open("copy.log")
    defer log.close()

    for line in lines:
        target.write(line)!
        log.write("copied {line.len()} bytes")!
    return lines.len()

fn report(outcome: Int!, unit: String):
    if outcome.is_err:
        print("  failed: {outcome.err}")
    else:
        print("  {outcome.ok} {unit}")

fn main():
    disk := Disk()

    print("save report.txt")
    report(save(disk, "report.txt", ["alpha", "beta"]), "bytes")

    # the second write fails, `!` leaves save, and the defer still runs
    print("save broken.txt")
    report(save(disk, "broken.txt", ["ok", "", "never"]), "bytes")

    print("copy")
    report(copy_with_log(disk, ["one", "two"]), "lines copied")

    print("files still open: {disk.open_files}")
