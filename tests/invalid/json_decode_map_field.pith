# a Map field in a json decode target must have String keys: a json
# object's keys are strings, so a Map[Int, T] has no document form and is
# refused at the checker. the Float, List[String] and Map[String, Int]
# fields beside it, each once refused the same way, are accepted.
import std.json as json

struct Order:
    pub id: Int
    pub price: Float
    pub tags: List[String]
    pub attrs: Map[String, Int]
    pub by_id: Map[Int, String]

fn main():
    r := json.decode_text[Order]("x")
    if r.is_err:
        print("err")
