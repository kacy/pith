; `xs[i]` on a null list handle. safe pith cannot hand a null container to
; a subscript, so this is combined text ir compiled with `pith build-ir`.
string m0s0 "before"
func main 0 void
strref 1 m0s0
call 2 pith_print_cstr unknown 1 1
iconst 3 0
iconst 4 0
call 5 pith_list_get_value_strict int 2 3 4
call 6 int_to_string string 1 5
call 7 pith_print_cstr unknown 1 6
iconst 8 0
ret 8
endfunc
