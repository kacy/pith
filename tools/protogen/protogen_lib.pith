# protogen_lib — a proto3 to pith code generator.
#
# lexes a .proto file, parses a focused proto3 subset (messages, enums, and
# scalar / message / enum fields, singular and repeated), and generates a pith
# module: a struct per message plus `encode_<Msg>` / `decode_<Msg>` functions
# that ride on std.protobuf's wire codec, and — for each `service` — a typed
# `<Svc>Client` whose methods wrap std.net.grpc's unary and streaming calls plus,
# for the unary rpcs, a `serve_<Svc>` server: you implement one handler per rpc
# and it routes, decodes, dispatches, and encodes. messages are bytes in, bytes
# out; the client and server encode and decode them for you.
#
# supported: the scalar types (int32/int64/uint32/uint64/sint32/sint64/bool/
# string/bytes/float/double/fixed32/fixed64/sfixed32/sfixed64), enums (as Int
# fields plus named constants), singular message fields (as optionals),
# repeated int-varint / enum / message / string / bytes fields, `oneof` groups
# (as a payload enum per group), `map<k, v>` fields (as pith Maps; string and
# integer keys), grpc `service` stubs for all four rpc shapes (unary,
# server-, client-, and bidi-streaming), and the common well-known types
# (Timestamp, Duration, Empty, and the wrappers), synthesized into the
# generated module as plain messages when their google/protobuf file is
# imported and the type is used.
#
# deferred (a clear error names them): bool/fixed map keys, proto2, repeated
# sint/fixed/float/double, and the other well-known types (Any, Struct,
# FieldMask, ...).

import std.bytes as bytes
import std.strings as strings

# --- tokens -----------------------------------------------------------------

fn is_space(c: Int) -> Bool:
    return c == 32 or c == 9 or c == 10 or c == 13

fn is_ident_char(c: Int) -> Bool:
    if c >= 65 and c <= 90:
        return true
    if c >= 97 and c <= 122:
        return true
    if c >= 48 and c <= 57:
        return true
    return c == 95 or c == 46

fn is_punct(c: Int) -> Bool:
    return c == 123 or c == 125 or c == 59 or c == 61 or c == 60 or c == 62 or c == 44 or c == 40 or c == 41 or c == 91 or c == 93

# split proto source into a flat token stream: identifiers/numbers, string
# contents (quotes dropped), and single-character punctuation. whitespace and
# `//` / `/* */` comments are discarded.
pub fn lex(src: String) -> List[String]:
    data := bytes.from_string_utf8(src)
    n := data.len()
    toks: List[String] := []
    mut i := 0
    while i < n:
        c := data[i]
        if is_space(c):
            i = i + 1
            continue
        if c == 47 and i + 1 < n and data[i + 1] == 47:
            i = i + 2
            while i < n and data[i] != 10:
                i = i + 1
            continue
        if c == 47 and i + 1 < n and data[i + 1] == 42:
            i = i + 2
            while i + 1 < n and not (data[i] == 42 and data[i + 1] == 47):
                i = i + 1
            i = i + 2
            continue
        if c == 34:
            i = i + 1
            start := i
            while i < n and data[i] != 34:
                i = i + 1
            toks.push(slice_text(data, start, i))
            i = i + 1
            continue
        if is_punct(c):
            toks.push(slice_text(data, i, i + 1))
            i = i + 1
            continue
        start := i
        while i < n and is_ident_char(data[i]):
            i = i + 1
        if i == start:
            # a stray character we do not tokenize; skip it
            i = i + 1
            continue
        toks.push(slice_text(data, start, i))
    return toks

fn slice_text(data: Bytes, start: Int, end: Int) -> String:
    return data.slice(start, end).to_string_utf8() catch ""

# --- ast --------------------------------------------------------------------

# one message field: its label ("repeated"/"optional"/""), proto type name,
# pith field name, and wire field number.
pub struct Field:
    pub label: String
    pub ptype: String
    pub name: String
    pub number: Int

# a oneof group: its name and member fields. on the wire the members are
# ordinary fields of the containing message; at most one is set.
pub struct Oneof:
    pub name: String
    pub fields: List[Field]

# a map field: its key/value proto types, pith field name, and wire field
# number. on the wire it is a repeated entry message with key = 1, value = 2.
pub struct MapField:
    pub key_type: String
    pub value_type: String
    pub name: String
    pub number: Int

# a message: its (simple) name, its fields, its oneof groups, and its map
# fields. nested messages are lifted to the top level.
pub struct Message:
    pub name: String
    pub fields: List[Field]
    pub oneofs: List[Oneof]
    pub maps: List[MapField]

# one enum constant: its name and integer value.
pub struct EnumValue:
    pub name: String
    pub value: Int

# an enum: its name and constants.
pub struct EnumDef:
    pub name: String
    pub values: List[EnumValue]

# one rpc in a service: its name, request/response message types, and whether
# each side streams (`stream` in the .proto).
pub struct Rpc:
    pub name: String
    pub req_type: String
    pub resp_type: String
    pub client_streaming: Bool
    pub server_streaming: Bool

# a grpc service: its name and rpcs.
pub struct Service:
    pub name: String
    pub rpcs: List[Rpc]

# a parsed proto file. `wkts` holds the simple names of the well-known types
# whose google/protobuf imports appeared ("Timestamp", "Int32Value", ...); the
# generator synthesizes the ones the file actually uses.
pub struct ProtoFile:
    pub package: String
    pub messages: List[Message]
    pub enums: List[EnumDef]
    pub services: List[Service]
    pub wkts: List[String]

# raised on unsupported or malformed proto input.
pub struct ParseError:
    pub message: String

fn parse_fail(message: String) -> ParseError:
    return ParseError(message)

# --- parser -----------------------------------------------------------------

struct Parser:
    toks: List[String]
    pos: Int

fn new_parser(toks: List[String]) -> Parser:
    return Parser(toks: toks, pos: 0)

impl Parser:
    fn done() -> Bool:
        return self.pos >= self.toks.len()

    fn peek() -> String:
        if self.pos >= self.toks.len():
            return ""
        return self.toks[self.pos]

    fn advance() -> String:
        t := self.peek()
        self.pos = self.pos + 1
        return t

    fn expect(tok: String) -> Bool!ParseError:
        got := self.advance()
        if got != tok:
            fail parse_fail("expected '{tok}' but found '{got}'")
        return true

    # skip a `[ ... ]` field-options block if present.
    fn skip_options() -> Bool!ParseError:
        if self.peek() != "[":
            return true
        self.advance()
        while not self.done() and self.peek() != "]":
            self.advance()
        self.expect("]")!
        return true

fn to_int(text: String, fallback: Int) -> Int:
    digits := bytes.from_string_utf8(text)
    mut value := 0
    mut i := 0
    while i < digits.len():
        c := digits[i]
        if c < 48 or c > 57:
            return fallback
        value = (value * 10) + (c - 48)
        i = i + 1
    return value

# parse a whole proto3 file into its messages and enums.
pub fn parse(src: String) -> ProtoFile!ParseError:
    p := new_parser(lex(src))
    mut package := ""
    messages: List[Message] := []
    enums: List[EnumDef] := []
    services: List[Service] := []
    wkts: List[String] := []
    while not p.done():
        kw := p.peek()
        if kw == "syntax":
            p.advance()
            p.expect("=")!
            p.advance()
            p.expect(";")!
        elif kw == "package":
            p.advance()
            package = p.advance()
            p.expect(";")!
        elif kw == "import":
            p.advance()
            if p.peek() == "public" or p.peek() == "weak":
                p.advance()
            path := p.advance()
            p.expect(";")!
            record_import(wkts, path)!
        elif kw == "option":
            # skip to the terminating semicolon
            p.advance()
            while not p.done() and p.peek() != ";":
                p.advance()
            p.expect(";")!
        elif kw == "message":
            parse_message(p, messages, enums)!
        elif kw == "enum":
            enums.push(parse_enum(p)!)
        elif kw == "service":
            services.push(parse_service(p)!)
        elif kw == ";":
            p.advance()
        else:
            fail parse_fail("unexpected token '{kw}' at top level")
    # a user type with a well-known type's name would be indistinguishable
    # from the imported one, so that combination is an error.
    for m in messages:
        if list_has(wkts, m.name):
            fail parse_fail("message '{m.name}' collides with the imported well-known type google.protobuf.{m.name}")
    for e in enums:
        if list_has(wkts, e.name):
            fail parse_fail("enum '{e.name}' collides with the imported well-known type google.protobuf.{e.name}")
    return ProtoFile(package: package, messages: messages, enums: enums, services: services, wkts: wkts)

# --- well-known types -------------------------------------------------------

# the well-known types protogen can synthesize. each generates as a plain
# message named by its simple name (Timestamp, Duration, Empty, Int32Value,
# ...), with the fields proto defines for it.
fn wkt_all_names() -> List[String]:
    return ["Timestamp", "Duration", "Empty", "DoubleValue", "FloatValue", "Int64Value", "UInt64Value", "Int32Value", "UInt32Value", "BoolValue", "StringValue", "BytesValue"]

# the google/protobuf file that declares a supported well-known type, or ""
# if the name is not one protogen knows.
fn wkt_import_path(name: String) -> String:
    if name == "Timestamp":
        return "google/protobuf/timestamp.proto"
    if name == "Duration":
        return "google/protobuf/duration.proto"
    if name == "Empty":
        return "google/protobuf/empty.proto"
    if list_has(wkt_all_names(), name):
        return "google/protobuf/wrappers.proto"
    return ""

# note an `import` statement. a supported google/protobuf import enables its
# well-known types; an unsupported one (any.proto, struct.proto, ...) is an
# error; any other import names another user file, which protogen — a
# single-file generator — ignores.
fn record_import(wkts: List[String], path: String) -> Bool!ParseError:
    if not path.starts_with("google/protobuf/"):
        return true
    mut matched := false
    for name in wkt_all_names():
        if wkt_import_path(name) == path:
            matched = true
            if not list_has(wkts, name):
                wkts.push(name)
    if not matched:
        fail parse_fail("import '{path}' is not supported (the supported well-known types are timestamp, duration, empty, and wrappers)")
    return true

# the synthesized definition of one well-known type, as an ordinary Message.
fn wkt_message(name: String) -> Message:
    fields: List[Field] := []
    if name == "Timestamp" or name == "Duration":
        fields.push(Field(label: "", ptype: "int64", name: "seconds", number: 1))
        fields.push(Field(label: "", ptype: "int32", name: "nanos", number: 2))
    elif name != "Empty":
        # every wrapper is a single `value = 1` field of its scalar type
        fields.push(Field(label: "", ptype: wkt_wrapper_scalar(name), name: "value", number: 1))
    return Message(name: name, fields: fields, oneofs: [], maps: [])

# the scalar proto type a wrapper well-known type carries.
fn wkt_wrapper_scalar(name: String) -> String:
    if name == "DoubleValue":
        return "double"
    if name == "FloatValue":
        return "float"
    if name == "Int64Value":
        return "int64"
    if name == "UInt64Value":
        return "uint64"
    if name == "Int32Value":
        return "int32"
    if name == "UInt32Value":
        return "uint32"
    if name == "BoolValue":
        return "bool"
    if name == "StringValue":
        return "string"
    return "bytes"

# parse `service Name { rpc Method([stream] Req) returns ([stream] Resp); ... }`.
fn parse_service(p: Parser) -> Service!ParseError:
    p.expect("service")!
    name := p.advance()
    p.expect(chr(123))!
    rpcs: List[Rpc] := []
    while not p.done() and p.peek() != chr(125):
        kw := p.peek()
        if kw == "rpc":
            rpcs.push(parse_rpc(p)!)
        elif kw == "option":
            p.advance()
            while not p.done() and p.peek() != ";":
                p.advance()
            p.expect(";")!
        elif kw == ";":
            p.advance()
        else:
            fail parse_fail("unexpected token '{kw}' in service '{name}'")
    p.expect(chr(125))!
    return Service(name: name, rpcs: rpcs)

# parse one `rpc Method([stream] Req) returns ([stream] Resp) [{}|;]`.
fn parse_rpc(p: Parser) -> Rpc!ParseError:
    p.expect("rpc")!
    name := p.advance()
    p.expect("(")!
    mut client_streaming := false
    if p.peek() == "stream":
        p.advance()
        client_streaming = true
    req := p.advance()
    p.expect(")")!
    p.expect("returns")!
    p.expect("(")!
    mut server_streaming := false
    if p.peek() == "stream":
        p.advance()
        server_streaming = true
    resp := p.advance()
    p.expect(")")!
    # an rpc body `{ ... }` (method options) or a bare `;`.
    if p.peek() == chr(123):
        p.advance()
        while not p.done() and p.peek() != chr(125):
            p.advance()
        p.expect(chr(125))!
    else:
        p.expect(";")!
    return Rpc(name: name, req_type: simple_name(req), resp_type: simple_name(resp), client_streaming: client_streaming, server_streaming: server_streaming)

# parse `message Name { ... }`, appending it and any nested messages/enums.
fn parse_message(p: Parser, messages: List[Message], enums: List[EnumDef]) -> Bool!ParseError:
    p.expect("message")!
    name := p.advance()
    p.expect(chr(123))!
    fields: List[Field] := []
    oneofs: List[Oneof] := []
    maps: List[MapField] := []
    while not p.done() and p.peek() != chr(125):
        kw := p.peek()
        if kw == "message":
            parse_message(p, messages, enums)!
        elif kw == "enum":
            enums.push(parse_enum(p)!)
        elif kw == "oneof":
            oneofs.push(parse_oneof(p)!)
        elif kw == "map":
            maps.push(parse_map_field(p)!)
        elif kw == "reserved":
            p.advance()
            while not p.done() and p.peek() != ";":
                p.advance()
            p.expect(";")!
        elif kw == ";":
            p.advance()
        else:
            fields.push(parse_field(p)!)
    p.expect(chr(125))!
    messages.push(Message(name: name, fields: fields, oneofs: oneofs, maps: maps))
    return true

# the map key types pith can carry: string keys stay String, integer keys
# become Int. proto3 also allows bool and fixed keys, but a pith Map keys by
# String or Int only, so those are a parse error.
fn is_map_key(ptype: String) -> Bool:
    if ptype == "string":
        return true
    return ptype == "int32" or ptype == "int64" or ptype == "uint32" or ptype == "uint64" or ptype == "sint32" or ptype == "sint64"

# parse `map<ktype, vtype> name = number [options];`.
fn parse_map_field(p: Parser) -> MapField!ParseError:
    p.expect("map")!
    p.expect("<")!
    ktype := p.advance()
    if not is_map_key(ktype):
        fail parse_fail("map key type '{ktype}' is not supported (use string or an integer type)")
    p.expect(",")!
    vtype := p.advance()
    if vtype == "map":
        fail parse_fail("a map value cannot be another map")
    p.expect(">")!
    name := p.advance()
    p.expect("=")!
    number := to_int(p.advance(), 0)
    p.skip_options()!
    p.expect(";")!
    return MapField(key_type: ktype, value_type: vtype, name: name, number: number)

# parse `oneof name { <type> <name> = <number>; ... }`. proto3 forbids labels
# on oneof members, so `repeated`/`optional` inside the group is a parse error.
fn parse_oneof(p: Parser) -> Oneof!ParseError:
    p.expect("oneof")!
    name := p.advance()
    p.expect(chr(123))!
    fields: List[Field] := []
    while not p.done() and p.peek() != chr(125):
        kw := p.peek()
        if kw == ";":
            p.advance()
        elif kw == "option":
            p.advance()
            while not p.done() and p.peek() != ";":
                p.advance()
            p.expect(";")!
        elif kw == "repeated" or kw == "optional":
            fail parse_fail("'{kw}' is not allowed inside a oneof")
        else:
            fields.push(parse_field(p)!)
    p.expect(chr(125))!
    return Oneof(name: name, fields: fields)

# parse one field: `[repeated|optional] <type> <name> = <number> [options];`
fn parse_field(p: Parser) -> Field!ParseError:
    mut label := ""
    head := p.peek()
    if head == "repeated" or head == "optional":
        label = p.advance()
    ptype := p.advance()
    if ptype == "map":
        # a plain map field is handled before we get here, so this is a
        # labeled map or a map inside a oneof — both forbidden by proto3.
        fail parse_fail("'map' is not allowed here")
    name := p.advance()
    p.expect("=")!
    number := to_int(p.advance(), 0)
    p.skip_options()!
    p.expect(";")!
    return Field(label: label, ptype: ptype, name: name, number: number)

# parse `enum Name { NAME = n; ... }`.
fn parse_enum(p: Parser) -> EnumDef!ParseError:
    p.expect("enum")!
    name := p.advance()
    p.expect(chr(123))!
    values: List[EnumValue] := []
    while not p.done() and p.peek() != chr(125):
        if p.peek() == ";" or p.peek() == "option":
            p.advance()
            if not p.done() and p.toks[p.pos - 1] == "option":
                while not p.done() and p.peek() != ";":
                    p.advance()
                p.expect(";")!
            continue
        vname := p.advance()
        p.expect("=")!
        vnum := to_int(p.advance(), 0)
        p.skip_options()!
        p.expect(";")!
        values.push(EnumValue(name: vname, value: vnum))
    p.expect(chr(125))!
    return EnumDef(name: name, values: values)

# --- type resolution --------------------------------------------------------

# CamelCase a snake_case name: "paypal_email" -> "PaypalEmail".
fn camel(name: String) -> String:
    mut out := ""
    for part in name.split("_"):
        out = out + strings.capitalize(part)
    return out

# the pith enum generated for a oneof group: <Msg><OneofName>.
fn oneof_enum_name(msg_name: String, o: Oneof) -> String:
    return msg_name + camel(o.name)

# the last dotted component of a (possibly package-qualified) type name.
fn simple_name(ptype: String) -> String:
    parts := ptype.split(".")
    if parts.len() == 0:
        return ptype
    return parts[parts.len() - 1]

fn list_has(names: List[String], target: String) -> Bool:
    for n in names:
        if n == target:
            return true
    return false

# whether a proto type names a message defined in this file.
fn is_message(ptype: String, message_names: List[String]) -> Bool:
    return list_has(message_names, simple_name(ptype))

fn is_enum(ptype: String, enum_names: List[String]) -> Bool:
    return list_has(enum_names, simple_name(ptype))

# the pith field type for a proto field.
fn pith_type(f: Field, message_names: List[String], enum_names: List[String]) -> String:
    base := scalar_pith_type(f.ptype, message_names, enum_names)
    if f.label == "repeated":
        return "List[{base}]"
    if is_message(f.ptype, message_names):
        return "{base}?"
    return base

fn scalar_pith_type(ptype: String, message_names: List[String], enum_names: List[String]) -> String:
    if is_message(ptype, message_names):
        return simple_name(ptype)
    if is_enum(ptype, enum_names):
        return "Int"
    if ptype == "string":
        return "String"
    if ptype == "bytes":
        return "Bytes"
    if ptype == "bool":
        return "Bool"
    if ptype == "double" or ptype == "float":
        return "Float"
    return "Int"

# the pith key type for a map field: string keys stay String, integer keys
# become Int (the parser already rejected anything else).
fn map_key_pith_type(key_type: String) -> String:
    if key_type == "string":
        return "String"
    return "Int"

# the pith field type for a map field.
fn map_pith_type(mf: MapField, message_names: List[String], enum_names: List[String]) -> String:
    k := map_key_pith_type(mf.key_type)
    v := scalar_pith_type(mf.value_type, message_names, enum_names)
    return "Map[{k}, {v}]"

# the zero literal for a scalar pith type.
fn scalar_zero(t: String) -> String:
    if t == "String":
        return "\"\""
    if t == "Bytes":
        return "bytes.empty()"
    if t == "Bool":
        return "false"
    if t == "Float":
        return "0.0"
    return "0"

# the zero/default value literal for a pith field type, for the constructor.
fn default_value(f: Field, message_names: List[String], enum_names: List[String]) -> String:
    if f.label == "repeated":
        return "[]"
    if is_message(f.ptype, message_names):
        return "none"
    return scalar_zero(scalar_pith_type(f.ptype, message_names, enum_names))

# --- code generation --------------------------------------------------------

fn message_names_of(messages: List[Message]) -> List[String]:
    names: List[String] := []
    for m in messages:
        names.push(m.name)
    return names

# check one type reference against the well-known types: a google.protobuf
# name must be a supported wkt with its import present, and a supported use
# is collected into `used` (once). any other type passes through untouched.
fn check_wkt_use(ptype: String, enabled: List[String], used: List[String]) -> Bool!ParseError:
    if not ptype.starts_with("google.protobuf."):
        return true
    name := simple_name(ptype)
    path := wkt_import_path(name)
    if path == "":
        fail parse_fail("well-known type '{ptype}' is not supported")
    if not list_has(enabled, name):
        fail parse_fail("'{ptype}' is used but '{path}' is not imported")
    if not list_has(used, name):
        used.push(name)
    return true

# the well-known types the file actually uses, validating every reference.
# fields, oneof members, and map values still carry the qualified name; rpc
# request/response types were reduced to simple names by the parser, so they
# match by name against the imported set (a collision with a user message is
# already ruled out at parse time).
fn used_wkts(pf: ProtoFile, declared: List[String]) -> List[String]!ParseError:
    used: List[String] := []
    for m in pf.messages:
        for f in m.fields:
            check_wkt_use(f.ptype, pf.wkts, used)!
        for o in m.oneofs:
            for f in o.fields:
                check_wkt_use(f.ptype, pf.wkts, used)!
        for mf in m.maps:
            check_wkt_use(mf.value_type, pf.wkts, used)!
    for svc in pf.services:
        for rpc in svc.rpcs:
            for tn in [rpc.req_type, rpc.resp_type]:
                if list_has(pf.wkts, tn) and not list_has(declared, tn) and not list_has(used, tn):
                    used.push(tn)
    return used

fn enum_names_of(pf: ProtoFile) -> List[String]:
    names: List[String] := []
    for e in pf.enums:
        names.push(e.name)
    return names

# the message types a message refers to through its fields, oneof members,
# and map values (its dependencies).
fn message_deps(m: Message, message_names: List[String]) -> List[String]:
    deps: List[String] := []
    for f in m.fields:
        add_message_dep(deps, m.name, f.ptype, message_names)
    for o in m.oneofs:
        for f in o.fields:
            add_message_dep(deps, m.name, f.ptype, message_names)
    for mf in m.maps:
        add_message_dep(deps, m.name, mf.value_type, message_names)
    return deps

fn add_message_dep(deps: List[String], owner: String, ptype: String, message_names: List[String]):
    if not is_message(ptype, message_names):
        return
    dep := simple_name(ptype)
    if dep != owner and not list_has(deps, dep):
        deps.push(dep)

# order messages so a referenced message is defined before the message that
# uses it (pith does not resolve a struct field whose type appears later). a
# self-reference is fine; a mutual cycle falls back to declaration order.
fn topo_sort(messages: List[Message], message_names: List[String]) -> List[Message]:
    ordered: List[Message] := []
    emitted: List[String] := []
    mut remaining := messages.len()
    while remaining > 0:
        mut progress := false
        for m in messages:
            if list_has(emitted, m.name):
                continue
            mut ready := true
            for dep in message_deps(m, message_names):
                if not list_has(emitted, dep):
                    ready = false
            if ready:
                ordered.push(m)
                emitted.push(m.name)
                remaining = remaining - 1
                progress = true
        if not progress:
            for m in messages:
                if not list_has(emitted, m.name):
                    ordered.push(m)
                    emitted.push(m.name)
            remaining = 0
    return ordered

# the std.protobuf Writer method for a singular scalar field, or "" if the type
# is not supported for a singular field.
fn write_method(ptype: String, enum_names: List[String]) -> String:
    if is_enum(ptype, enum_names):
        return "write_enum"
    if ptype == "int32" or ptype == "int64" or ptype == "uint32" or ptype == "uint64":
        return "write_int32"
    if ptype == "sint32" or ptype == "sint64":
        return "write_sint32"
    if ptype == "bool":
        return "write_bool"
    if ptype == "string":
        return "write_string"
    if ptype == "bytes":
        return "write_bytes"
    if ptype == "double":
        return "write_double"
    if ptype == "float":
        return "write_float"
    if ptype == "fixed32":
        return "write_fixed32"
    if ptype == "sfixed32":
        return "write_sfixed32"
    if ptype == "fixed64":
        return "write_fixed64"
    if ptype == "sfixed64":
        return "write_sfixed64"
    return ""

# the std.protobuf Reader method for a singular scalar field.
fn read_method(ptype: String, enum_names: List[String]) -> String:
    if is_enum(ptype, enum_names):
        return "read_enum"
    if ptype == "int32" or ptype == "int64" or ptype == "uint32" or ptype == "uint64":
        return "read_int64"
    if ptype == "sint32" or ptype == "sint64":
        return "read_sint64"
    if ptype == "bool":
        return "read_bool"
    if ptype == "string":
        return "read_string"
    if ptype == "bytes":
        return "read_bytes"
    if ptype == "double":
        return "read_double"
    if ptype == "float":
        return "read_float"
    if ptype == "fixed32":
        return "read_fixed32"
    if ptype == "sfixed32":
        return "read_sfixed32"
    if ptype == "fixed64":
        return "read_fixed64"
    if ptype == "sfixed64":
        return "read_sfixed64"
    return "read_int64"

# a repeated scalar packs as varints only for the plain integer and enum types.
fn is_packable_varint(ptype: String, enum_names: List[String]) -> Bool:
    if is_enum(ptype, enum_names):
        return true
    return ptype == "int32" or ptype == "int64" or ptype == "uint32" or ptype == "uint64"

# the proto3 "is this field non-default" guard for a singular scalar.
fn zero_guard(fieldname: String, ptype: String, enum_names: List[String]) -> String:
    fref := "m.{fieldname}"
    if ptype == "bool":
        return "if {fref}:"
    if ptype == "string":
        return "if {fref} != \"\":"
    if ptype == "bytes":
        return "if {fref}.len() > 0:"
    if ptype == "double" or ptype == "float":
        return "if {fref} != 0.0:"
    return "if {fref} != 0:"

# the encode-body lines for one field (already indented four spaces).
fn encode_field(f: Field, message_names: List[String], enum_names: List[String]) -> List[String]!ParseError:
    out: List[String] := []
    num := "{f.number}"
    fref := "m.{f.name}"
    if f.label == "repeated":
        if is_message(f.ptype, message_names):
            tn := simple_name(f.ptype)
            out.push("    for item in {fref}:")
            out.push("        w.write_message({num}, encode_{tn}(item)) catch false")
        elif f.ptype == "string":
            out.push("    for item in {fref}:")
            out.push("        w.write_string({num}, item) catch false")
        elif f.ptype == "bytes":
            out.push("    for item in {fref}:")
            out.push("        w.write_bytes({num}, item) catch false")
        elif is_packable_varint(f.ptype, enum_names):
            out.push("    if {fref}.len() > 0:")
            out.push("        w.write_packed_varints({num}, {fref}) catch false")
        else:
            fail parse_fail("repeated '{f.ptype}' fields are not supported yet")
        return out
    if is_message(f.ptype, message_names):
        tn := simple_name(f.ptype)
        # a per-field binding name, so two message fields of different types
        # in one encoder never share a name.
        sub := "sub_{f.name}"
        out.push("    if let {sub} = {fref}:")
        out.push("        w.write_message({num}, encode_{tn}({sub})) catch false")
        return out
    method := write_method(f.ptype, enum_names)
    if method == "":
        fail parse_fail("field type '{f.ptype}' is not supported yet")
    guard := zero_guard(f.name, f.ptype, enum_names)
    out.push("    {guard}")
    out.push("        w.{method}({num}, {fref}) catch false")
    return out

# the decode arm for one field. `first` picks `if` vs `elif` for the dispatch.
fn decode_field(f: Field, first: Bool, message_names: List[String], enum_names: List[String]) -> List[String]!ParseError:
    out: List[String] := []
    num := "{f.number}"
    fref := "m.{f.name}"
    mut keyword := "elif"
    if first:
        keyword = "if"
    out.push("        {keyword} tag.field == {num}:")
    if f.label == "repeated":
        if is_message(f.ptype, message_names):
            tn := simple_name(f.ptype)
            out.push("            {fref}.push(decode_{tn}(r.read_message()!)!)")
        elif f.ptype == "string":
            out.push("            {fref}.push(r.read_string()!)")
        elif f.ptype == "bytes":
            out.push("            {fref}.push(r.read_bytes()!)")
        elif is_packable_varint(f.ptype, enum_names):
            out.push("            if tag.wire == WIRE_LEN:")
            out.push("                for v in r.read_packed_varints()!:")
            out.push("                    {fref}.push(v)")
            out.push("            else:")
            out.push("                {fref}.push(r.read_int64()!)")
        else:
            fail parse_fail("repeated '{f.ptype}' fields are not supported yet")
        return out
    if is_message(f.ptype, message_names):
        tn := simple_name(f.ptype)
        out.push("            {fref} = decode_{tn}(r.read_message()!)!")
        return out
    rmethod := read_method(f.ptype, enum_names)
    out.push("            {fref} = r.{rmethod}()!")
    return out

# the encode-body lines for one map field: each entry is a little message
# (key = 1, value = 2) written length-delimited on the map's field number.
# key and value always write, even at their zero values, so every entry on
# the wire names both. an empty map writes nothing.
fn encode_map(mf: MapField, message_names: List[String], enum_names: List[String]) -> List[String]!ParseError:
    out: List[String] := []
    num := "{mf.number}"
    fref := "m.{mf.name}"
    # per-field binding names, so two map fields in one message never share a
    # name across loops of different types.
    k := "k_{mf.name}"
    ew := "ew_{mf.name}"
    kmethod := write_method(mf.key_type, enum_names)
    out.push("    for {k} in {fref}.keys():")
    out.push("        {ew} := writer()")
    out.push("        {ew}.{kmethod}(1, {k}) catch false")
    if is_message(mf.value_type, message_names):
        tn := simple_name(mf.value_type)
        out.push("        {ew}.write_message(2, encode_{tn}({fref}[{k}])) catch false")
    else:
        vmethod := write_method(mf.value_type, enum_names)
        if vmethod == "":
            fail parse_fail("map value type '{mf.value_type}' is not supported yet")
        out.push("        {ew}.{vmethod}(2, {fref}[{k}]) catch false")
    out.push("        w.write_message({num}, {ew}.bytes()) catch false")
    out.push("        {ew}.free()")
    return out

# the value a decoded map entry starts from: proto3 lets an entry omit its
# value, which then means the zero value. a message value decodes from no
# bytes, which is exactly its all-defaults form.
fn map_value_zero(vtype: String, message_names: List[String], enum_names: List[String]) -> String:
    if is_message(vtype, message_names):
        tn := simple_name(vtype)
        return "decode_{tn}(bytes.empty())!"
    return scalar_zero(scalar_pith_type(vtype, message_names, enum_names))

# the decode arm for one map field: read the entry message, parse key (1) and
# value (2) starting from their zero values (proto3 lets either be omitted),
# and insert. insert overwrites, so a duplicate key is last-one-wins.
fn decode_map_field(mf: MapField, first: Bool, message_names: List[String], enum_names: List[String]) -> List[String]:
    out: List[String] := []
    num := "{mf.number}"
    mut keyword := "elif"
    if first:
        keyword = "if"
    # per-field binding names, same reason as in encode_map.
    er := "er_{mf.name}"
    et := "et_{mf.name}"
    mk := "mk_{mf.name}"
    mv := "mv_{mf.name}"
    mut key_zero := "0"
    if mf.key_type == "string":
        key_zero = "\"\""
    kread := read_method(mf.key_type, enum_names)
    value_zero := map_value_zero(mf.value_type, message_names, enum_names)
    out.push("        {keyword} tag.field == {num}:")
    out.push("            {er} := reader(r.read_message()!)")
    out.push("            mut {mk} := {key_zero}")
    out.push("            mut {mv} := {value_zero}")
    out.push("            while not {er}.at_end():")
    out.push("                {et} := {er}.read_tag()!")
    out.push("                if {et}.field == 1:")
    out.push("                    {mk} = {er}.{kread}()!")
    out.push("                elif {et}.field == 2:")
    if is_message(mf.value_type, message_names):
        tn := simple_name(mf.value_type)
        out.push("                    {mv} = decode_{tn}({er}.read_message()!)!")
    else:
        vread := read_method(mf.value_type, enum_names)
        out.push("                    {mv} = {er}.{vread}()!")
    out.push("                else:")
    out.push("                    {er}.skip({et}.wire)!")
    out.push("            m.{mf.name}.insert({mk}, {mv})")
    return out

# the enum + constructor lines for one oneof group, emitted just before the
# containing struct. constructors exist because cross-module enum-variant
# construction has been buggy; std.sql's Value works around it the same way.
fn oneof_type_lines(msg_name: String, o: Oneof, message_names: List[String], enum_names: List[String]) -> List[String]:
    ename := oneof_enum_name(msg_name, o)
    out: List[String] := []
    out.push("# oneof {o.name} of {msg_name}. {ename}Unset means no member is set.")
    out.push("pub enum {ename}:")
    out.push("    {ename}Unset")
    for f in o.fields:
        variant := camel(f.name)
        vt := scalar_pith_type(f.ptype, message_names, enum_names)
        out.push("    {variant}({vt})")
    out.push("")
    out.push("# constructors for {ename}; call these from other modules rather than")
    out.push("# constructing the variants directly.")
    out.push("pub fn {msg_name}_{o.name}_unset() -> {ename}:")
    out.push("    return {ename}.{ename}Unset")
    for f in o.fields:
        variant := camel(f.name)
        vt := scalar_pith_type(f.ptype, message_names, enum_names)
        out.push("pub fn {msg_name}_{f.name}(v: {vt}) -> {ename}:")
        out.push("    return {ename}.{variant}(v)")
    out.push("")
    return out

# the encode-body lines for one oneof group: match on the enum and write the
# set member as a singular field of its type. a set member writes even at its
# zero value (oneof presence); Unset writes nothing.
fn encode_oneof(msg_name: String, o: Oneof, message_names: List[String], enum_names: List[String]) -> List[String]!ParseError:
    ename := oneof_enum_name(msg_name, o)
    out: List[String] := []
    out.push("    match m.{o.name}:")
    for f in o.fields:
        variant := camel(f.name)
        num := "{f.number}"
        # each arm binds under its own name. reusing one name across arms of
        # different payload types now compiles, but the compiler drops such a
        # mixed-kind name from the exit cleanup, leaking the payload on every
        # call; per-arm names stay tracked and leak-free.
        v := "v_{f.name}"
        if is_message(f.ptype, message_names):
            tn := simple_name(f.ptype)
            out.push("        {ename}.{variant}({v}) => w.write_message({num}, encode_{tn}({v})) catch false")
        else:
            method := write_method(f.ptype, enum_names)
            if method == "":
                fail parse_fail("field type '{f.ptype}' is not supported yet")
            out.push("        {ename}.{variant}({v}) => w.{method}({num}, {v}) catch false")
    out.push("        {ename}.{ename}Unset => false")
    return out

# the decode arm for one oneof member: seeing its field number sets the group
# to that variant, so the last member on the wire wins.
fn decode_oneof_field(ename: String, oname: String, f: Field, first: Bool, message_names: List[String], enum_names: List[String]) -> List[String]:
    out: List[String] := []
    num := "{f.number}"
    variant := camel(f.name)
    mut keyword := "elif"
    if first:
        keyword = "if"
    out.push("        {keyword} tag.field == {num}:")
    if is_message(f.ptype, message_names):
        tn := simple_name(f.ptype)
        out.push("            m.{oname} = {ename}.{variant}(decode_{tn}(r.read_message()!)!)")
    else:
        rmethod := read_method(f.ptype, enum_names)
        out.push("            m.{oname} = {ename}.{variant}(r.{rmethod}()!)")
    return out

# generate the full pith module for a parsed proto file.
pub fn generate(pf: ProtoFile) -> String!ParseError:
    # the used well-known types join the user's messages as synthesized
    # definitions and generate like any other message.
    wkt_used := used_wkts(pf, message_names_of(pf.messages))!
    all_messages: List[Message] := []
    for m in pf.messages:
        all_messages.push(m)
    for wkt_name in wkt_used:
        all_messages.push(wkt_message(wkt_name))
    message_names := message_names_of(all_messages)
    enum_names := enum_names_of(pf)
    lines: List[String] := []
    lines.push("# generated from a .proto file by tools/protogen; do not edit by hand.")
    pkg := pf.package
    if pkg != "":
        lines.push("# proto package: {pkg}")
    lines.push("")
    lines.push("from std.protobuf import ProtoError, writer, reader, WIRE_LEN")
    lines.push("import std.bytes as bytes")
    if pf.services.len() > 0:
        lines.push("import std.net.grpc as grpc")
    lines.push("")

    for e in pf.enums:
        lines.push("# enum {e.name}")
        for v in e.values:
            cname := "{e.name}_{v.name}"
            cval := "{v.value}"
            lines.push("pub {cname} := {cval}")
        lines.push("")

    # "{}" as literal text: an empty map literal for constructor defaults.
    empty_map := chr(123) + chr(125)

    ordered := topo_sort(all_messages, message_names)
    for m in ordered:
        no_members := m.fields.len() == 0 and m.oneofs.len() == 0 and m.maps.len() == 0

        # each oneof group gets its payload enum + constructors first, so the
        # struct below can name them.
        for o in m.oneofs:
            for ln in oneof_type_lines(m.name, o, message_names, enum_names):
                lines.push(ln)

        # struct
        if list_has(wkt_used, m.name):
            lines.push("# message {m.name} (synthesized well-known type google.protobuf.{m.name})")
        else:
            lines.push("# message {m.name}")
        lines.push("pub struct {m.name}:")
        if no_members:
            lines.push("    pub _empty: Bool")
        for f in m.fields:
            ft := pith_type(f, message_names, enum_names)
            lines.push("    pub {f.name}: {ft}")
        for mf in m.maps:
            mt := map_pith_type(mf, message_names, enum_names)
            lines.push("    pub {mf.name}: {mt}")
        for o in m.oneofs:
            ename := oneof_enum_name(m.name, o)
            lines.push("    pub {o.name}: {ename}")
        lines.push("")

        # a default-valued constructor value, for decode to start from
        ctor_args: List[String] := []
        for f in m.fields:
            dv := default_value(f, message_names, enum_names)
            ctor_args.push("{f.name}: {dv}")
        for mf in m.maps:
            ctor_args.push("{mf.name}: {empty_map}")
        for o in m.oneofs:
            ename := oneof_enum_name(m.name, o)
            ctor_args.push("{o.name}: {ename}.{ename}Unset")
        mut ctor := strings.join_nonempty(ctor_args, ", ")
        if no_members:
            ctor = "_empty: false"

        # encode
        lines.push("# encode a {m.name} to protobuf wire bytes.")
        lines.push("pub fn encode_{m.name}(m: {m.name}) -> Bytes:")
        lines.push("    w := writer()")
        for f in m.fields:
            for ln in encode_field(f, message_names, enum_names)!:
                lines.push(ln)
        for mf in m.maps:
            for ln in encode_map(mf, message_names, enum_names)!:
                lines.push(ln)
        for o in m.oneofs:
            for ln in encode_oneof(m.name, o, message_names, enum_names)!:
                lines.push(ln)
        lines.push("    out := w.bytes()")
        lines.push("    w.free()")
        lines.push("    return out")
        lines.push("")

        # decode
        lines.push("# decode a {m.name} from protobuf wire bytes.")
        lines.push("pub fn decode_{m.name}(data: Bytes) -> {m.name}!ProtoError:")
        lines.push("    m := {m.name}({ctor})")
        lines.push("    r := reader(data)")
        lines.push("    while not r.at_end():")
        lines.push("        tag := r.read_tag()!")
        if no_members:
            lines.push("        r.skip(tag.wire)!")
        else:
            mut first := true
            for f in m.fields:
                for ln in decode_field(f, first, message_names, enum_names)!:
                    lines.push(ln)
                first = false
            for mf in m.maps:
                for ln in decode_map_field(mf, first, message_names, enum_names):
                    lines.push(ln)
                first = false
            for o in m.oneofs:
                ename := oneof_enum_name(m.name, o)
                for f in o.fields:
                    for ln in decode_oneof_field(ename, o.name, f, first, message_names, enum_names):
                        lines.push(ln)
                    first = false
            lines.push("        else:")
            lines.push("            r.skip(tag.wire)!")
        lines.push("    return m")
        lines.push("")

    for svc in pf.services:
        for ln in gen_service_lines(svc, pf.package):
            lines.push(ln)
        for ln in gen_server_lines(svc, pf.package):
            lines.push(ln)

    return strings.join_lines(lines)

# generate the typed client stubs for one service: a `<Svc>Client` wrapping a
# grpc.Conn with a method per rpc, plus a handle struct for each streaming rpc.
# the handle structs come first so the client impl can name them.
fn gen_service_lines(svc: Service, pkg: String) -> List[String]:
    out: List[String] := []
    q := chr(34)
    mut svc_path := svc.name
    if pkg != "":
        svc_path = "{pkg}.{svc.name}"

    for rpc in svc.rpcs:
        handle := "{svc.name}{rpc.name}Call"
        req := rpc.req_type
        resp := rpc.resp_type
        derr := "{q}grpc: decode {resp} failed{q}"
        if rpc.server_streaming and not rpc.client_streaming:
            out.push("# a typed server-stream of {resp} messages from {svc.name}.{rpc.name}.")
            out.push("pub struct {handle}:")
            out.push("    pub inner: grpc.ServerStream")
            out.push("")
            out.push("impl {handle}:")
            out.push("    # gather and decode every response message.")
            out.push("    pub fn collect() -> List[{resp}]!grpc.GrpcError:")
            out.push("        items: List[{resp}] := []")
            out.push("        raw := grpc.collect_server_stream(self.inner)!")
            out.push("        for frame in raw:")
            out.push("            decoded := decode_{resp}(frame)")
            out.push("            if decoded.is_err:")
            out.push("                fail grpc.GrpcError(status: grpc.GRPC_INTERNAL, message: {derr})")
            out.push("            items.push(decoded.ok)")
            out.push("        return items")
            out.push("")
        elif rpc.client_streaming and not rpc.server_streaming:
            out.push("# a typed client-stream to {svc.name}.{rpc.name}.")
            out.push("pub struct {handle}:")
            out.push("    pub inner: grpc.ClientStream")
            out.push("")
            out.push("impl {handle}:")
            out.push("    # send one request message.")
            out.push("    pub fn send(req: {req}) -> Int:")
            out.push("        return self.inner.send(encode_{req}(req))")
            out.push("    # half-close the request stream.")
            out.push("    pub fn close_send() -> Int:")
            out.push("        return self.inner.close_send()")
            out.push("    # read and decode the single response.")
            out.push("    pub fn recv_response() -> {resp}!grpc.GrpcError:")
            out.push("        raw := self.inner.recv_response()!")
            out.push("        decoded := decode_{resp}(raw)")
            out.push("        if decoded.is_err:")
            out.push("            fail grpc.GrpcError(status: grpc.GRPC_INTERNAL, message: {derr})")
            out.push("        return decoded.ok")
            out.push("")
        elif rpc.client_streaming and rpc.server_streaming:
            out.push("# a typed bidirectional stream for {svc.name}.{rpc.name}.")
            out.push("pub struct {handle}:")
            out.push("    pub inner: grpc.BidiStream")
            out.push("")
            out.push("impl {handle}:")
            out.push("    # send one request message.")
            out.push("    pub fn send(req: {req}) -> Int:")
            out.push("        return self.inner.send(encode_{req}(req))")
            out.push("    # half-close the request stream.")
            out.push("    pub fn close_send() -> Int:")
            out.push("        return self.inner.close_send()")
            out.push("    # gather and decode every response message.")
            out.push("    pub fn collect() -> List[{resp}]!grpc.GrpcError:")
            out.push("        items: List[{resp}] := []")
            out.push("        mut done := false")
            out.push("        while not done:")
            out.push("            msg := self.inner.recv()!")
            out.push("            if msg.done:")
            out.push("                done = true")
            out.push("            else:")
            out.push("                decoded := decode_{resp}(msg.message)")
            out.push("                if decoded.is_err:")
            out.push("                    fail grpc.GrpcError(status: grpc.GRPC_INTERNAL, message: {derr})")
            out.push("                items.push(decoded.ok)")
            out.push("        return items")
            out.push("")

    out.push("# a typed grpc client for the {svc.name} service.")
    out.push("pub struct {svc.name}Client:")
    out.push("    conn: grpc.Conn")
    out.push("")
    out.push("# wrap a grpc connection in a typed {svc.name} client.")
    out.push("pub fn new_{svc.name}Client(conn: grpc.Conn) -> {svc.name}Client:")
    out.push("    return {svc.name}Client(conn: conn)")
    out.push("")
    out.push("impl {svc.name}Client:")
    for rpc in svc.rpcs:
        handle := "{svc.name}{rpc.name}Call"
        req := rpc.req_type
        resp := rpc.resp_type
        derr := "{q}grpc: decode {resp} failed{q}"
        path := "{q}/{svc_path}/{rpc.name}{q}"
        if not rpc.client_streaming and not rpc.server_streaming:
            out.push("    # unary rpc {rpc.name}.")
            out.push("    pub fn {rpc.name}(req: {req}) -> {resp}!grpc.GrpcError:")
            out.push("        raw := self.conn.unary({path}, encode_{req}(req))!")
            out.push("        decoded := decode_{resp}(raw)")
            out.push("        if decoded.is_err:")
            out.push("            fail grpc.GrpcError(status: grpc.GRPC_INTERNAL, message: {derr})")
            out.push("        return decoded.ok")
        elif rpc.server_streaming and not rpc.client_streaming:
            out.push("    # server-streaming rpc {rpc.name}.")
            out.push("    pub fn {rpc.name}(req: {req}) -> {handle}!grpc.GrpcError:")
            out.push("        inner := self.conn.server_stream({path}, encode_{req}(req))!")
            out.push("        return {handle}(inner: inner)")
        elif rpc.client_streaming and not rpc.server_streaming:
            out.push("    # client-streaming rpc {rpc.name}.")
            out.push("    pub fn {rpc.name}() -> {handle}!grpc.GrpcError:")
            out.push("        inner := self.conn.client_stream({path})!")
            out.push("        return {handle}(inner: inner)")
        else:
            out.push("    # bidirectional-streaming rpc {rpc.name}.")
            out.push("    pub fn {rpc.name}() -> {handle}!grpc.GrpcError:")
            out.push("        inner := self.conn.bidi_stream({path})!")
            out.push("        return {handle}(inner: inner)")
    out.push("")
    return out

# generate server-side stubs for one service: a settable handler slot per rpc, a
# body-level router that deframes/decodes each request and dispatches by method
# path, and serve_<Svc>/serve_<Svc>_tls that install the handlers and start
# grpc.serve_body. the handlers live in module globals because grpc's dispatch is
# a bare fn-value that cannot capture; a pith closure cannot either. the handler
# shape follows the rpc: unary (Req) -> Resp, server-streaming (Req) ->
# List[Resp], client-streaming (List[Req]) -> Resp, bidi (List[Req]) ->
# List[Resp]. every streamed side is buffered — the whole request and reply pass
# through memory — which fits bounded streams, not endless ones.
fn gen_server_lines(svc: Service, pkg: String) -> List[String]:
    out: List[String] := []
    q := chr(34)
    mut svc_path := svc.name
    if pkg != "":
        svc_path = "{pkg}.{svc.name}"
    if svc.rpcs.len() == 0:
        return out

    out.push("# a server for the {svc.name} service. implement one handler per rpc and")
    out.push("# hand them to serve_{svc.name}; the router deframes and decodes each")
    out.push("# request, dispatches by method path, and frames the reply. a streamed")
    out.push("# request arrives as a List, and a streamed reply is returned as one —")
    out.push("# buffered end to end, so bounded streams only.")
    for rpc in svc.rpcs:
        req_t := server_req_type(rpc)
        resp_t := server_resp_type(rpc)
        out.push("fn _{svc.name}_{rpc.name}_unimpl(req: {req_t}) -> {resp_t}!grpc.GrpcError:")
        out.push("    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: {q}{rpc.name} not implemented{q})")
        out.push("mut _{svc.name}_{rpc.name}_fn: fn({req_t}) -> {resp_t}!grpc.GrpcError := _{svc.name}_{rpc.name}_unimpl")
    out.push("")

    out.push("fn _{svc.name}_route(path: String, body: Bytes) -> Bytes!grpc.GrpcError:")
    for rpc in svc.rpcs:
        req := rpc.req_type
        resp := rpc.resp_type
        out.push("    if path == {q}/{svc_path}/{rpc.name}{q}:")
        out.push("        msgs := grpc.unframe_messages(body)!")
        if rpc.client_streaming:
            # every request message decodes into the handler's List[Req]
            out.push("        mut requests: List[{req}] := []")
            out.push("        for msg in msgs:")
            out.push("            decoded := decode_{req}(msg)")
            out.push("            if decoded.is_err:")
            out.push("                fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: {q}grpc: decode {req} failed{q})")
            out.push("            requests.push(decoded.ok)")
        else:
            # exactly one request message; an empty body is an all-default one
            out.push("        if msgs.len() > 1:")
            out.push("            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: {q}expected one request message{q})")
            out.push("        mut request := bytes.empty()")
            out.push("        if msgs.len() == 1:")
            out.push("            request = msgs[0]")
            out.push("        decoded := decode_{req}(request)")
            out.push("        if decoded.is_err:")
            out.push("            fail grpc.GrpcError(status: grpc.GRPC_INVALID_ARGUMENT, message: {q}grpc: decode {req} failed{q})")
        mut arg := "decoded.ok"
        if rpc.client_streaming:
            arg = "requests"
        if rpc.server_streaming:
            out.push("        replies := _{svc.name}_{rpc.name}_fn({arg})!")
            out.push("        mut framed: List[Bytes] := []")
            out.push("        for reply in replies:")
            out.push("            framed.push(encode_{resp}(reply))")
            out.push("        return grpc.frame_messages(framed)")
        else:
            out.push("        return grpc.frame_one(encode_{resp}(_{svc.name}_{rpc.name}_fn({arg})!))")
    out.push("    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: {q}no method {q} + path)")
    out.push("")

    mut params := ""
    for rpc, i in svc.rpcs:
        if i > 0:
            params = params + ", "
        params = params + "{rpc.name}: fn({server_req_type(rpc)}) -> {server_resp_type(rpc)}!grpc.GrpcError"

    out.push("# serve {svc.name} over plaintext http/2 (h2c). pass one handler per rpc.")
    out.push("pub fn serve_{svc.name}(host: String, port: Int, {params}) -> Int!:")
    for rpc in svc.rpcs:
        out.push("    _{svc.name}_{rpc.name}_fn = {rpc.name}")
    out.push("    return grpc.serve_body(host, port, _{svc.name}_route)!")
    out.push("")
    out.push("# serve {svc.name} over http/2 with tls (alpn h2).")
    out.push("pub fn serve_{svc.name}_tls(host: String, port: Int, cert: String, key: String, {params}) -> Int!:")
    for rpc in svc.rpcs:
        out.push("    _{svc.name}_{rpc.name}_fn = {rpc.name}")
    out.push("    return grpc.serve_body_tls(host, port, cert, key, _{svc.name}_route)!")
    out.push("")
    return out

# the server handler's request type: the message, or a List of it when the
# client streams.
fn server_req_type(rpc: Rpc) -> String:
    if rpc.client_streaming:
        return "List[{rpc.req_type}]"
    return rpc.req_type

# the server handler's reply type: the message, or a List of it when the server
# streams.
fn server_resp_type(rpc: Rpc) -> String:
    if rpc.server_streaming:
        return "List[{rpc.resp_type}]"
    return rpc.resp_type
