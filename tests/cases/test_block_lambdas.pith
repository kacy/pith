# multi-line closure bodies (fn(x): block) and map get_default for both
# key kinds. block lambdas infer their return type from their returns and
# capture outer variables like the short form.

fn apply(f: fn(Int) -> Int, x: Int) -> Int:
    return f(x)

fn main():
    stepper := fn(x: Int):
        mut acc := x
        if acc > 3:
            acc = acc + 100
        return acc + 1
    print("big = {apply(stepper, 5)}")
    print("small = {apply(stepper, 1)}")

    base := 10
    offset := fn(x: Int):
        mut total := base + x
        mut i := 0
        while i < 3:
            total = total + 1
            i = i + 1
        return total
    print("offset = {apply(offset, 5)}")

    mut m: Map[String, Int] := {}
    m.insert("a", 1)
    print("a = {m.get_default("a", 0)}")
    print("z = {m.get_default("z", 42)}")
    mut im: Map[Int, String] := {}
    im.insert(1, "one")
    print("one = {im.get_default(1, "?")}")
    print("missing = {im.get_default(9, "?")}")
