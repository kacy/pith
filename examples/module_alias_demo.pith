# module_alias_demo.pith — demonstrates import patterns
# shows: from_import, import with alias, and namespace usage

# standard from_import - imports specific functions into current scope.
# only names the module declares can be imported this way; abs, min, max
# and clamp are builtins and need no import
from std.math import sqrt, hypot

# import with alias - creates a readable module namespace
import std.math as math_lib
import std.io as io

fn test_direct_imports():
    # functions imported directly into scope
    print("hypot(3.0, 4.0) = {hypot(3.0, 4.0)}")
    print("sqrt(16.0) = {sqrt(16.0)}")

    # builtins, available without an import
    result := abs(-42)
    print("abs(-42) = {result}")

    min_val := min(10, 5)
    max_val := max(10, 5)
    print("min(10, 5) = {min_val}")
    print("max(10, 5) = {max_val}")

    clamped := clamp(15, 0, 10)
    print("clamp(15, 0, 10) = {clamped}")

fn main() -> Int!:
    print("Module Import Patterns Demonstration")
    print("====================================")
    test_direct_imports()
    print("Direct import tests passed!")
    print("")
    print("math_lib.abs_float(-12.5) = {math_lib.abs_float(-12.5)}")
    reader := io.string_reader("module alias io")
    defer reader.close()
    print(reader.read_all()!)
    return 0
