# ir_field_helpers.pith - field access metadata and emission helpers

from checker import c_get_expr_type
from ir_builder import ir_emit, ir_reg
from ir_type_helpers import ir_retkind_with_state, ir_type_from_tid
from ir_utils import ir_parse_field_index, ir_unpack_field_index
from types import get_type_info

# the byte offset of a field called field_name, when every struct in the
# program that declares that name puts it at the same slot. this is the
# guess the emitter falls back to once it has failed to pin down the
# receiver's type, so the whole value of it is the ambiguity check:
# returns -1 both when no struct declares the name and when two declare
# it at different slots, which makes an ambiguous name a clean miss
# rather than a silently wrong offset. the offset is slot index * 8.
# boxed enum variants live in the same table, so a variant name can
# take part in the match.
pub fn ir_unique_field_offset_with_state(field_name: String, struct_field_index_lookup: Map[String, String]) -> Int:
    keys := struct_field_index_lookup.keys()
    mut matched := false
    mut offset := 0
    for key in keys:
        if key.ends_with("." + field_name):
            next_offset := ir_unpack_field_index(struct_field_index_lookup[key]) * 8
            if not matched:
                matched = true
                offset = next_offset
            elif offset != next_offset:
                return 0 - 1
            continue
    if not matched:
        return 0 - 1
    return offset

# the emission kind for a field called field_name, on the same
# unambiguous-across-the-whole-program basis as
# ir_unique_field_offset_with_state, and normally called straight after
# it. returns "unknown" — never "" — when no struct declares the name
# and equally when two declare it with different kinds. degrading to
# "unknown" matters: the kind is what tells the ir consumer whether the
# loaded register holds a string, bytes, a float or a struct, so a
# confidently wrong kind here would put a retain or release on a value
# that never needed one.
pub fn ir_unique_field_kind_with_state(field_name: String, struct_field_lookup: Map[String, String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    keys := struct_field_lookup.keys()
    mut matched := false
    mut field_kind := "unknown"
    for key in keys:
        if key.ends_with("." + field_name):
            next_kind := ir_retkind_with_state(struct_field_lookup[key], type_aliases, struct_names)
            if not matched:
                matched = true
                field_kind = next_kind
            elif field_kind != next_kind:
                return "unknown"
            continue
    return field_kind

# emit the `field` read that loads obj_r's field into result_reg. the
# offset is resolved through four tiers in order: the exact
# "Struct.field" entry keyed by lookup_key; an offset that is
# unambiguous across every struct in the program; the fixed result
# layout for is_ok/ok/err/is_err; and finally the bare no-offset form.
# that last tier only assembles when field_name is a numeric tuple
# index — for a real field name the ir consumer rejects the program with
# "field instruction requires an explicit offset", so falling all the
# way through is a bug earlier in the pipeline rather than a graceful
# degradation. field_kind_override, when non-empty, beats the kind
# recorded for the field; that kind drives the consumer's tracking of
# which registers hold rc-managed values, so it decides what the caller
# has to retain or release around this read. the read itself takes no
# count: nothing here emits a retain or a release.
pub fn ir_emit_named_field_access_with_state(result_reg: Int, obj_r: Int, lookup_key: String, field_name: String, field_kind_override: String, struct_field_index_lookup: Map[String, String], struct_field_lookup: Map[String, String], type_aliases: Map[String, String], struct_names: Map[String, Int]):
    if struct_field_index_lookup.contains_key(lookup_key):
        field_offset := ir_unpack_field_index(struct_field_index_lookup[lookup_key]) * 8
        mut field_kind := "unknown"
        if field_kind_override.len() > 0:
            field_kind = field_kind_override
        elif struct_field_lookup.contains_key(lookup_key):
            field_kind = ir_retkind_with_state(struct_field_lookup[lookup_key], type_aliases, struct_names)
        ir_emit("field " + result_reg.to_string() + " " + obj_r.to_string() + " " + field_offset.to_string() + " " + field_kind + " " + field_name)
    else:
        unique_offset := ir_unique_field_offset_with_state(field_name, struct_field_index_lookup)
        if unique_offset >= 0:
            unique_kind := ir_unique_field_kind_with_state(field_name, struct_field_lookup, type_aliases, struct_names)
            ir_emit("field " + result_reg.to_string() + " " + obj_r.to_string() + " " + unique_offset.to_string() + " " + unique_kind + " " + field_name)
        elif field_name == "is_ok" or field_name == "is_err" or field_name == "ok" or field_name == "err":
            # a result field on a value whose payload type is a generic
            # parameter: the struct lookup knows nothing, but a result's
            # layout is fixed regardless of what it carries — flag at 0,
            # ok at 8, err at 16. without this the bare no-offset form went
            # out and the consumer rejected the program. is_err is the flag
            # negated, since only is_ok is stored.
            if field_name == "is_err":
                flag_r := ir_reg()
                ir_emit("field " + flag_r.to_string() + " " + obj_r.to_string() + " 0 bool is_ok")
                zero_r := ir_reg()
                ir_emit("iconst " + zero_r.to_string() + " 0")
                ir_emit("eq " + result_reg.to_string() + " " + flag_r.to_string() + " " + zero_r.to_string())
            else:
                mut offset := 0
                mut kind := "bool"
                if field_name == "ok":
                    offset = 8
                    kind = "unknown"
                elif field_name == "err":
                    offset = 16
                    kind = "unknown"
                ir_emit("field " + result_reg.to_string() + " " + obj_r.to_string() + " " + offset.to_string() + " " + kind + " " + field_name)
        else:
            ir_emit("field " + result_reg.to_string() + " " + obj_r.to_string() + " " + field_name)

# emit a tuple element read — `t.0`, `t.1` — and report whether it
# applied. false means nothing was emitted and the caller should fall
# through to the named-struct path: that happens when the checker never
# typed the receiver, typed it as something other than a tuple, or when
# field_name is not a decimal index inside the tuple's arity. the
# element's own type id gives the kind, and every element is one 8-byte
# slot, so this path has none of the name ambiguity the struct path has
# to guard against — which is why the caller tries it first.
pub fn ir_emit_tuple_field_access(result_reg: Int, obj_r: Int, recv_idx: Int, field_name: String) -> Bool:
    recv_tid := c_get_expr_type(recv_idx)
    if recv_tid < 0:
        return false
    recv_info := get_type_info(recv_tid)
    if recv_info.kind != "tuple":
        return false
    field_index := ir_parse_field_index(field_name)
    if field_index < 0 or field_index >= recv_info.elements.len():
        return false
    field_tid := recv_info.elements[field_index]
    field_offset := field_index * 8
    ir_emit("field " + result_reg.to_string() + " " + obj_r.to_string() + " " + field_offset.to_string() + " " + ir_type_from_tid(field_tid) + " " + field_name)
    return true
