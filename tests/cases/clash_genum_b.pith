# helper for test_generic_enum_name_clash: the other module that declares
# the generic enum Opt, with its variants in a different order.
pub enum Opt[T]:
    Nothing
    Some(T)

pub fn some_b(v: String) -> Opt[String]:
    return Opt.Some(v)

pub fn read_b(o: Opt[String]) -> String:
    match o:
        Opt.Some(s) => "b some {s}"
        Opt.Nothing => "b nothing"

pub fn wrap_b[T](v: T) -> Opt[T]:
    return Opt.Some(v)

pub fn none_b() -> Opt[String]:
    return Opt.Nothing
