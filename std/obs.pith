# std.obs - turn on tracing and metrics export with one call.
#
# obs.init() reads the standard OTEL_* environment variables, flips std.trace
# on, tells std.metrics to start collecting, and spawns a background exporter
# that periodically ships finished spans and the current metric snapshot to an
# OTLP/HTTP collector (see std.otlp).
#
#     import std.obs as obs
#
#     fn main():
#         obs.init()          # reads OTEL_EXPORTER_OTLP_ENDPOINT et al.
#         ... run your app; spans and metrics now export in the background ...
#         obs.shutdown()      # optional: stop the loop and flush one last time.
#
# with no OTEL_EXPORTER_OTLP_ENDPOINT set, init() does nothing and the program
# runs uninstrumented, so leaving the call in costs nothing in production.

import std.env as env
import std.metrics as metrics
import std.otlp as otlp
import std.strings as strings
import std.time as time
import std.trace as trace
import std.uuid as uuid

# environment variable names, matching the OpenTelemetry SDK conventions.
OTEL_SERVICE_NAME := "OTEL_SERVICE_NAME"
OTEL_SERVICE_VERSION := "OTEL_SERVICE_VERSION"
OTEL_SERVICE_INSTANCE_ID := "OTEL_SERVICE_INSTANCE_ID"
OTEL_ENDPOINT := "OTEL_EXPORTER_OTLP_ENDPOINT"
OTEL_PROTOCOL := "OTEL_EXPORTER_OTLP_PROTOCOL"
OTEL_METRIC_INTERVAL := "OTEL_METRIC_EXPORT_INTERVAL"
# extra export headers ("k1=v1,k2=v2"), the per-request timeout (ms), and the
# body compression ("gzip" turns it on; "none"/unset leaves it off).
OTEL_HEADERS := "OTEL_EXPORTER_OTLP_HEADERS"
OTEL_TIMEOUT := "OTEL_EXPORTER_OTLP_TIMEOUT"
OTEL_COMPRESSION := "OTEL_EXPORTER_OTLP_COMPRESSION"
# the batch-span-processor schedule delay controls how often spans are flushed.
OTEL_SPAN_DELAY := "OTEL_BSP_SCHEDULE_DELAY"
# the head sampler and its argument (a probability for the traceidratio modes).
OTEL_SAMPLER := "OTEL_TRACES_SAMPLER"
OTEL_SAMPLER_ARG := "OTEL_TRACES_SAMPLER_ARG"

# the default service.name when OTEL_SERVICE_NAME is unset.
DEFAULT_SERVICE_NAME := "pith-service"
# default metric export interval (ms) and span flush interval (ms).
DEFAULT_METRIC_INTERVAL_MS := 60000
DEFAULT_SPAN_DELAY_MS := 5000
# the OTel-default sampler: honor a parent's decision, sample new roots. its
# probability default (1.0) is passed as a literal at the call site rather than a
# module constant, because a module-level float constant is miscompiled to zero.
DEFAULT_SAMPLER := "parentbased_always_on"

# guards the two flags below so init/shutdown and the loop agree on state. every
# access goes through it: set_running and is_running for the loop, and the
# read-modify-writes in start and shutdown, which is what makes init idempotent
# rather than merely usually-idempotent. the flush calls are outside it, so the
# exporter's POST never runs under the lock.
mut obs_mu := Mutex()
# whether init has already run (init is idempotent).
mut started := false
# whether the exporter loop should keep going; shutdown() clears it.
mut running := false

fn set_running(on: Bool):
    obs_mu.lock()
    running = on
    obs_mu.unlock()

fn is_running() -> Bool:
    obs_mu.lock()
    r := running
    obs_mu.unlock()
    return r

# flush all finished spans to the collector, best effort (a failed POST is
# swallowed so the loop keeps running).
fn flush_spans(dest: otlp.Target):
    spans := trace.drain_finished_spans()
    otlp.export_traces(dest, spans) catch false

# flush the current metric snapshot to the collector, best effort.
fn flush_metrics(dest: otlp.Target):
    otlp.export_metrics(dest, metrics.snapshot()) catch false

# the background loop: wake every `tick` ms to flush spans, and flush metrics
# once every `metric_interval` ms. on shutdown it does one last flush of both.
fn run_exporter(dest: otlp.Target, tick: Int, metric_interval: Int):
    mut since_metrics := 0
    while is_running():
        time.delay(tick)
        flush_spans(dest)
        since_metrics = since_metrics + tick
        if since_metrics >= metric_interval:
            flush_metrics(dest)
            since_metrics = 0
    # a clean shutdown drains whatever is left.
    flush_spans(dest)
    flush_metrics(dest)

# the smaller of two positive intervals, but never below 1ms so the loop cannot
# busy-spin. the tick is min(span delay, metric interval) so neither signal is
# starved when one interval is much shorter than the other.
fn loop_tick(span_delay: Int, metric_interval: Int) -> Int:
    mut tick := span_delay
    if metric_interval < tick:
        tick = metric_interval
    if tick < 1:
        return 1
    return tick

# parse an OTEL_EXPORTER_OTLP_HEADERS spec ("k1=v1,k2=v2") into a flat
# [k1, v1, k2, v2, ...] header list for the exporter. each entry is split once on
# "=", key and value are trimmed, and any entry without a "=" or with an empty key
# is skipped, so malformed headers are dropped rather than sent.
fn parse_headers(spec: String) -> List[String]:
    mut out: List[String] := []
    for entry in spec.split(","):
        pair := strings.split_once(entry, "=")
        if not pair.found:
            continue
        key := pair.left.trim()
        value := pair.right.trim()
        if key == "":
            continue
        out.push(key)
        out.push(value)
    return out

# the service.instance.id to report: the explicit id when given, otherwise a
# freshly generated uuid so each process is distinguishable in the collector.
fn resolve_instance_id(explicit: String) -> String:
    if explicit != "":
        return explicit
    return uuid.v7() catch (uuid.v4() catch "")

# start tracing + metrics export against an explicit target and intervals. this
# is what init() calls after reading the environment; call it directly to
# configure the exporter in code rather than from OTEL_* variables. the version
# and instance id enrich the OTLP resource (either may be "" to omit it). the
# headers (a flat [k1, v1, ...] list) carry export auth, timeout_ms bounds each
# POST, and use_gzip compresses the body. the sampler_name/sampler_arg pick the
# head sampler (see std.trace, e.g. "parentbased_always_on" or "traceidratio"
# with a probability). idempotent.
pub fn start(service_name: String, service_version: String, service_instance_id: String, endpoint: String, protocol: String, headers: List[String], timeout_ms: Int, use_gzip: Bool, metric_interval_ms: Int, span_delay_ms: Int, sampler_name: String, sampler_arg: Float):
    if endpoint == "":
        return
    obs_mu.lock()
    if started:
        obs_mu.unlock()
        return
    started = true
    running = true
    obs_mu.unlock()

    dest := otlp.target_with_resource(service_name, service_version, service_instance_id, endpoint, protocol).with_headers(headers).with_timeout(timeout_ms).with_gzip(use_gzip)
    # install the sampler before turning tracing on so the first span already
    # sees the right decision.
    trace.set_sampler_from_name(sampler_name, sampler_arg)
    trace.set_active(true)
    trace.set_sink(true)
    tick := loop_tick(span_delay_ms, metric_interval_ms)
    # a bare, unqualified call so `spawn` accepts it; the task detaches and runs
    # for the process lifetime (until shutdown()).
    spawn run_exporter(dest, tick, metric_interval_ms)

# read the OTEL_* environment and turn observability on. with no
# OTEL_EXPORTER_OTLP_ENDPOINT set, this does nothing. one call wires up tracing,
# metrics collection, and the background exporter.
pub fn init():
    endpoint := env.str_or(OTEL_ENDPOINT, "")
    if endpoint == "":
        return
    service_name := env.str_or(OTEL_SERVICE_NAME, DEFAULT_SERVICE_NAME)
    service_version := env.str_or(OTEL_SERVICE_VERSION, "")
    service_instance_id := resolve_instance_id(env.str_or(OTEL_SERVICE_INSTANCE_ID, ""))
    protocol := env.str_or(OTEL_PROTOCOL, otlp.PROTOCOL_HTTP)
    headers := parse_headers(env.str_or(OTEL_HEADERS, ""))
    timeout_ms := env.int_or(OTEL_TIMEOUT, otlp.DEFAULT_TIMEOUT_MS)
    use_gzip := env.str_or(OTEL_COMPRESSION, "") == "gzip"
    metric_interval := env.int_or(OTEL_METRIC_INTERVAL, DEFAULT_METRIC_INTERVAL_MS)
    span_delay := env.int_or(OTEL_SPAN_DELAY, DEFAULT_SPAN_DELAY_MS)
    sampler := env.str_or(OTEL_SAMPLER, DEFAULT_SAMPLER)
    sampler_arg := env.float_or(OTEL_SAMPLER_ARG, 1.0)
    start(service_name, service_version, service_instance_id, endpoint, protocol, headers, timeout_ms, use_gzip, metric_interval, span_delay, sampler, sampler_arg)

# whether the exporter is currently running (init has run and shutdown has not).
pub fn active() -> Bool:
    return is_running()

# stop the background exporter and let it flush one final time. safe to call
# even if init() never ran. after shutdown, a later init() can start again.
pub fn shutdown():
    obs_mu.lock()
    was_running := running
    running = false
    started = false
    obs_mu.unlock()
    if not was_running:
        return
    # give the loop a moment to observe the flag, wake, and do its final flush.
    time.delay(50)

# --- tests ------------------------------------------------------------------

test "init stays off when no endpoint is configured":
    # OTEL_EXPORTER_OTLP_ENDPOINT is unset in the test environment.
    init()
    assert(not active())
    shutdown()

test "the loop tick is the smaller interval and never zero":
    assert_eq(loop_tick(5000, 60000), 5000)
    assert_eq(loop_tick(60000, 1000), 1000)
    assert_eq(loop_tick(0, 60000), 1)

test "start with an empty endpoint is a no-op":
    no_headers: List[String] := []
    start("svc", "1.0.0", "instance-1", "", otlp.PROTOCOL_HTTP, no_headers, 10000, false, 60000, 5000, "parentbased_always_on", 1.0)
    assert(not active())
    shutdown()

test "resolve_instance_id keeps an explicit id and generates one otherwise":
    assert_eq(resolve_instance_id("instance-1"), "instance-1")
    generated := resolve_instance_id("")
    assert(generated.len() > 0)

test "the header parser splits k=v pairs, trims, and skips junk":
    parsed := parse_headers("x-api-key=secret, x-tenant = acme ,,broken")
    # two valid pairs -> four flat entries; the empty and "="-less bits are dropped.
    assert_eq(parsed.len(), 4)
    assert_eq(parsed[0], "x-api-key")
    assert_eq(parsed[1], "secret")
    assert_eq(parsed[2], "x-tenant")     # surrounding spaces trimmed
    assert_eq(parsed[3], "acme")
    assert_eq(parse_headers("").len(), 0)

test "the header parser drops an entry with an empty key":
    parsed := parse_headers("=noKey,good=value")
    assert_eq(parsed.len(), 2)
    assert_eq(parsed[0], "good")
    assert_eq(parsed[1], "value")
