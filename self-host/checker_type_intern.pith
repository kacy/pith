# checker_type_intern.pith — shared generic type interning

from types import ti_list, ti_map, ti_set, ti_task, ti_channel, add_type_info, get_type_count, register_type_name, lookup_type_id, get_type_name, get_type_info

# interning keys must name the type unambiguously. display names print
# unnamed composites bare ("List", "fn"), which once merged
# List[List[Int]] and List[List[String]] into one interned id when two
# modules built them in the wrong order — so the key spells nested
# structure out fully. the same hazard applies to a named leaf: two modules
# can each declare a struct (or enum) called "Field", so keying by the bare
# name alone merged List[log.Field] and List[protogen.Field] into one id. the
# type id is unique per declaration, so a struct/enum leaf carries it in the
# key; primitives keep their plain name (their names are already unique, and
# lookups like "List[String]" rely on it).
fn intern_key_name(tid: Int) -> String:
    info := get_type_info(tid)
    if info.kind == "list":
        return "List[" + intern_key_name(info.inner) + "]"
    if info.kind == "set":
        return "Set[" + intern_key_name(info.inner) + "]"
    if info.kind == "task":
        return "Task[" + intern_key_name(info.inner) + "]"
    if info.kind == "channel":
        return "Channel[" + intern_key_name(info.inner) + "]"
    if info.kind == "map":
        return "Map[" + intern_key_name(info.key_type) + "," + intern_key_name(info.value_type) + "]"
    if info.kind == "optional":
        return intern_key_name(info.inner) + "?"
    if info.kind == "result":
        return intern_key_name(info.value_type) + "!" + intern_key_name(info.inner)
    if info.kind == "tuple":
        mut out := "("
        for e, i in info.elements:
            if i > 0:
                out = out + ","
            out = out + intern_key_name(e)
        return out + ")"
    if info.kind == "function":
        mut out := "fn("
        for pt, i in info.param_types:
            if i > 0:
                out = out + ","
            out = out + intern_key_name(pt)
        return out + ")->" + intern_key_name(info.return_type)
    if info.kind == "struct" or info.kind == "enum":
        # two modules can declare a same-named struct/enum; the id disambiguates.
        return info.name + "#" + tid.to_string()
    return get_type_name(tid)

fn build_collection_type_name(base: String, key_or_elem: Int, val: Int) -> String:
    if val < 0:
        return base + "[" + intern_key_name(key_or_elem) + "]"
    return base + "[" + intern_key_name(key_or_elem) + "," + intern_key_name(val) + "]"

# the one type id for `List[elem]`, minted on first request and handed
# back to everyone after. every written `List[T]` annotation and every
# list literal resolves through here, so two modules naming the same
# element type end up on the same id and can be compared with `==`
# instead of a structural walk. the id is also registered as a global
# type name built from the element's full spelling, which is why
# lookup_type_id("List[String]") finds it — but only for primitive
# elements; a struct or enum element is keyed by its type id
# ("List[Field#12]") and is not reachable by the name a user writes.
pub fn intern_list_type(elem: Int) -> Int:
    name := build_collection_type_name("List", elem, -1)
    existing := lookup_type_id(name)
    if existing == -1:
        add_type_info(ti_list(elem))
        tid := get_type_count() - 1
        register_type_name(name, tid)
        return tid
    return existing

# the one type id for `Set[elem]`, on the same contract as
# intern_list_type: created on first use, shared afterwards. reached
# both from a written `Set[T]` and from a `{a, b}` literal once the
# checker has agreed on an element type, so a literal assigned to a
# declared `Set[T]` matches by id and never needs the structural
# fallback.
pub fn intern_set_type(elem: Int) -> Int:
    name := build_collection_type_name("Set", elem, -1)
    existing := lookup_type_id(name)
    if existing == -1:
        add_type_info(ti_set(elem))
        tid := get_type_count() - 1
        register_type_name(name, tid)
        return tid
    return existing

# the one type id for `Map[key_type, val_type]`. the key covers both
# halves in order, so Map[String,Int] and Map[Int,String] are separate
# ids while the same pair written anywhere is one id. this is the only
# interned kind taking two arguments; pass them in the order they were
# written, since swapping them silently yields a different live map
# type rather than an error.
pub fn intern_map_type(key_type: Int, val_type: Int) -> Int:
    name := build_collection_type_name("Map", key_type, val_type)
    existing := lookup_type_id(name)
    if existing == -1:
        add_type_info(ti_map(key_type, val_type))
        tid := get_type_count() - 1
        register_type_name(name, tid)
        return tid
    return existing

# the one type id for `Task[inner]`, the type of a spawned call whose
# function returns inner. only a written `Task[T]` annotation comes
# through here: a `spawn f()` expression builds its own task type
# directly, so it does not get this id, and the two are reconciled by
# the structural comparison rather than by id equality. do not treat a
# task id mismatch as a type mismatch.
pub fn intern_task_type(inner: Int) -> Int:
    name := build_collection_type_name("Task", inner, -1)
    existing := lookup_type_id(name)
    if existing == -1:
        add_type_info(ti_task(inner))
        tid := get_type_count() - 1
        register_type_name(name, tid)
        return tid
    return existing

# the one type id for `Channel[inner]`, where inner is the type of the
# values sent over it. a channel type can only enter the table from a
# written `Channel[T]`, so unlike tasks every channel id in play is the
# interned one and two channel types compare equal by id.
pub fn intern_channel_type(inner: Int) -> Int:
    name := build_collection_type_name("Channel", inner, -1)
    existing := lookup_type_id(name)
    if existing == -1:
        add_type_info(ti_channel(inner))
        tid := get_type_count() - 1
        register_type_name(name, tid)
        return tid
    return existing
