# serve_Geometry slots above. module globals, because grpc's dispatch is
# a bare fn-value that cannot capture.
fn _Geometry_Corners_stream_unimpl(req: Shape, call: GeometryCornersServerCall) -> Int!grpc.GrpcError:
    fail grpc.GrpcError(status: grpc.GRPC_UNIMPLEMENTED, message: "Corners not implemented")
