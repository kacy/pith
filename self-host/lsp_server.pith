# lsp_server.pith — the pith language server: loop, routing, lifecycle
#
# a single-task server speaking the language server protocol over
# stdio. one loop reads frames from fd 0, handles each message
# synchronously, and writes every response frame straight to fd 1 —
# no spawned tasks, so nothing can interleave with the protocol
# stream. a document change is answered in two lanes: once the batch
# of input is drained the fast lane parses the changed document alone
# and publishes its parse errors, and the full front end runs over the
# whole import closure when 300ms pass without input.
# PITH_LSP_NO_DEBOUNCE=1 runs both lanes inline after every
# didOpen/didChange/didSave instead, which is what the transcript
# tests run under.
#
# fd 1 is the protocol channel, so nothing here may print(): a stray
# newline corrupts the frame stream.

from lsp_state import lsp_open_document, lsp_change_document, lsp_save_document, lsp_close_document, document_is_open, has_dirty, take_dirty, set_position_encoding
from lsp_features import run_analysis, syntax_diagnostics, forget_syntax_cost, DEBOUNCE_MS, ensure_analyzed, hover_result, document_symbols, workspace_symbols, code_actions, formatting_edits
from lsp_navigation import definition_location, references_locations, completion_items, prepare_rename_range, rename_workspace_edit
from lsp_tokens import semantic_token_legend, semantic_tokens_full, signature_help, inlay_hints
from check_pipeline import enable_closure_cache
from std.lsp.protocol import Message, parse_message, response_body, error_body, PARSE_ERROR, INVALID_REQUEST, METHOD_NOT_FOUND, SERVER_NOT_INITIALIZED
import std.lsp.transport as transport
import std.json as json
import std.bytes as bytes
import std.term.tty as tty

# lifecycle state: initialize must come first, shutdown is remembered
# so exit can report whether the client followed the protocol.
mut server_initialized := false
mut shutdown_seen := false
mut exit_requested := false
mut exit_code := 0

# when set, analysis runs inside the didOpen/didChange/didSave handler
# instead of on the debounce timeout.
mut no_debounce := false

# ---------------------------------------------------------------
# output
# ---------------------------------------------------------------

# frame a message body and write it to the protocol channel.
fn write_body(body: String):
    _n := tty.write(transport.encode_frame(bytes.from_string_utf8(body))) catch 0

fn write_bodies(bodies: List[String]):
    for body in bodies:
        write_body(body)

# ---------------------------------------------------------------
# initialize
# ---------------------------------------------------------------

# the position encoding to negotiate: utf-8 only when the client
# offers it in capabilities.general.positionEncodings.
fn negotiate_encoding(params: Int) -> String:
    if params < 0:
        return "utf-16"
    capabilities := json.object_get(params, "capabilities")
    if capabilities < 0:
        return "utf-16"
    general := json.object_get(capabilities, "general")
    if general < 0:
        return "utf-16"
    encodings := json.object_get(general, "positionEncodings")
    if encodings < 0 or json.type_of(encodings) != "array":
        return "utf-16"
    mut i := 0
    while i < json.array_len(encodings):
        entry := json.array_get(encodings, i)
        if json.type_of(entry) == "string" and json.get_string(entry) == "utf-8":
            return "utf-8"
        i = i + 1
    return "utf-16"

fn handle_initialize(m: Message):
    mode := negotiate_encoding(m.params)
    set_position_encoding(mode)
    caps := json.make_object()
    json.object_set(caps, "positionEncoding", json.make_string(mode))
    json.object_set(caps, "textDocumentSync", json.make_int(1))
    json.object_set(caps, "hoverProvider", json.make_bool(true))
    json.object_set(caps, "documentSymbolProvider", json.make_bool(true))
    json.object_set(caps, "documentFormattingProvider", json.make_bool(true))
    json.object_set(caps, "definitionProvider", json.make_bool(true))
    json.object_set(caps, "referencesProvider", json.make_bool(true))
    triggers := json.make_array()
    json.array_push(triggers, json.make_string("."))
    completion := json.make_object()
    json.object_set(completion, "triggerCharacters", triggers)
    json.object_set(caps, "completionProvider", completion)
    legend_types := json.make_array()
    for token_type in semantic_token_legend():
        json.array_push(legend_types, json.make_string(token_type))
    legend := json.make_object()
    json.object_set(legend, "tokenTypes", legend_types)
    json.object_set(legend, "tokenModifiers", json.make_array())
    semantic := json.make_object()
    json.object_set(semantic, "legend", legend)
    json.object_set(semantic, "full", json.make_bool(true))
    json.object_set(caps, "semanticTokensProvider", semantic)
    sig_triggers := json.make_array()
    json.array_push(sig_triggers, json.make_string("("))
    json.array_push(sig_triggers, json.make_string(","))
    signature := json.make_object()
    json.object_set(signature, "triggerCharacters", sig_triggers)
    json.object_set(caps, "signatureHelpProvider", signature)
    json.object_set(caps, "inlayHintProvider", json.make_bool(true))
    rename := json.make_object()
    json.object_set(rename, "prepareProvider", json.make_bool(true))
    json.object_set(caps, "renameProvider", rename)
    action_kinds := json.make_array()
    json.array_push(action_kinds, json.make_string("quickfix"))
    code_action := json.make_object()
    json.object_set(code_action, "codeActionKinds", action_kinds)
    json.object_set(caps, "codeActionProvider", code_action)
    json.object_set(caps, "workspaceSymbolProvider", json.make_bool(true))
    info := json.make_object()
    json.object_set(info, "name", json.make_string("pith-lsp"))
    json.object_set(info, "version", json.make_string("0.1.0"))
    result := json.make_object()
    json.object_set(result, "capabilities", caps)
    json.object_set(result, "serverInfo", info)
    server_initialized = true
    write_body(response_body(m.id, m.id_text, m.id_is_text, result))

# ---------------------------------------------------------------
# requests
# ---------------------------------------------------------------

# the uri under params.textDocument, or "".
fn params_uri(params: Int) -> String:
    if params < 0:
        return ""
    doc := json.object_get(params, "textDocument")
    if doc < 0:
        return ""
    return json.object_get_string_or(doc, "uri", "")

# the position under params.position; PositionOut carries defaults of 0
# when the params are malformed.
struct PositionOut:
    line: Int
    character: Int

fn params_position(params: Int) -> PositionOut:
    position := json.object_get(params, "position")
    mut line := 0
    mut character := 0
    if position >= 0:
        line = json.object_get_int_or(position, "line", 0)
        character = json.object_get_int_or(position, "character", 0)
    return PositionOut(line, character)

fn handle_hover(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    at := params_position(m.params)
    write_body(response_body(m.id, m.id_text, m.id_is_text, hover_result(uri, at.line, at.character)))

fn handle_definition(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    at := params_position(m.params)
    write_body(response_body(m.id, m.id_text, m.id_is_text, definition_location(uri, at.line, at.character)))

fn handle_references(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    at := params_position(m.params)
    mut include_decl := false
    context := json.object_get(m.params, "context")
    if context >= 0:
        include_decl = json.object_get_bool_or(context, "includeDeclaration", false)
    write_body(response_body(m.id, m.id_text, m.id_is_text, references_locations(uri, at.line, at.character, include_decl)))

# completion reads the last analysis on purpose: the text at the cursor
# is usually mid-edit and would not parse, so no ensure_analyzed here.
fn handle_completion(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    at := params_position(m.params)
    write_body(response_body(m.id, m.id_text, m.id_is_text, completion_items(uri, at.line, at.character)))

fn handle_document_symbol(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    write_body(response_body(m.id, m.id_text, m.id_is_text, document_symbols(uri)))

fn handle_formatting(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_body(response_body(m.id, m.id_text, m.id_is_text, formatting_edits(uri)))

# semantic tokens are lexer-based: no analysis needed, the overlay
# text is re-lexed as it stands.
fn handle_semantic_tokens(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_body(response_body(m.id, m.id_text, m.id_is_text, semantic_tokens_full(uri)))

# signature help reads the last analysis like completion does: the
# cursor usually just gained a "(" and the text would not parse.
fn handle_signature_help(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    at := params_position(m.params)
    write_body(response_body(m.id, m.id_text, m.id_is_text, signature_help(uri, at.line, at.character)))

fn handle_inlay_hint(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    mut start_line := 0
    mut end_line := 0
    range := json.object_get(m.params, "range")
    if range >= 0:
        start := json.object_get(range, "start")
        if start >= 0:
            start_line = json.object_get_int_or(start, "line", 0)
        end := json.object_get(range, "end")
        if end >= 0:
            end_line = json.object_get_int_or(end, "line", 0)
    write_body(response_body(m.id, m.id_text, m.id_is_text, inlay_hints(uri, start_line, end_line)))

fn handle_prepare_rename(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    at := params_position(m.params)
    write_body(response_body(m.id, m.id_text, m.id_is_text, prepare_rename_range(uri, at.line, at.character)))

fn handle_rename(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    at := params_position(m.params)
    new_name := json.object_get_string_or(m.params, "newName", "")
    write_body(response_body(m.id, m.id_text, m.id_is_text, rename_workspace_edit(uri, at.line, at.character, new_name)))

# code actions match the request's diagnostics against the last run's,
# so the analysis must describe this document first.
fn handle_code_action(m: Message):
    uri := params_uri(m.params)
    if not document_is_open(uri):
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    write_bodies(ensure_analyzed(uri))
    write_body(response_body(m.id, m.id_text, m.id_is_text, code_actions(uri, m.params)))

# workspace/symbol names no document, so it reads whatever the last
# analysis walked as-is; before any analysis the list is empty.
fn handle_workspace_symbol(m: Message):
    mut query := ""
    if m.params >= 0:
        query = json.object_get_string_or(m.params, "query", "")
    write_body(response_body(m.id, m.id_text, m.id_is_text, workspace_symbols(query)))

fn handle_request(m: Message):
    if m.method == "initialize":
        handle_initialize(m)
        return
    if not server_initialized:
        write_body(error_body(m.id, m.id_text, m.id_is_text, SERVER_NOT_INITIALIZED, "server not initialized"))
        return
    if m.method == "shutdown":
        shutdown_seen = true
        write_body(response_body(m.id, m.id_text, m.id_is_text, 0 - 1))
        return
    if m.method == "textDocument/hover":
        handle_hover(m)
        return
    if m.method == "textDocument/documentSymbol":
        handle_document_symbol(m)
        return
    if m.method == "textDocument/formatting":
        handle_formatting(m)
        return
    if m.method == "textDocument/definition":
        handle_definition(m)
        return
    if m.method == "textDocument/references":
        handle_references(m)
        return
    if m.method == "textDocument/completion":
        handle_completion(m)
        return
    if m.method == "textDocument/semanticTokens/full":
        handle_semantic_tokens(m)
        return
    if m.method == "textDocument/signatureHelp":
        handle_signature_help(m)
        return
    if m.method == "textDocument/inlayHint":
        handle_inlay_hint(m)
        return
    if m.method == "textDocument/prepareRename":
        handle_prepare_rename(m)
        return
    if m.method == "textDocument/rename":
        handle_rename(m)
        return
    if m.method == "textDocument/codeAction":
        handle_code_action(m)
        return
    if m.method == "workspace/symbol":
        handle_workspace_symbol(m)
        return
    write_body(error_body(m.id, m.id_text, m.id_is_text, METHOD_NOT_FOUND, "unknown method: " + m.method))

# ---------------------------------------------------------------
# notifications
# ---------------------------------------------------------------

# analyze one document now and publish what falls out; the immediate
# path used under PITH_LSP_NO_DEBOUNCE.
fn analyze_now(uri: String):
    write_bodies(run_analysis(uri))

# the document whose syntax the fast lane still owes an answer for, or
# "" when it is caught up.
mut syntax_pending := ""

# a document changed. the fast lane parses it alone and publishes any
# parse errors long before the closure check that follows can answer,
# but it fires once per batch of input rather than once per frame: with
# full-document sync only the newest text matters, so a burst of
# keystrokes parses once and the latest one wins. under
# PITH_LSP_NO_DEBOUNCE both lanes run inline, in order, so the
# transcript tests see the same sequence a client would.
fn note_changed(uri: String):
    if no_debounce:
        write_bodies(syntax_diagnostics(uri))
        analyze_now(uri)
        return
    syntax_pending = uri

# answer the fast lane's debt, if the document is still open.
fn publish_pending_syntax():
    uri := syntax_pending
    syntax_pending = ""
    if uri == "" or not document_is_open(uri):
        return
    scope := json.open_scope()
    defer json.close_scope(scope)
    write_bodies(syntax_diagnostics(uri))

fn handle_did_open(params: Int):
    if params < 0:
        return
    doc := json.object_get(params, "textDocument")
    if doc < 0:
        return
    uri := json.object_get_string_or(doc, "uri", "")
    if uri == "":
        return
    text := json.object_get_string_or(doc, "text", "")
    version := json.object_get_int_or(doc, "version", 0)
    lsp_open_document(uri, text, version)
    note_changed(uri)

fn handle_did_change(params: Int):
    uri := params_uri(params)
    if uri == "" or not document_is_open(uri):
        return
    changes := json.object_get(params, "contentChanges")
    if changes < 0 or json.type_of(changes) != "array" or json.array_len(changes) == 0:
        return
    # full sync: the last change carries the whole new text
    change := json.array_get(changes, json.array_len(changes) - 1)
    text := json.object_get_string_or(change, "text", "")
    doc := json.object_get(params, "textDocument")
    mut version := 0
    if doc >= 0:
        version = json.object_get_int_or(doc, "version", 0)
    lsp_change_document(uri, text, version)
    note_changed(uri)

fn handle_did_save(params: Int):
    uri := params_uri(params)
    if uri == "" or not document_is_open(uri):
        return
    mut text := ""
    mut has_text := false
    if params >= 0 and json.object_has(params, "text"):
        text = json.object_get_string_or(params, "text", "")
        has_text = true
    lsp_save_document(uri, text, has_text)
    note_changed(uri)

fn handle_notification(m: Message):
    if m.method == "exit":
        exit_requested = true
        exit_code = 1
        if shutdown_seen:
            exit_code = 0
        return
    if m.method == "initialized":
        return
    if m.method == "$/cancelRequest":
        # v1 handles every request synchronously; nothing is ever queued
        return
    if not server_initialized:
        # the spec drops notifications received before initialize
        return
    if m.method == "textDocument/didOpen":
        handle_did_open(m.params)
        return
    if m.method == "textDocument/didChange":
        handle_did_change(m.params)
        return
    if m.method == "textDocument/didSave":
        handle_did_save(m.params)
        return
    if m.method == "textDocument/didClose":
        closed := params_uri(m.params)
        forget_syntax_cost(closed)
        lsp_close_document(closed)
        return
    # unknown notifications are ignored by design

# ---------------------------------------------------------------
# the loop
# ---------------------------------------------------------------

# handle one raw message body inside its own json scope, so a long
# session's arena stays bounded.
fn handle_body(body: String):
    scope := json.open_scope()
    defer json.close_scope(scope)
    m := parse_message(body)
    if m.kind == "invalid":
        mut code := INVALID_REQUEST
        if m.error_text == "body is not valid json":
            code = PARSE_ERROR
        write_body(error_body(0 - 1, "", false, code, m.error_text))
        return
    if m.kind == "request":
        handle_request(m)
        return
    if m.kind == "notification":
        handle_notification(m)
        return
    # stray responses have nothing waiting on them in v1

# the debounce timeout fired: analyze the document that changed.
fn debounced_analysis():
    uri := take_dirty()
    if uri == "":
        return
    scope := json.open_scope()
    defer json.close_scope(scope)
    analyze_now(uri)

## run the language server over stdio until the client says exit or
## the stream closes. returns the process exit code: 0 after a proper
## shutdown/exit handshake, 1 otherwise.
pub fn run_lsp_server() -> Int:
    no_debounce = env("PITH_LSP_NO_DEBOUNCE") == "1"
    # a server checks the same closure per keystroke; keep the imports
    # between runs (see the closure cache in check_pipeline)
    enable_closure_cache()
    reader := transport.reader()
    while not exit_requested:
        # a pending analysis shortens the wait so the debounce fires;
        # an idle server just keeps listening
        mut wait_ms := 1000
        if has_dirty():
            wait_ms = DEBOUNCE_MS
        chunk := tty.read(65536, wait_ms) catch:
            # stdin closed: the client is gone
            if shutdown_seen:
                return 0
            return 1
        if bytes.len(chunk) == 0:
            # nothing arrived before the timeout
            if has_dirty():
                debounced_analysis()
            continue
        reader.feed(chunk)
        mut more := true
        while more and not exit_requested:
            body := reader.next()
            if body == none:
                more = false
            else:
                text := bytes.to_string_utf8(body.unwrap_or(bytes.empty())) catch ""
                handle_body(text)
        if reader.error() != "":
            # framing is unrecoverable once the header stream is corrupt
            return 1
        # the whole batch is handled; answer the fast lane before going
        # back to waiting, so a syntax error lands in the time one file
        # takes to parse rather than after the debounce and a closure
        # check. a batch ending in exit writes nothing more.
        if not exit_requested:
            publish_pending_syntax()
    return exit_code
