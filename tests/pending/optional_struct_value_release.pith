# PENDING — no issue yet. not registered in MEMCHECK_CASES; valgrind fails it.
#
# `.value()` on an optional holding a struct releases what it extracts one
# time too many. the program prints the right answer and exits 0, so only
# valgrind sees it:
#
#   $ pith build tests/pending/optional_struct_value_release.pith
#   $ PITH_STRUCT_FREELIST=0 valgrind -q --leak-check=no \
#       --errors-for-leak-kinds=none ./tests/pending/optional_struct_value_release
#   v
#   ==...== Invalid read of size 4
#   ==...==  Address ... is 0 bytes inside a block of size 40 free'd
#
# `unwrap_or` and a `match` on the same optional are clean, and so is a member
# read chained straight onto the extraction (`o.value().value`). what fails is
# binding the extraction, or handing it to a function — which is what a
# recursive walk over a `next: Node?` chain does at every step, and how this
# turned up.
#
# it is the second half of a pair: tests/pending/optional_value_extraction.pith
# has `.value()` under-releasing a heap payload a call handed back. both are
# `.value()` and neither is about generics.
#
# turn each block on with SHAPE. shape 4 is the clean twin.
import std.env as env

struct Plain:
    pub value: String
    pub next: Plain?

fn name_of(n: Plain) -> String:
    return n.value

fn build(tag: String) -> Plain:
    tail := Plain(value: "tail-" + tag, next: none)
    return Plain(value: "head-" + tag, next: tail)

# the shape the whole thing was found through: every step of the recursion
# extracts the next link out of an optional field and hands it over
fn walk(n: Plain) -> String:
    if n.next == none:
        return n.value
    return n.value + ">" + walk(n.next.value())

fn main():
    which := env.int_or("SHAPE", 1)
    if which == 1:
        # the smallest form: an optional local holding a struct, extracted
        # and bound
        o: Plain? := Plain(value: "v", next: none)
        inner := o.value()
        print(inner.value)
    if which == 2:
        # the extraction handed straight to a function
        c := build("a")
        print(name_of(c.next.value()))
    if which == 3:
        print(walk(build("a")))
    if which == 4:
        # the clean twin: unwrap_or and a match, and a member read chained
        # onto the extraction
        c := build("a")
        print(name_of(c.next.unwrap_or(c)))
        match c.next:
            none => print("none")
            tail => print(name_of(tail))
        print(c.next.value().value)
