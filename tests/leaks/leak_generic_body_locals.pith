# a generic declaration is never type checked — check_function_declaration
# returns early for one — so every expression in a specialization's body
# answers TID_ERR, which is a positive tid the emitter's `< 0` guards wave
# straight through. the emitter's ownership classification is blind there,
# and the specialization answered that by publishing every rc bind in the
# body as untracked: no zero-store, no release of the previous value on
# rebind, and no exit cleanup. every heap local a generic body built leaked,
# once per call.
#
# the locals churned here cannot escape their frame: a string rebound in a
# loop, a list, a map, a set, a bytes value, and a string whose only use is
# the value of a push into a list the same body built tagged for string
# elements. none of them reaches a call argument, a return, a container the
# frame hands on, a struct field or a lambda, so the exit cleanup releases
# exactly the count each binding took.
#
# the round's varying text arrives as a parameter rather than being built in
# the body: a builtin's result kind does not resolve inside a specialization
# either, so `i.to_string()` there leaks its result as a temporary — a
# separate gap, tracked on its own, that would swamp this measurement. a
# struct built from an owned temporary is left out for a related reason: a
# specialization lowers the construction opaquely, so the field's count is
# released at the site and never taken, and the case would be measuring that
# rather than what its locals hold.
import leakprobe as probe
import std.bytes as bytes

fn churn[T](t: T, tag: String) -> Int:
    mut acc := "seed"
    mut j := 0
    while j < 4:
        acc = acc + "-" + tag
        j = j + 1

    parts: List[String] := []
    piece := "p" + tag
    parts.push(piece)
    parts.push(acc)

    names: Map[String, String] := {}
    seen: Set[String] := {}
    raw := bytes.from_string_utf8("b" + tag)

    return acc.len() + parts.len() + names.len() + seen.len() + raw.len()

fn main():
    n := probe.rounds()
    mut i := 0
    mut total := 0
    while i < n:
        tag := i.to_string()
        total = total + churn(1, tag)
        i = i + 1
    kb := probe.peak_kb()
    if total < 0:
        print("unreachable")
    print("{kb}")
