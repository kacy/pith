# clash_widget_a — one of two same-named structs built directly with the
# module-qualified constructor (`a.Widget(...)`). the constructor must bind to
# this module's own declaration, never to whichever module registered the bare
# name into the shared table last.
pub struct Widget:
    pub n: Int

impl Widget:
    fn tag() -> Int:
        return self.n + 1000
    fn only_a() -> String:
        return "a-only"
