# std.cli: a command-line spec with subcommands, parsed without global state.
#
# the spec is a plain value: an app and a list of commands, each with options
# and positionals of its own. an option every command takes is declared once
# on the app and is accepted before or after the command. parse() takes the
# spec and an argument list and returns the parsed values or a CliError, so
# one program can parse as many lists as it likes. this one parses what a user
# of a small notes tool might type.

import std.cli as cli

fn notes_cli() -> cli.Cli:
    add := cli.command("add", "add a note", [cli.option("tag", "t", "tag the note", "")], ["text"])
    list := cli.command("list", "list notes", [cli.flag("all", "a", "include archived notes"), cli.option("limit", "n", "show at most this many", "10")], [])
    return cli.app("notes", "keep short notes", [cli.option("file", "f", "notes file", "notes.txt")], [], [add, list])

fn describe(parsed: cli.Parsed) -> String:
    file := cli.string(parsed, "file")
    if parsed.command == "add":
        tag := cli.string(parsed, "tag")
        tagged := if tag == "": "" else: " tagged {tag}"
        return "add \"{cli.positional(parsed, 0)}\"{tagged} to {file}"
    archived := if cli.flag_value(parsed, "all"): ", archived too" else: ""
    return "list up to {cli.int_or(parsed, "limit", 10)} notes from {file}{archived}"

fn main():
    spec := notes_cli()
    print(cli.help(spec))
    print("")

    invocations := [
        ["add", "buy milk"],
        ["add", "--file", "work.txt", "--tag", "urgent", "ship the release"],
        ["-f", "home.txt", "list", "-a", "-n", "3"],
        ["remove", "1"],
        ["add"],
    ]
    for argv in invocations:
        parsed := cli.parse(spec, argv)
        if parsed.is_err:
            print("notes {argv.join(" ")}: error: {parsed.err.message}")
        else:
            print("notes {argv.join(" ")}: {describe(parsed.ok)}")
