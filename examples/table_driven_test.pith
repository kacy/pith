# a table of cases, every row named and reported on its own.
#
# `each` runs one body over every labeled row. a row that fails is named where
# it sits, and the rows after it still run — which a loop over the same table
# cannot do: the first failure ends it, and what gets reported is the assertion
# rather than the row that provoked it. the label is also how `pith test` picks
# one row back out, with `--filter "the test name / no separator present"`.
import std.strings as strings
from std.testing import case, each, done

# one row: what to split, and what the pieces should come out as. the wanted
# pieces are written joined because a list compares by identity rather than by
# content, and what a row wants to compare is what it produced.
struct SplitCase:
    input: String
    sep: String
    limit: Int
    want: String

fn split_matches(c: SplitCase) -> Bool:
    return strings.split_n(c.input, c.sep, c.limit).join("|") == c.want

fn main():
    each([
        case("plain", SplitCase("a,b,c", ",", 8, "a|b|c")),
        case("no separator present", SplitCase("abc", ",", 8, "abc")),
        case("empty fields are kept", SplitCase("a,,c", ",", 8, "a||c")),
        case("leading and trailing", SplitCase(",a,", ",", 8, "|a|")),
        case("multi-character separator", SplitCase("a::b", "::", 8, "a|b")),
        case("the limit counts splits, not fields", SplitCase("a,b,c,d", ",", 2, "a|b|c,d")),
], split_matches)

    done()
