# structured logging examples
import std.log as log
import std.metrics as metrics
import std.fs as fs

fn main() -> String!:
    path := "/tmp/pith_logging.txt"
    fs.remove(path)
    log.set_console()
    log.set_level(log.debug_level())
    log.set_file(path)
    log.info("server starting on port 8080")
    log.warn("cache miss rate above threshold")
    log.error("connection refused")
    log.debug("request payload size: 1024 bytes")
    log.clear_file()
    content := fs.read(path)!
    print("file has info: {content.contains("[INFO]")}")
    print("file has error: {content.contains("[ERROR]")}")
    fs.remove(path)

    json_path := "/tmp/pith_logging_json.txt"
    fs.remove(json_path)
    logger := log.root().json().file(json_path).with([log.str("service", "api")]).target("http").trace_context("trace-demo", "span-demo")
    logger.info().int("port", 8080).bool("tls", false).duration_ms("elapsed_ms", 12).msg("server started")
    json_content := fs.read(json_path)!
    has_message := json_content.contains("\"message\":\"server started\"")
    has_service := json_content.contains("\"service\":\"api\"")
    has_trace := json_content.contains("\"trace_id\":\"trace-demo\"")
    print("json has message: {has_message}")
    print("json has service: {has_service}")
    print("json has trace: {has_trace}")
    fs.remove(json_path)

    trace_id := log.new_trace_id()!
    span_id := log.new_span_id()!
    print("trace ids look compact: {trace_id.len() == 32 and span_id.len() == 16 and not trace_id.contains("-") and not span_id.contains("-")}")

    metrics.reset()
    requests := metrics.counter("requests total")
    inflight := metrics.gauge("requests in flight")
    latency := metrics.histogram("request latency ms")
    requests.inc()
    requests.add(2.0)
    inflight.set(1.0)
    inflight.add(-1.0)
    latency.observe(12.0)
    latency.observe(30.0)
    snapshot := metrics.snapshot_text()
    print("metrics has counter: {snapshot.contains("requests_total 3")}")
    print("metrics has histogram: {snapshot.contains("request_latency_ms_count 2")}")

    print("logging works")
    return ""
