# a method's own type parameter is fixed by the argument types at the call
# site. one that appears in no parameter has nothing to fix it, so the bare
# call is refused (E222) instead of specializing at whatever the emitter
# happened to guess; the written spelling, `s.blank[Int]()`, is the repair.
struct Sink:
    pub name: String

impl Sink:
    pub fn blank[T]() -> Int:
        return 0

fn main():
    s := Sink(name: "s")
    print(s.blank().to_string())
