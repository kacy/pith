# 𝄞 clef, € euro, 中 middle, é acute: 4, 3, 3 and 2 bytes
## tag a value, 𝄞 and all
fn tag(s: String, n: Int) -> String:
    return s + n.to_string()

fn main():
    s4 := tag("𝄞", 1) + tag("𝄞𝄞", 2)
    s3 := tag("€", 1) + tag("中", 2)
    s2 := tag("é", 1) + tag("éé", 2)
    both := "𝄞€中é" + s4 + s3 + s2
    wrapped := tag(
        "𝄞", 3)
    print(both + wrapped)
