# threaded http server benchmark: one spawned handler per connection,
# with keep-alive each connection is one long-lived thread.
#
# original single-threaded notes follow.
# http server memory benchmark
#
# serves a small json api with allocation-churny request handling:
# query parsing, catalog lookups, and per-request string assembly.
# pair with bench/http_bench.sh, which drives it with wrk and samples
# rss over the run. the go counterpart is bench/http_server.go.
#
# run:  pith build bench/http_server.pith && ./bench/http_server 8080
import std.net.http as http

fn query_param(query: String, name: String) -> String:
    if query == "":
        return ""
    for part in query.split("&"):
        eq := part.index_of("=")
        if eq < 0:
            continue
        if part.substring(0, eq) == name:
            if eq + 1 < part.len():
                return part.substring(eq + 1, part.len())
    return ""

fn item_name(id: Int) -> String:
    kinds := ["widget", "gadget", "gizmo", "doodad", "contraption"]
    return kinds[id % kinds.len()] + "-" + id.to_string()

fn item_json(id: Int) -> String:
    q := chr(34)
    name := item_name(id)
    price := (id * 37) % 10000
    tags := name.split("-")
    mut body := chr(123) + q + "id" + q + ":" + id.to_string()
    body = body + "," + q + "name" + q + ":" + q + name + q
    body = body + "," + q + "price" + q + ":" + price.to_string()
    body = body + "," + q + "tags" + q + ":["
    for tag, i in tags:
        if i > 0:
            body = body + ","
        body = body + q + tag + q
    body = body + "]" + chr(125)
    return body

fn route(req: HttpRequestBytes) -> HttpResponse:
    is_item := req.is_get("/item") catch false
    if is_item:
        id_text := query_param(req.query() catch "", "id")
        id := parse_int(id_text) catch 0
        return http.json(200, item_json(id))
    is_health := req.is_get("/health") catch false
    if is_health:
        return http.json(200, chr(123) + chr(34) + "ok" + chr(34) + ":true" + chr(125))
    return http.not_found_response()

fn main() -> Int!:
    mut port := 8080
    argv := args()
    if argv.len() > 1:
        port = parse_int(argv[1]) catch 8080
    print("listening on {port}")
    fd := tcp_listen("0.0.0.0", port)!
    while true:
        client := tcp_accept(fd)!
        tcp_set_timeout(client, 5000)
        spawn serve_conn(client)
    return 0

fn serve_conn(fd: Int) -> Int:
    return http.serve_connection_fd(fd, route) catch 0
