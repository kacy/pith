## std.env — environment variable and argument access
##
## Functions:
##   get(key: String) -> String?   Get environment variable, or none when unset
##   get_args() -> List[String]    Get command-line arguments

## get an environment variable by name.
## returns Some(value) when set, none when the variable is not set.
pub fn get(key: String) -> String?:
    return env_opt(key)

## Get the command-line arguments as a list of strings
pub fn get_args() -> List[String]:
    return args()

## read a variable as a string, or `fallback` when it is unset or empty. an
## empty value is treated as unset so `FOO=` doesn't override a default — the
## convention config-from-env deployments expect.
pub fn str_or(key: String, fallback: String) -> String:
    value := env_opt(key).unwrap_or("")
    if value == "":
        return fallback
    return value

## read a variable as an integer, or `fallback` when it is unset, empty, or not
## a valid integer.
pub fn int_or(key: String, fallback: Int) -> Int:
    text := str_or(key, "")
    if text == "":
        return fallback
    return parse_int(text) catch fallback

## read a variable as a float, or `fallback` when it is unset, empty, or not a
## valid number.
pub fn float_or(key: String, fallback: Float) -> Float:
    text := str_or(key, "")
    if text == "":
        return fallback
    return parse_float(text) catch fallback

## read a variable as a bool. "true"/"1"/"yes"/"on" are true and
## "false"/"0"/"no"/"off" are false (case-insensitive); anything else, or an
## unset variable, returns `fallback`.
pub fn bool_or(key: String, fallback: Bool) -> Bool:
    lowered := str_or(key, "").to_lower()
    if lowered == "true" or lowered == "1" or lowered == "yes" or lowered == "on":
        return true
    if lowered == "false" or lowered == "0" or lowered == "no" or lowered == "off":
        return false
    return fallback

test "env reads missing keys as none":
    assert(get("PITH_STD_ENV_TEST_MISSING_KEY") == none)

test "typed readers fall back for an unset variable":
    missing := "PITH_STD_ENV_TEST_MISSING_KEY"
    assert(str_or(missing, "def") == "def")
    assert(int_or(missing, 42) == 42)
    assert(float_or(missing, 1.5) == 1.5)
    assert(bool_or(missing, true) == true)
    assert(bool_or(missing, false) == false)

test "env exposes process arguments":
    values := get_args()

    assert(values.len() > 0)
