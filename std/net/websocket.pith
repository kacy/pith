# std.net.websocket — WebSocket protocol (RFC 6455)
#
# WebSocket handshake, framing, and session helpers.
# the public surface is bytes-first, with text as a convenience layer on top.
#
#   import std.net.websocket as websocket
#   req := http.read_request_bytes(fd)!
#   if websocket.route_echo(fd, req, "/ws", "connected", "echo:", "quit")!:
#       return 0
#   client := websocket.dial("127.0.0.1", 8080, "/chat")!
import std.bytes as bytes
import std.binary as bin
import std.bits as bits
import std.hash as hash
import std.encoding as encoding
import std.crypto.random as crypto_random
import std.net.http as http
import std.io as io
import std.text.scanner as scanner
from std.bytes import ByteBuffer
from std.io import BufferedBytesReader, BufferedBytesWriter, BytesReader, BytesWriter, TcpStream
from std.net.http import HttpRequestBytes
# ===============================================================
# WebSocket Constants
# ===============================================================
# Magic GUID defined in RFC 6455 for handshake key computation
WS_MAGIC := "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
# WebSocket frame opcodes
OP_TEXT := 1 # Text frame
OP_BINARY := 2 # Binary frame
OP_CLOSE := 8 # Connection close
OP_PING := 9 # Ping frame
OP_PONG := 10 # Pong frame
OP_CONTINUATION := 0
WS_VERSION := "13"
DEFAULT_MESSAGE_FRAGMENT_SIZE := 64
DEFAULT_READ_CHUNK_SIZE := 1024
MAX_CONTROL_PAYLOAD := 125
# the largest reassembled message the receiver will buffer. a message may span many
# continuation fragments (FIN=0); without a ceiling an endless stream of fragments
# grows the reassembly buffer without bound. on exceed the peer is closed with 1009
# ("message too big", RFC 6455 §7.4.1) and the read fails. the fragment-count cap
# stops a flood of tiny or empty fragments that never grows past the byte cap; it is
# sized to the byte cap at our own minimum fragment size, so it never rejects a
# message the byte cap would admit.
MAX_MESSAGE_BYTES := 16777216
MAX_MESSAGE_FRAGMENTS := 262144
# the most a client reads of the server's handshake response head before it gives
# up on the dial, as http.MAX_HEADER_BYTES bounds a request head. an upgrade
# response is a status line and a few fields, so a head this long means the
# server is not answering the handshake.
pub MAX_HANDSHAKE_HEAD_BYTES := 65536
WS_CLOSE_MESSAGE_TOO_BIG := 1009
# one parsed websocket frame.
pub struct WebSocketFrame:
    pub fin: Bool
    pub opcode: Int
    pub masked: Bool
    pub payload: Bytes
# a websocket session. the read half belongs to the task that receives: a
# message is reassembled from several reads, so two tasks reading one session
# would split its frames between them. any task may send. a message goes out
# as one write under `send_mu`, so messages sent from several tasks at once
# never interleave on the wire, and `closed` is an atomic so a close on one task
# is seen by every other. a session that dialed or accepted its own socket
# holds it in `owned` and closes it with the session; over a reader and writer
# the caller handed in, closing marks the session closed and leaves the
# transport to the caller.
pub struct WebSocket:
    reader: BytesReader
    writer: BytesWriter
    client: Bool
    owned: TcpStream?
    closed: AtomicInt
    send_mu: Mutex
struct WebSocketMessage:
    pub opcode: Int
    pub payload: Bytes

struct FrameHeader:
    first_byte: Int
    fin: Bool
    opcode: Int
    masked: Bool
    payload_len: Int
    header_size: Int

# ===============================================================
# Handshake Computation
# ===============================================================
# Computes the Sec-WebSocket-Accept value from the client's Sec-WebSocket-Key.
# Implements the RFC 6455 handshake algorithm:
# 1. Concatenate key with magic GUID
# 2. Compute SHA-1 hash
# 3. Base64 encode the hash
pub fn compute_accept_bytes(key: Bytes) -> String!:
    buf := bytes.buffer_with_capacity(key.len() + WS_MAGIC.len())
    defer buf.free()
    buf.write(key)!
    buf.write(bytes.from_string_utf8(WS_MAGIC))!
    combined := buf.bytes()
    digest_hex := hash.sha1(combined)
    return encoding.b64_encode(encoding.from_hex(digest_hex)!)
# computes the accept value for a websocket handshake key.
pub fn compute_accept(key: String) -> String!:
    return compute_accept_bytes(bytes.from_string_utf8(key))
# Builds a complete HTTP 101 Switching Protocols response for WebSocket upgrade.
# Takes the client's Sec-WebSocket-Key and returns the full HTTP response.
pub fn handshake_response_bytes(key: Bytes) -> Bytes!:
    accept := compute_accept_bytes(key)!
    mut response := "HTTP/1.1 101 Switching Protocols\r\n"
    response = response + "Upgrade: websocket\r\n"
    response = response + "Connection: Upgrade\r\n"
    response = response + "Sec-WebSocket-Accept: " + accept + "\r\n"
    response = response + "\r\n"
    return bytes.from_string_utf8(response)
# builds a full websocket handshake response.
pub fn handshake_response(key: String) -> String!:
    return handshake_response_bytes(bytes.from_string_utf8(key))!.to_string_utf8()!
fn header_text(data: Bytes) -> String:
    text := data.to_string_utf8()
    if text.is_err:
        return ""
    return text.ok
fn normalize_path(path: String) -> String:
    if path.len() == 0:
        return "/"
    if ord(path[0]) == ord("/"):
        return path
    return "/" + path
fn default_host_header(host: String, port: Int) -> String:
    if port == 80:
        return host
    return host + ":" + port.to_string()
fn random_bytes(count: Int) -> Bytes!:
    return crypto_random.bytes(count)
fn random_mask_key() -> Bytes!:
    return random_bytes(4)
fn random_client_key() -> Bytes!:
    return random_bytes(16)
fn is_reserved_client_header(name: String) -> Bool:
    lowered := name.to_lower()
    return lowered == "host" or lowered == "connection" or lowered == "upgrade" or lowered == "sec-websocket-key" or lowered == "sec-websocket-version"
fn client_request_with_key(host_header: String, path: String, headers: Map[String, String], key: Bytes) -> Bytes!:
    crlf := chr(13) + chr(10)
    key_text := encoding.b64_encode(key)
    mut request := "GET " + normalize_path(path) + " HTTP/1.1" + crlf
    request = request + "Host: " + host_header + crlf
    request = request + "Upgrade: websocket" + crlf
    request = request + "Connection: Upgrade" + crlf
    request = request + "Sec-WebSocket-Key: " + key_text + crlf
    request = request + "Sec-WebSocket-Version: " + WS_VERSION + crlf
    for header_name in headers:
        if is_reserved_client_header(header_name):
            continue
        request = request + header_name + ": " + headers[header_name] + crlf
    request = request + crlf
    return bytes.from_string_utf8(request)
# builds a client websocket upgrade request.
pub fn client_request(host: String, path: String, headers: Map[String, String]) -> Bytes!:
    return client_request_with_key(host, path, headers, random_client_key()!)
fn header_has_token(value: Bytes, token: String) -> Bool:
    text := header_text(value)
    if text == "":
        return false
    for part in text.split(","):
        if part.trim().to_lower() == token.to_lower():
            return true
    return false
fn header_equals(value: Bytes, expected: String) -> Bool:
    text := header_text(value)
    if text == "":
        return false
    return text.trim().to_lower() == expected.to_lower()
fn bytes_equals_text(value: Bytes, expected: String) -> Bool:
    return header_text(value) == expected
# returns true when an http request is a valid websocket upgrade request.
pub fn is_upgrade_request(req: HttpRequestBytes) -> Bool:
    if not bytes_equals_text(req.method_bytes(), "GET"):
        return false
    if req.header_bytes("Sec-WebSocket-Key").is_empty():
        return false
    if not header_equals(req.header_bytes("Upgrade"), "websocket"):
        return false
    if not header_has_token(req.header_bytes("Connection"), "upgrade"):
        return false
    if not header_equals(req.header_bytes("Sec-WebSocket-Version"), WS_VERSION):
        return false
    return true
# builds the server-side upgrade response for a validated request.
pub fn upgrade_response(req: HttpRequestBytes) -> Bytes!:
    if not is_upgrade_request(req):
        fail "invalid websocket upgrade request"
    key := req.header_bytes("Sec-WebSocket-Key")
    if key.is_empty():
        fail "missing websocket key"
    return handshake_response_bytes(key)
fn response_header(head: Bytes, name: String) -> String:
    text := header_text(head)
    if text == "":
        return ""
    mut cur := scanner.new(text)
    first := scanner.take_line(cur)
    cur = first.cursor
    while not scanner.done(cur):
        scanned := scanner.take_line(cur)
        cur = scanned.cursor
        line := scanned.slice.text.trim()
        colon := line.index_of(":")
        if colon > 0:
            header_name := line.substring(0, colon).trim().to_lower()
            if header_name == name.to_lower():
                if colon + 1 < line.len():
                    return line.substring(colon + 1, line.len()).trim()
                return ""
    return ""
fn response_status_code(head: Bytes) -> Int!:
    text := header_text(head)
    if text == "":
        fail "invalid websocket response"
    line := scanner.take_line(scanner.new(text))
    if line.slice.text == "":
        fail "missing websocket status line"
    parts := line.slice.text.trim().split(" ")
    if parts.len() < 2:
        fail "invalid websocket status line"
    return parse_int(parts[1])
# whether the head in `buf` has just ended: its last byte closes an empty line,
# LF LF or CR LF CR LF. checked after each byte, so only the tail is looked at.
fn head_just_ended(buf: ByteBuffer) -> Bool:
    n := buf.len()
    if n < 2 or buf.get(n - 1) != 10:
        return false
    if buf.get(n - 2) == 10:
        return true
    return n >= 4 and buf.get(n - 2) == 13 and buf.get(n - 3) == 10 and buf.get(n - 4) == 13
# read the handshake response head a byte at a time, so nothing past it is taken
# off the stream before the session's own reader starts. a head longer than
# MAX_HANDSHAKE_HEAD_BYTES fails the dial.
fn read_http_head(reader: BufferedBytesReader) -> Bytes!:
    buf := bytes.buffer_with_capacity(DEFAULT_READ_CHUNK_SIZE)
    defer buf.free()
    while not head_just_ended(buf):
        if buf.len() >= MAX_HANDSHAKE_HEAD_BYTES:
            fail "websocket handshake response head exceeds the maximum"
        chunk := reader.read_bytes(1)!
        if chunk.is_empty():
            fail "websocket handshake response truncated"
        buf.write(chunk)!
    return buf.bytes()
fn validate_upgrade_response(head: Bytes, key: Bytes) -> Bool!:
    if response_status_code(head)! != 101:
        return false
    if response_header(head, "Upgrade").to_lower() != "websocket":
        return false
    if not header_has_token(bytes.from_string_utf8(response_header(head, "Connection")), "upgrade"):
        return false
    return response_header(head, "Sec-WebSocket-Accept") == compute_accept_bytes(key)!
fn new_session(reader: BytesReader, writer: BytesWriter, is_client: Bool, owned: TcpStream?) -> WebSocket:
    return WebSocket(reader, writer, is_client, owned, AtomicInt(0), Mutex())

# a session over its own socket reads and writes the socket directly. a frame
# is written whole, and a read asks for the bytes the frame still needs, so a
# buffer in between would save no syscalls.
fn socket_session(stream: TcpStream, is_client: Bool) -> WebSocket:
    return new_session(stream, stream, is_client, stream)

# a buffered writer handed to a session: each frame is flushed as it is
# written, so a message never waits in the buffer.
struct FlushingWriter:
    inner: BufferedBytesWriter

impl BytesWriter for FlushingWriter:
    fn write_bytes(data: Bytes) -> Int!:
        wrote := self.inner.write_bytes(data)!
        ensure_writer_flushed(self.inner)!
        return wrote

## wraps existing buffered io as a websocket connection. the caller keeps the
## reader and writer and frees them after the session closes. a buffered
## reader or writer lives with the task that made it, so a session built this
## way is used on that task only; `from_io` over a transport any task can
## write to makes a session other tasks can send on.
pub fn from_buffered(reader: BufferedBytesReader, writer: BufferedBytesWriter, is_client: Bool) -> WebSocket:
    return new_session(reader, FlushingWriter(writer), is_client, none)

## wraps a reader and a writer as a websocket connection, with no handshake.
## `write_bytes` must send all of its data, as a socket's and
## `http.take_connection`'s writers do. the caller owns the transport: closing
## the session marks it closed and leaves the reader and writer alone.
pub fn from_io(reader: BytesReader, writer: BytesWriter, is_client: Bool) -> WebSocket:
    return new_session(reader, writer, is_client, none)

fn ensure_writer_flushed(writer: BufferedBytesWriter) -> Int!:
    flushed := writer.flush()
    if flushed.is_err:
        fail "websocket flush failed"
    return 1
# dials a websocket endpoint with default headers.
pub fn dial(host: String, port: Int, path: String) -> WebSocket!:
    mut headers: Map[String, String] := {}
    return dial_with_headers(host, port, path, headers)
# dials a websocket endpoint with custom headers.
pub fn dial_with_headers(host: String, port: Int, path: String, headers: Map[String, String]) -> WebSocket!:
    conn := io.connect(host, port)!
    # close the connection on any error exit before the handshake completes; on
    # success it lives on inside the returned websocket, so errdefer stays silent.
    errdefer conn.close()
    key := random_client_key()!
    key_text := encoding.b64_encode(key)
    request := client_request_with_key(default_host_header(host, port), path, headers, key)!
    # the handshake's buffered io is registry-backed and lives only for this
    # call (the session registers a pair of its own on success), so give the
    # entries back on every exit, the failed handshake included.
    writer := conn.buffered_bytes_writer()
    defer writer.free()
    writer.write_bytes(request)!
    ensure_writer_flushed(writer)!
    head_reader := conn.buffered_bytes_reader_chunked(1)
    defer head_reader.free()
    response_head := read_http_head(head_reader)!
    if not validate_upgrade_response(response_head, bytes.from_string_utf8(key_text))!:
        fail "invalid websocket handshake response"
    return socket_session(conn, true)
# upgrades an accepted http connection to a websocket.
pub fn upgrade(fd: Int, req: HttpRequestBytes) -> WebSocket!:
    response := upgrade_response(req)!
    stream := io.from_fd(fd)
    # the handshake writer is registry-backed and lives only for this call
    # (see dial_with_headers); the session registers its own on success.
    writer := stream.buffered_bytes_writer()
    defer writer.free()
    writer.write_bytes(response)!
    ensure_writer_flushed(writer)!
    return socket_session(stream, false)
# reads a request from a socket and upgrades it to a websocket.
pub fn accept(fd: Int) -> WebSocket!:
    req := http.read_request_bytes(fd)!
    return upgrade(fd, req)
# upgrades a buffered request and io pair to a websocket.
pub fn accept_buffered(req: HttpRequestBytes, reader: BufferedBytesReader, writer: BufferedBytesWriter) -> WebSocket!:
    response := upgrade_response(req)!
    writer.write_bytes(response)!
    ensure_writer_flushed(writer)!
    return from_buffered(reader, writer, false)
## upgrades a request read off a reader and a writer, such as the two halves
## `http.take_connection` hands over, to a websocket. the writer may be used
## from any task when the transport allows it.
pub fn accept_io(req: HttpRequestBytes, reader: BytesReader, writer: BytesWriter) -> WebSocket!:
    writer.write_bytes(upgrade_response(req)!)!
    return from_io(reader, writer, false)
## answers a std.net.http or std.web handler's request with a websocket
## session: return it from the handler, and once the handler returns, the
## server writes the handshake and calls `session` on the connection's task.
## the connection closes when `session` returns. a request that is not a
## websocket upgrade gets a 400 instead.
##
##   fn chat(req: web.Request) -> http.HttpResponse:
##       return websocket.take_connection(req.raw, serve_member)
pub fn take_connection(req: HttpRequestBytes, session: fn(WebSocket) -> Int!) -> http.HttpResponse:
    if not is_upgrade_request(req):
        return http.text(400, "expected a websocket upgrade")
    return http.take_connection(fn(reader: BytesReader, writer: BytesWriter) -> Int! => run_taken(req, reader, writer, session))
fn run_taken(req: HttpRequestBytes, reader: BytesReader, writer: BytesWriter, session: fn(WebSocket) -> Int!) -> Int!:
    ws := accept_io(req, reader, writer)!
    defer ws.close_now()
    return session(ws)
fn should_handle_route(req: HttpRequestBytes, path: String) -> Bool!:
    if not req.is_get(path)!:
        return false
    return is_upgrade_request(req)
# returns true when the request matches a websocket route.
pub fn is_route(req: HttpRequestBytes, path: String) -> Bool!:
    return should_handle_route(req, path)!
# runs a simple echo session until the socket closes or stop_text is seen.
pub fn echo_session(ws: WebSocket, greeting: String, prefix: String, stop_text: String) -> Int!:
    mut sent := 0
    if greeting != "":
        ws.send_text(greeting)!
        sent = sent + 1
    while true:
        msg := ws.recv_text()
        if msg.is_err:
            return sent
        if stop_text != "" and msg.ok == stop_text:
            ws.close(1000, "bye")!
            return sent
        ws.send_text(prefix + msg.ok)!
        sent = sent + 1
# upgrades one request and serves the built-in echo session.
pub fn serve_echo(fd: Int, req: HttpRequestBytes, greeting: String, prefix: String, stop_text: String) -> Int!:
    ws := upgrade(fd, req)!
    return echo_session(ws, greeting, prefix, stop_text)
# buffered version of serve_echo().
pub fn serve_echo_buffered(req: HttpRequestBytes, reader: BufferedBytesReader, writer: BufferedBytesWriter, greeting: String, prefix: String, stop_text: String) -> Int!:
    ws := accept_buffered(req, reader, writer)!
    return echo_session(ws, greeting, prefix, stop_text)
# serves echo only when the request matches the given route.
pub fn route_echo(fd: Int, req: HttpRequestBytes, path: String, greeting: String, prefix: String, stop_text: String) -> Bool!:
    if not should_handle_route(req, path)!:
        return false
    serve_echo(fd, req, greeting, prefix, stop_text)!
    return true
# buffered version of route_echo().
pub fn route_echo_buffered(req: HttpRequestBytes, reader: BufferedBytesReader, writer: BufferedBytesWriter, path: String, greeting: String, prefix: String, stop_text: String) -> Bool!:
    if not should_handle_route(req, path)!:
        return false
    serve_echo_buffered(req, reader, writer, greeting, prefix, stop_text)!
    return true
impl WebSocketFrame:
    fn is_text() -> Bool:
        return self.opcode == OP_TEXT
    fn is_binary() -> Bool:
        return self.opcode == OP_BINARY
    fn is_close() -> Bool:
        return self.opcode == OP_CLOSE
    fn is_ping() -> Bool:
        return self.opcode == OP_PING
    fn is_pong() -> Bool:
        return self.opcode == OP_PONG
    fn payload_text() -> String!:
        return self.payload.to_string_utf8()!
    fn close_code() -> Int!:
        return validate_close_payload(self.payload)
    fn close_reason() -> String!:
        if self.payload.len() <= 2:
            return ""
        return self.payload.slice(2, self.payload.len()).to_string_utf8()!
fn frame_is_masked(second_byte: Int) -> Bool:
    return bits.band(second_byte, 128) != 0
fn frame_length_code(second_byte: Int) -> Int:
    return bits.band(second_byte, 127)
fn frame_extended_length_size(second_byte: Int) -> Int!:
    length_code := frame_length_code(second_byte)
    if length_code == 126:
        return 2
    if length_code == 127:
        fail "64-bit websocket lengths not supported yet"
    return 0
fn append_frame_length(buf: ByteBuffer, payload_len: Int, masked: Bool) -> Int!:
    mut len_byte := payload_len
    if masked:
        len_byte = bits.bor(len_byte, 128)
    if payload_len < 126:
        buf.write_byte(len_byte)!
        return 1
    if payload_len <= 65535:
        mut ext_len_marker := 126
        if masked:
            ext_len_marker = bits.bor(ext_len_marker, 128)
        buf.write_byte(ext_len_marker)!
        wrote := bin.write_u16_be(buf, payload_len)
        if wrote.is_err:
            fail wrote.err.message
        return 3
    fail "websocket payload too large"
fn frame_header_size(data: Bytes) -> Int!:
    if data.len() < 2:
        fail "websocket frame too short"
    mut offset := 2 + frame_extended_length_size(data[1])!
    if frame_is_masked(data[1]):
        offset = offset + 4
    return offset
fn frame_payload_length(data: Bytes) -> Int!:
    if data.len() < 2:
        fail "websocket frame too short"
    length_code := frame_length_code(data[1])
    if length_code < 126:
        return length_code
    if length_code == 126:
        if data.len() < 4:
            fail "websocket frame missing extended length"
        value := bin.read_u16_be_at(data, 2)
        if value.is_err:
            fail value.err.message
        return value.ok
    # length code 127 announces a 64-bit length, which this reader rejects.
    frame_extended_length_size(data[1])!
    return 0
fn apply_mask(payload: Bytes, mask_key: Bytes) -> Bytes!:
    if mask_key.len() != 4:
        fail "websocket mask key must be 4 bytes"
    buf := bytes.buffer_with_capacity(payload.len())
    defer buf.free()
    mut i := 0
    while i < payload.len():
        buf.write_byte(bits.xor(payload[i], mask_key[i % 4]))!
        i = i + 1
    return buf.bytes()
fn frame_mask_key(data: Bytes, header_size: Int) -> Bytes:
    return data.slice(header_size - 4, header_size)

fn parse_frame_header(data: Bytes) -> FrameHeader!:
    if data.len() < 2:
        fail "websocket frame too short"
    first_byte := data[0]
    if has_reserved_bits(first_byte):
        fail "websocket reserved bits are not supported"
    return FrameHeader(first_byte, bits.band(first_byte, 128) != 0, bits.band(first_byte, 15), frame_is_masked(data[1]), frame_payload_length(data)!, frame_header_size(data)!)

fn has_reserved_bits(first_byte: Int) -> Bool:
    return bits.band(first_byte, 112) != 0
fn is_data_opcode(opcode: Int) -> Bool:
    return opcode == OP_TEXT or opcode == OP_BINARY
fn is_reserved_opcode(opcode: Int) -> Bool:
    return opcode == 3 or opcode == 4 or opcode == 5 or opcode == 6 or opcode == 7 or opcode == 11 or opcode == 12 or opcode == 13 or opcode == 14 or opcode == 15
fn is_valid_close_code(code: Int) -> Bool:
    if code == 1000 or code == 1001 or code == 1002 or code == 1003:
        return true
    if code == 1007 or code == 1008 or code == 1009 or code == 1010 or code == 1011 or code == 1012 or code == 1013 or code == 1014:
        return true
    if code >= 3000 and code <= 4999:
        return true
    return false
fn validate_close_payload(payload: Bytes) -> Int!:
    if payload.len() == 1:
        fail "websocket close frame payload too short"
    if payload.len() < 2:
        return 0
    code_result := bin.read_u16_be_at(payload, 0)
    if code_result.is_err:
        fail code_result.err.message
    code := code_result.ok
    if not is_valid_close_code(code):
        fail "invalid websocket close code"
    if payload.len() > 2:
        payload.slice(2, payload.len()).to_string_utf8()!
    return code
fn validate_frame_rules(first_byte: Int, fin: Bool, opcode: Int, payload: Bytes) -> Int!:
    if has_reserved_bits(first_byte):
        fail "websocket reserved bits are not supported"
    if is_reserved_opcode(opcode):
        fail "websocket reserved opcode"
    if is_control_opcode(opcode):
        if not fin:
            fail "websocket control frames must be final"
        if payload.len() > MAX_CONTROL_PAYLOAD:
            fail "websocket control frame payload too large"
        if opcode == OP_CLOSE:
            validate_close_payload(payload)!
    elif opcode != OP_CONTINUATION and not is_data_opcode(opcode):
        fail "unsupported websocket opcode"
    return opcode
fn validate_frame_direction(ws: WebSocket, frame: WebSocketFrame) -> Int!:
    if ws.client:
        if frame.masked:
            fail "server websocket frames must not be masked"
        return 0
    if not frame.masked:
        fail "client websocket frames must be masked"
    return 0
fn is_control_opcode(opcode: Int) -> Bool:
    return opcode == OP_CLOSE or opcode == OP_PING or opcode == OP_PONG
# parses one raw websocket frame.
pub fn parse_frame(data: Bytes) -> WebSocketFrame!:
    header := parse_frame_header(data)!
    if data.len() < header.header_size + header.payload_len:
        fail "websocket frame payload truncated"
    payload_start := header.header_size
    payload_end := payload_start + header.payload_len
    payload := data.slice(payload_start, payload_end)
    mut decoded_payload := payload
    if header.masked:
        decoded_payload = apply_mask(payload, frame_mask_key(data, header.header_size))!
    validate_frame_rules(header.first_byte, header.fin, header.opcode, decoded_payload)!
    return WebSocketFrame(header.fin, header.opcode, header.masked, decoded_payload)
# builds one unmasked websocket frame.
pub fn frame_bytes(opcode: Int, payload: Bytes) -> Bytes!:
    return frame_bytes_with_fin(opcode, payload, true)
fn frame_bytes_with_fin(opcode: Int, payload: Bytes, fin: Bool) -> Bytes!:
    buf := bytes.buffer_with_capacity(payload.len() + 10)
    defer buf.free()
    append_frame(buf, opcode, payload, fin, bytes.empty())!
    return buf.bytes()

# append one frame to `buf`: masked with `mask_key` when it is not empty, as a
# client's frames are, and unmasked when it is.
fn append_frame(buf: ByteBuffer, opcode: Int, payload: Bytes, fin: Bool, mask_key: Bytes) -> Int!:
    if is_control_opcode(opcode):
        if not fin:
            fail "websocket control frames must be final"
        if payload.len() > MAX_CONTROL_PAYLOAD:
            fail "websocket control frame payload too large"
    mut first := bits.band(opcode, 15)
    if fin:
        first = bits.bor(first, 128)
    buf.write_byte(first)!
    masked := not mask_key.is_empty()
    append_frame_length(buf, payload.len(), masked)!
    if not masked:
        buf.write(payload)!
        return 0
    buf.write(mask_key)!
    buf.write(apply_mask(payload, mask_key)!)!
    return 0
# builds one text frame from a string.
pub fn text_frame_bytes(text: String) -> Bytes!:
    return frame_bytes(OP_TEXT, bytes.from_string_utf8(text))
# builds one binary frame.
pub fn binary_frame(payload: Bytes) -> Bytes!:
    return frame_bytes(OP_BINARY, payload)
fn close_payload(code: Int, reason: String) -> Bytes!:
    payload := bytes.buffer_with_capacity(reason.len() + 2)
    defer payload.free()
    wrote := bin.write_u16_be(payload, code)
    if wrote.is_err:
        fail wrote.err.message
    payload.write(bytes.from_string_utf8(reason))!
    validate_close_payload(payload.bytes())!
    return payload.bytes()
# builds one masked websocket frame.
pub fn masked_frame_bytes(opcode: Int, payload: Bytes, mask_key: Bytes) -> Bytes!:
    return masked_frame_bytes_with_fin(opcode, payload, mask_key, true)
fn masked_frame_bytes_with_fin(opcode: Int, payload: Bytes, mask_key: Bytes, fin: Bool) -> Bytes!:
    if mask_key.len() != 4:
        fail "websocket mask key must be 4 bytes"
    buf := bytes.buffer_with_capacity(payload.len() + 14)
    defer buf.free()
    append_frame(buf, opcode, payload, fin, mask_key)!
    return buf.bytes()
# builds one masked client text frame.
pub fn client_text_frame_bytes(text: String, mask_key: Bytes) -> Bytes!:
    return masked_frame_bytes(OP_TEXT, bytes.from_string_utf8(text), mask_key)
# builds one ping frame.
pub fn ping_frame(payload: Bytes) -> Bytes!:
    return frame_bytes(OP_PING, payload)
# builds one pong frame.
pub fn pong_frame(payload: Bytes) -> Bytes!:
    return frame_bytes(OP_PONG, payload)
# builds one close frame with a code and reason.
pub fn close_frame(code: Int, reason: String) -> Bytes!:
    return frame_bytes(OP_CLOSE, close_payload(code, reason)!)
# read exactly `count` bytes. the first read usually brings them all, and then
# no buffer is needed.
fn read_exact_bytes(reader: BytesReader, count: Int) -> Bytes!:
    if count <= 0:
        return bytes.empty()
    first := reader.read_bytes(count)!
    if first.is_empty():
        fail "websocket frame truncated"
    if first.len() == count:
        return first
    buf := bytes.buffer_with_capacity(count)
    defer buf.free()
    buf.write(first)!
    while buf.len() < count:
        chunk := reader.read_bytes(count - buf.len())!
        if chunk.is_empty():
            fail "websocket frame truncated"
        buf.write(chunk)!
    return buf.bytes()
## reads one full websocket frame from a reader, buffered or not.
pub fn read_frame_buffered(reader: BytesReader) -> WebSocketFrame!:
    start := read_exact_bytes(reader, 2)!
    mut extra_header := frame_extended_length_size(start[1])!
    if frame_is_masked(start[1]):
        extra_header = extra_header + 4
    header := start.concat(read_exact_bytes(reader, extra_header)!)
    payload_len := frame_payload_length(header)!
    payload := read_exact_bytes(reader, payload_len)!
    return parse_frame(header.concat(payload))
# append one frame of this session's: a client masks each frame with a fresh
# key, a server sends it as is.
fn append_session_frame(ws: WebSocket, buf: ByteBuffer, opcode: Int, payload: Bytes, fin: Bool) -> Int!:
    if ws.client:
        return append_frame(buf, opcode, payload, fin, random_mask_key()!)
    return append_frame(buf, opcode, payload, fin, bytes.empty())

# write the frames in `wire` as one write, holding the session's send lock so a
# message sent from another task cannot land in the middle of them.
fn transmit(ws: WebSocket, wire: Bytes) -> Int!:
    locked ws.send_mu:
        if ws.is_closed():
            fail "websocket is closed"
        ws.writer.write_bytes(wire)!
    return wire.len()

fn send_frame(ws: WebSocket, opcode: Int, payload: Bytes, fin: Bool) -> Int!:
    buf := bytes.buffer_with_capacity(payload.len() + 14)
    defer buf.free()
    append_session_frame(ws, buf, opcode, payload, fin)!
    transmit(ws, buf.bytes())!
    return payload.len()

fn handle_control_frame(ws: WebSocket, frame: WebSocketFrame) -> Bool!:
    if frame.is_ping():
        ws.pong(frame.payload)!
        return true
    if frame.is_pong():
        return true
    if frame.is_close():
        if not ws.is_closed():
            # reply best-effort: a peer that closes and vanishes must not
            # keep the session registered, so the teardown runs regardless.
            send_frame(ws, OP_CLOSE, frame.payload, true) catch 0
        ws.close_now()
        fail "websocket closed"
    return false

# fail the read when a reassembled message outgrows its caps, closing the peer with
# 1009 first so it learns why. the caller owns the reassembly buffer and frees it
# on the way out, so this only signals the peer and reports the error.
fn enforce_message_limits(ws: WebSocket, message_buf: ByteBuffer, fragments: Int) -> Int!:
    if message_buf.len() <= MAX_MESSAGE_BYTES and fragments <= MAX_MESSAGE_FRAGMENTS:
        return 0
    ws.close(WS_CLOSE_MESSAGE_TOO_BIG, "message too big") catch 0
    fail "websocket message exceeds the maximum size"

fn receive_message(ws: WebSocket) -> WebSocketMessage!:
    if ws.is_closed():
        fail "websocket is closed"
    mut message_opcode := OP_CONTINUATION
    mut message_buf := bytes.buffer()
    # the reassembly buffer is a native allocation arc won't reclaim; free it on
    # every exit. the returned message copies its bytes, so freeing after is safe.
    defer message_buf.free()
    mut fragments := 0
    while true:
        frame := read_frame_buffered(ws.reader)!
        validate_frame_direction(ws, frame)!
        if handle_control_frame(ws, frame)!:
            continue
        if frame.opcode == OP_CONTINUATION:
            if message_opcode == OP_CONTINUATION:
                fail "unexpected websocket continuation frame"
            message_buf.write(frame.payload)!
            fragments = fragments + 1
            enforce_message_limits(ws, message_buf, fragments)!
            if frame.fin:
                return WebSocketMessage(message_opcode, message_buf.bytes())
            continue
        if message_opcode != OP_CONTINUATION:
            fail "websocket message interrupted by a new data frame"
        if frame.fin:
            return WebSocketMessage(frame.opcode, frame.payload)
        message_opcode = frame.opcode
        message_buf.write(frame.payload)!
        fragments = fragments + 1
        enforce_message_limits(ws, message_buf, fragments)!
# send one message, split into fragments of DEFAULT_MESSAGE_FRAGMENT_SIZE. the
# fragments are built into one buffer and go out in one write.
fn send_message(ws: WebSocket, opcode: Int, payload: Bytes) -> Int!:
    if payload.len() <= DEFAULT_MESSAGE_FRAGMENT_SIZE:
        return send_frame(ws, opcode, payload, true)
    fragments := (payload.len() + DEFAULT_MESSAGE_FRAGMENT_SIZE - 1) / DEFAULT_MESSAGE_FRAGMENT_SIZE
    buf := bytes.buffer_with_capacity(payload.len() + fragments * 8)
    defer buf.free()
    mut offset := 0
    mut frame_opcode := opcode
    while offset < payload.len():
        mut end := offset + DEFAULT_MESSAGE_FRAGMENT_SIZE
        if end > payload.len():
            end = payload.len()
        append_session_frame(ws, buf, frame_opcode, payload.slice(offset, end), end == payload.len())!
        frame_opcode = OP_CONTINUATION
        offset = end
    transmit(ws, buf.bytes())!
    return payload.len()
impl WebSocket:
    fn recv() -> Bytes!:
        message := receive_message(self)!
        return message.payload
    fn recv_text() -> String!:
        message := receive_message(self)!
        if message.opcode != OP_TEXT:
            fail "expected websocket text message"
        return message.payload.to_string_utf8()!
    fn send(data: Bytes) -> Int!:
        return send_message(self, OP_BINARY, data)
    fn send_text(data: String) -> Int!:
        return send_message(self, OP_TEXT, bytes.from_string_utf8(data))
    fn ping(data: Bytes) -> Int!:
        return send_frame(self, OP_PING, data, true)
    fn pong(data: Bytes) -> Int!:
        return send_frame(self, OP_PONG, data, true)
    # send a close frame with the given code and reason, then close the
    # session. a failed write still closes it, so a broken peer cannot keep it
    # open. a second close returns 0.
    fn close(code: Int, reason: String) -> Int!:
        if self.is_closed():
            return 0
        payload := close_payload(code, reason)!
        wrote := send_frame(self, OP_CLOSE, payload, true)
        self.close_now()
        return wrote!
    # close the session without a close frame. a session that owns its socket
    # closes it, which also ends a read another task is blocked in. only the
    # first close does anything, whichever task makes it.
    fn close_now():
        if not self.closed.compare_set(0, 1):
            return
        if let stream = self.owned:
            stream.close()
    fn is_closed() -> Bool:
        return self.closed.load() != 0

# a session nobody closes is closed when its last value dies, as close_now()
# closes it: a session that owns its socket closes the socket, and no close
# frame goes out, since a destructor does no network io. the peer sees the
# connection end without a close handshake, as it would from a crash. close()
# first to send one. a session over a transport the caller handed in only
# marks itself closed.
impl Drop for WebSocket:
    fn drop():
        self.close_now()

test "websocket computes handshake accept values":
    key := "dGhlIHNhbXBsZSBub25jZQ=="
    response := handshake_response(key)!

    assert_eq(compute_accept(key)!, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
    assert(response.contains("HTTP/1.1 101 Switching Protocols"))
    assert(response.contains("Upgrade: websocket"))
    assert(response.contains("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))

test "websocket client requests keep reserved headers controlled":
    mut headers: Map[String, String] := {}
    headers.insert("Host", "bad.example")
    headers.insert("X-Test", "yes")
    request := client_request("example.test", "chat", headers)!.to_string_utf8()!

    assert(request.starts_with("GET /chat HTTP/1.1"))
    assert(request.contains("Host: example.test"))
    assert(request.contains("Upgrade: websocket"))
    assert(request.contains("Connection: Upgrade"))
    assert(request.contains("Sec-WebSocket-Version: 13"))
    assert(request.contains("X-Test: yes"))
    assert(not request.contains("bad.example"))

test "websocket validates upgrade requests":
    crlf := chr(13) + chr(10)
    raw := "GET /ws HTTP/1.1" + crlf + "Host: example.test" + crlf + "Upgrade: websocket" + crlf + "Connection: keep-alive, Upgrade" + crlf + "Sec-WebSocket-Version: 13" + crlf + "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==" + crlf + crlf
    req := http.read_request_buffered_bytes(io.bytes_reader(bytes.from_string_utf8(raw)).buffered_chunked(8))!
    response := upgrade_response(req)!.to_string_utf8()!

    assert(is_upgrade_request(req))
    assert(is_route(req, "/ws")!)
    assert(response.contains("101 Switching Protocols"))
    assert(response.contains("s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))

test "websocket parses unmasked and masked frames":
    mask := bytes.buffer()
    mask.write_byte(1)!
    mask.write_byte(2)!
    mask.write_byte(3)!
    mask.write_byte(4)!

    text_frame := parse_frame(text_frame_bytes("hello")!)!
    masked_frame := parse_frame(client_text_frame_bytes("hi", mask.bytes())!)!

    assert(text_frame.is_text())
    assert(not text_frame.masked)
    assert_eq(text_frame.payload_text()!, "hello")
    assert(masked_frame.is_text())
    assert(masked_frame.masked)
    assert_eq(masked_frame.payload_text()!, "hi")

test "websocket parses close frames and rejects bad close codes":
    frame := parse_frame(close_frame(1000, "bye")!)!
    bad := close_frame(1, "bad")

    assert(frame.is_close())
    assert_eq(frame.close_code()!, 1000)
    assert_eq(frame.close_reason()!, "bye")
    assert(bad.is_err)

test "websocket buffered frame reads consume full payloads":
    payload := text_frame_bytes("chunked")!
    reader := io.bytes_reader(payload).buffered_chunked(2)
    frame := read_frame_buffered(reader)!

    assert(frame.is_text())
    assert_eq(frame.payload_text()!, "chunked")

test "websocket receive rejects a message past the size cap":
    # a large-fragment message that never sets FIN, pushing the reassembly buffer
    # past MAX_MESSAGE_BYTES. the cap aborts the read and closes the peer with 1009
    # instead of buffering without bound.
    mut chunk := bytes.from_string_utf8("a")
    while chunk.len() < 65536:
        chunk = bytes.concat(chunk, chunk)
    chunk = chunk.slice(0, 65535)
    frames_buf := bytes.buffer()
    frames_buf.write(frame_bytes_with_fin(OP_BINARY, chunk, false)!)!
    mut total := chunk.len()
    while total <= MAX_MESSAGE_BYTES:
        frames_buf.write(frame_bytes_with_fin(OP_CONTINUATION, chunk, false)!)!
        total = total + chunk.len()
    sink := bytes.buffer()
    # a client-side socket accepts unmasked server frames, so the test frames need no
    # masking.
    ws := from_buffered(io.bytes_reader(frames_buf.bytes()).buffered_chunked(4096), sink.buffered(), true)
    result := ws.recv()
    assert(result.is_err)
    # the peer was told the message was too big (a close frame was written).
    assert(sink.bytes().len() > 0)

test "websocket close_now closes the session":
    frame_data := text_frame_bytes("ping")!
    cursor := io.bytes_reader(frame_data)
    reader := cursor.buffered_chunked(64)
    sink := bytes.buffer()
    writer := sink.buffered()
    ws := from_buffered(reader, writer, true)
    assert(not ws.is_closed())
    got := ws.recv()!
    assert_eq(got.to_string_utf8()!, "ping")
    ws.close_now()
    assert(ws.is_closed())
    # a second close is a no-op, and a closed session refuses io.
    ws.close_now()
    assert(ws.send_text("late").is_err)
    reader.free()
    writer.free()
    cursor.close()
    sink.free()

test "websocket close sends a close frame and closes":
    cursor := io.bytes_reader(bytes.empty())
    reader := cursor.buffered_chunked(64)
    sink := bytes.buffer()
    writer := sink.buffered()
    ws := from_buffered(reader, writer, true)
    wrote := ws.close(1000, "bye")!
    assert(wrote > 0)
    assert(ws.is_closed())
    # the second close finds the session closed and reports nothing sent.
    assert_eq(ws.close(1000, "again")!, 0)
    frame := parse_frame(sink.bytes())!
    assert(frame.is_close())
    assert_eq(frame.close_code()!, 1000)
    reader.free()
    writer.free()
    cursor.close()
    sink.free()
