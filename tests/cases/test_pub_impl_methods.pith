# pub methods in impl blocks must emit; they used to vanish silently,
# with calls returning zero.
struct Counter:
    n: Int

impl Counter:
    pub fn doubled() -> Int:
        return self.n * 2

    fn plain() -> Int:
        return self.n + 1

    pub fn describe() -> String:
        return "counter at " + self.n.to_string()

fn main():
    c := Counter(21)
    print("{c.doubled()}")
    print("{c.plain()}")
    print(c.describe())
