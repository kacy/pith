# a genuine same-kind duplicate on a generic base still errors: the
# module-scoped key catches two inherent declarations of the same method
# in one module.
struct Holder[T]:
    pub v: T

impl Holder:
    fn get() -> Int:
        return 1

impl Holder:
    fn get() -> Int:
        return 2

fn main():
    print("{Holder[Int](v: 3).get()}")
