# clash_layout_a — a struct Box built with named fields. clash_layout_b declares
# its own struct Box of the same name but a different field layout. named
# construction resolves each field by name against the struct's layout, so if the
# two Box layouts were ever confused the wrong field names would be used and the
# values would silently drop to zero.
pub struct Box:
    pub tag: String
    pub size: Int

pub fn make_a() -> Box:
    return Box(tag: "alpha", size: 111)
