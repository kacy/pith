# std.template - html templates that escape by default
#
# the point of this module is one decision: an interpolated value is escaped
# unless you say otherwise. a helper you have to remember to call protects the
# pages you remembered on; a renderer that escapes by default protects the
# ones you forgot, which are the ones that get exploited.
#
#   import std.template as template
#
#   page := template.compile("<h1>hello, <%= name %></h1>")!
#   ctx := template.context().set("name", "<script>alert(1)</script>")
#   template.render(page, ctx)!
#   # "<h1>hello, &lt;script&gt;alert(1)&lt;/script&gt;</h1>"
#
# the escape hatch is spelled `<%raw value %>`, in words rather than in
# punctuation, so that it is greppable. `grep -rn '<%raw' templates/` is a
# complete audit of every place your templates trust a value, which is a
# property a `<%== %>` or a `{{{ }}}` spelling does not give you.
#
# ## why `<% %>` and not `{{ }}`
#
# pith owns `{` and `}` inside string literals — they are its own
# interpolation, and a literal brace has to be doubled. a mustache-style
# template written inline would need `{{{{name}}}}` to mean `{{name}}`, in
# every template and in every test. `<% %>` cannot collide with pith's syntax,
# so a template reads the same in a `.html` file and in a pith string.
#
# ## the syntax, in full
#
#   <%= path %>            escaped output — the default
#   <%md path %>           the value rendered as markdown, safely
#   <%raw path %>          unescaped output — you are asserting it is safe html
#   <% if path %> … <% end %>
#   <% if not path %> … <% end %>
#   <% if path %> … <% else %> … <% end %>
#   <% for item in path %> … <% end %>
#   <%# a comment %>       dropped from the output
#
# that is the entire language. a `path` is a name, or names joined by dots
# (`user.name`), and nothing else: no function calls, no arithmetic, no
# comparisons, no filters, no `and`/`or`, no template inheritance, no partials
# or includes, no whitespace control. if you need a comparison, do it in pith
# and put a boolean in the context. this is a renderer, not a second language
# to debug.
#
# ## the data
#
# a context is a `std.json` node under the hood, so a value that arrived as
# json can be rendered directly, and the node pool's scoping rules apply — see
# the json node pool section of `docs/web.md`. inside a request handler the
# pool is already scoped for you and there is nothing to do.
#
# a path that does not resolve renders as empty and is falsy. that is a
# deliberate choice for a page renderer: a missing field should leave a hole,
# not take the response down. if a missing field is a bug for you, check the
# context before you render it.
#
# ## where a value lands
#
# compile reads the template's literal html and records where each `<%= %>`
# sits, and render escapes the value for that place:
#
#   - element text, a comment, `<title>` or `<textarea>`, and a quoted
#     attribute value: `html.escape`.
#   - an unquoted attribute value (`<p title=<%= x %>>`): every ascii byte
#     other than a letter, a digit, `-`, `_` and `.` becomes a numeric entity,
#     so a space or a `>` cannot end the attribute.
#   - a url attribute (`href`, `src`, `action`, `formaction`, `xlink:href`,
#     `poster`, `cite`, `background`, `data`, `codebase`, `longdesc`,
#     `manifest`, `icon`): the whole assembled attribute value — including any
#     literal prefix, literal suffix, entity references, and multiple `<%= %>`
#     slots — is checked with `html.safe_url`, and an attribute it refuses is
#     replaced with `about:blank`.
#
# compile refuses `<%= %>` where no escaping makes a value safe: inside
# `<script>` or `<style>`, in an event handler (`on...`), `style` or `srcdoc`
# attribute, and in a tag or attribute name. pass data to a script as json in a
# data attribute, and choose between fixed class names or attributes with
# `<% if %>`. `<%raw %>` is still allowed in all of these places, and what it
# writes is assumed not to change where the template is.
#
# the paths through an `if` must leave the html in the same place, and so must
# a `for` body, so a value after the block has one context. a template that
# opens an attribute in one branch and not the other fails to compile.
#
# ## markdown
#
# `<%md path %>` renders the value as markdown with std.markdown's safe
# defaults and writes the html in place: raw html in the value is shown as
# text, and link and image urls go through `html.safe_url`. there is no way to
# let raw html through from the markdown, so `<%md` is safe wherever it
# compiles and a `grep -rn '<%raw'` audit can skip it. text that should keep
# its raw html is rendered with std.markdown in pith and written with
# `<%raw %>`.
#
# the html it writes is block content, so compile accepts it only in element
# text: not in an attribute, a tag, a comment, `<script>`, `<style>`,
# `<title>` or `<textarea>`. `heading_ids` and `heading_anchors` on a compiled
# template give the headings ids and links to themselves. `code_highlighter`
# writes code blocks through a hook, such as `std.pith.highlight`'s
# `code_block`, whose html is trusted as `<%raw %>` is, so the audit looks
# for `code_highlighter(` too.

import std.fs as fs
import std.html as html
import std.json as json
import std.markdown as markdown

# the largest template source that will be compiled or loaded.
MAX_SOURCE_BYTES := 1_048_576

# the largest rendered output; a page that exceeds it fails rather than
# growing until the process dies. nested loops over attacker-sized lists are
# the way this gets hit.
MAX_OUTPUT_BYTES := 8_388_608

# how deeply `if` and `for` may nest. bounded so a pathological template
# cannot drive the renderer's recursion into the stack guard.
MAX_NESTING := 32

NODE_TEXT := 0
NODE_ESCAPED := 1
NODE_RAW := 2
NODE_IF := 3
NODE_ELSE := 4
NODE_FOR := 5
NODE_END := 6
NODE_MARKDOWN := 7
NODE_URL_START := 8
NODE_URL_END := 9

# how a `<%= %>` value is written out
MODE_TEXT := 0
MODE_URL := 1
MODE_UNQUOTED := 2
MODE_UNQUOTED_URL := 3

# ---------------------------------------------------------------
# types
# ---------------------------------------------------------------

# what went wrong, and the byte offset in the template source where it was
# noticed. render-time failures report the offset of the node being rendered.
pub struct TemplateError:
    pub message: String
    pub offset: Int

# one compiled instruction. `text` carries literal output, `path` the dotted
# lookup, `name` the loop variable. `alt` is the index of the matching `else`
# and `close` the index of the matching `end`, both resolved at compile time so
# rendering never rescans.
struct Node:
    kind: Int
    text: String
    path: String
    name: String
    negate: Bool
    alt: Int
    close: Int
    offset: Int
    # how a `<%= %>` value is escaped, from where it sits in the html (one of
    # the MODE_ constants). for a url mode, `text` holds the literal start of
    # the attribute value the value is appended to.
    mode: Int

# a parsed template. compile once, render many times; a `Template` holds no
# per-render state and is safe to share, with other tasks too: its nodes are
# frozen once compile builds them.
pub struct Template:
    frozen nodes: List[Node]
    # how `<%md %>` renders: the safe defaults, plus heading ids, anchors and
    # a code highlighter when the builders below ask for them.
    markdown_opts: markdown.Options = markdown.options()
    # whether markdown_opts has a code highlighter.
    highlighted: Bool = false

# the values a template renders. a thin, typed front for a `std.json` object
# node, so a context can be built by hand or adopted from parsed json.
pub struct Ctx:
    pub node: Int

# ---------------------------------------------------------------
# building a context
# ---------------------------------------------------------------

# A new, empty context to fill in with `set`.
pub fn context() -> Ctx:
    return Ctx(json.make_object())

# A new, empty list to fill in with `push` and hand to `set_child`.
#
# a `for` loop iterates one of these:
#
#   rows := template.list()
#   rows.push(template.context().set("title", title))
#   ctx.set_child("rows", rows)
pub fn list() -> Ctx:
    return Ctx(json.make_array())

# Adopts an existing `std.json` node as a context.
#
# the node should be an object for a template's root context. this borrows the
# handle; it stays owned by the json node pool and by whatever scope opened it.
pub fn from_json(handle: Int) -> Ctx:
    return Ctx(handle)

impl Ctx:
    # Sets a string field, and returns the context so calls chain.
    fn set(key: String, value: String) -> Ctx:
        json.object_set(self.node, key, json.make_string(value))
        return self

    # Sets an integer field.
    fn set_int(key: String, value: Int) -> Ctx:
        json.object_set(self.node, key, json.make_int(value))
        return self

    # Sets a float field.
    fn set_float(key: String, value: Float) -> Ctx:
        json.object_set(self.node, key, json.make_float(value))
        return self

    # Sets a boolean field, which `if` reads directly.
    fn set_bool(key: String, value: Bool) -> Ctx:
        json.object_set(self.node, key, json.make_bool(value))
        return self

    # Sets a field to a nested context or list.
    fn set_child(key: String, child: Ctx) -> Ctx:
        json.object_set(self.node, key, child.node)
        return self

    # Appends a nested context or list to a list context.
    fn push(child: Ctx) -> Ctx:
        json.array_push(self.node, child.node)
        return self

    # Appends a string to a list context, for `for tag in tags`.
    fn push_text(value: String) -> Ctx:
        json.array_push(self.node, json.make_string(value))
        return self

    # Appends an integer to a list context.
    fn push_int(value: Int) -> Ctx:
        json.array_push(self.node, json.make_int(value))
        return self

    # The underlying `std.json` handle, for code that wants to read or encode
    # the same data as json.
    fn handle() -> Int:
        return self.node

# ---------------------------------------------------------------
# compiling
# ---------------------------------------------------------------

# the index of the two-byte sequence `first``second` at or after `start`, or -1.
fn find_pair(source: String, start: Int, first: Int, second: Int) -> Int:
    mut position := start
    limit := source.len() - 1
    while position < limit:
        if ord(source[position]) == first and ord(source[position + 1]) == second:
            return position
        position = position + 1
    return 0 - 1

# true when `path` is a name, or dot-joined names, made of letters, digits, and
# underscores. rejecting anything else at compile time is what keeps the
# renderer from having to be an expression evaluator.
fn is_path(path: String) -> Bool:
    if path == "":
        return false
    mut segment_length := 0
    mut position := 0
    while position < path.len():
        byte := ord(path[position])
        if byte == 46:
            if segment_length == 0:
                return false
            segment_length = 0
        else:
            letter := (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90)
            digit := byte >= 48 and byte <= 57
            if not letter and not digit and byte != 95:
                return false
            segment_length = segment_length + 1
        position = position + 1
    return segment_length > 0

fn node_text(text: String, offset: Int) -> Node:
    return Node(NODE_TEXT, text, "", "", false, 0 - 1, 0 - 1, offset, MODE_TEXT)

fn node_output(kind: Int, path: String, offset: Int) -> Node:
    return Node(kind, "", path, "", false, 0 - 1, 0 - 1, offset, MODE_TEXT)

fn fail_at(message: String, offset: Int) -> Node!TemplateError:
    fail TemplateError(message, offset)

# parse the inside of one `<% … %>` into a node.
fn parse_tag(body: String, offset: Int) -> Node!TemplateError:
    trimmed := body.trim()
    if trimmed == "":
        return fail_at("empty tag", offset)!
    if trimmed.starts_with("#"):
        return node_text("", offset)
    if trimmed.starts_with("="):
        path := trimmed.substring(1, trimmed.len()).trim()
        if not is_path(path):
            return fail_at("expected a name or dotted path after '=', got '{path}'", offset)!
        return node_output(NODE_ESCAPED, path, offset)
    if trimmed.starts_with("raw "):
        path := trimmed.substring(4, trimmed.len()).trim()
        if not is_path(path):
            return fail_at("expected a name or dotted path after 'raw', got '{path}'", offset)!
        return node_output(NODE_RAW, path, offset)
    if trimmed.starts_with("md "):
        path := trimmed.substring(3, trimmed.len()).trim()
        if not is_path(path):
            return fail_at("expected a name or dotted path after 'md', got '{path}'", offset)!
        return node_output(NODE_MARKDOWN, path, offset)
    if trimmed == "end":
        return Node(NODE_END, "", "", "", false, 0 - 1, 0 - 1, offset, MODE_TEXT)
    if trimmed == "else":
        return Node(NODE_ELSE, "", "", "", false, 0 - 1, 0 - 1, offset, MODE_TEXT)
    if trimmed.starts_with("if "):
        mut condition := trimmed.substring(3, trimmed.len()).trim()
        mut negate := false
        if condition.starts_with("not "):
            condition = condition.substring(4, condition.len()).trim()
            negate = true
        if not is_path(condition):
            return fail_at("expected a name or dotted path after 'if', got '{condition}'", offset)!
        return Node(NODE_IF, "", condition, "", negate, 0 - 1, 0 - 1, offset, MODE_TEXT)
    if trimmed.starts_with("for "):
        rest := trimmed.substring(4, trimmed.len())
        parts := rest.split(" in ")
        if parts.len() != 2:
            return fail_at("expected 'for <name> in <path>', got '{trimmed}'", offset)!
        name := parts[0].trim()
        source := parts[1].trim()
        if not is_path(name) or name.contains("."):
            return fail_at("'{name}' is not a usable loop variable name", offset)!
        if not is_path(source):
            return fail_at("expected a name or dotted path to loop over, got '{source}'", offset)!
        return Node(NODE_FOR, "", source, name, false, 0 - 1, 0 - 1, offset, MODE_TEXT)
    return fail_at("unknown tag '{trimmed}'", offset)!

# ---------------------------------------------------------------
# html context
# ---------------------------------------------------------------
#
# compile reads the template's literal text with a small html tokenizer, so
# each `<%= %>` knows where in the page it lands and is escaped for that
# place. the tokenizer follows the states of the html spec that decide what a
# value means: element text, a tag, an attribute name, a quoted or unquoted
# attribute value, a comment, and the raw text inside `<script>` and
# `<style>`. it only reads the template, never a value, so a value cannot
# change the state.

# where the tokenizer is
H_TEXT := 0
H_LT := 1
H_LT_SLASH := 2
H_TAG_NAME := 3
H_IN_TAG := 4
H_ATTR_NAME := 5
H_AFTER_ATTR := 6
H_BEFORE_VALUE := 7
H_DOUBLE := 8
H_SINGLE := 9
H_UNQUOTED := 10
H_COMMENT := 11
H_BOGUS := 12
H_SCRIPT := 13
H_RCDATA := 14

# the tokenizer's state. `tag` is the element being opened or closed, or the
# element whose raw text this is in H_SCRIPT and H_RCDATA. `attr` is the
# attribute being read. `prefix` is the literal text of the attribute value so
# far. `known` turns false once a value is interpolated into it, since the
# literal text alone then no longer says how the url starts.
struct HtmlState:
    kind: Int
    tag: String
    attr: String
    closing: Bool
    prefix: String
    known: Bool

fn html_state(kind: Int, tag: String, attr: String, closing: Bool) -> HtmlState:
    return HtmlState(kind, tag, attr, closing, "", true)

fn is_space(byte: Int) -> Bool:
    return byte == 32 or byte == 9 or byte == 10 or byte == 12 or byte == 13

fn is_letter(byte: Int) -> Bool:
    return (byte >= 97 and byte <= 122) or (byte >= 65 and byte <= 90)

# an attribute whose value a browser follows as a url.
fn is_url_attr(name: String) -> Bool:
    if name == "href" or name == "src" or name == "action" or name == "formaction":
        return true
    if name == "xlink:href" or name == "poster" or name == "cite" or name == "background":
        return true
    return name == "data" or name == "codebase" or name == "longdesc" or name == "manifest" or name == "icon"

# an attribute whose value is code or markup rather than text: an event
# handler, inline css, or an iframe's srcdoc. escaping does not make a value
# safe there, so compile refuses `<%= %>` in one.
fn is_code_attr(name: String) -> Bool:
    return name.starts_with("on") or name == "style" or name == "srcdoc"

# the state after the `>` that ends a tag. `<script>` and `<style>` hold raw
# text in which an escaped value is still live code. in the other raw text and
# rcdata elements a value is shown as text, and with `<` escaped it cannot end
# the element.
fn after_tag(tag: String, closing: Bool) -> HtmlState:
    if closing:
        return html_state(H_TEXT, "", "", false)
    if tag == "script" or tag == "style":
        return html_state(H_SCRIPT, tag, "", false)
    if tag == "textarea" or tag == "title" or tag == "xmp" or tag == "iframe":
        return html_state(H_RCDATA, tag, "", false)
    if tag == "noembed" or tag == "noframes" or tag == "noscript":
        return html_state(H_RCDATA, tag, "", false)
    return html_state(H_TEXT, "", "", false)

# true when `text` at `start` matches lowercase ascii string `lower` ignoring ascii case,
# without slicing `text` (safe even when `start + lower.len()` falls inside multi-byte utf-8).
fn ascii_matches_lower(text: String, start: Int, lower: String) -> Bool:
    if start < 0 or start + lower.len() > text.len():
        return false
    mut k := 0
    while k < lower.len():
        mut b := ord(text[start + k])
        if b >= 65 and b <= 90:
            b = b + 32
        if b != ord(lower[k]):
            return false
        k = k + 1
    return true

# appendable lowercase token for a tag or attribute name byte; non-ascii bytes map to
# "?" so multi-byte utf-8 sequences never slice mid-character or match ascii tag/attr names.
fn ascii_name_char(byte: Int) -> String:
    if byte >= 65 and byte <= 90:
        return chr(byte + 32)
    if byte < 128:
        return chr(byte)
    return "?"

# whether `text` at `at` holds `</` and then `tag` in any case, followed by
# something that ends a tag name. that is what ends a raw text element.
fn closes_raw(text: String, at: Int, tag: String) -> Bool:
    end := at + 2 + tag.len()
    if end > text.len() or ord(text[at + 1]) != 47:
        return false
    if not ascii_matches_lower(text, at + 2, tag):
        return false
    if end == text.len():
        return true
    next := ord(text[end])
    return is_space(next) or next == 47 or next == 62

fn is_url_value_state(kind: Int, attr: String) -> Bool:
    return (kind == H_DOUBLE or kind == H_SINGLE or kind == H_UNQUOTED) and is_url_attr(attr)

# emit literal `text` into `nodes`, splitting at url attribute value boundaries so
# the renderer can validate every assembled url attribute value as a whole, and
# return the html state after `text`.
fn emit_text_and_advance(nodes: List[Node], start: HtmlState, text: String, offset: Int) -> HtmlState:
    mut kind := start.kind
    mut tag := start.tag
    mut attr := start.attr
    mut closing := start.closing
    mut prefix := start.prefix
    mut known := start.known
    # where the current attribute value began in `text`, so its literal part
    # is copied once rather than a byte at a time
    mut value_from := 0
    # where the next literal chunk to emit starts in `text`
    mut seg_start := 0
    mut ended := false
    mut i := 0
    while i < text.len():
        byte := ord(text[i])
        if kind == H_TEXT:
            if byte == 60:
                kind = H_LT
        elif kind == H_LT:
            if is_letter(byte):
                kind = H_TAG_NAME
                tag = ascii_name_char(byte)
                closing = false
            elif byte == 47:
                kind = H_LT_SLASH
            elif byte == 33:
                kind = H_BOGUS
                if i + 2 < text.len() and ord(text[i + 1]) == 45 and ord(text[i + 2]) == 45:
                    kind = H_COMMENT
                    i = i + 2
            elif byte == 63:
                kind = H_BOGUS
            elif byte != 60:
                kind = H_TEXT
        elif kind == H_LT_SLASH:
            if is_letter(byte):
                kind = H_TAG_NAME
                tag = ascii_name_char(byte)
                closing = true
            elif byte == 62:
                kind = H_TEXT
            else:
                kind = H_BOGUS
        elif kind == H_TAG_NAME:
            if is_space(byte) or byte == 47:
                kind = H_IN_TAG
            elif byte == 62:
                ended = true
            else:
                tag = tag + ascii_name_char(byte)
        elif kind == H_IN_TAG or kind == H_AFTER_ATTR:
            if byte == 62:
                ended = true
            elif byte == 47:
                kind = H_IN_TAG
            elif byte == 61 and kind == H_AFTER_ATTR:
                kind = H_BEFORE_VALUE
            elif not is_space(byte):
                kind = H_ATTR_NAME
                attr = ascii_name_char(byte)
        elif kind == H_ATTR_NAME:
            if is_space(byte):
                kind = H_AFTER_ATTR
            elif byte == 47:
                kind = H_IN_TAG
            elif byte == 61:
                kind = H_BEFORE_VALUE
            elif byte == 62:
                ended = true
            else:
                attr = attr + ascii_name_char(byte)
        elif kind == H_BEFORE_VALUE:
            if byte == 34 or byte == 39:
                kind = H_DOUBLE
                if byte == 39:
                    kind = H_SINGLE
                prefix = ""
                known = true
                value_from = i + 1
                if is_url_attr(attr):
                    if i + 1 > seg_start:
                        nodes.push(node_text(text.substring(seg_start, i + 1), offset + seg_start))
                    nodes.push(Node(NODE_URL_START, "", "", "", false, 0 - 1, 0 - 1, offset + i + 1, MODE_URL))
                    seg_start = i + 1
            elif byte == 62:
                ended = true
            elif not is_space(byte):
                kind = H_UNQUOTED
                prefix = ""
                known = true
                value_from = i
                if is_url_attr(attr):
                    if i > seg_start:
                        nodes.push(node_text(text.substring(seg_start, i), offset + seg_start))
                    nodes.push(Node(NODE_URL_START, "", "", "", false, 0 - 1, 0 - 1, offset + i, MODE_UNQUOTED_URL))
                    seg_start = i
        elif kind == H_DOUBLE or kind == H_SINGLE:
            if (byte == 34 and kind == H_DOUBLE) or (byte == 39 and kind == H_SINGLE):
                if is_url_attr(attr):
                    if i > seg_start:
                        nodes.push(node_text(text.substring(seg_start, i), offset + seg_start))
                    nodes.push(Node(NODE_URL_END, "", "", "", false, 0 - 1, 0 - 1, offset + i, MODE_TEXT))
                    seg_start = i
                kind = H_IN_TAG
                prefix = ""
        elif kind == H_UNQUOTED:
            if is_space(byte):
                if is_url_attr(attr):
                    if i > seg_start:
                        nodes.push(node_text(text.substring(seg_start, i), offset + seg_start))
                    nodes.push(Node(NODE_URL_END, "", "", "", false, 0 - 1, 0 - 1, offset + i, MODE_TEXT))
                    seg_start = i
                kind = H_IN_TAG
                prefix = ""
            elif byte == 62:
                if is_url_attr(attr):
                    if i > seg_start:
                        nodes.push(node_text(text.substring(seg_start, i), offset + seg_start))
                    nodes.push(Node(NODE_URL_END, "", "", "", false, 0 - 1, 0 - 1, offset + i, MODE_TEXT))
                    seg_start = i
                ended = true
        elif kind == H_COMMENT:
            if byte == 62 and i >= 2 and ord(text[i - 2]) == 45 and ord(text[i - 1]) == 45:
                kind = H_TEXT
        elif kind == H_BOGUS:
            if byte == 62:
                kind = H_TEXT
        elif kind == H_SCRIPT or kind == H_RCDATA:
            if byte == 60 and closes_raw(text, i, tag):
                kind = H_TAG_NAME
                closing = true
                i = i + 1 + tag.len()
        if ended:
            next := after_tag(tag, closing)
            kind = next.kind
            tag = next.tag
            attr = ""
            closing = false
            prefix = ""
            known = true
            ended = false
        i = i + 1
    if seg_start < text.len():
        nodes.push(node_text(text.substring(seg_start, text.len()), offset + seg_start))
    if kind == H_DOUBLE or kind == H_SINGLE or kind == H_UNQUOTED:
        prefix = prefix + text.substring(value_from, text.len())
    return HtmlState(kind, tag, attr, closing, prefix, known)

# the state after a value is written at `st`: an attribute value has begun,
# and its literal text no longer says how it starts.
fn after_value(st: HtmlState) -> HtmlState:
    mut kind := st.kind
    if kind == H_BEFORE_VALUE:
        kind = H_UNQUOTED
    return HtmlState(kind, st.tag, st.attr, st.closing, "", false)

# how a `<%= %>` at `st` is escaped, or a failure for a place where escaping
# cannot make a value safe.
fn escape_mode(st: HtmlState, offset: Int) -> Int!TemplateError:
    kind := st.kind
    if kind == H_TEXT or kind == H_RCDATA or kind == H_COMMENT or kind == H_BOGUS:
        return MODE_TEXT
    if kind == H_SCRIPT:
        fail TemplateError("'<%=' cannot make a value safe inside <{st.tag}>; pass it as json in a data attribute or a <script type=\"application/json\"> block", offset)
    quoted := kind == H_DOUBLE or kind == H_SINGLE
    if quoted or kind == H_UNQUOTED or kind == H_BEFORE_VALUE:
        if is_code_attr(st.attr):
            fail TemplateError("'<%=' cannot make a value safe in the '{st.attr}' attribute; put it in a data attribute or choose a class instead", offset)
        if is_url_attr(st.attr):
            if quoted:
                return MODE_URL
            return MODE_UNQUOTED_URL
        if quoted:
            return MODE_TEXT
        return MODE_UNQUOTED
    fail TemplateError("a value cannot be part of a tag or attribute name; use '<% if %>' to choose between fixed ones", offset)

# where a `<%md %>` at `st` would land, for the error that refuses it.
fn markdown_place(st: HtmlState) -> String:
    kind := st.kind
    if kind == H_SCRIPT or kind == H_RCDATA:
        return "inside <{st.tag}>"
    if kind == H_COMMENT or kind == H_BOGUS:
        return "inside a comment or declaration"
    if kind == H_DOUBLE or kind == H_SINGLE or kind == H_UNQUOTED or kind == H_BEFORE_VALUE:
        return "in an attribute value"
    return "inside a tag"

# one state for the two that the paths through a block leave the html in, or
# a failure when they differ in a way that leaves a later value unsure of
# where it lands. a tag that ends on a different attribute in each branch is
# fine, since only the name of the next attribute matters.
fn merge_states(a: HtmlState, b: HtmlState, offset: Int) -> HtmlState!TemplateError:
    if a.kind == b.kind and a.tag == b.tag and a.attr == b.attr and a.closing == b.closing:
        if a.known and b.known and a.prefix == b.prefix:
            return a
        return HtmlState(a.kind, a.tag, a.attr, a.closing, "", false)
    tag_a := a.kind == H_IN_TAG or a.kind == H_ATTR_NAME or a.kind == H_AFTER_ATTR
    tag_b := b.kind == H_IN_TAG or b.kind == H_ATTR_NAME or b.kind == H_AFTER_ATTR
    if tag_a and tag_b and a.tag == b.tag and a.closing == b.closing:
        return html_state(H_IN_TAG, a.tag, "", a.closing)
    fail TemplateError("the paths through this block leave the html in different places, so a value after it has no single context to be escaped for", offset)

# a value for an unquoted attribute. every ascii byte other than a letter, a
# digit, `-`, `_` and `.` becomes a numeric entity, so a space or a `>` in the
# value cannot end the attribute. the bytes of a multi-byte character pass
# through whole.
fn escape_unquoted(input: String) -> String:
    mut parts: List[String] := []
    mut copied := 0
    mut position := 0
    while position < input.len():
        byte := ord(input[position])
        plain := byte >= 128 or is_letter(byte) or (byte >= 48 and byte <= 57) or byte == 45 or byte == 95 or byte == 46
        if not plain:
            if position > copied:
                parts.push(input.substring(copied, position))
            parts.push("&#{byte};")
            copied = position + 1
        position = position + 1
    if copied == 0:
        return input
    if copied < input.len():
        parts.push(input.substring(copied, input.len()))
    return parts.join("")

# decode html character references in literal template text inside a url attribute
# so `html.safe_url` inspects the same url scheme and separators a browser sees
# (e.g. `&#58;`, `&#x3a;`, `&colon;`, `&sol;`, `&bsol;`, `&tab;`, `&newline;`).
fn decode_html_entities_for_url(input: String) -> String:
    if not input.contains("&"):
        return input
    n := input.len()
    mut parts: List[String] := []
    mut copied := 0
    mut i := 0
    while i < n:
        if ord(input[i]) != 38:
            i = i + 1
            continue
        mut decoded := ""
        mut next_i := 0 - 1
        if i + 2 < n and ord(input[i + 1]) == 35:
            mut j := i + 2
            mut is_hex := false
            if ord(input[j]) == 120 or ord(input[j]) == 88:
                is_hex = true
                j = j + 1
            mut digits := 0
            mut cp := 0
            while j < n:
                b := ord(input[j])
                mut d := 0 - 1
                if b >= 48 and b <= 57:
                    d = b - 48
                elif is_hex and b >= 65 and b <= 70:
                    d = b - 55
                elif is_hex and b >= 97 and b <= 102:
                    d = b - 87
                else:
                    break
                if cp <= 1114111:
                    if is_hex:
                        cp = cp * 16 + d
                    else:
                        cp = cp * 10 + d
                digits = digits + 1
                j = j + 1
            if digits > 0:
                if j < n and ord(input[j]) == 59:
                    j = j + 1
                if cp > 0 and cp < 128:
                    decoded = chr(cp)
                elif cp >= 128:
                    decoded = "_"
                next_i = j
        elif ascii_matches_lower(input, i, "&colon;"):
            decoded = ":"
            next_i = i + 7
        elif ascii_matches_lower(input, i, "&sol;"):
            decoded = "/"
            next_i = i + 5
        elif ascii_matches_lower(input, i, "&bsol;"):
            decoded = "\\"
            next_i = i + 6
        elif ascii_matches_lower(input, i, "&tab;"):
            decoded = "\t"
            next_i = i + 5
        elif ascii_matches_lower(input, i, "&newline;"):
            decoded = "\n"
            next_i = i + 9
        elif ascii_matches_lower(input, i, "&amp;"):
            decoded = "&"
            next_i = i + 5
        elif ascii_matches_lower(input, i, "&lt;"):
            decoded = "<"
            next_i = i + 4
        elif ascii_matches_lower(input, i, "&gt;"):
            decoded = ">"
            next_i = i + 4
        elif ascii_matches_lower(input, i, "&quot;"):
            decoded = "\""
            next_i = i + 6
        elif ascii_matches_lower(input, i, "&apos;"):
            decoded = "'"
            next_i = i + 6
        if next_i >= 0:
            if i > copied:
                parts.push(input.substring(copied, i))
            if decoded != "":
                parts.push(decoded)
            copied = next_i
            i = next_i
        else:
            i = i + 1
    if copied == 0:
        return input
    if copied < n:
        parts.push(input.substring(copied, n))
    return parts.join("")

# a `<%= %>` value, escaped for where it sits. url attributes are checked as a
# whole when their attribute closes (NODE_URL_END), so MODE_URL and
# MODE_UNQUOTED_URL only escape for their quoting here.
fn escape_for(mode: Int, value: String) -> String:
    if mode == MODE_UNQUOTED or mode == MODE_UNQUOTED_URL:
        return escape_unquoted(value)
    return html.escape(value)

# Compiles template source into a `Template`.
#
# every tag is checked here — an unknown tag, an unbalanced `end`, an
# expression that is not a plain dotted path, or nesting deeper than 32 all
# fail at compile time rather than rendering as something surprising. compile
# your templates at startup and a malformed one takes the process down before
# it takes a request down.
pub fn compile(source: String) -> Template!TemplateError:
    if source.len() > MAX_SOURCE_BYTES:
        fail TemplateError("template source is larger than {MAX_SOURCE_BYTES} bytes", 0)
    mut nodes: List[Node] := []
    mut open_blocks: List[Int] := []
    # the html state where each open block began, and where its `if` branch
    # ended once an `else` is seen
    mut entry_states: List[HtmlState] := []
    mut then_states: List[HtmlState] := []
    mut state := html_state(H_TEXT, "", "", false)
    mut position := 0
    while position < source.len():
        open := find_pair(source, position, 60, 37)
        if open < 0:
            text := source.substring(position, source.len())
            state = emit_text_and_advance(nodes, state, text, position)
            position = source.len()
        else:
            if open > position:
                text := source.substring(position, open)
                state = emit_text_and_advance(nodes, state, text, position)
            close := find_pair(source, open + 2, 37, 62)
            if close < 0:
                fail TemplateError("unclosed '<%' tag", open)
            node := parse_tag(source.substring(open + 2, close), open)!
            if node.kind == NODE_END:
                if open_blocks.len() == 0:
                    fail TemplateError("'end' with no open 'if' or 'for'", open)
                last := open_blocks.len() - 1
                opener := open_blocks[last]
                # a loop body can run again or not at all, so it must end
                # where it began; an `if` must end where its other path does
                mut other := entry_states[last]
                if nodes[opener].alt >= 0:
                    other = then_states[last]
                state = merge_states(state, other, open)!
                open_blocks = open_blocks.slice(0, last)
                entry_states = entry_states.slice(0, last)
                then_states = then_states.slice(0, last)
                nodes.push(node)
                nodes = close_block(nodes, opener, nodes.len() - 1)
            elif node.kind == NODE_ELSE:
                if open_blocks.len() == 0:
                    fail TemplateError("'else' with no open 'if'", open)
                last := open_blocks.len() - 1
                opener := open_blocks[last]
                if nodes[opener].kind != NODE_IF:
                    fail TemplateError("'else' is only allowed inside an 'if'", open)
                if nodes[opener].alt >= 0:
                    fail TemplateError("an 'if' may have only one 'else'", open)
                then_states[last] = state
                state = entry_states[last]
                nodes.push(node)
                nodes = set_alt(nodes, opener, nodes.len() - 1)
            elif node.kind == NODE_IF or node.kind == NODE_FOR:
                if open_blocks.len() >= MAX_NESTING:
                    fail TemplateError("blocks nested deeper than {MAX_NESTING}", open)
                nodes.push(node)
                open_blocks.push(nodes.len() - 1)
                entry_states.push(state)
                then_states.push(state)
            elif node.kind == NODE_ESCAPED:
                mode := escape_mode(state, open)!
                if state.kind == H_BEFORE_VALUE and is_url_attr(state.attr):
                    nodes.push(Node(NODE_URL_START, "", "", "", false, 0 - 1, 0 - 1, open, MODE_UNQUOTED_URL))
                nodes.push(Node(NODE_ESCAPED, "", node.path, "", false, 0 - 1, 0 - 1, open, mode))
                state = after_value(state)
            elif node.kind == NODE_RAW:
                if state.kind == H_BEFORE_VALUE and is_url_attr(state.attr):
                    nodes.push(Node(NODE_URL_START, "", "", "", false, 0 - 1, 0 - 1, open, MODE_UNQUOTED_URL))
                nodes.push(node)
                state = after_value(state)
            elif node.kind == NODE_MARKDOWN:
                # the html it writes is whole elements, so the page is back in
                # element text afterwards and the state does not move.
                if state.kind != H_TEXT:
                    fail TemplateError("'<%md' writes block html, so it can only sit in element text, not {markdown_place(state)}", open)
                nodes.push(node)
            else:
                nodes.push(node)
            position = close + 2
    if open_blocks.len() > 0:
        fail TemplateError("missing 'end'", nodes[open_blocks[open_blocks.len() - 1]].offset)
    if is_url_value_state(state.kind, state.attr):
        nodes.push(Node(NODE_URL_END, "", "", "", false, 0 - 1, 0 - 1, source.len(), MODE_TEXT))
    return Template(nodes)

impl Template:
    # A copy whose `<%md %>` tags give each heading an `id` made from its
    # text, as `markdown.options().heading_ids(true)` does. the ids are unique
    # within one `<%md %>`, not across several.
    fn heading_ids(enabled: Bool) -> Template:
        return Template(nodes: self.nodes, markdown_opts: self.markdown_opts.heading_ids(enabled), highlighted: self.highlighted)

    # A copy whose `<%md %>` tags also start each heading with a link to
    # itself, as `markdown.options().heading_anchors(true)` does.
    fn heading_anchors(enabled: Bool) -> Template:
        return Template(nodes: self.nodes, markdown_opts: self.markdown_opts.heading_anchors(enabled), highlighted: self.highlighted)

    # A copy whose `<%md %>` tags write code blocks through `hook`, as
    # `markdown.options().code_highlighter(hook)` does. what the hook returns
    # reaches the page unescaped, so a template given one is audited like
    # `<%raw %>`: `std.pith.highlight`'s `code_block` escapes everything,
    # and a hook of your own has to as well.
    fn code_highlighter(hook: fn(String, String) -> String?) -> Template:
        return Template(nodes: self.nodes, markdown_opts: self.markdown_opts.code_highlighter(hook), highlighted: true)

    # Whether `<%md %>` writes code blocks through a highlighter.
    fn highlights_code() -> Bool:
        return self.highlighted

# record the matching `end` on the node that opened the block.
fn close_block(nodes: List[Node], opener: Int, closer: Int) -> List[Node]:
    old := nodes[opener]
    mut out := nodes
    out[opener] = Node(old.kind, old.text, old.path, old.name, old.negate, old.alt, closer, old.offset, old.mode)
    return out

# record the matching `else` on the node that opened the block.
fn set_alt(nodes: List[Node], opener: Int, alt: Int) -> List[Node]:
    old := nodes[opener]
    mut out := nodes
    out[opener] = Node(old.kind, old.text, old.path, old.name, old.negate, alt, old.close, old.offset, old.mode)
    return out

# ---------------------------------------------------------------
# loading from a file
# ---------------------------------------------------------------

# Compiles a template read from `path`.
#
# the size is checked before the read rather than after, so pointing this at
# something enormous costs a stat and not the memory. `path` is used exactly as
# given and is joined with nothing, so it must come from your own code or your
# own configuration — never from a request. for a name that came from outside,
# use `load_in`.
pub fn load(path: String) -> Template!TemplateError:
    size := fs.size(path) catch:
        fail TemplateError("could not read template '{path}'", 0)
    if size > MAX_SOURCE_BYTES:
        fail TemplateError("template '{path}' is larger than {MAX_SOURCE_BYTES} bytes", 0)
    source := fs.read(path) catch:
        fail TemplateError("could not read template '{path}'", 0)
    return compile(source)!

# Compiles the template named `name` from inside `dir`.
#
# this is the one to reach for when the name came from a request. `name` must
# be a plain file name: no `/`, no `\`, no `..`, and no leading `.`. that rule
# is checked on the name as written rather than on a resolved path, so there is
# no window between the check and the read and no symlink to race — a name that
# cannot express a traversal cannot become one.
pub fn load_in(dir: String, name: String) -> Template!TemplateError:
    if name == "":
        fail TemplateError("empty template name", 0)
    if name.contains("/") or name.contains("\\"):
        fail TemplateError("template name '{name}' may not contain a path separator", 0)
    if name.starts_with("."):
        fail TemplateError("template name '{name}' may not start with '.'", 0)
    mut position := 0
    while position < name.len():
        if ord(name[position]) < 32:
            fail TemplateError("template name contains a control character", 0)
        position = position + 1
    mut prefix := dir
    if not prefix.ends_with("/"):
        prefix = prefix + "/"
    return load(prefix + name)!

# ---------------------------------------------------------------
# rendering
# ---------------------------------------------------------------

# resolve a dotted path against the loop variables in scope, innermost first,
# then against the root context. returns -1 when nothing matches.
fn resolve(root: Int, names: List[String], values: List[Int], path: String) -> Int:
    segments := path.split(".")
    mut handle := root
    mut start := 0
    mut frame := names.len() - 1
    while frame >= 0:
        if names[frame] == segments[0]:
            handle = values[frame]
            start = 1
            frame = 0 - 1
        else:
            frame = frame - 1
    mut index := start
    while index < segments.len():
        if handle < 0:
            return 0 - 1
        handle = json.object_get(handle, segments[index])
        index = index + 1
    return handle

# the text a node renders to, before escaping. containers render empty: a page
# that prints `[object Object]` is a bug that should look like a hole instead.
fn stringify(handle: Int) -> String:
    kind := json.type_of(handle)
    if kind == "string":
        return json.get_string(handle)
    if kind == "int":
        return json.get_int(handle).to_string()
    if kind == "float":
        return json.get_float(handle).to_string()
    if kind == "bool":
        return json.get_bool(handle).to_string()
    return ""

# whether `if` takes its branch. empty is false in every shape it comes in:
# missing, null, false, 0, "", and the empty list.
fn truthy(handle: Int) -> Bool:
    kind := json.type_of(handle)
    if kind == "bool":
        return json.get_bool(handle)
    if kind == "int":
        return json.get_int(handle) != 0
    if kind == "float":
        return json.get_float(handle) != 0.0
    if kind == "string":
        return json.get_string(handle) != ""
    if kind == "array":
        return json.array_len(handle) > 0
    if kind == "object":
        return true
    return false

# a copy of the loop-variable scope with one more binding on top. copying keeps
# the scope stack immutable across the recursive call, so an early return can
# never leave a stale binding behind.
fn extend_names(names: List[String], name: String) -> List[String]:
    mut out: List[String] := []
    mut index := 0
    while index < names.len():
        out.push(names[index])
        index = index + 1
    out.push(name)
    return out

fn extend_values(values: List[Int], value: Int) -> List[Int]:
    mut out: List[Int] := []
    mut index := 0
    while index < values.len():
        out.push(values[index])
        index = index + 1
    out.push(value)
    return out

struct RenderOut:
    mut total: Int
    mut parts: List[String]
    mut url_active: Bool
    mut url_unquoted: Bool
    mut url_has_escaped: Bool
    mut url_rendered: List[String]
    mut url_raw: List[String]

fn add_rendered_bytes(out: RenderOut, piece_len: Int, offset: Int) -> Bool!TemplateError:
    out.total = out.total + piece_len
    if out.total > MAX_OUTPUT_BYTES:
        fail TemplateError("rendered output is larger than {MAX_OUTPUT_BYTES} bytes", offset)
    return true

fn flush_url_attr(out: RenderOut):
    if not out.url_active:
        return
    mut keep := true
    if out.url_has_escaped:
        full_url := out.url_raw.join("")
        if full_url != "" and html.safe_url(full_url) != full_url:
            keep = false
    if keep:
        mut i := 0
        while i < out.url_rendered.len():
            out.parts.push(out.url_rendered[i])
            i = i + 1
    elif out.url_unquoted:
        out.parts.push(escape_unquoted("about:blank"))
    else:
        out.parts.push("about:blank")
    out.url_active = false
    out.url_unquoted = false
    out.url_has_escaped = false
    out.url_rendered = []
    out.url_raw = []

fn render_range(t: Template, start: Int, stop: Int, root: Int, names: List[String], values: List[Int], out: RenderOut) -> Bool!TemplateError:
    # collect rendered pieces in `out.parts` and join once at the end so nested
    # `<% if %>` and `<% for %>` blocks stay linear and enforce MAX_OUTPUT_BYTES
    # on every step. inside a url attribute (NODE_URL_START..NODE_URL_END), pieces
    # are buffered in `out.url_rendered`/`out.url_raw` and validated as a whole
    # against `html.safe_url` when the attribute closes.
    mut index := start
    while index < stop:
        node := t.nodes[index]
        if node.kind == NODE_URL_START:
            out.url_active = true
            out.url_unquoted = node.mode == MODE_UNQUOTED_URL
            out.url_has_escaped = false
            out.url_rendered = []
            out.url_raw = []
            index = index + 1
        elif node.kind == NODE_URL_END:
            flush_url_attr(out)
            index = index + 1
        elif node.kind == NODE_TEXT:
            add_rendered_bytes(out, node.text.len(), node.offset)!
            if out.url_active:
                out.url_rendered.push(node.text)
                out.url_raw.push(decode_html_entities_for_url(node.text))
            else:
                out.parts.push(node.text)
            index = index + 1
        elif node.kind == NODE_ESCAPED:
            raw_val := stringify(resolve(root, names, values, node.path))
            piece := escape_for(node.mode, raw_val)
            add_rendered_bytes(out, piece.len(), node.offset)!
            if out.url_active:
                out.url_has_escaped = true
                out.url_rendered.push(piece)
                out.url_raw.push(raw_val)
            else:
                out.parts.push(piece)
            index = index + 1
        elif node.kind == NODE_RAW:
            piece := stringify(resolve(root, names, values, node.path))
            add_rendered_bytes(out, piece.len(), node.offset)!
            if out.url_active:
                out.url_rendered.push(piece)
                out.url_raw.push(decode_html_entities_for_url(piece))
            else:
                out.parts.push(piece)
            index = index + 1
        elif node.kind == NODE_MARKDOWN:
            source := stringify(resolve(root, names, values, node.path))
            # a source longer than the whole output cap fails before it is
            # parsed rather than after.
            if source.len() > MAX_OUTPUT_BYTES:
                fail TemplateError("markdown at '{node.path}' is larger than {MAX_OUTPUT_BYTES} bytes", node.offset)
            piece := markdown.render(source, t.markdown_opts)
            add_rendered_bytes(out, piece.len(), node.offset)!
            out.parts.push(piece)
            index = index + 1
        elif node.kind == NODE_IF:
            mut taken := truthy(resolve(root, names, values, node.path))
            if node.negate:
                taken = not taken
            if taken:
                mut body_end := node.close
                if node.alt >= 0:
                    body_end = node.alt
                render_range(t, index + 1, body_end, root, names, values, out)!
            elif node.alt >= 0:
                render_range(t, node.alt + 1, node.close, root, names, values, out)!
            index = node.close + 1
        elif node.kind == NODE_FOR:
            items := resolve(root, names, values, node.path)
            count := json.array_len(items)
            mut item_index := 0
            while item_index < count:
                inner_names := extend_names(names, node.name)
                inner_values := extend_values(values, json.array_get(items, item_index))
                render_range(t, index + 1, node.close, root, inner_names, inner_values, out)!
                item_index = item_index + 1
            index = node.close + 1
        else:
            index = index + 1
    return true

# Renders `t` with `data`, escaping every `<%= %>` value.
#
# a value interpolated with `<%= %>` is escaped for where it lands (see the
# module header), always, with no way to turn that off for the template as a
# whole. the only unescaped path is a `<%raw %>` tag that somebody wrote on
# purpose.
pub fn render(t: Template, data: Ctx) -> String!TemplateError:
    mut names: List[String] := []
    mut values: List[Int] := []
    out := RenderOut(0, [], false, false, false, [], [])
    render_range(t, 0, t.nodes.len(), data.node, names, values, out)!
    flush_url_attr(out)
    return out.parts.join("")

# Compiles `source` and renders it in one step.
#
# convenient for a one-off fragment and for tests. a template that is rendered
# per request should be compiled once with `compile` and kept, so a syntax
# error is a startup failure and not a 500.
pub fn render_string(source: String, data: Ctx) -> String!TemplateError:
    return render(compile(source)!, data)!

# ---------------------------------------------------------------
# tests
# ---------------------------------------------------------------

# the two tests that matter: what happens by default, and what the opt-out
# does. if either of these ever changes, every page rendered by this module
# changes its security posture with it.

test "an interpolated value is escaped by default":
    ctx := context().set("name", "<script>alert(1)</script>")

    assert_eq(render_string("<h1>hello, <%= name %></h1>", ctx)!, "<h1>hello, &lt;script&gt;alert(1)&lt;/script&gt;</h1>")

test "raw is the only way out, and it is unescaped":
    ctx := context().set("body", "<b>bold</b>")

    assert_eq(render_string("<%= body %>", ctx)!, "&lt;b&gt;bold&lt;/b&gt;")
    assert_eq(render_string("<%raw body %>", ctx)!, "<b>bold</b>")

test "escaping applies in every position a value can appear":
    payload := "\" onmouseover=\"alert(1)"
    ctx := context().set("q", payload)

    assert_eq(render_string("<input value=\"<%= q %>\">", ctx)!, "<input value=\"&quot; onmouseover=&quot;alert(1)\">")
    assert_eq(render_string("<p><%= q %></p>", ctx)!, "<p>&quot; onmouseover=&quot;alert(1)</p>")

test "escaping applies inside a loop and inside a branch":
    rows := list()
    rows.push(context().set("title", "<one>"))
    rows.push(context().set("title", "&two"))
    ctx := context().set_child("rows", rows).set_bool("show", true).set("note", "<em>hi</em>")

    assert_eq(render_string("<% for row in rows %>[<%= row.title %>]<% end %>", ctx)!, "[&lt;one&gt;][&amp;two]")
    assert_eq(render_string("<% if show %><%= note %><% end %>", ctx)!, "&lt;em&gt;hi&lt;/em&gt;")
    assert_eq(render_string("<% if show %><%raw note %><% end %>", ctx)!, "<em>hi</em>")

test "a value is never re-read as template syntax":
    ctx := context().set("name", "<%raw secret %>").set("secret", "leaked")

    assert_eq(render_string("<%= name %>", ctx)!, "&lt;%raw secret %&gt;")
    assert_eq(render_string("<%raw name %>", ctx)!, "<%raw secret %>")

test "text passes through untouched":
    ctx := context()

    assert_eq(render_string("", ctx)!, "")
    assert_eq(render_string("<h1>plain</h1>", ctx)!, "<h1>plain</h1>")
    assert_eq(render_string("a <%# note %> b", ctx)!, "a  b")

test "values render by their type":
    ctx := context().set("s", "text").set_int("n", 42).set_bool("b", true).set_float("f", 1.5)

    assert_eq(render_string("<%= s %>|<%= n %>|<%= b %>|<%= f %>", ctx)!, "text|42|true|1.5")

test "a missing path renders empty and is falsy":
    ctx := context().set("here", "yes")

    assert_eq(render_string("[<%= missing %>]", ctx)!, "[]")
    assert_eq(render_string("[<%= here.deeper %>]", ctx)!, "[]")
    assert_eq(render_string("<% if missing %>yes<% else %>no<% end %>", ctx)!, "no")

test "dotted paths walk nested contexts":
    ctx := context().set_child("user", context().set("name", "ada").set_child("role", context().set("label", "admin")))

    assert_eq(render_string("<%= user.name %>", ctx)!, "ada")
    assert_eq(render_string("<%= user.role.label %>", ctx)!, "admin")

test "if takes the branch its value asks for":
    filled := context().set("v", "x").set_int("n", 1).set_bool("b", true)
    empty := context().set("v", "").set_int("n", 0).set_bool("b", false)

    assert_eq(render_string("<% if v %>y<% else %>n<% end %>", filled)!, "y")
    assert_eq(render_string("<% if v %>y<% else %>n<% end %>", empty)!, "n")
    assert_eq(render_string("<% if n %>y<% else %>n<% end %>", filled)!, "y")
    assert_eq(render_string("<% if n %>y<% else %>n<% end %>", empty)!, "n")
    assert_eq(render_string("<% if b %>y<% else %>n<% end %>", filled)!, "y")
    assert_eq(render_string("<% if b %>y<% else %>n<% end %>", empty)!, "n")

test "if not inverts the test":
    ctx := context().set("v", "")

    assert_eq(render_string("<% if not v %>empty<% end %>", ctx)!, "empty")
    assert_eq(render_string("<% if not missing %>gone<% end %>", ctx)!, "gone")

test "an empty list is falsy and loops zero times":
    ctx := context().set_child("rows", list())

    assert_eq(render_string("<% if rows %>some<% else %>none<% end %>", ctx)!, "none")
    assert_eq(render_string("<% for row in rows %>x<% end %>", ctx)!, "")
    assert_eq(render_string("<% for row in missing %>x<% end %>", ctx)!, "")

test "loops iterate lists of scalars and of contexts":
    tags := list().push_text("a").push_text("b").push_text("c")
    ctx := context().set_child("tags", tags)

    assert_eq(render_string("<% for tag in tags %><li><%= tag %></li><% end %>", ctx)!, "<li>a</li><li>b</li><li>c</li>")

test "loops nest and inner names shadow outer ones":
    inner_a := list().push_int(1).push_int(2)
    inner_b := list().push_int(3)
    groups := list()
    groups.push(context().set("label", "a").set_child("items", inner_a))
    groups.push(context().set("label", "b").set_child("items", inner_b))
    ctx := context().set_child("groups", groups)

    assert_eq(render_string("<% for g in groups %><%= g.label %>:<% for i in g.items %><%= i %><% end %>;<% end %>", ctx)!, "a:12;b:3;")

test "a loop variable does not leak past its loop":
    rows := list().push_text("x")
    ctx := context().set_child("rows", rows).set("row", "outer")

    assert_eq(render_string("<% for row in rows %><%= row %><% end %><%= row %>", ctx)!, "xouter")

test "an if nests inside a for":
    rows := list()
    rows.push(context().set("name", "on").set_bool("live", true))
    rows.push(context().set("name", "off").set_bool("live", false))
    ctx := context().set_child("rows", rows)

    assert_eq(render_string("<% for r in rows %><% if r.live %>[<%= r.name %>]<% end %><% end %>", ctx)!, "[on]")

test "whitespace inside a tag is optional":
    ctx := context().set("x", "v")

    assert_eq(render_string("<%=x%>", ctx)!, "v")
    assert_eq(render_string("<%=   x   %>", ctx)!, "v")
    assert_eq(render_string("<%  if  x  %>y<%  end  %>", ctx)!, "y")

test "a compiled template renders more than once":
    page := compile("<%= n %>")!

    assert_eq(render(page, context().set("n", "first"))!, "first")
    assert_eq(render(page, context().set("n", "second"))!, "second")

test "from_json renders a parsed document":
    scope := json.open_scope()
    root := json.parse("{{\"name\": \"<b>\", \"tags\": [\"x\", \"y\"]}}")
    out := render_string("<%= name %><% for t in tags %>-<%= t %><% end %>", from_json(root))!
    json.close_scope(scope)

    assert_eq(out, "&lt;b&gt;-x-y")

# a template that fails to compile, reported as a bool. `catch` has no error
# binding, so outcome is what a test can assert on — and a rejection is the
# whole contract here, not the wording of the message.
fn compile_rejects(source: String) -> Bool:
    compile(source) catch:
        return true
    return false

# the same, for a template name that should never reach the filesystem.
fn load_in_rejects(dir: String, name: String) -> Bool:
    load_in(dir, name) catch:
        return true
    return false

test "compile rejects a malformed template":
    assert_eq(compile_rejects("<% if x %>no end"), true)
    assert_eq(compile_rejects("<%= x"), true)
    assert_eq(compile_rejects("<% end %>"), true)
    assert_eq(compile_rejects("<% else %>"), true)
    assert_eq(compile_rejects("<% if x %><% else %><% else %><% end %>"), true)
    assert_eq(compile_rejects("<% for x in y %><% else %><% end %>"), true)
    assert_eq(compile_rejects("<% while x %><% end %>"), true)
    assert_eq(compile_rejects("<%= %>"), true)
    assert_eq(compile_rejects("<%  %>"), true)
    assert_eq(compile_rejects("<%= a b %>"), true)
    assert_eq(compile_rejects("<%= a() %>"), true)
    assert_eq(compile_rejects("<%= a.. %>"), true)
    assert_eq(compile_rejects("<%raw %>"), true)
    assert_eq(compile_rejects("<% for x %><% end %>"), true)
    assert_eq(compile_rejects("<% if %><% end %>"), true)

test "compile accepts the whole syntax":
    ok := compile("<% if a %><%= b %><% else %><%raw c %><% end %><% for d in e %><%# note %><% end %>")!

    assert_eq(compile_rejects("<% if a %><%= b %><% else %><%raw c %><% end %>"), false)
    assert_eq(ok.nodes.len() > 0, true)

test "load_in refuses a name that could escape its directory":
    assert_eq(load_in_rejects("templates", "../secret.html"), true)
    assert_eq(load_in_rejects("templates", "a/b.html"), true)
    assert_eq(load_in_rejects("templates", "a\\b.html"), true)
    assert_eq(load_in_rejects("templates", ".hidden"), true)
    assert_eq(load_in_rejects("templates", ".."), true)
    assert_eq(load_in_rejects("templates", ""), true)

test "compile refuses runaway nesting":
    mut deep := ""
    mut level := 0
    while level < MAX_NESTING + 1:
        deep = deep + "<% if a %>"
        level = level + 1
    while level > 0:
        deep = deep + "<% end %>"
        level = level - 1

    assert_eq(compile_rejects(deep), true)

test "load reads a template off disk and load_in joins a safe name":
    dir := fs.make_temp_dir("pith-template-")!
    fs.write(dir + "/page.html", "<h1><%= name %></h1>")!
    ctx := context().set("name", "<b>")
    from_path := render(load(dir + "/page.html")!, ctx)!
    from_name := render(load_in(dir, "page.html")!, ctx)!
    missing := load_in_rejects(dir, "missing.html")
    fs.remove(dir + "/page.html")
    fs.remove_empty_dir(dir)

    assert_eq(from_path, "<h1>&lt;b&gt;</h1>")
    assert_eq(from_name, "<h1>&lt;b&gt;</h1>")
    assert_eq(missing, true)

fn link(url: String) -> String:
    ctx := context().set("u", url)
    return render_string("<a href=\"<%= u %>\">", ctx) catch "ERR"

test "a value in a url attribute cannot run script":
    assert_eq(link("javascript:alert(1)"), "<a href=\"about:blank\">")
    assert_eq(link("JaVaScRiPt:alert(1)"), "<a href=\"about:blank\">")
    assert_eq(link("data:text/html,<script>alert(1)</script>"), "<a href=\"about:blank\">")
    assert_eq(link("vbscript:msgbox(1)"), "<a href=\"about:blank\">")
    assert_eq(link(" javascript:alert(1)"), "<a href=\"about:blank\">")
    # a leading control byte, which a browser strips before reading the scheme
    assert_eq(link(chr(1) + "java\tscript:alert(1)"), "<a href=\"about:blank\">")
    assert_eq(link("java\nscript:alert(1)"), "<a href=\"about:blank\">")
    assert_eq(link("//evil.example"), "<a href=\"about:blank\">")
    # an entity is not decoded in the value, and its `&` is escaped, so the
    # browser sees the text `javascript&#58;alert(1)`: a relative path
    assert_eq(link("javascript&#58;alert(1)"), "<a href=\"javascript&amp;#58;alert(1)\">")

test "a value in a url attribute keeps the urls a page needs":
    assert_eq(link("https://example.com/a?b=c&d=e"), "<a href=\"https://example.com/a?b=c&amp;d=e\">")
    assert_eq(link("http://example.com"), "<a href=\"http://example.com\">")
    assert_eq(link("/relative/path"), "<a href=\"/relative/path\">")
    assert_eq(link("relative"), "<a href=\"relative\">")
    assert_eq(link("mailto:someone@example.com"), "<a href=\"mailto:someone@example.com\">")
    assert_eq(link("#top"), "<a href=\"#top\">")
    assert_eq(link(""), "<a href=\"\">")

test "every url attribute is checked, in every quoting":
    ctx := context().set("u", "javascript:alert(1)")

    assert_eq(render_string("<img SRC='<%= u %>'>", ctx)!, "<img SRC='about:blank'>")
    assert_eq(render_string("<form action=<%= u %>>", ctx)!, "<form action=about&#58;blank>")
    assert_eq(render_string("<button formaction = \"<%= u %>\">", ctx)!, "<button formaction = \"about:blank\">")
    assert_eq(render_string("<svg><a xlink:href=\"<%= u %>\"></a></svg>", ctx)!, "<svg><a xlink:href=\"about:blank\"></a></svg>")
    assert_eq(render_string("<a title=\"<%= u %>\">", ctx)!, "<a title=\"javascript:alert(1)\">")

test "a url is checked as a whole across prefixes, suffixes, entities, and multiple slots":
    ctx := context().set("p", "/evil.example").set("id", "javascript:alert(1)").set("q", "a b")

    # "/" and "/evil.example" make "//evil.example", which leaves the site
    assert_eq(render_string("<a href=\"/<%= p %>\">", ctx)!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"/users/<%= id %>\">", ctx)!, "<a href=\"/users/javascript:alert(1)\">")
    assert_eq(render_string("<a href=\"https://example.com/?q=<%= q %>\">", ctx)!, "<a href=\"https://example.com/?q=a b\">")
    assert_eq(render_string("<a href=\"java<%= id %>\">", context().set("id", "script:alert(1)"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"javascript:<%= q %>\">", ctx)!, "<a href=\"about:blank\">")
    # literal suffix and entity-encoded colon after a dynamic slot
    assert_eq(render_string("<a href=\"<%= s %>:alert(1)\">", context().set("s", "javascript"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= s %>&#58;alert(1)\">", context().set("s", "javascript"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= s %>&#x3a;alert(1)\">", context().set("s", "javascript"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= s %>&colon;alert(1)\">", context().set("s", "javascript"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= s %>:alert(1)\">", context().set("s", "https"))!, "<a href=\"https:alert(1)\">")
    # multiple slots composing a protocol-relative url or script scheme
    assert_eq(render_string("<a href=\"<%= a %><%= b %>\">", context().set("a", "/").set("b", "/evil.example"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= a %>/<%= b %>\">", context().set("a", "").set("b", "/evil.example"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= a %><%= b %>\">", context().set("a", "java").set("b", "script:alert(1)"))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= a %><%= b %>\">", context().set("a", "/users/").set("b", "ada"))!, "<a href=\"/users/ada\">")
    # unquoted multi-slot and suffix urls
    assert_eq(render_string("<a href=<%= s %>:alert(1)>", context().set("s", "javascript"))!, "<a href=about&#58;blank>")
    assert_eq(render_string("<a href=<%= a %><%= b %>>", context().set("a", "/").set("b", "/evil.example"))!, "<a href=about&#58;blank>")
    # control flow inside a url attribute
    assert_eq(render_string("<a href=\"<%= s %><% if c %>:alert(1)<% end %>\">", context().set("s", "javascript").set_bool("c", true))!, "<a href=\"about:blank\">")
    assert_eq(render_string("<a href=\"<%= s %><% if c %>:alert(1)<% end %>\">", context().set("s", "javascript").set_bool("c", false))!, "<a href=\"javascript\">")
    chars := list().push_text("java").push_text("script:").push_text("alert(1)")
    assert_eq(render_string("<a href=\"<% for ch in chars %><%= ch %><% end %>\">", context().set_child("chars", chars))!, "<a href=\"about:blank\">")

test "html tokenizer handles multibyte utf-8 without slicing mid-character":
    ctx := context().set("x", "<b>")
    assert_eq(render_string("<style></abcdé</style><p><%= x %></p>", ctx)!, "<style></abcdé</style><p>&lt;b&gt;</p>")
    assert_eq(render_string("<!aé><p><%= x %></p>", ctx)!, "<!aé><p>&lt;b&gt;</p>")
    assert_eq(render_string("<!-- éa> --><p><%= x %></p>", ctx)!, "<!-- éa> --><p>&lt;b&gt;</p>")
    assert_eq(render_string("<divé café=\"1\"><%= x %></divé>", ctx)!, "<divé café=\"1\">&lt;b&gt;</divé>")

test "an unquoted attribute value cannot end the attribute":
    ctx := context().set("v", "x onmouseover=alert(1)")

    assert_eq(render_string("<p title=<%= v %>>", ctx)!, "<p title=x&#32;onmouseover&#61;alert&#40;1&#41;>")
    assert_eq(render_string("<p title=<%= v %> class=a>", context().set("v", "café-1.2_x"))!, "<p title=café-1.2_x class=a>")

test "compile refuses a value where escaping cannot make it safe":
    assert_eq(compile_rejects("<a onclick=\"go('<%= x %>')\">"), true)
    assert_eq(compile_rejects("<a ONMOUSEOVER=<%= x %>>"), true)
    assert_eq(compile_rejects("<p style=\"color: <%= x %>\">"), true)
    assert_eq(compile_rejects("<iframe srcdoc=\"<%= x %>\">"), true)
    assert_eq(compile_rejects("<script>var a = <%= x %>;</script>"), true)
    assert_eq(compile_rejects("<STYLE>p {{ color: <%= x %> }}</style>"), true)
    assert_eq(compile_rejects("<<%= x %>>"), true)
    assert_eq(compile_rejects("<div <%= x %>>"), true)
    assert_eq(compile_rejects("<div data-<%= x %>=1>"), true)
    assert_eq(compile_rejects("</<%= x %>>"), true)

test "raw is still allowed everywhere":
    ctx := context().set("u", "javascript:void(0)").set("js", "1 + 1")

    assert_eq(render_string("<a href=\"<%raw u %>\">", ctx)!, "<a href=\"javascript:void(0)\">")
    assert_eq(render_string("<script>var a = <%raw js %>;</script>", ctx)!, "<script>var a = 1 + 1;</script>")

test "the context follows the page past scripts, comments and raw text":
    ctx := context().set("x", "<b>")

    assert_eq(render_string("<script>if (a < b) {{}}</script><p><%= x %></p>", ctx)!, "<script>if (a < b) {{}}</script><p>&lt;b&gt;</p>")
    assert_eq(render_string("<!-- <a href=\" --><%= x %>", ctx)!, "<!-- <a href=\" -->&lt;b&gt;")
    assert_eq(render_string("<!-- <%= x %> -->", ctx)!, "<!-- &lt;b&gt; -->")
    assert_eq(render_string("<textarea><a href=\"</textarea><%= x %>", ctx)!, "<textarea><a href=\"</textarea>&lt;b&gt;")
    assert_eq(render_string("<title><%= x %></title>", ctx)!, "<title>&lt;b&gt;</title>")
    assert_eq(render_string("<p title=\"a>b\"><%= x %>", ctx)!, "<p title=\"a>b\">&lt;b&gt;")

test "blocks must leave the html where a later value can be placed":
    ctx := context().set_bool("c", true).set("v", "\"")

    assert_eq(render_string("<input <% if c %>checked<% else %>disabled<% end %> value=\"<%= v %>\">", ctx)!, "<input checked value=\"&quot;\">")
    assert_eq(render_string("<a class=\"<% for i in c %>x <% end %>\" href=\"<%= v %>\">", ctx)!, "<a class=\"\" href=\"&quot;\">")
    rows := list().push_text("/a").push_text("javascript:b")
    assert_eq(render_string("<% for r in rows %><a href=\"<%= r %>\">x</a><% end %>", context().set_child("rows", rows))!, "<a href=\"/a\">x</a><a href=\"about:blank\">x</a>")
    assert_eq(compile_rejects("<% if c %><a href=\"<% end %><%= v %>"), true)
    assert_eq(compile_rejects("<% for i in c %><p title=\"<% end %>"), true)
    assert_eq(compile_rejects("<% if c %><a href=\"<% else %><p><% end %>"), true)

test "nested for loops enforce MAX_OUTPUT_BYTES during rendering":
    # 200 x 200 x 256 bytes = 10 MiB (> 4 MiB MAX_OUTPUT_BYTES); fails mid-loop
    # rather than accumulating unbounded strings first.
    mut items := list()
    mut i := 0
    while i < 200:
        items = items.push_text("x")
        i = i + 1
    chunk := "a".repeat(256)
    ctx := context().set_child("rows", items).set("chunk", chunk)
    res := render_string("<% for a in rows %><% for b in rows %><%= chunk %><% end %><% end %>", ctx)
    assert(res.is_err)

test "md renders a value as markdown, exactly as markdown.to_html does":
    source := "# Title\n\nsome *text*, a [link](/a?b=1&c=2) and `code`\n\n- one\n- two\n\n```\nx < y\n```\n"
    ctx := context().set("body", source)

    assert_eq(render_string("<main><%md body %></main>", ctx)!, "<main>" + markdown.to_html(source) + "</main>")
    assert_eq(render_string("[<%md missing %>]", ctx)!, "[]")
    rows := list().push_text("*a*").push_text("`b`")
    assert_eq(render_string("<% for r in rows %><div><%md r %></div><% end %>", context().set_child("rows", rows))!, "<div><p><em>a</em></p>\n</div><div><p><code>b</code></p>\n</div>")

fn md_of(value: String) -> String:
    ctx := context().set("v", value).set("secret", "<b>leaked</b>")
    return render_string("<main><%md v %></main>", ctx) catch "ERR"

test "md is never a way to write raw html":
    assert_eq(md_of("<script>alert(1)</script>"), "<main><p>&lt;script&gt;alert(1)&lt;/script&gt;</p>\n</main>")
    assert_eq(md_of("<img src=x onerror=alert(1)>"), "<main><p>&lt;img src=x onerror=alert(1)&gt;</p>\n</main>")
    assert_eq(md_of("</main><script>alert(1)</script>"), "<main><p>&lt;/main&gt;&lt;script&gt;alert(1)&lt;/script&gt;</p>\n</main>")
    assert_eq(md_of("[x](javascript:alert(1))"), "<main><p><a href=\"\">x</a></p>\n</main>")
    assert_eq(md_of("[x](java&#x09;script&colon;alert(1))"), "<main><p><a href=\"\">x</a></p>\n</main>")
    assert_eq(md_of("![x](data:image/svg+xml,%3Csvg%20onload=alert(1)%3E)"), "<main><p><img src=\"\" alt=\"x\" /></p>\n</main>")
    assert_eq(md_of("[x](/u \"\\\" onmouseover=\\\"alert(1)\")"), "<main><p><a href=\"/u\" title=\"&quot; onmouseover=&quot;alert(1)\">x</a></p>\n</main>")
    assert_eq(md_of("<%raw secret %>"), "<main><p>&lt;%raw secret %&gt;</p>\n</main>")
    assert_eq(md_of("```\"><script>\nx\n```"), "<main><pre><code class=\"language-&quot;&gt;&lt;script&gt;\">x\n</code></pre>\n</main>")
    for attack in ["<div onclick=x>", "<iframe srcdoc=x>", "<!-- x -->", "<?php x ?>", "<![CDATA[x]]>", "<style>*{}</style>"]:
        assert_eq(md_of(attack), "<main>" + markdown.to_html(attack) + "</main>")
        assert(not md_of(attack).contains(attack))

test "md is refused anywhere but element text":
    assert_eq(compile_rejects("<p title=\"<%md v %>\">"), true)
    assert_eq(compile_rejects("<p title='<%md v %>'>"), true)
    assert_eq(compile_rejects("<p title=<%md v %>>"), true)
    assert_eq(compile_rejects("<a href=\"<%md v %>\">"), true)
    assert_eq(compile_rejects("<div <%md v %>>"), true)
    assert_eq(compile_rejects("<<%md v %>>"), true)
    assert_eq(compile_rejects("</<%md v %>>"), true)
    assert_eq(compile_rejects("<script><%md v %></script>"), true)
    assert_eq(compile_rejects("<style><%md v %></style>"), true)
    assert_eq(compile_rejects("<title><%md v %></title>"), true)
    assert_eq(compile_rejects("<textarea><%md v %></textarea>"), true)
    assert_eq(compile_rejects("<noscript><%md v %></noscript>"), true)
    assert_eq(compile_rejects("<!-- <%md v %> -->"), true)
    assert_eq(compile_rejects("<!doctype <%md v %>>"), true)
    assert_eq(compile_rejects("<%md %>"), true)
    assert_eq(compile_rejects("<%md a b %>"), true)
    assert_eq(compile_rejects("<%md a() %>"), true)
    refused := compile("<title><%md v %></title>")
    assert(refused.is_err)
    assert_eq(refused.err.message, "'<%md' writes block html, so it can only sit in element text, not inside <title>")
    assert_eq(compile_rejects("<div><%md v %></div><p><%md v %></p>"), false)
    assert_eq(compile_rejects("<script>a < b</script><%md v %><p title=\"<%= v %>\">"), false)
    assert_eq(compile_rejects("<% if c %><%md v %><% else %><%md w %><% end %>"), false)

test "a template can give markdown headings ids and anchors":
    ctx := context().set("body", "# Hi there\n\n## Hi there")
    page := compile("<%md body %>")!

    assert_eq(render(page, ctx)!, "<h1>Hi there</h1>\n<h2>Hi there</h2>\n")
    assert_eq(render(page.heading_ids(true), ctx)!, "<h1 id=\"hi-there\">Hi there</h1>\n<h2 id=\"hi-there-1\">Hi there</h2>\n")
    anchored := render(page.heading_anchors(true), ctx)!
    assert_eq(anchored, markdown.render("# Hi there\n\n## Hi there", markdown.options().heading_anchors(true)))
    assert_eq(render(page, ctx)!, "<h1>Hi there</h1>\n<h2>Hi there</h2>\n")

# a code highlighter for the tests: blocks in "loud" in capitals, escaped.
fn loud_code(language: String, code: String) -> String?:
    if language != "loud":
        return none
    return "<pre class=\"loud\">" + html.escape(code.to_upper()) + "</pre>\n"

test "a template can write markdown code blocks through a highlighter":
    ctx := context().set("body", "# t\n\n```loud\n<a>\n```\n\n```go\nx\n```\n")
    page := compile("<main><%md body %></main>")!
    assert_eq(render(page, ctx)!, "<main><h1>t</h1>\n<pre><code class=\"language-loud\">&lt;a&gt;\n</code></pre>\n<pre><code class=\"language-go\">x\n</code></pre>\n</main>")
    assert(not page.highlights_code())
    loud := page.code_highlighter(loud_code).heading_ids(true)
    assert(loud.highlights_code())
    assert_eq(render(loud, ctx)!, "<main><h1 id=\"t\">t</h1>\n<pre class=\"loud\">&lt;A&gt;\n</pre>\n<pre><code class=\"language-go\">x\n</code></pre>\n</main>")
    # the builders leave the receiver alone
    assert_eq(render(page, ctx)!, "<main><h1>t</h1>\n<pre><code class=\"language-loud\">&lt;a&gt;\n</code></pre>\n<pre><code class=\"language-go\">x\n</code></pre>\n</main>")

test "md output counts against MAX_OUTPUT_BYTES":
    too_big := context().set("v", "a".repeat(MAX_OUTPUT_BYTES + 1))
    assert(render_string("<%md v %>", too_big).is_err)
    mut rows := list()
    mut i := 0
    while i < 2100:
        rows = rows.push_text("x")
        i = i + 1
    ctx := context().set_child("rows", rows).set("v", "y".repeat(4096))
    assert(render_string("<% for r in rows %><%md v %><% end %>", ctx).is_err)
