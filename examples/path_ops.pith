# path_ops: taking file paths apart and putting them back with std.os.path.
#
# plans the output of a small static site build. each source file under
# content/ maps to a page under public/: markdown becomes html, images are
# copied as they are, and a path that climbs out of content/ is refused.
# nothing here touches the disk; std.os.path only works on the strings.

import std.os.path as path

fn output_path(source_root: String, output_root: String, source: String) -> String!:
    cleaned := path.clean(source)
    relative := path.rel(source_root, cleaned)
    if relative.starts_with(".."):
        fail "{source} is outside {source_root}"
    target := path.join(output_root, relative)
    extension := path.ext(cleaned)
    if extension == ".md":
        return path.with_ext(target, ".html")
    if [".png", ".jpg"].contains(extension):
        return target
    fail "no rule for {path.base(cleaned)}"

fn main():
    source_root := "/site/content"
    output_root := "/site/public"
    sources := [
        "/site/content/index.md",
        "/site/content/blog/2026/first-post.md",
        "/site/content/blog//2026/./photo.jpg",
        "/site/content/drafts/../about.md",
        "/site/content/../secrets.env",
        "/site/content/notes.txt",
]
    for source in sources:
        planned := output_path(source_root, output_root, source) catch err:
            print("skip  {err}")
            continue
        print("build {path.rel(output_root, planned):<26} from {path.stem(source)}{path.ext(source)}")

    # the section a page belongs to is the first directory under the root
    post := "/site/public/blog/2026/first-post.html"
    section := path.parts(path.rel(output_root, post))[0]
    print("")
    print("{path.base(post)} is in section '{section}', directory {path.dir(post)}")
    print("absolute: {path.is_abs(post)}, joined back: {path.join_all([output_root, "blog", "2026", "first-post.html"]) == post}")
