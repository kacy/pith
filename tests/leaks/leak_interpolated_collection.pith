# a fresh collection or struct rendered into a string: a call's list, map and
# struct, and a set (shown through a fresh sorted list). each render used to
# leak the value, and a set's render the list it was shown through as well.
import leakprobe as probe

struct Point:
    x: Int
    y: Int

fn nums(n: Int) -> List[Int]:
    return [n, n + 1]

fn table(n: Int) -> Map[String, Int]:
    return {"k": n}

fn at(n: Int) -> Point:
    return Point(x: n, y: n)

fn round(i: Int) -> Int:
    s: Set[String] := {"b", "a"}
    text := "{nums(i)} {table(i)} {at(i)} {s}"
    return text.len()

fn main():
    n := probe.rounds()
    mut i := 0
    mut checksum := 0
    while i < n:
        checksum = checksum + round(i)
        i = i + 1
    if checksum == 0 - 999:
        print("impossible")
    kb := probe.peak_kb()
    print("{kb}")
