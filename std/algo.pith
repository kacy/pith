# std.algo — sorting, searching, and string comparison
#
# Pure Pith sort and search algorithms.
# For list utilities (sum, reversed, zip, etc.) see std.collections.
#
#   from std.algo import sort, sort_desc, sort_strings, binary_search, strcmp

from std.collections import reversed, reversed_strings, sorted_positions

# ===============================================================
# Sorting
# ===============================================================

# Merge sort on integers (stable, ascending)
pub fn sort(list: List[Int]) -> List[Int]:
    n := list.len()
    if n <= 1:
        return list
    mid := n / 2
    mut left: List[Int] := []
    mut right: List[Int] := []
    for item, i in list:
        if i < mid:
            left.push(item)
        else:
            right.push(item)
    left = sort(left)
    right = sort(right)
    return merge(left, right)

fn merge(a: List[Int], b: List[Int]) -> List[Int]:
    mut result: List[Int] := []
    na := a.len()
    nb := b.len()
    mut i := 0
    mut j := 0
    while i < na and j < nb:
        if a[i] <= b[j]:
            result.push(a[i])
            i = i + 1
        else:
            result.push(b[j])
            j = j + 1
    while i < na:
        result.push(a[i])
        i = i + 1
    while j < nb:
        result.push(b[j])
        j = j + 1
    return result

# Merge sort descending
pub fn sort_desc(list: List[Int]) -> List[Int]:
    sorted := sort(list)
    return reversed(sorted)

# Lexicographic string comparison. Returns -1, 0, or 1.
pub fn strcmp(a: String, b: String) -> Int:
    mut i := 0
    mut min_len := a.len()
    if b.len() < min_len:
        min_len = b.len()
    while i < min_len:
        ca := ord(a[i])
        cb := ord(b[i])
        if ca < cb:
            return -1
        if ca > cb:
            return 1
        i = i + 1
    if a.len() < b.len():
        return -1
    if a.len() > b.len():
        return 1
    return 0

# Merge sort on strings (stable, lexicographic)
pub fn sort_strings(list: List[String]) -> List[String]:
    n := list.len()
    if n <= 1:
        return list
    mid := n / 2
    mut left: List[String] := []
    mut right: List[String] := []
    for item, i in list:
        if i < mid:
            left.push(item)
        else:
            right.push(item)
    left = sort_strings(left)
    right = sort_strings(right)
    return merge_strings(left, right)

fn merge_strings(a: List[String], b: List[String]) -> List[String]:
    mut result: List[String] := []
    na := a.len()
    nb := b.len()
    mut i := 0
    mut j := 0
    while i < na and j < nb:
        if strcmp(a[i], b[j]) <= 0:
            result.push(a[i])
            i = i + 1
        else:
            result.push(b[j])
            j = j + 1
    while i < na:
        result.push(a[i])
        i = i + 1
    while j < nb:
        result.push(b[j])
        j = j + 1
    return result

# ===============================================================
# Searching
# ===============================================================

# Binary search on a sorted list. Returns index or -1.
## sort a list by a string key drawn from each element, ascending.
## ties keep their input order (the sort is stable), so sorting by a
## secondary key first gives a compound order.
##
## `key` is called exactly once per element, in input order, before any
## comparison happens; the sort then runs against the cached keys. a key
## function with side effects therefore sees each element once and no more.
## the earlier insertion sort re-read the key of every element it probed,
## which was O(n^2) calls.
##
## the sort itself is std.collections.sorted_positions, so this shares one
## merge sort with the comparator-based and integer-keyed sorts there.
## `items` is not modified.
pub fn sort_by_key[T](items: List[T], key: fn(T) -> String) -> List[T]:
    mut keys: List[String] := []
    for item in items:
        keys.push(key(item))
    order := string_key_order(keys)
    # the gather is written out here rather than calling
    # std.collections.gather_positions: a generic body cannot call a generic
    # function in another module — the specialization emits a call the compiler
    # then fails to resolve at startup. string_key_order below is the same
    # limitation worked around the other way, by putting the cross-module call
    # in a body that is not itself generic.
    mut out: List[T] := []
    for pos in order:
        out.push(items[pos])
    return out

fn string_less(left: String, right: String) -> Bool:
    return left < right

fn string_key_order(keys: List[String]) -> List[Int]:
    return sorted_positions(keys, string_less)

## sort by a string key, descending: the reverse of sort_by_key.
##
## this reverses a stable ascending sort rather than sorting on the reversed
## comparison, so elements with equal keys come out in reverse input order.
## that difference from sort_by_key is observable and is kept deliberately.
## `key` is called exactly once per element, as in sort_by_key.
pub fn sort_by_key_desc[T](items: List[T], key: fn(T) -> String) -> List[T]:
    # reverse works in place and returns nothing; returning its result
    # handed back whatever the call left in the register, which happened
    # to be the list. the body was never type-checked, so nothing said so.
    sorted := sort_by_key(items, key)
    sorted.reverse()
    return sorted

## index of a value in a sorted int list, or none when absent.
pub fn binary_search(list: List[Int], value: Int) -> Int?:
    mut lo := 0
    mut hi := list.len() - 1
    while lo <= hi:
        mid := lo + (hi - lo) / 2
        if list[mid] == value:
            return mid
        elif list[mid] < value:
            lo = mid + 1
        else:
            hi = mid - 1
    return none

test "algo sorts integers and strings":
    nums := sort([4, 1, 3, 2])
    desc := sort_desc([4, 1, 3, 2])
    names := sort_strings(["grace", "ada", "linus"])

    assert_eq(nums.len(), 4)
    assert_eq(nums[0], 1)
    assert_eq(nums[3], 4)
    assert_eq(desc.len(), 4)
    assert_eq(desc[0], 4)
    assert_eq(desc[3], 1)
    assert_eq(names.join(","), "ada,grace,linus")

struct AlgoSortItem:
    pub name: String
    pub city: String

fn algo_sort_names(items: List[AlgoSortItem]) -> String:
    mut parts: List[String] := []
    for item in items:
        parts.push(item.city)
    return parts.join(",")

test "algo sort_by_key is stable and leaves its input alone":
    # every record shares a key, so the city says which order came out.
    tied := [AlgoSortItem("same", "oslo"), AlgoSortItem("same", "lima"), AlgoSortItem("same", "kiev")]
    assert_eq(algo_sort_names(sort_by_key(tied, fn(x: AlgoSortItem) => x.name)), "oslo,lima,kiev")
    # sort_by_key_desc reverses a stable ascending sort, so equal keys come back
    # in reverse input order. that is deliberate and is checked here.
    assert_eq(algo_sort_names(sort_by_key_desc(tied, fn(x: AlgoSortItem) => x.name)), "kiev,lima,oslo")

    empty: List[AlgoSortItem] := []
    assert_eq(sort_by_key(empty, fn(x: AlgoSortItem) => x.name).len(), 0)
    one := [AlgoSortItem("solo", "rome")]
    assert_eq(algo_sort_names(sort_by_key(one, fn(x: AlgoSortItem) => x.name)), "rome")

    words := ["pear", "apple", "fig", "apple"]
    assert_eq(sort_by_key(words, fn(s: String) => s).join(","), "apple,apple,fig,pear")
    assert_eq(sort_by_key_desc(words, fn(s: String) => s).join(","), "pear,fig,apple,apple")
    assert_eq(words.join(","), "pear,apple,fig,apple")

    # a key function that captures
    suffix := "-z"
    assert_eq(sort_by_key(words, fn(s: String) => s + suffix).join(","), "apple,apple,fig,pear")

    # a size that straddles the merge widths
    mut wide: List[String] := []
    mut i := 0
    while i < 21:
        wide.push("k{(i * 5) % 21}")
        i = i + 1
    ranked := sort_by_key(wide, fn(s: String) => s)
    assert_eq(ranked.len(), 21)
    assert_eq(ranked[0], "k0")
    assert_eq(ranked[20], "k9")

test "algo compares strings lexicographically":
    assert_eq(strcmp("ada", "ada"), 0)
    assert_eq(strcmp("ada", "grace"), 0 - 1)
    assert_eq(strcmp("grace", "ada"), 1)
    assert_eq(strcmp("ada", "adam"), 0 - 1)

test "algo binary search finds sorted values":
    nums := [1, 3, 5, 7, 9]

    assert_eq(binary_search(nums, 1).unwrap_or(-1), 0)
    assert_eq(binary_search(nums, 7).unwrap_or(-1), 3)
    assert(binary_search(nums, 2) == none)
