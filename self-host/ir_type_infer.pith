from checker import c_argument_widens_to_optional, c_generic_call_subst, c_get_expr_type, c_interface_coercion, c_is_interface_value_type, collect_generic_parameter_names, decode_tid_list, generic_base_identity, get_generic_declaration_index, has_generic_declaration, struct_instance_base_name, struct_instance_tids, struct_instance_type_args
