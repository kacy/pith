# a borrowed string stored into a container keeps its own count, whatever
# spelling reaches the container and whatever spelling the value is read
# through. every value is read back after the place it came from is
# overwritten, which frees the old string unless the store took a count.
# an empty `{}` in a struct field, a list element or a map value used to
# build a map that owned none of its strings.

struct Src:
    name: String

struct Holder:
    m: Map[String, String]
    l: List[String]
    s: Set[String]

struct Defaults:
    m: Map[String, String] = {}
    l: List[String] = []
    s: Set[String] = {}

struct Outer:
    inner: Holder

struct Maybe:
    m: Map[String, String]?
    l: List[String]?
    s: Set[String]?

struct Nest:
    ms: List[Map[String, String]]
    ls: List[List[String]]
    ss: List[Set[String]]

struct NestMap:
    ms: Map[String, Map[String, String]]
    ls: Map[String, List[String]]
    ss: Map[String, Set[String]]

impl Holder:
    fn get_m() -> Map[String, String]:
        return self.m

    fn get_l() -> List[String]:
        return self.l

    fn get_s() -> Set[String]:
        return self.s

fn make_m() -> Map[String, String]:
    return {}

fn make_opt_m() -> Map[String, String]?:
    return {}

fn make_l() -> List[String]:
    return []

fn make_opt_l() -> List[String]?:
    return []

fn make_s() -> Set[String]:
    return {}

fn make_opt_s() -> Set[String]?:
    return {}

mut g_name := ""

fn heap(tag: String) -> String:
    return "{tag} value {tag.len()} on the heap"

fn local_map_insert(src: Src, other: Src, p: String):
    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: Map[String, String] := {}
    r.insert("k0", src.name)
    r.insert("k1", table["k"])
    r.insert("k2", xs[0])
    r.insert("k3", g_name)
    r.insert("k4", p)
    for v in ys:
        r.insert("k5", v)
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_map_insert")
    print(r["k0"])
    print(r["k1"])
    print(r["k2"])
    print(r["k3"])
    print(r["k4"])
    print(r["k5"])

fn local_map_index_store(src: Src, other: Src, p: String):
    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: Map[String, String] := {}
    r["k0"] = src.name
    r["k1"] = table["k"]
    r["k2"] = xs[0]
    r["k3"] = g_name
    r["k4"] = p
    for v in ys:
        r["k5"] = v
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_map_index_store")
    print(r["k0"])
    print(r["k1"])
    print(r["k2"])
    print(r["k3"])
    print(r["k4"])
    print(r["k5"])

fn local_list_push(src: Src, other: Src, p: String):
    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: List[String] := []
    r.push(src.name)
    r.push(table["k"])
    r.push(xs[0])
    r.push(g_name)
    r.push(p)
    for v in ys:
        r.push(v)
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_list_push")
    for got in r:
        print(got)

fn local_list_insert(src: Src, other: Src, p: String):
    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: List[String] := []
    r.insert(0, src.name)
    r.insert(0, table["k"])
    r.insert(0, xs[0])
    r.insert(0, g_name)
    r.insert(0, p)
    for v in ys:
        r.insert(0, v)
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_list_insert")
    for got in r:
        print(got)

fn local_list_index_store(src: Src, other: Src, p: String):
    mut table: Map[String, String] := {"k": heap("map_index")}
    mut xs: List[String] := [heap("list_index")]
    mut ys: List[String] := [heap("for_var")]
    g_name = heap("global")
    mut r: List[String] := []
    for _ in 0..6:
        r.push("seed")
    r[0] = src.name
    r[1] = table["k"]
    r[2] = xs[0]
    r[3] = g_name
    r[4] = p
    for v in ys:
        r[5] = v
    src.name = heap("gone")
    table["k"] = heap("gone")
    xs[0] = heap("gone")
    g_name = heap("gone")
    other.name = heap("gone")
    ys[0] = heap("gone")
    print("local_list_index_store")
    for got in r:
        print(got)

