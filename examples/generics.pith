# generic structs and enums

struct Pair[A, B]:
    pub first: A
    pub second: B

struct Box[T]:
    pub value: T

enum Option[T]:
    Some(T)
    None

enum Either[L, R]:
    Left(L)
    Right(R)

# generic types are instantiated with concrete type arguments.
# each unique combination produces a separate concrete type.

fn show_pair(p: Pair[Int, String]) -> String:
    return "({p.first}, {p.second})"

fn show_box(b: Box[Float]) -> String:
    return "box of {b.value}"

# generic functions — type args are inferred from call-site arguments.
# no need to write identity[Int](42), just identity(42).

fn identity[T](x: T) -> T:
    return x

fn second[A, B](x: A, y: B) -> B:
    return y

# interface bounds constrain which types can be used as type arguments.
# fn show[T: Display](x: T) means T must implement Display.

interface Display:
    fn show(x: String) -> String

interface Hash:
    fn hash(x: String) -> Int

struct Point:
    pub x: Int
    pub y: Int

impl Display for Point:
    fn show(x: String) -> String:
        return "point"

impl Hash for Point:
    fn hash(x: String) -> Int:
        return 0

# bounded generic function — T must implement Display
fn show[T: Display](x: T) -> String:
    return "shown"

# multiple bounds — T must implement both Display and Hash
fn show_and_hash[T: Display + Hash](x: T) -> String:
    return "shown and hashed"

# bounded generic struct — T must implement Display
struct Wrapper[T: Display]:
    pub value: T

# a generic function can take an optional parameter alongside its type
# parameter. every call site shares one specialization, and each reads the
# optional from the declaration, so a literal `none` and a real `Int?` at
# different call sites both answer correctly.
fn label[T](tag: T, count: Int?) -> String:
    if count == none:
        return "{tag}: unknown"
    return "{tag}: {count.unwrap_or(0)}"

fn main():
    p: Pair[Int, String] := Pair(1, "hello")
    b: Box[Float] := Box(3.14)
    print("pair {show_pair(p)}")
    print("{show_box(b)}")

    # generic function calls — T is inferred from the arguments
    print("identity int {identity(42)}")
    print("identity str {identity("hello")}")
    print("second {second(1, "world")}")

    # bounded generic calls — Point implements Display and Hash
    pt := Point(1, 2)
    print("{show(pt)}")
    print("{show_and_hash(pt)}")

    # named fields work on generic structs too — the type arguments are
    # inferred from the values, in any field order
    named := Pair(second: "answer", first: 42)
    print("named {show_pair(named)}")

    # an optional parameter of a generic function, written both ways
    total: Int? := 7
    print(label("apples", none))
    print(label("pears", total))

    # a generic enum constructs and matches like any other enum. a payload
    # argument infers the instance; a payload-free variant takes it from
    # the binding's annotation.
    found := Option.Some(3)
    match found:
        Option.Some(n) => print("found {n}")
        Option.None => print("found nothing")
    missing: Option[Int] := Option.None
    match missing:
        Option.Some(n) => print("missing? {n}")
        Option.None => print("missing")

    # bounds have two spellings that mean the same thing: inline
    # ([T: Sized]) and a where clause after the signature. the clause
    # reads better once a function has several parameters or several
    # bounds per parameter.
    print(wingspan(Wing(feathers: 9)))

    # a method may declare type parameters of its own, separate from any the
    # type has. each call site infers them from its arguments and gets its own
    # specialization, the same as a call to a free generic function.
    ledger := Ledger(name: "log")
    print(ledger.note(12))
    print(ledger.note("open"))
    print(ledger.measure(Wing(feathers: 4)))

    # the type arguments can be written at the call instead, ahead of the
    # parentheses. that is the only way to fix a parameter that appears in
    # no argument, like the one `blank` only returns.
    print(ledger.note[Int](13))
    missing_count := ledger.blank[Int]()
    if missing_count == none:
        print("blank: nothing")

    # a generic type's methods may carry type parameters of their own as
    # well. the type's parameters are fixed by the receiver's instance and
    # the method's by the call, and each combination is its own
    # specialization: Box[Float].map to a String here, to an Int below.
    label := fn(v: Float) -> String:
        return "about {v}"
    boxed_label := b.map(label)
    print(boxed_label.value)
    floor := fn(v: Float) -> Int:
        return v.to_int()
    boxed_floor := b.map(floor)
    print("floor {boxed_floor.value}")

struct Wing:
    pub feathers: Int

interface Sized:
    fn size() -> Int

impl Sized for Wing:
    fn size() -> Int:
        return self.feathers

fn wingspan[T](v: T) -> String where T: Sized:
    return "spans {v.size()}"

struct Ledger:
    pub name: String

impl Ledger:
    # T is fixed by the argument at each call site
    fn note[T](value: T) -> String:
        return self.name + ": " + value.to_string()

    # a bound on the method's own type parameter, in the clause spelling
    fn measure[T](v: T) -> String where T: Sized:
        return self.name + " spans " + v.size().to_string()

    # T appears in no argument, so a call has to write it: blank[Int]()
    fn blank[T]() -> T?:
        return none

impl Box:
    # U is fixed by the function passed in; T by the box it is called on
    fn map[U](f: fn(T) -> U) -> Box[U]:
        return Box(f(self.value))
