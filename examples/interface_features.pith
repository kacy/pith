# interfaces: associated types and default methods.
#
# reads two kinds of building sensor. `type Reading` is an associated type:
# each impl says what its sensor returns, a Float for a thermometer and a
# Bool for a door contact, so one interface method has a different result
# type per impl. a method with a body is a default: an impl inherits it
# unless it writes its own, and the default can call the other methods on
# self.

interface Sensor:
    type Reading
    fn read() -> Reading
    fn location() -> String
    fn summary() -> String:
        return "sensor in {self.location()}"

struct Thermometer:
    room: String
    celsius: Float

struct DoorContact:
    door: String
    is_open: Bool

# binds Reading to Float and keeps the default summary
impl Sensor for Thermometer:
    type Reading = Float
    fn read() -> Reading:
        return self.celsius
    fn location() -> String:
        return self.room

# binds Reading to Bool and writes its own summary
impl Sensor for DoorContact:
    type Reading = Bool
    fn read() -> Reading:
        return self.is_open
    fn location() -> String:
        return "{self.door} door"
    fn summary() -> String:
        state := if self.is_open: "open" else: "closed"
        return "{self.door} door is {state}"

fn main():
    lab := Thermometer(room: "lab", celsius: 22.5)
    server_room := Thermometer(room: "server room", celsius: 31.0)
    loading_dock := DoorContact(door: "loading dock", is_open: true)

    # read() is a Float here, so it compares with a Float
    for thermometer in [lab, server_room]:
        too_warm := thermometer.read() > 27.0
        print("{thermometer.summary()}: {thermometer.read():.1} C, too warm: {too_warm}")

    # and a Bool here, so it goes straight into an if
    if loading_dock.read():
        print("alert: {loading_dock.summary()}")
