# ir_generics.pith - generic function metadata helpers

from ast import get_node, Node
from ir_names import ir_import_target_name
from ir_type_helpers import ir_resolve_type_hint_with_state, ir_resolve_result_type_kind, ir_type_from_tid
from types import get_type_info, get_type_name
from ir_method_tables import ir_func_returns
from ir_utils import ir_push_string

## true for any function-declaration node kind.
pub fn ir_is_fn_decl_kind(kind: String) -> Bool:
    return kind == "fn" or kind == "fn_decl"

## true when the declaration carries generic parameters.
pub fn ir_has_generic_params(node: Node) -> Bool:
    for child in node.children:
        if get_node(child).kind == "generic_param":
            return true
    return false

## the declaration's generic parameter names, in order.
pub fn ir_collect_generic_param_names(node: Node) -> List[String]:
    mut names: List[String] := []
    mut i := 0
    while i < node.children.len():
        child := get_node(node.children[i])
        if child.kind == "generic_param":
            names.push(child.value)
        i = i + 1
    return names

## the n-th parameter name of a function node, or "".
pub fn ir_param_name_at(fn_idx: Int, param_index: Int) -> String:
    node := get_node(fn_idx)
    mut seen := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if seen == param_index:
                return cn.value
            seen = seen + 1
    return ""

## prefer a name that names a generic declaration.
pub fn ir_generic_preferred_name_with_state(preferred: String, fallback: String, generic_decl_indices: Map[String, Int]) -> String:
    if generic_decl_indices.contains_key(preferred):
        return preferred
    return fallback

## the generic json decode helper name for a type, or "".
pub fn ir_json_generic_name_with_state(base_name: String, generic_decl_indices: Map[String, Int]) -> String:
    return ir_generic_preferred_name_with_state("std_json_" + base_name, base_name, generic_decl_indices)

## the generic config decode helper name for a type, or "".
pub fn ir_config_generic_name_with_state(base_name: String, generic_decl_indices: Map[String, Int]) -> String:
    return ir_generic_preferred_name_with_state("std_config_" + base_name, base_name, generic_decl_indices)

## resolve alias.generic_fn() to its qualified name, or "".
pub fn ir_resolve_generic_module_call_name(module_path: String, member_name: String) -> String:
    if module_path.len() > 0:
        return ir_import_target_name(module_path, member_name)
    return member_name

## the generic handle-pool decode helper name for a type, or "".
pub fn ir_handle_generic_name_with_state(base_name: String, module_path: String, generic_decl_indices: Map[String, Int]) -> String:
    preferred := ir_resolve_generic_module_call_name(module_path, base_name)
    return ir_generic_preferred_name_with_state(preferred, base_name, generic_decl_indices)

## pack type names into one string for storage.
pub fn ir_encode_type_list(type_names: List[String]) -> String:
    return type_names.join(chr(9))

## unpack a stored type-name list.
pub fn ir_decode_type_list(encoded: String) -> List[String]:
    if encoded.len() == 0:
        return []
    return encoded.split(chr(9))

## the dedupe key for one specialization request.
pub fn ir_generic_specialization_key(name: String, type_names: List[String]) -> String:
    return name + chr(9) + ir_encode_type_list(type_names)

fn ir_sanitize_symbol_part(name: String) -> String:
    mut out := ""
    mut i := 0
    while i < name.len():
        ch := name[i]
        if ch == "[" or ch == "]" or ch == "," or ch == " " or ch == "." or ch == ":":
            out = out + "_"
        else:
            out = out + ch
        i = i + 1
    return out

## the emitted symbol name for one specialization.
pub fn ir_generic_specialization_name(name: String, type_names: List[String]) -> String:
    mut suffix_parts: List[String] := []
    for type_name in type_names:
        suffix_parts.push(ir_sanitize_symbol_part(type_name))
    return name + "__" + suffix_parts.join("_")

## substitute generic parameters in a type name.
pub fn ir_specialize_type_name_with_state(name: String, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    for generic_param, i in generic_params:
        if i < concrete_types.len() and generic_param == name:
            return concrete_types[i]
    return ir_resolve_type_hint_with_state(name, type_aliases, struct_names)

## resolve a type node under a generic substitution.
pub fn ir_resolve_type_node_with_subst_with_state(type_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    tn := get_node(type_idx)
    if tn.kind == "type":
        return ir_resolve_type_hint_with_state(ir_specialize_type_name_with_state(tn.value, generic_params, concrete_types, type_aliases, struct_names), type_aliases, struct_names)
    if tn.kind == "generic_type":
        if tn.value == "List":
            if tn.children.len() > 0:
                inner := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if inner == "string":
                    return "list_string"
            return "list"
        if tn.value == "Map":
            if tn.children.len() > 0:
                key_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if key_type == "int":
                    return "map_int"
            return "map"
        if tn.value == "Set":
            if tn.children.len() > 0:
                elem_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
                if elem_type == "int":
                    return "set_int"
            return "set"
        return ir_resolve_type_hint_with_state(tn.value, type_aliases, struct_names)
    # an explicit type argument written at a call site is parsed as an
    # expression, so `Holder[List[Int]]([1, 2])` hands its argument over as an
    # ident, an index or an unwrap rather than as a type node. the rules are
    # the ones above; only the shape differs. without these the argument
    # resolved to "", the instance was built over a kind nothing matched, and
    # the field read guessed.
    if tn.kind == "ident":
        return ir_resolve_type_hint_with_state(ir_specialize_type_name_with_state(tn.value, generic_params, concrete_types, type_aliases, struct_names), type_aliases, struct_names)
    if tn.kind == "index" and tn.children.len() > 1:
        base := get_node(tn.children[0])
        if base.kind != "ident":
            return ""
        if base.value == "List":
            inner := ir_resolve_type_node_with_subst_with_state(tn.children[1], generic_params, concrete_types, type_aliases, struct_names)
            if inner == "string":
                return "list_string"
            return "list"
        if base.value == "Map":
            key_type := ir_resolve_type_node_with_subst_with_state(tn.children[1], generic_params, concrete_types, type_aliases, struct_names)
            if key_type == "int":
                return "map_int"
            return "map"
        if base.value == "Set":
            elem_type := ir_resolve_type_node_with_subst_with_state(tn.children[1], generic_params, concrete_types, type_aliases, struct_names)
            if elem_type == "int":
                return "set_int"
            return "set"
        return ir_resolve_type_hint_with_state(base.value, type_aliases, struct_names)
    if tn.kind == "unwrap":
        return "tuple"
    # a pair written at a call site is a tuple expression node, as `(Int,
    # String)?` above is an unwrap over one; it used to resolve to "", so a
    # channel over a bare pair tagged its payload as nothing and freed none
    # of it
    if tn.kind == "tuple":
        return "tuple"
    if tn.kind == "grouped" and tn.children.len() == 1:
        return ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
    if tn.kind == "result_type" and tn.children.len() > 0:
        inner_type := ir_resolve_type_node_with_subst_with_state(tn.children[0], generic_params, concrete_types, type_aliases, struct_names)
        return ir_resolve_result_type_kind(inner_type)
    if tn.kind == "optional_type" and tn.children.len() > 0:
        return "tuple"
    if tn.kind == "fn_type":
        return "closure"
    if tn.kind == "tuple_type":
        return "tuple"
    return ""

## a function node's return type under substitution.
pub fn ir_extract_return_type_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "type" or rn.kind == "generic_type" or rn.kind == "result_type" or rn.kind == "optional_type":
                    return ir_resolve_type_node_with_subst_with_state(returns_child, generic_params, concrete_types, type_aliases, struct_names)
    return "unknown"

## the inner type of an optional return under substitution.
pub fn ir_extract_optional_inner_type_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> String:
    node := get_node(fn_idx)
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            for returns_child in cn.children:
                rn := get_node(returns_child)
                if rn.kind == "optional_type" and rn.children.len() > 0:
                    return ir_resolve_type_node_with_subst_with_state(rn.children[0], generic_params, concrete_types, type_aliases, struct_names)
    return ""

## parameter type names under a generic substitution.
pub fn ir_extract_param_types_with_subst_with_state(fn_idx: Int, generic_params: List[String], concrete_types: List[String], type_aliases: Map[String, String], struct_names: Map[String, Int]) -> List[String]:
    node := get_node(fn_idx)
    mut param_types: List[String] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                param_types.push(ir_resolve_type_node_with_subst_with_state(cn.children[0], generic_params, concrete_types, type_aliases, struct_names))
            else:
                param_types.push("")
    return param_types

# the generic instantiation registry: which generic declarations
# exist (by module-qualified name), and which specializations have
# been requested, named, and emitted.
pub mut ir_generic_decl_indices: Map[String, Int] := {}
pub mut ir_generic_decl_module_paths: Map[String, String] := {}
pub mut ir_generic_specialization_keys: List[String] := []
pub mut ir_generic_specialization_names: Map[String, String] := {}
pub mut ir_generic_specialization_type_lists: Map[String, String] := {}
pub mut ir_generic_emitted_specializations: Map[String, Int] := {}
## Per-spec arg-tid list encoded as tab-joined ints. Populated on demand at
## call sites where the arg tids are structurally richer than the
## emission-kind concrete_types list. Used by the emitter to recover the
## concrete Optional tid inside a specialization body (concrete_types
## flattens Optional to "tuple").
## The impl target of every generic declaration that is a method rather than a
## free function, keyed by the same symbol name ir_generic_decl_indices uses.
## A method's specialization takes a leading self parameter and emits inside
## its impl's context; nothing else about it differs from a free function's.
pub mut ir_generic_method_owners: Map[String, String] := {}
## How many type parameters the owner of each generic method declares, keyed
## like ir_generic_method_owners; absent or 0 for a concrete owner. On a
## generic owner a specialization's type arguments are the receiver
## instance's followed by the method's own, and this count is where the two
## lists meet.
pub mut ir_generic_method_owner_param_counts: Map[String, Int] := {}

## file a generic declaration under its module-qualified name.
pub fn ir_record_generic_function_decl(item_idx: Int, node: Node, module_path: String):
    mut full_name := node.value
    if module_path.len() > 0:
        full_name = ir_import_target_name(module_path, node.value)
    ir_generic_decl_indices.insert(full_name, item_idx)
    ir_generic_decl_module_paths.insert(full_name, module_path)

## true when the name is a recorded generic declaration.
pub fn ir_is_generic_function_name(name: String) -> Bool:
    return ir_generic_decl_indices.contains_key(name)

## file a generic impl method under the symbol dispatch resolves it to.
## `owner_param_count` is how many type parameters the impl target declares:
## 0 for a concrete owner.
pub fn ir_record_generic_method_decl(method_idx: Int, full_name: String, impl_type: String, module_path: String, owner_param_count: Int):
    ir_generic_decl_indices.insert(full_name, method_idx)
    ir_generic_decl_module_paths.insert(full_name, module_path)
    ir_generic_method_owners.insert(full_name, impl_type)
    ir_generic_method_owner_param_counts.insert(full_name, owner_param_count)

## how many of a generic declaration's type arguments belong to its owner's
## instance: the owner's parameter count for a method on a generic struct,
## 0 for a free function or a method on a concrete owner.
pub fn ir_generic_owner_param_count(name: String) -> Int:
    if ir_generic_method_owner_param_counts.contains_key(name):
        return ir_generic_method_owner_param_counts[name]
    return 0

## true when the name is a recorded generic impl method.
pub fn ir_is_generic_method_name(name: String) -> Bool:
    return ir_generic_method_owners.contains_key(name)

## prefer a name that names a generic declaration.
pub fn ir_generic_preferred_name(preferred: String, fallback: String) -> String:
    return ir_generic_preferred_name_with_state(preferred, fallback, ir_generic_decl_indices)

## every specialization symbol emitted so far, mapped to the key that first
## requested it. a body can be requested by the checker's type arguments
## (ir_queue_generic_specialization_for_tids) and, from a site that has no
## call node such as a decode target, by emission kinds; for primitives,
## structs and enums both spell the same symbol, and without this map the
## drain emitted that function twice.
pub mut ir_generic_specialization_by_symbol: Map[String, String] := {}

## request a specialization; names it and records its types once.
pub fn ir_queue_generic_specialization(name: String, arg_types: List[String], ret_type: String) -> String:
    key := ir_generic_specialization_key(name, arg_types)
    if ir_generic_specialization_names.contains_key(key):
        return ir_generic_specialization_names[key]
    spec_name := ir_generic_specialization_name(name, arg_types)
    if ir_generic_specialization_by_symbol.contains_key(spec_name):
        return spec_name
    ir_generic_specialization_by_symbol.insert(spec_name, key)
    ir_generic_specialization_keys = ir_push_string(ir_generic_specialization_keys, key)
    ir_generic_specialization_names.insert(key, spec_name)
    ir_generic_specialization_type_lists.insert(key, ir_encode_type_list(arg_types))
    ir_func_returns.insert(spec_name, ret_type)
    return spec_name

## the checker's type arguments for each specialization key, comma-encoded:
## the tids `T`, `U`, ... take in that specialization, as the checker settled
## them at the call node that first asked for it (c_generic_call_subst).
## these are type-parameter tids, not argument tids; a tid-keyed request
## records them at queue time, and the emitter hands them to
## c_check_specialization just before it emits the body. a kind-keyed request
## (a decode target, or a call the checker left without a record) has none,
## and its body is emitted without the re-check, as before.
pub mut ir_generic_specialization_subst_tids: Map[String, String] := {}

## the symbol spelling of one type argument. primitives, structs and enums
## keep the emission kind that named specializations before (`int`,
## `string`, `Holder`), so their symbols do not move; a composite spells its
## structure, because the emission kind collapses every optional and result
## to "tuple" and every list to "list", and two type-argument lists that
## differ only there must not share a body. two type ids with the same
## spelling denote the same type (optional and tuple types are not interned),
## so the spelling is also the dedupe identity. a kind the map does not
## cover carries its type id, which keeps distinct types distinct.
pub fn ir_tid_symbol_spelling(tid: Int) -> String:
    if tid < 0:
        return "unknown"
    info := get_type_info(tid)
    if info.kind == "optional":
        return "opt_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "result":
        if info.value_type >= 0:
            return "res_" + ir_tid_symbol_spelling(info.inner) + "_" + ir_tid_symbol_spelling(info.value_type)
        return "res_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "tuple":
        mut parts: List[String] := []
        for element in info.elements:
            parts.push(ir_tid_symbol_spelling(element))
        return "tup_" + parts.join("_") + "_end"
    if info.kind == "list":
        return "list_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "set":
        return "set_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "map":
        return "map_" + ir_tid_symbol_spelling(info.key_type) + "_" + ir_tid_symbol_spelling(info.value_type)
    if info.kind == "task":
        return "task_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "channel":
        return "chan_" + ir_tid_symbol_spelling(info.inner)
    if info.kind == "function":
        mut parts: List[String] := []
        for param in info.param_types:
            parts.push(ir_tid_symbol_spelling(param))
        return "fn_" + parts.join("_") + "_r_" + ir_tid_symbol_spelling(info.return_type)
    # an enum spells its name even when it lowers to an int (no payload
    # variant): two enums are two types, and each module emits the
    # specializations its own code requests, so a shared spelling would put
    # the same symbol into two module sections.
    if info.kind == "enum":
        return ir_sanitize_symbol_part(info.name)
    kind := ir_type_from_tid(tid)
    if kind.len() > 0:
        return ir_sanitize_symbol_part(kind)
    return ir_sanitize_symbol_part(get_type_name(tid)) + "_t" + tid.to_string()

## request a specialization by the checker's type arguments: the key and the
## symbol come from the spellings, the emission kinds for the substitution
## from the type ids, and the ids themselves are recorded for the re-check
## the emitter runs before the body is emitted.
pub fn ir_queue_generic_specialization_for_tids(name: String, tids: List[Int], ret_type: String) -> String:
    mut spellings: List[String] := []
    mut kinds: List[String] := []
    for tid in tids:
        spellings.push(ir_tid_symbol_spelling(tid))
        mut kind := ir_type_from_tid(tid)
        if kind.len() == 0:
            kind = "unknown"
        kinds.push(kind)
    key := name + chr(9) + "tids" + chr(9) + spellings.join(chr(9))
    if ir_generic_specialization_names.contains_key(key):
        return ir_generic_specialization_names[key]
    spec_name := ir_generic_specialization_symbol(name, spellings)
    if ir_generic_specialization_by_symbol.contains_key(spec_name):
        return spec_name
    ir_generic_specialization_by_symbol.insert(spec_name, key)
    ir_generic_specialization_keys = ir_push_string(ir_generic_specialization_keys, key)
    ir_generic_specialization_names.insert(key, spec_name)
    ir_generic_specialization_type_lists.insert(key, ir_encode_type_list(kinds))
    mut parts: List[String] := []
    for tid in tids:
        parts.push(tid.to_string())
    ir_generic_specialization_subst_tids.insert(key, parts.join(","))
    ir_func_returns.insert(spec_name, ret_type)
    return spec_name

## the symbol of one specialization from its type-argument spellings. a free
## function or a method on a concrete owner appends its arguments after a
## double underscore (`first__int`, `Sink_echo__string`). a method on a
## generic owner spells the owner's instance arguments where the
## per-instance copies of its plain methods spell theirs, between the owner
## and the method name, and its own after the method name as every
## specialization does: `Box_int_map__string` is `Box[Int].map[String]`,
## beside `Box_int_describe` for the plain `Box[Int].describe`. the two
## lists never mix, so the symbol reads back as the pair it was built from.
fn ir_generic_specialization_symbol(name: String, spellings: List[String]) -> String:
    owner_count := ir_generic_owner_param_count(name)
    if owner_count == 0 or owner_count >= spellings.len():
        return name + "__" + spellings.join("_")
    method_name := get_node(ir_generic_decl_indices[name]).value
    owner_symbol := name.substring(0, name.len() - method_name.len() - 1)
    mut owner_part: List[String] := []
    mut method_part: List[String] := []
    for spelling, i in spellings:
        if i < owner_count:
            owner_part.push(spelling)
        else:
            method_part.push(spelling)
    return owner_symbol + "_" + owner_part.join("_") + "_" + method_name + "__" + method_part.join("_")

## the checker's type arguments recorded for a spec key, or an empty list.
pub fn ir_decode_generic_spec_subst_tids(key: String) -> List[Int]:
    result: List[Int] := []
    if not ir_generic_specialization_subst_tids.contains_key(key):
        return result
    encoded := ir_generic_specialization_subst_tids[key]
    if encoded.len() == 0:
        return result
    for part in encoded.split(","):
        mut val := 0
        mut neg := false
        mut i := 0
        if part.len() > 0 and part[0] == "-":
            neg = true
            i = 1
        while i < part.len():
            c := part[i]
            if c >= "0" and c <= "9":
                val = val * 10 + (ord(c) - 48)
            i = i + 1
        if neg:
            val = 0 - val
        result.push(val)
    return result
