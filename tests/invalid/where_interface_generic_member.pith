# a where clause on an interface member PARSES (the clause is not a parse
# error), but generic interface members themselves are not supported yet:
# the member's type parameter is unknown in the body. E202 here proves the
# clause made it through the parser — a grammar regression would surface
# as E240 instead.
interface Sized:
    fn tagged_by[U](u: U) -> Int where U: Tag

interface Tag:
    fn tag() -> Int

struct Point:
    pub x: Int

impl Sized for Point:
    fn tagged_by[U](u: U) -> Int where U: Tag:
        return u.tag() + self.x

fn main():
    print(Point(x: 1).tagged_by(Point(x: 2)))
