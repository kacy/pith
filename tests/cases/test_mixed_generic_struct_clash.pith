# a generic struct and a plain struct with the same name in two modules. a
# method call on either used to run the body from whichever module was
# imported last, with no diagnostic. each value must dispatch to its own
# module's methods, in either import order.
import clash_mixed_generic as g
import clash_mixed_plain as p

fn main():
    a := g.make(3)
    print(a.tag())
    b := p.make(4)
    print(b.tag())
    c := g.make("s")
    print(c.tag())
    d := p.Pod(9)
    print(d.tag())
    e := g.Pod[Int](1)
    print(e.tag())
