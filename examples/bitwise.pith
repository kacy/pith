# bitwise operations: masks, flags and packed fields.
#
# works with three things that are usually stored as bits: unix file
# permissions, colors packed into one integer, and the ascii case bit. the
# operations are the builtins bit_and, bit_or, bit_xor, bit_not, bit_shl and
# bit_shr; std.fmt prints a number in octal, hex or binary.

import std.fmt as fmt

READ := 4
WRITE := 2
EXECUTE := 1

# "rwxr-x---" to its numeric mode, three bits per group of three letters
fn parse_mode(text: String) -> Int:
    mut mode := 0
    for character in text:
        mode = bit_shl(mode, 1)
        if character != "-":
            mode = bit_or(mode, 1)
    return mode

# the permission bits for one class: 0 for owner, 1 for group, 2 for others
fn class_bits(mode: Int, class_index: Int) -> Int:
    return bit_and(bit_shr(mode, 3 * (2 - class_index)), 7)

fn can(mode: Int, class_index: Int, permission: Int) -> Bool:
    return bit_and(class_bits(mode, class_index), permission) != 0

fn pack_rgb(red: Int, green: Int, blue: Int) -> Int:
    return bit_or(bit_or(bit_shl(red, 16), bit_shl(green, 8)), blue)

fn channel(color: Int, shift: Int) -> Int:
    return bit_and(bit_shr(color, shift), 255)

# ascii upper and lower case letters differ only in bit 5 (value 32)
fn swap_case(text: String) -> String:
    mut swapped := ""
    for character in text:
        if (character >= "a" and character <= "z") or (character >= "A" and character <= "Z"):
            swapped = swapped + chr(bit_xor(ord(character), 32))
        else:
            swapped = swapped + character
    return swapped

fn main():
    mode := parse_mode("rwxr-x---")
    print("rwxr-x--- is mode {fmt.oct(mode)} ({fmt.bin(mode)})")
    print("group can read: {can(mode, 1, READ)}, others can read: {can(mode, 2, READ)}")

    # set a bit with or (others get read), clear bits with and-not (owner
    # loses write and execute)
    shared := bit_or(mode, READ)
    locked := bit_and(shared, bit_not(bit_shl(WRITE + EXECUTE, 6)))
    print("after sharing: {fmt.oct(shared)}, after locking the owner: {fmt.oct(locked)}")

    teal := pack_rgb(0, 128, 128)
    print("teal is 0x{fmt.hex(teal)}: red {channel(teal, 16)}, green {channel(teal, 8)}, blue {channel(teal, 0)}")

    print(swap_case("Hello, Pith 2"))
