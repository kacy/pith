# ir_metadata.pith — static IR lowering metadata

FLOAT_RETURNING_FUNCS := "pow,sqrt,floor,ceil,round,to_float,get_float,float_from_bits"
BOOL_RETURNING_FUNCS := "term_is_tty,term_raw_enter,term_restore,file_exists,dir_exists,fs_remove_dir,fs_remove_tree,os_chdir,os_set_env,os_unset_env,get_bool,object_has,has,crypto_constant_time_eq,crypto_verify_ed25519,crypto_verify_ecdsa_p256_sha256_asn1,crypto_verify_ecdsa_p384_sha384_asn1,crypto_verify_rsa_pkcs1_sha256,crypto_verify_rsa_pkcs1_sha384,crypto_verify_rsa_pss_sha384,crypto_verify_rsa_pss_sha512,crypto_verify_rsa_pkcs1_sha512,crypto_verify_rsa_pss_sha256,byte_buffer_set"
INT_RETURNING_FUNCS := "term_size,term_write,abs,min,max,clamp,len,fnv1a,ord,exec,fs_file_size,byte_buffer_len,byte_buffer_get,crypto_x25519_keygen,crypto_p256_keygen,os_pid,signal_notify,signal_wait,signal_raise,tcp_shutdown,UInt,Int8,Int16,Int32,Int64,UInt8,UInt16,UInt32,UInt64,float_to_bits"
STRING_RETURNING_FUNCS := "sha256,hex_encode,hex_decode,to_hex,b64_encode,chr,read_file,env,os_getcwd,os_temp_dir,os_home_dir,os_cert_roots_pem,scheme,host,query,fragment,decode,exec_output,type_of,get_string"
BYTES_RETURNING_FUNCS := "term_read,bytes_from_string_utf8,read_file_bytes,file_read_bytes,tcp_read_bytes,process_read_bytes,process_read_err_bytes,byte_buffer_bytes,b64_decode,from_hex,bytes_slice,bytes_concat,secure_random_bytes,crypto_x25519_public_key,crypto_x25519_shared_secret,crypto_aes_128_gcm_seal,crypto_aes_128_gcm_open,crypto_aes_256_gcm_seal,crypto_aes_256_gcm_open,crypto_chacha20_poly1305_seal,crypto_chacha20_poly1305_open,crypto_sign_rsa_pss_sha256_pkcs8,crypto_sign_rsa_pkcs1_sha256_pkcs8,crypto_sign_ed25519_pkcs8,crypto_sign_ecdsa_p256_sha256_pkcs8,crypto_sign_ecdsa_p256_sha256_asn1_pkcs8,crypto_sign_rsa_pss_sha384_pkcs8,crypto_sign_rsa_pss_sha512_pkcs8,crypto_sign_rsa_pkcs1_sha384_pkcs8,crypto_sign_rsa_pkcs1_sha512_pkcs8,crypto_sign_ecdsa_p384_sha384_asn1_pkcs8,crypto_blake2b,crypto_argon2id,zstd_compress,zstd_decompress"
LIST_RETURNING_FUNCS := "args,range,repeat_val,zeros,sort,sort_desc,reversed,take,drop,slice,unique,without,intersection,difference,flatten,chunks"
LIST_STRING_RETURNING_FUNCS := "sort_strings,zip,enumerate,toml_keys"
BOOL_RETURNING_METHODS := "contains,starts_with,ends_with,is_empty,string_contains,string_is_empty,contains_key,map_contains_key,map_contains_ikey,map_is_empty,set_contains,set_contains_int,set_is_empty,send,try_send,close,is_closed,is_done"
VOID_METHODS := "reverse,clear,push,remove,insert,add,list_remove,list_clear,list_reverse,map_insert,map_insert_ikey,map_remove,map_remove_ikey,map_clear,set_add,set_add_int,set_remove,set_remove_int,set_clear,detach,lock,unlock,done,wait,acquire,release,store"
STRING_RETURNING_METHODS := "trim,substring,to_upper,to_lower,reverse,replace,repeat,pad_left,pad_right,char_at,join,list_join,list_join_int,read_file,env,chr"

# fallible builtins, grouped by how the ir carries their result (see the result
# encoding in docs/ir-contract.md). parse_int and parse_float keep their own
# legacy retkinds and are handled directly in ir_builtin_result_retkind.
RESULT_INT_FUNCS := "file_open_read,file_open_write,file_open_append,byte_buffer_write,byte_buffer_write_string_utf8,byte_buffer_write_byte,file_write,file_write_bytes,tcp_connect,tcp_listen,tcp_accept,tcp_write,tcp_write_bytes,process_spawn,process_spawn_argv,process_output_argv,process_write,process_write_bytes,crypto_x25519_keygen,crypto_p256_keygen"
RESULT_BOOL_FUNCS := "write_file,append_file,write_file_bytes,append_file_bytes"
RESULT_STRING_FUNCS := "read_file,exec_output,dns_resolve,bytes_to_string_utf8,bytes_substring_utf8,file_read,tcp_read,process_read,process_read_err"
RESULT_BYTES_FUNCS := "term_read,read_file_bytes,b64_decode,from_hex,file_read_bytes,tcp_read_bytes,process_read_bytes,process_read_err_bytes,crypto_x25519_public_key,crypto_x25519_shared_secret,crypto_aes_128_gcm_seal,crypto_aes_128_gcm_open,crypto_aes_256_gcm_seal,crypto_aes_256_gcm_open,crypto_chacha20_poly1305_seal,crypto_chacha20_poly1305_open,crypto_sign_rsa_pss_sha256_pkcs8,crypto_sign_rsa_pkcs1_sha256_pkcs8,crypto_sign_ed25519_pkcs8,crypto_sign_ecdsa_p256_sha256_pkcs8,crypto_sign_ecdsa_p256_sha256_asn1_pkcs8,crypto_sign_rsa_pss_sha384_pkcs8,crypto_sign_rsa_pss_sha512_pkcs8,crypto_sign_rsa_pkcs1_sha384_pkcs8,crypto_sign_rsa_pkcs1_sha512_pkcs8,crypto_sign_ecdsa_p384_sha384_asn1_pkcs8,crypto_blake2b,crypto_argon2id,zstd_compress,zstd_decompress"

fn ir_csv_contains(csv: String, name: String) -> Bool:
    if name.len() == 0:
        return false
    items := csv.split(",")
    for item in items:
        if item == name:
            return true
    return false

# the builtins the emitter types as returning a float. this table and the
# six below stand in for the declarations a builtin never has: ir_infer_type
# falls back to them when the checker supplied no type for the call. a name
# in none of them types as "", i.e. unknown.
pub fn ir_is_float_returning_func(fname: String) -> Bool:
    return ir_csv_contains(FLOAT_RETURNING_FUNCS, fname)

# the builtins the emitter types as returning a bool. several are
# did-it-work calls (os_set_env, fs_remove_tree, the crypto verifiers):
# they report failure as a plain false and are absent from
# RESULT_BOOL_FUNCS, so nothing here goes through the result abi.
pub fn ir_is_bool_returning_func(fname: String) -> Bool:
    return ir_csv_contains(BOOL_RETURNING_FUNCS, fname)

# the builtins the emitter types as returning an int. the fixed-width
# conversions (Int8 through UInt64, float_to_bits) live here too: the ir
# has no narrower integer type, so they are ordinary int-returning calls.
pub fn ir_is_int_returning_func(fname: String) -> Bool:
    return ir_csv_contains(INT_RETURNING_FUNCS, fname)

# the builtins the emitter types as returning a string. a few names are
# also in RESULT_STRING_FUNCS (read_file, exec_output); those two tables do
# different jobs — the fallible one decides how the result is carried, this
# one names the type of the value inside it.
pub fn ir_is_string_returning_func(fname: String) -> Bool:
    return ir_csv_contains(STRING_RETURNING_FUNCS, fname)

# the builtins the emitter types as returning bytes. most entries are also
# in RESULT_BYTES_FUNCS, so the call itself yields a result — what this
# table describes is the payload type, not the shape of the return.
pub fn ir_is_bytes_returning_func(fname: String) -> Bool:
    return ir_csv_contains(BYTES_RETURNING_FUNCS, fname)

# the builtins whose result the emitter types as the generic "list".
# keeping these apart from the list-of-string table is how the element kind
# survives into method lowering: a "list_string" receiver sorts with
# list_sort_strings_copy, a plain "list" with list_sort_copy.
pub fn ir_is_list_returning_func(fname: String) -> Bool:
    return ir_csv_contains(LIST_RETURNING_FUNCS, fname)

# the builtins whose result the emitter types as "list_string" rather than
# plain "list" — the counterpart to ir_is_list_returning_func, which
# explains why the two are separate tables.
pub fn ir_is_list_string_returning_func(fname: String) -> Bool:
    return ir_csv_contains(LIST_STRING_RETURNING_FUNCS, fname)

# whether a bare name is one of the builtins the seven tables above type.
# lambda capture analysis is the caller: an identifier naming a builtin is
# a call, not a free variable, so it is left out of the closure
# environment. the fallible tables are not part of this union, so a name
# like file_open_read answers false here.
pub fn ir_is_known_returning_func(fname: String) -> Bool:
    return ir_is_float_returning_func(fname) or ir_is_bool_returning_func(fname) or ir_is_int_returning_func(fname) or ir_is_string_returning_func(fname) or ir_is_bytes_returning_func(fname) or ir_is_list_returning_func(fname) or ir_is_list_string_returning_func(fname)

# the ir retkind of a fallible builtin's result. the match order is preserved
# from the original hand-written chain so every function's retkind is unchanged.
pub fn ir_builtin_result_retkind(name: String) -> String:
    if name == "parse_int":
        return "tuple"
    if ir_csv_contains(RESULT_INT_FUNCS, name):
        return "result_int"
    if ir_csv_contains(RESULT_BOOL_FUNCS, name):
        return "result_bool"
    if name == "parse_float":
        return "float"
    if ir_csv_contains(RESULT_STRING_FUNCS, name):
        return "string"
    if ir_csv_contains(RESULT_BYTES_FUNCS, name):
        return "bytes"
    return ""

# the ok-value kind for a builtin whose result is carried as result_int/bool.
pub fn ir_builtin_result_ok_kind(name: String) -> String:
    legacy_kind := ir_builtin_result_retkind(name)
    if legacy_kind == "result_int":
        return "int"
    if legacy_kind == "result_bool":
        return "bool"
    if name == "parse_int":
        return "int"
    return ""

# whether a method call yields a bool. type inference answers "bool" for
# these on any receiver, and the emitter records the same kind for the call
# it is lowering. the table carries both spellings of a method — `contains`
# and `string_contains`, `contains_key` and `map_contains_ikey` — because
# it is asked once with the source name and once with the lowered emit
# name, and neither query rewrites the other's form.
pub fn ir_is_bool_returning_method(meth: String) -> Bool:
    return ir_csv_contains(BOOL_RETURNING_METHODS, meth)

# whether a method leaves no value of its own. asked with the lowered emit
# name. the emitter forces the call's retkind to "void" and then hands the
# RECEIVER register back as the expression's value, so `xs.reverse()`
# evaluates to xs and chains; for the same reason it skips the release of
# an owned receiver, which trades a leak on a discarded chain for not
# freeing the value the chain returns.
pub fn ir_is_void_method(meth: String) -> Bool:
    return ir_csv_contains(VOID_METHODS, meth)

# whether a method returns a string. only type inference asks, and only
# once the checker has failed to type the call. the table is keyed by
# method name with no receiver, so an entry means the string version of
# that name: `reverse` here is String.reverse, not List.reverse, which is
# a void method.
pub fn ir_is_string_returning_method(meth: String) -> Bool:
    return ir_csv_contains(STRING_RETURNING_METHODS, meth)

# the runtime symbol a builtin is emitted under, or `name` unchanged when
# nothing here claims it — which is how a user function passes through. the
# general call path applies this only after the declared-function table
# misses, so a program that declares its own `trim` gets its own body; the
# `_raw` emit helpers apply it unconditionally, because they are already
# emitting a builtin. the `__`-prefixed keys are the emitter's synthesized
# calls (collection construction, retain/release, string equality) and
# cannot be written in source.
pub fn ir_runtime_call_name(name: String) -> String:
    if name == "print":
        return "pith_print_cstr"
    if name == "spawn":
        return "pith_spawn"
    if name == "await":
        return "pith_await"
    if name == "int_to_string":
        return "int_to_string"
    if name == "float_to_string":
        return "float_to_string"
    if name == "bool_to_string":
        return "bool_to_string"
    if name == "len":
        return "pith_auto_len"
    if name == "contains" or name == "string_contains":
        return "pith_cstring_contains"
    if name == "substring":
        return "pith_cstring_substring"
    if name == "starts_with":
        return "pith_cstring_starts_with"
    if name == "ends_with":
        return "pith_cstring_ends_with"
    if name == "trim":
        return "pith_cstring_trim"
    if name == "split":
        return "pith_string_split_to_list"
    if name == "to_upper":
        return "pith_cstring_to_upper"
    if name == "to_lower":
        return "pith_cstring_to_lower"
    if name == "replace":
        return "pith_cstring_replace"
    if name == "repeat":
        return "pith_cstring_repeat"
    if name == "index_of" or name == "string_index_of":
        return "pith_cstring_index_of"
    if name == "last_index_of" or name == "string_last_index_of":
        return "pith_cstring_last_index_of"
    if name == "char_at":
        return "pith_cstring_char_at"
    if name == "char_at_strict":
        return "pith_cstring_char_at_strict"
    if name == "chars":
        return "pith_cstring_chars"
    if name == "reverse":
        return "pith_cstring_reverse"
    if name == "is_empty" or name == "string_is_empty":
        return "pith_cstring_is_empty"
    if name == "join":
        return "list_join"
    if name == "slice":
        return "list_slice_copy"
    if name == "push":
        return "pith_list_push_value"
    if name == "pop":
        return "pith_list_pop"
    if name == "set":
        return "pith_list_set_value"
    if name == "sort_strings":
        return "pith_list_sort_strings"
    if name == "__list_get" or name == "__index":
        return "pith_list_get_value"
    if name == "__list_get_strict":
        return "pith_list_get_value_strict"
    if name == "__list_get_unchecked":
        return "pith_list_get_value_unchecked"
    if name == "__list_new":
        return "pith_list_new_default"
    if name == "__list_new_str":
        return "pith_list_new_cstr"
    if name == "__list_new_list":
        return "pith_list_new_nested_list"
    if name == "__list_new_map":
        return "pith_list_new_nested_map"
    if name == "__list_new_struct":
        return "pith_list_new_struct"
    if name == "__list_new_bytes":
        return "pith_list_new_bytes"
    if name == "__list_new_closure":
        return "pith_list_new_closure"
    if name == "__list_new_set":
        return "pith_list_new_set"
    if name == "__list_push":
        return "pith_list_push_value"
    if name == "__map_new":
        return "pith_map_new_default"
    if name == "__map_new_int":
        return "pith_map_new_int"
    if name == "__map_new_str_val":
        return "pith_map_new_cstr_val"
    if name == "__map_new_int_str_val":
        return "pith_map_new_int_cstr_val"
    if name == "__cstring_retain":
        return "pith_cstring_retain"
    if name == "__cstring_release":
        return "pith_cstring_release"
    if name == "__set_new":
        return "pith_set_new_default"
    if name == "__set_new_int":
        return "pith_set_new_int"
    if name == "__set_to_list":
        return "pith_set_to_list_cstr"
    if name == "__set_to_list_int":
        return "pith_set_to_list_int_handle"
    if name == "__struct_alloc":
        return "pith_struct_alloc"
    if name == "__closure_set_env":
        return "pith_closure_set_env"
    if name == "__closure_get_env":
        return "pith_closure_get_env"
    if name == "__str_eq":
        return "pith_cstring_eq"
    return name

## whether an emitter receiver type names a primitive, whose methods are all
## builtins the runtime provides.
pub fn ir_obj_type_is_primitive(obj_type: String) -> Bool:
    return obj_type == "string" or obj_type == "bytes" or obj_type == "int" or obj_type == "float" or obj_type == "bool"

## the runtime call name for a builtin method on a primitive receiver. the
## consumer resolves a bare call name through the user function table first,
## so a free function sharing the name captured the method call: with
## `fn to_int(text: String, fallback: Int)` in the build, `(1.5).to_int()`
## passed one argument to a two-argument function — and with a same-arity
## `fn to_int(x: Float)` it silently ran the wrong body. the receiver's
## checked type already chose the builtin; naming the runtime symbol keeps
## that choice closed. most names route through ir_runtime_call_name — the
## same mapping an unshadowed call would get at emission — and the four
## whose short abi key IS the method name get their full symbol here.
pub fn ir_primitive_method_call_name(emit_name: String) -> String:
    if emit_name == "to_int":
        return "pith_float_to_int"
    if emit_name == "to_float":
        return "pith_int_to_float"
    if emit_name == "pad_left":
        return "pith_cstring_pad_left"
    if emit_name == "pad_right":
        return "pith_cstring_pad_right"
    return ir_runtime_call_name(emit_name)

fn ir_method_string_emit_name(mname: String) -> String:
    if mname == "len":
        return "string_len"
    if mname == "is_empty":
        return "string_is_empty"
    if mname == "get":
        return "pith_cstring_char_at_opt"
    return mname

fn ir_method_bytes_emit_name(mname: String) -> String:
    if mname == "len":
        return "bytes_len"
    if mname == "is_empty":
        return "bytes_is_empty"
    if mname == "slice":
        return "bytes_slice"
    if mname == "concat":
        return "bytes_concat"
    if mname == "to_string_utf8":
        return "bytes_to_string_utf8"
    return mname

fn ir_method_list_emit_name(mname: String, obj_type: String) -> String:
    if mname == "len":
        return "pith_list_len"
    if mname == "insert":
        return "list_insert"
    if mname == "slice":
        return "list_slice_copy"
    if mname == "sort":
        if obj_type == "list_string":
            return "list_sort_strings_copy"
        return "list_sort_copy"
    if mname == "join":
        return "list_join"
    if mname == "reverse":
        return "list_reverse"
    if mname == "clear":
        return "list_clear"
    if mname == "get":
        return "pith_list_get_opt"
    if mname == "first":
        return "pith_list_first_opt"
    if mname == "last":
        return "pith_list_last_opt"
    return mname

fn ir_method_map_emit_name(mname: String, obj_type: String) -> String:
    obj_is_map_int := obj_type == "map_int"
    if mname == "len":
        return "map_len"
    if mname == "is_empty":
        return "map_is_empty"
    if mname == "clear":
        return "map_clear"
    if mname == "keys":
        if obj_is_map_int:
            return "map_keys_ikey"
        return "map_keys"
    if mname == "values":
        return "map_values"
    if mname == "contains_key" and obj_is_map_int:
        return "map_contains_ikey"
    if mname == "insert":
        if obj_is_map_int:
            return "map_insert_ikey"
        return "map_insert"
    if mname == "remove":
        if obj_is_map_int:
            return "map_remove_ikey"
        return "map_remove"
    if mname == "take":
        if obj_is_map_int:
            return "map_take_ikey"
        return "map_take"
    if mname == "get_default":
        if obj_is_map_int:
            return "map_get_default_ikey"
        return "map_get_default"
    if mname == "get":
        if obj_is_map_int:
            return "map_get_ikey_opt"
        return "map_get_opt"
    return mname

fn ir_method_set_emit_name(mname: String, obj_type: String) -> String:
    obj_is_set_int := obj_type == "set_int"
    if mname == "len":
        return "set_len"
    if mname == "add":
        if obj_is_set_int:
            return "set_add_int"
        return "set_add"
    if mname == "contains":
        if obj_is_set_int:
            return "set_contains_int"
        return "set_contains"
    if mname == "is_empty":
        return "set_is_empty"
    if mname == "clear":
        return "set_clear"
    if mname == "remove":
        if obj_is_set_int:
            return "set_remove_int"
        return "set_remove"
    return mname

# the name a method call is emitted under, picked from the source method
# name and the emitter's receiver-type string ("string", "list_string",
# "map_int", "channel:T", "opaque:Mutex", and so on). a pair no branch
# recognizes comes back as `mname` unchanged, leaving the consumer to
# resolve it — that is the path a user-defined method takes. one result is
# not a symbol at all: `to_string` on a string receiver returns "identity",
# which tells the caller to emit no call and reuse the receiver register.
pub fn ir_method_emit_name(mname: String, obj_type: String) -> String:
    obj_is_string := obj_type == "string"
    obj_is_bytes := obj_type == "bytes"
    obj_is_bool := obj_type == "bool"
    obj_is_float := obj_type == "float"
    obj_is_int := obj_type == "int"
    obj_is_map := obj_type == "map" or obj_type == "map_int"
    obj_is_set := obj_type == "set" or obj_type == "set_int"
    obj_is_list := obj_type == "list" or obj_type == "list_string" or obj_type.starts_with("list:")
    obj_is_channel := obj_type == "channel" or obj_type.starts_with("channel:")
    obj_is_task := obj_type == "task" or obj_type.starts_with("task:")

    mut emit_name := mname
    if mname == "to_string":
        if obj_is_float:
            emit_name = "float_to_string"
        elif obj_is_bool:
            emit_name = "bool_to_string"
        elif obj_is_int:
            emit_name = "int_to_string"
        elif obj_is_string:
            emit_name = "identity"
    elif obj_is_string:
        emit_name = ir_method_string_emit_name(mname)
    elif obj_is_bytes:
        emit_name = ir_method_bytes_emit_name(mname)
    elif obj_is_list:
        emit_name = ir_method_list_emit_name(mname, obj_type)
    elif obj_is_map:
        emit_name = ir_method_map_emit_name(mname, obj_type)
    elif obj_is_set:
        emit_name = ir_method_set_emit_name(mname, obj_type)
    elif obj_is_channel:
        if mname == "len":
            emit_name = "pith_channel_len"
        elif mname == "cap":
            emit_name = "pith_channel_cap"
        elif mname == "send":
            emit_name = "pith_channel_send"
        elif mname == "try_send":
            emit_name = "pith_channel_try_send"
        elif mname == "recv":
            emit_name = "pith_channel_recv"
        elif mname == "try_recv":
            emit_name = "pith_channel_try_recv"
        elif mname == "close":
            emit_name = "pith_channel_close"
        elif mname == "is_closed":
            emit_name = "pith_channel_is_closed"
    elif obj_is_task:
        if mname == "is_done":
            emit_name = "pith_task_is_done"
        elif mname == "detach":
            emit_name = "pith_task_detach"
    elif obj_type == "AtomicInt" or obj_type == "opaque:AtomicInt":
        if mname == "load":
            emit_name = "pith_atomic_int_get"
        elif mname == "store":
            emit_name = "pith_atomic_int_set"
        elif mname == "compare_set":
            emit_name = "pith_atomic_int_compare_set"
    # the remaining sync primitives emit their full runtime symbols for the
    # same reason atomics and channels do: a bare name like `done` is also a
    # legal variable name, and the consumer resolves a call through a local
    # of that name as a closure call. `done := WaitGroup(); done.done()`
    # jumped through a waitgroup handle and crashed until these were mapped.
    elif obj_type == "Mutex" or obj_type == "opaque:Mutex":
        if mname == "lock":
            emit_name = "pith_mutex_lock"
        elif mname == "unlock":
            emit_name = "pith_mutex_unlock"
    elif obj_type == "WaitGroup" or obj_type == "opaque:WaitGroup":
        if mname == "add":
            emit_name = "pith_waitgroup_add"
        elif mname == "done":
            emit_name = "pith_waitgroup_done"
        elif mname == "wait":
            emit_name = "pith_waitgroup_wait"
    elif obj_type == "Semaphore" or obj_type == "opaque:Semaphore":
        if mname == "acquire":
            emit_name = "pith_semaphore_acquire"
        elif mname == "release":
            emit_name = "pith_semaphore_release"
    return emit_name
