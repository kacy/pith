# a statement ends at the line end. without that rule `assert x == 4` parsed
# as the bare name `assert` and then a comparison whose result was dropped, so
# a failing assert passed.
fn main():
    x := 3
    assert x == 4
    print "hi"
    x
    y := 1 2

test "a failing assert":
    x := 3
    assert x == 4
