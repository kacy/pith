# a small module that main.pith imports. only `pub` names can be imported;
# `divide_rounded` is a helper private to this file.

# the sum of two integers.
pub fn add(a: Int, b: Int) -> Int:
    return a + b

# the product of two integers.
pub fn multiply(a: Int, b: Int) -> Int:
    return a * b

# `part` as a whole-number percentage of `whole`, rounded to the nearest.
pub fn percent_of(part: Int, whole: Int) -> Int:
    return divide_rounded(part * 100, whole)

fn divide_rounded(numerator: Int, denominator: Int) -> Int:
    return (numerator + denominator / 2) / denominator
