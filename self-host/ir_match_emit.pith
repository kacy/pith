# ir_match_emit.pith: lowering of match expressions and statements:
# subject evaluation, per-arm conditions (including variant payload
# destructuring), binding setup, and arm bodies.
#
# arm bodies contain statements and expressions, which stay in ir_lower;
# entry points take IrEmitHooks instead of importing ir_lower back so the
# module graph stays a strict DAG.

from ast import Node, get_node, node_kind
from checker import c_get_expr_type, c_pattern_type
from types import get_type_info, get_type_name
from ir_builder import ir_emit, ir_label, ir_new_temp_name, ir_reg
from ir_state import IrEmitHooks, ir_var_regs, ir_var_types, ir_current_func_return_kind, ir_untracked_rc_binds, ir_kinded_rc_binds, ir_last_was_ret, ir_boxed_enums, ir_enum_payload_kinds, ir_struct_field_index_lookup, ir_struct_names, ir_match_subject_tid, ir_match_pin_slot, ir_match_pin_slot_kind, ir_match_enter, ir_match_leave
from ir_types import ir_rc_kind, ir_struct_base_name, ir_sync_type_hint, ir_checked_type, ir_type_from_tid
from ir_primitives import ir_emit_call2, ir_emit_label, ir_emit_bool_literal, ir_emit_float_literal, ir_emit_int_literal, ir_emit_string_literal, ir_optional_flag_field, ir_optional_value_field, ir_rc_retain_reg, ir_rc_release_reg, ir_kinded_code, ir_kinded_rebind

# parsed child indices of one match arm: pattern, optional guard (-1 if none), and body.
struct IrMatchArm:
    pat_idx: Int
    guard_idx: Int
    body_idx: Int

fn ir_parse_match_arm(arm: Node) -> IrMatchArm:
    pat_idx := arm.children[0]
    mut guard_idx := 0 - 1
    mut body_idx := 0 - 1
    mut j := 1
    while j < arm.children.len():
        cn := get_node(arm.children[j])
        if cn.kind == "guard":
            if cn.children.len() > 0:
                guard_idx = cn.children[0]
        else:
            body_idx = arm.children[j]
        j = j + 1
    return IrMatchArm(pat_idx, guard_idx, body_idx)

# pin the subject just evaluated, when the caller asked for it: drop what the
# slot still holds from an earlier pass (a loop, or an arm that left by break
# or continue), then take a count on this subject. returns the slot, or "".
fn ir_take_match_pin(subj_r: Int) -> String:
    slot := ir_match_pin_slot
    kind := ir_match_pin_slot_kind
    ir_match_pin_slot = ""
    if slot.len() == 0:
        return ""
    old_r := ir_reg()
    ir_emit("load " + old_r.to_string() + " " + slot)
    ir_rc_release_reg(old_r, kind)
    ir_rc_retain_reg(subj_r, kind)
    ir_emit("store " + slot + " " + subj_r.to_string())
    return slot

# drop the pin at the match's merge and clear the slot, so the exit cleanup
# finds nothing left to release on this path.
fn ir_release_match_pin(slot: String, kind: String):
    if slot.len() == 0:
        return
    held_r := ir_reg()
    ir_emit("load " + held_r.to_string() + " " + slot)
    ir_rc_release_reg(held_r, kind)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + slot + " " + zero_r.to_string())

# emit the pattern test, bindings, optional guard, and subject-release/alias-track
# entry for one match arm; returns the fall-through label for the next arm.
fn ir_emit_match_arm_enter(arm: IrMatchArm, subj_r: Int, subj_type: String, subj_release: String, alias_release: String, hooks: IrEmitHooks, alias_track: fn(Int, String, Bool)) -> String:
    cond_r := ir_emit_match_cond(arm.pat_idx, subj_r)
    cand_l := ir_label()
    next_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + cand_l + " " + next_l)
    ir_emit_label(cand_l)
    ir_emit_match_bindings(arm.pat_idx, subj_r, subj_type)
    if arm.guard_idx >= 0:
        g_r := hooks.emit_expr(arm.guard_idx)
        body_l := ir_label()
        ir_emit("brif " + g_r.to_string() + " " + body_l + " " + next_l)
        ir_emit_label(body_l)
    # the subject dies here: this arm has bound (and counted) what it needs,
    # no later arm's condition runs on this path, and released after the guard
    # so a failing guard still hands a live subject to the next arm's test.
    if subj_release.len() > 0:
        ir_rc_release_reg(subj_r, subj_release)
    if alias_release.len() > 0:
        alias_track(subj_r, alias_release, true)
    return next_l

# emit one arm's body as the function's return value. an expression body
# goes through the full return contract (hooks.emit_ret is ir_emit_return_value):
# defers, borrow retain, optional/result wrap, and tracked local cleanup.
fn ir_emit_match_arm_return(body_idx: Int, hooks: IrEmitHooks):
    body := get_node(body_idx)
    if body.kind == "block":
        hooks.emit_block(body_idx)
        return
    mut expr_idx := body_idx
    if body.kind == "body" and body.children.len() > 0:
        expr_idx = body.children[0]
    hooks.emit_ret(expr_idx)
    # emit_ret already sets this on every exit path; kept as belt-and-braces
    # because emit_ret is a caller-supplied callback.
    ir_last_was_ret = true

# whether one arm's pattern leaves the subject's count releasable once the
# arm has bound its names. a bare binding on a non-optional subject IS the
# subject (an uncounted alias the arm body may store or return), and a
# tuple pattern binds element borrows the subject's cascade owns, so both
# rule the release out. an or-pattern is as safe as its alternatives.
# a variant pattern is safe only when every bound rc slot's kind resolved: an
# "unknown" slot is bound without a retain (ir_bind_owned_rc_payload emits
# nothing for it), and freeing the box would leave that binding dangling.
# a sub-pattern nested in a payload is judged the same way, with every
# binding below a payload counted (a nested tuple's elements included, see
# ir_emit_pattern_bindings), so it too needs each bound slot's kind resolved.
# an optional subject's bare binding is the counted payload extraction, not
# an alias, so it keeps the subject free.
## true when `pat_idx` leaves a freshly owned subject safe to release after binding.
pub fn ir_match_pattern_keeps_subject_free(pat_idx: Int, subj_is_optional: Bool) -> Bool:
    return ir_pattern_keeps_subject_free(pat_idx, subj_is_optional, false)

fn ir_pattern_keeps_subject_free(pat_idx: Int, subj_is_optional: Bool, counted: Bool) -> Bool:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        return subj_is_optional
    if pat.kind == "pat_tuple":
        if not counted:
            return false
        elems := ir_match_tuple_element_kinds(pat_idx, pat.children.len())
        for sub_idx, i in pat.children:
            if node_kind(sub_idx) == "pat_binding":
                if elems[i] == "unknown":
                    return false
            elif not ir_pattern_keeps_subject_free(sub_idx, false, true):
                return false
        return true
    if pat.kind == "pat_or":
        for alt_idx in pat.children:
            if not ir_pattern_keeps_subject_free(alt_idx, subj_is_optional, counted):
                return false
        return true
    if pat.kind == "pat_variant":
        kinds := ir_variant_pattern_kinds(pat_idx)
        for sub_idx, i in pat.children:
            if node_kind(sub_idx) == "pat_binding":
                if i >= kinds.len() or kinds[i] == "unknown":
                    return false
            elif not ir_pattern_keeps_subject_free(sub_idx, false, true):
                return false
        return true
    return true

## whether a pattern binds any name, at any depth.
pub fn ir_pattern_binds_names(pat_idx: Int) -> Bool:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding":
        return true
    for child in pat.children:
        if ir_pattern_binds_names(child):
            return true
    return false

# whether a sub-pattern can fail to match its slot. a binding or a wildcard
# never can, and neither can a tuple of sub-patterns that never can.
fn ir_pattern_is_refutable(pat_idx: Int) -> Bool:
    pat := get_node(pat_idx)
    if pat.kind == "pat_binding" or pat.kind == "pat_wildcard":
        return false
    if pat.kind == "pat_tuple":
        for child in pat.children:
            if ir_pattern_is_refutable(child):
                return true
        return false
    return true

# the type a pattern matches against: what the checker recorded for it, or
# fallback_tid when it recorded none.
fn ir_pattern_tid(pat_idx: Int, fallback_tid: Int) -> Int:
    tid := c_pattern_type(pat_idx)
    if tid >= 0:
        return tid
    return fallback_tid

## the ir key of a variant pattern's name, "Enum.Variant". a pattern written
## through a module alias ("lib.Enum.Variant") drops the alias, the way a
## module-qualified constructor does, since an enum's variants are filed under
## the enum's own name.
pub fn ir_variant_pattern_key(value: String) -> String:
    mut dots := 0
    mut i := value.len() - 1
    while i >= 0:
        if value[i] == ".":
            dots = dots + 1
            if dots == 2:
                return value.substring(i + 1, value.len())
        i = i - 1
    return value

# the ir key of the variant a pattern matches: the key the enum it matches
# is filed under, when that is the written enum under its declaring module's
# identity.
fn ir_variant_pattern_key_for(pat_idx: Int, fallback_tid: Int) -> String:
    key := ir_variant_pattern_key(get_node(pat_idx).value)
    tid := ir_pattern_tid(pat_idx, fallback_tid)
    if tid >= 0 and get_type_info(tid).kind == "enum":
        written := ir_variant_enum_name(key)
        base := ir_struct_base_name(get_type_info(tid).name)
        typed := base + "." + ir_variant_pattern_variant_name(key)
        if base.ends_with("_" + written) and ir_struct_field_index_lookup.contains_key(typed):
            return typed
    return key

## the payload kinds of a variant pattern's slots, resolved against the enum
## instance the pattern matches (see ir_pattern_tid), or an empty list for a
## variant without a payload. fallback_tid stands in for a pattern the checker
## recorded no type for.
pub fn ir_variant_pattern_kinds_for(pat_idx: Int, fallback_tid: Int) -> List[String]:
    key := ir_variant_pattern_key_for(pat_idx, fallback_tid)
    mut kinds: List[String] := []
    if ir_enum_payload_kinds.contains_key(key):
        kinds = ir_resolved_variant_kinds_for_tid(ir_pattern_tid(pat_idx, fallback_tid), key, ir_enum_payload_kinds[key].split(","))
    return kinds

fn ir_variant_pattern_kinds(pat_idx: Int) -> List[String]:
    return ir_variant_pattern_kinds_for(pat_idx, ir_match_subject_tid)

# load payload slot `i` of a boxed enum value under the kind its variant
# declares. the tag fills the first word, so the payloads start one word in.
fn ir_emit_payload_slot(subj_r: Int, i: Int, kinds: List[String], name: String) -> Int:
    mut kind := "unknown"
    if i < kinds.len():
        kind = kinds[i]
    slot_r := ir_reg()
    ir_emit("field " + slot_r.to_string() + " " + subj_r.to_string() + " " + ((i + 1) * 8).to_string() + " " + kind + " " + name)
    return slot_r

# the rc kind a match may release its subject with once an arm is taken, or
# "" when the subject is not this match's to free. asked after
# ir_match_subject_tid is set, because variant-kind resolution reads it.
fn ir_match_subject_release_kind(node: Node, subj_type: String, subj_owned: Bool) -> String:
    if not subj_owned:
        return ""
    kind := ir_rc_kind(subj_type)
    if kind.len() == 0:
        return ""
    if ir_match_subject_tid < 0:
        return ""
    info := get_type_info(ir_match_subject_tid)
    if info.kind == "result":
        return ""
    subj_is_optional := info.kind == "optional"
    mut i := 1
    while i < node.children.len():
        arm := get_node(node.children[i])
        if arm.children.len() > 0:
            if not ir_match_pattern_keeps_subject_free(arm.children[0], subj_is_optional):
                return ""
        i = i + 1
    return kind

## lower a function-tail match directly into returns. subj_owned reports
## whether the subject expression is an owned fresh temporary whose count
## this match must release. alias_release names the kind of an owned fresh
## subject the arms only read through a bare binding (tracked in flight during
## each arm via alias_track and freed on fall-through via alias_free).
pub fn ir_emit_match_return(node: Node, hooks: IrEmitHooks, subj_owned: Bool, alias_release: String, alias_track: fn(Int, String, Bool), alias_free: fn(Int, String)):
    subj_r := hooks.emit_expr(node.children[0])
    # every arm returns, so the exit cleanup is what releases a pin here
    ir_take_match_pin(subj_r)
    subj_type := ir_checked_type(node.children[0])
    saved_subj_tid := ir_match_enter(c_get_expr_type(node.children[0]))
    subj_release := ir_match_subject_release_kind(node, subj_type, subj_owned)
    mut i := 1
    while i < node.children.len():
        arm := ir_parse_match_arm(get_node(node.children[i]))
        next_l := ir_emit_match_arm_enter(arm, subj_r, subj_type, subj_release, alias_release, hooks, alias_track)
        ir_emit_match_arm_return(arm.body_idx, hooks)
        if alias_release.len() > 0:
            alias_track(subj_r, alias_release, false)
        ir_emit_label(next_l)
        i = i + 1
    # no arm matched: the fall-through lands on the function's default
    # return, and the subject dies unread.
    if subj_release.len() > 0:
        ir_rc_release_reg(subj_r, subj_release)
    if alias_release.len() > 0:
        alias_free(subj_r, alias_release)
    ir_match_leave(saved_subj_tid)

## the boolean register deciding whether an arm matches.
pub fn ir_emit_match_cond(pat_idx: Int, subj_r: Int) -> Int:
    pat := get_node(pat_idx)
    if pat.kind == "pat_wildcard":
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 1")
        return r
    if pat.kind == "pat_binding":
        # on an optional subject a binding matches only the some case
        # (the none arm is spelled `none`); anywhere else it always matches
        subj_info := get_type_info(ir_match_subject_tid)
        if subj_info.kind == "optional":
            return ir_optional_flag_field(subj_r)
        r := ir_reg()
        ir_emit("iconst " + r.to_string() + " 1")
        return r
    if pat.kind == "pat_none":
        flag_r := ir_optional_flag_field(subj_r)
        zero_r := ir_reg()
        ir_emit("iconst " + zero_r.to_string() + " 0")
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + flag_r.to_string() + " " + zero_r.to_string())
        return r
    if pat.kind == "pat_int":
        lit_r := ir_emit_int_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_bool":
        lit_r := ir_emit_bool_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_float":
        lit_r := ir_emit_float_literal(pat)
        r := ir_reg()
        ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
        return r
    if pat.kind == "pat_string":
        lit_r := ir_emit_string_literal(pat)
        r := ir_reg()
        ir_emit_call2(r, "__str_eq", "bool", subj_r, lit_r)
        return r
    if pat.kind == "pat_variant":
        r := ir_reg()
        key := ir_variant_pattern_key_for(pat_idx, ir_match_subject_tid)
        if ir_struct_field_index_lookup.contains_key(key):
            enum_name := ir_variant_enum_name(key)
            lit_r := ir_reg()
            ir_emit("iconst " + lit_r.to_string() + " " + ir_struct_field_index_lookup[key])
            if ir_boxed_enums.contains_key(enum_name):
                # boxed enum: the subject is a pointer; compare the stored tag,
                # then fold in any payload sub-patterns that can fail
                tag_r := ir_reg()
                ir_emit("field " + tag_r.to_string() + " " + subj_r.to_string() + " 0 int __enum_tag")
                ir_emit("eq " + r.to_string() + " " + tag_r.to_string() + " " + lit_r.to_string())
                return ir_emit_variant_payload_conds(pat_idx, subj_r, r)
            ir_emit("eq " + r.to_string() + " " + subj_r.to_string() + " " + lit_r.to_string())
            return r
        ir_emit("iconst " + r.to_string() + " 0")
        return r
    if pat.kind == "pat_range":
        # lo <= subject and subject <= hi ("incl") or < hi ("excl"), compared
        # unsigned on a UInt subject, whose bounds may pass the largest Int
        lo_r := ir_emit_int_literal(get_node(pat.children[0]))
        hi_r := ir_emit_int_literal(get_node(pat.children[1]))
        subject_name := get_type_name(c_get_expr_type(pat_idx))
        mut cmp := ""
        if subject_name == "UInt" or subject_name == "UInt64":
            cmp = "u"
        lo_ok := ir_reg()
        ir_emit(cmp + "gte " + lo_ok.to_string() + " " + subj_r.to_string() + " " + lo_r.to_string())
        hi_ok := ir_reg()
        if pat.value == "incl":
            ir_emit(cmp + "lte " + hi_ok.to_string() + " " + subj_r.to_string() + " " + hi_r.to_string())
        else:
            ir_emit(cmp + "lt " + hi_ok.to_string() + " " + subj_r.to_string() + " " + hi_r.to_string())
        r := ir_reg()
        ir_emit("and " + r.to_string() + " " + lo_ok.to_string() + " " + hi_ok.to_string())
        return r
    if pat.kind == "pat_or":
        # matches when any alternative matches.
        mut acc_r := ir_emit_match_cond(pat.children[0], subj_r)
        mut k := 1
        while k < pat.children.len():
            alt_r := ir_emit_match_cond(pat.children[k], subj_r)
            or_r := ir_reg()
            ir_emit("or " + or_r.to_string() + " " + acc_r.to_string() + " " + alt_r.to_string())
            acc_r = or_r
            k = k + 1
        return acc_r
    if pat.kind == "pat_tuple":
        # each element loads its slot and recurses into the ordinary
        # pattern machinery; bindings and wildcards match anything
        elems := ir_match_tuple_element_kinds(pat_idx, pat.children.len())
        acc_r := ir_reg()
        ir_emit("iconst " + acc_r.to_string() + " 1")
        mut out_r := acc_r
        for sub_idx, i in pat.children:
            if not ir_pattern_is_refutable(sub_idx):
                continue
            elem_r := ir_reg()
            ir_emit("field " + elem_r.to_string() + " " + subj_r.to_string() + " " + (i * 8).to_string() + " " + elems[i] + " __t" + i.to_string())
            sub_r := ir_emit_match_cond(sub_idx, elem_r)
            and_r := ir_reg()
            ir_emit("and " + and_r.to_string() + " " + out_r.to_string() + " " + sub_r.to_string())
            out_r = and_r
        return out_r
    r := ir_reg()
    ir_emit("iconst " + r.to_string() + " 0")
    return r

## element kinds for a tuple-pattern subject.
pub fn ir_match_tuple_element_kinds(pat_idx: Int, count: Int) -> List[String]:
    mut out: List[String] := []
    info := get_type_info(ir_pattern_tid(pat_idx, ir_match_subject_tid))
    mut i := 0
    while i < count:
        if info.kind == "tuple" and i < info.elements.len():
            out.push(ir_type_from_tid(info.elements[i]))
        else:
            out.push("unknown")
        i = i + 1
    return out

## the enum a variant pattern name belongs to, or "".
pub fn ir_variant_enum_name(variant_key: String) -> String:
    mut i := 0
    while i < variant_key.len():
        if variant_key[i] == ".":
            return variant_key.substring(0, i)
        i = i + 1
    return variant_key

# the variant a pattern key names ("Opt.Some" -> "Some"), or the key
# itself when it carries no dot.
fn ir_variant_pattern_variant_name(variant_key: String) -> String:
    mut i := 0
    while i < variant_key.len():
        if variant_key[i] == ".":
            return variant_key.substring(i + 1, variant_key.len())
        i = i + 1
    return variant_key

# whether an emission kind is a leftover type-parameter name, not a
# builtin kind and not a registered struct or enum.
fn ir_payload_kind_is_unresolved(kind: String) -> Bool:
    if kind.len() == 0 or kind == "unknown":
        return false
    if kind == "int" or kind == "float" or kind == "bool" or kind == "string" or kind == "bytes":
        return false
    if kind == "tuple" or kind == "closure" or kind == "channel" or kind == "task":
        return false
    if ir_sync_type_hint(kind):
        return false
    if kind == "list" or kind == "list_string" or kind == "map" or kind == "map_int" or kind == "set" or kind == "set_int":
        return false
    if kind.contains("?") or kind.contains("."):
        return false
    if ir_struct_names.contains_key(ir_struct_base_name(kind)):
        return false
    return true

# the concrete payload kinds an enum instance's checked type gives this
# variant, or an empty list.
fn ir_variant_kinds_from_tid(tid: Int, variant_name: String) -> List[String]:
    mut out: List[String] := []
    if tid < 0:
        return out
    info := get_type_info(tid)
    if info.kind != "enum":
        return out
    mut vi := 0
    for v in info.variants:
        if v == variant_name and out.len() == 0:
            if vi < info.variant_types.len():
                for ptid in info.variant_types[vi]:
                    out.push(ir_struct_base_name(ir_type_from_tid(ptid)))
        vi = vi + 1
    return out

## merge a variant's declared payload kinds with the concrete ones its
## checked instance type carries: an unresolved parameter-name slot takes
## the instance's kind, everything else keeps the declaration's; a
## concrete declared kind (including an optional payload's "tuple") is
## already right and must stay untouched.
pub fn ir_resolved_variant_kinds_for_tid(tid: Int, variant_key: String, kinds: List[String]) -> List[String]:
    mut needs_instance := false
    for k in kinds:
        if ir_payload_kind_is_unresolved(k):
            needs_instance = true
    if needs_instance == false:
        return kinds
    concrete := ir_variant_kinds_from_tid(tid, ir_variant_pattern_variant_name(variant_key))
    if concrete.len() == 0:
        return kinds
    mut out: List[String] := []
    for k, i in kinds:
        if ir_payload_kind_is_unresolved(k) and i < concrete.len() and concrete[i].len() > 0:
            out.push(concrete[i])
        else:
            out.push(k)
    return out

## extend an arm condition with variant payload checks.
pub fn ir_emit_variant_payload_conds(pat_idx: Int, subj_r: Int, tag_cond_r: Int) -> Int:
    pat := get_node(pat_idx)
    mut refutable := false
    for sub_idx in pat.children:
        if ir_pattern_is_refutable(sub_idx):
            refutable = true
    if not refutable:
        return tag_cond_r
    kinds := ir_variant_pattern_kinds(pat_idx)
    temp := ir_new_temp_name("variant_match")
    ir_emit("store " + temp + " " + tag_cond_r.to_string())
    test_l := ir_label()
    done_l := ir_label()
    ir_emit("brif " + tag_cond_r.to_string() + " " + test_l + " " + done_l)
    ir_emit_label(test_l)
    mut acc_r := tag_cond_r
    for sub_idx, i in pat.children:
        if ir_pattern_is_refutable(sub_idx):
            slot_r := ir_emit_payload_slot(subj_r, i, kinds, "__payload")
            cond_r := ir_emit_match_cond(sub_idx, slot_r)
            and_r := ir_reg()
            ir_emit("and " + and_r.to_string() + " " + acc_r.to_string() + " " + cond_r.to_string())
            acc_r = and_r
    ir_emit("store " + temp + " " + acc_r.to_string())
    ir_emit("jmp " + done_l)
    ir_emit_label(done_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + temp)
    return r

# give a match binding its own count on an rc payload: release whatever the
# name held before (zero on first reach, a stale payload when an arm rebinds
# the name in a loop), then retain the new value.
fn ir_bind_owned_rc_payload(name: String, value_r: Int, kind: String):
    rc_kind := ir_rc_kind(kind)
    if ir_kinded_rc_binds.contains(name):
        if ir_kinded_code(rc_kind) == 0:
            ir_kinded_rebind(name, "")
            return
        ir_rc_retain_reg(value_r, rc_kind)
        ir_kinded_rebind(name, rc_kind)
        return
    if rc_kind.len() == 0:
        return
    if not ir_untracked_rc_binds.contains(name):
        old_r := ir_reg()
        ir_emit("load " + old_r.to_string() + " " + name)
        ir_rc_release_reg(old_r, rc_kind)
    ir_rc_retain_reg(value_r, rc_kind)

## a binding that takes no count of its own (a tuple element, the whole
## subject). a kinded name still drops what it owned before, and records that
## it now owns nothing, so the exit cleanup leaves the view alone.
pub fn ir_bind_uncounted_view(name: String):
    if ir_kinded_rc_binds.contains(name):
        ir_kinded_rebind(name, "")

## bind pattern names to the matched subject's pieces.
pub fn ir_emit_match_bindings(pat_idx: Int, subj_r: Int, subj_type: String):
    ir_emit_pattern_bindings(pat_idx, subj_r, subj_type, false)

# the binder behind ir_emit_match_bindings. `counted` is set below a variant
# payload: an arm's own tuple pattern binds its elements as views of a
# subject that outlives the arm, but a tuple nested in a payload binds them
# with counts of their own, like the payload bindings around it.
fn ir_emit_pattern_bindings(pat_idx: Int, subj_r: Int, subj_type: String, counted: Bool):
    pat := get_node(pat_idx)
    if pat.kind == "pat_or":
        # the alternatives bind the same names but may pull them from
        # different payload slots, so each alternative re-tests its own
        # condition and binds from its own shape
        done_l := ir_label()
        mut k := 0
        while k < pat.children.len():
            cond_r := ir_emit_match_cond(pat.children[k], subj_r)
            bind_l := ir_label()
            next_l := ir_label()
            ir_emit("brif " + cond_r.to_string() + " " + bind_l + " " + next_l)
            ir_emit_label(bind_l)
            ir_emit_pattern_bindings(pat.children[k], subj_r, subj_type, counted)
            ir_emit("jmp " + done_l)
            ir_emit_label(next_l)
            k = k + 1
        ir_emit_label(done_l)
        return
    if pat.kind == "pat_tuple":
        elems := ir_match_tuple_element_kinds(pat_idx, pat.children.len())
        for sub_idx, i in pat.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                elem_r := ir_reg()
                ir_emit("field " + elem_r.to_string() + " " + subj_r.to_string() + " " + (i * 8).to_string() + " " + elems[i] + " " + sub.value)
                if counted:
                    ir_bind_owned_rc_payload(sub.value, elem_r, elems[i])
                else:
                    ir_bind_uncounted_view(sub.value)
                ir_var_regs.insert(sub.value, elem_r)
                if elems[i] != "unknown":
                    ir_var_types.insert(sub.value, elems[i])
                ir_emit("store " + sub.value + " " + elem_r.to_string())
            elif ir_pattern_binds_names(sub_idx):
                elem_r := ir_reg()
                ir_emit("field " + elem_r.to_string() + " " + subj_r.to_string() + " " + (i * 8).to_string() + " " + elems[i] + " __t" + i.to_string())
                ir_emit_pattern_bindings(sub_idx, elem_r, elems[i], counted)
        return
    if pat.kind == "pat_binding":
        subj_info := get_type_info(ir_match_subject_tid)
        if subj_info.kind == "optional":
            # the binding is the unwrapped inner value, mirroring if let
            inner_r := ir_optional_value_field(subj_r, ir_match_subject_tid)
            ir_var_regs.insert(pat.value, inner_r)
            inner_kind := ir_type_from_tid(subj_info.inner)
            if inner_kind.len() > 0:
                ir_var_types.insert(pat.value, inner_kind)
            ir_bind_owned_rc_payload(pat.value, inner_r, inner_kind)
            ir_emit("store " + pat.value + " " + inner_r.to_string())
            return
        ir_var_regs.insert(pat.value, subj_r)
        if subj_type.len() > 0:
            ir_var_types.insert(pat.value, subj_type)
        ir_bind_uncounted_view(pat.value)
        ir_emit("store " + pat.value + " " + subj_r.to_string())
    if pat.kind == "pat_variant" and pat.children.len() > 0:
        kinds := ir_variant_pattern_kinds(pat_idx)
        for sub_idx, i in pat.children:
            sub := get_node(sub_idx)
            if sub.kind == "pat_binding":
                mut kind := "unknown"
                if i < kinds.len():
                    kind = kinds[i]
                slot_r := ir_emit_payload_slot(subj_r, i, kinds, sub.value)
                ir_bind_owned_rc_payload(sub.value, slot_r, kind)
                ir_var_regs.insert(sub.value, slot_r)
                if kind != "unknown":
                    ir_var_types.insert(sub.value, kind)
                ir_emit("store " + sub.value + " " + slot_r.to_string())
            elif ir_pattern_binds_names(sub_idx):
                mut kind := "unknown"
                if i < kinds.len():
                    kind = kinds[i]
                slot_r := ir_emit_payload_slot(subj_r, i, kinds, "__payload")
                ir_emit_pattern_bindings(sub_idx, slot_r, kind, true)

## emit one arm's body into `result_temp` (or run a block body).
pub fn ir_emit_match_arm_body(body_idx: Int, result_temp: String, hooks: IrEmitHooks):
    body := get_node(body_idx)
    if body.kind == "block":
        hooks.emit_block(body_idx)
        return
    mut expr_idx := body_idx
    if body.kind == "body" and body.children.len() > 0:
        expr_idx = body.children[0]
    val_r := hooks.emit_value(expr_idx)
    ir_emit("store " + result_temp + " " + val_r.to_string())
    ir_last_was_ret = false

## lower an if used as an expression: evaluate the first branch whose condition
## holds into a shared temp. children are [condition, then_expr, elif_branch..., else_expr].
## hooks.emit_value emits each branch value and hooks.emit_expr evaluates conditions.
pub fn ir_emit_if_expr(node: Node, hooks: IrEmitHooks) -> Int:
    result_temp := ir_new_temp_name("ifexpr")
    end_l := ir_label()
    cond_r := hooks.emit_expr(node.children[0])
    then_l := ir_label()
    mut next_l := ir_label()
    ir_emit("brif " + cond_r.to_string() + " " + then_l + " " + next_l)
    ir_emit_label(then_l)
    then_r := hooks.emit_value(node.children[1])
    ir_emit("store " + result_temp + " " + then_r.to_string())
    ir_emit("jmp " + end_l)
    ir_emit_label(next_l)
    mut i := 2
    while i < node.children.len() - 1:
        branch := get_node(node.children[i])
        branch_cond_r := hooks.emit_expr(branch.children[0])
        body_l := ir_label()
        after_l := ir_label()
        ir_emit("brif " + branch_cond_r.to_string() + " " + body_l + " " + after_l)
        ir_emit_label(body_l)
        branch_r := hooks.emit_value(branch.children[1])
        ir_emit("store " + result_temp + " " + branch_r.to_string())
        ir_emit("jmp " + end_l)
        ir_emit_label(after_l)
        i = i + 1
    else_r := hooks.emit_value(node.children[node.children.len() - 1])
    ir_emit("store " + result_temp + " " + else_r.to_string())
    ir_emit_label(end_l)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

## lower a match used as an expression. hooks.emit_value emits an arm's value
## and hooks.emit_expr emits the subject and guards.
pub fn ir_emit_match_expr(node: Node, hooks: IrEmitHooks, subj_owned: Bool, alias_release: String, alias_track: fn(Int, String, Bool), alias_free: fn(Int, String)) -> Int:
    subj_r := hooks.emit_expr(node.children[0])
    pin_kind := ir_match_pin_slot_kind
    pin_slot := ir_take_match_pin(subj_r)
    subj_type := ir_checked_type(node.children[0])
    saved_subj_tid := ir_match_enter(c_get_expr_type(node.children[0]))
    subj_release := ir_match_subject_release_kind(node, subj_type, subj_owned)
    result_temp := ir_new_temp_name("match")
    end_l := ir_label()
    mut i := 1
    while i < node.children.len():
        arm := ir_parse_match_arm(get_node(node.children[i]))
        next_l := ir_emit_match_arm_enter(arm, subj_r, subj_type, subj_release, alias_release, hooks, alias_track)
        ir_emit_match_arm_body(arm.body_idx, result_temp, hooks)
        if alias_release.len() > 0:
            alias_track(subj_r, alias_release, false)
            # the arm's value is in the temp with a count of its own
            if not ir_last_was_ret:
                alias_free(subj_r, alias_release)
        if not ir_last_was_ret:
            ir_emit("jmp " + end_l)
        ir_emit_label(next_l)
        i = i + 1
    # no arm matched: the subject dies unread, and a zero keeps the result
    # temp defined.
    if subj_release.len() > 0:
        ir_rc_release_reg(subj_r, subj_release)
    if alias_release.len() > 0:
        alias_free(subj_r, alias_release)
    zero_r := ir_reg()
    ir_emit("iconst " + zero_r.to_string() + " 0")
    ir_emit("store " + result_temp + " " + zero_r.to_string())
    ir_emit_label(end_l)
    ir_release_match_pin(pin_slot, pin_kind)
    ir_match_leave(saved_subj_tid)
    r := ir_reg()
    ir_emit("load " + r.to_string() + " " + result_temp)
    return r

## the tail match node of a function body, or -1.
pub fn ir_function_tail_match(body_idx: Int) -> Int:
    if ir_current_func_return_kind.len() == 0:
        return 0 - 1
    if ir_current_func_return_kind == "void":
        return 0 - 1
    return ir_unwrap_tail_match(body_idx)

## unwrap a returns-wrapped tail match node.
pub fn ir_unwrap_tail_match(idx: Int) -> Int:
    n := get_node(idx)
    if n.kind == "match_expr":
        return idx
    if n.kind == "body" or n.kind == "block" or n.kind == "then" or n.kind == "else":
        if n.children.len() == 0:
            return 0 - 1
        return ir_unwrap_tail_match(n.children[n.children.len() - 1])
    return 0 - 1
