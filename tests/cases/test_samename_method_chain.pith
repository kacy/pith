# a method's signature resolves in the module that declared it. a chained call
# on either same-named struct keeps its own type, whichever import came last.
import clash_chain_a as a
import clash_chain_b as b

fn main():
    print(a.make().with_label("x").only_on_a())
    print(a.make().with_label("x").merged(a.make()).label)
    print(a.make().with_label("x").tag().shout())
    print(b.make().with_port(9).only_on_b().to_string())
    print(b.make().with_port(9).merged(b.make()).port.to_string())
