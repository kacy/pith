# a module whose exports are named like the builtins max and min, for
# test_uuid_bigint_builtin_max. `max` takes the builtin's two Ints, so a
# bare `max(a, b)` resolved to it would compile and print the wrong answer;
# `min` takes nothing, so one resolved to it would fail to compile.

# the two arguments packed into one number, which no builtin returns.
pub fn max(a: Int, b: Int) -> Int:
    return a * 1000 + b

# a constant text, reached only as `named.min()`.
pub fn min() -> String:
    return "module min"
