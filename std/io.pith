        return read_exact_process_stderr_bytes(self, count)

    fn read_exact_bytes_ctx(ctx: Context, count: Int) -> Bytes!BlockingError:
        return read_exact_process_stderr_bytes_ctx(self, ctx, count)

    fn read_all_bytes() -> Bytes!:
        return read_all_process_stderr_bytes(self)

    fn read_all_bytes_ctx(ctx: Context) -> Bytes!BlockingError:
        return read_all_process_stderr_bytes_ctx(self, ctx)

    fn read_all_bytes_chunked(chunk_size: Int) -> Bytes!:
        return read_all_process_stderr_bytes_chunked(self, chunk_size)

    fn read_all_bytes_chunked_ctx(ctx: Context, chunk_size: Int) -> Bytes!BlockingError:
        return read_all_process_stderr_bytes_chunked_ctx(self, ctx, chunk_size)

    fn buffered_bytes() -> BufferedBytesReader:
        return buffered_bytes_reader_from_stderr(self, DEFAULT_CHUNK_SIZE)

    fn buffered_bytes_chunked(chunk_size: Int) -> BufferedBytesReader:
        return buffered_bytes_reader_from_stderr(self, chunk_size)

    fn buffered() -> BufferedProcessStderr:
        return buffered_process_stderr(self)

    fn buffered_chunked(chunk_size: Int) -> BufferedProcessStderr:
        return buffered_process_stderr_chunked(self, chunk_size)

impl Reader for ProcessStderr:
    fn read(max_bytes: Int) -> String!:
        return process_stderr_read(self, max_bytes)

impl BytesReader for ProcessStderr:
    fn read_bytes(max_bytes: Int) -> Bytes!:
        return process_stderr_read_bytes(self, max_bytes)

impl Process:
    fn stdin() -> ProcessStdin:
        return process_stdin(self)

    fn stdout() -> ProcessStdout:
        return process_stdout(self)

    fn stderr() -> ProcessStderr:
        return process_stderr(self)

    fn wait() -> Int:
        return wait_process(self)

    fn kill() -> Bool:
        return kill_process(self)

    fn close():
        close_process(self)

impl Closer for Process:
    fn close():
        close_process(self)

