# observability out of the box with std.web.
#
# a server built with web.new() is instrumented for free: a built-in middleware
# records a request counter, an in-flight gauge, and a duration histogram for
# every route, and web.new() serves GET /metrics with the prometheus text of it
# all. there is no instrumentation code below — the greet handler just returns a
# greeting. we spawn the server, hit /greet a few times, scrape /metrics, and
# read the request counter straight out of the exposition text to prove it
# counted every request on its own.
import std.web as web
import std.net.http as http

# GET /greet?name=... — a plain handler with no metrics code of its own.
fn greet(req: web.Request) -> http.HttpResponse:
    return http.text(200, "hi, " + req.query_or("name", "world"))

# the default (observable) app: one route, plus the /healthz and /metrics that
# web.new() sets up for you.
fn build_app() -> web.App:
    return web.new().get("/greet", greet)

# run the server in the background so main can act as a client against it.
fn serve_bg(port: Int) -> Int:
    return build_app().listen("127.0.0.1", port) catch 0

# fetch a path and return just the response body, so we can print it.
fn fetch(port: Int, path: String) -> String:
    resp := http.get_request("127.0.0.1", port, path).send() catch:
        return "no response"
    return resp.body_text() catch ""

# pull the value of the request-counter series whose labels contain `marker` out
# of the prometheus text: find its line and return whatever follows "} ".
fn counter_value(metrics_text: String, marker: String) -> String:
    for line in metrics_text.split("\n"):
        if line.starts_with("http_server_requests_total{{") and line.contains(marker):
            close := line.index_of("}} ")
            if close >= 0:
                return line.substring(close + 2, line.len())
    return "?"

fn main() -> Int!:
    port := 18099
    spawn serve_bg(port)
    sleep(200)   # give the listener a moment to bind

    # three requests to the same route — no instrumentation code anywhere.
    mut last := ""
    mut i := 0
    while i < 3:
        last = fetch(port, "/greet?name=ada")
        i = i + 1
    print("last response: " + last)

    # scrape the endpoint web.new() serves for free and read the counter back.
    metrics_text := fetch(port, "/metrics")
    marker := "route=\"/greet\""
    print("/metrics served: " + metrics_text.contains("# TYPE http_server_requests_total counter").to_string())
    print("requests to /greet: " + counter_value(metrics_text, marker))
    return 0
