# a generic that hands back its optional `T` unchanged returns the wrong
# value when `T` is itself an optional. `first_or[T](xs: List[T], fallback:
# T) -> T` at `T = Int?` answers a pointer where the payload should be and at
# `T = String?` an empty string, on both the `xs[0]` path and the `fallback`
# path; the concrete twins (`first_or_int_opt`, `first_or_str_opt`) answer
# correctly. the shape predates tid-keyed specialization (it fails the same
# way when `Int?` and `String?` share one body) and is unrelated to `show[T]`,
# which passes at both types (tests/cases/test_generic_optional_key_split).
# the likely site is the return path's "already optional" decision for a
# value whose static type is the parameter `T` while the substituted type is
# an optional: the returned value is wrapped in a second shell, and the caller
# unwraps one layer and reads the inner shell's address as the payload.
#
# expected, once fixed: 7 / xy / 4 / hi, each equal to the twin line after it.
fn first_or[T](xs: List[T], fallback: T) -> T:
    if xs.len() > 0:
        return xs[0]
    return fallback

fn first_or_int_opt(xs: List[Int?], fallback: Int?) -> Int? :
    if xs.len() > 0:
        return xs[0]
    return fallback

fn first_or_str_opt(xs: List[String?], fallback: String?) -> String? :
    if xs.len() > 0:
        return xs[0]
    return fallback

fn main():
    a: Int? := 4
    s: String? := "hi"
    n: Int? := none
    t: String? := none
    ints: List[Int?] := [7, none]
    strs: List[String?] := ["x" + "y", none]
    print("{first_or(ints, n)}")
    print("{first_or_int_opt(ints, n)}")
    print("{first_or(strs, t)}")
    print("{first_or_str_opt(strs, t)}")
    empty_ints: List[Int?] := []
    empty_strs: List[String?] := []
    print("{first_or(empty_ints, a)}")
    print("{first_or_int_opt(empty_ints, a)}")
    print("{first_or(empty_strs, s)}")
    print("{first_or_str_opt(empty_strs, s)}")
