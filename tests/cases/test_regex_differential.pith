# std.regex searches in one pass with an unanchored prefix. this checks it
# against the engine it replaced, which ran the vm once per start offset,
# over random patterns and inputs: find, captures and find_all must agree
# exactly, spans and groups included.

import std.regex as regex

OP_CHAR := 0
OP_ANY := 1
OP_CLASS := 2
OP_SPLIT := 3
OP_JMP := 4
OP_SAVE := 5
OP_MATCH := 6
OP_BOL := 7
OP_EOL := 8

fn class_matches(cd: regex.ClassDef, code: Int) -> Bool:
    mut hit := false
    mut i := 0
    while i + 1 < cd.ranges.len() and not hit:
        if code >= cd.ranges[i] and code <= cd.ranges[i + 1]:
            hit = true
        i = i + 2
    if cd.negate:
        return not hit
    return hit

fn add_thread(re: regex.Regex, list_pcs: List[Int], list_slots: List[List[Int]], seen: Set[Int], pc: Int, slots: List[Int], pos: Int, input_len: Int):
    if seen.contains(pc):
        return
    seen.add(pc)
    inst := re.insts[pc]
    if inst.op == OP_JMP:
        add_thread(re, list_pcs, list_slots, seen, inst.a, slots, pos, input_len)
        return
    if inst.op == OP_SPLIT:
        add_thread(re, list_pcs, list_slots, seen, inst.a, slots, pos, input_len)
        add_thread(re, list_pcs, list_slots, seen, inst.b, slots, pos, input_len)
        return
    if inst.op == OP_SAVE:
        mut copied: List[Int] := []
        for v in slots:
            copied.push(v)
        while copied.len() <= inst.a:
            copied.push(0 - 1)
        copied[inst.a] = pos
        add_thread(re, list_pcs, list_slots, seen, pc + 1, copied, pos, input_len)
        return
    if inst.op == OP_BOL:
        if pos == 0:
            add_thread(re, list_pcs, list_slots, seen, pc + 1, slots, pos, input_len)
        return
    if inst.op == OP_EOL:
        if pos == input_len:
            add_thread(re, list_pcs, list_slots, seen, pc + 1, slots, pos, input_len)
        return
    list_pcs.push(pc)
    list_slots.push(slots)

# the old anchored run: one vm pass from a single start offset
fn old_run_from(re: regex.Regex, input: String, start: Int) -> List[Int]:
    mut cur_pcs: List[Int] := []
    mut cur_slots: List[List[Int]] := []
    mut seen: Set[Int] := {}
    mut init: List[Int] := []
    n := input.len()
    add_thread(re, cur_pcs, cur_slots, seen, 0, init, start, n)
    mut best: List[Int] := []
    mut pos := start
    while cur_pcs.len() > 0:
        mut next_pcs: List[Int] := []
        mut next_slots: List[List[Int]] := []
        mut next_seen: Set[Int] := {}
        mut code := 0 - 1
        if pos < n:
            code = ord(input[pos])
        mut thread_index := 0
        mut matched_this_round := false
        while thread_index < cur_pcs.len() and not matched_this_round:
            inst := re.insts[cur_pcs[thread_index]]
            slots := cur_slots[thread_index]
            if inst.op == OP_MATCH:
                best = slots
                matched_this_round = true
            elif inst.op == OP_CHAR:
                if code == inst.a:
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            elif inst.op == OP_ANY:
                if code >= 0 and code != 10:
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            elif inst.op == OP_CLASS:
                if code >= 0 and class_matches(re.classes[inst.a], code):
                    add_thread(re, next_pcs, next_slots, next_seen, cur_pcs[thread_index] + 1, slots, pos + 1, n)
            thread_index = thread_index + 1
        cur_pcs = next_pcs
        cur_slots = next_slots
        pos = pos + 1
        if pos > n and cur_pcs.len() == 0:
            return best
    return best

fn on_boundary(input: String, at: Int) -> Bool:
    if at <= 0 or at >= input.len():
        return true
    code := ord(input[at])
    return code < 128 or code >= 192

fn slots_aligned(input: String, slots: List[Int]) -> Bool:
    mut i := 0
    while i < slots.len():
        if slots[i] >= 0 and not on_boundary(input, slots[i]):
            return false
        i = i + 1
    return true

# the old search loop: the first start offset with an aligned match
fn old_search(re: regex.Regex, input: String, start: Int) -> List[Int]:
    mut s := start
    while s <= input.len():
        slots := old_run_from(re, input, s)
        if slots.len() >= 2 and slots_aligned(input, slots):
            return slots
        s = s + 1
    return []

fn group_text(input: String, slots: List[Int], ngroups: Int) -> String:
    mut out: List[String] := []
    mut g := 0
    while g < ngroups:
        lo_i := g * 2
        hi_i := g * 2 + 1
        if hi_i < slots.len() and slots[lo_i] >= 0 and slots[hi_i] >= slots[lo_i]:
            out.push(input.substring(slots[lo_i], slots[hi_i]))
        else:
            out.push("")
        g = g + 1
    return out.join("|")

fn old_find_all(re: regex.Regex, input: String) -> String:
    mut out: List[String] := []
    mut start := 0
    while start <= input.len():
        slots := old_search(re, input, start)
        if slots.len() < 2:
            return out.join(" ")
        stop := slots[1]
        out.push("{slots[0]}-{stop}")
        if stop == slots[0]:
            start = stop + 1
        else:
            start = stop
    return out.join(" ")

fn new_find_all(re: regex.Regex, input: String) -> String:
    mut out: List[String] := []
    for m in re.find_all(input):
        out.push("{m.start}-{m.stop}")
    return out.join(" ")

struct Rng:
    state: Int

fn next_int(r: Rng, bound: Int) -> Int:
    r.state = (r.state * 1103515245 + 12345) % 2147483648
    return (r.state / 65536) % bound

fn random_pattern(r: Rng) -> String:
    atoms := ["a", "b", "c", ".", "[ab]", "[^a]", "\\d", "\\w", "^", "$", "(a|b)", "(ab|a)", "(a*)", "(b+|)", "x", "1"]
    quants := ["", "", "", "*", "+", "?"]
    mut parts: List[String] := []
    count := 1 + next_int(r, 5)
    mut i := 0
    while i < count:
        k := next_int(r, 10)
        if k == 0:
            parts.push("|")
        elif k == 1:
            # a group around two atoms
            parts.push("(" + atoms[next_int(r, atoms.len())] + atoms[next_int(r, atoms.len())] + ")" + quants[next_int(r, quants.len())])
        else:
            parts.push(atoms[next_int(r, atoms.len())] + quants[next_int(r, quants.len())])
        i = i + 1
    return parts.join("")

fn random_input(r: Rng) -> String:
    chars := ["a", "b", "c", "x", "1", " ", "\n", "é", "ab", "ba"]
    mut parts: List[String] := []
    count := next_int(r, 12)
    mut i := 0
    while i < count:
        parts.push(chars[next_int(r, chars.len())])
        i = i + 1
    return parts.join("")

fn span_text(slots: List[Int]) -> String:
    if slots.len() < 2:
        return "none"
    return "{slots[0]}-{slots[1]}"

fn main() -> Int!:
    r := Rng(20261031)
    mut patterns := 0
    mut checks := 0
    mut matched := 0
    mut mismatches := 0
    while patterns < 4000:
        pattern := random_pattern(r)
        compiled := regex.compile(pattern)
        if compiled.is_err:
            continue
        re := compiled!
        patterns = patterns + 1
        mut j := 0
        while j < 8:
            input := random_input(r)
            old := old_search(re, input, 0)
            old_s := span_text(old)
            mut old_caps := "none"
            if old.len() >= 2:
                old_caps = group_text(input, old, re.ngroups)
                matched = matched + 1
            m := re.find(input)
            mut new_s := "none"
            if m != none:
                new_s = "{m.value().start}-{m.value().stop}"
            mut new_caps := "none"
            c := re.captures(input)
            if c != none:
                new_caps = c.value().join("|")
            old_all := old_find_all(re, input)
            new_all := new_find_all(re, input)
            same_match := re.is_match(input) == (old.len() >= 2)
            if old_s != new_s or old_caps != new_caps or old_all != new_all or not same_match:
                mismatches = mismatches + 1
                if mismatches <= 5:
                    print("mismatch: pattern={pattern} input={input} find {old_s} vs {new_s} caps {old_caps} vs {new_caps} all {old_all} vs {new_all}")
            checks = checks + 1
            j = j + 1
    print("patterns: {patterns}")
    print("checks: {checks}")
    print("with a match: {matched}")
    print("mismatches: {mismatches}")
    return 0
