import std.algo as algo
import std.collections as collections

fn main() -> Int!:
    xs := [1, 3, 5, 7, 9]
    print("bs_hit:" + algo.binary_search(xs, 5).unwrap_or(-1).to_string())
    print("bs_hit0:" + algo.binary_search(xs, 1).unwrap_or(-1).to_string())
    print("bs_miss_none:" + (algo.binary_search(xs, 4) == none).to_string())

    nums := [10, 20, 30, 40]
    hit := collections.find_index(nums, fn(n: Int) => n == 30)
    miss := collections.find_index(nums, fn(n: Int) => n == 99)
    print("fi_hit:" + hit.unwrap_or(-1).to_string())
    print("fi_hit_present:" + (hit != none).to_string())
    print("fi_miss_none:" + (miss == none).to_string())

    zero_hit := collections.find_index(nums, fn(n: Int) => n == 10)
    print("fi_zero_present:" + (zero_hit != none).to_string())
    print("fi_zero_value:" + zero_hit.unwrap_or(-1).to_string())
    return 0
