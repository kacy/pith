# scope.pith — lexical scope arena for the self-hosted type checker
#
# scopes are stored in a flat list (arena-indexed), with parent
# links as integer indices (-1 for root). bindings are stored in
# separate flat lists tagged with scope_id, avoiding nested structs.

from std.collections import copy_list

# ---------------------------------------------------------------
# scope entry — a single lexical scope (no nested collections)
# ---------------------------------------------------------------

# one lexical scope. note what is NOT here: the bindings. those live in
# flat parallel lists tagged by scope id, so a scope is just this small
# record and lookups filter the binding lists rather than walking a
# per-scope container.
#
# `parent` is the enclosing scope's id, which is how a name not found
# here is chased outward. `return_type` is the enclosing function's
# declared return type, so a `return` can be checked without carrying
# the function down the walk, and `in_loop` is what lets `break` and
# `continue` be rejected outside one.
pub struct ScopeEntry:
    pub parent: Int
    pub return_type: Int
    pub in_loop: Bool
    # true for the scope a function or lambda body opens. it marks where a
    # name search should stop: a local shadowing a MODULE name is ordinary and
    # everywhere, while one shadowing another local in the same function is
    # what the emitter cannot express, since it gives a function one slot per
    # name.
    pub is_function: Bool

# ---------------------------------------------------------------
# bindings stored flat — parallel lists tagged by scope_id
# ---------------------------------------------------------------

mut scope_entries: List[ScopeEntry] := []
mut binding_scope_ids: List[Int] := []
mut binding_names: List[String] := []
mut binding_types: List[Int] := []
mut binding_mutable_flags: List[Bool] := []
# each binding remembers which module defined it ("" for builtins and
# the entry file), so the checker can tell a name resolved through a
# genuine import from one that leaked across the shared global scope
mut binding_module_tags: List[String] := []
# each binding remembers the AST node that declared it (-1 when there is
# no source node, e.g. builtins), so tooling can answer go-to-definition
mut binding_decl_nodes: List[Int] := []
mut defining_module := ""

# name-indexed view of the arena: "scope:name" -> arena indices in
# definition order. every lookup used to scan the WHOLE arena backwards at
# every level of the scope chain, which made checking quadratic in the
# binding count of a large module closure — the single hottest cost in the
# checker. the index narrows each probe to the handful of bindings that one
# scope actually holds under that name, so a lookup costs the chain depth
# times a tiny list instead of the chain depth times every binding so far.
mut binding_index: Map[String, List[Int]] := {}

fn binding_key(scope_id: Int, name: String) -> String:
    return scope_id.to_string() + ":" + name

## set the module path tagged onto bindings defined from here on.
pub fn set_defining_module(module_path: String):
    defining_module = module_path

# reset the arena (for reuse between files)
pub fn reset_scope_arena():
    scope_entries = []
    binding_scope_ids = []
    binding_names = []
    binding_types = []
    binding_mutable_flags = []
    binding_module_tags = []
    binding_decl_nodes = []
    binding_index = {}
    defining_module = ""

# create a new scope, return its index
pub fn create_scope(parent: Int) -> Int:
    mut ret_type := -1
    mut in_lp := false
    if parent >= 0:
        p := scope_entries[parent]
        ret_type = p.return_type
        in_lp = p.in_loop
    scope_entries.push(ScopeEntry(parent, ret_type, in_lp, false))
    return scope_entries.len() - 1

# define a binding in a scope with no source node (builtins)
pub fn define_binding(scope_id: Int, name: String, type_id: Int, is_mut: Bool):
    define_binding_at(scope_id, name, type_id, is_mut, -1)

# define a binding in a scope, remembering the AST node that declared it
pub fn define_binding_at(scope_id: Int, name: String, type_id: Int, is_mut: Bool, decl_node: Int):
    binding_scope_ids.push(scope_id)
    binding_names.push(name)
    binding_types.push(type_id)
    binding_mutable_flags.push(is_mut)
    binding_module_tags.push(defining_module)
    binding_decl_nodes.push(decl_node)
    key := binding_key(scope_id, name)
    idx := binding_names.len() - 1
    if binding_index.contains_key(key):
        mut entries := binding_index[key]
        entries.push(idx)
        binding_index.insert(key, entries)
    else:
        binding_index.insert(key, [idx])

## every binding name the last run defined, builtins included, in
## definition order. tooling reads this for completion; names repeat
## when several scopes bind the same one.
pub fn all_binding_names() -> List[String]:
    mut names: List[String] := []
    for name in binding_names:
        names.push(name)
    return names

## the type id recorded for each binding, parallel to
## all_binding_names.
## every binding's declaration node, parallel to all_binding_names;
## -1 for bindings registered without a source node.
pub fn all_binding_decl_nodes() -> List[Int]:
    return binding_decl_nodes

## the type id recorded for each binding, positionally parallel to
## all_binding_names and all_binding_decl_nodes. tooling walks the
## three together and backwards, so a repeated name resolves to the
## innermost binding that shadows it. this returns a fresh copy, not
## the arena's own list.
pub fn all_binding_types() -> List[Int]:
    mut tids: List[Int] := []
    for tid in binding_types:
        tids.push(tid)
    return tids

## the module that defined the binding a lookup would find, or "".
## true when any binding of the name reachable from the scope was
## defined by the given module or by the builtins ("") — a name can
## be registered by several modules (a builtin re-exported by std),
## and local visibility means any one of them suffices.
pub fn binding_visible_from(scope_id: Int, name: String, module_path: String) -> Bool:
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        mut i := entries.len() - 1
        while i >= 0:
            tag := binding_module_tags[entries[i]]
            if tag == "" or tag == module_path:
                return true
            i = i - 1
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return binding_visible_from(entry.parent, name, module_path)
    return false

## true when the module declared a top-level binding of the name.
## the root scope is always id 0 (first created after reset); builtin
## registrations carry an empty tag and count as declared everywhere.
pub fn module_declared_top_level(name: String, module_path: String) -> Bool:
    key := binding_key(0, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        mut i := entries.len() - 1
        while i >= 0:
            tag := binding_module_tags[entries[i]]
            if tag == "" or tag == module_path:
                return true
            i = i - 1
    return false

## the type of a binding the module owns, or -1. bindings tagged with a
## different module are skipped: the global scope holds every module's
## top-level names at once, so a bare-name lookup behind `alias.name`
## would otherwise reach a function some unrelated module declared.
## builtins carry an empty tag and belong to every module.
pub fn lookup_binding_owned_by(scope_id: Int, name: String, module_path: String) -> Int:
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        mut i := entries.len() - 1
        while i >= 0:
            tag := binding_module_tags[entries[i]]
            if tag == "" or tag == module_path:
                return binding_types[entries[i]]
            i = i - 1
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return lookup_binding_owned_by(entry.parent, name, module_path)
    return -1

## the arena index of the binding a lookup from this scope would find,
## or -1. the checker uses it to retype a binding after the fact: an
## empty collection literal has no element type at its declaration, so
## the binding starts out untyped and takes its real type from the
## first value stored into it.
## true when this exact scope declares the name itself, rather than inheriting
## it from an enclosing one. the difference matters where a redeclaration is
## legal but shadowing is not.
pub fn binding_declared_in_scope(scope_id: Int, name: String) -> Bool:
    return binding_index.contains_key(binding_key(scope_id, name))

## true when an enclosing scope inside the SAME function already binds the
## name. the search stops at the function boundary, so shadowing a module-level
## name — which is ordinary, and everywhere — does not count, while shadowing
## another local in the same body does.
pub fn binding_shadows_enclosing_local(scope_id: Int, name: String) -> Bool:
    mut cur := scope_id
    while cur >= 0:
        entry := scope_entries[cur]
        if cur != scope_id:
            if binding_index.contains_key(binding_key(cur, name)):
                return true
        if entry.is_function:
            return false
        cur = entry.parent
    return false

## the index of the binding a name resolves to from this scope, or -1.
pub fn lookup_binding_index(scope_id: Int, name: String) -> Int:
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        return entries[entries.len() - 1]
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return lookup_binding_index(entry.parent, name)
    return -1

## replace the recorded type of an existing binding by arena index.
pub fn set_binding_type_at(index: Int, type_id: Int):
    if index >= 0 and index < binding_types.len():
        binding_types[index] = type_id

## the declaration node of the binding a lookup from this scope would
## find, or -1 for a builtin or an unknown name.
pub fn lookup_binding_decl_node(scope_id: Int, name: String) -> Int:
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        return binding_decl_nodes[entries[entries.len() - 1]]
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return lookup_binding_decl_node(entry.parent, name)
    return -1

## the type id bound to the name, searched in this scope and then up
## the parent chain, or -1 when no scope in the chain binds it. -1
## means the name is unknown, not that it is untyped: a binding the
## checker could not resolve is recorded as TID_ERR, which is 15.
pub fn lookup_binding(scope_id: Int, name: String) -> Int:
    # the latest binding of the name in this scope wins (shadowing), so
    # only the last index under the key matters; miss falls to the parent
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        return binding_types[entries[entries.len() - 1]]
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return lookup_binding(entry.parent, name)
    return -1

# check if a binding is mutable, walking the parent chain
pub fn is_binding_mutable(scope_id: Int, name: String) -> Bool:
    key := binding_key(scope_id, name)
    if binding_index.contains_key(key):
        entries := binding_index[key]
        return binding_mutable_flags[entries[entries.len() - 1]]
    entry := scope_entries[scope_id]
    if entry.parent >= 0:
        return is_binding_mutable(entry.parent, name)
    return false

# get the return type for the enclosing function (-1 if none)
pub fn get_scope_return_type(scope_id: Int) -> Int:
    return scope_entries[scope_id].return_type

# check if we're inside a loop
pub fn is_in_loop_scope(scope_id: Int) -> Bool:
    return scope_entries[scope_id].in_loop

# create a child scope with a specific return type
pub fn create_function_scope(parent: Int, return_type: Int) -> Int:
    mut in_lp := false
    if parent >= 0:
        in_lp = scope_entries[parent].in_loop
    scope_entries.push(ScopeEntry(parent, return_type, in_lp, true))
    return scope_entries.len() - 1

# create a child scope marked as inside a loop
pub fn create_loop_scope(parent: Int) -> Int:
    mut ret_type := -1
    if parent >= 0:
        ret_type = scope_entries[parent].return_type
    scope_entries.push(ScopeEntry(parent, ret_type, true, false))
    return scope_entries.len() - 1

# ---------------------------------------------------------------
# snapshots — the whole arena copied, for a run that resumes from it
# ---------------------------------------------------------------

# a copy of every scope and binding as they stood at one moment, so a
# later run can be put back to exactly that state rather than defining
# every imported module's bindings over again. ScopeEntry records are
# never mutated in place, so the scope list is shared one level down;
# the per-name index holds lists that grow, so those are copied.
pub struct ScopeSnapshot:
    pub entries: List[ScopeEntry]
    pub scope_ids: List[Int]
    pub names: List[String]
    pub types: List[Int]
    pub mutable_flags: List[Bool]
    pub module_tags: List[String]
    pub decl_nodes: List[Int]
    pub index: Map[String, List[Int]]
    pub module: String

fn copy_binding_index(src: Map[String, List[Int]]) -> Map[String, List[Int]]:
    mut out: Map[String, List[Int]] := {}
    for key in src.keys():
        out.insert(key, copy_list(src[key]))
    return out

# copy the arena out. the live arena keeps changing afterwards; the
# snapshot does not.
pub fn take_scope_snapshot() -> ScopeSnapshot:
    return ScopeSnapshot(copy_list(scope_entries), copy_list(binding_scope_ids), copy_list(binding_names), copy_list(binding_types), copy_list(binding_mutable_flags), copy_list(binding_module_tags), copy_list(binding_decl_nodes), copy_binding_index(binding_index), defining_module)

# make the live arena a copy of the snapshot, leaving the snapshot as it
# was so it can be restored again after the next run.
pub fn restore_scope_snapshot(s: ScopeSnapshot):
    scope_entries = copy_list(s.entries)
    binding_scope_ids = copy_list(s.scope_ids)
    binding_names = copy_list(s.names)
    binding_types = copy_list(s.types)
    binding_mutable_flags = copy_list(s.mutable_flags)
    binding_module_tags = copy_list(s.module_tags)
    binding_decl_nodes = copy_list(s.decl_nodes)
    binding_index = copy_binding_index(s.index)
    defining_module = s.module
