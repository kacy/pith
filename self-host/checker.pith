# checker.pith — semantic analysis and type checking
#
# two-pass approach:
#   pass 1 (register): walk top-level declarations, record names and
#     type signatures in the module scope.
#   pass 2 (check): walk function bodies and top-level bindings,
#     creating child scopes for functions and blocks.
#
# uses an error sentinel pattern: when a sub-expression has type
# TID_ERR, further checks are skipped to prevent cascading noise.
#
# a bare `none` is deliberately NOT that sentinel. it carries TID_NONE,
# which participates in every comparison and satisfies exactly one kind of
# target: an optional. see types_structurally_equal.
#
# all globals use c_ prefix to avoid collisions with lexer/parser
# globals in the flat C namespace.

from types import TypeInfo, ti_primitive, ti_struct, ti_enum, ti_function, ti_optional, ti_result, ti_tuple, ti_list, ti_map, ti_set, ti_task, ti_channel, add_type_info, set_type_info, get_type_count, register_type_name, register_qualified_type_name, lookup_type_id, lookup_qualified_type_id, get_type_info, get_type_name, is_numeric_type, is_integer_type, is_error_type, is_none_type, initialize_type_table, TypeTableSnapshot, take_type_table_snapshot, restore_type_table_snapshot, TID_INT, TID_UINT, TID_FLOAT, TID_BOOL, TID_STRING, TID_BYTES, TID_VOID, TID_INT8, TID_INT16, TID_INT32, TID_INT64, TID_UINT8, TID_UINT16, TID_UINT32, TID_UINT64, TID_ERR, TID_NONE, TID_FIRST_USER
from scope import reset_scope_arena, create_scope, binding_shadows_enclosing_local, define_binding, define_binding_at, lookup_binding, lookup_binding_index, lookup_binding_decl_node, set_binding_type_at, lookup_binding_owned_by, binding_visible_from, module_declared_top_level, set_defining_module, is_binding_mutable, get_scope_return_type, is_in_loop_scope, create_function_scope, create_loop_scope, ScopeSnapshot, take_scope_snapshot, restore_scope_snapshot
from ast import Node, get_node, add_node, add_leaf
from errors import Diagnostic, render_diagnostics_json
from checker_modules import module_generic_target_name, clean_import_part, module_default_alias, module_import_target_name, split_qualified_name
from checker_type_intern import intern_list_type, intern_set_type, intern_map_type, intern_task_type, intern_channel_type
from checker_builtins import register_builtin_types, builtin_scope_id, set_builtin_scope_id
from checker_diagnostics import checker_reset_diagnostics, checker_set_file_path, checker_get_diagnostics, checker_set_current_node, checker_restore_current_node, checker_current_node_index, checker_reported_at_current, report_error_at, report_error, report_error_with_fix_at, report_error_with_fix, report_warning_at, report_warning, checker_current_file_path, checker_set_reporting, checker_set_message_suffix, checker_set_severity_override, checker_begin_dedup, checker_end_dedup, DiagnosticsSnapshot, take_diagnostics_snapshot, restore_diagnostics_snapshot
from checker_interfaces import checker_interfaces_reset, register_interface_declaration_name, has_interface_declaration, take_interfaces_snapshot, restore_interfaces_snapshot
from checker_methods import checker_methods_reset, register_method_signature, has_method_declaration, get_method_declaration_index, method_tid_key, register_method_owner, clear_method_owner, method_declaration_owner, MethodsSnapshot, take_methods_snapshot, restore_methods_snapshot
from std.collections import copy_list, copy_map

# Module alias tracking - maps alias name to module path
mut module_aliases: Map[String, String] := {}

# Module exports tracking - flat list of "module_path<TAB>export_name".
# Qualified resolution currently uses scope bindings directly, so this is
# retained only as lightweight bookkeeping for future module APIs.
mut module_export_entries: List[String] := []

# Wildcard import tracking - which modules have been wildcard imported
# This enables from X import * functionality
mut wildcard_imports: List[String] := []
mut generic_named_import_entries: List[String] := []
mut generic_wildcard_import_entries: List[String] := []
mut current_checker_module_path: String := ""
mut checked_module_paths: Map[String, Bool] := {}
mut generic_inference_subst: Map[String, Int] := {}
# the value expression the arm helper just typed, or -1 for a block arm or
# an empty body. the match and select expression checkers read it straight
# after each arm, so a branch can be recorded as widening into the optional
# the arms settle on (see mark_widened_branches).
mut last_branch_value_expr := 0 - 1

# --- generic bodies walked per specialization --------------------------
# the substitution in force while a generic body is walked against one set
# of concrete types: a type parameter name resolves to the tid at the same
# position. empty outside such a walk. resolve_named_type consults it first,
# ahead of the suppression that lets a generic signature register with its
# parameters unknown — with a substitution active, a parameter name must
# never reach that arm.
mut active_subst_params: List[String] := []
mut active_subst_args: List[Int] := []
# the type arguments settled at each generic call node (inferred, or
# resolved from an explicit spelling), comma-encoded and keyed by the call
# node. rewritten on every check of the node, so inside a generic body the
# entry is the specialization most recently walked — which is the one the
# emitter is about to emit when it reads it, since it asks for that walk
# first.
pub mut generic_call_subst: Map[Int, String] := {}
# the bodies still to walk and the ones already walked. an entry is
# "F\t<decl idx>\t<self tid>\t<tids>" for a generic function or a generic
# method on a concrete owner (self tid -1 for a free function), or
# "M\t<method idx>\t<instance tid>" for a plain method of a generic struct
# against one instance it is called on. a walk can queue more, so the drain
# loops until the queue stops growing. `queued` keeps a pending entry from being pushed
# twice; `checked` keeps a walked one from being walked again in a later
# module's drain.
mut generic_body_worklist: List[String] := []
mut generic_body_queued: Map[String, Bool] := {}
mut generic_body_checked: Map[String, Bool] := {}
# how many distinct type sets each declaration has been queued at. past
# generic_body_spec_limit the declaration is reported once (E267) and queued
# no further: `f[T]` calling `f[List[T]]` would otherwise never stop.
mut generic_body_spec_counts: Map[Int, Int] := {}
generic_body_spec_limit := 64
# each generic struct instance's declaration node, so a method walked
# against the instance reads the type parameters off the declaration the
# instance was built from — never a same-named declaration in another
# module. and the module each impl method was registered from, so its body
# is walked in that module's context.
mut struct_instance_decl_idx: Map[Int, Int] := {}
mut impl_method_modules: Map[Int, String] := {}
# per-module snapshots taken as each module is checked, so a generic body
# one module declares can be walked during a later module's turn with the
# declaring module's imports, file stamp and global names in force.
mut checker_module_roots: Map[String, Int] := {}
mut checker_module_files: Map[String, String] := {}
mut checker_module_alias_lists: Map[String, String] := {}
# PITH_CHECK_GENERIC_BODIES, read once per initialize_checker. "off" leaves
# generic bodies unwalked, as pass 2 always has; "silent" walks them and
# records nothing; "count" records what the walks find as warnings, so a
# corpus can be surveyed without a build turning red; "on" records errors.
mut generic_body_check_mode := "off"

fn copy_string_map(src: Map[String, String]) -> Map[String, String]:
    mut dst: Map[String, String] := {}
    for key in src.keys():
        dst.insert(key, src[key])
    return dst

# ---------------------------------------------------------------
# checker state
# ---------------------------------------------------------------

pub mut current_scope := -1
pub mut method_type_map: Map[String, Int] := {}
# every (method key, declaration kind) pair seen so far, keyed
# "<key>#inherent" / "<key>#iface". a SAME-kind re-declaration is the E263
# duplicate; the inherent+interface pair is std/io's deliberate
# conformance idiom, so the two kinds are tracked independently.
mut method_declared_kinds: Map[String, Bool] := {}
pub mut method_visibility_map: Map[String, Bool] := {}
# whether each module function was declared `pub`, keyed by its module-qualified
# symbol. a call through a module alias consults this so a module's private
# helpers stay private; without it every function in the shared name table was
# reachable from anywhere.
pub mut function_visibility_map: Map[String, Bool] := {}
mut struct_field_default_nodes: Map[String, Int] := {}
# legacy map kept for probes; generic declaration lookup uses flat lists
pub mut generic_declaration_map: Map[String, Int] := {}
mut generic_declaration_names: List[String] := []
# the first module seen to declare a generic under each bare base name, and
# the bare base names more than one module declares. a generic base has no
# type id to key by, so every table that describes one keys by its name —
# and a bare name shared by two modules would merge the two declarations.
# see generic_base_identity for how the ambiguous ones are told apart.
mut generic_base_first_module: Map[String, String] := {}
mut ambiguous_generic_bases: Map[String, Bool] := {}
# each qualified generic key back to the bare name it was built from, for the
# few places that hold an identity and have to match it against a written name.
mut generic_identity_bare_names: Map[String, String] := {}
# the module each generic declaration was registered from, keyed by its AST
# node index, so an instantiation can name the declaration it came from.
mut generic_declaration_modules: Map[Int, String] := {}
mut checking_test_decl := false
# impl set: "Type\tInterface" -> 1
mut implementation_set: Map[String, Int] := {}
# interface base name -> its interface_decl node index, so an impl can find
# the interface's default methods (fn_decl members) to inherit.
mut interface_decl_index: Map[String, Int] := {}
# associated types: interface base name -> csv of declared type-member names.
mut interface_assoc_types: Map[String, String] := {}
# an impl's bindings, keyed "ConcreteType.Item" -> bound type TID.
mut assoc_type_binding: Map[String, Int] := {}
# the bound type's *node* (not the resolved tid), so a binding written in terms
# of the type's own generic params (`type Item = U`, `type Item = I.Item`) can
# be resolved per instance with the instance's type args substituted in.
mut assoc_type_binding_node: Map[String, Int] := {}
# ConcreteType -> csv of the associated-type names it binds, so a call site can
# substitute them (Item -> Int) when resolving a method's return/param types.
mut type_assoc_names: Map[String, String] := {}
# bindings of the impl currently being processed, consulted in resolve_named_type
# so `Item` resolves to the bound type inside that impl's methods.
mut active_assoc_bindings: Map[String, Int] := {}
# impl interface args: "Type\tIfaceBase" -> "tid1,tid2,..." (tid list as csv)
# (Pith Maps can't hold List values reliably; encode the tid list as a string.)
pub mut impl_interface_args: Map[String, String] := {}
# generic struct instance info, keyed by the instance's tid, for dispatch-time
# substitution: type_args is a csv of arg tids, base_name is the original
# (un-instantiated) struct name from which the instance was built.
pub mut struct_instance_type_args: Map[Int, String] := {}
pub mut struct_instance_base_name: Map[Int, String] := {}
# Pith's cross-module Map read is unreliable for iterating, so we also
# maintain a parallel list of instance tids that callers can use to walk
# every generic struct instantiation the program has registered.
pub mut struct_instance_tids: List[Int] := []
# names that resolve_named_type should treat as unknown without raising E202.
# used while registering methods on a generic struct so the methods can
# reference the struct's type parameters (T) without errors. dispatch
# substitutes the real types later via resolve_type_with_substitution_map.
mut suppress_unknown_type_for: Map[String, Int] := {}
# expression type cache — populated by c_check_expr, queried by codegen
pub mut expression_type_cache: Map[Int, Int] := {}
# use-site -> declaration-node map, recorded as identifiers and calls
# resolve, so editor tooling can answer go-to-definition
mut definition_of: Map[Int, Int] := {}
# argument expressions the checker accepted by widening a plain value into
# the optional its parameter declares (`f(3)` against `fn f(x: Int?)`).
# the emitter has no view of a callee's declared parameter types once the
# call name is resolved, so the decision is recorded here at the one place
# that does know it. see argument_widens_to_optional.
pub mut optional_widened_arguments: Map[Int, Bool] := {}
# bindings declared from an empty collection literal with no annotation
# (`mut tasks := []`), keyed by binding arena index, valued with the
# literal's node index. such a binding has no element type yet; the
# first push/insert/add supplies one, and the entry is dropped once the
# binding is retyped. see refine_empty_literal_binding.
mut open_empty_literal_bindings: Map[Int, Int] := {}

# ---------------------------------------------------------------
# initialization
# ---------------------------------------------------------------

# clear every piece of checker state and seed a fresh global scope with
# the builtin types and functions. call this once per check run, before
# the first c_run_module; checking several modules in one run shares the
# state deliberately, so re-initializing between them would discard the
# types the earlier modules registered.
pub fn initialize_checker(file_path: String):
    initialize_type_table()
    reset_scope_arena()
    checker_reset_diagnostics(file_path)
    method_type_map = {}
    method_declared_kinds = {}
    method_visibility_map = {}
    function_visibility_map = {}
    checker_methods_reset()
    struct_field_default_nodes = {}
    generic_declaration_map = {}
    generic_declaration_names = []
    generic_base_first_module = {}
    ambiguous_generic_bases = {}
    generic_identity_bare_names = {}
    generic_declaration_modules = {}
    checker_interfaces_reset()
    implementation_set = {}
    interface_decl_index = {}
    interface_assoc_types = {}
    assoc_type_binding = {}
    assoc_type_binding_node = {}
    type_assoc_names = {}
    active_assoc_bindings = {}
    impl_interface_args = {}
    struct_instance_type_args = {}
    struct_instance_base_name = {}
    struct_instance_tids = []
    suppress_unknown_type_for = {}
    expression_type_cache = {}
    definition_of = {}
    optional_widened_arguments = {}
    open_empty_literal_bindings = {}
    module_aliases = {}
    module_export_entries = []
    wildcard_imports = []
    generic_named_import_entries = []
    generic_wildcard_import_entries = []
    current_checker_module_path = ""
    checked_module_paths = {}
    generic_inference_subst = {}
    active_subst_params = []
    active_subst_args = []
    generic_call_subst = {}
    generic_body_worklist = []
    generic_body_queued = {}
    generic_body_checked = {}
    generic_body_spec_counts = {}
    struct_instance_decl_idx = {}
    impl_method_modules = {}
    checker_module_roots = {}
    checker_module_files = {}
    checker_module_alias_lists = {}
    # on by default: a fault inside a generic body is an error, reported at
    # its line with the specialization it was found at. the walk also
    # registers a generic struct instance first made inside a generic body
    # before any emission starts, and records the call-site type arguments
    # the emitter's own re-check reads. `silent` keeps the walk and drops the
    # reports; `count` records them as warnings; `off` skips the walk.
    generic_body_check_mode = env_opt("PITH_CHECK_GENERIC_BODIES").unwrap_or("on")
    current_scope = create_scope(-1)
    register_builtin_types(current_scope)

# name the module whose AST is about to be checked, so its types,
# generics and function visibility get registered under a qualified name
# rather than a bare one. drivers call this before each imported
# module's c_run_module, then pass "" for the root file being compiled —
# an empty path means "not inside a module" and turns the qualified
# lookups off. it also records the path in the set of modules this run
# has seen, which is what lets the E246 phantom-import check fire (an
# import naming something the source module never declares) and what
# lets a type be found by module basename later.
pub fn set_checker_module_path(module_path: String):
    checked_module_paths.insert(module_path, true)
    current_checker_module_path = module_path
    set_defining_module(module_path)

# set the path stamped on diagnostics raised from here on. a single
# check run walks several modules, so this has to be updated alongside
# set_checker_module_path or every error will be reported against
# whichever file was named last.
pub fn set_checker_file_path(file_path: String):
    checker_set_file_path(file_path)

# Register an import alias for module namespace resolution
pub fn register_import_alias(alias: String, module_path: String):
    module_aliases.insert(alias, module_path)

# Process import declarations from AST and register aliases
pub fn process_import_aliases(root_idx: Int):
    root := get_node(root_idx)
    for child in root.children:
        node := get_node(child)
        mut kind := node.kind
        mut value := node.value
        if kind == "pub":
            if node.children.len() > 0:
                inner := get_node(node.children[0])
                kind = inner.kind
                value = inner.value
        if kind == "import":
            # Parse "path" or "path as alias"
            mut path := value
            mut has_alias := false
            mut alias := ""
            mut si := 0
            while si < value.len() - 3:
                if ord(value[si]) == 32:
                    if ord(value[si + 1]) == 97:
                        if ord(value[si + 2]) == 115:
                            if ord(value[si + 3]) == 32:
                                path = value.substring(0, si)
                                alias = value.substring(si + 4, value.len())
                                has_alias = true
                                break
                si = si + 1
            if has_alias:
                register_import_alias(alias, path)
            else:
                register_import_alias(module_default_alias(path), path)
        elif kind == "from_import":
            # Parse "path name1 name2 ..." or "path *" for wildcard
            mut parts: List[String] := []
            mut part_start := 0
            mut i := 0
            while i <= value.len():
                mut at_boundary := false
                if i == value.len():
                    at_boundary = true
                elif ord(value[i]) == 32:
                    at_boundary = true
                if at_boundary:
                    if part_start < i:
                        parts.push(value.substring(part_start, i))
                    part_start = i + 1
                i = i + 1

            if parts.len() > 0:
                mod_path := parts[0]
                # Check for wildcard import (second part is "*")
                if parts.len() > 1:
                    if parts[1] == "*":
                        wildcard_imports.push(mod_path)
                        generic_wildcard_import_entries.push(current_checker_module_path + chr(9) + mod_path)
                    else:
                        mut pi := 1
                        while pi < parts.len():
                            imported_name := clean_import_part(parts[pi])
                            if imported_name.len() > 0:
                                # a phantom import (a name the source module never
                                # declares) otherwise sails through and dies much
                                # later as a silent unknown call in the backend.
                                # only enforced for modules this run has actually
                                # registered, so single-file checks stay quiet.
                                if checked_module_paths.contains_key(mod_path):
                                    # generic functions never define a binding; they
                                    # live only in the generic declaration map under
                                    # their module-qualified name. interfaces and type
                                    # names register globally without a module tag, so
                                    # for those only existence can be checked.
                                    mut declared := module_declared_top_level(imported_name, mod_path)
                                    if declared == false:
                                        declared = generic_declaration_map.contains_key(module_generic_target_name(mod_path, imported_name))
                                    if declared == false:
                                        declared = has_interface_declaration(imported_name)
                                    if declared == false:
                                        declared = lookup_type_id(imported_name) >= 0
                                    if declared == false:
                                        report_error_with_fix_at(child, "E246", "'" + imported_name + "' is not declared by module '" + mod_path + "'", "import it from the module that defines it")
                                generic_named_import_entries.push(current_checker_module_path + chr(9) + imported_name + chr(9) + mod_path)
                            pi = pi + 1

# one type argument, spelled so the spelling names the type. get_type_name
# answers with the bare kind for every unnamed composite — "List" for every
# list, "Map" for every map, "optional" for every optional — so an instance
# named from it keyed Holder[List[Int]] and Holder[List[String]] alike, and
# whichever was built first handed the other its field types. spelling the
# element out separates them.
#
# a named leaf (a struct, an enum, a primitive) already names itself, so it
# comes back exactly as before: an instance over named arguments only keeps
# the name it has always had, and the symbols built from that name do not
# move. the composite spellings use only letters, digits and the bracket and
# comma that ir_sanitize_symbol already folds to underscores, which is why
# `?`, `!` and the arrow do not appear here even where they would read better.
fn instance_type_arg_name(tid: Int) -> String:
    if tid < 0:
        return get_type_name(tid)
    info := get_type_info(tid)
    if info.kind == "list":
        return "List[" + instance_type_arg_name(info.inner) + "]"
    if info.kind == "set":
        return "Set[" + instance_type_arg_name(info.inner) + "]"
    if info.kind == "task":
        return "Task[" + instance_type_arg_name(info.inner) + "]"
    if info.kind == "channel":
        return "Channel[" + instance_type_arg_name(info.inner) + "]"
    if info.kind == "map":
        return "Map[" + instance_type_arg_name(info.key_type) + "," + instance_type_arg_name(info.value_type) + "]"
    if info.kind == "optional":
        return "optional[" + instance_type_arg_name(info.inner) + "]"
    if info.kind == "result":
        return "result[" + instance_type_arg_name(info.value_type) + "," + instance_type_arg_name(info.inner) + "]"
    if info.kind == "tuple":
        mut elems: List[String] := []
        for e in info.elements:
            elems.push(instance_type_arg_name(e))
        return "tuple[" + elems.join(",") + "]"
    if info.kind == "function":
        mut params: List[String] := []
        for pt in info.param_types:
            params.push(instance_type_arg_name(pt))
        return "fn[" + params.join(",") + "][" + instance_type_arg_name(info.return_type) + "]"
    return get_type_name(tid)

# build an instantiation name like "Pair[Int,String]"
fn build_instantiated_type_name(base: String, type_args: List[Int]) -> String:
    mut result := base + "["
    for arg, i in type_args:
        if i > 0:
            result = result + ","
        result = result + instance_type_arg_name(arg)
    result = result + "]"
    return result

# ---------------------------------------------------------------
# type resolution — resolve AST type expression nodes to TypeIds
# ---------------------------------------------------------------

mut type_resolve_depth := 0

# resolve a type expression node, with optional generic substitution
# subst_active: if true, subst_params/subst_args provide substitution
fn resolve_type_implementation(node_idx: Int) -> Int:
    if node_idx < 0:
        return TID_ERR
    type_resolve_depth = type_resolve_depth + 1
    if type_resolve_depth > 128:
        type_resolve_depth = type_resolve_depth - 1
        report_error("E233", "type nesting too deep")
        return TID_ERR
    node := get_node(node_idx)
    mut result := TID_ERR
    if node.kind == "type":
        result = resolve_named_type(node.value)
    elif node.kind == "generic_type":
        result = resolve_generic_type_from_node(node)
    elif node.kind == "optional_type":
        inner := resolve_type_implementation(node.children[0])
        if is_error_type(inner):
            result = TID_ERR
        else:
            result = add_type_info(ti_optional(inner))
    elif node.kind == "result_type":
        ok := resolve_type_implementation(node.children[0])
        mut err_tid := TID_STRING
        if node.children.len() > 1:
            err_tid = resolve_type_implementation(node.children[1])
        result = add_type_info(ti_result(ok, err_tid))
    elif node.kind == "tuple_type":
        mut elems: List[Int] := []
        for child in node.children:
            elems.push(resolve_type_implementation(child))
        result = add_type_info(ti_tuple(elems))
    elif node.kind == "fn_type":
        mut params: List[Int] := []
        mut ret := TID_VOID
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "param":
                params.push(resolve_type_implementation(cn.children[0]))
            elif cn.kind == "returns":
                ret = resolve_type_implementation(cn.children[0])
        result = add_type_info(ti_function(params, ret))
    type_resolve_depth = type_resolve_depth - 1
    return result

fn resolve_imported_type_name(name: String) -> String:
    parts := split_qualified_name(name)
    alias := parts.0
    member := parts.1
    if member == "":
        return name
    if module_aliases.contains_key(alias):
        module_path := module_aliases[alias]
        target := module_import_target_name(module_path, member)
        if lookup_type_id(target) >= 0:
            return target
        if lookup_type_id(member) >= 0:
            return member
    return name

# resolve a type name to the declaration that is actually in scope, honoring
# module boundaries. the global type table (tt_names) is a single namespace, so
# two modules that declare a struct of the same name overwrite each other there.
# this consults the module-qualified table first: a bare name binds to the
# current module's own struct, and an `alias.Type` binds to the aliased module's
# struct. returns -1 when no module-scoped entry applies, so the caller falls
# back to the global table (builtins and single-definition types resolve there).
fn resolve_type_name_module_scoped(name: String) -> Int:
    parts := split_qualified_name(name)
    alias := parts.0
    member := parts.1
    if member != "" and module_aliases.contains_key(alias):
        # `alias.Type` — bind to the aliased module's own declaration, never to
        # whatever module last registered this name into the global table.
        module_path := module_aliases[alias]
        by_import_name := lookup_qualified_type_id(module_path, module_import_target_name(module_path, member))
        if by_import_name >= 0:
            return by_import_name
        return lookup_qualified_type_id(module_path, member)
    if member == "" and current_checker_module_path.len() > 0:
        # a bare name — prefer the current module's own declaration.
        return lookup_qualified_type_id(current_checker_module_path, name)
    return -1

# last resort for an `alias.Type` whose alias is not one of ours. it happens
# when a type crosses two module boundaries: std.sql returns a
# `decimal.Decimal`, spelled with std.sql's own alias for std.decimal, and that
# spelling reaches a caller who imported std.decimal under a different name.
# by then the defining module's alias table is gone, so fall back to reading
# the alias as a module basename and looking the member up there.
#
# only reached where the name would otherwise be an unknown-type error, so it
# can turn a failure into a success but never change a program that compiles.
# a basename shared by two modules is resolved by which of them declares the
# member; if both do, the caller had no alias to disambiguate with anyway.
#
# the cost is a little permissiveness: writing `decimal.Decimal` in a file that
# imported the module under another name, or under none, now resolves instead of
# erroring. requiring the file to import the module under some alias would close
# that, but it would also stop a caller from holding a value whose type it never
# names — reading a `row.decimal(...)` without importing std.decimal at all —
# which is the more common of the two.
fn resolve_type_by_module_basename(name: String) -> Int:
    parts := split_qualified_name(name)
    alias := parts.0
    member := parts.1
    if member == "":
        return -1
    suffix := "." + alias
    for module_path in checked_module_paths.keys():
        if module_path == alias or module_path.ends_with(suffix):
            found := lookup_qualified_type_id(module_path, member)
            if found >= 0:
                return found
    return -1

fn resolve_named_type(name: String) -> Int:
    # a generic body walked against concrete types: its type parameters
    # resolve to those types before anything else is consulted, and a
    # dotted `T.Item` resolves through the concrete type's own binding
    if active_subst_params.len() > 0:
        for sp, si in active_subst_params:
            if sp == name:
                return active_subst_args[si]
        if name.contains("."):
            sparts := name.split(".")
            if sparts.len() == 2:
                for sp, si in active_subst_params:
                    if sp == sparts[0]:
                        assoc := resolve_assoc_type_of_instance(active_subst_args[si], sparts[1])
                        if is_error_type(assoc) == false:
                            return assoc
    # an associated type name resolves to the binding of the impl currently
    # being processed (e.g. `Item` -> `Int` inside `impl Container for IntBox`)
    if active_assoc_bindings.contains_key(name):
        return active_assoc_bindings[name]
    # a dotted `T.Item` where T is a suppressed generic param isn't a real type
    # yet — dispatch substitutes T and resolves the binding later
    if name.contains("."):
        dparts := name.split(".")
        if dparts.len() == 2 and suppress_unknown_type_for.contains_key(dparts[0]):
            return TID_ERR
    # module-scoped resolution wins so same-named structs in different modules
    # never collide; it falls through to the global table when it doesn't apply.
    scoped := resolve_type_name_module_scoped(name)
    if scoped >= 0:
        return scoped
    resolved_name := resolve_imported_type_name(name)
    tid := lookup_type_id(resolved_name)
    if tid < 0:
        # methods on a generic struct can reference the struct's type params
        # (T, U, ...) — at registration time those aren't real types yet, but
        # dispatch will re-resolve them with substitution
        if suppress_unknown_type_for.contains_key(resolved_name):
            return TID_ERR
        recovered := resolve_type_by_module_basename(name)
        if recovered >= 0:
            return recovered
        report_error("E202", "unknown type: " + name)
        return TID_ERR
    return tid

fn resolve_generic_type_from_node(node: Node) -> Int:
    base := resolve_imported_type_name(node.value)
    mut type_args: List[Int] := []
    for child in node.children:
        type_args.push(resolve_type_implementation(child))
    return resolve_generic_type(base, type_args)

# a set element and a map key are hashed, and the containers hash exactly two
# flavors: int and string. an int-family element takes the int flavor and a
# String the string flavor; every other type used to fall into one of the two
# anyway and misbehaved silently — the string flavor read whatever the value's
# word pointed at as a c-string, so distinct lists and bytes collapsed into
# one entry through their allocation headers, a struct compared raw memory
# bytes, a plain enum inserted nothing at all, and a float crashed the
# process. the phrase names what was written so the message reads back the
# source ("an optional", "a list", "Bytes"), and "" means the type is
# hashable — or not yet concrete: a generic parameter passes here and is
# judged again at each instantiation, where it has a concrete type.
fn unhashable_component_phrase(tid: Int) -> String:
    if tid < 0:
        return ""
    info := get_type_info(tid)
    if info.kind == "optional":
        return "an optional"
    if info.kind == "list" or info.kind == "map" or info.kind == "set":
        return "a " + info.kind
    if info.kind == "struct":
        return "a struct"
    if info.kind == "enum":
        return "an enum"
    if info.kind == "function":
        return "a function value"
    if info.kind == "tuple":
        return "a tuple"
    if info.kind == "task":
        return "a task"
    if info.kind == "channel":
        return "a channel"
    if info.kind == "result":
        return "a result"
    if info.kind == "primitive":
        if info.name == "Bytes":
            return "Bytes"
        if info.name == "Float":
            return "Float"
        if info.name == "Bool":
            return "Bool"
    return ""

# rather than build a container that loses data, an unhashable type is
# rejected wherever a set element or map key type is formed — annotation,
# inferred literal, an empty literal's first typed store, and a generic
# instantiation, which is the one path with no node to point at.
fn reject_unhashable_component(node_idx: Int, tid: Int, position: String) -> Bool:
    phrase := unhashable_component_phrase(tid)
    if phrase.len() == 0:
        return false
    mut msg := phrase + " cannot be " + position + "; a set element and a map key hash int and string flavors only"
    if get_type_info(tid).kind == "optional":
        msg = "an optional cannot be " + position + "; store List[T?] or key by the payload instead"
    if node_idx >= 0:
        report_error_at(node_idx, "E254", msg)
    else:
        report_error("E254", msg)
    return true

fn resolve_generic_type(base: String, type_args: List[Int]) -> Int:
    # builtin generic types
    if strings_equal(base, "List"):
        if type_args.len() != 1:
            report_error("E221", "List expects 1 type argument, got " + type_args.len().to_string())
            return TID_ERR
        return intern_list_type(type_args[0])
    if strings_equal(base, "Set"):
        if type_args.len() != 1:
            report_error("E221", "Set expects 1 type argument, got " + type_args.len().to_string())
            return TID_ERR
        if reject_unhashable_component(0 - 1, type_args[0], "a set element type"):
            return TID_ERR
        return intern_set_type(type_args[0])
    if strings_equal(base, "Map"):
        if type_args.len() != 2:
            report_error("E221", "Map expects 2 type arguments, got " + type_args.len().to_string())
            return TID_ERR
        if reject_unhashable_component(0 - 1, type_args[0], "a map key type"):
            return TID_ERR
        return intern_map_type(type_args[0], type_args[1])
    if strings_equal(base, "Task"):
        if type_args.len() != 1:
            report_error("E221", "Task expects 1 type argument, got " + type_args.len().to_string())
            return TID_ERR
        return intern_task_type(type_args[0])
    if strings_equal(base, "Channel"):
        if type_args.len() != 1:
            report_error("E221", "Channel expects 1 type argument, got " + type_args.len().to_string())
            return TID_ERR
        return intern_channel_type(type_args[0])
    # user-defined generic types
    if has_generic_declaration(base):
        decl_idx := get_generic_declaration_index(base)
        return instantiate_generic_type(decl_idx, type_args)
    report_error("E202", "unknown generic type: " + base)
    return TID_ERR

# resolve the associated type `member` of a concrete or generic-instance type.
# for a concrete impl (IntBox.Item = Int) this is just the bound type; for a
# generic instance (MapIter[Range,Int].Item = U) the binding is resolved with
# the instance's type args substituted in, which recurses for `I.Item` bindings.
fn resolve_assoc_type_of_instance(inst_tid: Int, member: String) -> Int:
    if inst_tid < 0:
        return TID_ERR
    base := extract_base_type_name(get_type_name(inst_tid))
    bkey := base + "." + member
    if assoc_type_binding_node.contains_key(bkey) == false:
        return TID_ERR
    binding_node := assoc_type_binding_node[bkey]
    mut params: List[String] := []
    mut args: List[Int] := []
    if struct_instance_type_args.contains_key(inst_tid):
        args = decode_tid_list(struct_instance_type_args[inst_tid])
        if has_generic_declaration(base):
            bdecl := get_node(get_generic_declaration_index(base))
            params = collect_generic_parameter_names(bdecl)
    return resolve_type_with_substitution_map(binding_node, params, args)

# resolve with a substitution map for generic params
fn resolve_type_with_substitution_map(node_idx: Int, subst_params: List[String], subst_args: List[Int]) -> Int:
    if node_idx < 0:
        return TID_ERR
    node := get_node(node_idx)
    if node.kind == "type":
        # a dotted `T.Item`: substitute T to its concrete type, then resolve
        # that type's associated-type binding through the instance (which
        # recurses when the binding is itself another type's associated type)
        if node.value.contains("."):
            dparts := node.value.split(".")
            if dparts.len() == 2:
                mut bi := 0
                for p in subst_params:
                    if strings_equal(p, dparts[0]):
                        if bi < subst_args.len():
                            resolved := resolve_assoc_type_of_instance(subst_args[bi], dparts[1])
                            if is_error_type(resolved) == false:
                                return resolved
                        bi = bi + 1
        # check if this type name is a generic param that should be substituted
        mut i := 0
        for p in subst_params:
            if strings_equal(p, node.value):
                if i < subst_args.len():
                    return subst_args[i]
                return TID_ERR
            i = i + 1
        return resolve_named_type(node.value)
    if node.kind == "generic_type":
        mut type_args: List[Int] := []
        for child in node.children:
            type_args.push(resolve_type_with_substitution_map(child, subst_params, subst_args))
        return resolve_generic_type(node.value, type_args)
    if node.kind == "optional_type":
        inner := resolve_type_with_substitution_map(node.children[0], subst_params, subst_args)
        if is_error_type(inner):
            return TID_ERR
        return add_type_info(ti_optional(inner))
    if node.kind == "result_type":
        ok := resolve_type_with_substitution_map(node.children[0], subst_params, subst_args)
        mut err_tid := TID_STRING
        if node.children.len() > 1:
            err_tid = resolve_type_with_substitution_map(node.children[1], subst_params, subst_args)
        return add_type_info(ti_result(ok, err_tid))
    if node.kind == "tuple_type":
        mut elems: List[Int] := []
        for child in node.children:
            elems.push(resolve_type_with_substitution_map(child, subst_params, subst_args))
        return add_type_info(ti_tuple(elems))
    if node.kind == "fn_type":
        mut params: List[Int] := []
        mut ret := TID_VOID
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "param":
                params.push(resolve_type_with_substitution_map(cn.children[0], subst_params, subst_args))
            elif cn.kind == "returns":
                ret = resolve_type_with_substitution_map(cn.children[0], subst_params, subst_args)
        return add_type_info(ti_function(params, ret))
    return TID_ERR

# ---------------------------------------------------------------
# pass 1 — declaration registration
# ---------------------------------------------------------------

# pass 1: put every top-level name in this module — functions, structs,
# enums, interfaces, impls, type aliases — into scope before any body is
# checked, so declarations can refer to each other in any order. globals
# (`binding` nodes) and test blocks are deliberately left to pass 2.
# run this before c_check_all; checking a body first would report the
# names below it as unknown.
pub fn c_register_all(root_idx: Int):
    root := get_node(root_idx)
    for child in root.children:
        register_top_level_declarations(child)
    # with every interface and impl now registered, let impls inherit any
    # interface default methods they did not override
    for child in root.children:
        fill_interface_defaults_for(child)

fn register_top_level_declarations(node_idx: Int):
    node := get_node(node_idx)
    if node.kind == "pub":
        register_declaration(node.children[0], true)
    elif node.kind == "from_import":
        # imports not handled in single-file mode
        return
    elif node.kind == "import":
        return
    else:
        register_declaration(node_idx, false)

fn register_declaration(node_idx: Int, is_pub: Bool):
    node := get_node(node_idx)
    if node.kind == "threadlocal":
        # a threadlocal global is an ordinary module global to the checker; the
        # wrapper is only a storage marker the emitter reads.
        register_declaration(node.children[0], is_pub)
        return
    if node.kind == "fn_decl":
        register_function_declaration(node_idx, node, is_pub)
    elif node.kind == "struct_decl":
        register_struct_declaration(node_idx, node)
    elif node.kind == "enum_decl":
        register_enum_declaration(node_idx, node)
    elif node.kind == "interface_decl":
        register_interface_declaration(node_idx, node)
    elif node.kind == "impl_decl":
        register_implementation_declaration(node_idx, node)
    elif node.kind == "type_alias":
        register_type_alias_declaration(node)
    elif node.kind == "binding":
        # handled in pass 2
        return
    elif node.kind == "test_decl":
        # no names to register
        return

# ---------------------------------------------------------------
# pass 1 — function declarations
# ---------------------------------------------------------------

# whether `name` may be called from outside `module_path`. a name the checker
# never saw declared there is left alone: single-file mode registers nothing,
# and the builtin std modules that get symbol-prefixed rather than
# module-qualified are not in the table either. only a function it positively
# knows is private is refused.
fn module_function_is_visible(module_path: String, name: String) -> Bool:
    if module_path == current_checker_module_path:
        return true
    key := module_generic_target_name(module_path, name)
    if not function_visibility_map.contains_key(key):
        return true
    return function_visibility_map[key]

fn register_function_declaration(node_idx: Int, node: Node, is_pub: Bool):
    name := node.value
    if current_checker_module_path.len() > 0:
        function_visibility_map.insert(module_generic_target_name(current_checker_module_path, name), is_pub)
    if declaration_has_generic_params(node):
        register_generic_declaration(name, node_idx)
        return
    # resolve function signature
    fn_tid := resolve_function_signature(node)
    if fn_tid >= 0:
        define_binding_at(current_scope, name, fn_tid, false, node_idx)
        if current_checker_module_path.len() > 0:
            define_binding_at(current_scope, module_generic_target_name(current_checker_module_path, name), fn_tid, false, node_idx)

fn resolve_function_signature(node: Node) -> Int:
    mut params: List[Int] := []
    mut ret := TID_VOID
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                ptid := resolve_type_implementation(cn.children[0])
                params.push(ptid)
            else:
                report_error("E230", "parameter requires a type annotation")
                params.push(TID_ERR)
        elif cn.kind == "returns":
            ret = resolve_type_implementation(cn.children[0])
    return add_type_info(ti_function(params, ret))

# ---------------------------------------------------------------
# pass 1 — struct declarations
# ---------------------------------------------------------------

# a weak field must be an optional reference to a struct — that is the only
# thing weak can meaningfully not-own, and the only shape a cycle forms through.
# reading one back as T? relies on the optional machinery, so the type must be
# `SomeStruct?`.
fn check_weak_field(fname: String, ftid: Int):
    if is_error_type(ftid):
        return
    info := get_type_info(ftid)
    if info.kind == "optional" and info.inner >= 0 and get_type_info(info.inner).kind == "struct":
        return
    report_error("E249", "weak field '" + fname + "' must be an optional struct type (T?)")

# builtin type names the compiler special-cases. a user struct or enum that
# reuses one of these silently shadows the builtin and miscompiles anything that
# relies on it — e.g. a `struct Channel` corrupts every `Channel[T]` in scope, so
# an imported module's internal channels stop working with no error. reject the
# name instead of letting it shadow.
fn is_reserved_type_name(name: String) -> Bool:
    reserved := ["Int", "Float", "Bool", "String", "Bytes", "Void", "List", "Map", "Channel", "Task", "Mutex", "WaitGroup", "Semaphore", "AtomicInt"]
    for r in reserved:
        if strings_equal(name, r):
            return true
    return false

# register a user-declared type name both globally and under the module that
# declared it. the qualified entry lets resolve_named_type prefer this module's
# own struct over a same-named struct another module registered into the shared
# global table.
fn register_module_type_name(name: String, tid: Int):
    register_type_name(name, tid)
    register_qualified_type_name(current_checker_module_path, name, tid)

fn register_struct_declaration(node_idx: Int, node: Node):
    name := node.value
    if is_reserved_type_name(name):
        report_error_at(node_idx, "E250", "'" + name + "' is a builtin type name and cannot be used as a struct name")
        return
    if declaration_has_generic_params(node):
        register_generic_declaration(name, node_idx)
        define_binding_at(current_scope, name, TID_ERR, false, node_idx)
        return
    base_name := name
    # register the name first, with a placeholder, so a field can reference the
    # struct's own type (a self-referential `next: Node?`). the real fields fill
    # in once every field type is resolved below.
    mut empty_names: List[String] := []
    mut empty_ints: List[Int] := []
    mut empty_bools: List[Bool] := []
    tid := add_type_info(ti_struct(base_name, empty_names, empty_ints, empty_bools, empty_bools))
    register_module_type_name(base_name, tid)
    define_binding_at(current_scope, base_name, tid, false, node_idx)
    # non-generic: resolve field types immediately
    mut field_names: List[String] := []
    mut field_types: List[Int] := []
    mut field_pub: List[Bool] := []
    mut field_mut: List[Bool] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "field":
            fname := extract_field_name(cn.value)
            is_pub := cn.value.contains(" pub")
            is_mut := cn.value.contains(" mut")
            field_names.push(fname)
            if cn.children.len() > 0:
                ftid := resolve_type_implementation(cn.children[0])
                field_types.push(ftid)
                if cn.value.contains(" weak"):
                    check_weak_field(fname, ftid)
                if cn.children.len() > 1:
                    default_tid := c_check_expr(cn.children[1], current_scope)
                    if optional_target_accepts_value(cn.children[1], default_tid, ftid):
                        struct_field_default_nodes.insert(base_name + "." + fname, cn.children[1])
                    elif is_error_type(default_tid) == false and default_tid != ftid:
                        if types_structurally_equal(default_tid, ftid) == false:
                            report_error("E219", "default for field '" + fname + "' must be " + get_type_name(ftid) + ", got " + get_type_name(default_tid))
                        else:
                            struct_field_default_nodes.insert(base_name + "." + fname, cn.children[1])
                    else:
                        struct_field_default_nodes.insert(base_name + "." + fname, cn.children[1])
            else:
                field_types.push(TID_ERR)
            field_pub.push(is_pub)
            field_mut.push(is_mut)
    set_type_info(tid, ti_struct(base_name, field_names, field_types, field_pub, field_mut))

# ---------------------------------------------------------------
# pass 1 — enum declarations
# ---------------------------------------------------------------

fn register_enum_declaration(node_idx: Int, node: Node):
    name := node.value
    if is_reserved_type_name(name):
        report_error_at(node_idx, "E250", "'" + name + "' is a builtin type name and cannot be used as an enum name")
        return
    if declaration_has_generic_params(node):
        register_generic_declaration(name, node_idx)
        define_binding_at(current_scope, name, TID_ERR, false, node_idx)
        return
    base_name := name
    # non-generic: resolve variant types immediately
    mut variant_names: List[String] := []
    mut variant_types: List[List[Int]] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "variant":
            variant_names.push(cn.value)
            mut vtypes: List[Int] := []
            for vc in cn.children:
                vtypes.push(resolve_type_implementation(vc))
            variant_types.push(vtypes)
    tid := add_type_info(ti_enum(base_name, variant_names, variant_types))
    register_module_type_name(base_name, tid)
    define_binding_at(current_scope, base_name, tid, false, node_idx)

# ---------------------------------------------------------------
# pass 1 — interface declarations
# ---------------------------------------------------------------

fn register_interface_declaration(node_idx: Int, node: Node):
    base_name := node.value
    mut name := base_name
    mut generic_names: List[String] := []
    mut assoc_names: List[String] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "generic_param":
            generic_names.push(cn.value)
        elif cn.kind == "assoc_type":
            assoc_names.push(cn.value)
    if assoc_names.len() > 0:
        interface_assoc_types.insert(base_name, assoc_names.join(","))
    if generic_names.len() > 0:
        name = build_interface_type_name(name, generic_names)
    # register as a zero-field struct in type table (so it's resolvable)
    mut empty_s: List[String] := []
    mut empty_i: List[Int] := []
    mut empty_b: List[Bool] := []
    tid := add_type_info(ti_struct(name, empty_s, empty_i, empty_b, empty_b))
    register_type_name(name, tid)
    if generic_names.len() > 0:
        register_type_name(base_name, tid)
        register_interface_declaration_name(base_name)
    register_interface_declaration_name(name)
    # remember the node so impls can find this interface's default methods
    interface_decl_index.insert(base_name, node_idx)

# ---------------------------------------------------------------
# pass 1 — impl declarations
# ---------------------------------------------------------------

fn register_implementation_declaration(node_idx: Int, node: Node):
    # children[0] is the target type (or interface type if "impl X for Y:")
    # optional for_type node follows
    # then method fn_decls
    first_type_node := get_node(node.children[0])
    mut concrete_name := ""
    mut interface_name := ""
    mut iface_base := ""
    mut method_start := 1

    # check if there's a for_type node
    if node.children.len() > 1:
        second_node := get_node(node.children[1])
        if second_node.kind == "for_type":
            # impl Interface for Type:
            interface_name = get_type_node_name(first_type_node)
            for_inner := get_node(second_node.children[0])
            concrete_name = get_type_node_name(for_inner)
            method_start = 2
            iface_base = iface_type_base_name(first_type_node)
        else:
            concrete_name = get_type_node_name(first_type_node)
    else:
        concrete_name = get_type_node_name(first_type_node)

    if concrete_name == "":
        return

    # when the impl targets a generic base, file every entry below under the
    # declaring module's key as well as the bare one. an instance of a generic
    # whose bare name two modules share is named from that key, so this is what
    # its dispatch, interface and associated-type lookups find; the bare entry
    # stays for every program where the name is unambiguous. see
    # generic_base_alias_key for why the choice cannot be made here.
    generic_alias := generic_base_alias_key(concrete_name)

    if iface_base != "":
        # record in impl set, keyed on base names so generic instances
        # (FilterIter[Range, Int]) find the impl registered for FilterIter
        key := concrete_name + chr(9) + iface_base
        implementation_set.insert(key, 1)
        # also record the impl's interface-arg encoding (per-arg "tid:N" or
        # "param:N" — see encode_impl_iface_args) so bound-based inference
        # can recover the args and substitute the receiver's instance args
        impl_interface_args.insert(key, encode_impl_iface_args(concrete_name, first_type_node))
        if generic_alias != "":
            alias_key := generic_alias + chr(9) + iface_base
            implementation_set.insert(alias_key, 1)
            impl_interface_args.insert(alias_key, impl_interface_args[key])

    # if this impl is for a generic struct, suppress `unknown type` errors for
    # the struct's type parameters while registering its methods so signatures
    # like `fn next() -> T?` resolve cleanly. dispatch substitutes T later.
    mut suppressed_params: List[String] := []
    if has_generic_declaration(concrete_name):
        gdecl := get_node(get_generic_declaration_index(concrete_name))
        suppressed_params = collect_generic_parameter_names(gdecl)
        for sp in suppressed_params:
            suppress_unknown_type_for.insert(sp, 1)

    # collect associated-type bindings first, so the interface's method
    # signatures (`-> Item`) resolve to the bound type as methods register
    active_assoc_bindings = {}
    mut assoc_names_for_type: List[String] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "assoc_type_bind":
            bound_tid := resolve_type_implementation(cn.children[0])
            active_assoc_bindings.insert(cn.value, bound_tid)
            assoc_type_binding.insert(concrete_name + "." + cn.value, bound_tid)
            assoc_type_binding_node.insert(concrete_name + "." + cn.value, cn.children[0])
            if generic_alias != "":
                assoc_type_binding.insert(generic_alias + "." + cn.value, bound_tid)
                assoc_type_binding_node.insert(generic_alias + "." + cn.value, cn.children[0])
            assoc_names_for_type.push(cn.value)
    if assoc_names_for_type.len() > 0:
        type_assoc_names.insert(concrete_name, assoc_names_for_type.join(","))
        if generic_alias != "":
            type_assoc_names.insert(generic_alias, assoc_names_for_type.join(","))

    # register each method (skip first method_start children)
    mut skip := method_start
    for child in node.children:
        if skip > 0:
            skip = skip - 1
            continue
        mut cn := get_node(child)
        mut method_node_idx := child
        mut method_is_pub := false
        if cn.kind == "pub":
            method_is_pub = true
            method_node_idx = cn.children[0]
            cn = get_node(method_node_idx)
        if cn.kind == "fn_decl":
            method_params := suppress_method_type_params(concrete_name, cn)
            register_method_declaration_aliased(concrete_name, generic_alias, method_node_idx, cn, method_is_pub, interface_name != "")
            release_method_type_params(method_params)
            impl_method_modules.insert(method_node_idx, current_checker_module_path)
    active_assoc_bindings = {}

    # clear the suppression for the next impl block
    for sp in suppressed_params:
        suppress_unknown_type_for.remove(sp)

# a method may carry type parameters of its own (`fn run[T](v: T) -> T`).
# they are not real types while the signature registers — the call site fixes
# them — so suppress them exactly the way an impl on a generic struct
# suppresses the struct's parameters. only names this call introduced are
# returned, so lifting the suppression afterwards cannot drop a name the
# enclosing impl block owns.
#
# on a generic owner the two lists compose: the owner's parameters are fixed
# by the receiver's instance and the method's by the call, and the body is
# walked once per combination (c_check_specialization). the composition
# substitutes by name, so a method parameter spelled like one of the owner's
# would silently resolve to the owner's type everywhere it is written; that
# spelling is refused (E265) rather than composed.
fn suppress_method_type_params(owner_name: String, method_node: Node) -> List[String]:
    mut added: List[String] := []
    if declaration_has_generic_params(method_node) == false:
        return added
    mut owner_params: List[String] := []
    if has_generic_declaration(owner_name):
        owner_params = collect_generic_parameter_names(get_node(get_generic_declaration_index(owner_name)))
    for name in collect_generic_parameter_names(method_node):
        if owner_params.contains(name):
            report_error_at(first_generic_param_index(method_node), "E265", "generic method '" + method_node.value + "' on generic type '" + owner_name + "' reuses its owner's type parameter name '" + name + "'; a method's own type parameters need names of their own")
        if suppress_unknown_type_for.contains_key(name) == false:
            suppress_unknown_type_for.insert(name, 1)
            added.push(name)
    return added

# the declaration's first type-parameter node, which carries the position of
# the bracket list — the fn_decl node itself is built after its body and points
# past it. answers -1 when the declaration has no type parameters.
fn first_generic_param_index(node: Node) -> Int:
    for child in node.children:
        if get_node(child).kind == "generic_param":
            return child
    return 0 - 1

# lift the suppression suppress_method_type_params put in place.
fn release_method_type_params(names: List[String]):
    for name in names:
        suppress_unknown_type_for.remove(name)

# the concrete declaration an impl target names, resolved in the registering
# module's own scope. a generic base ("Iter") has no single tid, and a target
# the module cannot see resolves to nothing; both answer -1 and the method
# stays name-keyed only, which degrades to the old behavior rather than
# inventing a wrong owner.
fn method_owner_type_id(type_name: String) -> Int:
    if type_name.contains("["):
        return 0 - 1
    if has_generic_declaration(type_name):
        return 0 - 1
    scoped := resolve_type_name_module_scoped(type_name)
    if scoped >= 0:
        return scoped
    return lookup_type_id(resolve_imported_type_name(type_name))

fn register_method_declaration(type_name: String, node_idx: Int, node: Node, is_pub: Bool, from_interface: Bool):
    register_method_declaration_aliased(type_name, "", node_idx, node, is_pub, from_interface)

# register one impl method. `alias_name` is the declaring module's key for a
# generic base (see generic_base_alias_key) or "": when it is set, the method
# is filed under that key too, so a receiver whose generic base name is shared
# with another module's finds the body its own module declared. pass "" for a
# concrete type — those are told apart by the owner tid instead.
fn register_method_declaration_aliased(type_name: String, alias_name: String, node_idx: Int, node: Node, is_pub: Bool, from_interface: Bool):
    mut method_name := node.value
    fn_tid := resolve_function_signature(node)
    key := type_name + "." + method_name
    owner := method_owner_type_id(type_name)
    # a second impl block giving the same declaration the same method used to
    # overwrite the first silently, and which body answered depended on
    # module order. duplicates are keyed by the OWNER TID, not the bare name:
    # two modules may each declare a struct with this name and each give its
    # own struct the method, and an impl in another module may add NEW
    # methods to a type it can see (std.fs extends std.io's FileStream) —
    # both stay legal. a generic base has no tid and its name is globally
    # unique, so it dedups by the name key. only a SAME-KIND collision is an
    # error — std/io's conformance idiom declares each method twice on
    # purpose, once in the inherent block and once in the interface impl
    # (`impl StringReader: fn read` and `impl Reader for StringReader:
    # fn read`, identical bodies), and that pair stays legal in either order.
    mut kind_key := key
    if owner >= 0:
        kind_key = method_tid_key(owner, method_name)
    else:
        # a generic base has no tid, and its bare name is NOT globally
        # unique — std.iter's MapIter and a user module's MapIter both
        # register "MapIter.next". scope the duplicate check to the
        # declaring module, so same-named generics in different modules
        # never collide; a genuine duplicate within one module still
        # errors.
        kind_key = current_checker_module_path + ":" + key
    mut new_kind := "inherent"
    if from_interface:
        new_kind = "iface"
    # an impl target that resolves to neither a tid nor a generic base is
    # exempt from the duplicate check: with no owner to key on, the check
    # could only collide unrelated same-named types.
    dup_check_applies := owner >= 0 or has_generic_declaration(type_name)
    seen_key := kind_key + "#" + new_kind
    if dup_check_applies and method_declared_kinds.contains_key(seen_key):
        report_error_at(node_idx, "E263", "duplicate method '" + method_name + "' on '" + type_name + "': another impl block already declares it")
    method_declared_kinds.insert(seen_key, true)
    method_type_map.insert(key, fn_tid)
    method_visibility_map.insert(key, is_pub)
    register_method_signature(key, node_idx)
    # two modules can each declare a struct with this name, so the bare-name
    # key cannot say whose method this is. register a tid-keyed entry for the
    # declaration the impl target actually resolves to, and remember that
    # owner on the name key so a same-named foreign struct cannot answer for
    # it. keep the owner in step with the latest name-key write.
    if owner >= 0:
        register_method_signature(method_tid_key(owner, method_name), node_idx)
        register_method_owner(key, owner)
    else:
        clear_method_owner(key)
    if alias_name != "":
        alias_key := alias_name + "." + method_name
        method_type_map.insert(alias_key, fn_tid)
        method_visibility_map.insert(alias_key, is_pub)
        register_method_signature(alias_key, node_idx)
        clear_method_owner(alias_key)

# after all interfaces and impls are registered, an `impl Iface for T`
# inherits every default method (a fn_decl member of the interface) that
# T did not provide itself. we register the interface's default node under
# "T.method" so calls resolve; the emitter emits a per-type copy, and the
# body is type-checked against T in check_implementation_declaration.
fn fill_interface_defaults_for(node_idx: Int):
    node := get_node(node_idx)
    if node.kind == "pub":
        fill_interface_defaults_for(node.children[0])
        return
    if node.kind == "impl_decl":
        fill_impl_defaults(node)

fn fill_impl_defaults(node: Node):
    # only `impl Iface for Concrete` inherits defaults
    if node.children.len() < 2:
        return
    second_node := get_node(node.children[1])
    if second_node.kind != "for_type":
        return
    first_type_node := get_node(node.children[0])
    iface_base := iface_type_base_name(first_type_node)
    for_inner := get_node(second_node.children[0])
    concrete_name := get_type_node_name(for_inner)
    if concrete_name == "" or iface_base == "":
        return
    if interface_decl_index.contains_key(iface_base) == false:
        return
    iface_node := get_node(interface_decl_index[iface_base])
    generic_alias := generic_base_alias_key(concrete_name)
    for member in iface_node.children:
        mn := get_node(member)
        # a fn_decl member carries a body: it is a default. an abstract
        # member is a bare fn_sig and is skipped.
        if mn.kind == "fn_decl":
            key := concrete_name + "." + mn.value
            # a method the type provides itself always wins over the default.
            # ask by tid where the target resolves, so a same-named struct in
            # another module can neither suppress this type's default nor
            # stand in for a method it never declared.
            owner := method_owner_type_id(concrete_name)
            mut provides_own := method_type_map.contains_key(key)
            if owner >= 0:
                provides_own = has_method_declaration(method_tid_key(owner, mn.value))
            if provides_own == false:
                default_params := suppress_method_type_params(concrete_name, mn)
                register_method_declaration_aliased(concrete_name, generic_alias, member, mn, true, true)
                release_method_type_params(default_params)

fn check_type_implements_interface(type_name: String, iface_name: String) -> Bool:
    # match on base names so a generic instance like FilterIter[Range, Int]
    # finds the impl registered for FilterIter against Iterator
    type_base := extract_base_type_name(type_name)
    iface_base := extract_base_type_name(iface_name)
    key := type_base + chr(9) + iface_base
    return implementation_set.contains_key(key)

fn build_interface_type_name(base: String, args: List[String]) -> String:
    mut result := base + "["
    mut first := true
    for arg in args:
        if first == false:
            result = result + ","
        first = false
        result = result + arg
    return result + "]"

# ---------------------------------------------------------------
# pass 1 — type alias
# ---------------------------------------------------------------

fn register_type_alias_declaration(node: Node):
    name := node.value
    if node.children.len() > 0:
        target := resolve_type_implementation(node.children[0])
        register_module_type_name(name, target)

# ---------------------------------------------------------------
# helpers
# ---------------------------------------------------------------

# the name with any type-argument list cut off, so an instantiated type
# can be looked up against the generic declaration it came from. a name
# with no `[` comes back unchanged, which makes this safe to call on any
# type name without testing first.
pub fn extract_base_type_name(name: String) -> String:
    # "swap[T]" -> "swap", "Pair[A, B]" -> "Pair"
    mut i := 0
    while i < name.len():
        if ord(name[i]) == 91:
            return name.substring(0, i)
        i = i + 1
    return name

fn declaration_has_generic_params(node: Node) -> Bool:
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "generic_param":
            return true
    return false

# the type parameter names a declaration introduces, in source order —
# ["K", "V"] for `struct Pair[K, V]`. the order is what makes this
# useful: callers zip it against a concrete type-argument list to build
# the substitution map, so a declaration with no generic params gives an
# empty list rather than an error. pass the node returned by
# get_generic_declaration_index.
pub fn collect_generic_parameter_names(node: Node) -> List[String]:
    mut params: List[String] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "generic_param":
            params.push(trim_type_text(cn.value))
    return params

fn register_generic_declaration(name: String, node_idx: Int):
    key := module_generic_target_name(current_checker_module_path, name)
    if generic_declaration_map.contains_key(key) == false:
        generic_declaration_names.push(key)
    generic_declaration_map.insert(key, node_idx)
    generic_declaration_modules.insert(node_idx, current_checker_module_path)
    if key != name:
        generic_identity_bare_names.insert(key, name)
    # a second module declaring a generic under this bare base name makes the
    # bare name ambiguous from here on. modules are checked one at a time, so
    # this is only settled once every module has registered — which is why the
    # identity below is consulted at use time, never at registration time.
    if generic_base_first_module.contains_key(name):
        if generic_base_first_module[name] != current_checker_module_path:
            ambiguous_generic_bases.insert(name, true)
    else:
        generic_base_first_module.insert(name, current_checker_module_path)
    if current_checker_module_path.len() > 0 and generic_declaration_map.contains_key(name) == false:
        generic_declaration_names.push(name)
        generic_declaration_map.insert(name, node_idx)

# the name every table keys a generic base by. a generic declaration has no
# type id to key on — only its instances get one — so a struct's methods, its
# interface impls, its associated-type bindings and its instance names are all
# filed under the base name. that name is unique in almost every program, and
# stays bare when it is; when two modules each declare a generic with the same
# bare name it is not, and the declaration's own module joins the key so the
# two never merge. deciding this per name rather than always qualifying keeps
# every program that has no such clash keyed exactly as before, down to the
# emitted symbols.
pub fn generic_base_identity(module_path: String, name: String) -> String:
    if ambiguous_generic_bases.contains_key(name) == false:
        return name
    key := module_generic_target_name(module_path, name)
    if generic_declaration_map.contains_key(key):
        return key
    return name

# the bare name a generic identity was built from, or the name unchanged when
# it is already bare. for the callers that hold an identity and have to match
# it against a name written in source, which never carries the module.
pub fn generic_identity_bare_name(identity: String) -> String:
    if generic_identity_bare_names.contains_key(identity):
        return generic_identity_bare_names[identity]
    return identity

# the identity of the generic declaration at this AST node index, resolved
# from the module it was registered in. instantiation names an instance from
# this, so two modules' `Box[Int]` become two differently named types with
# two type ids instead of merging into one.
pub fn generic_declaration_identity(decl_idx: Int) -> String:
    decl := get_node(decl_idx)
    if generic_declaration_modules.contains_key(decl_idx):
        return generic_base_identity(generic_declaration_modules[decl_idx], decl.value)
    return decl.value

# the declaring module's key for the generic base `name`, or "" when `name`
# names no module-declared generic. registration runs one module at a time,
# long before the last module has had its chance to make a bare base name
# ambiguous, so a registration site cannot ask generic_base_identity what the
# key will be — it files its entry under this key as well as the bare one and
# lets the use site pick. the extra entry is inert in a program with no clash.
fn generic_base_alias_key(name: String) -> String:
    decl_idx := get_generic_declaration_index(name)
    if decl_idx < 0:
        return ""
    if generic_declaration_modules.contains_key(decl_idx) == false:
        return ""
    qualified := module_generic_target_name(generic_declaration_modules[decl_idx], name)
    if qualified == name:
        return ""
    return qualified

fn resolve_generic_declaration_key(name: String) -> String:
    if current_checker_module_path.len() > 0:
        current_key := module_generic_target_name(current_checker_module_path, name)
        if generic_declaration_map.contains_key(current_key):
            return current_key
    if generic_declaration_map.contains_key(name):
        return name
    for entry in generic_named_import_entries:
        parts := entry.split(chr(9))
        if parts.len() >= 3:
            if parts[0] == current_checker_module_path and parts[1] == name:
                imported_key := module_generic_target_name(parts[2], name)
                if generic_declaration_map.contains_key(imported_key):
                    return imported_key
    for entry in generic_wildcard_import_entries:
        parts := entry.split(chr(9))
        if parts.len() >= 2:
            if parts[0] == current_checker_module_path:
                imported_key := module_generic_target_name(parts[1], name)
                if generic_declaration_map.contains_key(imported_key):
                    return imported_key
    return ""

# whether `name` names a generic function or struct visible from the
# module being checked. pass a base name with no type arguments — run it
# through extract_base_type_name first. the search prefers a declaration
# in the current module over a bare one of the same name, then falls
# back to what this module's named and wildcard imports bring in.
pub fn has_generic_declaration(name: String) -> Bool:
    return resolve_generic_declaration_key(name).len() > 0

# the AST node index of the generic declaration `name` resolves to, or
# -1 when nothing matches. resolution order is the same as
# has_generic_declaration. the emitter uses this alongside
# collect_generic_parameter_names to recover a generic's parameter list
# at an instantiation site, long after the checker has run.
pub fn get_generic_declaration_index(name: String) -> Int:
    key := resolve_generic_declaration_key(name)
    if key.len() > 0:
        return generic_declaration_map[key]
    return -1

fn collect_function_param_types(node: Node) -> List[Int]:
    mut params: List[Int] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                params.push(resolve_type_implementation(cn.children[0]))
            else:
                params.push(TID_ERR)
    return params

fn collect_function_return_type(node: Node) -> Int:
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            return resolve_type_implementation(cn.children[0])
    return TID_VOID

fn extract_field_name(value: String) -> String:
    # "name pub mut" -> "name"
    mut i := 0
    while i < value.len():
        if ord(value[i]) == 32:
            return value.substring(0, i)
        i = i + 1
    return value

fn strings_equal(a: String, b: String) -> Bool:
    if a.len() != b.len():
        return false
    mut i := 0
    while i < a.len():
        if ord(a[i]) != ord(b[i]):
            return false
        i = i + 1
    return true

fn get_type_node_name(node: Node) -> String:
    # extract the type name from a type expression node
    if node.kind == "type":
        if node.value.contains("["):
            base := extract_base_type_name(node.value)
            inner := node.value.substring(base.len() + 1, node.value.len() - 1)
            parts := inner.split(",")
            mut args: List[String] := []
            for part in parts:
                args.push(part.trim())
            return build_interface_type_name(base, args)
        return node.value
    if node.kind == "generic_type":
        mut parts: List[String] := []
        for child in node.children:
            child_name := get_type_node_name(get_node(child))
            if child_name == "":
                return ""
            parts.push(child_name)
        return build_interface_type_name(node.value, parts)
    return ""

fn get_type_node_name_with_substitution(node: Node, subst_map: Map[String, Int]) -> String:
    if node.kind == "type":
        if node.value.contains("["):
            base := extract_base_type_name(node.value)
            inner := node.value.substring(base.len() + 1, node.value.len() - 1)
            raw_parts := inner.split(",")
            mut args: List[String] := []
            for raw in raw_parts:
                part := raw.trim()
                if subst_map.contains_key(part):
                    args.push(get_type_name(subst_map[part]))
                else:
                    args.push(part)
            return build_interface_type_name(base, args)
        if subst_map.contains_key(node.value):
            return get_type_name(subst_map[node.value])
        return node.value
    if node.kind == "generic_type":
        mut parts: List[String] := []
        for child in node.children:
            child_name := get_type_node_name_with_substitution(get_node(child), subst_map)
            if child_name == "":
                return ""
            parts.push(child_name)
        return build_interface_type_name(node.value, parts)
    return ""

# extract the binding name from a binding value like "x" or "x mut"
fn extract_binding_name(value: String) -> String:
    mut i := 0
    while i < value.len():
        if ord(value[i]) == 32:
            return value.substring(0, i)
        i = i + 1
    return value

fn binding_is_mutable(value: String) -> Bool:
    return value.contains(" mut")

# ---------------------------------------------------------------
# pass 2 — check declarations
# ---------------------------------------------------------------

# pass 2: type-check the bodies — functions, impl methods, test blocks,
# and the module's global bindings — with every top-level name already
# in scope from c_register_all. this is where the bulk of a check run's
# time goes. a generic function's body is skipped entirely — it has no
# concrete types until something instantiates it — so a mistake inside
# one is not reported by this pass.
pub fn c_check_all(root_idx: Int):
    collect_module_global_names(root_idx)
    root := get_node(root_idx)
    for child in root.children:
        check_top_level_declarations(child)

# every module-level binding this file declares, by name. collected before
# any body is checked, so a global written below the function that shadows it
# still counts. E266 is the only reader.
mut c_module_global_names: List[String] := []
# names the shadow walk has already seen mentioned in the body it is walking.
mut c_shadow_seen_names: List[String] := []

fn collect_module_global_names(root_idx: Int):
    c_module_global_names = []
    root := get_node(root_idx)
    for child in root.children:
        mut inner := get_node(child)
        if inner.kind == "pub" and inner.children.len() > 0:
            inner = get_node(inner.children[0])
        if inner.kind == "threadlocal" and inner.children.len() > 0:
            inner = get_node(inner.children[0])
        if inner.kind == "binding" or inner.kind == "bind":
            name := extract_binding_name(inner.value)
            if name.len() > 0 and not c_module_global_names.contains(name):
                c_module_global_names.push(name)

# E266: a module global read in a function that later binds the same name.
#
# a function's storage is flat — one slot per name for the whole body — so a
# local, a parameter or a pattern binding takes its name for the entire
# function and the module global of that name is unreachable from it. that is
# fine on its own, and legal. what has no answer is a body that wants BOTH:
# reads the global somewhere above and binds a local of the same name below.
# one of the two has to be wrong, and neither is a wrong the emitter can see,
# so it is refused here instead.
#
# a `for` variable is exempt. it is the one binding with storage scoped to a
# block rather than the function, so the global is still reachable on either
# side of the loop and nothing is ambiguous.
fn report_shadow_after_read(name: String, node_idx: Int):
    if name.len() == 0:
        return
    if not c_module_global_names.contains(name):
        return
    if not c_shadow_seen_names.contains(name):
        return
    report_error_with_fix_at(node_idx, "E266", "'" + name + "' names a module global that is read earlier in this function, and this binding takes the name for the whole function", "rename the binding, or move the reads of the global into a function that does not bind the name")

fn check_global_shadow_reads(idx: Int):
    node := get_node(idx)
    if node.kind == "ident":
        if not c_shadow_seen_names.contains(node.value):
            c_shadow_seen_names.push(node.value)
        return
    # an `assign` carries its target in the node's value rather than as an
    # ident child, so it needs its own mention.
    if node.kind == "assign":
        if not c_shadow_seen_names.contains(node.value):
            c_shadow_seen_names.push(node.value)
    # children first: a binding's own initializer is a child of it, and
    # `mut g := g + 1` reads the global on the right of a binding that would
    # then claim the name.
    for child in node.children:
        check_global_shadow_reads(child)
    if node.kind == "binding" or node.kind == "bind":
        report_shadow_after_read(extract_binding_name(node.value), idx)
    elif node.kind == "pat_binding":
        report_shadow_after_read(node.value, idx)

fn check_top_level_declarations(node_idx: Int):
    node := get_node(node_idx)
    if node.kind == "pub":
        check_declaration(node.children[0])
    elif node.kind == "from_import":
        return
    elif node.kind == "import":
        return
    else:
        check_declaration(node_idx)

fn check_declaration(node_idx: Int):
    node := get_node(node_idx)
    if node.kind == "threadlocal":
        check_declaration(node.children[0])
        return
    if node.kind == "fn_decl":
        check_function_declaration(node)
    elif node.kind == "binding":
        check_binding_statement(node_idx, current_scope)
    elif node.kind == "impl_decl":
        check_implementation_declaration(node)
    elif node.kind == "test_decl":
        check_test_declaration(node)

# ---------------------------------------------------------------
# pass 2 — function checking
# ---------------------------------------------------------------

fn check_function_declaration(node: Node):
    if declaration_has_generic_params(node):
        return
    name := node.value
    # skip main — it may not be registered if it's the entry point
    fn_tid := lookup_binding(current_scope, name)
    if fn_tid < 0:
        return
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        return
    # create function scope with return type
    fn_scope := create_function_scope(current_scope, fn_info.return_type)
    reset_fn_weak_tracking()
    # define parameters
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            pname := extract_binding_name(cn.value)
            if param_idx < fn_info.param_types.len():
                define_binding_at(fn_scope, pname, fn_info.param_types[param_idx], cn.value.contains("mut"), child)
            note_fn_binding_name(pname, child)
            param_idx = param_idx + 1
        elif cn.kind == "body":
            check_function_body(child, fn_scope)

fn check_function_body(node_idx: Int, scope_id: Int):
    if c_module_global_names.len() > 0:
        c_shadow_seen_names = []
        check_global_shadow_reads(node_idx)
    node := get_node(node_idx)
    if node.children.len() > 0:
        block := get_node(node.children[0])
        if block.kind == "block":
            check_block_statement(block, scope_id)

fn check_block_statement(node: Node, scope_id: Int):
    for child in node.children:
        check_statement(child, scope_id)

# ---------------------------------------------------------------
# pass 2 — impl checking
# ---------------------------------------------------------------

fn check_implementation_declaration(node: Node):
    first_type_node := get_node(node.children[0])
    mut concrete_name := ""
    mut method_start := 1

    if node.children.len() > 1:
        second_node := get_node(node.children[1])
        if second_node.kind == "for_type":
            for_inner := get_node(second_node.children[0])
            concrete_name = get_type_node_name(for_inner)
            method_start = 2
        else:
            concrete_name = get_type_node_name(first_type_node)
    else:
        concrete_name = get_type_node_name(first_type_node)

    if concrete_name == "":
        return

    if method_start == 2 and iface_type_base_name(first_type_node) == "Drop":
        check_drop_implementation(node, concrete_name, method_start)

    concrete_tid := lookup_type_id(concrete_name)
    if concrete_tid < 0:
        return

    # activate this impl's associated-type bindings so `Item` resolves inside
    # the method bodies, and check that every declared associated type is bound
    active_assoc_bindings = {}
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "assoc_type_bind":
            active_assoc_bindings.insert(cn.value, resolve_type_implementation(cn.children[0]))
    if method_start == 2:
        check_assoc_types_bound(first_type_node, concrete_name)

    # check each method body (skip first method_start children)
    mut skip := method_start
    for child in node.children:
        if skip > 0:
            skip = skip - 1
            continue
        mut cn := get_node(child)
        mut method_idx := child
        if cn.kind == "pub":
            method_idx = cn.children[0]
            cn = get_node(method_idx)
        if cn.kind == "fn_decl":
            check_method_body(concrete_name, concrete_tid, method_idx, cn)

    # type-check any inherited interface defaults against this concrete type,
    # so `self` inside a default resolves to the implementing type
    if method_start == 2:
        iface_base := iface_type_base_name(first_type_node)
        if interface_decl_index.contains_key(iface_base):
            # the impl header names the interface: record the reference
            record_definition(node.children[0], interface_decl_index[iface_base])
            iface_node := get_node(interface_decl_index[iface_base])
            for member in iface_node.children:
                mn := get_node(member)
                if mn.kind == "fn_decl":
                    # a default the impl didn't override: type-check it here
                    if is_impl_own_method(node, method_start, mn.value) == false:
                        check_method_body(concrete_name, concrete_tid, member, mn)
                elif mn.kind == "fn_sig":
                    # an abstract method: the impl must provide it directly.
                    # catching it here names the gap at the impl block instead
                    # of leaving a confusing "no method" error at the call site
                    if is_impl_own_method(node, method_start, mn.value) == false:
                        report_error("E235", "impl of " + iface_base + " for " + concrete_name + " is missing method: " + mn.value)
    active_assoc_bindings = {}

# `impl Drop for T` is the destructor hook (docs/ownership.md): the emitter
# calls T's `drop` from the destructor it attaches at construction, so the
# impl has to be a shape that destructor can call. T must be a struct the
# current module declares — the destructor is generated per declaration and
# spells the method symbol from the declaring module, a generic struct has
# one destructor per instance with no place for the call, and an enum
# releases tagged payloads rather than fields — and the impl must provide
# exactly `fn drop()`: no parameters, no return, since the runtime hands the
# body the bare pointer and reads nothing back. `Drop` is a language-level
# interface, so no declaration of it is needed or looked for.
fn check_drop_implementation(node: Node, concrete_name: String, method_start: Int):
    prefix := "impl Drop for " + concrete_name + ": "
    if has_generic_declaration(concrete_name):
        report_error("E268", prefix + "a generic struct cannot implement Drop")
        return
    tid := lookup_type_id(concrete_name)
    if tid < 0:
        return
    if get_type_info(tid).kind != "struct":
        report_error("E268", prefix + "only a struct can implement Drop")
        return
    if module_declares_struct(concrete_name) == false:
        report_error("E268", prefix + "Drop must be implemented in the module that declares the struct")
        return
    mut found := false
    mut skip := method_start
    for child in node.children:
        if skip > 0:
            skip = skip - 1
            continue
        mut cn := get_node(child)
        if cn.kind == "pub":
            cn = get_node(cn.children[0])
        if cn.kind != "fn_decl":
            continue
        if cn.value != "drop":
            report_error("E268", prefix + "the impl may only declare drop(), not '" + cn.value + "'")
            continue
        found = true
        if declaration_has_generic_params(cn) or collect_function_param_types(cn).len() > 0:
            report_error("E268", prefix + "drop() takes no parameters")
        elif collect_function_return_type(cn) != TID_VOID:
            report_error("E268", prefix + "drop() returns nothing")
    if found == false:
        report_error("E268", prefix + "the impl must declare fn drop()")

# whether the module being checked declares a struct under `name` itself,
# as opposed to seeing one through an import. walks the module's own root,
# which snapshot_module_context recorded before the passes began.
fn module_declares_struct(name: String) -> Bool:
    if checker_module_roots.contains_key(current_checker_module_path) == false:
        return false
    root := get_node(checker_module_roots[current_checker_module_path])
    for child in root.children:
        mut cn := get_node(child)
        if cn.kind == "pub":
            cn = get_node(cn.children[0])
        if (cn.kind == "struct_decl" or cn.kind == "struct") and cn.value == name:
            return true
    return false

# an impl of an interface with associated types must bind every one of them.
fn check_assoc_types_bound(iface_type_node: Node, concrete_name: String):
    iface_base := iface_type_base_name(iface_type_node)
    if interface_assoc_types.contains_key(iface_base) == false:
        return
    for req_name in interface_assoc_types[iface_base].split(","):
        if active_assoc_bindings.contains_key(req_name) == false:
            report_error("E229", "impl of " + iface_base + " for " + concrete_name + " is missing associated type: " + req_name)

# is a method name provided directly by the impl block (vs inherited)?
fn is_impl_own_method(node: Node, method_start: Int, method_name: String) -> Bool:
    mut skip := method_start
    for child in node.children:
        if skip > 0:
            skip = skip - 1
            continue
        mut cn := get_node(child)
        if cn.kind == "pub":
            cn = get_node(cn.children[0])
        if cn.kind == "fn_decl":
            if cn.value == method_name:
                return true
    return false

fn check_method_body(type_name: String, type_tid: Int, node_idx: Int, node: Node):
    # a method with its own type parameters has no concrete signature until a
    # call fixes them, so its body is not checked here — the same treatment
    # check_function_declaration gives a free generic function.
    if declaration_has_generic_params(node):
        return
    param_types := collect_function_param_types(node)
    ret_type := collect_function_return_type(node)
    method_scope := create_function_scope(current_scope, ret_type)
    reset_fn_weak_tracking()
    # bind self
    define_binding_at(method_scope, "self", type_tid, false, node_idx)

    # define parameters (skipping self — it's implicit)
    mut param_idx := 0
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            pname := extract_binding_name(cn.value)
            if param_idx < param_types.len():
                define_binding_at(method_scope, pname, param_types[param_idx], cn.value.contains("mut"), child)
            note_fn_binding_name(pname, child)
            param_idx = param_idx + 1
        elif cn.kind == "body":
            check_function_body(child, method_scope)

# ---------------------------------------------------------------
# pass 2 — test checking
# ---------------------------------------------------------------

fn check_test_declaration(node: Node):
    test_scope := create_function_scope(current_scope, TID_VOID)
    checking_test_decl = true
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "body":
            check_function_body(child, test_scope)
    checking_test_decl = false

# ---------------------------------------------------------------
# statement checking
# ---------------------------------------------------------------

fn check_statement(node_idx: Int, scope_id: Int):
    checker_set_current_node(node_idx)
    node := get_node(node_idx)
    if node.kind == "binding":
        check_binding_statement(node_idx, scope_id)
    elif node.kind == "assignment":
        check_assignment(node, scope_id)
    elif node.kind == "return":
        check_return_statement(node, scope_id)
    elif node.kind == "fail":
        check_fail_statement(node, scope_id)
    elif node.kind == "if_stmt":
        check_if_statement(node, scope_id)
    elif node.kind == "while_stmt":
        check_while_statement(node, scope_id)
    elif node.kind == "if_let":
        check_if_let_statement(node, scope_id)
    elif node.kind == "while_let":
        check_while_let_statement(node, scope_id)
    elif node.kind == "for_stmt":
        check_for_statement(node, scope_id)
    elif node.kind == "break":
        if is_in_loop_scope(scope_id) == false:
            report_error("E215", "break outside of loop")
    elif node.kind == "continue":
        if is_in_loop_scope(scope_id) == false:
            report_error("E215", "continue outside of loop")
    elif node.kind == "match_expr":
        check_match_expression(node_idx, scope_id)
    elif node.kind == "defer":
        check_defer_statement(node, scope_id)
    elif node.kind == "errdefer":
        check_errdefer_statement(node, scope_id)
    else:
        # expression statement
        c_check_expr(node_idx, scope_id)

# a deferred statement runs on every exit from its enclosing scope, including
# error paths. to keep that re-emission safe we only allow a plain side-effect
# statement: no control transfer (return/fail/break/continue), no `!`/`?`
# propagation (which would exit again mid-cleanup), no nested defer, and no
# binding (its name would never be visible anyway).
fn check_defer_statement(node: Node, scope_id: Int):
    if get_scope_return_type(scope_id) < 0:
        report_error("E260", "defer is only allowed inside a function")
        return
    check_defer_body(node, scope_id)

# `errdefer` shares every restriction with `defer` on its inner statement, but
# it only runs on an error exit (fail / `!`-propagation), so it is meaningless
# in a function that can't return an error. require a result (`T!`) return type.
fn check_errdefer_statement(node: Node, scope_id: Int):
    ret_type := get_scope_return_type(scope_id)
    if ret_type < 0:
        report_error("E260", "errdefer is only allowed inside a function")
        return
    if get_type_info(ret_type).kind != "result":
        report_error_with_fix("E260", "errdefer is only meaningful in a function returning a result (`T!`)", "use `defer` for cleanup that must always run, or give the function a `T!` return type")
        return
    check_defer_body(node, scope_id)

# shared inner-statement validation for `defer` and `errdefer`: both re-emit
# their inner statement at scope-exit edges, so both forbid the same unsafe
# shapes and both need the inner statement type-checked for the emitter.
fn check_defer_body(node: Node, scope_id: Int):
    if node.children.len() < 1:
        return
    inner_idx := node.children[0]
    # reject the shapes we can't re-emit safely before type-checking, so a
    # forbidden statement reports one clear error instead of a cascade.
    if defer_body_has_forbidden_node(inner_idx):
        report_error_with_fix("E260", "a deferred statement must be a plain side-effect (no return/fail/break/continue, no `!`/`?`, no defer or binding)", "move the control flow out of the defer, or wrap the cleanup in a helper function")
        return
    # type-check the inner statement so its expression types are recorded for
    # the emitter.
    check_statement(inner_idx, scope_id)

# recursively scan a deferred statement for shapes that would make re-emitting
# it at a scope exit unsafe. an early exit inside a defer would re-trigger the
# very cleanup we are in the middle of, and a binding leaks no usable name.
fn defer_body_has_forbidden_node(idx: Int) -> Bool:
    node := get_node(idx)
    k := node.kind
    if k == "return" or k == "fail" or k == "break" or k == "continue":
        return true
    if k == "defer" or k == "errdefer" or k == "binding" or k == "bind":
        return true
    if k == "try" or k == "try_expr" or k == "unwrap":
        return true
    for child in node.children:
        if defer_body_has_forbidden_node(child):
            return true
    return false

# ---------------------------------------------------------------
# binding statement
# ---------------------------------------------------------------

# True when both types are Optional wrappings of the same inner type. Type
# interning duplicates `T?` on every annotation site (add_type_info doesn't
# dedupe), so `mut a: Int? := 5; mut b: Int? := 5` gives `a` and `b`
# different tids even though the shape is identical. Used to let == and !=
# pass structural check when both sides are the same Optional.
fn optional_types_match(a: Int, b: Int) -> Bool:
    if a < 0 or b < 0:
        return false
    a_info := get_type_info(a)
    b_info := get_type_info(b)
    if a_info.kind != "optional" or b_info.kind != "optional":
        return false
    if a_info.inner < 0 or b_info.inner < 0:
        return false
    if a_info.inner == b_info.inner:
        return true
    return types_structurally_equal(a_info.inner, b_info.inner)

# `x == 5` with x: Int? — the mixed comparison, where exactly one side is an
# optional and the other is a plain value of its inner type. every other typed
# position widens the plain side (argument, binding, field, return); == was
# the position that never got the clause, so it reported E217. bare `none`
# stays out deliberately: it has its own arms above, and #680's rule — none
# satisfies only an optional — must not loosen through here.
fn optional_plain_comparison(a: Int, b: Int) -> Bool:
    if a < 0 or b < 0:
        return false
    if is_error_type(a) or is_error_type(b):
        return false
    if is_none_type(a) or is_none_type(b):
        return false
    return optional_accepts_plain(a, b) or optional_accepts_plain(b, a)

# one direction of the widening rule: an optional with this tid accepts a
# plain value of its inner type (exactly, or structurally). shared by both
# orders of optional_plain_comparison and by the argument-position widening,
# which layers its own guards and the recording side effect on top.
fn optional_accepts_plain(opt_tid: Int, plain_tid: Int) -> Bool:
    opt_info := get_type_info(opt_tid)
    if opt_info.kind != "optional" or opt_info.inner < 0:
        return false
    if get_type_info(plain_tid).kind == "optional":
        return false
    if opt_info.inner == plain_tid:
        return true
    return types_structurally_equal(opt_info.inner, plain_tid)

fn value_matches_optional_target(value_idx: Int, actual_tid: Int, expected_tid: Int) -> Bool:
    if expected_tid < 0:
        return false
    expected_info := get_type_info(expected_tid)
    if expected_info.kind != "optional":
        return false
    value_node := get_node(value_idx)
    if value_node.kind == "none_lit":
        return true
    # a name bound to a bare `none` carries the sentinel rather than the
    # literal node, and satisfies the same optional targets.
    if is_none_type(actual_tid):
        return true
    if actual_tid < 0:
        return false
    if actual_tid == expected_tid:
        return true
    if actual_tid == expected_info.inner:
        return true
    return types_structurally_equal(actual_tid, expected_info.inner)

# a plain inner value satisfies an optional parameter by widening to Some(v),
# the same rule a binding, a struct field and a collection element already
# apply through value_matches_optional_target. argument position is the one
# that never routed through it, so `f(3)` against `fn f(x: Int?)` reported.
#
# only the widening case is recorded. an argument that is already the optional
# arrives in the right shape on its own, and a bare `none` builds the empty
# tuple in ir_expr — recording either would make the emitter wrap a value that
# is already wrapped. `none` is excluded outright so #680's rule survives: it
# stays a value that only an optional target accepts, and nothing here lets a
# plain value satisfy `none` in the other direction.
fn argument_widens_to_optional(expr_idx: Int, actual_tid: Int, expected_tid: Int) -> Bool:
    if expr_idx < 0 or actual_tid < 0 or expected_tid < 0:
        return false
    if actual_tid == expected_tid:
        return false
    if is_error_type(actual_tid) or is_error_type(expected_tid):
        return false
    if is_none_type(actual_tid) or is_none_type(expected_tid):
        return false
    # the inner value may itself be an optional: `x: Int?` into an `Int??`
    # target is a plain value to that target and needs its shell like any
    # other. only a value that already IS the target (excluded above) arrives
    # in the right shape. an earlier form refused every optional value here,
    # so the deeper wrap was never recorded and the emitter, reading the
    # value's kind, forwarded the inner shell as the outer one (#1051).
    expected_info := get_type_info(expected_tid)
    if expected_info.kind != "optional" or expected_info.inner < 0:
        return false
    if actual_tid != expected_info.inner and types_structurally_equal(actual_tid, expected_info.inner) == false:
        return false
    optional_widened_arguments.insert(expr_idx, true)
    return true

# does the emitter have to wrap this argument expression in Some(v)? true only
# for the nodes argument_widens_to_optional accepted.
pub fn c_argument_widens_to_optional(expr_idx: Int) -> Bool:
    return optional_widened_arguments.contains_key(expr_idx)

# accept a value into an optional target and record what the emitter has to
# build for it. the two answers differ: `none` and a value that is already the
# optional arrive in the right shape and are recorded as nothing, while a
# plain inner value needs the Some shell, which is what the recording asks
# for. every acceptance site goes through here: a binding, an assignment, a
# struct field or its default, an argument. the record is what tells the
# emitter that an optional value handed to a deeper optional (`x: Int?` into
# an `Int??`) still needs its shell, since by kind it already looks like one
# (#1051).
fn optional_target_accepts_value(value_idx: Int, actual_tid: Int, expected_tid: Int) -> Bool:
    if value_matches_optional_target(value_idx, actual_tid, expected_tid) == false:
        return false
    argument_widens_to_optional(value_idx, actual_tid, expected_tid)
    return true

fn struct_field_has_default(struct_name: String, field_name: String) -> Bool:
    return struct_field_default_nodes.contains_key(struct_name + "." + field_name)

fn struct_min_required_fields(struct_name: String, info: TypeInfo) -> Int:
    mut min_required := info.fields.len()
    while min_required > 0:
        field_name := info.fields[min_required - 1]
        if struct_field_has_default(struct_name, field_name):
            min_required = min_required - 1
        else:
            break
    return min_required

# record a collection literal's type as the annotated one, and push the
# expected element type into any collection literal nested inside it. a
# literal takes its own type from its elements, so `[[1, none]]` under a
# List[List[Int?]] annotation would type the inner list List[Int] and
# lose the optional; the emitter wraps elements from the container's
# recorded type, so recording the right type on every nested literal is
# what makes deep literals build correct values.
# give an empty (or otherwise untyped) collection literal the type it is being
# stored into. an empty literal has nothing to infer an element type from, so it
# checks as an error and the emitter falls back to an untagged container — one
# that does not retain what gets pushed into it. an annotated binding already
# did this; a struct field is the other place a literal has a declared type
# waiting for it.
fn propagate_empty_collection_literal(value_idx: Int, expected_tid: Int):
    if expected_tid < 0:
        return
    node := get_node(value_idx)
    if node.kind == "list" or node.kind == "map" or node.kind == "set":
        propagate_expected_collection_type(value_idx, expected_tid)

fn propagate_expected_collection_type(literal_idx: Int, expected_tid: Int):
    if expected_tid < 0:
        return
    node := get_node(literal_idx)
    expected_info := get_type_info(expected_tid)
    if node.kind == "list" and expected_info.kind == "list":
        expression_type_cache.insert(literal_idx, expected_tid)
        for child in node.children:
            propagate_expected_collection_type(child, expected_info.inner)
    elif node.kind == "set" and expected_info.kind == "set":
        expression_type_cache.insert(literal_idx, expected_tid)
        for child in node.children:
            propagate_expected_collection_type(child, expected_info.inner)
    elif node.kind == "map" and expected_info.kind == "map":
        expression_type_cache.insert(literal_idx, expected_tid)
        for entry_idx in node.children:
            entry := get_node(entry_idx)
            if entry.kind == "entry" and entry.children.len() >= 2:
                propagate_expected_collection_type(entry.children[1], expected_info.value_type)
    elif node.kind == "map" and expected_info.kind == "set" and node.children.len() == 0:
        # `{}` is the only spelling of an empty set and parses as a map, so
        # a set target has to cross the kinds. the emitter reads the
        # recorded type back and builds a set rather than a map — without
        # it a `{}` written into a Set position builds a map, and every
        # `add` into it is silently dropped.
        expression_type_cache.insert(literal_idx, expected_tid)

# give a collection literal written straight into a call or method argument
# the type the parameter declares. `[]` and `{}` carry no element type of
# their own, so with nothing to take one from they check as an error and
# the emitter builds an untagged container — one that takes no count for
# what is stored into it, leaving every heap element on a count the caller
# still has to drop. an annotated bind, a `return`, a struct field and an
# assignment already take their type from context; an argument was the last
# position that did not.
#
# only an *empty* literal is retargeted. an empty one has no elements that
# could disagree with the parameter, so the recorded type cannot be a lie
# and no element check is needed; a literal with elements types itself and
# is left exactly as it was, which keeps a genuinely wrong element type
# reporting rather than being stamped over. the container this builds is
# the one the equivalent `mut xs: T := []` then `f(xs)` already builds, so
# it is a shape the ownership rules cover rather than a new one.
fn propagate_empty_argument_collection_type(arg_idx: Int, expected: Int, actual: Int, scope_id: Int):
    if is_error_type(actual) == false:
        return
    if expected < 0:
        return
    expr_idx := argument_expression_index(arg_idx)
    node := get_node(expr_idx)
    if node.children.len() != 0:
        # a literal WITH elements types itself — but an empty literal nested
        # inside leaves the whole thing error-typed (`f([[]])`), and an
        # error-typed argument skips the coercion path the mismatch check
        # would have run. run it here for its recording effect: the element
        # walk qualifies the literal honestly and records the declared type
        # through every nested literal, so the inner list is tagged and owns
        # what is pushed into it. a genuinely wrong element still fails the
        # coercion and leaves the literal exactly as it was — either way
        # this path is done.
        if node.kind == "list" or node.kind == "map" or node.kind == "set":
            collection_literal_coerces(expr_idx, expected, scope_id)
        return
    if node.kind == "list" or node.kind == "map" or node.kind == "set":
        # an optional-of-container parameter (`f(v: List[String]?)`) declares
        # the optional, not the container inside it, so an empty literal used
        # to match nothing and reach the callee as a bare container handle —
        # which the callee then read as an optional tuple and dereferenced.
        # take the type from the inner container and mark the argument so the
        # emitter wraps the tagged container in the Some the callee expects.
        expected_info := get_type_info(expected)
        if expected_info.kind == "optional" and expected_info.inner >= 0:
            inner_info := get_type_info(expected_info.inner)
            if inner_info.kind == "list" or inner_info.kind == "map" or inner_info.kind == "set":
                propagate_expected_collection_type(expr_idx, expected_info.inner)
                # only wrap once the literal really took the inner container's
                # type. a literal whose spelling does not match it (`{}` against
                # a `List[T]?`) is left exactly as it was rather than wrapped
                # around the wrong container.
                if expression_type_cache.contains_key(expr_idx):
                    if expression_type_cache[expr_idx] == expected_info.inner:
                        optional_widened_arguments.insert(expr_idx, true)
                return
        propagate_expected_collection_type(expr_idx, expected)

# true when a single value can build an element of the expected type:
# a nested collection literal recurses, an optional target accepts none
# or the bare inner value, everything else must be type-compatible. this
# is what keeps the coercion honest — a String element for a List[Int]
# still fails.
fn literal_element_coerces(value_idx: Int, expected_tid: Int, scope_id: Int) -> Bool:
    if expected_tid < 0:
        return false
    node := get_node(value_idx)
    if node.kind == "list" or node.kind == "set" or node.kind == "map":
        return collection_literal_coerces(value_idx, expected_tid, scope_id)
    expected_info := get_type_info(expected_tid)
    if expected_info.kind == "optional":
        if node.kind == "none_lit":
            return true
        inner_type := c_check_expr(value_idx, scope_id)
        if is_error_type(inner_type):
            return false
        return inner_type == expected_info.inner or types_compatible(inner_type, expected_info.inner)
    actual := c_check_expr(value_idx, scope_id)
    if is_error_type(actual):
        return false
    return types_compatible(actual, expected_tid)

# true when a collection literal can validly build the expected
# collection type, allowing optional wrapping of its leaves but
# rejecting genuinely wrong element types. on success it records the
# expected type through the literal (and its nested literals) so the
# emitter wraps each element correctly.
fn collection_literal_coerces(value_idx: Int, target_tid: Int, scope_id: Int) -> Bool:
    if target_tid < 0:
        return false
    node := get_node(value_idx)
    target_info := get_type_info(target_tid)
    # an optional whose inner type is a container takes the literal through
    # the container and wraps what it built. the walk below recurses on the
    # three container kinds and an optional is not one of them, so
    # `{"a": [1, 2]}` against a Map[String, List[Int]?] used to report even
    # though every element was fine — and a List[Int?]? parameter, which has
    # to widen its elements and its container at once, reported too.
    if target_info.kind == "optional" and target_info.inner >= 0:
        inner_info := get_type_info(target_info.inner)
        if inner_info.kind != "list" and inner_info.kind != "map" and inner_info.kind != "set":
            return false
        if collection_literal_coerces(value_idx, target_info.inner, scope_id) == false:
            return false
        # the literal now carries the inner container's type; the Some shell
        # around it is the emitter's to build, which is what this records.
        optional_widened_arguments.insert(value_idx, true)
        return true
    if node.kind == "list" and target_info.kind == "list":
        for child in node.children:
            if literal_element_coerces(child, target_info.inner, scope_id) == false:
                return false
        propagate_expected_collection_type(value_idx, target_tid)
        return true
    if node.kind == "set" and target_info.kind == "set":
        for child in node.children:
            if literal_element_coerces(child, target_info.inner, scope_id) == false:
                return false
        propagate_expected_collection_type(value_idx, target_tid)
        return true
    if node.kind == "map" and target_info.kind == "map":
        for entry_idx in node.children:
            entry := get_node(entry_idx)
            if entry.kind == "entry" and entry.children.len() >= 2:
                if literal_element_coerces(entry.children[0], target_info.key_type, scope_id) == false:
                    return false
                if literal_element_coerces(entry.children[1], target_info.value_type, scope_id) == false:
                    return false
        propagate_expected_collection_type(value_idx, target_tid)
        return true
    return false

# a value is a collection literal that coerces to an expected collection
# type. lets assignments and struct fields accept the same optional-in-a-
# collection literals an annotated binding does, without masking real
# element-type errors. the scope must be the one the value was checked
# in — its element expressions are re-checked to verify compatibility.
fn collection_literal_matches_target(value_idx: Int, target_tid: Int, scope_id: Int) -> Bool:
    return collection_literal_coerces(value_idx, target_tid, scope_id)

# per-function name bookkeeping for weak bindings. the emitter keys a local's
# storage slot by NAME across the whole function, so one name carrying both a
# weak and a non-weak binding (sibling branches, a loop variable, a match
# payload) would make reads of the weak one lower without the liveness
# resolution — a wrong value, not a leak. a weak name must therefore be unique
# in its function, in both directions. reset per function body; lambda bodies
# do NOT reset — they nest inside the function, and a lambda referencing an
# enclosing weak binding captures it weakly through the closure environment.
mut fn_bound_names: List[String] := []
mut fn_weak_names: List[String] := []
mut checker_lambda_depth := 0

fn reset_fn_weak_tracking():
    fn_bound_names = []
    fn_weak_names = []
    checker_lambda_depth = 0

# record a non-weak binding name (param, loop variable, match payload, plain
# `:=`), rejecting reuse of a name that is weak elsewhere in the function.
# the push is unconditional and undeduplicated on purpose: this runs for
# every binding in every function, so it must stay O(1) — only the rare
# weak-binding path ever scans the list.
fn note_fn_binding_name(name: String, node_idx: Int):
    if fn_weak_names.len() > 0 and fn_weak_names.contains(name):
        report_error_at(node_idx, "E261", "the name '" + name + "' is bound weak elsewhere in this function; use a different name")
    fn_bound_names.push(name)

fn check_binding_statement(node_idx: Int, scope_id: Int):
    node := get_node(node_idx)
    name := extract_binding_name(node.value)
    is_mut := binding_is_mutable(node.value)
    if node.value.contains(" weak"):
        if fn_bound_names.contains(name):
            report_error_at(node_idx, "E261", "a weak binding cannot reuse the name '" + name + "', which is already bound in this function")
        # a lambda body emits as its own function but shares the enclosing
        # emission's tracking today, so a weak local declared inside one
        # would lower against the wrong function's slots. weak bindings in
        # closures arrive together with weak capture support.
        if checker_lambda_depth > 0:
            report_error_at(node_idx, "E261", "a weak binding inside a closure is not supported yet")
        fn_bound_names.push(name)
        fn_weak_names.push(name)
        check_weak_binding(node_idx, scope_id, name)
        return
    # a binding in a nested block does not shadow an enclosing one, it
    # overwrites it: the emitter gives a function one slot per name, so the
    # inner binding writes the outer one's storage and the outer read after the
    # block answers with the inner value — or with garbage, when the two have
    # different types. that is a wrong answer with no diagnostic, so the name is
    # rejected rather than allowed to shadow, the same choice E250 makes for a
    # struct that reuses a builtin type name.
    #
    # sibling blocks reusing a name are untouched: neither encloses the other,
    # so the earlier one is not visible here and they share a slot harmlessly.
    if binding_shadows_enclosing_local(scope_id, name):
        report_error_at(node_idx, "E262", "'" + name + "' is already bound in this function; a nested binding overwrites it rather than shadowing it")
    note_fn_binding_name(name, node_idx)
    # children: [type_expr?, value_expr]
    # if 2 children -> first is type annotation, second is value
    # if 1 child -> no annotation, child is value
    if node.children.len() == 2:
        # has type annotation
        annotated := resolve_type_implementation(node.children[0])
        val_node := get_node(node.children[1])
        mut val_type := c_check_expr(node.children[1], scope_id)
        if is_error_type(annotated) == false:
            # an empty collection literal types as an error on its own;
            # under an annotation it takes the annotated type, and the
            # cache entry is what tells the emitter which container (and
            # element kind) to construct
            if is_error_type(val_type):
                if val_node.kind == "list" or val_node.kind == "map" or val_node.kind == "set":
                    propagate_expected_collection_type(node.children[1], annotated)
                # `y: Opt[Int] := Opt.Nothing` — the constructor had no
                # payload argument to infer its instance from, so it typed
                # as the error wildcard. the annotation IS the instance:
                # record it on the constructor expression so the match
                # checker and the emitter both see a typed value.
                else:
                    gbase := generic_enum_construction_base(val_node)
                    if gbase != "":
                        ainfo := get_type_info(annotated)
                        if ainfo.kind == "enum" and extract_base_type_name(ainfo.name) == gbase:
                            expression_type_cache.insert(node.children[1], annotated)
                            val_type = annotated
            if optional_target_accepts_value(node.children[1], val_type, annotated):
                define_binding_at(scope_id, name, annotated, is_mut, node_idx)
                return
            if is_error_type(val_type) == false:
                if annotated != val_type:
                    if types_structurally_equal(annotated, val_type):
                        define_binding_at(scope_id, name, annotated, is_mut, node_idx)
                        return
                    # a collection literal takes the annotated type when its
                    # elements are compatible (allowing optional wrapping),
                    # which also records the type for the emitter's container
                    # choice; a genuinely wrong element type still fails.
                    if collection_literal_matches_target(node.children[1], annotated, scope_id) == false:
                        report_error_at(node.children[1], "E200", "type mismatch: expected " + get_type_name(annotated) + ", got " + get_type_name(val_type))
        define_binding_at(scope_id, name, annotated, is_mut, node_idx)
    elif node.children.len() == 1:
        val_type := c_check_expr(node.children[0], scope_id)
        define_binding_at(scope_id, name, val_type, is_mut, node_idx)
        # an empty collection literal with no annotation has no element
        # type yet; remember the binding so the first value stored into
        # it can retype it (refine_empty_literal_binding).
        if is_error_type(val_type):
            val_node := get_node(node.children[0])
            if val_node.children.len() == 0:
                if val_node.kind == "list" or val_node.kind == "map" or val_node.kind == "set":
                    open_empty_literal_bindings.insert(lookup_binding_index(scope_id, name), node.children[0])
            # `x := Opt.Nothing` — a generic enum constructor whose instance
            # could not be inferred from arguments. left alone, the binding
            # stays silently error-typed and a later match on it runs no arm
            # at runtime. that silence is worse than the error, so demand
            # the annotation here, where the fix is one edit away.
            gbase := generic_enum_construction_base(val_node)
            if gbase != "":
                report_error_at(node.children[0], "E262", "cannot infer the type arguments of generic enum '" + gbase + "' from this constructor; annotate the binding")

# `weak name := expr` holds its struct target without keeping it alive.
# the binding's type is the optional of the target's type — every read
# yields the target, or none once it has been reclaimed — mirroring a
# weak struct field (E249). the target must be a plain struct value,
# and the binding stays immutable: a weak slot is not a variable to
# swap, it is an edge that either still reaches its target or does not.
fn check_weak_binding(node_idx: Int, scope_id: Int, name: String):
    node := get_node(node_idx)
    if node.value.contains(" mut"):
        report_error_at(node_idx, "E261", "a weak binding cannot be 'mut'")
    if node.children.len() == 2:
        report_error_at(node.children[0], "E261", "a weak binding takes its type from its value; remove the annotation")
    val_idx := node.children[node.children.len() - 1]
    val_type := c_check_expr(val_idx, scope_id)
    if is_error_type(val_type):
        define_binding_at(scope_id, name, val_type, false, node_idx)
        return
    if get_type_info(val_type).kind != "struct":
        report_error_at(val_idx, "E261", "a weak binding must hold a struct value, got " + get_type_name(val_type))
        define_binding_at(scope_id, name, TID_ERR, false, node_idx)
        return
    define_binding_at(scope_id, name, add_type_info(ti_optional(val_type)), false, node_idx)

# ---------------------------------------------------------------
# assignment statement
# ---------------------------------------------------------------

fn check_assignment(node: Node, scope_id: Int):
    # node.value is the operator: "=", "+=", "-=", "*=", "/="
    # children[0] is target, children[1] is value
    if node.children.len() < 2:
        return
    target_idx := node.children[0]
    value_idx := node.children[1]
    target_node := get_node(target_idx)
    # check target mutability
    if target_node.kind == "ident":
        if is_binding_mutable(scope_id, target_node.value) == false:
            report_error_with_fix("E216", "cannot assign to immutable variable '" + target_node.value + "'", "declare with 'mut': mut " + target_node.value)
            return
    target_type := c_check_expr(target_idx, scope_id)
    val_type := c_check_expr(value_idx, scope_id)
    # `mut x := none` binds the none type, which only an optional target
    # accepts, so the binding could never be assigned into and the error landed
    # on the first use rather than on the declaration. the first concrete
    # assignment names the type instead: the binding becomes an optional over
    # what was assigned, which is the only type the declaration could have
    # meant. the shell the bind already built is the one that then holds it.
    if target_node.kind == "ident" and is_none_type(target_type):
        if is_error_type(val_type) == false and is_none_type(val_type) == false:
            slot := lookup_binding_index(scope_id, target_node.value)
            if slot >= 0:
                val_info := get_type_info(val_type)
                mut promoted := 0 - 1
                if val_info.kind == "optional":
                    # already an optional: adopt it rather than wrap it again.
                    # the emitter aliases the value's own shell here, so
                    # recording an optional-of-optional described something
                    # nobody built and the second unwrap read the payload as a
                    # shell address.
                    promoted = val_type
                elif val_type != TID_VOID and val_info.kind != "result":
                    promoted = add_type_info(ti_optional(val_type))
                # a void call and a result have no optional to be: leaving
                # promoted unset falls through to the ordinary check, which
                # reports the same mismatch an annotated binding reports.
                if promoted >= 0:
                    set_binding_type_at(slot, promoted)
                    expression_type_cache.insert(target_idx, promoted)
                    return
    if is_error_type(target_type):
        return
    op := node.value
    # these two accept a value the target can be built from, which is a plain
    # assignment's question. a compound assignment asks a different one: it
    # reads the target, applies an operator and writes it back, so an optional
    # target has to be unwrapped first. taking these early returns for `+=` and
    # friends skipped the numeric check below entirely, and the operator was
    # then emitted against the optional's shell address — `x += 3` on an
    # `Int?` holding 5 answered 0, with no diagnostic anywhere.
    if op == "=":
        if optional_target_accepts_value(value_idx, val_type, target_type):
            return
        if collection_literal_matches_target(value_idx, target_type, scope_id):
            return
    if is_error_type(val_type):
        return
    if op == "=":
        if target_type != val_type:
            if types_structurally_equal(target_type, val_type) == false:
                report_error_at(value_idx, "E200", "type mismatch: expected " + get_type_name(target_type) + ", got " + get_type_name(val_type))
    else:
        # compound assignment: +=, -=, *=, /=
        if is_numeric_type(target_type) == false:
            report_error("E217", "operator " + op + " requires numeric type, got " + get_type_name(target_type))
        elif target_type != val_type:
            report_error_at(value_idx, "E200", "type mismatch: expected " + get_type_name(target_type) + ", got " + get_type_name(val_type))

# ---------------------------------------------------------------
# return statement
# ---------------------------------------------------------------

# a block-bodied lambda infers its return type from its return statements;
# the sentinel makes the first return record instead of compare.
TID_LAMBDA_INFER := 0 - 2
mut lambda_inferred_return := 0 - 1

fn check_return_statement(node: Node, scope_id: Int):
    expected := get_scope_return_type(scope_id)
    if expected == TID_LAMBDA_INFER:
        if node.children.len() == 0:
            if lambda_inferred_return < 0:
                lambda_inferred_return = TID_VOID
            return
        first := c_check_expr(node.children[0], scope_id)
        if lambda_inferred_return < 0:
            lambda_inferred_return = first
        elif is_error_type(first) == false and first != lambda_inferred_return:
            if types_structurally_equal(first, lambda_inferred_return) == false:
                report_error("E200", "lambda returns disagree: " + get_type_name(lambda_inferred_return) + " vs " + get_type_name(first))
        return
    if expected < 0:
        report_error("E231", "return outside of function")
        return
    if node.children.len() == 0:
        # bare return
        if expected != TID_VOID:
            report_error("E200", "return type mismatch: expected " + get_type_name(expected) + ", got Void")
        return
    actual := c_check_expr(node.children[0], scope_id)
    actual_node := get_node(node.children[0])
    exp_info := get_type_info(expected)
    # an empty collection literal in return position takes its type from
    # the declared return type; recording it lets the emitter create the
    # container tagged so it owns its elements (`return []` was producing
    # untagged List[String] buffers).
    if actual_node.kind == "list" or actual_node.kind == "map" or actual_node.kind == "set":
        if actual_node.children.len() == 0 and is_error_type(actual):
            if exp_info.kind == "list" or exp_info.kind == "map" or exp_info.kind == "set":
                expression_type_cache.insert(node.children[0], expected)
                return
    if actual_node.kind == "none_lit":
        if exp_info.kind == "optional":
            return
    if is_error_type(actual):
        return
    if actual == expected:
        return
    # allow returning inner type from result-returning function. the
    # structural check covers a tuple inner ((Int, Int)!), whose tid is
    # not interned to a single value the way named types are.
    if exp_info.kind == "result":
        if actual == exp_info.inner:
            return
        if types_structurally_equal(actual, exp_info.inner):
            return
    # allow returning inner type from optional-returning function. the
    # return is recorded as widening, the same record an argument or a
    # binding leaves, because the emitter cannot always tell from the
    # value's shape: `return inner` with `inner: (Int, String)?` into a
    # `((Int, String)?)?` return is an optional handed to an optional and
    # still needs its second shell (#1051).
    if exp_info.kind == "optional":
        if actual == exp_info.inner or types_structurally_equal(actual, exp_info.inner):
            argument_widens_to_optional(node.children[0], actual, expected)
            return
    # check structural equality (tuples)
    if types_structurally_equal(actual, expected):
        return
    # `none` is not a type to widen the signature to; the fix is either an
    # optional return type or a real value.
    if is_none_type(actual):
        report_error_with_fix_at(node.children[0], "E200", "return type mismatch: expected " + get_type_name(expected) + ", got none", "return a value, or declare the return type " + get_type_name(expected) + "?")
        return
    report_error_with_fix_at(node.children[0], "E200", "return type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(actual), "change the return type to " + get_type_name(actual))

# ---------------------------------------------------------------
# fail statement
# ---------------------------------------------------------------

fn check_fail_statement(node: Node, scope_id: Int):
    ret_type := get_scope_return_type(scope_id)
    if ret_type < 0:
        report_error("E231", "fail outside of function")
        return
    ret_info := get_type_info(ret_type)
    if ret_info.kind != "result":
        report_error("E234", "fail requires function to return a result type")
        return
    if node.children.len() < 1:
        return
    err_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(err_type):
        return
    if types_compatible(err_type, ret_info.value_type) == false:
        report_error("E219", "fail type mismatch: expected " + get_type_name(ret_info.value_type) + ", got " + get_type_name(err_type))

# ---------------------------------------------------------------
# if statement
# ---------------------------------------------------------------

fn check_if_statement(node: Node, scope_id: Int):
    # children: [condition, then, elif..., else?]
    if node.children.len() < 2:
        return
    tid_bool := lookup_type_id("Bool")
    # check condition
    cond_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(cond_type) == false:
        if cond_type != tid_bool:
            report_error("E200", "condition must be Bool, got " + get_type_name(cond_type))
    # check then branch
    then_node := get_node(node.children[1])
    if then_node.kind == "then":
        then_scope := create_scope(scope_id)
        if then_node.children.len() > 0:
            block := get_node(then_node.children[0])
            if block.kind == "block":
                check_block_statement(block, then_scope)
    # check elif and else branches (skip first 2: condition + then)
    mut skip_if := 2
    for child in node.children:
        if skip_if > 0:
            skip_if = skip_if - 1
            continue
        cn := get_node(child)
        if cn.kind == "elif":
            elif_scope := create_scope(scope_id)
            if cn.children.len() > 0:
                econd := c_check_expr(cn.children[0], elif_scope)
                if is_error_type(econd) == false:
                    if econd != tid_bool:
                        report_error("E200", "condition must be Bool, got " + get_type_name(econd))
            if cn.children.len() > 1:
                ebody := get_node(cn.children[1])
                if ebody.kind == "block":
                    check_block_statement(ebody, elif_scope)
                elif ebody.kind == "then":
                    if ebody.children.len() > 0:
                        eblock := get_node(ebody.children[0])
                        if eblock.kind == "block":
                            check_block_statement(eblock, elif_scope)
        elif cn.kind == "else":
            else_scope := create_scope(scope_id)
            if cn.children.len() > 0:
                eblock := get_node(cn.children[0])
                if eblock.kind == "block":
                    check_block_statement(eblock, else_scope)

# ---------------------------------------------------------------
# while statement
# ---------------------------------------------------------------

fn check_while_statement(node: Node, scope_id: Int):
    if node.children.len() < 2:
        return
    tid_bool := lookup_type_id("Bool")
    cond_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(cond_type) == false:
        if cond_type != tid_bool:
            report_error("E200", "condition must be Bool, got " + get_type_name(cond_type))
    loop_scope := create_loop_scope(scope_id)
    body_node := get_node(node.children[1])
    if body_node.kind == "body":
        check_function_body(node.children[1], loop_scope)
    elif body_node.kind == "block":
        check_block_statement(body_node, loop_scope)

# if let / while let: a one-pattern conditional. a variant pattern matches
# and destructures like a match arm; a bare binding unwraps an optional
# subject. bindings are visible only in the matched branch (loop body).
fn check_let_pattern(pat_idx: Int, subj_idx: Int, branch_scope: Int, outer_scope: Int, form: String):
    subj_type := c_check_expr(subj_idx, outer_scope)
    if is_error_type(subj_type):
        return
    pat := get_node(pat_idx)
    if pat.kind == "pat_variant":
        check_pattern_match(pat_idx, subj_type, branch_scope)
        return
    if pat.kind == "pat_binding":
        note_fn_binding_name(pat.value, pat_idx)
        info := get_type_info(subj_type)
        if info.kind == "optional":
            define_binding_at(branch_scope, pat.value, info.inner, false, pat_idx)
            return
        report_error("E245", form + " with a bare binding needs an optional subject, got " + get_type_name(subj_type))
        return
    report_error("E245", form + " supports variant patterns and optional bindings")

fn check_if_let_statement(node: Node, scope_id: Int):
    # children: [pattern, subject, then-block, else-block?]
    if node.children.len() < 3:
        return
    then_scope := create_scope(scope_id)
    check_let_pattern(node.children[0], node.children[1], then_scope, scope_id, "if let")
    then_node := get_node(node.children[2])
    if then_node.kind == "block":
        check_block_statement(then_node, then_scope)
    if node.children.len() > 3:
        else_scope := create_scope(scope_id)
        else_node := get_node(node.children[3])
        if else_node.kind == "block":
            check_block_statement(else_node, else_scope)

fn check_while_let_statement(node: Node, scope_id: Int):
    # children: [pattern, subject, body]
    if node.children.len() < 3:
        return
    loop_scope := create_loop_scope(scope_id)
    check_let_pattern(node.children[0], node.children[1], loop_scope, scope_id, "while let")
    body_node := get_node(node.children[2])
    if body_node.kind == "block":
        check_block_statement(body_node, loop_scope)

# ---------------------------------------------------------------
# for statement
# ---------------------------------------------------------------

# If `iter_type` is an iterator (a struct with a `next() -> T?` method), return
# the element type T; otherwise return -1. For a generic struct instance like
# `Iter[Int]`, the method registers under the base name and references the
# struct's type params, so we normalize the lookup and resolve next()'s return
# type with substitution.
fn iterator_element_type(iter_type: Int) -> Int:
    info := get_type_info(iter_type)
    if info.kind != "struct":
        return 0 - 1
    type_name := get_type_name(iter_type)
    # the receiver's tid names the exact declaration; the name-keyed
    # fallbacks stay for generic instances, but a next() belonging to a
    # different declaration of the same name must not answer here.
    mut next_key := method_tid_key(iter_type, "next")
    if has_method_declaration(next_key) == false:
        next_key = type_name + ".next"
        if has_method_declaration(next_key) == false:
            base := extract_base_type_name(type_name)
            if base != type_name:
                next_key = base + ".next"
        next_owner := method_declaration_owner(next_key)
        if next_owner >= 0 and next_owner != iter_type:
            return 0 - 1
    if has_method_declaration(next_key) == false:
        return 0 - 1
    method_node := get_node(get_method_declaration_index(next_key))
    queue_dispatched_method(get_method_declaration_index(next_key), iter_type)
    mut struct_params: List[String] := []
    mut struct_args: List[Int] := []
    if struct_instance_type_args.contains_key(iter_type):
        struct_args = decode_tid_list(struct_instance_type_args[iter_type])
        if struct_instance_base_name.contains_key(iter_type):
            base := struct_instance_base_name[iter_type]
            if has_generic_declaration(base):
                sdecl := get_node(get_generic_declaration_index(base))
                struct_params = collect_generic_parameter_names(sdecl)
    # resolve the iterator's associated types (e.g. `Item` -> Int for Range,
    # or -> the source's element for a MapIter/FilterIter instance) so next()'s
    # `-> Item?` return resolves to the concrete element type
    assoc_base := extract_base_type_name(type_name)
    if type_assoc_names.contains_key(assoc_base):
        for an in type_assoc_names[assoc_base].split(","):
            resolved := resolve_assoc_type_of_instance(iter_type, an)
            if is_error_type(resolved) == false:
                struct_params.push(an)
                struct_args.push(resolved)
    ret_tid := collect_function_return_type_with_subst(method_node, struct_params, struct_args)
    ret_info := get_type_info(ret_tid)
    if ret_info.kind != "optional":
        return 0 - 1
    return ret_info.inner

fn check_for_statement(node: Node, scope_id: Int):
    # node.value: "x" or "x, i" (binding names)
    # children[0]: iterable expression
    # children[1]: body
    if node.children.len() < 2:
        return
    tid_err := lookup_type_id("<error>")
    tid_int := lookup_type_id("Int")
    tid_string := lookup_type_id("String")
    mut elem_type := tid_err
    iter_node := get_node(node.children[0])
    if iter_node.kind == "range":
        # `for i in lo..hi`: the bounds must be Int, and i is bound to Int
        lo_type := c_check_expr(iter_node.children[0], scope_id)
        hi_type := c_check_expr(iter_node.children[1], scope_id)
        if is_error_type(lo_type) or is_error_type(hi_type):
            return
        if lo_type != tid_int or hi_type != tid_int:
            report_error("E217", "range bounds must be Int, got " + get_type_name(lo_type) + ".." + get_type_name(hi_type))
            return
        elem_type = tid_int
    else:
        iter_type := c_check_expr(node.children[0], scope_id)
        if is_error_type(iter_type):
            return
        # infer element type from collection
        iter_info := get_type_info(iter_type)
        if iter_type == tid_string:
            elem_type = tid_string
        elif iter_info.kind == "list":
            elem_type = iter_info.inner
        elif iter_info.kind == "map":
            elem_type = iter_info.key_type
        elif iter_info.kind == "set":
            elem_type = iter_info.inner
        else:
            # iterator protocol: a struct with a `next() -> T?` method is iterable,
            # yielding T until next() returns none
            it_elem := iterator_element_type(iter_type)
            if it_elem >= 0:
                elem_type = it_elem
            else:
                report_error("E217", "cannot iterate over " + get_type_name(iter_type))
                return
    # create loop scope
    loop_scope := create_loop_scope(scope_id)
    # bind the loop variable
    if node.children.len() >= 3:
        elem_name := get_node(node.children[2]).value
        note_fn_binding_name(elem_name, node.children[2])
        define_binding_at(loop_scope, elem_name, elem_type, false, node.children[2])
        # cache the element type on the loop-var node so the ir emitter can
        # read it back (used to type the value extracted from an iterator)
        expression_type_cache.insert(node.children[2], elem_type)
        if node.children.len() >= 4:
            idx_name := get_node(node.children[3]).value
            note_fn_binding_name(idx_name, node.children[3])
            define_binding_at(loop_scope, idx_name, tid_int, false, node.children[3])
    else:
        binding_names := node.value
        define_binding(loop_scope, binding_names.trim(), elem_type, false)
    # check body
    body_node := get_node(node.children[1])
    if body_node.kind == "body":
        check_function_body(node.children[1], loop_scope)
    elif body_node.kind == "block":
        check_block_statement(body_node, loop_scope)

# ---------------------------------------------------------------
# expression checking
# ---------------------------------------------------------------

# type an expression and return its type id, recording the answer in
# expression_type_cache so the emitter can read it back by node index
# through c_get_expr_type. this is the single entry point for expression
# typing — every kind of expression funnels through here, which is why
# it also stamps the node as current, so a diagnostic raised anywhere
# below gets that node's line and column. an expression that fails to
# check yields the `<error>` type rather than a raised error, so test
# the result with is_error_type instead of assuming success. the cache
# is written, never consulted, on this path: calling twice on one node
# re-checks it and can re-report.
pub fn c_check_expr(node_idx: Int, scope_id: Int) -> Int:
    prev := checker_set_current_node(node_idx)
    result := check_expression_implementation(node_idx, scope_id)
    checker_restore_current_node(prev)
    expression_type_cache.insert(node_idx, result)
    return result

# the recorded use-site -> declaration-node map
pub fn get_definition_of() -> Map[Int, Int]:
    return definition_of

# record a use-site -> declaration-node pair. -1 on either side means
# the resolution has no source node (builtins), so nothing is recorded
fn record_definition(use_idx: Int, decl_idx: Int):
    if use_idx >= 0 and decl_idx >= 0:
        definition_of.insert(use_idx, decl_idx)

# look up cached expression type (returns TID_ERR if not found)
pub fn c_get_expr_type(node_idx: Int) -> Int:
    if expression_type_cache.contains_key(node_idx):
        return expression_type_cache[node_idx]
    return TID_ERR

fn check_expression_implementation(node_idx: Int, scope_id: Int) -> Int:
    node := get_node(node_idx)
    tid_int := lookup_type_id("Int")
    tid_float := lookup_type_id("Float")
    tid_string := lookup_type_id("String")
    tid_bool := lookup_type_id("Bool")
    if node.kind == "int_lit":
        return tid_int
    if node.kind == "float_lit":
        return tid_float
    if node.kind == "string_lit":
        return tid_string
    if node.kind == "bool_lit":
        return tid_bool
    if node.kind == "none_lit":
        return TID_NONE
    if node.kind == "ident":
        return check_identifier(node_idx, node.value, scope_id)
    if node.kind == "self":
        return check_identifier(node_idx, "self", scope_id)
    if node.kind == "binary":
        return check_binary_expression(node, scope_id)
    if node.kind == "unary":
        return check_unary_expression(node, scope_id)
    if node.kind == "grouped":
        if node.children.len() > 0:
            return c_check_expr(node.children[0], scope_id)
        return TID_ERR
    if node.kind == "string_interp":
        # check all interpolated expressions; a format-spec part wraps
        # its expression one level down
        for child in node.children:
            cn := get_node(child)
            if cn.kind == "interp_spec":
                spec_tid := c_check_expr(cn.children[0], scope_id)
                if is_error_type(spec_tid) == false:
                    if type_supports_stringify(spec_tid) == false:
                        report_error("E219", "string interpolation requires a stringifiable value, got " + get_type_name(spec_tid))
            elif cn.kind != "lit":
                expr_tid := c_check_expr(child, scope_id)
                if is_error_type(expr_tid) == false:
                    if type_supports_stringify(expr_tid) == false:
                        report_error("E219", "string interpolation requires a stringifiable value, got " + get_type_name(expr_tid))
        return tid_string
    if node.kind == "if_expr":
        return check_if_expression(node, scope_id)
    if node.kind == "call":
        return check_function_call(node, scope_id)
    if node.kind == "method_call":
        return check_method_call(node, scope_id)
    if node.kind == "field_access":
        return check_field_access_expression(node, scope_id)
    if node.kind == "index":
        return check_index_expression(node, scope_id)
    if node.kind == "unwrap":
        return check_unwrap_expression(node, scope_id)
    if node.kind == "try":
        return check_try_expression(node, scope_id)
    if node.kind == "catch_expr":
        return check_catch_expression(node, scope_id)
    if node.kind == "catch_block":
        return check_catch_block(node, scope_id)
    if node.kind == "select_expr":
        return check_select_expression(node, scope_id)
    if node.kind == "match_expr":
        return check_match_expression(node_idx, scope_id)
    if node.kind == "lambda":
        return check_lambda_expression(node, scope_id)
    if node.kind == "list":
        return check_list_expression(node, scope_id)
    if node.kind == "map":
        return check_map_expression(node, scope_id)
    if node.kind == "set":
        return check_set_expression(node, scope_id)
    if node.kind == "tuple":
        return check_tuple_expression(node, scope_id)
    if node.kind == "struct_init":
        return check_struct_initialization(node, scope_id)
    if node.kind == "spawn":
        return check_spawn_expression(node, scope_id)
    if node.kind == "await":
        return check_await_expression(node, scope_id)
    return TID_ERR

fn type_supports_stringify(tid: Int) -> Bool:
    if tid < 0:
        return false
    info := get_type_info(tid)
    if info.kind == "primitive":
        return info.name == "String" or info.name == "Int" or info.name == "UInt" or info.name == "Int8" or info.name == "Int16" or info.name == "Int32" or info.name == "Int64" or info.name == "UInt8" or info.name == "UInt16" or info.name == "UInt32" or info.name == "UInt64" or info.name == "Float" or info.name == "Bool"
    if info.kind == "result":
        return type_supports_stringify(info.inner) and type_supports_stringify(info.value_type)
    # containers render as "[a, b]" / "{k: v}"; structs render through a
    # show() impl or a synthesized "Name(field: value)" form
    if info.kind == "list" or info.kind == "set":
        return type_supports_stringify(info.inner)
    if info.kind == "map":
        return type_supports_stringify(info.key_type) and type_supports_stringify(info.value_type)
    if info.kind == "struct":
        return true
    # an optional renders as "none" or as its payload's own text, so it is
    # stringifiable exactly when the payload is
    if info.kind == "optional":
        return type_supports_stringify(info.inner)
    return false

# ---------------------------------------------------------------
# identifier lookup
# ---------------------------------------------------------------

# true when the current module from-imported the name (from any
# module) or wildcard-imports anything. name-level, deliberately loose:
# it never rejects a genuine import, only names no import mentions.
fn current_module_imports_name(name: String) -> Bool:
    wildcard_needle := current_checker_module_path + chr(9)
    for w in generic_wildcard_import_entries:
        if w.starts_with(wildcard_needle):
            return true
    needle := current_checker_module_path + chr(9) + name + chr(9)
    for entry in generic_named_import_entries:
        if entry.starts_with(needle):
            return true
    return false

# the module a from-import in the current module names as the source of
# `name`, or "". first matching entry wins; an aliased or wildcard import
# leaves the name unresolved here and the caller keeps the global answer.
fn from_import_source_module(name: String) -> String:
    needle := current_checker_module_path + chr(9) + name + chr(9)
    for entry in generic_named_import_entries:
        if entry.starts_with(needle):
            return entry.substring(needle.len(), entry.len())
    return ""

fn check_identifier(node_idx: Int, name: String, scope_id: Int) -> Int:
    tid := lookup_binding(scope_id, name)
    if tid >= 0:
        # a name defined by another module resolves only through an
        # import; the shared global scope would otherwise let it leak
        # across modules and die later in emission. builtins and the
        # current module's own names always pass.
        if binding_visible_from(scope_id, name, current_checker_module_path) == false:
            # the shared global scope answers with whichever module
            # registered the name last. a from-import names its source
            # module, so prefer the declaration that module owns —
            # otherwise two modules declaring the same function name
            # (binary.reader / protobuf.reader) hand the caller the wrong
            # signature, and every type derived from it is the wrong
            # module's same-named struct.
            source := from_import_source_module(name)
            if source.len() > 0:
                owned := lookup_binding_owned_by(scope_id, name, source)
                if owned >= 0:
                    return owned
            if current_module_imports_name(name) == false:
                # a generic declaration never enters the binding table, so a
                # module calling its own generic fn can land here when some
                # other loaded module has a concrete fn of the same name
                # (collections.partition[T] vs strings.partition). the generic
                # resolver is module-aware and prefers the current module, so
                # let the generic call path take over exactly as it does when
                # no concrete binding exists at all.
                if has_generic_declaration(name):
                    return TID_ERR
                report_error_with_fix_at(node_idx, "E201", "'" + name + "' belongs to another module and is not imported here", "import it where it is defined")
                return TID_ERR
        record_definition(node_idx, lookup_binding_decl_node(scope_id, name))
        return tid
    # check if it's a generic decl name — suppress false "undefined" errors
    if has_generic_declaration(name):
        return TID_ERR
    report_error_at(node_idx, "E201", "undefined variable: " + name)
    return TID_ERR

# ---------------------------------------------------------------
# binary expression checking
# ---------------------------------------------------------------

fn check_binary_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 2:
        return TID_ERR
    op := node.value
    tid_bool := lookup_type_id("Bool")
    tid_string := lookup_type_id("String")
    # pipe operator: special handling
    if op == "pipe":
        return check_pipe_expression(node, scope_id)

    left_node := get_node(node.children[0])
    right_node := get_node(node.children[1])
    left := c_check_expr(node.children[0], scope_id)
    right := c_check_expr(node.children[1], scope_id)

    # `x == none` is the emptiness test, so an optional on the other side is
    # the whole point. the node-kind arms carry the literal; the tid arms
    # carry a name bound to a bare `none`. anything else falls through to the
    # ordinary comparison check, which now reports rather than skipping.
    if op == "eq" or op == "neq":
        left_is_none := left_node.kind == "none_lit" or is_none_type(left)
        right_is_none := right_node.kind == "none_lit" or is_none_type(right)
        if left_is_none and right_is_none:
            return tid_bool
        if left_is_none:
            if get_type_info(right).kind == "optional":
                return tid_bool
        if right_is_none:
            if get_type_info(left).kind == "optional":
                return tid_bool

    if is_error_type(left):
        return TID_ERR
    if is_error_type(right):
        return TID_ERR

    # string concatenation
    if op == "add":
        if left == tid_string:
            if right == tid_string:
                return tid_string

    # arithmetic operators: add, sub, mul, div, mod
    if op == "add":
        if is_numeric_type(left) == false:
            report_error("E217", "operator + requires numeric type, got " + get_type_name(left))
            return TID_ERR
        if left != right:
            report_error("E217", "operator + type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return left
    if op == "sub":
        if is_numeric_type(left) == false:
            report_error("E217", "operator - requires numeric type, got " + get_type_name(left))
            return TID_ERR
        if left != right:
            report_error("E217", "operator - type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return left
    if op == "mul":
        if is_numeric_type(left) == false:
            report_error("E217", "operator * requires numeric type, got " + get_type_name(left))
            return TID_ERR
        if left != right:
            report_error("E217", "operator * type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return left
    if op == "div":
        if is_numeric_type(left) == false:
            report_error("E217", "operator / requires numeric type, got " + get_type_name(left))
            return TID_ERR
        if left != right:
            report_error("E217", "operator / type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return left
    if op == "mod":
        if is_integer_type(left) == false:
            report_error("E217", "operator % requires integer type, got " + get_type_name(left))
            return TID_ERR
        if left != right:
            report_error("E217", "operator % type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return left

    # comparison operators: eq, neq
    if op == "eq":
        if left != right and optional_types_match(left, right) == false and optional_plain_comparison(left, right) == false:
            report_error("E217", "operator == type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool
    if op == "neq":
        if left != right and optional_types_match(left, right) == false and optional_plain_comparison(left, right) == false:
            report_error("E217", "operator != type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool

    # ordering: lt, gt, lte, gte
    if op == "lt":
        if is_numeric_type(left) == false:
            if left != tid_string:
                report_error("E217", "operator < requires numeric or string type, got " + get_type_name(left))
                return TID_ERR
        if left != right:
            report_error("E217", "operator < type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool
    if op == "gt":
        if is_numeric_type(left) == false:
            if left != tid_string:
                report_error("E217", "operator > requires numeric or string type, got " + get_type_name(left))
                return TID_ERR
        if left != right:
            report_error("E217", "operator > type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool
    if op == "lte":
        if is_numeric_type(left) == false:
            if left != tid_string:
                report_error("E217", "operator <= requires numeric or string type, got " + get_type_name(left))
                return TID_ERR
        if left != right:
            report_error("E217", "operator <= type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool
    if op == "gte":
        if is_numeric_type(left) == false:
            if left != tid_string:
                report_error("E217", "operator >= requires numeric or string type, got " + get_type_name(left))
                return TID_ERR
        if left != right:
            report_error("E217", "operator >= type mismatch: " + get_type_name(left) + " vs " + get_type_name(right))
            return TID_ERR
        return tid_bool

    # logical: and, or
    if op == "and":
        if left != tid_bool:
            report_error("E217", "operator 'and' requires Bool, got " + get_type_name(left))
            return TID_ERR
        if right != tid_bool:
            report_error("E217", "operator 'and' requires Bool, got " + get_type_name(right))
            return TID_ERR
        return tid_bool
    if op == "or":
        if left != tid_bool:
            report_error("E217", "operator 'or' requires Bool, got " + get_type_name(left))
            return TID_ERR
        if right != tid_bool:
            report_error("E217", "operator 'or' requires Bool, got " + get_type_name(right))
            return TID_ERR
        return tid_bool

    return TID_ERR

# ---------------------------------------------------------------
# pipe expression: value | fn_name
# ---------------------------------------------------------------

fn check_pipe_expression(node: Node, scope_id: Int) -> Int:
    left := c_check_expr(node.children[0], scope_id)
    if is_error_type(left):
        return TID_ERR
    rhs_node := get_node(node.children[1])
    if rhs_node.kind != "ident":
        report_error("E208", "pipe operator requires a function name on the right")
        return TID_ERR
    fn_name := rhs_node.value
    fn_tid := lookup_binding(scope_id, fn_name)
    if fn_tid < 0:
        report_error("E201", "undefined function: " + fn_name)
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "'" + fn_name + "' is not a function")
        return TID_ERR
    if fn_info.param_types.len() != 1:
        report_error("E207", "pipe target '" + fn_name + "' must take exactly 1 parameter")
        return TID_ERR
    if left != fn_info.param_types[0]:
        report_error("E200", "pipe type mismatch: function expects " + get_type_name(fn_info.param_types[0]) + ", got " + get_type_name(left))
        return TID_ERR
    return fn_info.return_type

# ---------------------------------------------------------------
# unary expression
# ---------------------------------------------------------------

fn check_unary_expression(node: Node, scope_id: Int) -> Int:
    tid_bool := lookup_type_id("Bool")
    if node.children.len() < 1:
        return TID_ERR
    operand := c_check_expr(node.children[0], scope_id)
    if is_error_type(operand):
        return TID_ERR
    op := node.value
    if op == "negate":
        if is_numeric_type(operand) == false:
            report_error("E217", "unary - requires numeric type, got " + get_type_name(operand))
            return TID_ERR
        return operand
    if op == "not":
        if operand != tid_bool:
            report_error("E217", "unary 'not' requires Bool, got " + get_type_name(operand))
            return TID_ERR
        return tid_bool
    return TID_ERR

# ---------------------------------------------------------------
# call expression
# ---------------------------------------------------------------

fn check_json_decode_callee(index_node: Node, member_name: String) -> Bool:
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind != "field_access" or base_node.value != member_name:
        return false
    if base_node.children.len() < 1:
        return false
    recv_node := get_node(base_node.children[0])
    if recv_node.kind != "ident":
        return false
    if module_aliases.contains_key(recv_node.value):
        if module_aliases[recv_node.value] == "std.json":
            return true
    return recv_node.value == "json" or recv_node.value == "json_mod"

fn check_config_decode_callee(index_node: Node, member_name: String) -> Bool:
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind != "field_access" or base_node.value != member_name:
        return false
    if base_node.children.len() < 1:
        return false
    recv_node := get_node(base_node.children[0])
    if recv_node.kind != "ident":
        return false
    if module_aliases.contains_key(recv_node.value):
        if module_aliases[recv_node.value] == "std.config":
            return true
    return recv_node.value == "config" or recv_node.value == "config_mod"

# std.toml and std.yaml decode the same way — both parse into a node pool
# addressed by Int handles — so one check serves both. this returns the short
# module name the call goes through ("toml" or "yaml"), or "" when the call is
# not a handle-pool decode. the caller needs the name for the error type and
# for the messages.
fn handle_decode_module(index_node: Node, member_name: String) -> String:
    if index_node.kind != "index" or index_node.children.len() < 2:
        return ""
    base_node := get_node(index_node.children[0])
    if base_node.kind != "field_access" or base_node.value != member_name:
        return ""
    if base_node.children.len() < 1:
        return ""
    recv_node := get_node(base_node.children[0])
    if recv_node.kind != "ident":
        return ""
    if module_aliases.contains_key(recv_node.value):
        if module_aliases[recv_node.value] == "std.toml":
            return "toml"
        if module_aliases[recv_node.value] == "std.yaml":
            return "yaml"
    if recv_node.value == "toml" or recv_node.value == "toml_mod":
        return "toml"
    if recv_node.value == "yaml" or recv_node.value == "yaml_mod":
        return "yaml"
    return ""

fn check_handle_decode_callee(index_node: Node, member_name: String) -> Bool:
    return handle_decode_module(index_node, member_name).len() > 0

fn handle_decode_error_type(module_name: String) -> String:
    if module_name == "yaml":
        return "YamlDecodeError"
    return "TomlDecodeError"

fn check_config_file_decode_callee(index_node: Node, member_name: String) -> Bool:
    if index_node.kind != "index" or index_node.children.len() < 2:
        return false
    base_node := get_node(index_node.children[0])
    if base_node.kind == "ident":
        return base_node.value == member_name
    if base_node.kind != "field_access" or base_node.value != member_name:
        return false
    if base_node.children.len() < 1:
        return false
    recv_node := get_node(base_node.children[0])
    if recv_node.kind != "ident":
        return false
    if module_aliases.contains_key(recv_node.value):
        if module_aliases[recv_node.value] == "std.config":
            return true
    return recv_node.value == "config" or recv_node.value == "config_mod"

fn resolve_json_decode_type_arg(type_arg_idx: Int) -> Int:
    type_arg := get_node(type_arg_idx)
    if type_arg.kind == "ident":
        return resolve_named_type(type_arg.value)
    if type_arg.kind == "field_access" and type_arg.children.len() > 0:
        recv := get_node(type_arg.children[0])
        if recv.kind == "ident":
            return resolve_named_type(recv.value + "." + type_arg.value)
    report_error("E202", "json.decode type argument must be a concrete struct type")
    return TID_ERR

fn decode_support_seen_key(field_tid: Int) -> String:
    return "|" + field_tid.to_string() + "|"

fn json_decode_field_supported_with_seen(field_tid: Int, seen: String) -> Bool:
    if field_tid == lookup_type_id("String") or field_tid == lookup_type_id("Int") or field_tid == lookup_type_id("Bool"):
        return true
    info := get_type_info(field_tid)
    if info.kind == "optional" and info.inner >= 0:
        return json_decode_field_supported_with_seen(info.inner, seen)
    if info.kind == "struct":
        seen_key := decode_support_seen_key(field_tid)
        if seen.contains(seen_key):
            return false
        next_seen := seen + seen_key
        for field_name, i in info.fields:
            if i < info.field_pub.len() and not info.field_pub[i]:
                return false
            if i >= info.field_types.len():
                return false
            if not json_decode_field_supported_with_seen(info.field_types[i], next_seen):
                return false
        return true
    return false

fn json_decode_field_supported(field_tid: Int) -> Bool:
    return json_decode_field_supported_with_seen(field_tid, "")

fn check_config_decode_call(index_node: Node, arg_indices: List[Int], scope_id: Int, prefixed: Bool) -> Int:
    if index_node.children.len() < 2:
        report_error("E222", "config.decode requires an explicit struct type")
        return TID_ERR

    mut expected_args := 1
    if prefixed:
        expected_args = 2
    if arg_indices.len() != expected_args:
        report_error("E207", "config.decode expects " + expected_args.to_string() + " argument(s), got " + arg_indices.len().to_string())
        return TID_ERR

    target_tid := resolve_json_decode_type_arg(index_node.children[1])
    if is_error_type(target_tid):
        return TID_ERR
    target_info := get_type_info(target_tid)
    if target_info.kind != "struct":
        report_error("E219", "config.decode target must be a struct, got " + get_type_name(target_tid))
        return TID_ERR

    cfg_tid := lookup_type_id("Config")
    if cfg_tid < 0:
        report_error("E202", "unknown type: Config")
        return TID_ERR
    first_arg_tid := c_check_expr(arg_indices[0], scope_id)
    if is_error_type(first_arg_tid) == false and first_arg_tid != cfg_tid:
        report_error("E219", "config.decode argument type mismatch: expected Config, got " + get_type_name(first_arg_tid))
        return TID_ERR
    if prefixed:
        prefix_tid := c_check_expr(arg_indices[1], scope_id)
        string_tid := lookup_type_id("String")
        if is_error_type(prefix_tid) == false and prefix_tid != string_tid:
            report_error("E219", "config.decode prefix type mismatch: expected String, got " + get_type_name(prefix_tid))
            return TID_ERR

    for field_name, i in target_info.fields:
        if i < target_info.field_pub.len() and not target_info.field_pub[i]:
            report_error("E219", "config.decode target field must be public: " + field_name)
            return TID_ERR
        if i < target_info.field_types.len():
            field_tid := target_info.field_types[i]
            if not json_decode_field_supported(field_tid):
                report_error("E219", "config.decode does not support field '" + field_name + "' of type " + get_type_name(field_tid))
                return TID_ERR
    err_tid := lookup_type_id("ConfigError")
    if err_tid < 0:
        report_error("E202", "unknown type: ConfigError")
        return TID_ERR
    return add_type_info(ti_result(target_tid, err_tid))

fn check_json_decode_call(index_node: Node, arg_indices: List[Int], scope_id: Int, text_input: Bool) -> Int:
    if index_node.children.len() < 2:
        report_error("E222", "json.decode requires an explicit struct type")
        return TID_ERR
    if arg_indices.len() != 1:
        report_error("E207", "json.decode expects 1 argument, got " + arg_indices.len().to_string())
        return TID_ERR

    target_tid := resolve_json_decode_type_arg(index_node.children[1])
    if is_error_type(target_tid):
        return TID_ERR
    target_info := get_type_info(target_tid)
    if target_info.kind != "struct":
        report_error("E219", "json.decode target must be a struct, got " + get_type_name(target_tid))
        return TID_ERR

    arg_node := get_node(arg_indices[0])
    mut arg_expr_idx := arg_indices[0]
    if arg_node.kind == "arg" and arg_node.children.len() > 0:
        arg_expr_idx = arg_node.children[0]
    arg_tid := c_check_expr(arg_expr_idx, scope_id)
    mut expected_tid := lookup_type_id("Bytes")
    if text_input:
        expected_tid = lookup_type_id("String")
    if is_error_type(arg_tid) == false and arg_tid != expected_tid:
        report_error("E219", "json.decode argument type mismatch: expected " + get_type_name(expected_tid) + ", got " + get_type_name(arg_tid))
        return TID_ERR

    for field_name, i in target_info.fields:
        if i < target_info.field_pub.len() and not target_info.field_pub[i]:
            report_error("E219", "json.decode target field must be public: " + field_name)
            return TID_ERR
        if i < target_info.field_types.len():
            field_tid := target_info.field_types[i]
            if not json_decode_field_supported(field_tid):
                report_error("E219", "json.decode does not support field '" + field_name + "' of type " + get_type_name(field_tid))
                return TID_ERR
    err_tid := lookup_type_id("JsonDecodeError")
    if err_tid < 0:
        report_error("E202", "unknown type: JsonDecodeError")
        return TID_ERR
    return add_type_info(ti_result(target_tid, err_tid))

fn check_handle_decode_call(index_node: Node, module_name: String, arg_indices: List[Int], scope_id: Int, text_input: Bool) -> Int:
    label := module_name + ".decode"
    if index_node.children.len() < 2:
        report_error("E222", label + " requires an explicit struct type")
        return TID_ERR
    if arg_indices.len() != 1:
        report_error("E207", label + " expects 1 argument, got " + arg_indices.len().to_string())
        return TID_ERR

    target_tid := resolve_json_decode_type_arg(index_node.children[1])
    if is_error_type(target_tid):
        return TID_ERR
    target_info := get_type_info(target_tid)
    if target_info.kind != "struct":
        report_error("E219", label + " target must be a struct, got " + get_type_name(target_tid))
        return TID_ERR

    arg_node := get_node(arg_indices[0])
    mut arg_expr_idx := arg_indices[0]
    if arg_node.kind == "arg" and arg_node.children.len() > 0:
        arg_expr_idx = arg_node.children[0]
    arg_tid := c_check_expr(arg_expr_idx, scope_id)
    mut expected_tid := lookup_type_id("Int")
    if text_input:
        expected_tid = lookup_type_id("String")
    if is_error_type(arg_tid) == false and arg_tid != expected_tid:
        report_error("E219", label + " argument type mismatch: expected " + get_type_name(expected_tid) + ", got " + get_type_name(arg_tid))
        return TID_ERR

    for field_name, i in target_info.fields:
        if i < target_info.field_pub.len() and not target_info.field_pub[i]:
            report_error("E219", label + " target field must be public: " + field_name)
            return TID_ERR
        if i < target_info.field_types.len():
            field_tid := target_info.field_types[i]
            if not json_decode_field_supported(field_tid):
                report_error("E219", label + " does not support field '" + field_name + "' of type " + get_type_name(field_tid))
                return TID_ERR
    err_name := handle_decode_error_type(module_name)
    err_tid := lookup_type_id(err_name)
    if err_tid < 0:
        report_error("E202", "unknown type: " + err_name)
        return TID_ERR
    return add_type_info(ti_result(target_tid, err_tid))

fn check_config_file_decode_call(index_node: Node, arg_indices: List[Int], scope_id: Int) -> Int:
    if index_node.children.len() < 2:
        report_error("E222", "config typed file decode requires an explicit struct type")
        return TID_ERR
    if arg_indices.len() != 1:
        report_error("E207", "config typed file decode expects 1 argument, got " + arg_indices.len().to_string())
        return TID_ERR

    target_tid := resolve_json_decode_type_arg(index_node.children[1])
    if is_error_type(target_tid):
        return TID_ERR
    target_info := get_type_info(target_tid)
    if target_info.kind != "struct":
        report_error("E219", "config typed file decode target must be a struct, got " + get_type_name(target_tid))
        return TID_ERR

    arg_node := get_node(arg_indices[0])
    mut arg_expr_idx := arg_indices[0]
    if arg_node.kind == "arg" and arg_node.children.len() > 0:
        arg_expr_idx = arg_node.children[0]
    arg_tid := c_check_expr(arg_expr_idx, scope_id)
    expected_tid := lookup_type_id("String")
    if is_error_type(arg_tid) == false and arg_tid != expected_tid:
        report_error("E219", "config typed file decode argument type mismatch: expected " + get_type_name(expected_tid) + ", got " + get_type_name(arg_tid))
        return TID_ERR

    for field_name, i in target_info.fields:
        if i < target_info.field_pub.len() and not target_info.field_pub[i]:
            report_error("E219", "config typed file decode target field must be public: " + field_name)
            return TID_ERR
        if i < target_info.field_types.len():
            field_tid := target_info.field_types[i]
            if not json_decode_field_supported(field_tid):
                report_error("E219", "config typed file decode does not support field '" + field_name + "' of type " + get_type_name(field_tid))
                return TID_ERR
    err_tid := lookup_type_id("ConfigError")
    if err_tid < 0:
        report_error("E202", "unknown type: ConfigError")
        return TID_ERR
    return add_type_info(ti_result(target_tid, err_tid))

fn check_explicit_generic_callee_name(index_node: Node) -> String:
    if index_node.kind != "index" or index_node.children.len() < 1:
        return ""
    base_node := get_node(index_node.children[0])
    if base_node.kind == "ident":
        return base_node.value
    if base_node.kind == "field_access" and base_node.children.len() > 0:
        recv_node := get_node(base_node.children[0])
        if recv_node.kind == "ident" and module_aliases.contains_key(recv_node.value):
            return module_generic_target_name(module_aliases[recv_node.value], base_node.value)
    return ""

# an explicit type argument at a call site is parsed as an expression, not as
# a type: `Holder[List[Int]]` is an index node whose argument is itself an
# index node, `Holder[Int?]` is an index node over an unwrap, and
# `Channel[(Int, String)?]` is an unwrap over a tuple node whose elements are
# expressions. none of those kinds means anything to the type-expression
# resolver, so they used to come back as the error type — which is a wildcard
# everywhere it is compared, so the instance took `<error>` for its field and
# the field read guessed a layout and faulted, and a channel built over one
# type-checked clean while its `recv` resolved to nothing. resolve the
# expression shapes here instead, and refuse a shape that is not a type at all
# (a literal, a call) out loud rather than handing the wildcard back silently.
fn resolve_explicit_type_arg(type_arg_idx: Int) -> Int:
    type_arg := get_node(type_arg_idx)
    if type_arg.kind == "ident":
        return resolve_named_type(type_arg.value)
    if type_arg.kind == "index":
        return resolve_explicit_generic_type_arg(type_arg)
    if type_arg.kind == "unwrap":
        if type_arg.children.len() == 0:
            return TID_ERR
        inner := resolve_explicit_type_arg(type_arg.children[0])
        if is_error_type(inner):
            return TID_ERR
        return add_type_info(ti_optional(inner))
    if type_arg.kind == "grouped" and type_arg.children.len() == 1:
        return resolve_explicit_type_arg(type_arg.children[0])
    # an associated type of a type parameter, `engine[A.Msg]()`, parses as a
    # field access on the parameter's name. the dotted spelling is what
    # resolve_named_type already takes for `T.Item`: under the substitution a
    # walked generic body runs with, it resolves through the concrete type's
    # binding; while a generic signature registers, it is the suppressed
    # error type it always was.
    if type_arg.kind == "field_access" and type_arg.children.len() > 0:
        recv := get_node(type_arg.children[0])
        if recv.kind == "ident":
            return resolve_named_type(recv.value + "." + type_arg.value)
    if type_arg.kind == "tuple":
        if type_arg.children.len() == 0:
            report_error_at(type_arg_idx, "E210", "type argument must be a type, not an empty tuple")
            return TID_ERR
        mut elems: List[Int] := []
        for child in type_arg.children:
            elem := resolve_explicit_type_arg(child)
            if is_error_type(elem):
                return TID_ERR
            elems.push(elem)
        return add_type_info(ti_tuple(elems))
    if is_type_node_kind(type_arg.kind):
        return resolve_type_implementation(type_arg_idx)
    report_error_at(type_arg_idx, "E210", "type argument must be a type")
    return TID_ERR

# the node kinds the type-expression resolver understands: what an annotation
# parses to, as opposed to the expression shapes a call site's type argument
# takes.
fn is_type_node_kind(kind: String) -> Bool:
    if kind == "type" or kind == "generic_type" or kind == "optional_type":
        return true
    return kind == "result_type" or kind == "tuple_type" or kind == "fn_type"

# `List[Int]` and `mod.Box[String]` in explicit-type-argument position. the
# base names a generic type the same way the enclosing call's base does, so it
# goes through check_explicit_generic_callee_name for the module-qualified
# spelling and resolve_imported_type_name for the bare one.
fn resolve_explicit_generic_type_arg(type_arg: Node) -> Int:
    if type_arg.children.len() < 2:
        return TID_ERR
    base_node := get_node(type_arg.children[0])
    mut base := ""
    if base_node.kind == "ident":
        base = resolve_imported_type_name(base_node.value)
    else:
        base = check_explicit_generic_callee_name(type_arg)
    if base.len() == 0:
        return TID_ERR
    mut args: List[Int] := []
    mut i := 1
    while i < type_arg.children.len():
        arg := resolve_explicit_type_arg(type_arg.children[i])
        if is_error_type(arg):
            return TID_ERR
        args.push(arg)
        i = i + 1
    return resolve_generic_type(base, args)

fn check_generic_struct_call_explicit(name: String, index_node: Node, arg_indices: List[Int], scope_id: Int) -> Int:
    decl_idx := get_generic_declaration_index(name)
    if decl_idx < 0:
        return TID_ERR
    decl_node := get_node(decl_idx)
    generic_params := collect_generic_parameter_names(decl_node)
    mut type_args: List[Int] := []
    mut i := 1
    while i < index_node.children.len():
        type_args.push(resolve_explicit_type_arg(index_node.children[i]))
        i = i + 1
    if type_args.len() != generic_params.len():
        report_error("E221", name + " expects " + generic_params.len().to_string() + " type arguments, got " + type_args.len().to_string())
        return TID_ERR
    mut subst_map: Map[String, Int] := {}
    for gp, gp_i in generic_params:
        if gp_i < type_args.len():
            subst_map.insert(gp, type_args[gp_i])
    if check_type_parameter_bounds(decl_idx, subst_map) == false:
        return TID_ERR
    struct_tid := instantiate_generic_struct_type(decl_idx, type_args)
    if struct_tid < 0:
        return TID_ERR
    return check_struct_constructor(get_type_name(struct_tid), struct_tid, get_type_info(struct_tid), arg_indices, scope_id)

fn check_generic_function_call_explicit(name: String, index_node: Node, arg_indices: List[Int], scope_id: Int) -> Int:
    decl_idx := get_generic_declaration_index(name)
    if decl_idx < 0:
        return TID_ERR
    decl_node := get_node(decl_idx)
    generic_params := collect_generic_parameter_names(decl_node)
    mut subst_args: List[Int] := []
    mut i := 1
    while i < index_node.children.len():
        subst_args.push(resolve_explicit_type_arg(index_node.children[i]))
        i = i + 1
    if subst_args.len() != generic_params.len():
        report_error("E221", name + " expects " + generic_params.len().to_string() + " type arguments, got " + subst_args.len().to_string())
        return TID_ERR
    mut subst_map: Map[String, Int] := {}
    for gp, gp_i in generic_params:
        if gp_i < subst_args.len():
            subst_map.insert(gp, subst_args[gp_i])
    if check_type_parameter_bounds(decl_idx, subst_map) == false:
        return TID_ERR
    record_generic_call_subst(subst_args)
    queue_function_specialization(decl_idx, 0 - 1, subst_args)

    mut arg_types: List[Int] := []
    for ai in arg_indices:
        arg_node := get_node(ai)
        mut arg_expr := ai
        if arg_node.kind == "arg" and arg_node.children.len() > 0:
            arg_expr = arg_node.children[0]
        arg_types.push(c_check_expr(arg_expr, scope_id))

    mut param_type_nodes: List[Int] := []
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                param_type_nodes.push(cn.children[0])
            else:
                param_type_nodes.push(-1)
    if arg_types.len() != param_type_nodes.len():
        report_error("E207", "expected " + param_type_nodes.len().to_string() + " arguments, got " + arg_types.len().to_string())
        return TID_ERR

    mut ret_type := TID_VOID
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            ret_type = resolve_type_with_substitution_map(cn.children[0], generic_params, subst_args)

    # same widening rule as the inferred path: a plain value satisfies an
    # optional parameter once the explicit type args make it concrete.
    mut vidx := 0
    for ptn in param_type_nodes:
        if ptn >= 0 and vidx < arg_types.len():
            concrete := resolve_type_with_substitution_map(ptn, generic_params, subst_args)
            if is_error_type(concrete) == false and is_error_type(arg_types[vidx]) == false:
                if arg_types[vidx] != concrete:
                    if argument_widens_to_optional(argument_expression_index(arg_indices[vidx]), arg_types[vidx], concrete) == false:
                        if types_structurally_equal(arg_types[vidx], concrete) == false:
                            report_error("E219", "argument type mismatch: expected " + get_type_name(concrete) + ", got " + get_type_name(arg_types[vidx]))
        vidx = vidx + 1
    return ret_type

fn check_function_call(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        return TID_ERR
    callee_idx := node.children[0]
    callee_node := get_node(callee_idx)

    # get argument nodes (children after callee)
    mut arg_indices: List[Int] := []
    mut skip_callee := 1
    for child in node.children:
        if skip_callee > 0:
            skip_callee = skip_callee - 1
            continue
        arg_indices.push(child)

    # Channel[T]() constructor — callee is an index expr like Channel[Int]
    if callee_node.kind == "index":
        if check_json_decode_callee(callee_node, "decode"):
            return check_json_decode_call(callee_node, arg_indices, scope_id, false)
        if check_json_decode_callee(callee_node, "decode_text"):
            return check_json_decode_call(callee_node, arg_indices, scope_id, true)
        if check_config_decode_callee(callee_node, "decode"):
            return check_config_decode_call(callee_node, arg_indices, scope_id, false)
        if check_config_decode_callee(callee_node, "decode_prefix"):
            return check_config_decode_call(callee_node, arg_indices, scope_id, true)
        if check_handle_decode_callee(callee_node, "decode"):
            return check_handle_decode_call(callee_node, handle_decode_module(callee_node, "decode"), arg_indices, scope_id, false)
        if check_handle_decode_callee(callee_node, "decode_text"):
            return check_handle_decode_call(callee_node, handle_decode_module(callee_node, "decode_text"), arg_indices, scope_id, true)
        if check_config_file_decode_callee(callee_node, "from_toml_file_typed"):
            return check_config_file_decode_call(callee_node, arg_indices, scope_id)
        if check_config_file_decode_callee(callee_node, "from_json_file_typed"):
            return check_config_file_decode_call(callee_node, arg_indices, scope_id)
        if callee_node.children.len() >= 2:
            obj_node := get_node(callee_node.children[0])
            if obj_node.kind == "ident":
                if obj_node.value == "Channel":
                    return check_channel_constructor(callee_node, arg_indices, scope_id)
        explicit_name := check_explicit_generic_callee_name(callee_node)
        if explicit_name.len() > 0 and has_generic_declaration(explicit_name):
            record_definition(checker_current_node_index(), get_generic_declaration_index(explicit_name))
            gdecl := get_node(get_generic_declaration_index(explicit_name))
            if gdecl.kind == "struct_decl":
                return check_generic_struct_call_explicit(explicit_name, callee_node, arg_indices, scope_id)
            return check_generic_function_call_explicit(explicit_name, callee_node, arg_indices, scope_id)
        return check_function_call_expression(callee_idx, arg_indices, scope_id)

    if callee_node.kind == "ident":
        name := callee_node.value
        # assert_eq / assert_ne take two values of any one type, which no fixed
        # builtin signature describes, so they are resolved by name here rather
        # than registered in checker_builtins.
        #
        # they are deliberately not restricted to a `test` block. a table of
        # cases checked by a shared helper is the ordinary way to write
        # exhaustive coverage, and while these only existed inside the block
        # every case had to be spelled out inline instead. a module that defines
        # or imports its own assert_eq still wins: the builtin only fills a name
        # nothing else has claimed.
        if name == "assert_eq" or name == "assert_ne":
            if lookup_binding(scope_id, name) < 0:
                return check_assertion_equality(name, arg_indices, scope_id)
        if name == "map":
            return check_list_map_builtin(arg_indices, scope_id)
        if name == "filter":
            return check_list_filter_builtin(arg_indices, scope_id)
        if name == "reduce":
            return check_list_reduce_builtin(arg_indices, scope_id)
        # check if it's a struct constructor
        struct_tid := lookup_type_id(name)
        if struct_tid >= 0:
            info := get_type_info(struct_tid)
            if info.kind == "struct":
                # opaque types (0 fields) with args use a constructor function
                # e.g. Semaphore(10) — registered via register_sync_primitive_type
                if info.fields.len() == 0:
                    if arg_indices.len() > 0:
                        return check_function_call_expression(callee_idx, arg_indices, scope_id)
                return check_struct_constructor(name, struct_tid, info, arg_indices, scope_id)
            if info.kind == "enum":
                # enum variant constructor (qualified as EnumName.Variant)
                # — this case shouldn't happen for plain ident calls
                return check_function_call_expression(callee_idx, arg_indices, scope_id)
        # a bare call to a generic imported by name (`from std.testing import
        # assert_eq`, then `assert_eq(a, b)`). every module's top-level names
        # share one scope, so the binding arm below finds the generic's
        # function type and types the call as a plain one, which records no
        # type arguments; the emitter then cannot key the specialization by
        # them and falls back to its own inference (`assert_eq[Int?]` and
        # `assert_eq[String?]` land on one body). the named import says which
        # module's generic this is, so resolve through it first, the way the
        # module-qualified spelling already does.
        imported_from := from_import_source_module(name)
        if imported_from.len() > 0:
            imported_key := module_generic_target_name(imported_from, name)
            if has_generic_declaration(imported_key):
                imported_decl := get_node(get_generic_declaration_index(imported_key))
                if imported_decl.kind == "fn_decl":
                    return check_generic_function_call(imported_key, arg_indices, scope_id)
        existing_fn := lookup_binding(scope_id, name)
        if existing_fn >= 0:
            existing_info := get_type_info(existing_fn)
            if existing_info.kind == "function":
                return check_function_call_expression(callee_idx, arg_indices, scope_id)
        # check if it's a generic declaration
        if has_generic_declaration(name):
            gdecl := get_node(get_generic_declaration_index(name))
            if gdecl.kind == "struct_decl":
                return check_generic_struct_constructor(name, arg_indices, scope_id)
            return check_generic_function_call(name, arg_indices, scope_id)
        # normal function call
        return check_function_call_expression(callee_idx, arg_indices, scope_id)

    # non-ident callee (e.g. lambda call)
    return check_function_call_expression(callee_idx, arg_indices, scope_id)

# check a Channel[T]() constructor call — resolves the type argument
# and returns the channel type id
fn check_channel_constructor(index_node: Node, arg_indices: List[Int], scope_id: Int) -> Int:
    # index_node.children[1] is the type argument (e.g. "Int" in Channel[Int]).
    # a channel carries exactly one payload type, and the constructor used to
    # read only the first: Channel[A, B](n) — likely someone expecting a pair
    # payload — silently built a Channel[A]. the count is checked before
    # anything is read, the same arity error the annotation position reports.
    extra_args := index_node.children.len() - 1
    if extra_args != 1:
        report_error("E221", "Channel expects 1 type argument, got " + extra_args.to_string())
        return TID_ERR
    # the payload is written in expression position, so a parameterized type
    # arrives as an index node (Holder[String], List[Int]), an optional as an
    # unwrap and a pair as a tuple — the shapes every other explicit type
    # argument takes, resolved and refused by the same helper. a kind test
    # here used to stand in for that helper, and it looked only at the outer
    # node: `(Int, String)?` is an unwrap, so it passed, and the tuple under it
    # resolved to the error wildcard without a word.
    inner_tid := resolve_explicit_type_arg(index_node.children[1])
    if is_error_type(inner_tid):
        return TID_ERR
    if arg_indices.len() > 1:
        report_error("E207", "Channel constructor takes 0 or 1 arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    if arg_indices.len() == 1:
        expect_one_typed_argument("Channel", arg_indices, lookup_type_id("Int"), scope_id)
    mut type_args: List[Int] := []
    type_args.push(inner_tid)
    return resolve_generic_type("Channel", type_args)

fn check_function_call_expression(callee_idx: Int, arg_indices: List[Int], scope_id: Int) -> Int:
    callee_type := c_check_expr(callee_idx, scope_id)
    if is_error_type(callee_type):
        return TID_ERR
    return check_callable_type_with_args(callee_type, arg_indices, scope_id)

fn check_callable_type_with_args(callee_type: Int, arg_indices: List[Int], scope_id: Int) -> Int:
    fn_info := get_type_info(callee_type)
    if fn_info.kind != "function":
        report_error("E208", "expression is not callable")
        return TID_ERR
    # check arg count
    if arg_indices.len() != fn_info.param_types.len():
        report_error("E207", "expected " + fn_info.param_types.len().to_string() + " arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    # check arg types
    mut idx := 0
    for ai in arg_indices:
        arg_node := get_node(ai)
        mut arg_expr_idx := ai
        if arg_node.kind == "arg":
            if arg_node.children.len() > 0:
                arg_expr_idx = arg_node.children[0]
        arg_type := c_check_expr(arg_expr_idx, scope_id)
        if idx < fn_info.param_types.len():
            propagate_empty_argument_collection_type(arg_expr_idx, fn_info.param_types[idx], arg_type, scope_id)
        if is_error_type(arg_type) == false:
            if idx < fn_info.param_types.len():
                expected := fn_info.param_types[idx]
                if arg_type != expected:
                    if argument_widens_to_optional(arg_expr_idx, arg_type, expected) == false:
                        if collection_literal_matches_target(arg_expr_idx, expected, scope_id) == false:
                            if types_structurally_equal(arg_type, expected) == false:
                                report_error_at(arg_expr_idx, "E219", "argument type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(arg_type))
        idx = idx + 1
    return fn_info.return_type

# Does this constructor call use named fields (e.g. `Point(x: 3)`)? True if any
# argument carries a field name.
fn struct_args_are_named(arg_indices: List[Int]) -> Bool:
    for ai in arg_indices:
        an := get_node(ai)
        if an.kind == "arg" and an.value.len() > 0:
            return true
    return false

fn struct_has_field(info: TypeInfo, field_name: String) -> Bool:
    for f in info.fields:
        if strings_equal(f, field_name):
            return true
    return false

# Validate and type-check a named-field constructor call. Each field may be
# given at most once, every name must exist, and any omitted field must have a
# default. Fields can arrive in any order; the emitter reorders to declaration
# order independently.
fn check_named_struct_constructor(name: String, struct_tid: Int, info: TypeInfo, arg_indices: List[Int], scope_id: Int) -> Int:
    mut provided: Map[String, Int] := {}
    mut ok := true
    for ai in arg_indices:
        an := get_node(ai)
        if an.kind != "arg" or an.value.len() == 0:
            report_error("E243", name + ": cannot mix positional and named fields")
            ok = false
        elif struct_has_field(info, an.value) == false:
            report_error("E240", name + " has no field '" + an.value + "'")
            ok = false
        elif provided.contains_key(an.value):
            report_error("E241", name + ": field '" + an.value + "' set more than once")
            ok = false
        else:
            mut expr := ai
            if an.children.len() > 0:
                expr = an.children[0]
            provided.insert(an.value, expr)
    # every field without a default must be supplied.
    for fld in info.fields:
        if provided.contains_key(fld) == false:
            if struct_field_has_default(name, fld) == false:
                report_error("E242", name + ": missing field '" + fld + "'")
                ok = false
    if ok == false:
        return TID_ERR
    # type-check each supplied field against its declared type.
    mut idx := 0
    for fld in info.fields:
        if provided.contains_key(fld):
            expr := provided[fld]
            arg_type := c_check_expr(expr, scope_id)
            if is_error_type(arg_type):
                propagate_empty_collection_literal(expr, info.field_types[idx])
            if is_error_type(arg_type) == false:
                expected := info.field_types[idx]
                if optional_target_accepts_value(expr, arg_type, expected) == false:
                    if collection_literal_matches_target(expr, expected, scope_id) == false:
                        if types_compatible(arg_type, expected) == false:
                            report_error_at(expr, "E219", "field '" + fld + "' type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(arg_type))
        idx = idx + 1
    return struct_tid

fn check_struct_constructor(name: String, struct_tid: Int, info: TypeInfo, arg_indices: List[Int], scope_id: Int) -> Int:
    if struct_args_are_named(arg_indices):
        return check_named_struct_constructor(name, struct_tid, info, arg_indices, scope_id)
    # constructor calls can omit trailing fields with defaults.
    if arg_indices.len() > info.fields.len():
        report_error("E207", name + " expects at most " + info.fields.len().to_string() + " fields, got " + arg_indices.len().to_string())
        return TID_ERR
    min_required := struct_min_required_fields(name, info)
    if arg_indices.len() < min_required:
        report_error("E207", name + " expects at least " + min_required.to_string() + " fields, got " + arg_indices.len().to_string())
        return TID_ERR
    # check provided field types
    mut idx := 0
    for ai in arg_indices:
        arg_node := get_node(ai)
        mut arg_expr_idx := ai
        if arg_node.kind == "arg":
            if arg_node.children.len() > 0:
                arg_expr_idx = arg_node.children[0]
        arg_type := c_check_expr(arg_expr_idx, scope_id)
        # an empty collection literal types as an error on its own; against a
        # field it takes the field's type, and the cache entry is what tells the
        # emitter which container to build. without it `S([])` produced an
        # untagged list that never owned what was later pushed into it.
        if is_error_type(arg_type):
            if idx < info.field_types.len():
                propagate_empty_collection_literal(arg_expr_idx, info.field_types[idx])
        if is_error_type(arg_type) == false:
            if idx < info.field_types.len():
                expected := info.field_types[idx]
                if optional_target_accepts_value(arg_expr_idx, arg_type, expected) == false:
                    if collection_literal_matches_target(arg_expr_idx, expected, scope_id) == false:
                        if types_compatible(arg_type, expected) == false:
                            report_error_at(arg_expr_idx, "E219", "field '" + info.fields[idx] + "' type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(arg_type))
        idx = idx + 1
    return struct_tid

# Walk a field's declared type node and its corresponding argument's concrete
# type in parallel. When the field side names one of the struct's generic
# parameters (T, U, ...), record T → arg_tid in subst_map. Handles the common
# containers (List, Set, Map, Optional, Task, Channel, tuple) so a field like
# `items: List[T]` matched against `List[Int]` infers T = Int.
fn unify_field_type_against_arg(field_node_idx: Int, arg_tid: Int, generic_params: List[String], subst_map: Map[String, Int]):
    if field_node_idx < 0:
        return
    if arg_tid < 0:
        return
    fnode := get_node(field_node_idx)
    if fnode.kind == "type":
        for gp in generic_params:
            if strings_equal(gp, fnode.value):
                if subst_map.contains_key(gp) == false:
                    subst_map.insert(gp, arg_tid)
                return
        return
    arg_info := get_type_info(arg_tid)
    if fnode.kind == "generic_type":
        if strings_equal(fnode.value, "List"):
            if arg_info.kind == "list":
                if fnode.children.len() == 1:
                    unify_field_type_against_arg(fnode.children[0], arg_info.inner, generic_params, subst_map)
            return
        if strings_equal(fnode.value, "Set"):
            if arg_info.kind == "set":
                if fnode.children.len() == 1:
                    unify_field_type_against_arg(fnode.children[0], arg_info.inner, generic_params, subst_map)
            return
        if strings_equal(fnode.value, "Map"):
            if arg_info.kind == "map":
                if fnode.children.len() == 2:
                    unify_field_type_against_arg(fnode.children[0], arg_info.key_type, generic_params, subst_map)
                    unify_field_type_against_arg(fnode.children[1], arg_info.value_type, generic_params, subst_map)
            return
        if strings_equal(fnode.value, "Task"):
            if arg_info.kind == "task":
                if fnode.children.len() == 1:
                    unify_field_type_against_arg(fnode.children[0], arg_info.inner, generic_params, subst_map)
            return
        if strings_equal(fnode.value, "Channel"):
            if arg_info.kind == "channel":
                if fnode.children.len() == 1:
                    unify_field_type_against_arg(fnode.children[0], arg_info.inner, generic_params, subst_map)
            return
        return
    if fnode.kind == "optional_type":
        if arg_info.kind == "optional":
            if fnode.children.len() >= 1:
                unify_field_type_against_arg(fnode.children[0], arg_info.inner, generic_params, subst_map)
        return
    if fnode.kind == "tuple_type":
        if arg_info.kind == "tuple":
            mut i := 0
            for c in fnode.children:
                if i < arg_info.elements.len():
                    unify_field_type_against_arg(c, arg_info.elements[i], generic_params, subst_map)
                i = i + 1

# the type of the value a named-field call gives to `fname`, or -1 when
# the field is not named (it either has a default or the call is invalid,
# and the concrete constructor check reports that precisely).
fn named_arg_type_for_field(arg_indices: List[Int], fname: String, scope_id: Int) -> Int:
    for ai in arg_indices:
        an := get_node(ai)
        if an.kind == "arg":
            if strings_equal(an.value, fname):
                if an.children.len() > 0:
                    return c_check_expr(an.children[0], scope_id)
    return -1

fn check_generic_struct_constructor(name: String, arg_indices: List[Int], scope_id: Int) -> Int:
    decl_idx := get_generic_declaration_index(name)
    decl_node := get_node(decl_idx)
    generic_params := collect_generic_parameter_names(decl_node)
    named := struct_args_are_named(arg_indices)
    # collect field type nodes and names from the declaration, in order.
    mut field_type_nodes: List[Int] := []
    mut field_names: List[String] := []
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "field":
            if cn.children.len() > 0:
                field_type_nodes.push(cn.children[0])
            else:
                field_type_nodes.push(-1)
            field_names.push(extract_field_name(cn.value))
    # evaluate argument types aligned to declaration field order, so the
    # inference walk below lines up whether the call is positional or named.
    # named args are matched to fields by name; an omitted (defaulted) field
    # gets -1 and contributes nothing to inference.
    mut arg_types: List[Int] := []
    if named:
        for fname in field_names:
            arg_types.push(named_arg_type_for_field(arg_indices, fname, scope_id))
    else:
        for ai in arg_indices:
            arg_node := get_node(ai)
            mut arg_expr := ai
            if arg_node.kind == "arg":
                if arg_node.children.len() > 0:
                    arg_expr = arg_node.children[0]
            arg_types.push(c_check_expr(arg_expr, scope_id))
        # generic constructor calls can omit trailing fields with defaults.
        if arg_types.len() > field_type_nodes.len():
            report_error("E207", name + " expects at most " + field_type_nodes.len().to_string() + " fields, got " + arg_types.len().to_string())
            return TID_ERR
    # infer type args from argument types. We walk each field's declared type
    # node alongside the concrete arg type so containers like `List[T]` against
    # `List[Int]` infer T = Int.
    mut subst_map: Map[String, Int] := {}
    mut fidx := 0
    for ftn in field_type_nodes:
        if ftn >= 0:
            if fidx < arg_types.len() and arg_types[fidx] >= 0 and is_error_type(arg_types[fidx]) == false:
                unify_field_type_against_arg(ftn, arg_types[fidx], generic_params, subst_map)
        fidx = fidx + 1
    # check interface bounds
    if check_type_parameter_bounds(decl_idx, subst_map) == false:
        return TID_ERR
    # build type_args list in order of generic_params
    mut type_args: List[Int] := []
    for gp in generic_params:
        if subst_map.contains_key(gp):
            type_args.push(subst_map[gp])
        else:
            type_args.push(TID_ERR)
    # instantiate the struct and reuse the concrete constructor checks
    struct_tid := instantiate_generic_struct_type(decl_idx, type_args)
    if struct_tid < 0:
        return TID_ERR
    return check_struct_constructor(get_type_name(struct_tid), struct_tid, get_type_info(struct_tid), arg_indices, scope_id)

fn check_assertion_equality(name: String, arg_indices: List[Int], scope_id: Int) -> Int:
    if arg_indices.len() != 2:
        report_error("E207", name + " expects 2 arguments, got " + arg_indices.len().to_string())
        return TID_VOID
    first_idx := arg_indices[0]
    second_idx := arg_indices[1]
    first_node := get_node(first_idx)
    second_node := get_node(second_idx)
    mut first_expr := first_idx
    mut second_expr := second_idx
    if first_node.kind == "arg":
        if first_node.children.len() > 0:
            first_expr = first_node.children[0]
    if second_node.kind == "arg":
        if second_node.children.len() > 0:
            second_expr = second_node.children[0]
    t1 := c_check_expr(first_expr, scope_id)
    t2 := c_check_expr(second_expr, scope_id)
    if is_error_type(t1) == false:
        if is_error_type(t2) == false:
            if t1 != t2 and types_structurally_equal(t1, t2) == false:
                report_error("E219", name + " arguments must be the same type: " + get_type_name(t1) + " vs " + get_type_name(t2))
        # the builtin spelling lowers to std.testing's generic; its one type
        # argument is the operands' type, recorded here so the emitter keys the
        # specialization by it like any other generic call.
        mut type_args: List[Int] := []
        type_args.push(t1)
        record_generic_call_subst(type_args)
    return TID_VOID

fn call_arg_expr_index(arg_idx: Int) -> Int:
    arg_node := get_node(arg_idx)
    if arg_node.kind == "arg":
        if arg_node.children.len() > 0:
            return arg_node.children[0]
    return arg_idx

fn check_list_map_builtin(arg_indices: List[Int], scope_id: Int) -> Int:
    if arg_indices.len() != 2:
        report_error("E207", "map expects 2 arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    list_tid := c_check_expr(call_arg_expr_index(arg_indices[0]), scope_id)
    fn_tid := c_check_expr(call_arg_expr_index(arg_indices[1]), scope_id)
    if is_error_type(list_tid):
        return TID_ERR
    if is_error_type(fn_tid):
        return TID_ERR
    list_info := get_type_info(list_tid)
    if list_info.kind != "list":
        report_error("E219", "map expects a List as the first argument, got " + get_type_name(list_tid))
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "map expects a function as the second argument")
        return TID_ERR
    if fn_info.param_types.len() != 1:
        report_error("E207", "map callback expects 1 parameter, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], list_info.inner) == false:
        report_error("E219", "map callback parameter mismatch: expected " + get_type_name(list_info.inner) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    return intern_list_type(fn_info.return_type)

fn check_list_filter_builtin(arg_indices: List[Int], scope_id: Int) -> Int:
    if arg_indices.len() != 2:
        report_error("E207", "filter expects 2 arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    list_tid := c_check_expr(call_arg_expr_index(arg_indices[0]), scope_id)
    fn_tid := c_check_expr(call_arg_expr_index(arg_indices[1]), scope_id)
    if is_error_type(list_tid):
        return TID_ERR
    if is_error_type(fn_tid):
        return TID_ERR
    list_info := get_type_info(list_tid)
    if list_info.kind != "list":
        report_error("E219", "filter expects a List as the first argument, got " + get_type_name(list_tid))
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "filter expects a function as the second argument")
        return TID_ERR
    if fn_info.param_types.len() != 1:
        report_error("E207", "filter callback expects 1 parameter, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], list_info.inner) == false:
        report_error("E219", "filter callback parameter mismatch: expected " + get_type_name(list_info.inner) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    if fn_info.return_type != lookup_type_id("Bool"):
        if is_integer_type(fn_info.return_type) == false:
            report_error("E219", "filter callback must return Bool or Int-like truthy value, got " + get_type_name(fn_info.return_type))
            return TID_ERR
    return list_tid

fn check_list_reduce_builtin(arg_indices: List[Int], scope_id: Int) -> Int:
    if arg_indices.len() != 3:
        report_error("E207", "reduce expects 3 arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    list_tid := c_check_expr(call_arg_expr_index(arg_indices[0]), scope_id)
    init_tid := c_check_expr(call_arg_expr_index(arg_indices[1]), scope_id)
    fn_tid := c_check_expr(call_arg_expr_index(arg_indices[2]), scope_id)
    if is_error_type(list_tid):
        return TID_ERR
    if is_error_type(init_tid):
        return TID_ERR
    if is_error_type(fn_tid):
        return TID_ERR
    list_info := get_type_info(list_tid)
    if list_info.kind != "list":
        report_error("E219", "reduce expects a List as the first argument, got " + get_type_name(list_tid))
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "reduce expects a function as the third argument")
        return TID_ERR
    if fn_info.param_types.len() != 2:
        report_error("E207", "reduce callback expects 2 parameters, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], init_tid) == false:
        report_error("E219", "reduce accumulator parameter mismatch: expected " + get_type_name(init_tid) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[1], list_info.inner) == false:
        report_error("E219", "reduce element parameter mismatch: expected " + get_type_name(list_info.inner) + ", got " + get_type_name(fn_info.param_types[1]))
        return TID_ERR
    if types_structurally_equal(fn_info.return_type, init_tid) == false:
        report_error("E219", "reduce callback return mismatch: expected " + get_type_name(init_tid) + ", got " + get_type_name(fn_info.return_type))
        return TID_ERR
    return init_tid

# Method-call forms of the higher-order list builtins. The receiver is the
# list (its element type is info.inner), so these take one fewer argument than
# the free-function forms above: list.map(fn), list.filter(fn), list.reduce(init, fn).

fn check_list_map_method(info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    if args.len() != 1:
        report_error("E207", "map expects 1 argument, got " + args.len().to_string())
        return TID_ERR
    fn_tid := c_check_expr(call_arg_expr_index(args[0]), scope_id)
    if is_error_type(fn_tid):
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "map expects a function argument")
        return TID_ERR
    if fn_info.param_types.len() != 1:
        report_error("E207", "map callback expects 1 parameter, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], info.inner) == false:
        report_error("E219", "map callback parameter mismatch: expected " + get_type_name(info.inner) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    return intern_list_type(fn_info.return_type)

fn check_list_filter_method(info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    if args.len() != 1:
        report_error("E207", "filter expects 1 argument, got " + args.len().to_string())
        return TID_ERR
    fn_tid := c_check_expr(call_arg_expr_index(args[0]), scope_id)
    if is_error_type(fn_tid):
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "filter expects a function argument")
        return TID_ERR
    if fn_info.param_types.len() != 1:
        report_error("E207", "filter callback expects 1 parameter, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], info.inner) == false:
        report_error("E219", "filter callback parameter mismatch: expected " + get_type_name(info.inner) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    if fn_info.return_type != lookup_type_id("Bool"):
        if is_integer_type(fn_info.return_type) == false:
            report_error("E219", "filter callback must return Bool or Int-like truthy value, got " + get_type_name(fn_info.return_type))
            return TID_ERR
    return intern_list_type(info.inner)

fn check_list_reduce_method(info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    if args.len() != 2:
        report_error("E207", "reduce expects 2 arguments, got " + args.len().to_string())
        return TID_ERR
    init_tid := c_check_expr(call_arg_expr_index(args[0]), scope_id)
    fn_tid := c_check_expr(call_arg_expr_index(args[1]), scope_id)
    if is_error_type(init_tid):
        return TID_ERR
    if is_error_type(fn_tid):
        return TID_ERR
    fn_info := get_type_info(fn_tid)
    if fn_info.kind != "function":
        report_error("E208", "reduce expects a function as the second argument")
        return TID_ERR
    if fn_info.param_types.len() != 2:
        report_error("E207", "reduce callback expects 2 parameters, got " + fn_info.param_types.len().to_string())
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[0], init_tid) == false:
        report_error("E219", "reduce accumulator parameter mismatch: expected " + get_type_name(init_tid) + ", got " + get_type_name(fn_info.param_types[0]))
        return TID_ERR
    if types_structurally_equal(fn_info.param_types[1], info.inner) == false:
        report_error("E219", "reduce element parameter mismatch: expected " + get_type_name(info.inner) + ", got " + get_type_name(fn_info.param_types[1]))
        return TID_ERR
    if types_structurally_equal(fn_info.return_type, init_tid) == false:
        report_error("E219", "reduce callback return mismatch: expected " + get_type_name(init_tid) + ", got " + get_type_name(fn_info.return_type))
        return TID_ERR
    return init_tid

# ---------------------------------------------------------------
# interface bounds checking
# ---------------------------------------------------------------

# Extract the base name of a type/generic_type node, ignoring its arg list.
# For `Iterator[Int]` returns "Iterator"; for `Counter` returns "Counter".
pub fn iface_type_base_name(node: Node) -> String:
    if node.kind == "generic_type":
        return node.value
    if node.kind == "type":
        if node.value.contains("["):
            return extract_base_type_name(node.value)
        return node.value
    return ""

# Extract the type-argument names of a type/generic_type node, in order.
# For `Iterator[T]` returns ["T"]; for `Iterator[Int]` returns ["Int"].
pub fn iface_type_arg_names(node: Node) -> List[String]:
    mut names: List[String] := []
    if node.kind == "generic_type":
        for child in node.children:
            cn := get_node(child)
            names.push(get_type_node_name(cn))
    elif node.kind == "type":
        if node.value.contains("["):
            base := extract_base_type_name(node.value)
            inner := node.value.substring(base.len() + 1, node.value.len() - 1)
            parts := inner.split(",")
            for part in parts:
                names.push(part.trim())
    return names

# Encode an impl's interface arguments so bound-based inference can resolve
# them later against a concrete instance. Each arg is one of:
#   "param:N"  — references the impl-struct's Nth generic parameter (e.g.,
#                for `impl Iterator[U] for MapIter[I, T, U]`, the lone arg is
#                "param:2" because U is the 3rd type param of MapIter)
#   "tid:N"    — a concrete type id resolved at registration
# Encoded as a comma-separated list.
pub fn encode_impl_iface_args(impl_struct_base: String, bound_node: Node) -> String:
    arg_names := iface_type_arg_names(bound_node)
    mut struct_params: List[String] := []
    if has_generic_declaration(impl_struct_base):
        sdecl := get_node(get_generic_declaration_index(impl_struct_base))
        struct_params = collect_generic_parameter_names(sdecl)
    mut parts: List[String] := []
    for n in arg_names:
        mut found_idx := 0 - 1
        for sp, sp_i in struct_params:
            if sp == n:
                found_idx = sp_i
        if found_idx >= 0:
            parts.push("param:" + found_idx.to_string())
        else:
            parts.push("tid:" + lookup_type_id(n).to_string())
    return parts.join(",")

# Decode an encoded impl-args string into concrete tids, substituting any
# "param:N" markers using the receiver instance's type arguments. Returns -1
# for entries that can't be resolved.
pub fn decode_impl_iface_args(encoded: String, instance_tid: Int) -> List[Int]:
    mut tids: List[Int] := []
    if encoded.len() == 0:
        return tids
    mut instance_args: List[Int] := []
    if struct_instance_type_args.contains_key(instance_tid):
        instance_args = decode_tid_list(struct_instance_type_args[instance_tid])
    parts := encoded.split(",")
    for part in parts:
        if part.starts_with("param:"):
            idx_str := part.substring(6, part.len())
            idx := parse_integer_string(idx_str)
            if idx >= 0 and idx < instance_args.len():
                tids.push(instance_args[idx])
            else:
                tids.push(0 - 1)
        elif part.starts_with("tid:"):
            tid := parse_integer_string(part.substring(4, part.len()))
            tids.push(tid)
        else:
            tids.push(0 - 1)
    return tids

# Encode a tid list as a comma-separated string, so we can store it in a
# Map[String, String] (Maps with List values are unreliable today).
fn encode_tid_list(tids: List[Int]) -> String:
    mut parts: List[String] := []
    for tid in tids:
        parts.push(tid.to_string())
    return parts.join(",")

# the inverse of encode_tid_list: split a csv of type ids back into a
# list. this is how a caller reads struct_instance_type_args and
# impl_interface_args, which hold their tid lists as strings because
# pith Maps cannot carry List values reliably. an empty string decodes
# to an empty list, so an entry recorded for a type with no arguments
# round-trips cleanly.
pub fn decode_tid_list(s: String) -> List[Int]:
    mut tids: List[Int] := []
    if s.len() == 0:
        return tids
    parts := s.split(",")
    for part in parts:
        tids.push(parse_integer_string(part))
    return tids

# After arg-based inference has bound some type params to concrete types, walk
# the function's interface bounds: if a bound param `T` is already concrete `C`
# and `C` implements `Iface[A, B, ...]`, unify each unbound bound arg with the
# corresponding `A`, `B`, ... from the impl record. Kept small/separate so the
# module-global Map reads compile reliably (see codegen-map-read-sensitivity).
fn infer_subst_from_bounds(decl_node: Node, generic_params: List[String]):
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "generic_param":
            param_name := cn.value
            if generic_inference_subst.contains_key(param_name):
                concrete_tid := generic_inference_subst[param_name]
                # normalize to the base name so generic instances (Iter[Int])
                # look up against the impl registered under their base (Iter)
                concrete_name := extract_base_type_name(get_type_name(concrete_tid))
                for bound_idx in cn.children:
                    bound_node := get_node(bound_idx)
                    iface_base := iface_type_base_name(bound_node)
                    bound_arg_names := iface_type_arg_names(bound_node)
                    impl_key := concrete_name + chr(9) + iface_base
                    if impl_interface_args.contains_key(impl_key):
                        # decode_impl_iface_args substitutes any "param:N"
                        # markers using concrete_tid's instance type args, so
                        # `impl Iterator[U] for MapIter[I, T, U]` resolves U
                        # to the receiver's actual third type argument
                        impl_args := decode_impl_iface_args(impl_interface_args[impl_key], concrete_tid)
                        mut k := 0
                        while k < bound_arg_names.len() and k < impl_args.len():
                            ban := bound_arg_names[k]
                            mut is_gp := false
                            for gp in generic_params:
                                if gp == ban:
                                    is_gp = true
                            if is_gp and generic_inference_subst.contains_key(ban) == false:
                                if impl_args[k] >= 0:
                                    generic_inference_subst.insert(ban, impl_args[k])
                            k = k + 1

fn check_type_parameter_bounds(decl_node_idx: Int, subst_map: Map[String, Int]) -> Bool:
    decl_node := get_node(decl_node_idx)
    mut ok := true
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "generic_param":
            param_name := cn.value
            if subst_map.contains_key(param_name):
                inferred_tid := subst_map[param_name]
                type_name := get_type_name(inferred_tid)
                # walk bound children (each is a type node for an interface)
                for bound_idx in cn.children:
                    bound_node := get_node(bound_idx)
                    iface_name := get_type_node_name_with_substitution(bound_node, subst_map)
                    if has_interface_declaration(iface_name) == false:
                        report_error("E226", "unknown interface '" + iface_name + "' in bound for '" + param_name + "'")
                        ok = false
                    else:
                        if check_type_implements_interface(type_name, iface_name) == false:
                            report_error("E226", "type '" + type_name + "' does not implement interface '" + iface_name + "'")
                            ok = false
    return ok

# ---------------------------------------------------------------
# generic function call
# ---------------------------------------------------------------

fn bind_inferred_generic_type(name: String, actual_tid: Int) -> Bool:
    if generic_inference_subst.contains_key(name):
        existing := generic_inference_subst[name]
        if types_structurally_equal(existing, actual_tid) == false:
            report_error("E219", "type parameter inference mismatch for " + name + ": " + get_type_name(existing) + " vs " + get_type_name(actual_tid))
            return false
        return true
    generic_inference_subst.insert(name, actual_tid)
    return true

fn trim_type_text(text: String) -> String:
    mut start := 0
    mut end := text.len()
    while start < end and text[start] == " ":
        start = start + 1
    while end > start and text[end - 1] == " ":
        end = end - 1
    return text.substring(start, end)

fn split_top_level_type_args(text: String) -> List[String]:
    mut parts: List[String] := []
    mut start := 0
    mut depth := 0
    mut i := 0
    while i < text.len():
        ch := text[i]
        if ch == "[":
            depth = depth + 1
        elif ch == "]":
            depth = depth - 1
        elif ch == "," and depth == 0:
            parts.push(trim_type_text(text.substring(start, i)))
            start = i + 1
        i = i + 1
    parts.push(trim_type_text(text.substring(start, text.len())))
    return parts

fn infer_generic_subst_from_type_text(type_name: String, actual_tid: Int, generic_params: List[String]) -> Bool:
    if actual_tid < 0:
        return true
    trimmed := trim_type_text(type_name)
    for gp in generic_params:
        normalized_gp := trim_type_text(gp)
        if strings_equal(normalized_gp, trimmed):
            return bind_inferred_generic_type(normalized_gp, actual_tid)

    actual_info := get_type_info(actual_tid)

    if trimmed.starts_with("List[") and trimmed.ends_with("]"):
        if actual_info.kind != "list":
            return true
        inner_text := trimmed.substring(5, trimmed.len() - 1)
        return infer_generic_subst_from_type_text(inner_text, actual_info.inner, generic_params)

    if trimmed.starts_with("Set[") and trimmed.ends_with("]"):
        if actual_info.kind != "set":
            return true
        inner_text := trimmed.substring(4, trimmed.len() - 1)
        return infer_generic_subst_from_type_text(inner_text, actual_info.inner, generic_params)

    if trimmed.starts_with("Task[") and trimmed.ends_with("]"):
        if actual_info.kind != "task":
            return true
        inner_text := trimmed.substring(5, trimmed.len() - 1)
        return infer_generic_subst_from_type_text(inner_text, actual_info.inner, generic_params)

    if trimmed.starts_with("Channel[") and trimmed.ends_with("]"):
        if actual_info.kind != "channel":
            return true
        inner_text := trimmed.substring(8, trimmed.len() - 1)
        return infer_generic_subst_from_type_text(inner_text, actual_info.inner, generic_params)

    if trimmed.starts_with("Map[") and trimmed.ends_with("]"):
        if actual_info.kind != "map":
            return true
        args := split_top_level_type_args(trimmed.substring(4, trimmed.len() - 1))
        if args.len() > 0:
            if infer_generic_subst_from_type_text(args[0], actual_info.key_type, generic_params) == false:
                return false
        if args.len() > 1:
            return infer_generic_subst_from_type_text(args[1], actual_info.value_type, generic_params)
        return true

    return true

fn infer_generic_subst_from_type_node(type_idx: Int, actual_tid: Int, generic_params: List[String]) -> Bool:
    if type_idx < 0 or actual_tid < 0:
        return true
    node := get_node(type_idx)
    if node.kind == "type":
        return infer_generic_subst_from_type_text(node.value, actual_tid, generic_params)

    actual_info := get_type_info(actual_tid)

    if node.kind == "generic_type":
        for gp in generic_params:
            normalized_gp := trim_type_text(gp)
            if strings_equal(normalized_gp, trim_type_text(node.value)):
                return bind_inferred_generic_type(normalized_gp, actual_tid)
        if node.value == "List":
            if actual_info.kind == "list" and node.children.len() > 0:
                return infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params)
            return true
        if node.value == "Set":
            if actual_info.kind == "set" and node.children.len() > 0:
                return infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params)
            return true
        if node.value == "Task":
            if actual_info.kind == "task" and node.children.len() > 0:
                return infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params)
            return true
        if node.value == "Channel":
            if actual_info.kind == "channel" and node.children.len() > 0:
                return infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params)
            return true
        if node.value == "Map":
            if actual_info.kind == "map" and node.children.len() > 1:
                if infer_generic_subst_from_type_node(node.children[0], actual_info.key_type, generic_params) == false:
                    return false
                return infer_generic_subst_from_type_node(node.children[1], actual_info.value_type, generic_params)
            return true
        return true

    if node.kind == "optional_type":
        if actual_info.kind == "optional" and node.children.len() > 0:
            return infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params)
        return true

    if node.kind == "result_type":
        if actual_info.kind == "result" and node.children.len() > 0:
            if infer_generic_subst_from_type_node(node.children[0], actual_info.inner, generic_params) == false:
                return false
            if node.children.len() > 1 and actual_info.value_type >= 0:
                return infer_generic_subst_from_type_node(node.children[1], actual_info.value_type, generic_params)
        return true

    if node.kind == "tuple_type":
        if actual_info.kind == "tuple":
            for child, i in node.children:
                if i < actual_info.elements.len():
                    if infer_generic_subst_from_type_node(child, actual_info.elements[i], generic_params) == false:
                        return false
        return true

    if node.kind == "fn_type":
        if actual_info.kind == "function":
            for child, i in node.children:
                cn := get_node(child)
                if cn.kind == "param":
                    if i < actual_info.param_types.len():
                        if infer_generic_subst_from_type_node(cn.children[0], actual_info.param_types[i], generic_params) == false:
                            return false
                    continue
                if cn.kind == "returns":
                    if cn.children.len() > 0:
                        return infer_generic_subst_from_type_node(cn.children[0], actual_info.return_type, generic_params)
        return true

    return true

fn check_generic_function_call(name: String, arg_indices: List[Int], scope_id: Int) -> Int:
    decl_idx := get_generic_declaration_index(name)
    record_definition(checker_current_node_index(), decl_idx)
    decl_node := get_node(decl_idx)
    generic_params := collect_generic_parameter_names(decl_node)
    # evaluate all argument types
    mut arg_types: List[Int] := []
    for ai in arg_indices:
        arg_node := get_node(ai)
        mut arg_expr := ai
        if arg_node.kind == "arg":
            if arg_node.children.len() > 0:
                arg_expr = arg_node.children[0]
        arg_types.push(c_check_expr(arg_expr, scope_id))
    # collect param type nodes from the declaration
    mut param_type_nodes: List[Int] := []
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                param_type_nodes.push(cn.children[0])
            else:
                param_type_nodes.push(-1)
    # check arg count
    if arg_types.len() != param_type_nodes.len():
        report_error("E207", "expected " + param_type_nodes.len().to_string() + " arguments, got " + arg_types.len().to_string())
        return TID_ERR
    # infer type args from argument types using a map
    generic_inference_subst = {}
    mut pidx := 0
    for ptn in param_type_nodes:
        if ptn >= 0 and pidx < arg_types.len():
            if infer_generic_subst_from_type_node(ptn, arg_types[pidx], generic_params) == false:
                return TID_ERR
        pidx = pidx + 1
    # infer remaining type parameters by walking interface bounds: if T_i is
    # already bound to a concrete C, and C implements Iface[T_j, ...], then T_j
    # is fixed by the implementation
    infer_subst_from_bounds(decl_node, generic_params)
    # verify all generic params were inferred, build subst_args list
    mut subst_args: List[Int] := []
    mut all_inferred := true
    for gp in generic_params:
        normalized_gp := trim_type_text(gp)
        if generic_inference_subst.contains_key(normalized_gp):
            subst_args.push(generic_inference_subst[normalized_gp])
        else:
            all_inferred = false
            mut debug_args: List[String] := []
            for arg_tid in arg_types:
                debug_args.push(get_type_name(arg_tid))
            mut debug_params: List[String] := []
            for ptn in param_type_nodes:
                if ptn >= 0:
                    pnode := get_node(ptn)
                    debug_params.push(pnode.kind + ":" + pnode.value)
            report_error("E222", "cannot infer type parameter " + gp)
            # Return immediately to prevent cascading errors
            return TID_ERR
    # check interface bounds
    if check_type_parameter_bounds(decl_idx, generic_inference_subst) == false:
        return TID_ERR
    record_generic_call_subst(subst_args)
    queue_function_specialization(decl_idx, 0 - 1, subst_args)
    # resolve return type with substitution
    mut ret_type := TID_VOID
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            ret_type = resolve_type_with_substitution_map(cn.children[0], generic_params, subst_args)
    # validate arg types against concrete param types. a plain value widens
    # into an optional parameter here the same way it does on the non-generic
    # paths — safe now that #148 made the specialization read the parameter's
    # optional-ness off the declaration rather than the call site.
    mut vidx := 0
    for ptn in param_type_nodes:
        if ptn >= 0:
            if vidx < arg_types.len():
                concrete := resolve_type_with_substitution_map(ptn, generic_params, subst_args)
                if is_error_type(concrete) == false:
                    if is_error_type(arg_types[vidx]) == false:
                        if arg_types[vidx] != concrete:
                            if argument_widens_to_optional(argument_expression_index(arg_indices[vidx]), arg_types[vidx], concrete) == false:
                                if types_structurally_equal(arg_types[vidx], concrete) == false:
                                    report_error("E219", "argument type mismatch: expected " + get_type_name(concrete) + ", got " + get_type_name(arg_types[vidx]))
        vidx = vidx + 1
    return ret_type

# ---------------------------------------------------------------
# method call
# ---------------------------------------------------------------

# fix a generic method's own type parameters from the argument types at one
# call site, in declaration order. this is check_generic_function_call's
# inference step applied to a method: unify each written parameter type against
# the checked argument type, fill anything still free from the interface bounds
# on the declaration, then verify those bounds hold. answers [] when a
# parameter stays unbound or a bound fails, having reported; a method with type
# parameters always has at least one, so an empty answer is unambiguous.
fn infer_method_type_arguments(method_node: Node, decl_idx: Int, method_name: String, method_params: List[String], arg_types: List[Int]) -> List[Int]:
    mut empty: List[Int] := []
    mut param_type_nodes: List[Int] := []
    for child in method_node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                param_type_nodes.push(cn.children[0])
            else:
                param_type_nodes.push(0 - 1)
    if arg_types.len() != param_type_nodes.len():
        report_error("E207", method_name + " expects " + param_type_nodes.len().to_string() + " arguments, got " + arg_types.len().to_string())
        return empty
    generic_inference_subst = {}
    mut pidx := 0
    for ptn in param_type_nodes:
        if ptn >= 0 and pidx < arg_types.len():
            if infer_generic_subst_from_type_node(ptn, arg_types[pidx], method_params) == false:
                return empty
        pidx = pidx + 1
    infer_subst_from_bounds(method_node, method_params)
    mut subst_args: List[Int] := []
    for gp in method_params:
        if generic_inference_subst.contains_key(gp):
            subst_args.push(generic_inference_subst[gp])
        else:
            report_error("E222", "cannot infer type parameter " + gp)
            return empty
    if check_type_parameter_bounds(decl_idx, generic_inference_subst) == false:
        return empty
    return subst_args

# Variants of collect_function_param_types / collect_function_return_type that
# substitute generic type parameters with concrete type arguments. Used to
# resolve method signatures on a generic struct instance like `Iter[Int]`.
fn collect_function_param_types_with_subst(node: Node, params: List[String], args: List[Int]) -> List[Int]:
    mut out: List[Int] := []
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                out.push(resolve_type_with_substitution_map(cn.children[0], params, args))
            else:
                out.push(TID_ERR)
    return out

fn collect_function_return_type_with_subst(node: Node, params: List[String], args: List[Int]) -> Int:
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "returns":
            if cn.children.len() > 0:
                return resolve_type_with_substitution_map(cn.children[0], params, args)
    return TID_VOID

# the declaration key of a user-defined method on `dispatch_type`, or "" when
# the type declares none by that name. the receiver's checked tid names the
# exact declaration, so the tid key is tried first — two modules can declare
# a same-named struct and only the tid can tell their methods apart. methods
# on a generic struct are registered under the base name (e.g. "Iter"), so
# the name-keyed fallback remains: the qualified name ("Iter[Int].next"),
# then the base name. a name-keyed entry that belongs to a different
# declaration of the same name must not answer for this receiver; refusing
# it lets the caller's E209 name the type.
fn user_method_declaration_key(dispatch_type: Int, method_name: String) -> String:
    type_name := get_type_name(dispatch_type)
    mut key := method_tid_key(dispatch_type, method_name)
    if has_method_declaration(key) == false:
        key = type_name + "." + method_name
        if has_method_declaration(key) == false:
            base_name := extract_base_type_name(type_name)
            if base_name != type_name:
                key = base_name + "." + method_name
        owner := method_declaration_owner(key)
        if owner >= 0 and owner != dispatch_type:
            key = ""
    if key.len() > 0 and has_method_declaration(key):
        return key
    return ""

# the type-expression nodes written between the brackets of a method call
# (`x.describe[Int, String](v)`), in order; empty when the call wrote none.
fn method_call_type_arguments(node: Node) -> List[Int]:
    mut empty: List[Int] := []
    if node.type_args < 0:
        return empty
    return get_node(node.type_args).children

# the type arguments a method call wrote, resolved against the method's own
# parameters in declaration order: the explicit counterpart of
# infer_method_type_arguments, and the method form of
# check_generic_function_call_explicit. the count has to match the
# declaration (E221), every written type has to resolve, and the bounds have
# to hold; answers [] having reported otherwise.
fn resolve_written_method_type_args(method_name: String, decl_idx: Int, method_params: List[String], written: List[Int]) -> List[Int]:
    mut empty: List[Int] := []
    if written.len() != method_params.len():
        report_error("E221", method_name + " expects " + method_params.len().to_string() + " type arguments, got " + written.len().to_string())
        return empty
    mut tids: List[Int] := []
    mut subst_map: Map[String, Int] := {}
    for type_idx, i in written:
        tid := resolve_type_implementation(type_idx)
        if is_error_type(tid):
            return empty
        tids.push(tid)
        subst_map.insert(method_params[i], tid)
    if check_type_parameter_bounds(decl_idx, subst_map) == false:
        return empty
    return tids

# a method-call node's value sometimes carries the leading dot of its
# spelling (`.next`); resolution always wants the bare name.
fn normalized_method_name(raw: String) -> String:
    if raw.starts_with("."):
        return raw.substring(1, raw.len())
    return raw

# call arguments arrive wrapped in an `arg` node; the expression is inside.
fn argument_expression_index(arg_idx: Int) -> Int:
    arg_node := get_node(arg_idx)
    if arg_node.kind == "arg" and arg_node.children.len() > 0:
        return arg_node.children[0]
    return arg_idx

# `mod.name(x)` when the module has no such function. pith has no free-function
# spelling for methods, so when `name` is a method on the first argument's type
# the mistake is almost always the receiver form written inside out — say so,
# because the plain "undefined function" reads like a typo.
fn report_undefined_module_function(alias: String, name: String, arg_indices: List[Int], scope_id: Int):
    message := "undefined function: " + alias + "." + name
    if arg_indices.len() > 0:
        recv_type := c_check_expr(argument_expression_index(arg_indices[0]), scope_id)
        if is_error_type(recv_type) == false:
            if method_type_map.contains_key(get_type_name(recv_type) + "." + name):
                report_error_with_fix("E201", message, "'" + name + "' is a method on " + get_type_name(recv_type) + "; call it as receiver." + name + "(...)")
                return
    report_error("E201", message)

# give a binding declared as an empty collection literal its type from
# the first value stored into it. `mut tasks := []` checks as an error
# (the literal has nothing to name an element type), so `tasks.push(v)`
# retypes the binding to List[typeof(v)] here, and records the type on
# the literal node so the emitter builds a tagged container that retains
# its elements. returns the collection type, or TID_ERR when the binding
# is not an open empty literal or the stored value is itself untyped
# (pushing `none` or another empty literal decides nothing, so the
# binding stays open for a later, typed store).
fn refine_empty_literal_binding(name: String, method: String, args: List[Int], scope_id: Int, recv_idx: Int) -> Int:
    binding_index := lookup_binding_index(scope_id, name)
    if binding_index < 0:
        return TID_ERR
    if open_empty_literal_bindings.contains_key(binding_index) == false:
        return TID_ERR
    literal_idx := open_empty_literal_bindings[binding_index]
    literal_kind := get_node(literal_idx).kind
    mut refined := TID_ERR
    if literal_kind == "list" and method == "push" and args.len() == 1:
        elem := c_check_expr(argument_expression_index(args[0]), scope_id)
        if is_error_type(elem) == false:
            refined = intern_list_type(elem)
    elif literal_kind == "set" and method == "add" and args.len() == 1:
        elem := c_check_expr(argument_expression_index(args[0]), scope_id)
        if is_error_type(elem) == false:
            if reject_unhashable_component(argument_expression_index(args[0]), elem, "a set element type"):
                return TID_ERR
            refined = intern_set_type(elem)
    elif literal_kind == "map" and method == "insert" and args.len() == 2:
        key_type := c_check_expr(argument_expression_index(args[0]), scope_id)
        value_type := c_check_expr(argument_expression_index(args[1]), scope_id)
        if is_error_type(key_type) == false and is_error_type(value_type) == false:
            if reject_unhashable_component(argument_expression_index(args[0]), key_type, "a map key type"):
                return TID_ERR
            refined = intern_map_type(key_type, value_type)
    if is_error_type(refined):
        return TID_ERR
    set_binding_type_at(binding_index, refined)
    open_empty_literal_bindings.remove(binding_index)
    expression_type_cache.insert(literal_idx, refined)
    expression_type_cache.insert(recv_idx, refined)
    return refined

# whether an enum declaration carries a variant of this name. used to tell
# a variant constructor on a generic enum's bare name apart from a method
# call that happens to share the receiver's name.
fn enum_decl_has_variant(decl: Node, name: String) -> Bool:
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "variant" and strings_equal(cn.value, name):
            return true
    return false

# the type argument a payload argument pins down, or -1. a payload declared
# as the bare parameter binds the argument's type; one declared as the
# parameter's optional binds the argument's inner type when the argument is
# already an optional. deeper shapes — the parameter buried inside another
# generic, like Chain[T] — bind nothing here, because by the time such a
# payload is passed the bare parameter has always appeared in an earlier
# slot (a recursive variant carries the element before the tail).
fn generic_enum_param_binding(payload_idx: Int, param: String, arg_tid: Int) -> Int:
    if payload_idx < 0 or arg_tid < 0:
        return 0 - 1
    if is_error_type(arg_tid) or is_none_type(arg_tid):
        return 0 - 1
    tn := get_node(payload_idx)
    if tn.kind == "type" and strings_equal(tn.value, param):
        return arg_tid
    if tn.kind == "optional_type" and tn.children.len() > 0:
        inner_n := get_node(tn.children[0])
        if inner_n.kind == "type" and strings_equal(inner_n.value, param):
            ainfo := get_type_info(arg_tid)
            if ainfo.kind == "optional":
                return ainfo.inner
            return arg_tid
    return 0 - 1

# the generic enum a constructor expression names, or "" when the node is
# not `Base.Variant(...)` on a generic enum's bare name. the binding checker
# uses this twice: to hand an annotation's instance to a constructor that
# had nothing to infer from, and to refuse an unannotated binding that
# would otherwise stay silently untyped.
fn generic_enum_construction_base(val_node: Node) -> String:
    # a payload-carrying constructor parses as a method call; a payload-free
    # variant written without parentheses (`Opt.Nothing`) parses as a field
    # access. both name the same thing.
    if val_node.kind != "method_call" and val_node.kind != "field_access":
        return ""
    if val_node.children.len() < 1:
        return ""
    recv := get_node(val_node.children[0])
    if recv.kind != "ident":
        return ""
    if has_generic_declaration(recv.value) == false:
        return ""
    decl := get_node(get_generic_declaration_index(recv.value))
    if decl.kind != "enum_decl":
        return ""
    mname := normalized_method_name(val_node.value)
    if enum_decl_has_variant(decl, mname):
        return recv.value
    return ""

# `Opt.Some(5)` — a variant constructor on a generic enum's bare name.
# infer the instance from the payload arguments, instantiate it, and check
# the arguments against the instantiated payload types. a constructor with
# nothing to infer from (`Opt.Nothing`) returns the error type WITHOUT
# reporting: a typed target supplies the instance in that case — the
# annotated-binding path records it — and a generic function returning its
# own enum (`return RecvResult.Closed`) has carried this shape since before
# inference existed. only an unannotated binding turns the silence into an
# error, in check_binding_statement.
fn check_generic_enum_variant_construction(decl_idx: Int, variant_name: String, arg_indices: List[Int], scope_id: Int) -> Int:
    decl := get_node(decl_idx)
    generic_params := collect_generic_parameter_names(decl)
    # the caller's enum_decl_has_variant guard is the gate, so the variant
    # is present by the time this runs; a miss here just yields no payloads.
    mut payload_nodes: List[Int] := []
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "variant" and strings_equal(cn.value, variant_name):
            for vc in cn.children:
                payload_nodes.push(vc)
    if arg_indices.len() != payload_nodes.len():
        report_error("E207", variant_name + " expects " + payload_nodes.len().to_string() + " arguments, got " + arg_indices.len().to_string())
        return TID_ERR
    mut arg_types: List[Int] := []
    mut arg_exprs: List[Int] := []
    for ai in arg_indices:
        a_expr := argument_expression_index(ai)
        arg_exprs.push(a_expr)
        arg_types.push(c_check_expr(a_expr, scope_id))
    mut type_args: List[Int] := []
    for param in generic_params:
        mut bound := 0 - 1
        for pn, i in payload_nodes:
            if bound < 0:
                bound = generic_enum_param_binding(pn, param, arg_types[i])
        if bound < 0:
            return TID_ERR
        type_args.push(bound)
    tid := instantiate_generic_type(decl_idx, type_args)
    if tid < 0:
        return TID_ERR
    info := get_type_info(tid)
    mut vi := 0
    for v in info.variants:
        if strings_equal(v, variant_name):
            if vi < info.variant_types.len():
                payload_types := info.variant_types[vi]
                mut pi := 0
                for at in arg_types:
                    if pi < payload_types.len():
                        if is_error_type(at) == false and at != payload_types[pi]:
                            # a plain value satisfies an optional payload by
                            # widening, the same rule a binding applies — a
                            # recursive variant's tail (Chain[T]?) is handed
                            # a plain Chain[Int] all over the tree.
                            if optional_target_accepts_value(arg_exprs[pi], at, payload_types[pi]) == false:
                                if types_structurally_equal(at, payload_types[pi]) == false:
                                    report_error("E219", "argument type mismatch: expected " + get_type_name(payload_types[pi]) + ", got " + get_type_name(at))
                    pi = pi + 1
        vi = vi + 1
    return tid

fn check_method_call(node: Node, scope_id: Int) -> Int:
    # node.value = method name
    # children[0] = receiver
    # children[1..] = arguments
    if node.children.len() < 1:
        return TID_ERR
    method_name := normalized_method_name(node.value)
    recv_node := get_node(node.children[0])

    mut arg_indices: List[Int] := []
    mut skip_recv := 1
    for child in node.children:
        if skip_recv > 0:
            skip_recv = skip_recv - 1
            continue
        arg_indices.push(child)

    if recv_node.kind == "ident":
        recv_name := recv_node.value
        if module_aliases.contains_key(recv_name):
            module_path := module_aliases[recv_name]
            # cross-module struct construction: `m.S(...)` where S is a struct
            # type the aliased module declares. resolve the type the same way the
            # same-module ident path does and build it, instead of falling through
            # to the function-binding lookup (which reports "not callable").
            # resolve the aliased module's own declaration first: two modules
            # can each declare a struct with this name, and the bare-name
            # lookup below answers with whichever module registered the name
            # into the shared table last.
            mut ctor_tid := resolve_type_name_module_scoped(recv_name + "." + method_name)
            mut ctor_type_name := method_name
            if ctor_tid < 0:
                ctor_type_name = resolve_imported_type_name(recv_name + "." + method_name)
                ctor_tid = lookup_type_id(ctor_type_name)
            if ctor_tid >= 0:
                ctor_info := get_type_info(ctor_tid)
                if ctor_info.kind == "struct":
                    # opaque zero-field types built with args use a constructor
                    # function (e.g. sync primitives), so leave those to the
                    # function path; only intercept real field structs.
                    if ctor_info.fields.len() > 0 or arg_indices.len() == 0:
                        return check_struct_constructor(ctor_type_name, ctor_tid, ctor_info, arg_indices, scope_id)
            # a cross-module generic struct: `m.Pair(...)`
            gen_ctor_name := module_generic_target_name(module_path, method_name)
            if has_generic_declaration(gen_ctor_name):
                if get_node(get_generic_declaration_index(gen_ctor_name)).kind == "struct_decl":
                    return check_generic_struct_constructor(gen_ctor_name, arg_indices, scope_id)
            if has_generic_declaration(method_name):
                if get_node(get_generic_declaration_index(method_name)).kind == "struct_decl":
                    return check_generic_struct_constructor(method_name, arg_indices, scope_id)
            # a function the aliased module declared without `pub` belongs to
            # that module. the lookups below end in a bare-name fallback into
            # the shared table, which used to reach a private helper and return
            # a value the caller could not use.
            if not module_function_is_visible(module_path, method_name):
                report_error("E251", "'" + method_name + "' is not public in module '" + recv_name + "'")
                return TID_ERR
            qualified_name := module_import_target_name(module_path, method_name)
            module_name := module_generic_target_name(module_path, method_name)
            mut callee_type := lookup_binding(scope_id, module_name)
            # the remaining two lookups are unqualified for all but a handful
            # of modules, and every module's top-level names share one table.
            # they have to stay inside the aliased module, or an untagged
            # lookup happily answers `a.helper()` with the `helper` that
            # module b declared.
            if callee_type < 0:
                callee_type = lookup_binding_owned_by(scope_id, qualified_name, module_path)
            if callee_type < 0:
                callee_type = lookup_binding_owned_by(scope_id, method_name, module_path)
            if callee_type < 0:
                generic_name := module_generic_target_name(module_path, method_name)
                if has_generic_declaration(generic_name):
                    return check_generic_function_call(generic_name, arg_indices, scope_id)
                if has_generic_declaration(method_name):
                    return check_generic_function_call(method_name, arg_indices, scope_id)
            if callee_type < 0:
                report_undefined_module_function(recv_name, method_name, arg_indices, scope_id)
                return TID_ERR
            record_definition(checker_current_node_index(), lookup_binding_decl_node(scope_id, module_name))
            return check_callable_type_with_args(callee_type, arg_indices, scope_id)

    # a generic enum's bare name has no type id — only instances like
    # Opt[Int] are registered — so `Opt.Some(5)` cannot reach the
    # receiver-typed variant-constructor path below (the receiver checks as
    # the error wildcard and the whole call used to type as error, silently).
    # infer the instance from the payload arguments instead.
    if recv_node.kind == "ident" and has_generic_declaration(recv_node.value):
        gdecl_idx := get_generic_declaration_index(recv_node.value)
        gdecl := get_node(gdecl_idx)
        if gdecl.kind == "enum_decl" and enum_decl_has_variant(gdecl, method_name):
            return check_generic_enum_variant_construction(gdecl_idx, method_name, arg_indices, scope_id)

    mut receiver_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(receiver_type) and recv_node.kind == "ident":
        # `mut tasks := []` left the binding untyped; the first value
        # stored into it names the element type. without this, every
        # later use of the binding stayed silently untyped — awaiting a
        # task pulled out of such a list lost its result type, and the
        # ok-payload extraction lowered to an unresolvable call.
        receiver_type = refine_empty_literal_binding(recv_node.value, method_name, arg_indices, scope_id, node.children[0])
    if is_error_type(receiver_type):
        return TID_ERR
    mut recv_info := get_type_info(receiver_type)
    mut dispatch_type := receiver_type
    if recv_info.kind == "optional":
        # `.value` extracts the inner T from a T?; callers are responsible for
        # checking `!= none` first. used by iterator adapters where the source's
        # next() result is already known to be Some.
        if method_name == "value":
            expect_no_arguments(method_name, arg_indices)
            return recv_info.inner
        if method_name == "unwrap_or":
            # T?.unwrap_or(default: T) -> T
            if arg_indices.len() != 1:
                report_error("E207", "unwrap_or expects 1 argument, got " + arg_indices.len().to_string())
                return recv_info.inner
            check_argument_type(arg_indices[0], recv_info.inner, scope_id)
            return recv_info.inner
        dispatch_type = recv_info.inner
        recv_info = get_type_info(dispatch_type)
    elif recv_info.kind == "result":
        result_method := check_result_method_call(method_name, recv_info, arg_indices, scope_id)
        if is_error_type(result_method) == false:
            return result_method
        dispatch_type = recv_info.inner
        recv_info = get_type_info(dispatch_type)

    # type arguments written at the call (`x.describe[Int](v)`) belong to a
    # user-declared method with type parameters of its own, and the method
    # tables below know nothing of them. refuse every other target here, so a
    # written list is never silently dropped on the floor by a table that
    # happens to answer the name.
    written_type_args := method_call_type_arguments(node)
    if written_type_args.len() > 0:
        generic_key := user_method_declaration_key(dispatch_type, method_name)
        if generic_key.len() == 0:
            # a field of closures indexed by a type-shaped expression (a
            # constant, an enum variant) and called is the one shape the
            # parser's rule reads as type arguments; name the way out.
            if recv_info.fields.contains(method_name):
                report_error("E209", "'" + method_name + "' is a field of " + get_type_name(receiver_type) + ", not a method; to index it and call the element, bind the element first or write (" + method_name + "[...])(...)")
                return TID_ERR
            report_error("E209", get_type_name(receiver_type) + " has no method '" + method_name + "' that takes type arguments")
            return TID_ERR
        if declaration_has_generic_params(get_node(get_method_declaration_index(generic_key))) == false:
            report_error("E221", method_name + " expects 0 type arguments, got " + written_type_args.len().to_string())
            return TID_ERR

    tid_string := lookup_type_id("String")
    tid_bytes := lookup_type_id("Bytes")
    tid_int := lookup_type_id("Int")
    tid_float := lookup_type_id("Float")
    tid_bool := lookup_type_id("Bool")

    # string methods
    if dispatch_type == tid_string:
        return check_string_method_call(method_name, arg_indices, scope_id)
    if dispatch_type == tid_bytes:
        return check_bytes_method_call(method_name, arg_indices, scope_id)
    # primitive methods
    if is_integer_type(dispatch_type):
        return check_int_method_call(method_name, arg_indices, scope_id)
    if dispatch_type == tid_float:
        return check_float_method_call(method_name, arg_indices, scope_id)
    if dispatch_type == tid_bool:
        return check_bool_method_call(method_name, arg_indices, scope_id)

    # collection methods. each table answers -1 for "not my method";
    # any real type id — TID_ERR included — means it handled the call.
    if recv_info.kind == "list":
        result := check_list_method_call(method_name, recv_info, arg_indices, scope_id)
        if method_table_answered(result):
            return result
    if recv_info.kind == "map":
        result := check_map_method_call(method_name, recv_info, arg_indices, scope_id)
        if method_table_answered(result):
            return result
    if recv_info.kind == "set":
        result := check_set_method_call(method_name, recv_info, arg_indices, scope_id)
        if method_table_answered(result):
            return result

    # channel methods
    if recv_info.kind == "channel":
        ch_result := check_channel_method_call(method_name, recv_info, arg_indices, scope_id)
        if method_table_answered(ch_result):
            return ch_result

    if recv_info.kind == "task":
        task_result := check_task_method_call(method_name, recv_info, arg_indices, scope_id)
        if method_table_answered(task_result):
            return task_result

    # sync primitive methods
    if recv_info.kind == "struct":
        sync_result := check_sync_primitive_method_call(recv_info.name, method_name, arg_indices, scope_id)
        if method_table_answered(sync_result):
            return sync_result

    # enum variant constructors: Shape.Circle(2.5). the receiver is the enum
    # type itself and the variant's payload types are the parameters; the
    # expression produces a value of the enum type.
    if recv_info.kind == "enum":
        mut vi := 0
        while vi < recv_info.variants.len():
            if recv_info.variants[vi] == method_name:
                payload_types := recv_info.variant_types[vi]
                if arg_indices.len() != payload_types.len():
                    report_error("E207", method_name + " expects " + payload_types.len().to_string() + " arguments, got " + arg_indices.len().to_string())
                    return TID_ERR
                mut pi := 0
                for pai in arg_indices:
                    pa_node := get_node(pai)
                    mut pa_expr := pai
                    if pa_node.kind == "arg":
                        if pa_node.children.len() > 0:
                            pa_expr = pa_node.children[0]
                    pa_type := c_check_expr(pa_expr, scope_id)
                    if pi < payload_types.len():
                        propagate_empty_argument_collection_type(pa_expr, payload_types[pi], pa_type, scope_id)
                    if is_error_type(pa_type) == false and pi < payload_types.len():
                        if pa_type != payload_types[pi]:
                            if types_structurally_equal(pa_type, payload_types[pi]) == false:
                                # a plain value widens into an optional
                                # payload, the rule the generic enum path
                                # above already applies. destructuring is
                                # untouched: a match binding on an optional
                                # payload reads the payload's declared type.
                                if optional_target_accepts_value(pa_expr, pa_type, payload_types[pi]) == false:
                                    report_error("E219", "argument type mismatch: expected " + get_type_name(payload_types[pi]) + ", got " + get_type_name(pa_type))
                    pi = pi + 1
                return receiver_type
            vi = vi + 1

    # user-defined methods
    type_name := get_type_name(dispatch_type)
    key := user_method_declaration_key(dispatch_type, method_name)
    if key.len() > 0:
        record_definition(checker_current_node_index(), get_method_declaration_index(key))
        method_node := get_node(get_method_declaration_index(key))
        queue_dispatched_method(get_method_declaration_index(key), dispatch_type)
        # if the receiver is a generic struct instance, build a substitution
        # map (T -> Int, ...) so the method signature resolves concretely
        mut struct_params: List[String] := []
        mut struct_args: List[Int] := []
        if struct_instance_type_args.contains_key(dispatch_type):
            struct_args = decode_tid_list(struct_instance_type_args[dispatch_type])
            if struct_instance_base_name.contains_key(dispatch_type):
                base := struct_instance_base_name[dispatch_type]
                if has_generic_declaration(base):
                    sdecl := get_node(get_generic_declaration_index(base))
                    struct_params = collect_generic_parameter_names(sdecl)
        # associated-type bindings for the receiver resolve like extra type
        # params (Item -> Int) so a method typed `-> Item` resolves here too
        assoc_base := extract_base_type_name(type_name)
        if type_assoc_names.contains_key(assoc_base):
            for an in type_assoc_names[assoc_base].split(","):
                bkey := assoc_base + "." + an
                if assoc_type_binding.contains_key(bkey):
                    struct_params.push(an)
                    struct_args.push(assoc_type_binding[bkey])
        # a method's own type parameters (`fn run[T](v: T) -> T`) are fixed by
        # this call's arguments, so those have to be checked before the
        # signature resolves. the types land in the expression cache and the
        # validation loop below reads them back rather than checking a second
        # time, which would report anything wrong inside an argument twice.
        # a call that writes its type arguments (`x.run[Int](v)`) skips the
        # inference: the written list is resolved and checked against the
        # declaration instead, and the arguments are checked once, below.
        mut method_args_prechecked := false
        if declaration_has_generic_params(method_node):
            method_params := collect_generic_parameter_names(method_node)
            mut method_type_args: List[Int] := []
            if written_type_args.len() > 0:
                method_type_args = resolve_written_method_type_args(method_name, get_method_declaration_index(key), method_params, written_type_args)
            else:
                mut method_arg_types: List[Int] := []
                for ai in arg_indices:
                    method_arg_types.push(c_check_expr(argument_expression_index(ai), scope_id))
                method_args_prechecked = true
                method_type_args = infer_method_type_arguments(method_node, get_method_declaration_index(key), method_name, method_params, method_arg_types)
            if method_type_args.len() == 0:
                return TID_ERR
            for mp in method_params:
                struct_params.push(mp)
            for ma in method_type_args:
                struct_args.push(ma)
            # the record the emitter reads is the whole specialization key:
            # on a generic owner the receiver's instance arguments come first,
            # then the method's own, so `Box[Int].map[String]` and
            # `Box[String].map[String]` are two bodies.
            record_generic_call_subst(owner_and_method_type_args(dispatch_type, method_type_args))
            queue_function_specialization(get_method_declaration_index(key), dispatch_type, method_type_args)
        param_types := collect_function_param_types_with_subst(method_node, struct_params, struct_args)
        ret_type := collect_function_return_type_with_subst(method_node, struct_params, struct_args)
        # check arg count
        if arg_indices.len() != param_types.len():
            report_error("E207", method_name + " expects " + param_types.len().to_string() + " arguments, got " + arg_indices.len().to_string())
            return TID_ERR
        # check arg types
        mut aidx := 0
        for ai in arg_indices:
            arg_node := get_node(ai)
            mut arg_expr := ai
            if arg_node.kind == "arg":
                if arg_node.children.len() > 0:
                    arg_expr = arg_node.children[0]
            mut atype := TID_ERR
            if method_args_prechecked:
                atype = c_get_expr_type(arg_expr)
            else:
                atype = c_check_expr(arg_expr, scope_id)
            if aidx < param_types.len():
                propagate_empty_argument_collection_type(arg_expr, param_types[aidx], atype, scope_id)
            if is_error_type(atype) == false:
                if aidx < param_types.len():
                    if atype != param_types[aidx]:
                        if argument_widens_to_optional(arg_expr, atype, param_types[aidx]) == false:
                            if collection_literal_matches_target(arg_expr, param_types[aidx], scope_id) == false:
                                if types_structurally_equal(atype, param_types[aidx]) == false:
                                    report_error("E219", "argument type mismatch: expected " + get_type_name(param_types[aidx]) + ", got " + get_type_name(atype))
            aidx = aidx + 1
        return ret_type
    # a fn-value field invoked like a method: `h.shut(x)` where `shut: fn(C)` is
    # a field, not a method. resolve it as a call on the field's function type.
    if recv_info.kind == "struct":
        mut ffi := 0
        while ffi < recv_info.fields.len():
            if strings_equal(recv_info.fields[ffi], method_name):
                if ffi < recv_info.field_types.len() and get_type_info(recv_info.field_types[ffi]).kind == "function":
                    return check_callable_type_with_args(recv_info.field_types[ffi], arg_indices, scope_id)
            ffi = ffi + 1
    # a table that recognized the method may have reported already;
    # don't stack the generic "no method" on top of its specific error
    if checker_reported_at_current() == false:
        report_error("E209", get_type_name(receiver_type) + " has no method '" + method_name + "'")
    return TID_ERR

# ---------------------------------------------------------------
# string methods
# ---------------------------------------------------------------

# a method table's answer counts when it is any real type id,
# TID_ERR included: an error id means the table recognized the method
# and already reported. only a negative answer means "not my method,
# keep dispatching". this predicate is the whole contract — the
# set-insert segfault came from one gate testing it wrong.
fn method_table_answered(result: Int) -> Bool:
    return result >= 0 and is_error_type(result) == false

fn check_string_method_call(method: String, args: List[Int], scope_id: Int) -> Int:
    tid_int := lookup_type_id("Int")
    tid_string := lookup_type_id("String")
    tid_bool := lookup_type_id("Bool")
    if method == "len":
        expect_no_arguments(method, args)
        return tid_int
    # a string's to_string is itself. the method exists so a generic body
    # can spell `v.to_string()` for a `T` that is a string as well as a
    # number; a body checked at String used to be refused here while the
    # same body ran fine, since the emitter lowers it to the value itself.
    if method == "to_string":
        expect_no_arguments(method, args)
        return tid_string
    if method == "trim":
        expect_no_arguments(method, args)
        return tid_string
    if method == "to_upper":
        expect_no_arguments(method, args)
        return tid_string
    if method == "to_lower":
        expect_no_arguments(method, args)
        return tid_string
    if method == "is_empty":
        expect_no_arguments(method, args)
        return tid_bool
    if method == "contains":
        expect_one_string_argument(method, args, scope_id)
        return tid_bool
    if method == "starts_with":
        expect_one_string_argument(method, args, scope_id)
        return tid_bool
    if method == "ends_with":
        expect_one_string_argument(method, args, scope_id)
        return tid_bool
    if method == "index_of":
        expect_one_string_argument(method, args, scope_id)
        return tid_int
    if method == "last_index_of":
        expect_one_string_argument(method, args, scope_id)
        return tid_int
    if method == "split":
        expect_one_string_argument(method, args, scope_id)
        return intern_list_type(tid_string)
    if method == "substring":
        expect_two_int_arguments(method, args, scope_id)
        return tid_string
    if method == "replace":
        expect_two_string_arguments(method, args, scope_id)
        return tid_string
    if method == "repeat":
        expect_one_typed_argument(method, args, tid_int, scope_id)
        return tid_string
    if method == "pad_left":
        expect_int_string_arguments(method, args, scope_id)
        return tid_string
    if method == "pad_right":
        expect_int_string_arguments(method, args, scope_id)
        return tid_string
    if method == "chars":
        expect_no_arguments(method, args)
        return intern_list_type(tid_string)
    if method == "get":
        expect_one_typed_argument(method, args, tid_int, scope_id)
        return add_type_info(ti_optional(tid_string))
    report_error("E209", "String has no method '" + method + "'")
    return TID_ERR

# ---------------------------------------------------------------
# bytes methods
# ---------------------------------------------------------------

fn check_bytes_method_call(method: String, args: List[Int], scope_id: Int) -> Int:
    tid_int := lookup_type_id("Int")
    tid_string := lookup_type_id("String")
    tid_bytes := lookup_type_id("Bytes")
    tid_bool := lookup_type_id("Bool")
    if method == "len":
        expect_no_arguments(method, args)
        return tid_int
    if method == "is_empty":
        expect_no_arguments(method, args)
        return tid_bool
    if method == "slice":
        expect_two_int_arguments(method, args, scope_id)
        return tid_bytes
    if method == "concat":
        expect_one_typed_argument(method, args, tid_bytes, scope_id)
        return tid_bytes
    if method == "to_string_utf8":
        expect_no_arguments(method, args)
        return add_type_info(ti_result(tid_string, TID_STRING))
    report_error("E209", "Bytes has no method '" + method + "'")
    return TID_ERR

fn check_result_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    tid_string := lookup_type_id("String")
    if method == "to_string":
        expect_no_arguments(method, args)
        if type_supports_stringify(info.inner) == false or type_supports_stringify(info.value_type) == false:
            report_error("E219", "result.to_string requires stringifiable ok and err values")
            return TID_ERR
        return tid_string
    if method == "unwrap_or":
        if args.len() != 1:
            report_error("E207", "unwrap_or expects 1 argument, got " + args.len().to_string())
            return TID_ERR
        check_argument_type(args[0], info.inner, scope_id)
        return info.inner
    if method == "or_else":
        if args.len() != 1:
            report_error("E207", "or_else expects 1 argument, got " + args.len().to_string())
            return TID_ERR
        handler_type := c_check_expr(call_arg_expr_index(args[0]), scope_id)
        if is_error_type(handler_type):
            return TID_ERR
        handler_info := get_type_info(handler_type)
        if handler_info.kind != "function":
            report_error("E219", "or_else expects a function, got " + get_type_name(handler_type))
            return TID_ERR
        if handler_info.param_types.len() != 1:
            report_error("E219", "or_else handler must take exactly 1 argument")
            return TID_ERR
        if types_compatible(handler_info.param_types[0], info.value_type) == false:
            report_error("E219", "or_else handler must accept " + get_type_name(info.value_type) + ", got " + get_type_name(handler_info.param_types[0]))
            return TID_ERR
        ret_info := get_type_info(handler_info.return_type)
        if ret_info.kind != "result":
            report_error("E219", "or_else handler must return a result type")
            return TID_ERR
        if types_compatible(ret_info.inner, info.inner) == false:
            report_error("E219", "or_else handler must return " + get_type_name(info.inner) + " on success, got " + get_type_name(ret_info.inner))
            return TID_ERR
        return handler_info.return_type
    return TID_ERR

# ---------------------------------------------------------------
# primitive methods
# ---------------------------------------------------------------

fn check_int_method_call(method: String, args: List[Int], scope_id: Int) -> Int:
    tid_string := lookup_type_id("String")
    tid_float := lookup_type_id("Float")
    if method == "to_string":
        expect_no_arguments(method, args)
        return tid_string
    if method == "to_float":
        expect_no_arguments(method, args)
        return tid_float
    report_error("E209", "Int has no method '" + method + "'")
    return TID_ERR

fn check_float_method_call(method: String, args: List[Int], scope_id: Int) -> Int:
    tid_string := lookup_type_id("String")
    tid_int := lookup_type_id("Int")
    if method == "to_string":
        expect_no_arguments(method, args)
        return tid_string
    if method == "to_int":
        expect_no_arguments(method, args)
        return tid_int
    report_error("E209", "Float has no method '" + method + "'")
    return TID_ERR

fn check_bool_method_call(method: String, args: List[Int], scope_id: Int) -> Int:
    tid_string := lookup_type_id("String")
    if method == "to_string":
        expect_no_arguments(method, args)
        return tid_string
    report_error("E209", "Bool has no method '" + method + "'")
    return TID_ERR

# ---------------------------------------------------------------
# list methods
# ---------------------------------------------------------------

fn check_list_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    elem := info.inner
    tid_int := lookup_type_id("Int")
    tid_string := lookup_type_id("String")
    tid_bool := lookup_type_id("Bool")
    tid_void := lookup_type_id("Void")
    if method == "push":
        expect_one_widened_argument(method, args, elem, scope_id)
        return tid_void
    if method == "len":
        expect_no_arguments(method, args)
        return tid_int
    if method == "is_empty":
        expect_no_arguments(method, args)
        return tid_bool
    if method == "clear":
        expect_no_arguments(method, args)
        return tid_void
    if method == "reverse":
        expect_no_arguments(method, args)
        return tid_void
    if method == "remove":
        expect_one_typed_argument(method, args, tid_int, scope_id)
        return tid_void
    if method == "insert":
        if args.len() != 2:
            report_error("E207", "insert expects 2 arguments (index, value), got " + args.len().to_string())
            return tid_void
        check_argument_type(args[0], tid_int, scope_id)
        check_widened_argument_type(args[1], elem, scope_id)
        return tid_void
    if method == "contains":
        expect_one_widened_argument(method, args, elem, scope_id)
        return tid_bool
    if method == "join":
        expect_one_typed_argument(method, args, tid_string, scope_id)
        # join formats elements into a string; only String and Int elements are
        # supported. other element types would otherwise crash at runtime.
        if elem != tid_string and is_integer_type(elem) == false:
            report_error("E219", "join requires a list of String or Int elements, got List[" + get_type_name(elem) + "]; map elements to String first")
        return tid_string
    if method == "index_of":
        expect_one_widened_argument(method, args, elem, scope_id)
        return add_type_info(ti_optional(tid_int))
    if method == "slice":
        expect_two_int_arguments(method, args, scope_id)
        return intern_list_type(elem)
    if method == "sort":
        expect_no_arguments(method, args)
        return intern_list_type(elem)
    if method == "map":
        return check_list_map_method(info, args, scope_id)
    if method == "filter":
        return check_list_filter_method(info, args, scope_id)
    if method == "reduce":
        return check_list_reduce_method(info, args, scope_id)
    if method == "get":
        expect_one_typed_argument(method, args, tid_int, scope_id)
        return add_type_info(ti_optional(elem))
    if method == "first":
        expect_no_arguments(method, args)
        return add_type_info(ti_optional(elem))
    if method == "last":
        expect_no_arguments(method, args)
        return add_type_info(ti_optional(elem))
    # not a built-in list method
    return -1

# ---------------------------------------------------------------
# map methods
# ---------------------------------------------------------------

fn check_map_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    key_t := info.key_type
    val_t := info.value_type
    tid_void := lookup_type_id("Void")
    tid_int := lookup_type_id("Int")
    tid_bool := lookup_type_id("Bool")
    if method == "insert":
        if args.len() != 2:
            report_error("E207", "insert expects 2 arguments, got " + args.len().to_string())
            return tid_void
        # the key is a query position as much as a store one — the map looks
        # it up to decide whether this replaces an entry — so only the value
        # takes the store widening.
        check_argument_type(args[0], key_t, scope_id)
        check_widened_argument_type(args[1], val_t, scope_id)
        return tid_void
    if method == "len":
        expect_no_arguments(method, args)
        return tid_int
    if method == "is_empty":
        expect_no_arguments(method, args)
        return tid_bool
    if method == "clear":
        expect_no_arguments(method, args)
        return tid_void
    if method == "contains_key":
        expect_one_typed_argument(method, args, key_t, scope_id)
        return tid_bool
    if method == "get":
        expect_one_typed_argument(method, args, key_t, scope_id)
        return add_type_info(ti_optional(val_t))
    if method == "get_default":
        if args.len() != 2:
            report_error("E207", "get_default expects 2 arguments, got " + args.len().to_string())
            return val_t
        check_argument_type(args[0], key_t, scope_id)
        check_argument_type(args[1], val_t, scope_id)
        return val_t
    if method == "remove":
        expect_one_typed_argument(method, args, key_t, scope_id)
        return tid_void
    if method == "take":
        # remove and return the value with its count transferred: the
        # reclaim-safe way to drop a registry entry
        expect_one_typed_argument(method, args, key_t, scope_id)
        return val_t
    if method == "keys":
        expect_no_arguments(method, args)
        return intern_list_type(key_t)
    if method == "values":
        expect_no_arguments(method, args)
        return intern_list_type(val_t)
    return -1

# ---------------------------------------------------------------
# set methods
# ---------------------------------------------------------------

fn check_set_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    elem := info.inner
    if method == "insert":
        # the map spelling; without this rejection it falls through to
        # the map dispatch and the emitter builds a three-argument call
        report_error_with_fix("E209", "Set has no method 'insert'", "use add(value)")
        return TID_ERR
    if method == "add":
        # `add` stores, but there is nothing to widen into: an unhashable
        # element type — an optional, a container, Bytes, a struct — is
        # rejected outright (E254), since a set hashes int and string
        # flavors only and none of those values is either.
        expect_one_typed_argument(method, args, elem, scope_id)
        return TID_VOID
    if method == "len":
        expect_no_arguments(method, args)
        return TID_INT
    if method == "is_empty":
        expect_no_arguments(method, args)
        return TID_BOOL
    if method == "clear":
        expect_no_arguments(method, args)
        return TID_VOID
    if method == "contains":
        expect_one_typed_argument(method, args, elem, scope_id)
        return TID_BOOL
    if method == "remove":
        expect_one_typed_argument(method, args, elem, scope_id)
        return TID_VOID
    return -1

# ---------------------------------------------------------------
# method arg validators
# ---------------------------------------------------------------

fn check_sync_primitive_method_call(type_name: String, method: String, args: List[Int], scope_id: Int) -> Int:
    tid_void := lookup_type_id("Void")
    tid_int := lookup_type_id("Int")
    tid_err := lookup_type_id("<error>")
    if type_name == "Mutex":
        if method == "lock":
            expect_no_arguments("Mutex.lock", args)
            return tid_void
        if method == "unlock":
            expect_no_arguments("Mutex.unlock", args)
            return tid_void
    if type_name == "WaitGroup":
        if method == "add":
            expect_one_typed_argument("WaitGroup.add", args, tid_int, scope_id)
            return tid_void
        if method == "done":
            expect_no_arguments("WaitGroup.done", args)
            return tid_void
        if method == "wait":
            expect_no_arguments("WaitGroup.wait", args)
            return tid_void
    if type_name == "Semaphore":
        if method == "acquire":
            expect_no_arguments("Semaphore.acquire", args)
            return tid_void
        if method == "release":
            expect_no_arguments("Semaphore.release", args)
            return tid_void
    if type_name == "AtomicInt":
        tid_bool := lookup_type_id("Bool")
        if method == "load":
            expect_no_arguments("AtomicInt.load", args)
            return tid_int
        if method == "store":
            expect_one_typed_argument("AtomicInt.store", args, tid_int, scope_id)
            return tid_void
        if method == "compare_set":
            expect_two_typed_arguments("AtomicInt.compare_set", args, tid_int, tid_int, scope_id)
            return tid_bool
    return tid_err

fn check_channel_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    tid_int := lookup_type_id("Int")
    tid_bool := lookup_type_id("Bool")
    tid_err := lookup_type_id("<error>")
    inner := info.inner
    # a send is a store into the channel's element type, so a plain value
    # widens into an optional payload there the same way a list push does.
    if method == "send":
        expect_one_widened_argument("Channel.send", args, inner, scope_id)
        return tid_bool
    if method == "recv":
        # recv() returns T? (optional of inner type)
        expect_no_arguments("Channel.recv", args)
        return add_type_info(ti_optional(inner))
    if method == "try_send":
        expect_one_widened_argument("Channel.try_send", args, inner, scope_id)
        return tid_bool
    if method == "try_recv":
        expect_no_arguments("Channel.try_recv", args)
        return add_type_info(ti_optional(inner))
    if method == "close":
        expect_no_arguments("Channel.close", args)
        return tid_bool
    if method == "is_closed":
        expect_no_arguments("Channel.is_closed", args)
        return tid_bool
    if method == "len":
        expect_no_arguments("Channel.len", args)
        return tid_int
    if method == "cap":
        expect_no_arguments("Channel.cap", args)
        return tid_int
    return tid_err

fn check_task_method_call(method: String, info: TypeInfo, args: List[Int], scope_id: Int) -> Int:
    tid_bool := lookup_type_id("Bool")
    tid_void := lookup_type_id("Void")
    tid_err := lookup_type_id("<error>")
    if method == "is_done":
        expect_no_arguments("Task.is_done", args)
        return tid_bool
    if method == "detach":
        expect_no_arguments("Task.detach", args)
        return tid_void
    return tid_err

fn expect_no_arguments(method: String, args: List[Int]):
    if args.len() != 0:
        report_error("E207", method + " takes no arguments, got " + args.len().to_string())

fn expect_one_string_argument(method: String, args: List[Int], scope_id: Int):
    tid_string := lookup_type_id("String")
    if args.len() != 1:
        report_error("E207", method + " expects 1 argument, got " + args.len().to_string())
        return
    check_argument_type(args[0], tid_string, scope_id)

fn expect_two_string_arguments(method: String, args: List[Int], scope_id: Int):
    tid_string := lookup_type_id("String")
    if args.len() != 2:
        report_error("E207", method + " expects 2 arguments, got " + args.len().to_string())
        return
    check_argument_type(args[0], tid_string, scope_id)
    check_argument_type(args[1], tid_string, scope_id)

fn expect_two_int_arguments(method: String, args: List[Int], scope_id: Int):
    tid_int := lookup_type_id("Int")
    if args.len() != 2:
        report_error("E207", method + " expects 2 arguments, got " + args.len().to_string())
        return
    check_argument_type(args[0], tid_int, scope_id)
    check_argument_type(args[1], tid_int, scope_id)

fn expect_int_string_arguments(method: String, args: List[Int], scope_id: Int):
    tid_int := lookup_type_id("Int")
    tid_string := lookup_type_id("String")
    if args.len() != 2:
        report_error("E207", method + " expects 2 arguments, got " + args.len().to_string())
        return
    check_argument_type(args[0], tid_int, scope_id)
    check_argument_type(args[1], tid_string, scope_id)

fn expect_one_typed_argument(method: String, args: List[Int], expected: Int, scope_id: Int):
    if args.len() != 1:
        report_error("E207", method + " expects 1 argument, got " + args.len().to_string())
        return
    check_argument_type(args[0], expected, scope_id)

fn expect_two_typed_arguments(method: String, args: List[Int], first: Int, second: Int, scope_id: Int):
    if args.len() != 2:
        report_error("E207", method + " expects 2 arguments, got " + args.len().to_string())
        return
    check_argument_type(args[0], first, scope_id)
    check_argument_type(args[1], second, scope_id)

fn check_argument_type(arg_idx: Int, expected: Int, scope_id: Int):
    expr_idx := argument_expression_index(arg_idx)
    actual := c_check_expr(expr_idx, scope_id)
    propagate_empty_argument_collection_type(arg_idx, expected, actual, scope_id)
    if is_error_type(actual) == false:
        if actual != expected:
            if types_structurally_equal(actual, expected) == false:
                report_error_at(expr_idx, "E219", "argument type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(actual))

# the argument check for a position that takes the container's declared
# element type: a plain value widens into an optional element there the same
# way a binding, a struct field and a plain function's parameter already do.
# `xs.push(3)` into a List[Int?] keeps the Some(3) the list is declared to
# hold, and `xs.contains(3)` builds one to search with.
#
# a search position may only widen where the search compares structurally. a
# list's does — an optional element compares by tag and payload, so the shell
# built here finds the equal element it names. a map key and a set element
# never reach this question: the containers hash int and string flavors only,
# so Set[T?], Map[T?, V] and every other unhashable element or key type are
# rejected as types (E254) before any store or search could ask for widening.
fn check_widened_argument_type(arg_idx: Int, expected: Int, scope_id: Int):
    expr_idx := argument_expression_index(arg_idx)
    actual := c_check_expr(expr_idx, scope_id)
    propagate_empty_argument_collection_type(arg_idx, expected, actual, scope_id)
    if is_error_type(actual):
        return
    if actual == expected:
        return
    if types_structurally_equal(actual, expected):
        return
    if optional_target_accepts_value(expr_idx, actual, expected):
        return
    if collection_literal_matches_target(expr_idx, expected, scope_id):
        return
    report_error_at(expr_idx, "E219", "argument type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(actual))

fn expect_one_widened_argument(method: String, args: List[Int], expected: Int, scope_id: Int):
    if args.len() != 1:
        report_error("E207", method + " expects 1 argument, got " + args.len().to_string())
        return
    check_widened_argument_type(args[0], expected, scope_id)

# ---------------------------------------------------------------
# field access
# ---------------------------------------------------------------

fn check_field_access_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        return TID_ERR
    field_name := node.value

    # check if this is module alias access (e.g., math.abs)
    obj_node_idx := node.children[0]
    obj_node := get_node(obj_node_idx)
    if obj_node.kind == "ident":
        obj_name := obj_node.value
        if module_aliases.contains_key(obj_name):
            module_path := module_aliases[obj_name]
            qualified_name := module_import_target_name(module_path, field_name)
            module_name := module_generic_target_name(module_path, field_name)
            # a function the target module declared without `pub` is its own
            # business. the lookups below end in a bare-name fallback into the
            # shared table, which used to reach a private helper and hand back
            # a value the caller could not use.
            if not module_function_is_visible(module_path, field_name):
                report_error("E251", "'" + field_name + "' is not public in module '" + obj_name + "'")
                return TID_ERR
            mut func_tid := lookup_binding(scope_id, module_name)
            if func_tid >= 0:
                return func_tid
            # the same unqualified lookups as the call path, under the same
            # restriction: neither may answer with a name another module owns.
            func_tid = lookup_binding_owned_by(scope_id, qualified_name, module_path)
            if func_tid >= 0:
                return func_tid
            func_tid = lookup_binding_owned_by(scope_id, field_name, module_path)
            if func_tid >= 0:
                return func_tid
            report_error("E209", "module '" + obj_name + "' has no function '" + field_name + "'")
            return TID_ERR

    obj_type := c_check_expr(obj_node_idx, scope_id)
    if is_error_type(obj_type):
        return TID_ERR
    obj_info := get_type_info(obj_type)
    if obj_info.kind == "struct":
        mut fidx := 0
        while fidx < obj_info.fields.len():
            if strings_equal(obj_info.fields[fidx], field_name):
                if fidx < obj_info.field_types.len():
                    return obj_info.field_types[fidx]
                return TID_ERR
            fidx = fidx + 1
        report_error("E209", get_type_name(obj_type) + " has no field '" + field_name + "'")
        return TID_ERR
    if obj_info.kind == "tuple":
        # parse field name as integer index
        idx := parse_integer_string(field_name)
        if idx < 0:
            report_error("E209", "tuple field must be a numeric index")
            return TID_ERR
        if idx >= obj_info.elements.len():
            report_error("E209", "tuple index " + field_name + " out of bounds (tuple has " + obj_info.elements.len().to_string() + " elements)")
            return TID_ERR
        return obj_info.elements[idx]
    if obj_info.kind == "result":
        tid_bool := lookup_type_id("Bool")
        if strings_equal(field_name, "is_ok") or strings_equal(field_name, "is_err"):
            return tid_bool
        if strings_equal(field_name, "ok"):
            return obj_info.inner
        if strings_equal(field_name, "err"):
            return obj_info.value_type
        report_error("E209", "result has no field '" + field_name + "'")
        return TID_ERR
    # enum variant access (e.g. Shape.Circle) — for match patterns
    if obj_info.kind == "enum":
        # this is typically used in patterns, not field access
        # but allow it for enum variant references
        return obj_type
    report_error("E209", get_type_name(obj_type) + " has no field '" + field_name + "'")
    return TID_ERR

fn parse_integer_string(s: String) -> Int:
    # simple integer parser for tuple field indices
    if s.len() == 0:
        return -1
    mut result := 0
    mut i := 0
    while i < s.len():
        ch := s[i]
        if ch == "0":
            result = result * 10
        elif ch == "1":
            result = result * 10 + 1
        elif ch == "2":
            result = result * 10 + 2
        elif ch == "3":
            result = result * 10 + 3
        elif ch == "4":
            result = result * 10 + 4
        elif ch == "5":
            result = result * 10 + 5
        elif ch == "6":
            result = result * 10 + 6
        elif ch == "7":
            result = result * 10 + 7
        elif ch == "8":
            result = result * 10 + 8
        elif ch == "9":
            result = result * 10 + 9
        else:
            return -1
        i = i + 1
    return result

# ---------------------------------------------------------------
# index expression
# ---------------------------------------------------------------

# true, having reported, when this index expression brackets a generic
# method without calling it: `x.describe[Int]` on its own. the parser reads
# `x.describe[Int](v)` as a method call carrying type arguments, so what
# reaches here is the bracket list with no call after it. answers false for
# every other shape, including an index into a field that happens to share a
# method's name, so the ordinary index checking below is untouched.
fn indexes_a_generic_method(node: Node, scope_id: Int) -> Bool:
    base := get_node(node.children[0])
    if base.kind != "field_access" or base.children.len() == 0:
        return false
    # only a bracket holding a bare type name can be a type-argument list. an
    # ordinary index holds a literal, a key expression or a binding, so this
    # returns before checking anything on every real index expression.
    arg := get_node(node.children[1])
    if arg.kind != "ident":
        return false
    if lookup_binding(scope_id, arg.value) >= 0:
        return false
    if lookup_type_id(arg.value) < 0:
        return false
    recv_type := c_check_expr(base.children[0], scope_id)
    if is_error_type(recv_type):
        return false
    recv_info := get_type_info(recv_type)
    if recv_info.fields.contains(base.value):
        return false
    mut key := method_tid_key(recv_type, base.value)
    if has_method_declaration(key) == false:
        key = get_type_name(recv_type) + "." + base.value
        if has_method_declaration(key) == false:
            return false
    if declaration_has_generic_params(get_node(get_method_declaration_index(key))) == false:
        return false
    report_error("E209", get_type_name(recv_type) + "." + base.value + " is a generic method: its type arguments go ahead of the call's parentheses, as in " + base.value + "[" + arg.value + "](...)")
    return true

fn check_index_expression(node: Node, scope_id: Int) -> Int:
    tid_string := lookup_type_id("String")
    tid_bytes := lookup_type_id("Bytes")
    tid_int := lookup_type_id("Int")
    if node.children.len() < 2:
        return TID_ERR
    # `x.describe[Int]` with no call after it is an index into `x.describe`,
    # which is a method, not a field. name that here — checking the parts
    # would report a missing field and an undefined variable, and neither
    # reads as the real problem.
    if indexes_a_generic_method(node, scope_id):
        return TID_ERR
    mut obj_type := c_check_expr(node.children[0], scope_id)
    idx_type := c_check_expr(node.children[1], scope_id)
    if is_error_type(obj_type):
        return TID_ERR
    if is_error_type(idx_type):
        return TID_ERR
    mut obj_info := get_type_info(obj_type)
    if obj_info.kind == "optional":
        obj_type = obj_info.inner
        obj_info = get_type_info(obj_type)
    elif obj_info.kind == "result":
        obj_type = obj_info.inner
        obj_info = get_type_info(obj_type)
    # string indexing
    if obj_type == tid_string:
        if is_integer_type(idx_type) == false:
            report_error("E217", "string index must be integer, got " + get_type_name(idx_type))
            return TID_ERR
        return tid_string
    if obj_type == tid_bytes:
        if is_integer_type(idx_type) == false:
            report_error("E217", "bytes index must be integer, got " + get_type_name(idx_type))
            return TID_ERR
        return tid_int
    if obj_info.kind == "list":
        if is_integer_type(idx_type) == false:
            report_error("E217", "list index must be integer, got " + get_type_name(idx_type))
            return TID_ERR
        return obj_info.inner
    if obj_info.kind == "map":
        if idx_type != obj_info.key_type:
            report_error("E217", "map key type mismatch: expected " + get_type_name(obj_info.key_type) + ", got " + get_type_name(idx_type))
            return TID_ERR
        return obj_info.value_type
    report_error("E217", get_type_name(obj_type) + " does not support indexing")
    return TID_ERR

# ---------------------------------------------------------------
# unwrap expression (value?)
# ---------------------------------------------------------------

fn check_unwrap_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        return TID_ERR
    inner := c_check_expr(node.children[0], scope_id)
    if is_error_type(inner):
        return TID_ERR
    info := get_type_info(inner)
    if info.kind == "optional":
        if checking_test_decl:
            return info.inner
        # ? propagates `none` as a fail in the enclosing function. That
        # only makes sense when the enclosing function returns a result;
        # otherwise the unwrap would either silently corrupt the program
        # or have to abort, which violates the no-panics rule.
        ret := get_scope_return_type(scope_id)
        if ret < 0:
            report_error_with_fix("E238", "unwrap (?) can only be used in functions that return a result type", "wrap main or the enclosing fn return in T! and propagate, or replace ? with `match`/`unwrap_or` for an in-place default")
            return TID_ERR
        ret_info := get_type_info(ret)
        if ret_info.kind != "result":
            report_error_with_fix("E238", "unwrap (?) can only be used in functions that return a result type", "wrap main or the enclosing fn return in T! and propagate, or replace ? with `match`/`unwrap_or` for an in-place default")
            return TID_ERR
        return info.inner
    if info.kind == "result":
        report_error_with_fix("E224", "unwrap (?) requires an optional type, got " + get_type_name(inner), "use ! to propagate a result error")
    else:
        report_error_with_fix("E224", "unwrap (?) requires an optional type, got " + get_type_name(inner), "wrap the producer return in T? so ? has something to unwrap")
    return TID_ERR

# ---------------------------------------------------------------
# try expression (value!)
# ---------------------------------------------------------------

fn check_try_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        return TID_ERR
    inner := c_check_expr(node.children[0], scope_id)
    if is_error_type(inner):
        return TID_ERR
    info := get_type_info(inner)
    if info.kind == "result":
        if checking_test_decl:
            return info.inner
        # verify enclosing function also returns a result
        ret := get_scope_return_type(scope_id)
        if ret < 0:
            report_error("E239", "try (!) can only be used in functions that return a result type")
            return TID_ERR
        ret_info := get_type_info(ret)
        if ret_info.kind != "result":
            report_error("E239", "try (!) can only be used in functions that return a result type")
            return TID_ERR
        if types_compatible(info.value_type, ret_info.value_type) == false:
            report_error("E239", "try (!) error type mismatch: cannot propagate " + get_type_name(info.value_type) + " from function returning " + get_type_name(ret))
            return TID_ERR
        return info.inner
    if info.kind == "optional":
        report_error_with_fix("E224", "try (!) requires a result type, got " + get_type_name(inner), "use ? to unwrap an optional value")
    else:
        report_error_with_fix("E224", "try (!) requires a result type, got " + get_type_name(inner), "wrap the producer return in T! so ! can propagate the error")
    return TID_ERR

fn check_catch_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 2:
        return TID_ERR
    result_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(result_type):
        return TID_ERR
    result_info := get_type_info(result_type)
    if result_info.kind != "result":
        report_error("E224", "catch requires a result type, got " + get_type_name(result_type))
        return TID_ERR
    fallback_type := c_check_expr(node.children[1], scope_id)
    if is_error_type(fallback_type):
        return TID_ERR
    if types_compatible(fallback_type, result_info.inner) == false:
        report_error("E219", "catch fallback type mismatch: expected " + get_type_name(result_info.inner) + ", got " + get_type_name(fallback_type))
        return TID_ERR
    return result_info.inner

# `expr catch:` with an indented block. the block runs on the error path and
# produces no value, so it has to leave — return, fail, continue or break —
# rather than fall through to code that would read a binding nothing wrote.
fn check_catch_block(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 2:
        return TID_ERR
    result_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(result_type):
        return TID_ERR
    result_info := get_type_info(result_type)
    if result_info.kind != "result":
        report_error("E224", "catch requires a result type, got " + get_type_name(result_type))
        return TID_ERR

    block_node := get_node(node.children[1])
    block_scope := create_scope(scope_id)
    check_block_statement(block_node, block_scope)

    if block_node.children.len() == 0:
        report_error("E253", "a catch block cannot be empty; it runs on the error path and must leave with return, fail, continue or break")
        return TID_ERR
    last := get_node(block_node.children[block_node.children.len() - 1])
    if last.kind != "return" and last.kind != "fail" and last.kind != "continue" and last.kind != "break":
        report_error("E253", "a catch block must end with return, fail, continue or break; it produces no value for the surrounding expression")
        return TID_ERR
    return result_info.inner

fn check_select_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() == 0:
        report_error("E232", "select requires at least one arm")
        return TID_ERR
    mut result_type := TID_ERR
    mut saw_default := false
    mut saw_timeout := false
    mut branch_exprs: List[Int] := []
    mut branch_types: List[Int] := []
    for child in node.children:
        arm_node := get_node(child)
        last_branch_value_expr = 0 - 1
        arm_type := check_select_arm(arm_node, scope_id)
        branch_exprs.push(last_branch_value_expr)
        branch_types.push(arm_type)
        if arm_node.kind == "select_default_arm":
            if saw_default:
                report_error("E232", "select can only have one default arm")
            saw_default = true
        elif arm_node.kind == "select_timeout_arm":
            if saw_timeout:
                report_error("E232", "select can only have one timeout arm")
            saw_timeout = true
        if is_error_type(result_type):
            result_type = arm_type
        elif is_error_type(arm_type) == false:
            if arm_type != result_type:
                if arm_type != TID_VOID and result_type != TID_VOID:
                    unified := unify_branch_types(result_type, arm_type)
                    if unified < 0:
                        report_error("E225", "select arms have different types: " + get_type_name(result_type) + " vs " + get_type_name(arm_type))
                    else:
                        result_type = unified
    mark_widened_branches(branch_exprs, branch_types, result_type)
    return result_type

# the type two branches of one expression settle on, or -1 when they cannot.
# equal or same-shape types keep the first — composite types (tuples,
# optionals) are allocated fresh per resolution, so two branches with the
# same shape can carry different ids. a `none` beside a value takes the
# value's optional, and a value beside its own optional takes the optional,
# so `match v: none => none; x => x` in a body returning `T?` is a `T?`
# rather than a fault between `none` and `Int`.
fn unify_branch_types(result_type: Int, arm_type: Int) -> Int:
    if arm_type == result_type:
        return result_type
    if types_structurally_equal(arm_type, result_type):
        return result_type
    if is_none_type(result_type):
        if is_none_type(arm_type):
            return result_type
        return optional_over(arm_type)
    if is_none_type(arm_type):
        return optional_over(result_type)
    rinfo := get_type_info(result_type)
    if rinfo.kind == "optional":
        if rinfo.inner == arm_type or types_structurally_equal(rinfo.inner, arm_type):
            return result_type
    ainfo := get_type_info(arm_type)
    if ainfo.kind == "optional":
        if ainfo.inner == result_type or types_structurally_equal(ainfo.inner, result_type):
            return arm_type
    return 0 - 1

# `tid` as an optional: itself when it already is one.
fn optional_over(tid: Int) -> Int:
    if get_type_info(tid).kind == "optional":
        return tid
    return add_type_info(ti_optional(tid))

# once the branches of one expression settle on an optional, each branch that
# produced a plain value is recorded as widening into it — the same record a
# call argument uses (optional_widened_arguments) — so the emitter builds the
# Some the readers of the whole expect rather than storing the bare value in
# a slot read as a shell. a `none` branch and an already-optional branch need
# nothing.
fn mark_widened_branches(exprs: List[Int], types: List[Int], result_type: Int):
    if result_type < 0 or is_error_type(result_type):
        return
    if get_type_info(result_type).kind != "optional":
        return
    for e, i in exprs:
        t := types[i]
        if e >= 0 and t >= 0 and is_error_type(t) == false and is_none_type(t) == false and t != TID_VOID:
            if get_type_info(t).kind != "optional":
                optional_widened_arguments.insert(e, true)

fn check_select_arm(arm: Node, scope_id: Int) -> Int:
    if arm.kind == "select_recv_arm":
        return check_select_recv_arm(arm, scope_id)
    if arm.kind == "select_send_arm":
        return check_select_send_arm(arm, scope_id)
    if arm.kind == "select_timeout_arm":
        return check_select_timeout_arm(arm, scope_id)
    if arm.kind == "select_default_arm":
        return check_select_arm_body(arm, 0, scope_id)
    report_error("E232", "invalid select arm")
    return TID_ERR

fn check_select_recv_arm(arm: Node, scope_id: Int) -> Int:
    if arm.children.len() < 2:
        report_error("E232", "select recv arm requires a recv expression and body")
        return TID_ERR
    recv_node := get_node(arm.children[0])
    if recv_node.kind != "method_call" or recv_node.value != "recv":
        report_error("E232", "select recv arms must use name := channel.recv()")
        return TID_ERR
    recv_type := c_check_expr(arm.children[0], scope_id)
    if is_error_type(recv_type):
        return TID_ERR
    arm_scope := create_scope(scope_id)
    define_binding(arm_scope, arm.value, recv_type, false)
    return check_select_arm_body(arm, 1, arm_scope)

fn check_select_send_arm(arm: Node, scope_id: Int) -> Int:
    if arm.children.len() < 2:
        report_error("E232", "select send arm requires a send expression and body")
        return TID_ERR
    send_node := get_node(arm.children[0])
    if send_node.kind != "method_call" or send_node.value != "send":
        report_error("E232", "select send arms must use channel.send(value)")
        return TID_ERR
    send_type := c_check_expr(arm.children[0], scope_id)
    if is_error_type(send_type):
        return TID_ERR
    if send_type != TID_BOOL:
        report_error("E232", "select send arms must use a channel send expression")
        return TID_ERR
    return check_select_arm_body(arm, 1, scope_id)

fn check_select_timeout_arm(arm: Node, scope_id: Int) -> Int:
    if arm.children.len() < 2:
        report_error("E232", "select timeout arm requires a duration and body")
        return TID_ERR
    timeout_type := c_check_expr(arm.children[0], scope_id)
    if is_error_type(timeout_type) == false:
        if timeout_type != TID_INT:
            report_error("E219", "select timeout expects Int milliseconds, got " + get_type_name(timeout_type))
    return check_select_arm_body(arm, 1, scope_id)

fn check_select_arm_body(arm: Node, body_idx: Int, scope_id: Int) -> Int:
    if body_idx >= arm.children.len():
        return TID_VOID
    body_node := get_node(arm.children[body_idx])
    if body_node.kind == "body":
        if body_node.children.len() == 0:
            last_branch_value_expr = 0 - 1
            return TID_VOID
        last_branch_value_expr = body_node.children[0]
        return c_check_expr(body_node.children[0], scope_id)
    if body_node.kind == "block":
        check_block_statement(body_node, scope_id)
        last_branch_value_expr = 0 - 1
        return TID_VOID
    last_branch_value_expr = arm.children[body_idx]
    return c_check_expr(arm.children[body_idx], scope_id)

# ---------------------------------------------------------------
# if expression
# ---------------------------------------------------------------

fn check_if_expression(node: Node, scope_id: Int) -> Int:
    # children: [condition, then_expr, elif_branches..., else_expr]
    if node.children.len() < 2:
        return TID_ERR
    cond := c_check_expr(node.children[0], scope_id)
    if is_error_type(cond) == false:
        if cond != TID_BOOL:
            report_error("E200", "condition must be Bool, got " + get_type_name(cond))
    # check then branch
    then_type := c_check_expr(node.children[1], scope_id)
    mut result_type := then_type
    mut branch_exprs: List[Int] := [node.children[1]]
    mut branch_types: List[Int] := [then_type]
    # check remaining branches (skip first 2: condition + then)
    mut skip_br := 2
    for child in node.children:
        if skip_br > 0:
            skip_br = skip_br - 1
            continue
        cn := get_node(child)
        if cn.kind == "elif_branch":
            if cn.children.len() >= 2:
                econd := c_check_expr(cn.children[0], scope_id)
                if is_error_type(econd) == false:
                    if econd != TID_BOOL:
                        report_error("E200", "condition must be Bool, got " + get_type_name(econd))
                etype := c_check_expr(cn.children[1], scope_id)
                branch_exprs.push(cn.children[1])
                branch_types.push(etype)
                if is_error_type(result_type):
                    result_type = etype
                elif is_error_type(etype) == false:
                    if etype != result_type:
                        unified := unify_branch_types(result_type, etype)
                        if unified < 0:
                            report_error("E225", "if expression branches have different types: " + get_type_name(result_type) + " vs " + get_type_name(etype))
                        else:
                            result_type = unified
        else:
            # else branch
            etype := c_check_expr(child, scope_id)
            branch_exprs.push(child)
            branch_types.push(etype)
            if is_error_type(result_type):
                result_type = etype
            elif is_error_type(etype) == false:
                if etype != result_type:
                    unified := unify_branch_types(result_type, etype)
                    if unified < 0:
                        report_error("E225", "if expression branches have different types: " + get_type_name(result_type) + " vs " + get_type_name(etype))
                    else:
                        result_type = unified
    mark_widened_branches(branch_exprs, branch_types, result_type)
    return result_type

# ---------------------------------------------------------------
# match expression
# ---------------------------------------------------------------

fn check_match_expression(node_idx: Int, scope_id: Int) -> Int:
    node := get_node(node_idx)
    # children[0] is the subject expression
    # children[1..] are arm nodes
    if node.children.len() < 2:
        return TID_ERR
    subject_type := c_check_expr(node.children[0], scope_id)
    if is_error_type(subject_type):
        return TID_ERR
    mut result_type := TID_ERR
    mut arm_values: List[String] := []
    mut branch_exprs: List[Int] := []
    mut branch_types: List[Int] := []
    mut skip_subj := 1
    for child in node.children:
        if skip_subj > 0:
            skip_subj = skip_subj - 1
            continue
        arm_node := get_node(child)
        if arm_node.kind == "arm":
            arm_type := check_match_arm(arm_node, subject_type, scope_id)
            branch_exprs.push(last_branch_value_expr)
            branch_types.push(arm_type)
            # collect pattern values for exhaustiveness; an or-pattern covers
            # each of its alternatives.
            if arm_node.children.len() > 0:
                pat := get_node(arm_node.children[0])
                if pat.kind == "pat_or":
                    for alt in pat.children:
                        av := collect_arm_pattern_bindings(get_node(alt))
                        if av.len() > 0:
                            arm_values.push(av)
                else:
                    pv := collect_arm_pattern_bindings(pat)
                    if pv.len() > 0:
                        arm_values.push(pv)
            if is_error_type(result_type):
                result_type = arm_type
            elif is_error_type(arm_type) == false:
                if arm_type != result_type:
                    if arm_type != TID_VOID:
                        if result_type != TID_VOID:
                            unified := unify_branch_types(result_type, arm_type)
                            if unified < 0:
                                report_error("E225", "match arms have different types: " + get_type_name(result_type) + " vs " + get_type_name(arm_type))
                            else:
                                result_type = unified
    mark_widened_branches(branch_exprs, branch_types, result_type)
    # exhaustiveness checking
    check_match_exhaustiveness(subject_type, arm_values, node_idx)
    return result_type

fn check_match_arm(arm: Node, subject_type: Int, scope_id: Int) -> Int:
    # children: [pattern, guard?, body]
    if arm.children.len() < 2:
        return TID_ERR
    arm_scope := create_scope(scope_id)
    # check pattern
    check_pattern_match(arm.children[0], subject_type, arm_scope)
    # find body (may have guard between pattern and body)
    mut body_idx := 1
    if arm.children.len() > 2:
        guard_node := get_node(arm.children[1])
        if guard_node.kind == "guard":
            if guard_node.children.len() > 0:
                guard_type := c_check_expr(guard_node.children[0], arm_scope)
                if is_error_type(guard_type) == false:
                    if guard_type != TID_BOOL:
                        report_error("E218", "match guard must be Bool, got " + get_type_name(guard_type))
            body_idx = 2
    last_branch_value_expr = 0 - 1
    if body_idx >= arm.children.len():
        return TID_VOID
    body_node := get_node(arm.children[body_idx])
    # an inline `=> expr` arm is wrapped in a "body" node; its type is the
    # expression's type so the match can be used as a value.
    if body_node.kind == "body":
        if body_node.children.len() > 0:
            last_branch_value_expr = body_node.children[0]
            return c_check_expr(body_node.children[0], arm_scope)
        return TID_VOID
    if body_node.kind == "block":
        check_block_statement(body_node, arm_scope)
        return TID_VOID
    # expression arm
    last_branch_value_expr = arm.children[body_idx]
    return c_check_expr(arm.children[body_idx], arm_scope)

# ---------------------------------------------------------------
# pattern checking
# ---------------------------------------------------------------

fn check_pattern_match(pat_idx: Int, expected_type: Int, scope_id: Int):
    pat := get_node(pat_idx)
    if pat.kind == "pat_wildcard":
        return
    if pat.kind == "pat_binding":
        note_fn_binding_name(pat.value, pat_idx)
        # a binding on an optional subject unwraps, mirroring if let
        info := get_type_info(expected_type)
        if info.kind == "optional":
            define_binding_at(scope_id, pat.value, info.inner, false, pat_idx)
            return
        define_binding_at(scope_id, pat.value, expected_type, false, pat_idx)
        return
    if pat.kind == "pat_int":
        if is_integer_type(expected_type) == false:
            report_error("E228", "integer pattern cannot match " + get_type_name(expected_type))
        return
    if pat.kind == "pat_range":
        if is_integer_type(expected_type) == false:
            report_error("E228", "range pattern cannot match " + get_type_name(expected_type))
        return
    if pat.kind == "pat_float":
        if expected_type != TID_FLOAT:
            report_error("E228", "float pattern cannot match " + get_type_name(expected_type))
        return
    if pat.kind == "pat_string":
        if expected_type != TID_STRING:
            report_error("E228", "string pattern cannot match " + get_type_name(expected_type))
        return
    if pat.kind == "pat_bool":
        if expected_type != TID_BOOL:
            report_error("E228", "bool pattern cannot match " + get_type_name(expected_type))
        return
    if pat.kind == "pat_none":
        return
    if pat.kind == "pat_variant":
        check_variant_pattern_match(pat, expected_type, scope_id)
        return
    if pat.kind == "pat_or":
        check_or_pattern_match(pat, expected_type, scope_id)
        return
    if pat.kind == "pat_tuple":
        check_tuple_pattern_match(pat, expected_type, scope_id)
        return

# Each alternative of an or-pattern must match the same type. Alternatives may
# not bind names (the arms can't tell which alternative matched), so a binding
# or wildcard alternative is rejected.
fn check_or_pattern_match(pat: Node, expected_type: Int, scope_id: Int):
    for alt in pat.children:
        alt_node := get_node(alt)
        if alt_node.kind == "pat_binding" or alt_node.kind == "pat_wildcard":
            report_error("E228", "or-pattern alternatives cannot bind; use a separate arm")
        else:
            check_pattern_match(alt, expected_type, scope_id)

fn check_variant_pattern_match(pat: Node, expected_type: Int, scope_id: Int):
    # value: "EnumName.VariantName"
    # children: sub-patterns for variant fields
    parts := split_qualified_name(pat.value)
    if parts.1.len() == 0:
        return
    type_name := parts.0
    variant_name := parts.1
    mut enum_tid := lookup_type_id(type_name)
    # a generic enum registers only its instances (Opt[Int]), never the bare
    # base, so a pattern's `Opt.Some` finds nothing by name and used to die
    # here with "unknown type". the subject already names the instance, and
    # its base name says whether the pattern is talking about that same enum
    # — so resolve the pattern against the subject. a pattern naming a
    # DIFFERENT enum keeps its table lookup and still fails the mismatch
    # check below.
    if expected_type >= 0:
        einfo := get_type_info(expected_type)
        if einfo.kind == "enum" and extract_base_type_name(einfo.name) == type_name:
            enum_tid = expected_type
    if enum_tid < 0:
        report_error("E202", "unknown type: " + type_name)
        return
    if enum_tid != expected_type:
        report_error("E228", "variant pattern type " + type_name + " does not match expected type " + get_type_name(expected_type))
        return
    enum_info := get_type_info(enum_tid)
    if enum_info.kind != "enum":
        report_error("E228", type_name + " is not an enum")
        return
    # find the variant
    mut found := false
    mut vidx := 0
    for v in enum_info.variants:
        if strings_equal(v, variant_name):
            found = true
            # check sub-pattern count
            if vidx < enum_info.variant_types.len():
                variant_fields := enum_info.variant_types[vidx]
                if pat.children.len() != variant_fields.len():
                    report_error("E213", variant_name + " has " + variant_fields.len().to_string() + " fields, but pattern has " + pat.children.len().to_string())
                    return
                # check each sub-pattern
                mut fidx := 0
                for sub_pat in pat.children:
                    if fidx < variant_fields.len():
                        sub := get_node(sub_pat)
                        if sub.kind == "pat_binding":
                            # a payload binding holds the slot exactly as
                            # declared: the runtime binds the raw payload, so
                            # an optional payload stays optional here. the
                            # unwrap rule in check_pattern_match is for a
                            # binding arm on an optional SUBJECT, where the
                            # match itself unwraps — applying it to a payload
                            # typed the box as its inner and interpolating
                            # the binding printed a heap address.
                            note_fn_binding_name(sub.value, sub_pat)
                            define_binding_at(scope_id, sub.value, variant_fields[fidx], false, sub_pat)
                        else:
                            check_pattern_match(sub_pat, variant_fields[fidx], scope_id)
                    fidx = fidx + 1
        vidx = vidx + 1
    if found == false:
        report_error("E212", type_name + " has no variant '" + variant_name + "'")

fn check_tuple_pattern_match(pat: Node, expected_type: Int, scope_id: Int):
    info := get_type_info(expected_type)
    if info.kind != "tuple":
        report_error("E228", "tuple pattern cannot match " + get_type_name(expected_type))
        return
    if pat.children.len() != info.elements.len():
        report_error("E213", "tuple pattern has " + pat.children.len().to_string() + " elements, expected " + info.elements.len().to_string())
        return
    mut i := 0
    for sub_pat in pat.children:
        if i < info.elements.len():
            check_pattern_match(sub_pat, info.elements[i], scope_id)
        i = i + 1

# ---------------------------------------------------------------
# exhaustiveness checking
# ---------------------------------------------------------------

fn collect_arm_pattern_bindings(pat: Node) -> String:
    if pat.kind == "pat_wildcard":
        return "_"
    if pat.kind == "pat_binding":
        return "_"
    if pat.kind == "pat_bool":
        return pat.value
    if pat.kind == "pat_variant":
        # extract variant name from "EnumName.VariantName"
        parts := split_qualified_name(pat.value)
        if parts.1.len() > 0:
            return parts.1
        return parts.0
    if pat.kind == "pat_int":
        return pat.value
    if pat.kind == "pat_string":
        return pat.value
    if pat.kind == "pat_tuple":
        # a tuple of bindings and wildcards matches anything
        for sub_idx in pat.children:
            sub := get_node(sub_idx)
            if sub.kind != "pat_binding" and sub.kind != "pat_wildcard":
                return ""
        return "_"
    if pat.kind == "pat_none":
        return "None"
    return ""

fn check_match_exhaustiveness(subject_type: Int, arm_values: List[String], node_idx: Int):
    # if any wildcard or binding pattern, it's exhaustive
    for v in arm_values:
        if v == "_":
            return
    # check by type
    if subject_type == TID_BOOL:
        check_bool_exhaustiveness(arm_values)
        return
    subj_info := get_type_info(subject_type)
    if subj_info.kind == "enum":
        check_enum_exhaustiveness(subj_info, arm_values)
        return
    if subj_info.kind == "optional":
        # Optional needs both Some and None patterns (or wildcard)
        mut has_some := false
        mut has_none := false
        for v in arm_values:
            if v == "Some":
                has_some = true
            elif v == "_":
                has_some = true
            if v == "None":
                has_none = true
            elif v == "_":
                has_none = true
        if not has_some:
            report_error("E204", "non-exhaustive match on Optional: add 'Some' case or wildcard (_)")
        if not has_none:
            report_error("E204", "non-exhaustive match on Optional: add 'None' case or wildcard (_)")
        return
    # infinite domain (Int, String, Float) — need wildcard
    report_error("E204", "non-exhaustive match: add a wildcard (_) pattern")

fn check_bool_exhaustiveness(arm_values: List[String]):
    mut has_true := false
    mut has_false := false
    for v in arm_values:
        if v == "true":
            has_true = true
        if v == "false":
            has_false = true
    if has_true == false:
        report_error("E204", "non-exhaustive match: missing 'true' case")
    if has_false == false:
        report_error("E204", "non-exhaustive match: missing 'false' case")

fn check_enum_exhaustiveness(info: TypeInfo, arm_values: List[String]):
    mut missing: List[String] := []
    for variant in info.variants:
        mut found := false
        for v in arm_values:
            if strings_equal(v, variant):
                found = true
        if found == false:
            missing.push(variant)
    if missing.len() > 0:
        report_error("E204", "non-exhaustive match: missing variants: " + missing.join(", "))

# ---------------------------------------------------------------
# lambda expression
# ---------------------------------------------------------------

fn check_lambda_expression(node: Node, scope_id: Int) -> Int:
    # children: params..., body (last child is the expression body or body node)
    mut params: List[Int] := []
    lambda_scope := create_scope(scope_id)
    mut body_idx := -1
    # -1 when the lambda declares no return type, which is the common case
    mut declared_return := 0 - 1
    for child in node.children:
        cn := get_node(child)
        if cn.kind == "param":
            if cn.children.len() > 0:
                ptid := resolve_type_implementation(cn.children[0])
                params.push(ptid)
                pname := extract_binding_name(cn.value)
                define_binding_at(lambda_scope, pname, ptid, false, child)
            else:
                report_error("E230", "lambda parameter requires a type annotation")
                params.push(TID_ERR)
        elif cn.kind == "returns":
            if cn.children.len() > 0:
                declared_return = resolve_type_implementation(cn.children[0])
        else:
            body_idx = child
    # check body. the depth counter marks that names resolved in here cross a
    # closure boundary, which is what the weak-capture rejection keys off.
    checker_lambda_depth = checker_lambda_depth + 1
    mut ret_type := TID_VOID
    if body_idx >= 0:
        body_node := get_node(body_idx)
        if body_node.kind == "body":
            # short-form lambda: body wraps a single expression
            if body_node.children.len() > 0:
                ret_type = c_check_expr(body_node.children[0], lambda_scope)
                if declared_return >= 0:
                    if is_error_type(ret_type) == false and types_structurally_equal(ret_type, declared_return) == false:
                        report_error("E200", "lambda return type mismatch: expected " + get_type_name(declared_return) + ", got " + get_type_name(ret_type))
                    ret_type = declared_return
        elif body_node.kind == "block":
            # a declared return type stands in for the infer sentinel, so every
            # return in the body is held against it by the same check a named
            # function's returns go through.
            mut block_expect := TID_LAMBDA_INFER
            if declared_return >= 0:
                block_expect = declared_return
            block_scope := create_function_scope(lambda_scope, block_expect)
            saved_infer := lambda_inferred_return
            lambda_inferred_return = 0 - 1
            check_block_statement(body_node, block_scope)
            if declared_return >= 0:
                ret_type = declared_return
            elif lambda_inferred_return >= 0:
                ret_type = lambda_inferred_return
            lambda_inferred_return = saved_infer
        else:
            ret_type = c_check_expr(body_idx, lambda_scope)
    checker_lambda_depth = checker_lambda_depth - 1
    return add_type_info(ti_function(params, ret_type))

# ---------------------------------------------------------------
# collection literal expressions
# ---------------------------------------------------------------

# a bare `none` element names no type of its own — all it says is that the
# element type has to be an optional. so it is folded into the unified
# element type rather than compared against it: the concrete elements decide
# the inner type and the result is wrapped once. `[none, 1]` is a
# `List[Int?]`, which is also what a `List[Int?]` annotation asks for, while
# a `List[Int]` annotation still rejects it element by element.
fn element_type_with_none(elem_type: Int) -> Int:
    if elem_type < 0:
        return elem_type
    if get_type_info(elem_type).kind == "optional":
        return elem_type
    return add_type_info(ti_optional(elem_type))

fn check_list_expression(node: Node, scope_id: Int) -> Int:
    tid_err := lookup_type_id("<error>")
    if node.children.len() == 0:
        # empty list — type comes from annotation context
        return tid_err
    # check all elements
    mut elem_type := tid_err
    mut saw_none := false
    for child in node.children:
        t := c_check_expr(child, scope_id)
        if is_none_type(t):
            saw_none = true
            continue
        if is_error_type(elem_type):
            elem_type = t
        elif is_error_type(t) == false:
            if t != elem_type and types_structurally_equal(t, elem_type) == false:
                report_error_at(child, "E223", "list elements must be the same type: expected " + get_type_name(elem_type) + ", got " + get_type_name(t))
    if saw_none:
        # even an all-`none` literal has a shape: a list of optionals whose
        # inner is not yet known. that is enough for a `List[T?]` annotation to
        # match structurally and for a `List[T]` one to reject, and it keeps
        # the element tag right (an optional is heap-shaped, not an int).
        return intern_list_type(element_type_with_none(elem_type))
    if is_error_type(elem_type):
        return tid_err
    return intern_list_type(elem_type)

fn check_map_expression(node: Node, scope_id: Int) -> Int:
    tid_err := lookup_type_id("<error>")
    if node.children.len() == 0:
        return tid_err
    mut key_type := tid_err
    mut val_type := tid_err
    mut saw_none_value := false
    for child in node.children:
        entry := get_node(child)
        if entry.kind == "entry":
            if entry.children.len() >= 2:
                kt := c_check_expr(entry.children[0], scope_id)
                vt := c_check_expr(entry.children[1], scope_id)
                if is_none_type(kt):
                    # a map key is hashed and compared; the empty case of an
                    # optional is not a key.
                    report_error_at(entry.children[0], "E223", "map key cannot be none")
                elif reject_unhashable_component(entry.children[0], kt, "a map key type"):
                    return tid_err
                elif is_error_type(key_type):
                    key_type = kt
                elif is_error_type(kt) == false:
                    if kt != key_type:
                        report_error_at(entry.children[0], "E223", "map keys must be the same type")
                if is_none_type(vt):
                    saw_none_value = true
                elif is_error_type(val_type):
                    val_type = vt
                elif is_error_type(vt) == false:
                    if vt != val_type and types_structurally_equal(vt, val_type) == false:
                        report_error_at(entry.children[1], "E223", "map values must be the same type")
    if is_error_type(key_type):
        return tid_err
    if saw_none_value:
        return intern_map_type(key_type, element_type_with_none(val_type))
    if is_error_type(val_type):
        return tid_err
    return intern_map_type(key_type, val_type)

fn check_set_expression(node: Node, scope_id: Int) -> Int:
    # sets look like {a, b, c} — distinguish from map by no entries
    tid_err := lookup_type_id("<error>")
    if node.children.len() == 0:
        return tid_err
    mut elem_type := tid_err
    for child in node.children:
        t := c_check_expr(child, scope_id)
        if is_none_type(t):
            # a set element is hashed and compared; the empty case of an
            # optional is not a member.
            report_error_at(child, "E223", "set element cannot be none")
        elif reject_unhashable_component(child, t, "a set element type"):
            return tid_err
        elif is_error_type(elem_type):
            elem_type = t
        elif is_error_type(t) == false:
            if t != elem_type and types_structurally_equal(t, elem_type) == false:
                report_error_at(child, "E223", "set elements must be the same type")
    if is_error_type(elem_type):
        return tid_err
    return intern_set_type(elem_type)

# a bare `none` element carries TID_NONE, which the structural comparison
# accepts against a declared `T?` element and rejects against every other.
fn check_tuple_expression(node: Node, scope_id: Int) -> Int:
    mut elems: List[Int] := []
    for child in node.children:
        elems.push(c_check_expr(child, scope_id))
    return add_type_info(ti_tuple(elems))

fn check_struct_initialization(node: Node, scope_id: Int) -> Int:
    # node.value contains the struct type name
    struct_name := node.value
    struct_tid := lookup_type_id(struct_name)
    if struct_tid < 0:
        report_error("E202", "unknown type: " + struct_name)
        return TID_ERR

    # get struct info
    info := get_type_info(struct_tid)
    if info.kind != "struct":
        report_error("E202", struct_name + " is not a struct type")
        return TID_ERR

    # check field count
    if node.children.len() > info.fields.len():
        report_error("E207", struct_name + " expects at most " + info.fields.len().to_string() + " fields, got " + node.children.len().to_string())
        return TID_ERR
    min_required := struct_min_required_fields(struct_name, info)
    if node.children.len() < min_required:
        report_error("E207", struct_name + " expects at least " + min_required.to_string() + " fields, got " + node.children.len().to_string())
        return TID_ERR

    # check each field type
    mut idx := 0
    for child in node.children:
        arg_type := c_check_expr(child, scope_id)
        if is_error_type(arg_type) == false:
            if idx < info.field_types.len():
                expected := info.field_types[idx]
                if optional_target_accepts_value(child, arg_type, expected) == false:
                    if collection_literal_matches_target(child, expected, scope_id) == false:
                        if types_compatible(arg_type, expected) == false:
                            report_error_at(child, "E219", "field '" + info.fields[idx] + "' type mismatch: expected " + get_type_name(expected) + ", got " + get_type_name(arg_type))
        idx = idx + 1

    return struct_tid

# ---------------------------------------------------------------
# spawn/await
# ---------------------------------------------------------------

fn check_spawn_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        report_error("E232", "spawn requires a function call")
        return TID_ERR
    inner_node := get_node(node.children[0])
    if inner_node.kind != "call":
        report_error("E232", "spawn requires a function call")
        return TID_ERR
    inner := c_check_expr(node.children[0], scope_id)
    if is_error_type(inner):
        return TID_ERR
    check_spawn_shared_collections(inner_node)
    return add_type_info(ti_task(inner))

# a spawned task runs on its own os thread. reference counts are atomic,
# but a list, map, or set is an unsynchronized buffer behind a handle,
# so handing one that this scope still holds to a task lets both threads
# mutate the same buffer. a fresh collection (a literal, a copy, a call
# result) is not shared and is fine — that is also the escape hatch. a
# value meant to cross tasks belongs in a channel or an atomic cell.
fn check_spawn_shared_collections(call_node: Node):
    for child, i in call_node.children:
        if i == 0:
            continue
        mut expr_idx := child
        arg_node := get_node(child)
        if arg_node.kind == "arg" and arg_node.children.len() > 0:
            expr_idx = arg_node.children[0]
        if spawn_arg_shares_collection(expr_idx):
            kind := get_type_info(c_get_expr_type(expr_idx)).kind
            report_error_with_fix_at(expr_idx, "E248", "a spawned task cannot take a " + kind + " this scope still holds; both threads would mutate the same buffer", "send it through a channel, or pass a copy (copy_" + kind + ")")

# true when the argument names a collection some other scope keeps a
# handle to: a variable, a struct field, or a container element. fresh
# collections (literals, copies, call results) transfer cleanly.
fn spawn_arg_shares_collection(expr_idx: Int) -> Bool:
    node := get_node(expr_idx)
    if node.kind != "ident" and node.kind != "field_access" and node.kind != "index":
        return false
    tid := c_get_expr_type(expr_idx)
    if tid < 0:
        return false
    kind := get_type_info(tid).kind
    return kind == "list" or kind == "map" or kind == "set"

fn check_await_expression(node: Node, scope_id: Int) -> Int:
    if node.children.len() < 1:
        report_error("E232", "await requires a Task expression")
        return TID_ERR
    inner := c_check_expr(node.children[0], scope_id)
    if is_error_type(inner):
        return TID_ERR
    info := get_type_info(inner)
    if info.kind == "task":
        return info.inner
    report_error("E232", "await requires a Task type, got " + get_type_name(inner))
    return TID_ERR

# ---------------------------------------------------------------
# generic instantiation
# ---------------------------------------------------------------

fn instantiate_generic_type(decl_idx: Int, type_args: List[Int]) -> Int:
    decl := get_node(decl_idx)
    if decl.kind == "struct_decl":
        return instantiate_generic_struct_type(decl_idx, type_args)
    if decl.kind == "enum_decl":
        return instantiate_generic_enum_type(decl_idx, type_args)
    return TID_ERR

fn instantiate_generic_struct_type(decl_idx: Int, type_args: List[Int]) -> Int:
    decl := get_node(decl_idx)
    # the instance is named from the declaration's identity, not from its bare
    # name: with two modules each declaring `Box[T]`, one shared name would
    # hand the second module's instantiation the first module's type id, and
    # one type would answer for both — wrong fields, wrong method bodies. the
    # identity is the bare name in every program without such a clash, so the
    # instance names and the symbols built from them do not move.
    base_name := generic_declaration_identity(decl_idx)
    inst_name := build_instantiated_type_name(base_name, type_args)
    existing := lookup_type_id(inst_name)
    if existing != -1:
        return existing
    generic_params := collect_generic_parameter_names(decl)
    # register the instance under an empty shell before resolving its fields,
    # so a self-referential field (next: Node[T]?) finds this tid by name
    # instead of re-entering this function forever. filled in below.
    mut shell_names: List[String] := []
    mut shell_types: List[Int] := []
    mut shell_bools: List[Bool] := []
    tid := add_type_info(ti_struct(inst_name, shell_names, shell_types, shell_bools, shell_bools))
    register_type_name(inst_name, tid)
    # remember the type-args + base name on the instance tid so dispatch can
    # substitute the struct's type parameters in method signatures
    struct_instance_type_args.insert(tid, encode_tid_list(type_args))
    struct_instance_base_name.insert(tid, base_name)
    struct_instance_tids.push(tid)
    struct_instance_decl_idx.insert(tid, decl_idx)
    mut field_names: List[String] := []
    mut field_types: List[Int] := []
    mut field_pub: List[Bool] := []
    mut field_mut: List[Bool] := []
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "field":
            fname := extract_field_name(cn.value)
            is_pub := cn.value.contains(" pub")
            is_mut := cn.value.contains(" mut")
            field_names.push(fname)
            field_pub.push(is_pub)
            field_mut.push(is_mut)
            if cn.children.len() > 0:
                ftid := resolve_type_with_substitution_map(cn.children[0], generic_params, type_args)
                field_types.push(ftid)
                if cn.children.len() > 1:
                    struct_field_default_nodes.insert(inst_name + "." + fname, cn.children[1])
            else:
                field_types.push(TID_ERR)
    set_type_info(tid, ti_struct(inst_name, field_names, field_types, field_pub, field_mut))
    return tid

fn instantiate_generic_enum_type(decl_idx: Int, type_args: List[Int]) -> Int:
    decl := get_node(decl_idx)
    # named from the declaration's identity for the same reason as the struct
    # path above: two modules' same-named generic enums must not share a tid.
    base_name := generic_declaration_identity(decl_idx)
    inst_name := build_instantiated_type_name(base_name, type_args)
    existing := lookup_type_id(inst_name)
    if existing != -1:
        return existing
    generic_params := collect_generic_parameter_names(decl)
    # same shell-first registration as the struct path: a variant payload can
    # name its own enum (Cons(T, Chain[T]?)), and resolving it before the
    # name exists recurses without a floor.
    mut shell_variants: List[String] := []
    mut shell_variant_types: List[List[Int]] := []
    tid := add_type_info(ti_enum(inst_name, shell_variants, shell_variant_types))
    register_type_name(inst_name, tid)
    mut variant_names: List[String] := []
    mut variant_types: List[List[Int]] := []
    for child in decl.children:
        cn := get_node(child)
        if cn.kind == "variant":
            variant_names.push(cn.value)
            mut vtypes: List[Int] := []
            for vc in cn.children:
                vtypes.push(resolve_type_with_substitution_map(vc, generic_params, type_args))
            variant_types.push(vtypes)
    set_type_info(tid, ti_enum(inst_name, variant_names, variant_types))
    return tid

# ---------------------------------------------------------------
# structural equality
# ---------------------------------------------------------------

fn types_structurally_equal(a: Int, b: Int) -> Bool:
    if a == b:
        return true
    # an error-typed side is a wildcard: either a subexpression whose error was
    # already reported at its own site (comparing again only cascades noise), or
    # the wildcard inner of an untargeted `none` element, which any concrete
    # inner satisfies.
    if is_error_type(a):
        return true
    if is_error_type(b):
        return true
    # `none` is not a wildcard. it names the empty case of an optional and
    # nothing else, so it satisfies an optional target and fails against every
    # concrete type — which is what makes `takes_int(none)` report.
    if is_none_type(a):
        return b >= 0 and get_type_info(b).kind == "optional"
    if is_none_type(b):
        return a >= 0 and get_type_info(a).kind == "optional"
    if a < 0:
        return false
    if b < 0:
        return false
    ai := get_type_info(a)
    bi := get_type_info(b)
    # function type structural equality
    if ai.kind == "function":
        if bi.kind == "function":
            if ai.param_types.len() != bi.param_types.len():
                return false
            for ap, i in ai.param_types:
                if i < bi.param_types.len():
                    if types_structurally_equal(ap, bi.param_types[i]) == false:
                        return false
            if types_structurally_equal(ai.return_type, bi.return_type) == false:
                return false
            return true
    # tuple structural equality
    if ai.kind == "tuple":
        if bi.kind == "tuple":
            if ai.elements.len() != bi.elements.len():
                return false
            for ae, i in ai.elements:
                if i < bi.elements.len():
                    if types_structurally_equal(ae, bi.elements[i]) == false:
                        return false
            return true
    # result structural equality
    if ai.kind == "result":
        if bi.kind == "result":
            if types_structurally_equal(ai.inner, bi.inner) == false:
                return false
            return types_structurally_equal(ai.value_type, bi.value_type)
    # optional structural equality
    if ai.kind == "optional":
        if bi.kind == "optional":
            return types_structurally_equal(ai.inner, bi.inner)
    # list structural equality
    if ai.kind == "list":
        if bi.kind == "list":
            return types_structurally_equal(ai.inner, bi.inner)
    # map structural equality
    if ai.kind == "map":
        if bi.kind == "map":
            if types_structurally_equal(ai.key_type, bi.key_type) == false:
                return false
            return types_structurally_equal(ai.value_type, bi.value_type)
    # set structural equality
    if ai.kind == "set":
        if bi.kind == "set":
            return types_structurally_equal(ai.inner, bi.inner)
    # task structural equality
    if ai.kind == "task":
        if bi.kind == "task":
            return types_structurally_equal(ai.inner, bi.inner)
    # channel structural equality
    if ai.kind == "channel":
        if bi.kind == "channel":
            return types_structurally_equal(ai.inner, bi.inner)
    # struct structural equality
    if ai.kind == "struct":
        if bi.kind == "struct":
            if ai.fields.len() != bi.fields.len():
                return false
            for field_name, i in ai.fields:
                if field_name != bi.fields[i]:
                    return false
                if types_structurally_equal(ai.field_types[i], bi.field_types[i]) == false:
                    return false
            return true
    # enum structural equality
    if ai.kind == "enum":
        if bi.kind == "enum":
            if ai.variants.len() != bi.variants.len():
                return false
            for variant_name, i in ai.variants:
                if variant_name != bi.variants[i]:
                    return false
                # compare variant field types
                if ai.variant_types[i].len() != bi.variant_types[i].len():
                    return false
                for field_type, j in ai.variant_types[i]:
                    if types_structurally_equal(field_type, bi.variant_types[i][j]) == false:
                        return false
            return true
    return false

fn types_compatible(actual: Int, expected: Int) -> Bool:
    if actual == expected:
        return true
    return types_structurally_equal(actual, expected)

# ---------------------------------------------------------------
# public API — run checker and return diagnostics as JSON
# ---------------------------------------------------------------

# check one parsed file end to end: initialize, register declarations,
# then check bodies, and hand back everything that was reported. this is
# the single-file path — it re-initializes on entry, so it cannot be
# used to check a program spread across modules, and imported names go
# unresolved because pass 1 skips import nodes. for a multi-module run
# call initialize_checker once and drive c_run_module per module.
# an empty list means the file checked clean.
pub fn c_run(root_idx: Int, file_path: String) -> List[Diagnostic]:
    initialize_checker(file_path)
    process_import_aliases(root_idx)
    snapshot_module_context(root_idx)
    c_register_all(root_idx)
    c_check_all(root_idx)
    drain_generic_body_worklist()
    return checker_get_diagnostics()

# run checker passes on a single module without re-initializing.
# call initialize_checker() once, then c_run_module() for each module in order.
pub fn c_run_module(root_idx: Int) -> List[Diagnostic]:
    saved_aliases := copy_string_map(module_aliases)
    process_import_aliases(root_idx)
    snapshot_module_context(root_idx)
    c_register_all(root_idx)
    c_check_all(root_idx)
    drain_generic_body_worklist()
    module_aliases = saved_aliases
    return checker_get_diagnostics()

# ---------------------------------------------------------------
# generic bodies, walked per specialization
# ---------------------------------------------------------------
#
# pass 2 skips a generic body: it has no concrete types until something
# instantiates it. the functions below walk those bodies afterwards, once
# per distinct set of concrete types the program asks for, with the type
# parameters resolving to those types. a call site records the types it
# settled (generic_call_subst) and queues the pair; a method call on a
# generic struct instance queues that method against that instance; the
# queue is drained at the end of each module's check, and a walk that meets
# another generic call queues that one too. the emitter asks for the same walk
# again, silently, just before it emits each specialization, so the
# expression types it reads for that body are the ones for the types it is
# emitting. see docs/generics.md.

# the module a declaration was registered from, or "" for the root file.
fn declaration_module(decl_idx: Int) -> String:
    if generic_declaration_modules.contains_key(decl_idx):
        return generic_declaration_modules[decl_idx]
    if impl_method_modules.contains_key(decl_idx):
        return impl_method_modules[decl_idx]
    return ""

# record what a later walk of this module's generic bodies needs: its root,
# its file, and its import aliases as they stand once the imports are
# processed.
fn snapshot_module_context(root_idx: Int):
    checker_module_roots.insert(current_checker_module_path, root_idx)
    checker_module_files.insert(current_checker_module_path, checker_current_file_path())
    mut entries: List[String] := []
    for alias in module_aliases.keys():
        entries.push(alias + "=" + module_aliases[alias])
    checker_module_alias_lists.insert(current_checker_module_path, entries.join(chr(9)))

# make `module_path` the module being checked — its scoped lookups, imports,
# diagnostic file stamp and global names — from the snapshot taken when it
# was checked, and answer the module that was current so the caller can put
# it back the same way. process_import_aliases is not re-run: it appends to
# lists that accumulate over the whole run.
#
# the snapshot is installed even when the path already matches: c_run_module
# puts the caller's alias table back when a module's run ends, so a walk that
# starts after the run (the emitter re-checking a specialization) finds the
# module current but its aliases gone, and every `mod.Thing` in the body then
# resolves to nothing.
fn enter_module_context(module_path: String) -> String:
    prev := current_checker_module_path
    current_checker_module_path = module_path
    set_defining_module(module_path)
    mut aliases: Map[String, String] := {}
    if checker_module_alias_lists.contains_key(module_path):
        for entry in checker_module_alias_lists[module_path].split(chr(9)):
            pair := entry.split("=")
            if pair.len() == 2:
                aliases.insert(pair[0], pair[1])
    module_aliases = aliases
    if checker_module_files.contains_key(module_path):
        checker_set_file_path(checker_module_files[module_path])
    if checker_module_roots.contains_key(module_path):
        collect_module_global_names(checker_module_roots[module_path])
    return prev

# " in first[Int]": the specialization a report inside a generic body was
# found at.
fn specialization_suffix(name: String, tids: List[Int]) -> String:
    mut names: List[String] := []
    for t in tids:
        names.push(get_type_name(t))
    return " in " + name + "[" + names.join(", ") + "]"

# the type arguments of the receiver's generic instance, when `self_tid` is
# one, followed by a generic method's own; the method's alone otherwise.
fn owner_and_method_type_args(self_tid: Int, method_tids: List[Int]) -> List[Int]:
    mut combined: List[Int] := []
    if struct_instance_type_args.contains_key(self_tid):
        combined = decode_tid_list(struct_instance_type_args[self_tid])
    for t in method_tids:
        combined.push(t)
    return combined

# record the type arguments settled for the generic call being checked,
# keyed by the call node, for the emitter to read back.
fn record_generic_call_subst(tids: List[Int]):
    node_idx := checker_current_node_index()
    if node_idx >= 0:
        generic_call_subst.insert(node_idx, encode_tid_list(tids))

## the type arguments recorded for the generic call at `node_idx` by the
## most recent check of that node, or an empty list when none was.
pub fn c_generic_call_subst(node_idx: Int) -> List[Int]:
    if generic_call_subst.contains_key(node_idx):
        return decode_tid_list(generic_call_subst[node_idx])
    mut empty: List[Int] := []
    return empty

# queue a generic function's body, or a generic method's on a concrete
# owner, for a walk against `tids`. `self_tid` is the owner for a method and
# -1 for a free function. a type set with an unresolved member is not
# queued: the call site reported it already, and the walk would only repeat
# the report against the error type.
fn queue_function_specialization(decl_idx: Int, self_tid: Int, tids: List[Int]):
    if generic_body_check_mode == "off" or decl_idx < 0:
        return
    for t in tids:
        if t < 0 or is_error_type(t):
            return
    entry := "F" + chr(9) + decl_idx.to_string() + chr(9) + self_tid.to_string() + chr(9) + encode_tid_list(tids)
    if generic_body_checked.contains_key(entry) or generic_body_queued.contains_key(entry):
        return
    mut count := 0
    if generic_body_spec_counts.contains_key(decl_idx):
        count = generic_body_spec_counts[decl_idx]
    if count >= generic_body_spec_limit:
        if count == generic_body_spec_limit:
            report_error_at(decl_idx, "E267", "'" + get_node(decl_idx).value + "' is instantiated at more than " + generic_body_spec_limit.to_string() + " distinct type sets; a generic that calls itself at a larger type never stops")
            generic_body_spec_counts.insert(decl_idx, count + 1)
        return
    generic_body_spec_counts.insert(decl_idx, count + 1)
    generic_body_queued.insert(entry, true)
    generic_body_worklist.push(entry)

# queue a plain method of a generic struct for a walk against one instance.
fn queue_method_specialization(method_idx: Int, inst_tid: Int):
    if generic_body_check_mode == "off" or method_idx < 0 or inst_tid < 0:
        return
    entry := "M" + chr(9) + method_idx.to_string() + chr(9) + inst_tid.to_string()
    if generic_body_checked.contains_key(entry) or generic_body_queued.contains_key(entry):
        return
    generic_body_queued.insert(entry, true)
    generic_body_worklist.push(entry)

# a method call whose receiver is a generic struct instance: queue the
# method's body against that instance. the pairs walked are the ones the
# program dispatches, not every method of every instance — a method that is
# never called at some instance (`size()` on a `Holder[Int?]` the program
# only ever builds) is not a fault of the program, and would be reported as
# one otherwise. a method with type parameters of its own goes through
# queue_function_specialization from the same call.
fn queue_dispatched_method(method_idx: Int, receiver_tid: Int):
    if struct_instance_decl_idx.contains_key(receiver_tid) == false:
        return
    if declaration_has_generic_params(get_node(method_idx)):
        return
    queue_method_specialization(method_idx, receiver_tid)

# walk one body with `self` (when given) and the parameters bound to the
# types handed in: the shape of check_function_declaration and
# check_method_body, minus the signature resolution they do themselves.
fn walk_specialized_body(decl_idx: Int, decl_node: Node, self_tid: Int, param_types: List[Int], ret_type: Int):
    fn_scope := create_function_scope(current_scope, ret_type)
    reset_fn_weak_tracking()
    if self_tid >= 0:
        define_binding_at(fn_scope, "self", self_tid, false, decl_idx)
    mut param_idx := 0
    for child in decl_node.children:
        cn := get_node(child)
        if cn.kind == "param":
            pname := extract_binding_name(cn.value)
            if param_idx < param_types.len():
                define_binding_at(fn_scope, pname, param_types[param_idx], cn.value.contains("mut"), child)
            note_fn_binding_name(pname, child)
            param_idx = param_idx + 1
        elif cn.kind == "body":
            check_function_body(child, fn_scope)

## walk a generic function's body, or a generic method's, with the method's
## own type parameters resolving to `concrete_tids`. `self_tid` is the owner
## for a method and -1 for a free function; when the owner is an instance of
## a generic struct (`Box[Int].map[String]`) the struct's parameters and
## associated types resolve to that instance's ahead of the method's own, so
## the body is walked once per combination of the two lists. with `report`
## false nothing is recorded: the emitter walks this way to have the
## expression types for the body it is about to emit, after the check pass
## reported already.
pub fn c_check_specialization(decl_idx: Int, self_tid: Int, concrete_tids: List[Int], report: Bool):
    if decl_idx < 0:
        return
    decl_node := get_node(decl_idx)
    if decl_node.kind != "fn_decl":
        return
    method_params := collect_generic_parameter_names(decl_node)
    if method_params.len() != concrete_tids.len():
        return
    for t in concrete_tids:
        if t < 0 or is_error_type(t):
            return
    mut params: List[String] := []
    mut args: List[Int] := []
    mut suffix := specialization_suffix(decl_node.value, concrete_tids)
    mut assoc: Map[String, Int] := {}
    if struct_instance_decl_idx.contains_key(self_tid) and struct_instance_base_name.contains_key(self_tid):
        base := struct_instance_base_name[self_tid]
        params = collect_generic_parameter_names(get_node(struct_instance_decl_idx[self_tid]))
        args = decode_tid_list(struct_instance_type_args[self_tid])
        if params.len() != args.len():
            return
        assoc = instance_assoc_bindings(base, params, args)
        suffix = " in " + get_type_name(self_tid) + "." + suffix.substring(4, suffix.len())
    for mp in method_params:
        params.push(mp)
    for t in concrete_tids:
        args.push(t)
    mut prev_reporting := true
    if report == false:
        prev_reporting = checker_set_reporting(false)
    prev_module := enter_module_context(declaration_module(decl_idx))
    prev_suffix := checker_set_message_suffix(suffix)
    saved_assoc := active_assoc_bindings
    if assoc.len() > 0:
        active_assoc_bindings = assoc
    saved_params := active_subst_params
    saved_args := active_subst_args
    active_subst_params = params
    active_subst_args = args
    param_types := collect_function_param_types_with_subst(decl_node, params, args)
    ret_type := collect_function_return_type_with_subst(decl_node, params, args)
    walk_specialized_body(decl_idx, decl_node, self_tid, param_types, ret_type)
    active_subst_params = saved_params
    active_subst_args = saved_args
    active_assoc_bindings = saved_assoc
    checker_set_message_suffix(prev_suffix)
    enter_module_context(prev_module)
    if report == false:
        checker_set_reporting(prev_reporting)

# the associated-type bindings of `base`'s impl, resolved through one
# instance's type arguments (`Item -> Int` on a `Holder[Int]`).
fn instance_assoc_bindings(base: String, params: List[String], args: List[Int]) -> Map[String, Int]:
    mut bindings: Map[String, Int] := {}
    if type_assoc_names.contains_key(base):
        for an in type_assoc_names[base].split(","):
            bkey := base + "." + an
            if assoc_type_binding_node.contains_key(bkey):
                bindings.insert(an, resolve_type_with_substitution_map(assoc_type_binding_node[bkey], params, args))
    return bindings

## walk a plain method of a generic struct against one instance of it, with
## the struct's type parameters and associated types resolving to the
## instance's. `report` as in c_check_specialization.
pub fn c_check_method_specialization(method_idx: Int, inst_tid: Int, report: Bool):
    if method_idx < 0 or inst_tid < 0:
        return
    method_node := get_node(method_idx)
    if method_node.kind != "fn_decl":
        return
    if struct_instance_decl_idx.contains_key(inst_tid) == false:
        return
    if struct_instance_base_name.contains_key(inst_tid) == false:
        return
    base := struct_instance_base_name[inst_tid]
    sdecl := get_node(struct_instance_decl_idx[inst_tid])
    params := collect_generic_parameter_names(sdecl)
    args := decode_tid_list(struct_instance_type_args[inst_tid])
    if params.len() != args.len():
        return
    mut prev_reporting := true
    if report == false:
        prev_reporting = checker_set_reporting(false)
    prev_module := enter_module_context(declaration_module(method_idx))
    prev_suffix := checker_set_message_suffix(" in " + get_type_name(inst_tid) + "." + method_node.value)
    saved_assoc := active_assoc_bindings
    active_assoc_bindings = instance_assoc_bindings(base, params, args)
    saved_params := active_subst_params
    saved_args := active_subst_args
    active_subst_params = params
    active_subst_args = args
    param_types := collect_function_param_types_with_subst(method_node, params, args)
    ret_type := collect_function_return_type_with_subst(method_node, params, args)
    walk_specialized_body(method_idx, method_node, inst_tid, param_types, ret_type)
    active_subst_params = saved_params
    active_subst_args = saved_args
    active_assoc_bindings = saved_assoc
    checker_set_message_suffix(prev_suffix)
    enter_module_context(prev_module)
    if report == false:
        checker_set_reporting(prev_reporting)

## walk a method body once more against `self_tid`: an interface default
## inherited by several types is checked once per implementing type, and
## the emitter asks for the walk again before each per-type copy it emits.
## `report` as in c_check_specialization.
pub fn c_check_method_body_for(method_idx: Int, self_tid: Int, report: Bool):
    if method_idx < 0 or self_tid < 0:
        return
    method_node := get_node(method_idx)
    if method_node.kind != "fn_decl":
        return
    mut prev_reporting := true
    if report == false:
        prev_reporting = checker_set_reporting(false)
    prev_module := enter_module_context(declaration_module(method_idx))
    check_method_body(get_type_name(self_tid), self_tid, method_idx, method_node)
    enter_module_context(prev_module)
    if report == false:
        checker_set_reporting(prev_reporting)

# one queued entry, in either of the two spellings generic_body_worklist
# describes.
fn check_worklist_entry(entry: String):
    parts := entry.split(chr(9))
    if parts.len() >= 4 and parts[0] == "F":
        c_check_specialization(parse_integer_string(parts[1]), parse_integer_string(parts[2]), decode_tid_list(parts[3]), true)
    elif parts.len() >= 3 and parts[0] == "M":
        c_check_method_specialization(parse_integer_string(parts[1]), parse_integer_string(parts[2]), true)

# walk every queued body, and whatever those walks queue, until the queue
# is empty. the expression-type cache is swapped out for the duration: what
# a walk writes there is one specialization's answer for nodes the emitter
# reads only after asking for its own walk, and pass 2's entries for the
# concrete code must not be disturbed. definition_of is left alone on
# purpose, so go-to-definition works inside a generic body.
fn drain_generic_body_worklist():
    if generic_body_check_mode == "off":
        return
    saved_cache := expression_type_cache
    expression_type_cache = {}
    prev_reporting := checker_set_reporting(generic_body_check_mode != "silent")
    mut prev_severity := ""
    if generic_body_check_mode == "count":
        prev_severity = checker_set_severity_override("warning")
    checker_begin_dedup()
    mut i := 0
    while i < generic_body_worklist.len():
        entry := generic_body_worklist[i]
        i = i + 1
        if generic_body_checked.contains_key(entry) == false:
            generic_body_checked.insert(entry, true)
            check_worklist_entry(entry)
    generic_body_worklist = []
    generic_body_queued = {}
    checker_end_dedup()
    if generic_body_check_mode == "count":
        checker_set_severity_override(prev_severity)
    checker_set_reporting(prev_reporting)
    expression_type_cache = saved_cache

# render diagnostics as the machine-readable JSON array editors and
# tests consume: one object per diagnostic, in the order they were
# reported, with a trailing newline. nothing is filtered — warnings come
# through alongside errors, told apart by each object's "severity"
# field. this only re-exports errors.render_diagnostics_json so a caller
# that already imports the checker needs no second import.
pub fn c_diagnostics_to_json(diags: List[Diagnostic]) -> String:
    return render_diagnostics_json(diags)

# ---------------------------------------------------------------
# snapshots — every table copied, for a run that resumes from it
# ---------------------------------------------------------------
#
# a long-lived tool that checks the same import closure over and over
# (the language server, once per keystroke) takes a snapshot after the
# imported modules are checked and restores it before checking the
# edited file, so the imports are registered and checked once rather
# than once per edit. correctness rests on the snapshot being complete:
# a table missing here would carry the previous edit's entries into the
# next run and answer with stale types. every `mut` in this module and
# the modules it delegates to is listed, transients included, so the
# restored state is the checked-imports state exactly.

# the checker's whole state at one moment. tables are copied one level
# down: the records they hold (TypeInfo, ScopeEntry, Diagnostic) are
# never mutated in place, so sharing them is safe.
pub struct CheckerSnapshot:
    pub types: TypeTableSnapshot
    pub scopes: ScopeSnapshot
    pub diagnostics: DiagnosticsSnapshot
    pub methods: MethodsSnapshot
    pub interfaces: List[String]
    pub builtin_scope: Int
    pub module_aliases: Map[String, String]
    pub module_export_entries: List[String]
    pub wildcard_imports: List[String]
    pub generic_named_import_entries: List[String]
    pub generic_wildcard_import_entries: List[String]
    pub current_checker_module_path: String
    pub checked_module_paths: Map[String, Bool]
    pub generic_inference_subst: Map[String, Int]
    pub last_branch_value_expr: Int
    pub active_subst_params: List[String]
    pub active_subst_args: List[Int]
    pub generic_call_subst: Map[Int, String]
    pub generic_body_worklist: List[String]
    pub generic_body_queued: Map[String, Bool]
    pub generic_body_checked: Map[String, Bool]
    pub generic_body_spec_counts: Map[Int, Int]
    pub struct_instance_decl_idx: Map[Int, Int]
    pub impl_method_modules: Map[Int, String]
    pub checker_module_roots: Map[String, Int]
    pub checker_module_files: Map[String, String]
    pub checker_module_alias_lists: Map[String, String]
    pub generic_body_check_mode: String
    pub current_scope: Int
    pub method_type_map: Map[String, Int]
    pub method_declared_kinds: Map[String, Bool]
    pub method_visibility_map: Map[String, Bool]
    pub function_visibility_map: Map[String, Bool]
    pub struct_field_default_nodes: Map[String, Int]
    pub generic_declaration_map: Map[String, Int]
    pub generic_declaration_names: List[String]
    pub generic_base_first_module: Map[String, String]
    pub ambiguous_generic_bases: Map[String, Bool]
    pub generic_identity_bare_names: Map[String, String]
    pub generic_declaration_modules: Map[Int, String]
    pub checking_test_decl: Bool
    pub implementation_set: Map[String, Int]
    pub interface_decl_index: Map[String, Int]
    pub interface_assoc_types: Map[String, String]
    pub assoc_type_binding: Map[String, Int]
    pub assoc_type_binding_node: Map[String, Int]
    pub type_assoc_names: Map[String, String]
    pub active_assoc_bindings: Map[String, Int]
    pub impl_interface_args: Map[String, String]
    pub struct_instance_type_args: Map[Int, String]
    pub struct_instance_base_name: Map[Int, String]
    pub struct_instance_tids: List[Int]
    pub suppress_unknown_type_for: Map[String, Int]
    pub expression_type_cache: Map[Int, Int]
    pub definition_of: Map[Int, Int]
    pub optional_widened_arguments: Map[Int, Bool]
    pub open_empty_literal_bindings: Map[Int, Int]
    pub type_resolve_depth: Int
    pub c_module_global_names: List[String]
    pub c_shadow_seen_names: List[String]
    pub fn_bound_names: List[String]
    pub fn_weak_names: List[String]
    pub checker_lambda_depth: Int
    pub lambda_inferred_return: Int

# copy the checker's state out. the live state keeps changing
# afterwards; the snapshot does not.
pub fn take_checker_snapshot() -> CheckerSnapshot:
    return CheckerSnapshot(
        types: take_type_table_snapshot(),
        scopes: take_scope_snapshot(),
        diagnostics: take_diagnostics_snapshot(),
        methods: take_methods_snapshot(),
        interfaces: take_interfaces_snapshot(),
        builtin_scope: builtin_scope_id(),
        module_aliases: copy_map(module_aliases),
        module_export_entries: copy_list(module_export_entries),
        wildcard_imports: copy_list(wildcard_imports),
        generic_named_import_entries: copy_list(generic_named_import_entries),
        generic_wildcard_import_entries: copy_list(generic_wildcard_import_entries),
        current_checker_module_path: current_checker_module_path,
        checked_module_paths: copy_map(checked_module_paths),
        generic_inference_subst: copy_map(generic_inference_subst),
        last_branch_value_expr: last_branch_value_expr,
        active_subst_params: copy_list(active_subst_params),
        active_subst_args: copy_list(active_subst_args),
        generic_call_subst: copy_map(generic_call_subst),
        generic_body_worklist: copy_list(generic_body_worklist),
        generic_body_queued: copy_map(generic_body_queued),
        generic_body_checked: copy_map(generic_body_checked),
        generic_body_spec_counts: copy_map(generic_body_spec_counts),
        struct_instance_decl_idx: copy_map(struct_instance_decl_idx),
        impl_method_modules: copy_map(impl_method_modules),
        checker_module_roots: copy_map(checker_module_roots),
        checker_module_files: copy_map(checker_module_files),
        checker_module_alias_lists: copy_map(checker_module_alias_lists),
        generic_body_check_mode: generic_body_check_mode,
        current_scope: current_scope,
        method_type_map: copy_map(method_type_map),
        method_declared_kinds: copy_map(method_declared_kinds),
        method_visibility_map: copy_map(method_visibility_map),
        function_visibility_map: copy_map(function_visibility_map),
        struct_field_default_nodes: copy_map(struct_field_default_nodes),
        generic_declaration_map: copy_map(generic_declaration_map),
        generic_declaration_names: copy_list(generic_declaration_names),
        generic_base_first_module: copy_map(generic_base_first_module),
        ambiguous_generic_bases: copy_map(ambiguous_generic_bases),
        generic_identity_bare_names: copy_map(generic_identity_bare_names),
        generic_declaration_modules: copy_map(generic_declaration_modules),
        checking_test_decl: checking_test_decl,
        implementation_set: copy_map(implementation_set),
        interface_decl_index: copy_map(interface_decl_index),
        interface_assoc_types: copy_map(interface_assoc_types),
        assoc_type_binding: copy_map(assoc_type_binding),
        assoc_type_binding_node: copy_map(assoc_type_binding_node),
        type_assoc_names: copy_map(type_assoc_names),
        active_assoc_bindings: copy_map(active_assoc_bindings),
        impl_interface_args: copy_map(impl_interface_args),
        struct_instance_type_args: copy_map(struct_instance_type_args),
        struct_instance_base_name: copy_map(struct_instance_base_name),
        struct_instance_tids: copy_list(struct_instance_tids),
        suppress_unknown_type_for: copy_map(suppress_unknown_type_for),
        expression_type_cache: copy_map(expression_type_cache),
        definition_of: copy_map(definition_of),
        optional_widened_arguments: copy_map(optional_widened_arguments),
        open_empty_literal_bindings: copy_map(open_empty_literal_bindings),
        type_resolve_depth: type_resolve_depth,
        c_module_global_names: copy_list(c_module_global_names),
        c_shadow_seen_names: copy_list(c_shadow_seen_names),
        fn_bound_names: copy_list(fn_bound_names),
        fn_weak_names: copy_list(fn_weak_names),
        checker_lambda_depth: checker_lambda_depth,
        lambda_inferred_return: lambda_inferred_return)

# make the live state a copy of the snapshot, leaving the snapshot as
# it was so it can be restored again after the next run.
pub fn restore_checker_snapshot(s: CheckerSnapshot):
    restore_type_table_snapshot(s.types)
    restore_scope_snapshot(s.scopes)
    restore_diagnostics_snapshot(s.diagnostics)
    restore_methods_snapshot(s.methods)
    restore_interfaces_snapshot(s.interfaces)
    set_builtin_scope_id(s.builtin_scope)
    module_aliases = copy_map(s.module_aliases)
    module_export_entries = copy_list(s.module_export_entries)
    wildcard_imports = copy_list(s.wildcard_imports)
    generic_named_import_entries = copy_list(s.generic_named_import_entries)
    generic_wildcard_import_entries = copy_list(s.generic_wildcard_import_entries)
    current_checker_module_path = s.current_checker_module_path
    checked_module_paths = copy_map(s.checked_module_paths)
    generic_inference_subst = copy_map(s.generic_inference_subst)
    last_branch_value_expr = s.last_branch_value_expr
    active_subst_params = copy_list(s.active_subst_params)
    active_subst_args = copy_list(s.active_subst_args)
    generic_call_subst = copy_map(s.generic_call_subst)
    generic_body_worklist = copy_list(s.generic_body_worklist)
    generic_body_queued = copy_map(s.generic_body_queued)
    generic_body_checked = copy_map(s.generic_body_checked)
    generic_body_spec_counts = copy_map(s.generic_body_spec_counts)
    struct_instance_decl_idx = copy_map(s.struct_instance_decl_idx)
    impl_method_modules = copy_map(s.impl_method_modules)
    checker_module_roots = copy_map(s.checker_module_roots)
    checker_module_files = copy_map(s.checker_module_files)
    checker_module_alias_lists = copy_map(s.checker_module_alias_lists)
    generic_body_check_mode = s.generic_body_check_mode
    current_scope = s.current_scope
    method_type_map = copy_map(s.method_type_map)
    method_declared_kinds = copy_map(s.method_declared_kinds)
    method_visibility_map = copy_map(s.method_visibility_map)
    function_visibility_map = copy_map(s.function_visibility_map)
    struct_field_default_nodes = copy_map(s.struct_field_default_nodes)
    generic_declaration_map = copy_map(s.generic_declaration_map)
    generic_declaration_names = copy_list(s.generic_declaration_names)
    generic_base_first_module = copy_map(s.generic_base_first_module)
    ambiguous_generic_bases = copy_map(s.ambiguous_generic_bases)
    generic_identity_bare_names = copy_map(s.generic_identity_bare_names)
    generic_declaration_modules = copy_map(s.generic_declaration_modules)
    checking_test_decl = s.checking_test_decl
    implementation_set = copy_map(s.implementation_set)
    interface_decl_index = copy_map(s.interface_decl_index)
    interface_assoc_types = copy_map(s.interface_assoc_types)
    assoc_type_binding = copy_map(s.assoc_type_binding)
    assoc_type_binding_node = copy_map(s.assoc_type_binding_node)
    type_assoc_names = copy_map(s.type_assoc_names)
    active_assoc_bindings = copy_map(s.active_assoc_bindings)
    impl_interface_args = copy_map(s.impl_interface_args)
    struct_instance_type_args = copy_map(s.struct_instance_type_args)
    struct_instance_base_name = copy_map(s.struct_instance_base_name)
    struct_instance_tids = copy_list(s.struct_instance_tids)
    suppress_unknown_type_for = copy_map(s.suppress_unknown_type_for)
    expression_type_cache = copy_map(s.expression_type_cache)
    definition_of = copy_map(s.definition_of)
    optional_widened_arguments = copy_map(s.optional_widened_arguments)
    open_empty_literal_bindings = copy_map(s.open_empty_literal_bindings)
    type_resolve_depth = s.type_resolve_depth
    c_module_global_names = copy_list(s.c_module_global_names)
    c_shadow_seen_names = copy_list(s.c_shadow_seen_names)
    fn_bound_names = copy_list(s.fn_bound_names)
    fn_weak_names = copy_list(s.fn_weak_names)
    checker_lambda_depth = s.checker_lambda_depth
    lambda_inferred_return = s.lambda_inferred_return
