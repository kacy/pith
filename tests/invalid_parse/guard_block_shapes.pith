# a module guard block holds only private `mut` globals, a sharded guard
# needs a count, and a struct guard is one mutex per value.
guard a_mu:
    mut ok: Int := 0
    pub mut exported: Int := 0
    fixed := 3

guard b_mu[0]:
    mut none_here: Int := 0

struct Pool:
    guard pick[4]:
        next: Int

fn main():
    print("x")
