# std.mysql — a pure-pith mysql/mariadb client (protocol version 10).
#
# connect with host/port/user/password/database, run a query, and iterate the
# rows as std.sql values:
#
#   conn := mysql.connect("127.0.0.1", 3306, "me", "pw", "mydb")!
#   for row in mysql.query(conn, "select id, name from users")!:
#       print("{row.as_int(0)} {row.as_text(1)}")
#   conn.close()
#
# authentication is mysql_native_password (the SHA-1 scramble). queries use the
# text protocol, so values arrive as strings and are decoded by column type.

import std.sql as sql
import std.bytes as bytes
import std.bits as bits
import std.hash as hash
import std.encoding as encoding
import std.net.tls as tls
from std.io import TcpStream
from std.iter import Iterator

# --- byte helpers (mysql is little-endian) ---

# an n-byte little-endian integer.
fn le_int(value: Int, width: Int) -> Bytes:
    out := bytes.buffer()
    mut i := 0
    while i < width:
        out.write_byte(bits.band(bits.shr(value, i * 8), 255)) catch 0
        i = i + 1
    result := out.bytes()
    out.free()
    return result

# xor two equal-length byte strings.
fn xor_bytes(a: Bytes, b: Bytes) -> Bytes:
    out := bytes.buffer()
    mut i := 0
    while i < bytes.len(a):
        out.write_byte(bits.xor(bytes.get(a, i), bytes.get(b, i))) catch 0
        i = i + 1
    result := out.bytes()
    out.free()
    return result

# a cursor over a packet payload; mysql packs everything little-endian with
# length-encoded integers and strings, so a small stateful reader keeps the
# parsing readable.
struct Reader:
    data: Bytes
    mut pos: Int

impl Reader:
    fn u8() -> Int:
        v := bytes.get(self.data, self.pos)
        self.pos = self.pos + 1
        return v

    fn le(width: Int) -> Int:
        mut value := 0
        mut i := 0
        while i < width:
            value = bits.bor(value, bits.shl(bytes.get(self.data, self.pos + i), i * 8))
            i = i + 1
        self.pos = self.pos + width
        return value

    fn skip(n: Int):
        self.pos = self.pos + n

    # a length-encoded integer.
    fn lenenc() -> Int:
        first := self.u8()
        if first < 251:
            return first
        if first == 252:
            return self.le(2)
        if first == 253:
            return self.le(3)
        if first == 254:
            return self.le(8)
        return 0

    # a length-encoded string.
    fn lenenc_str() -> String!:
        n := self.lenenc()
        s := bytes.to_string_utf8(bytes.slice(self.data, self.pos, self.pos + n))!
        self.pos = self.pos + n
        return s

    # a null-terminated string.
    fn cstring() -> String!:
        start := self.pos
        while bytes.get(self.data, self.pos) != 0:
            self.pos = self.pos + 1
        s := bytes.to_string_utf8(bytes.slice(self.data, start, self.pos))!
        self.pos = self.pos + 1
        return s

# --- connection ---

# an open connection to a mysql/mariadb server; `buf` holds bytes read past
# the current packet.
pub struct Conn:
    fd: Int
    mut buf: Bytes
    mut pos: Int
    mut secure: Bool
    mut tls_handle: Int
    mut last_seq: Int

impl Conn:
    # read one chunk from the transport: the tls session when secure, the plain
    # socket otherwise.
    fn recv_chunk() -> Bytes!:
        if self.secure:
            return tls.conn_from_handle(self.tls_handle).read_bytes(4096)!
        return tcp_read_bytes(self.fd, 4096)!

    fn recv_exact(n: Int) -> Bytes!:
        while bytes.len(self.buf) - self.pos < n:
            chunk := self.recv_chunk()!
            if bytes.len(chunk) == 0:
                fail "mysql: connection closed"
            self.buf = bytes.concat(bytes.slice(self.buf, self.pos, bytes.len(self.buf)), chunk)
            self.pos = 0
        out := bytes.slice(self.buf, self.pos, self.pos + n)
        self.pos = self.pos + n
        return out

    # read one packet, returning its payload. the 3-byte little-endian length
    # and 1-byte sequence id are consumed; the sequence id is stashed in
    # last_seq so an auth reply can echo the next one.
    fn read_packet() -> Bytes!:
        head := self.recv_exact(4)!
        length := bytes.get(head, 0) + bytes.get(head, 1) * 256 + bytes.get(head, 2) * 65536
        self.last_seq = bytes.get(head, 3)
        return self.recv_exact(length)!

    # write raw bytes to the transport: the tls session when secure, the plain
    # socket otherwise.
    fn send_raw(data: Bytes) -> Int!:
        if self.secure:
            return tls.conn_from_handle(self.tls_handle).write_all_bytes(data)!
        return tcp_write_bytes(self.fd, data)!

    fn send_packet(seq: Int, payload: Bytes) -> Int!:
        out := bytes.buffer()
        out.write(le_int(bytes.len(payload), 3)) catch 0
        out.write_byte(seq) catch 0
        out.write(payload) catch 0
        n := self.send_raw(out.bytes())!
        out.free()
        return n

    # close the connection.
    pub fn close():
        if self.secure:
            tls.conn_from_handle(self.tls_handle).close()
        tcp_close(self.fd)

# base capabilities: PROTOCOL_41 | SECURE_CONNECTION | PLUGIN_AUTH |
# CONNECT_WITH_DB | LONG_PASSWORD. DEPRECATE_EOF is left off so the server frames
# result sets with EOF packets.
CAPS_BASE := 557577
# CLIENT_SSL, added to request a tls upgrade before the handshake response.
CAP_SSL := 2048

# the mysql_native_password scramble:
#   SHA1(password) XOR SHA1(salt + SHA1(SHA1(password)))
fn native_scramble(password: String, salt: Bytes) -> Bytes:
    sha_pw := hash.sha1_bytes(bytes.from_string_utf8(password))
    double := hash.sha1_bytes(sha_pw)
    seeded := hash.sha1_bytes(bytes.concat(salt, double))
    return xor_bytes(sha_pw, seeded)

# the caching_sha2_password fast-auth scramble:
#   SHA256(password) XOR SHA256(SHA256(SHA256(password)) + salt)
fn caching_sha2_scramble(password: String, salt: Bytes) -> Bytes:
    sha_pw := hash.sha256_bytes(bytes.from_string_utf8(password))
    double := hash.sha256_bytes(sha_pw)
    seeded := hash.sha256_bytes(bytes.concat(double, salt))
    return xor_bytes(sha_pw, seeded)

# the scramble for a given auth plugin. an empty password always scrambles to
# nothing.
fn scramble_for(plugin: String, password: String, salt: Bytes) -> Bytes:
    if password.len() == 0:
        return bytes.empty()
    if plugin == "caching_sha2_password":
        return caching_sha2_scramble(password, salt)
    return native_scramble(password, salt)

# read the error message from an ERR packet payload (after the 0xff marker):
# 2-byte code, a 6-byte sql-state marker, then the message.
fn err_text(payload: Bytes) -> String:
    if bytes.len(payload) <= 9:
        return "unknown error"
    return bytes.to_string_utf8(bytes.slice(payload, 9, bytes.len(payload))) catch "error"

# open a connection and complete the handshake and authentication.
pub fn connect(host: String, port: Int, user: String, password: String, database: String) -> Conn!:
    fd := tcp_connect(host, port)!
    conn := Conn(fd: fd, buf: bytes.empty(), pos: 0, secure: false, tls_handle: 0, last_seq: 0)
    # the conn owns the socket but nothing closes it until the caller does. a
    # failed greeting or auth never reaches the caller, so close it here rather
    # than leak the socket on every failed dial (the conn is plain, so close()
    # just tcp_closes the fd once).
    greeting := conn.read_packet()
    if greeting.is_err:
        conn.close()
        fail greeting.err
    started := conn.authenticate(greeting.ok, user, password, database, 1)
    if started.is_err:
        conn.close()
        fail started.err
    return conn

# like connect, but upgrade the socket to tls before sending credentials. the
# server must advertise ssl support; the mysql SSLRequest is an abbreviated
# handshake response carrying only the capability flags with CLIENT_SSL set.
pub fn connect_tls(host: String, port: Int, user: String, password: String, database: String, server_name: String, config: tls.Config) -> Conn!:
    fd := tcp_connect(host, port)!
    conn := Conn(fd: fd, buf: bytes.empty(), pos: 0, secure: false, tls_handle: 0, last_seq: 0)
    # the conn is plain until the tls upgrade lands, so every failure up to that
    # point closes it with conn.close() (a single tcp_close on the fd).
    greeting := conn.read_packet()
    if greeting.is_err:
        conn.close()
        fail greeting.err

    ssl := bytes.buffer()
    ssl.write(le_int(CAPS_BASE + CAP_SSL, 4)) catch 0
    ssl.write(le_int(16777216, 4)) catch 0
    ssl.write_byte(45) catch 0
    mut z := 0
    while z < 23:
        ssl.write_byte(0) catch 0
        z = z + 1
    sent := conn.send_packet(1, ssl.bytes())
    if sent.is_err:
        conn.close()
        fail sent.err
    ssl.free()

    session_result := tls.client(TcpStream(fd), server_name, config)
    if session_result.is_err:
        # the tls upgrade never completed, so the fd is still a plain socket.
        conn.close()
        fail session_result.err
    session := session_result.ok
    conn.secure = true
    conn.tls_handle = session.handle
    # from here the tls session owns the socket. on a failed auth close through
    # the session once — not conn.close(), which would tcp_close the fd twice.
    started := conn.authenticate(greeting.ok, user, password, database, 2)
    if started.is_err:
        tls.conn_from_handle(session.handle).close()
        fail started.err
    return conn

impl Conn:
    # send the handshake response for `plugin` and run the auth exchange to
    # completion. `response_seq` is 1 for a plain connection and 2 after a tls
    # upgrade (the SSLRequest took sequence 1).
    fn authenticate(greeting: Bytes, user: String, password: String, database: String, response_seq: Int) -> Bool!:
        salt := parse_salt(greeting)!
        plugin := parse_auth_plugin(greeting)!
        mut caps := CAPS_BASE
        if self.secure:
            caps = caps + CAP_SSL
        scramble := scramble_for(plugin, password, salt)

        out := bytes.buffer()
        out.write(le_int(caps, 4)) catch 0
        out.write(le_int(16777216, 4)) catch 0
        out.write_byte(45) catch 0
        mut z := 0
        while z < 23:
            out.write_byte(0) catch 0
            z = z + 1
        out.write(cstring_bytes(user)) catch 0
        out.write_byte(bytes.len(scramble)) catch 0
        out.write(scramble) catch 0
        out.write(cstring_bytes(database)) catch 0
        out.write(cstring_bytes(plugin)) catch 0
        self.send_packet(response_seq, out.bytes())!
        out.free()
        return self.finish_auth(password)

    # drive the post-response auth exchange: an OK ends it, an auth-switch
    # re-scrambles for the requested plugin, and caching_sha2 AuthMoreData either
    # signals a cache hit or asks for the password (sent in the clear, which is
    # why full auth is only allowed over tls).
    fn finish_auth(password: String) -> Bool!:
        while true:
            reply := self.read_packet()!
            marker := bytes.get(reply, 0)
            if marker == 0:
                return true
            if marker == 255:
                fail "mysql: {err_text(reply)}"
            if marker == 254:
                r := Reader(data: reply, pos: 1)
                switch_plugin := r.cstring()!
                mut switch_salt := bytes.slice(reply, r.pos, bytes.len(reply))
                if switch_salt.len() > 20:
                    switch_salt = bytes.slice(switch_salt, 0, 20)
                self.send_packet(self.last_seq + 1, scramble_for(switch_plugin, password, switch_salt))!
            elif marker == 1:
                sub := bytes.get(reply, 1)
                if sub == 3:
                    continue
                elif sub == 4:
                    if not self.secure:
                        fail "mysql: caching_sha2_password full auth needs tls"
                    self.send_packet(self.last_seq + 1, cstring_bytes(password))!
                else:
                    fail "mysql: unexpected auth data {sub}"
            else:
                fail "mysql: unexpected auth reply {marker}"

# a string plus a null terminator.
fn cstring_bytes(text: String) -> Bytes:
    out := bytes.buffer()
    out.write_string_utf8(text) catch 0
    out.write_byte(0) catch 0
    result := out.bytes()
    out.free()
    return result

# the 20-byte auth salt from the initial handshake packet: an 8-byte part, then
# fixed fields, then 12 more salt bytes.
fn parse_salt(greeting: Bytes) -> Bytes!:
    r := Reader(data: greeting, pos: 0)
    r.skip(1)
    r.cstring()!
    r.skip(4)
    salt1 := bytes.slice(greeting, r.pos, r.pos + 8)
    r.skip(8)
    r.skip(1)
    r.skip(2)
    r.skip(1)
    r.skip(2)
    r.skip(2)
    r.skip(1)
    r.skip(10)
    salt2 := bytes.slice(greeting, r.pos, r.pos + 12)
    return bytes.concat(salt1, salt2)

# the auth plugin name the server advertises: it follows the second salt part
# (12 bytes plus a null terminator). a server that omits it defaults to
# mysql_native_password.
fn parse_auth_plugin(greeting: Bytes) -> String!:
    r := Reader(data: greeting, pos: 0)
    r.skip(1)
    r.cstring()!
    r.skip(4)
    r.skip(8)
    r.skip(1)
    r.skip(2)
    r.skip(1)
    r.skip(2)
    r.skip(2)
    r.skip(1)
    r.skip(10)
    r.skip(13)
    if r.pos >= bytes.len(greeting):
        return "mysql_native_password"
    return r.cstring()!

# --- queries ---

# a buffered result set from one query, iterated as sql.Row.
pub struct Rows:
    mut rows: List[sql.Row]
    mut pos: Int

impl Iterator for Rows:
    type Item = sql.Row
    fn next() -> sql.Row?:
        if self.pos >= self.rows.len():
            return none
        row := self.rows[self.pos]
        self.pos = self.pos + 1
        return row

# a column's name and mysql type code, the two fields we need from a column
# definition packet.
struct ColumnDef:
    name: String
    kind: Int

# read and parse one column-definition packet: five length-encoded strings
# (catalog, schema, table, org_table, name), the org_name, then fixed fields
# up to the 1-byte type code.
fn read_column_def(conn: Conn) -> ColumnDef!:
    col := conn.read_packet()!
    r := Reader(data: col, pos: 0)
    r.lenenc_str()!
    r.lenenc_str()!
    r.lenenc_str()!
    r.lenenc_str()!
    name := r.lenenc_str()!
    r.lenenc_str()!
    r.skip(1)
    r.skip(2)
    r.skip(4)
    return ColumnDef(name: name, kind: r.u8())

# run a query through the text protocol and collect its rows.
pub fn query(conn: Conn, text: String) -> Rows!:
    cmd := bytes.buffer()
    cmd.write_byte(3) catch 0
    cmd.write_string_utf8(text) catch 0
    conn.send_packet(0, cmd.bytes())!
    cmd.free()

    first := conn.read_packet()!
    lead := bytes.get(first, 0)
    if lead == 255:
        fail "mysql: {err_text(first)}"
    if lead == 0:
        # OK packet: a statement with no result set.
        return Rows(rows: [], pos: 0)

    count_reader := Reader(data: first, pos: 0)
    column_count := count_reader.lenenc()

    # column definitions: keep each column's name and mysql type.
    mut names: List[String] := []
    mut types: List[Int] := []
    mut c := 0
    while c < column_count:
        def := read_column_def(conn)!
        names.push(def.name)
        types.push(def.kind)
        c = c + 1

    conn.read_packet()!

    # rows, until the trailing EOF packet (0xfe with a short payload).
    mut rows: List[sql.Row] := []
    while true:
        pkt := conn.read_packet()!
        if bytes.get(pkt, 0) == 254 and bytes.len(pkt) < 9:
            return Rows(rows: rows, pos: 0)
        r := Reader(data: pkt, pos: 0)
        mut values: List[sql.Value] := []
        mut i := 0
        while i < column_count:
            if bytes.get(pkt, r.pos) == 251:
                r.skip(1)
                values.push(sql.null_value())
            else:
                values.push(decode_value(r.lenenc_str()!, types[i]))
            i = i + 1
        rows.push(sql.row(values, names))

# decode a text value by its mysql column type.
fn decode_value(raw: String, mysql_type: Int) -> sql.Value:
    # tiny, short, long, longlong, int24, year
    if mysql_type == 1 or mysql_type == 2 or mysql_type == 3 or mysql_type == 8 or mysql_type == 9 or mysql_type == 13:
        return sql.integer(parse_int(raw) catch 0)
    # float, double, decimal, newdecimal
    if mysql_type == 4 or mysql_type == 5 or mysql_type == 0 or mysql_type == 246:
        return sql.real(parse_float(raw) catch 0.0)
    return sql.text(raw)

# --- prepared statements (binary protocol) ---

# a server-side prepared statement: its id and how many parameters it expects.
pub struct Stmt:
    id: Int
    num_params: Int

# a length-encoded integer, the wire form mysql uses for lengths and counts.
fn lenenc_bytes(n: Int) -> Bytes:
    out := bytes.buffer()
    if n < 251:
        out.write_byte(n) catch 0
    elif n < 65536:
        out.write_byte(252) catch 0
        out.write(le_int(n, 2)) catch 0
    else:
        out.write_byte(253) catch 0
        out.write(le_int(n, 3)) catch 0
    result := out.bytes()
    out.free()
    return result

# read `count` column-definition packets and the EOF packet that ends them.
fn skip_defs(conn: Conn, count: Int) -> Bool!:
    mut i := 0
    while i < count:
        conn.read_packet()!
        i = i + 1
    conn.read_packet()!
    return true

# prepare a statement on the server (COM_STMT_PREPARE). run it with
# query_prepared / exec_prepared, which bind parameters and reuse the parse.
pub fn prepare(conn: Conn, text: String) -> Stmt!:
    cmd := bytes.buffer()
    cmd.write_byte(22) catch 0
    cmd.write_string_utf8(text) catch 0
    conn.send_packet(0, cmd.bytes())!
    cmd.free()

    resp := conn.read_packet()!
    if bytes.get(resp, 0) == 255:
        fail "mysql: {err_text(resp)}"
    r := Reader(data: resp, pos: 0)
    r.skip(1)
    stmt_id := r.le(4)
    num_columns := r.le(2)
    num_params := r.le(2)

    if num_params > 0:
        skip_defs(conn, num_params)!
    if num_columns > 0:
        skip_defs(conn, num_columns)!
    return Stmt(id: stmt_id, num_params: num_params)

# sign-extend an unsigned little-endian value of `width` bytes to a signed int.
fn sign_extend(value: Int, width: Int) -> Int:
    high := bits.shl(1, width * 8 - 1)
    if bits.band(value, high) != 0:
        return value - bits.shl(1, width * 8)
    return value

# widen a 32-bit float's bit pattern into a 64-bit double, exact for normal
# numbers, zero, and inf/nan. subnormal floats (vanishingly rare in stored data)
# are not reconstructed precisely.
fn f32_to_f64(raw: Int) -> Float:
    sign := bits.band(bits.shr(raw, 31), 1)
    exp := bits.band(bits.shr(raw, 23), 255)
    mant := bits.band(raw, 8388607)
    mant64 := bits.shl(mant, 29)
    mut exp64 := exp - 127 + 1023
    if exp == 255:
        exp64 = 2047
    elif exp == 0 and mant == 0:
        exp64 = 0
    combined := bits.bor(bits.bor(bits.shl(sign, 63), bits.shl(exp64, 52)), mant64)
    return float_from_bits(combined)

# decode one value from a binary result row by its mysql type: integers arrive
# little-endian, float/double as raw ieee754 bits, everything else as a
# length-encoded string.
fn decode_binary(r: Reader, mysql_type: Int) -> sql.Value!:
    if mysql_type == 1:
        return sql.integer(sign_extend(r.u8(), 1))
    if mysql_type == 2 or mysql_type == 13:
        return sql.integer(sign_extend(r.le(2), 2))
    if mysql_type == 3 or mysql_type == 9:
        return sql.integer(sign_extend(r.le(4), 4))
    if mysql_type == 8:
        return sql.integer(r.le(8))
    if mysql_type == 5:
        return sql.real(float_from_bits(r.le(8)))
    if mysql_type == 4:
        return sql.real(f32_to_f64(r.le(4)))
    return sql.text(r.lenenc_str()!)

# build a COM_STMT_EXECUTE payload, binding every parameter as a string (the
# server coerces to the column type). null parameters are not supported here.
fn build_execute(stmt: Stmt, params: List[String]) -> Bytes:
    out := bytes.buffer()
    out.write_byte(23) catch 0
    out.write(le_int(stmt.id, 4)) catch 0
    out.write_byte(0) catch 0
    out.write(le_int(1, 4)) catch 0
    if stmt.num_params > 0:
        null_bytes := (stmt.num_params + 7) / 8
        mut i := 0
        while i < null_bytes:
            out.write_byte(0) catch 0
            i = i + 1
        out.write_byte(1) catch 0
        mut j := 0
        while j < stmt.num_params:
            out.write_byte(253) catch 0
            out.write_byte(0) catch 0
            j = j + 1
        for p in params:
            value := bytes.from_string_utf8(p)
            out.write(lenenc_bytes(bytes.len(value))) catch 0
            out.write(value) catch 0
    result := out.bytes()
    out.free()
    return result

# the outcome of one execute: rows for a select, or the affected count and the
# auto-increment id the server assigned (both from the OK packet) otherwise.
struct BinaryResult:
    rows: List[sql.Row]
    affected: Int
    last_insert_id: Int

# run a prepared statement and read its reply: an OK packet (no result set) or a
# binary result set of column definitions followed by binary rows.
fn run_stmt(conn: Conn, stmt: Stmt, params: List[String]) -> BinaryResult!:
    if params.len() != stmt.num_params:
        fail "mysql: statement expects {stmt.num_params} params, got {params.len()}"
    conn.send_packet(0, build_execute(stmt, params))!

    first := conn.read_packet()!
    lead := bytes.get(first, 0)
    if lead == 255:
        fail "mysql: {err_text(first)}"
    if lead == 0:
        # OK packet: affected-rows lenenc, then the last-insert-id lenenc.
        ok := Reader(data: first, pos: 1)
        affected := ok.lenenc()
        return BinaryResult(rows: [], affected: affected, last_insert_id: ok.lenenc())

    header := Reader(data: first, pos: 0)
    column_count := header.lenenc()
    mut names: List[String] := []
    mut types: List[Int] := []
    mut c := 0
    while c < column_count:
        def := read_column_def(conn)!
        names.push(def.name)
        types.push(def.kind)
        c = c + 1
    conn.read_packet()!

    # binary rows: a 0x00 header, a null bitmap offset by two reserved bits,
    # then each non-null value in binary form. an EOF packet ends the set.
    mut rows: List[sql.Row] := []
    while true:
        pkt := conn.read_packet()!
        if bytes.get(pkt, 0) == 254 and bytes.len(pkt) < 9:
            return BinaryResult(rows: rows, affected: 0, last_insert_id: 0)
        r := Reader(data: pkt, pos: 1)
        null_bytes := (column_count + 9) / 8
        bitmap := bytes.slice(pkt, r.pos, r.pos + null_bytes)
        r.skip(null_bytes)
        mut values: List[sql.Value] := []
        mut k := 0
        while k < column_count:
            slot := k + 2
            flag := bits.band(bits.shr(bytes.get(bitmap, slot / 8), slot % 8), 1)
            if flag == 1:
                values.push(sql.null_value())
            else:
                values.push(decode_binary(r, types[k])!)
            k = k + 1
        rows.push(sql.row(values, names))

# run a prepared statement, binding `params`, and collect its rows.
pub fn query_prepared(conn: Conn, stmt: Stmt, params: List[String]) -> Rows!:
    result := run_stmt(conn, stmt, params)!
    return Rows(rows: result.rows, pos: 0)

# run a prepared statement for its effect, returning the number of rows it
# affected.
pub fn exec_prepared(conn: Conn, stmt: Stmt, params: List[String]) -> Int!:
    result := run_stmt(conn, stmt, params)!
    return result.affected

# the affected-row count and auto-increment id from one execute. `last_insert_id`
# is the id the server assigned an auto_increment column, or 0 when the statement
# inserted none.
pub struct ExecInfo:
    pub affected: Int
    pub last_insert_id: Int

# like exec_prepared, but also report the auto-increment id the insert produced.
pub fn exec_prepared_info(conn: Conn, stmt: Stmt, params: List[String]) -> ExecInfo!:
    result := run_stmt(conn, stmt, params)!
    return ExecInfo(affected: result.affected, last_insert_id: result.last_insert_id)

# release a prepared statement on the server (COM_STMT_CLOSE), which sends no
# reply.
pub fn close_stmt(conn: Conn, stmt: Stmt) -> Bool!:
    cmd := bytes.buffer()
    cmd.write_byte(25) catch 0
    cmd.write(le_int(stmt.id, 4)) catch 0
    conn.send_packet(0, cmd.bytes())!
    cmd.free()
    return true

# --- connection pool ---

# a small connection pool: hand out live connections and take them back for
# reuse, so callers skip the tcp + auth handshake on every query.
#
# `max_open` is a hard cap on how many connections exist at once. a `slots`
# channel holds one token per allowed connection; acquire() takes a token and
# release() returns it, so when every connection is checked out the next
# acquirer blocks on the channel — yielding under the green scheduler — until
# one comes back, rather than opening an unbounded number and exhausting the
# server. an idle connection is reused before a token buys a fresh one, so the
# pool never holds more than `max_open` connections live at a time.
#
# the pool is self-synchronizing: `mu` guards the idle list and `slots` is a
# channel (already safe across tasks), so many green tasks can share one pool
# without an outer lock, and the connect/close network i/o stays outside `mu`.
pub struct Pool:
    mut idle: List[Conn]
    host: String
    port: Int
    user: String
    password: String
    database: String
    max_open: Int
    mu: Mutex
    slots: Channel[Bool]

# create a pool that dials the given server. it opens connections lazily and
# never holds more than `max_open` connections at once (clamped to at least one).
pub fn pool(host: String, port: Int, user: String, password: String, database: String, max_open: Int) -> Pool:
    cap := clamp_open(max_open)
    slots := Channel[Bool](cap)
    mut i := 0
    while i < cap:
        slots.send(true)
        i = i + 1
    return Pool(idle: [], host: host, port: port, user: user, password: password, database: database, max_open: cap, mu: Mutex(), slots: slots)

# a pool must allow at least one connection.
fn clamp_open(max_open: Int) -> Int:
    if max_open < 1:
        return 1
    return max_open

impl Pool:
    # take a connection from the pool. it first claims a slot — blocking (and
    # yielding) when all `max_open` connections are checked out — then reuses an
    # idle connection or, failing that, opens a fresh one outside the lock. on a
    # failed dial it hands the slot back so the cap does not leak.
    pub fn acquire() -> Conn!:
        self.slots.recv()
        self.mu.lock()
        n := self.idle.len()
        mut reused: Conn? := none
        if n > 0:
            reused = self.idle[n - 1]
            self.idle = self.idle.slice(0, n - 1)
        self.mu.unlock()
        if reused != none:
            return reused?
        fresh := connect(self.host, self.port, self.user, self.password, self.database)
        if fresh.is_err:
            self.slots.send(true)
            fail fresh.err
        return fresh.ok

    # return a connection for reuse, or close it if the pool is already full,
    # then hand its slot back. the idle list is updated before the slot returns,
    # so an acquirer woken by that slot finds the connection waiting for it and
    # does not open a redundant one.
    pub fn release(conn: Conn):
        self.mu.lock()
        keep := self.idle.len() < self.max_open
        if keep:
            self.idle.push(conn)
        self.mu.unlock()
        if not keep:
            conn.close()
        self.slots.send(true)

    # close a checked-out connection that must not go back into rotation (it is
    # out of protocol sync after a failed statement) and hand its slot back. like
    # release it returns the slot, so a discarded connection never leaks the cap.
    pub fn discard(conn: Conn):
        conn.close()
        self.slots.send(true)

    # close every idle connection.
    pub fn close():
        self.mu.lock()
        idle := self.idle
        self.idle = []
        self.mu.unlock()
        for conn in idle:
            conn.close()

# --- tests (pure logic; no server needed) ---

test "mysql_native_password scramble matches a known vector":
    salt := encoding.from_hex("000102030405060708090a0b0c0d0e0f10111213")!
    scramble := native_scramble("secret", salt)
    assert_eq(encoding.to_hex(scramble), "21b3ff405f32cbe4aafff291396046ea29fa3a4d")

test "caching_sha2_password scramble matches a known vector":
    # cross-checked against a reference sha-256 implementation, since the
    # available server offers only mysql_native_password.
    salt := encoding.from_hex("000102030405060708090a0b0c0d0e0f10111213")!
    scramble := caching_sha2_scramble("secret", salt)
    assert_eq(encoding.to_hex(scramble), "6c84c617ec1f26456a02c42ed7cb02eca7d8511333f98bc9b31e5f68ce1665d5")
    # an empty password scrambles to nothing regardless of plugin
    assert_eq(scramble_for("caching_sha2_password", "", salt).len(), 0)

test "little-endian integers round-trip":
    four := Reader(data: le_int(305419896, 4), pos: 0)
    assert_eq(four.le(4), 305419896)
    two := Reader(data: le_int(258, 2), pos: 0)
    assert_eq(two.le(2), 258)

test "length-encoded values parse":
    buf := bytes.buffer()
    buf.write_byte(5) catch 0
    buf.write_byte(5) catch 0
    buf.write_string_utf8("hello") catch 0
    data := buf.bytes()
    buf.free()
    r := Reader(data: data, pos: 0)
    assert_eq(r.lenenc(), 5)
    assert_eq(r.lenenc_str()!, "hello")

test "value decode honors mysql types":
    row := sql.row([decode_value("42", 3), decode_value("hi", 253), decode_value("9.5", 5)], ["a", "b", "c"])
    assert_eq(row.as_int(0), 42)
    assert_eq(row.as_text(1), "hi")
    assert_eq(row.as_real(2), 9.5)
