# bitwise operations and ord/chr round-tripping
# demonstrates: ord/chr conversion, bit manipulation, byte extraction

fn main():
    # ord and chr are inverses
    print("ord A: {ord("A")}")
    print("ord a: {ord("a")}")
    print("ord 0: {ord("0")}")
    print("chr 65: {chr(65)}")
    print("roundtrip: {chr(ord("Z"))}")

    # bitwise AND
    print("and ff 0f: {bit_and(0xFF, 0x0F)}")
    print("and 12 10: {bit_and(12, 10)}")

    # bitwise OR
    print("or f0 0f: {bit_or(0xF0, 0x0F)}")
    print("or 12 10: {bit_or(12, 10)}")

    # bitwise XOR
    print("xor ff 0f: {bit_xor(0xFF, 0x0F)}")
    print("xor 5 3: {bit_xor(5, 3)}")

    # bitwise NOT (masked to 8 bits for readability)
    print("not 0 masked: {bit_and(bit_not(0), 0xFF)}")

    # shift left / right
    print("shl 1 4: {bit_shl(1, 4)}")
    print("shr 256 4: {bit_shr(256, 4)}")

    # practical: extract bytes from a 16-bit value
    original_value := 0xDEAD
    low_byte := bit_and(original_value, 0xFF)
    high_byte := bit_and(bit_shr(original_value, 8), 0xFF)
    print("low byte: {low_byte}")
    print("high byte: {high_byte}")

    # reassemble the original value from its bytes
    reassembled_value := bit_or(bit_shl(high_byte, 8), low_byte)
    print("reassembled: {reassembled_value == 0xDEAD}")

    # print_err goes to stderr (not captured in stdout diff)
    print_err("this goes to stderr")
    print("bitwise ok")
