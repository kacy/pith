# std.text.tables - reading the generated unicode tables
#
# the tables in `case_tables` and `norm_tables` are strings of fixed-width
# base64 records, sorted by their search key. this module reads a field out of
# one and binary-searches it in place.
#
# nothing is decoded up front. a lookup touches about log2(n) records -- a
# dozen field reads for the largest table -- so there is no list to build, no
# startup cost, and no memory held for tables a program never consults.
#
# the record layout is set by tools/unicodegen/generate.py; see
# tools/unicodegen/README.md for why the data is packed this way rather than
# emitted as list literals.

# characters per packed field. 4 base64 characters carry 24 bits, which covers
# any code point with room to spare.
pub fn field_chars() -> Int:
    return 4

# the value of one base64 character. the alphabet is A-Z, a-z, 0-9, '+', '/'.
fn digit(b: Int) -> Int:
    if b >= 65 and b <= 90:
        return b - 65
    if b >= 97 and b <= 122:
        return (b - 97) + 26
    if b >= 48 and b <= 57:
        return (b - 48) + 52
    if b == 43:
        return 62
    return 63

fn raw_digit(table: String, at: Int) -> Int:
    return digit(bit_and(ord(table[at]), 255))

# read a 4-character field starting at a character offset. use this when the
# data is not a uniform grid of records -- the packed break tests interleave a
# marker character between fields.
pub fn field_at(table: String, at: Int) -> Int:
    return (raw_digit(table, at) * 262144) + (raw_digit(table, at + 1) * 4096) + (raw_digit(table, at + 2) * 64) + raw_digit(table, at + 3)

# read one field of one record. `arity` is how many fields a record has, which
# the caller knows from the table it is reading.
pub fn field(table: String, record: Int, index: Int, arity: Int) -> Int:
    return field_at(table, ((record * arity) + index) * 4)

# find the record whose first field equals `key`, or -1 when there is none.
pub fn find(table: String, arity: Int, count: Int, key: Int) -> Int:
    mut low := 0
    mut high := count - 1
    while low <= high:
        middle := (low + high) / 2
        at := field(table, middle, 0, arity)
        if at == key:
            return middle
        if at < key:
            low = middle + 1
        else:
            high = middle - 1
    return - 1

# find the last record whose first field is <= `key`, or -1 when every record
# starts above it. this is the lookup for range tables, where a record covers
# a span of code points rather than one.
pub fn find_containing(table: String, arity: Int, count: Int, key: Int) -> Int:
    mut low := 0
    mut high := count - 1
    mut best := - 1
    while low <= high:
        middle := (low + high) / 2
        if field(table, middle, 0, arity) <= key:
            best = middle
            low = middle + 1
        else:
            high = middle - 1
    return best

# find the record whose first two fields equal `first` and `second`, or -1.
# the composition table keys on a pair of code points, which does not fit in
# one field.
pub fn find_pair(table: String, arity: Int, count: Int, first: Int, second: Int) -> Int:
    mut low := 0
    mut high := count - 1
    while low <= high:
        middle := (low + high) / 2
        at_first := field(table, middle, 0, arity)
        at_second := field(table, middle, 1, arity)
        if at_first == first and at_second == second:
            return middle
        mut lower := at_first < first
        if at_first == first:
            lower = at_second < second
        if lower:
            low = middle + 1
        else:
            high = middle - 1
    return - 1

test "reads a field at a character offset":
    table := "AAABAAEsARFwAAA/"
    assert_eq(field_at(table, 0), 1)
    assert_eq(field_at(table, 4), 300)
    assert_eq(field_at(table, 8), 70000)

test "reads packed fields":
    # two records of two fields: (1, 300) and (70000, 63)
    table := "AAABAAEsARFwAAA/"
    assert_eq(field(table, 0, 0, 2), 1)
    assert_eq(field(table, 0, 1, 2), 300)
    assert_eq(field(table, 1, 0, 2), 70000)
    assert_eq(field(table, 1, 1, 2), 63)

test "binary searches for an exact key":
    table := "AAABAAEsARFwAAA/"
    assert_eq(find(table, 2, 2, 1), 0)
    assert_eq(find(table, 2, 2, 70000), 1)
    assert_eq(find(table, 2, 2, 2), - 1)
    assert_eq(find(table, 2, 2, 0), - 1)
    assert_eq(find(table, 2, 2, 999999), - 1)

test "binary searches for a containing range":
    table := "AAABAAEsARFwAAA/"
    assert_eq(find_containing(table, 2, 2, 0), - 1)
    assert_eq(find_containing(table, 2, 2, 1), 0)
    assert_eq(find_containing(table, 2, 2, 5000), 0)
    assert_eq(find_containing(table, 2, 2, 70000), 1)
    assert_eq(find_containing(table, 2, 2, 999999), 1)

test "binary searches on a two-field key":
    # (1, 2) -> 10, (1, 5) -> 11, (9, 1) -> 12
    table := "AAABAAACAAAKAAABAAAFAAALAAAJAAABAAAM"
    assert_eq(find_pair(table, 3, 3, 1, 2), 0)
    assert_eq(find_pair(table, 3, 3, 1, 5), 1)
    assert_eq(find_pair(table, 3, 3, 9, 1), 2)
    assert_eq(find_pair(table, 3, 3, 1, 3), - 1)
    assert_eq(find_pair(table, 3, 3, 9, 2), - 1)
    assert_eq(find_pair(table, 3, 3, 0, 0), - 1)
