# a grpc service over plaintext http/2 (h2c), server and client in one process.
#
# the server routes each call by its /package.Service/Method path to one dispatch
# handler and sends the reply back with the grpc-status trailer. the client dials
# with grpc.dial_h2c (no tls) and makes two unary calls over the one connection: a
# known method and an unknown one, which comes back as GRPC_UNIMPLEMENTED. the
# messages are protobuf — field 1 is a string in both directions.

import std.net.grpc as grpc
import std.protobuf as protobuf
import std.bytes as bytes
import std.time as time

PORT := 50251

# read protobuf field 1 (a string) from a message, defaulting to "" if absent.
fn read_name(message: Bytes) -> String!protobuf.ProtoError:
    r := protobuf.reader(message)
    mut name := ""
    while not r.at_end():
        tag := r.read_tag()!
        if tag.field == 1:
            name = r.read_string()!
        else:
            r.skip(tag.wire)!
    return name

# encode a single string into protobuf field 1 — the request and reply shape.
fn message_of(text: String) -> Bytes:
    w := protobuf.writer()
    w.write_string(1, text) catch false
    out := w.bytes()
    w.free()
    return out

# the service: one method, /greeter.Greeter/SayHello, greeting the caller by name.
# an unknown path fails with GRPC_UNIMPLEMENTED, the standard grpc response.
fn greeter(path: String, request: Bytes) -> Bytes!grpc.GrpcError:
    if path != "/greeter.Greeter/SayHello":
        fail grpc.GrpcError(grpc.GRPC_UNIMPLEMENTED, "no method " + path)
    name := read_name(request) catch "world"
    return message_of("hello, " + name)

fn run_server():
    grpc.serve("127.0.0.1", PORT, greeter) catch 0

# call `path` over `conn` and print the reply, or the grpc-status on failure.
fn call(conn: grpc.Conn, path: String, name: String):
    reply := conn.unary(path, message_of(name))
    if reply.is_err:
        print(path + " -> error " + reply.err.status.to_string() + ": " + reply.err.message)
    else:
        print(path + " -> " + (read_name(reply.ok) catch "?"))

fn main():
    spawn run_server()
    time.delay(400)
    dialed := grpc.dial_h2c("127.0.0.1", PORT)
    if dialed.is_err:
        print("dial failed")
        return
    conn := dialed.ok
    call(conn, "/greeter.Greeter/SayHello", "pith")
    call(conn, "/greeter.Greeter/Unknown", "pith")
    conn.close()
