# a helper module for test_interface_values_cross_module: an interface,
# a type implementing it, and a function taking a list of its values.
pub interface Shape:
    fn area() -> Int
    fn name() -> String

pub struct Sq:
    pub s: Int

impl Shape for Sq:
    fn area() -> Int:
        return self.s * self.s
    fn name() -> String:
        return "sq"

pub fn total(xs: List[Shape]) -> Int:
    mut t := 0
    for x in xs:
        t = t + x.area()
    return t
