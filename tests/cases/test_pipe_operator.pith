# `x | f` calls f with x, and pipes chain left to right. it used to pass the
# checker and then stop the build with "unknown or malformed instruction".
import std.strings as strings

fn double(x: Int) -> Int:
    return x * 2

fn shout(s: String) -> String:
    return s + "!"

fn main() -> Int:
    print("{5 | double}")
    print("{5 | double | double}")
    name := "pith"
    print(name + "-" | shout)
    print(name | strings.capitalize)
    add_one := fn(x: Int) -> Int => x + 1
    print("{3 | add_one}")
    return 0
