# child processes with std.os.process: the steps of a small deploy script.
#
# a Command is built up (arguments, environment, working directory) and then
# run in the way the caller needs: `text_trimmed` for a command whose output is
# the answer, `output_checked` for one whose failure must stop the script,
# `output_ctx` with a deadline for one that might hang, and `start` for a
# child to stream text through. every command here is a posix tool, so the
# output is the same on any unix machine.

import std.concurrent as concurrent
import std.os.process as process

fn main() -> Int!:
    # arguments go to the program as they are: no shell, so no quoting. the
    # error type is ExitError rather than a string, so it is caught here.
    version := process.command("printf").args(["%s", "release 1.4.2"]).text_trimmed() catch:
        fail "could not read the version"
    print("building {version}")

    # the child gets its own environment additions and working directory.
    where := process.command("sh").args(["-c", "echo \"$STAGE in $(pwd)\""]).env("STAGE", "staging").cwd("/").text_trimmed() catch "an unknown stage"
    print("deploying to {where}")

    # a failing step: the error carries the exit status and what went to stderr.
    migrate := process.command("sh").args(["-c", "echo 'migration 7 failed: lock timeout' >&2; exit 3"]).output_checked()
    if migrate.is_err:
        print("migrate exited {migrate.err.status}: {migrate.err.stderr.trim()}")

    # a step that hangs is killed when its deadline passes.
    deadline := concurrent.with_timeout(concurrent.background(), 200).0
    health := process.command("sleep").arg("10").output_ctx(deadline)
    if health.is_err:
        print("health check: no answer in 200ms, killed it")

    # stream text through a running child: head passes on the first two lines
    # and exits, which ends its output.
    child := process.command("head").args(["-n", "2"]).start()!
    defer child.close()
    child.stdin().write_all("web-1 ready\nweb-2 ready\nweb-3 ready\n")!
    first_two := child.stdout().read_all()!
    print("first hosts up: {first_two.trim().split("\n").join(", ")}")
    print("head exited {child.wait()}")
    return 0
