        return buffered_string_writer_write(self, data)

impl Flusher for BufferedStringWriter:
    fn flush() -> Int!:
        return buffered_string_writer_flush(self)

impl Closer for BufferedStringWriter:
    # drop the writer's registry entries, discarding anything unflushed —
    # flush() first. the target buffer is closed by whoever built it; a write
    # after close reports nothing written, and a second close is a no-op.
    fn close():
        close_buffered_string_writer_state(self.handle)

