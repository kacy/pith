; a field store into a struct after its last release, under
; PITH_QUARANTINE=1. the store is generated code alone, so without quarantine
; it writes into freed memory (or into whatever value the struct pool handed
; the block to next) and nothing notices.
string m0s0 "before:"
func main 0 void
iconst 1 3
iconst 2 1
call 3 pith_struct_alloc struct:Cell 1 2
sstore 3 0 1
field 4 3 0 int n
strref 5 m0s0
call 6 int_to_string string 1 4
concat 7 5 6
call 8 pith_print_cstr unknown 1 7
call 9 pith_struct_release void 1 3
iconst 10 9
sstore 3 0 10
iconst 11 0
ret 11
endfunc
